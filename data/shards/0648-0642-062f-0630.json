{"poems":[[53,"وردنا بها بين العذيب وضارج","https://www.aldiwan.net/poem29925.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[47,"أيا أم الأسير سقاك غيث","https://www.aldiwan.net/poem25257.html","الوافر"],[51,"أخالد يا ابن الخالدات مخازيا","https://www.aldiwan.net/poem65963.html","الطويل"],[70,"سواك الذي ودي لديه مضيع","https://www.aldiwan.net/poem43024.html","الطويل"],[85,"ألا حبذا صحبة المكتب","https://www.aldiwan.net/poem62987.html","المتقارب"],[43,"بنا منك فوق الرمل ما بك في الرمل","https://www.aldiwan.net/poem9926.html","الطويل"],[45,"سل الحلبي عن حلب","https://www.aldiwan.net/poem11047.html","مجزوء الوافر"],[45,"بني عثمان أنتم في غني","https://www.aldiwan.net/poem64673.html","الوافر"],[46,"متى أنا للدار المريحة ظاعن","https://www.aldiwan.net/poem23375.html","الطويل"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[1,"أتعرف رسم الدار قفرا منازله","https://www.aldiwan.net/poem34010.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85308","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[45,"بَني عُثْمانَ! أنْتُمْ، في غُنَىٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=31120",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[141,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[148,"وجدت ولا طب لما أنا واجد","https://www.aldiwan.net/poem68550.html","الطويل"],[184,"سمعنا بالوفاء وما رأينا","https://www.aldiwan.net/poem43976.html","الوافر"],[196,"يا فتية الحي كفوا الأعين النجلا","https://www.aldiwan.net/poem51900.html","البسيط"],[197,"سلي بعدك الواشين هل ذاع لي سر","https://www.aldiwan.net/poem45584.html","الطويل"],[210,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[210,"أشاقك رسم أم أشاقك مربع","https://www.aldiwan.net/poem37864.html","الطويل"],[268,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[290,"ألا من لنفس لا تؤدي حقوقها","https://www.aldiwan.net/poem441.html",""],[302,"عسى من بلانا بالبعاد يجود","https://www.aldiwan.net/poem16804.html","الطويل"],[364,"وقد ذكرت والتذكار جهدي","https://www.aldiwan.net/poem17738.html","الوافر"],[374,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[388,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[399,"وقد أطلت ما ترى","https://www.aldiwan.net/poem46492.html","مجزوء الرجز"],[400,"ما آن للعاذل أن يغلقا","https://www.aldiwan.net/poem33627.html","السريع"],[429,"قرنت بواو الصدغ صاد المقبل","https://www.aldiwan.net/poem12695.html","الطويل"],[436,"إذا سقيت أرض فقد بشرت أرض","https://www.aldiwan.net/poem34784.html","الطويل"],[436,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[459,"طليق الوجه أغلب هاشمي","https://www.aldiwan.net/poem15629.html","الوافر"],[462,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[475,"هي الدار قد أقوت ورث جديدها","https://www.aldiwan.net/poem15191.html","الطويل"],[491,"ومعصرة أنخت بها","https://www.aldiwan.net/poem67409.html","مجزوء الوافر"],[498,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[511,"هبوني أخفيت الذي بي من الهوى","https://www.aldiwan.net/poem67701.html","الطويل"],[514,"ألا يا عقاب الوكر وكر ضرية","https://www.aldiwan.net/poem48672.html","الطويل"],[527,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[549,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[549,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[556,"دع المنكرين الجاحدين فإنهم","https://www.aldiwan.net/poem34944.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"]],"verses":[["وَقَد ذَعذَعَ اللَيلُ النُجومَ لِغَورِها","كَبَيضِ الأَداحي بَعثَرَتهُ النَقانِقُ",0,"ق",1,0],["وَقَدْ ذُعِرَتْ خَوْلاَنُ بَيْنَ بُيُوتِهَا","غَدَاةَ بَدَتْ مِنْهَا اللُّيَوُث بخَوْلاَنِ",1,"ن",1,0],["وَقَدْ ذَغَرَ الْعُرْبَانَ مِنْكَ غَضَنْفَرٌ","أَزَلُّ عَريضُ الصَّدْرِ سَاعِدُهُ فعْمُ",2,"م",1,0],["وَقَد ذُقتَ طَعمَ الرَدى عِندَما","أُصيبَ قِطارُكَ يَومَ السَفَر",3,"ر",1,0],["وَقَد ذُقتِ الرَزايا وَالمَنايا","وَلا وَلَدٌ لَدَيكِ وَلا عَشيرُ",4,"ر",1,0],["وقد ذَهِلتْ عن طِفلِها كلُّ مُطفلٍ","رؤومٍ وألقتْ حملها كلُّ حاملِ",5,"ل",1,0],["وَقَد ذَكَروا في خادِمِ القَومِ أَنَّهُ","بِما كانَ مِن أَخلاقِهِم يَتَهَذَّبُ",6,"ب",1,0],["وَقَد ذَهَبَ المُمتَلي صِحَّةً","وَصَحَّ السَقيمُ فَلَم يَذهَبِ",7,"ب",1,0],["وَقَد ذُقتُ حَلواءَ البَنينَ عَلى الصِبا","فَلا تَحسَبَنّي قُلتُ ما قُلتُ عَن جَهلِ",8,"ل",1,0],["وَقَد ذَبَحَ الدَجاجَ لَنا","فَأَمسى ديكُهُ عَزَبا",9,"ب",2,0],["وَقَد ذَبَحوكُمُ سَرَفاً وَبَغياً","بِتَلِّ عُقَيبَ إِذ كُرِهَ المِصاعُ",10,"ع",1,0],["وَقَد ذُقتُها ما بَينَ شَهدٍ وَعَلقَمٍ","وَجَرَّبتُها مِن صَحَّةٍ وَسَقامِ",11,"م",1,0],["وقد ذابَتْ بِنارِ الحِقْدِ منها","شَكائِمُها فمازَجَتِ الرُّوَالا",12,"ل",2,0],["وَقَد ذَهَبَت سَلمى بِعَقلِكَ كُلِّهِ","فَهَل غَيرُ صَيدٍ أَحرَزَتهُ حَبائِلُه",13,"ل",2,0],["وقد ذقت حلو العيش دهراً ومره","إلى أن تساوى في فمي الحلو والمر",14,"ر",1,0],["وقد ذر قرن الشمس يلمع نوره","فأطريت منها النور يلمع والقرنا",15,"ن",2,0],["وَقَد ذرفت أَدمعاً","فاِستهزأت بأَدمعي",16,"ي",1,0],["وَقَد ذُبتُ في حُبِّ الغَواني غِوايَةً","وَقَبَّلتُ أَطرافَ البنانِ المُطَرَّفِ",17,"ف",1,0],["وقد ذهب الَّليلُ إلاَّ ذَماً","كما ردَّدَ النَّفَس َ الجارضونا",18,"ن",2,0],["وَقَدْ ذَبَحُوكُمُ سَرَفاً وَبَغياً،","بِتَلّ عُقبََ أذْكَرَهُ المِصَاعُ",19,"ع",1,0],["وقد ذيدَ عنها الزادُ رَفهاً لآكلٍ","وحُرّم فيها الماء صفواً لشارب",20,"ب",1,0],["وَقَد ذَلَّ مَن حاوَلوا نَصرَهُ","فَكَيفَ يَعِزُّ بِهِ المُنتَصِر",21,"ر",1,0],["وَقَد ذُقتُ طَعمَ الحُبِّ بَدءاً وَعَودَةً","فلَم أدرِ هَل مُرَاً تَطَعَّمتُ أم حُلوا",22,"و",2,0],["وقد ذكر الوفاء فقال قوم","مقالا واسعا قبلي وبعدي",23,"ي",1,0],["وقد ذكرنا حمول الحيِّ فاحتملت","منَّا الضلوع غراماً أثقل الإبلا",24,"ل",2,0],["وقد ذقتُ من حلوِ الزمانِ ومرِّهِ","فلا الحلو أنساني هواكِ ولا المرُّ",25,"ر",1,0],["وقد ذوى كلُّ ما في الأرضِ من شَجَرٍ","وقد سَفَحْنَ لضُمَ الصَّخْرِ آماقُ",26,"ق",1,0],["وقد ذبلَت أغصانُه وفروعهُ","وحلَّ به خطبٌ من الدَّهرِ مُفْظع",27,"ع",1,0],["وقد ذبُلَت كالياسمينِ جُفونُها","وإن تَفترِ العينانِ فالقلبُ ما فَتر",28,"ر",1,0],["وَقَد ذَبذَبَت بِالحَيِّ دارٌ مُشِتَّةٌ","وَصَرفُ النَوى أَشطانُها وَصُفوقُها",29,"ق",3,0],["وقد ذهبت أيامه وتنكرت","عليه أمور فاظطربن عهود",30,"د",1,0],["وَقَد ذَكَّرتُ وَالتَذكارُ جُهدي","وَقَد نادَيتُ لَو سُمِعَ النَداءُ",31,"ا",2,1],["وقد ذهبت في سر ناسوته الورى","مذاهب يرويها أولوا الألمعية",32,"ه",1,0],["وقد ذكر الغزالي","له جملة علامات",33,"ت",1,0],["وقد ذكرتُ قصَصاً","تحارُ فيهنّ الفِكَرْ",34,"ر",1,0],["وقد ذوى روض المعالي وهل","للروض إن لم تسقه مرتقا",35,"ق",2,0],["وقد ذكَروا أنّ الشبابَ ولايةً","تؤكّدُ بالإجمالِ أو بالتجمُّلِ",36,"ل",1,0],["وقد ذَبُلَت فِي رَوضِ جُودِكَ زَهرَةٌ","ثناؤكَ منها فِي الورى يانِعٌ غَضُّ",37,"ض",1,0],["وَقَدْ ذَكَّرَتْهُمْ جِفاناً نَمَتْكَ","إِلَى كلِّ ملكٍ رفيعِ العِمادِ",38,"د",1,0],["وقد ذهبتْ بصبري واجباتٌ","اِباءُ النَّفْسِ يمنعُ أنْ تُقالا",39,"ل",2,0],["وقد ذقتُ حلو الوجد فيك ومرَّهُ","وأرضعتُ في سهل التباريح والصعب",40,"ب",1,0],["وقد ذهبتْ عنها البشاشةُ بعدَما","تأنَّقَ مرآها وطابَ صعيدُها",41,"د",3,0],["وَقَد ذَرَفَت لِفَقدِ الكَر","مِ فيها أَعيُنُ العِنَبِ",42,"ب",1,0],["وقدْ ذَكَرْتِني لهُ","وتمَّ فيهِ أَمَلي",43,"ي",1,0],["وقد ذاب قلبي اليوم شوقاً وصبوةً","إليك وما ترثي لقلبي منهما",44,"م",2,0],["وَقَد ذَكَرنَ لي بِالكَثيبِ مُؤالِف","قِلاص عدى او قِلاص بَني وَبرِ",45,"ر",1,0],["وقدْ ذَهَبَ الخوارِجُ نَحْوَ هَذا","وما مِثلُ الخوارِجِ من يَقُود",46,"د",1,0],["وَقَد ذَهَبوا عَن طَريقِ الصّوابِ","وأنتَ عليه وما ثَمَّ ثانِ",47,"ن",1,0],["وقد ذلّ وقد كان","محلَّ العزِّ نَجْرانُ",48,"ن",1,0],["وقد ذادهم عن ورد حوض نبينا","لدينا بتبديل من الوهم غالب",49,"ب",1,0],["وقد ذكرت ذاك أن من نفى","ليس يشاهد على ما وصفا",50,"ف",2,0],["وقد ذكرت قبل هذا في الخبر","إنكار من شهدهم ممن حضر",50,"ر",1,0],["وقد ذكرت في الكتاب أولا","إيجابهم كفر الذي قد حولا",50,"ل",2,0],["وقد ذكرت قبل ذا أحداثه","وجوره في الحكم والتياثه",50,"ه",1,0],["وقد ذكرت شرطه عليهم","بذاك إذ قدمه إليهم",50,"م",1,0],["وقد ذكرت بالذي تقدما","من جعل القسم بذاك سلما",50,"م",2,0],["وقد ذكرت ههنا منونها","وسوف أحكي بعد ذا عيونها",50,"ه",2,0],["وقد ذكرت ذاك فيما قد مضى","وجئت بالحجة فيه وانقضى",50,"ض",2,0],["وقد ذكرت أمرها في باب","من قبل هذا الباب في الكتاب",50,"ب",1,0],["وقد ذكرت السبق والفضيلة","بالطهر في مسائل طويلة",50,"ه",1,0],["وقد ذكرت الرد فيما اصله","وقوله يعلم من قد حصله",50,"ه",1,0],["وقد ذكَرُوا البحرَ المحيطَ وَإِنَّما","نَدَاهُ هو البحْرُ الذي البَحرُ نَهرُه",51,"ر",2,0]]}