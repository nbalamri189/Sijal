{"poems":[[53,"متشبث بعلائقي متخلص","https://www.aldiwan.net/poem64932.html","الكامل"],[87,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[50,"قد أغتدي قبل طلوع الشمس","https://www.aldiwan.net/poem64350.html","الرجز"],[190,"كن ظريفا وكن أديبا حكيما","https://www.aldiwan.net/poem43285.html","الخفيف"],[409,"أما آن للقلب أن يعقلا","https://www.aldiwan.net/poem33484.html","المتقارب"],[438,"يا برق سق حيا السحاب الأبرقا","https://www.aldiwan.net/poem12682.html","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46665",""],[1985,"","https://poetry.dctabudhabi.ae/diwan/poem/132427","المتدارك"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88665","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87494","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[5085,"قالت لنا","https://www.poetsgate.com/ViewPoem.aspx?id=188399",""]],"verses":[["كن ظل بيت لا يزول ولا تكن","ظل السحاب يُظِلُّ ثم يقلّصُ",0,"ص",1,0],["كُن ظَهيراً لِأَهلِها وَنَصيراً","وَاِبذُلِ النُصحَ بَعدَ ذَلِكَ مَحضا",1,"ض",2,0],["كَنَظَرِ المَجنونِ أَو ذي المَسِّ","حَتّى إِذا أَقصَدَ بَعدَ الحَبسِ",2,"س",1,0],["كن ظريفا وكن أديبا حكيما","ربّ كلبا ولا تربّ يتيما",3,"م",2,1],["كنظم صفي الهدى من غدا","هو السحر لكنه لي حلال",4,"ل",1,0],["كنظام مدحِ الحافظِ الحَبْرِ الذي","راقَ المسامعَ والعيونَ منَمقا",5,"ق",2,0],["كنظمِ مناقبِ تاج الملو","كِ أصبحَ يُعجزني رصفُها",6,"ف",3,0],["كنظيم اللؤلؤ مبسمه","حلو صافيه مبدده",7,"د",2,0],["كنظامي ساحبا ذيل الغرور","فوق هام النجم وهو الاجدر",8,"ر",1,0],["كنظامي وهو فيكم عطر","حيث قد كان له المسك ختام",8,"م",1,0],["كَنَظيرِ ما رجلٌ تكهنَّ قائلاً","للطفل وهو بمهدِهِ لا يفقَهُ",9,"ه",1,0],["كَنَظمِهِ البَدِيعِ فِى أُسلُوبِهِ","وَعَجزِ مَن بَارَاهُ عَن مَطلوبِهِ",10,"ه",1,0],["كنْ ظَالمِي ، أرضَى بسيفكَ قاتلي","حُكمُ الهَوَى في عَاشقٍ مَقبولُ",11,"ل",1,0]]}