رُني نائِماً وَيَقظانا",0,"ن",2,0],["أَبصَرتُ شَيباً بِمَولاها فَوا عَجَبا","لَمِن يَراها وَيَبدو الشَيبُ في الراسِ",1,"س",1,0],["أَبصَرتُهُ يَوماً فَساءَلتُهُ","عَنها وَكانَت تِلكَ عاداتي",2,"ت",2,0],["أَبصَرتُ هَيكَلَ عَظمِهِ","فَذَكَرتُ سُكّانَ المَقابِر",3,"ر",1,0],["أَبصَروا في حِماكَ غَيثاً وَناراً","ذاكَ يَهمي وَتِلكَ تَذكو لَهيبا",4,"ب",2,0],["أَبصَرتَ جِنّاً في مَسالِخِ فِتيَةٍ","وَشَهِدتَ أَفئِدَةً مِنَ الصُوّانِ",5,"ن",1,0],["أَبصَروا مَوقِفي فَعَزَّ عَلَيهِم","مِنكَ قُربي وَمِن عُلاكَ اِنتِسابي",6,"ب",2,0],["أَبْصَرَهَا إِنسِيَّةً تَنْجَلِي","فِي المَعْبَدِ الأَكْبَرِ يَوْمَ الْخِتَامْ",7,"م",1,0],["أُبْصُقْ دُخَاناً بِوَجْهِ المُعْتَدِي وَلظىً","إِذَا الْتَفَتَّ تُحَاذِيِهِ وَفِيكَ فَمُ",8,"م",1,0],["أبصر الحق بالعمى","لم يضره عمى البصر",9,"ر",1,0],["أَبصِر فَإِنَّ أَميرَ المُؤمِنينَ لَهُ","أَعلى الفُروعِ وَحَيثُ اِستَجمَعَ الوادي",10,"ي",1,0],["أَبصَرنَ أَنَّ ظُهورَ الأَرضِ هائِجَةٌ","وَقَلَّصَ الرَطبُ إِلّا أَن يُرى سِرَرُ",11,"ر",1,0],["أَبصَرتِ أَنَّ وُجوهَهُم قَد شَفَّها","ما لا يَشُفُّكِ مِن سُرىً وَسَمومِ",12,"م",1,0],["أَبصَرَتني بِمَكانِ موسى قائِماً","في النورِ فَوقَ الطورِ حينَ تَراني",13,"ي",1,0],["أبصرتُ زوجتَهُ يوماً بحضرَته","وقد علتْ دون سقفِ البيت رِجْلاها",14,"ا",3,0],["أبصرتْ في صِقاله صُوَراً من","ه قِباحاً فأظهرت تكليحا",15,"ح",2,0],["أبْصَرْتَ عُودِي عَارياً فكَسَوْتَهُ","وقَدِ الْتَحَى مِنْهُ زَمَانِي مَا الْتَحَى",16,"ح",2,0],["أبصر بيضاء في القَذالِ فلا","نَفْرٌ كنفرٍ رأيتُهُ نَفَره",17,"ر",2,0],["أبصرتُه والكأسُ بين فمٍ","منه وبين أنامل خمس",18,"س",1,0],["أبصرت باقةَ نرجسٍ","في كف من أهواه غضَّهْ",19,"ه",1,1],["أبصارهُم نحو السماءِ كأنما","بَصَروا بها تُطوى بكفَّيْ كاشِطِ",20,"ط",1,0],["أبصر أشياء فيك منفسةً","إذا رآها مذمَّمٌ لهفا",21,"ف",2,0],["أبصرَ الفرصةَ الأميرُ لعمري","فيك وهْو المسدَّدُ الأفعالِ",22,"ل",1,0],["أبصرتْ نفسُه الذي هو لاقٍ","فرأت منه منظرَ الأهوالِ",23,"ل",1,0],["أبصرتُه ساجداً للأير مبتهلاً","فقلتُ أعظمتَ كفراً بعد إيمانِ",24,"ن",1,0],["أبصرتُها بين أترابٍ هَززْن على","عَقْد الزنانير بالكُثبان أغصانا",25,"ن",2,0],["أَبصَرَتهُ فَأَكبَرَت أَن تَرى في ال","جَوِّ صَيّادَها عَلى الغَبراءِ",26,"ا",2,0],["أَبصَرتُها وَالشَمسُ عِندَ شُروقِها","فَرَأَيتُها مَغمورَةً بِالنارِ",27,"ر",1,1],["أَبصَرتُها في الخَمس وَالعَشرِ","فَرَأَيتُ أُختَ الرِئم وَالبَدرِ",28,"ر",1,1],["أَبصَرتُ كَأَنِّيَ في مَوضِع","ما فيهِ غَيرُ الأَرواحِ",29,"ح",1,0],["أَبصَرتَ نَفسَكَ أَصبَحت","مَستورَةً فَهَتَكتَها",30,"ت",3,0],["أَبصَرتُ وَجهَكَ ثُمَّ قُل","تُ لِمُقلَتي أَبصَرتِ مِصرا",31,"ر",2,0],["أُبصِرُ المَوتَ إِذا أَب","صَرَ غَيري مَن عَشِقتُهُ",32,"ت",2,0],["أبصَرتُ طَرفَكَ عِندَ مُشتَجَرِ القَنا","فَبَدا لِطَرفي أَنَّهُ فَلَكُ",33,"ك",1,1],["أَبصَرتُ رُشدي في النَدى","فالبُخلُ عِندي كالضَلالْ",34,"ل",1,0],["أَبصَرُا الطَعنَ في القُلوبِ دِراكاً","قَبلَ أَن يُبصِروا الرِماحَ خَيالا",35,"ل",2,0],["أَبصَرتُهُ في المَنامِ مُعتَذِراً","إِلَيَّ مِمّا أَتاهُ يَقظانا",36,"ن",2,0],["أبصرْتَ عسكرَ نجدةٍ بِحَياً","منه إذا ما شامَ عَسكَرُه",37,"ر",2,0],["أَبصَرتُ مَن وافى مَنِيَّتَهُ","فَكَأَنَّ حُبَّ حَبيبِهِ بُغضُ",38,"ض",1,0],["أبصرتُهُ فرأيتُ أبدعَ منظرٍ","ثم انثنيتُ بناظري محسورا",39,"ر",2,0],["أبصروا دمعي فخافوا","قلتُ لا تخشَوا بكائي",40,"ي",1,1],["أَبصَرتُها لَيلَةً وَنِسوَتِها","يَمشينَ بَينَ المَقامِ وَالحَجَرِ",41,"ر",1,0],["أَبصَروهُمْ بِعُيونٍ حَلَّقتْ","تكشفُ السِّرَّ وتَهدِي ذَا العَمى",42,"م",2,0],["أَبصَرَ الهُدَّامَ جَمّاً فَبَنى","ذَلِكَ المَجدُ الأَشَمُّ الأَطوَلُ",43,"ل",1,0],["أبصرتَها في نُورِ ربّك ما رأت","عيناك آفاقاً لها وتخوما",44,"م",2,0],["أبصرتُها عند الصباحِ ال","غضِّ تشبه كوكْبَهْ",45,"ب",2,0],["أَبصَرتُ وَجهاً لَها في جِيدِهِ تَلَعٌ","تَحتَ العُقُودِ وَفي القُرطَينِ تَشمِيرُ",46,"ر",1,0],["أَبصَرتُهُ في المَنامِ مُعتَذِراً","إِلَيَّ مِمّا جَناهُ يَقظانا",47,"ن",2,1],["أَبصارُنا تَجني مَحاسِنَ وَجهِهِ","فَفُؤادُ كُلِّ فَتىً بِهِ مَفتونُ",48,"ن",1,0],["أَبصَرتُ في بَغدادَ رومِيَّه","تَقصُرُ عَنها كُلُّ أُمنِيَّه",49,"ي",2,1],["أَبصَرتُ رُشدي وَهَجَرتُ المُنى","وَرُبَّما ذَلَّت لَهُنَّ الرِقاب",50,"ب",1,0],["أبصرتُ في المرآةِ آخرَ قصّتي","ونَعَى بها نفسي إليّ الناعي",51,"ي",1,0],