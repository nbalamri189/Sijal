{"poems":[[463,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95320","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102986","الكامل"],[5277,"هجاءُ البدر","https://www.poetsgate.com/ViewPoem.aspx?id=192282",""],[5821,"يوم السبت - مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=114115",""]],"verses":[["فَكاكُك أيّها القلبُ الأسيرُ","غداً لو قال حادي الركبِ سِيروا",0,"ر",3,1],["فكَّاكُ أعناق الملوك فإن يُرِد","أسراً لها لم يقضَ منه فكاكُ",1,"ك",1,0],["فكّاك معتقل مغيث طريدة","يا دهره خييت بين الأدهر",2,"ر",1,0],["فكاكاً من قيودِ الذنبِ إنّي","أخافُ اللهَ من سوءِ المآلِ",3,"ل",1,0],["فكاكها من كل غاصب وغدار","من هيبته ترعا بليا حراسه",4,"س",2,0]]}