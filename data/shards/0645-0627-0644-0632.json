{"poems":[[92,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[32,"يَا دَارَ مَيَّة َ بَالْخَلْصَاءِ غيَّرَهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20514&r=&rc=8",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[463,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62893","المنسرح"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83556","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72564","الرجز"],[4578,"راع القلوب مصابٌ جاء بالعجب","https://www.poetsgate.com/ViewPoem.aspx?id=49352",""]],"verses":[["ما لزَوجي إذا ذَكَرتُ له الأنسَ","وما أرتجي من العيشِ أنا",0,"ن",2,0],["مالزتُ أطردُ في آثارهمْ بصري","وَالشوْقُ يَقْتَادُ مِنْ ذي الْحَاجَة ِ الْبَصَرَا",1,"ر",2,0],["ما لِزيتاءَ ما لسيناءَ ما لل","كهفِ كالغارِ بالحبيبِ اِلتقاءُ",2,"ا",2,0],["ما لزماني على احتشامي","في بسطهِ الجورَ لي ومالي",3,"ل",2,0],["مال زهواً وصِباً","وتثني مرحا",4,"ح",2,0],["ما لزمانٍ عَدا عليهِ عَدّتْ","عليه أُمُّ الربيقِ من نُوبِهْ",5,"ب",2,0],["ما لزهر النجوم تنظر شزوا","في البرايا كأعين العذال",6,"ل",1,0],["ما لَزمتُ الحمى وَقمت بِباب ال","لهِ حقّاً مُستَطلعاً أَسرارا",7,"ر",2,0],["ما لزماني دون كل الأزمن","أوقعه الله بداء مزمن",8,"ن",1,1],["ما لزمان يرينا كل نائبة","تزيل معنى رضا الأيام بالغضب",9,"ب",1,0]]}