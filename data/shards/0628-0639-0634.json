{"poems":[[36,"إذا طلعت شمس النهار فسلمي","https://www.aldiwan.net/poem4908.html","الطويل"],[74,"تعشقتها في الحلي غصناء منثورا","https://www.aldiwan.net/poem18770.html","الطويل"],[35,"وإنك لو بلغتها قولي اسلمي","https://www.aldiwan.net/poem25875.html","الطويل"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/12322","الطويل"],[93,"الشاعر والأمة","https://www.poetsgate.com/ViewPoem.aspx?id=53088",""],[136,"ثلاث ليال حين جاز ينير","https://www.aldiwan.net/poem54674.html","الطويل"],[290,"ظننا الجو خال من مجيب","https://www.aldiwan.net/poem39383.html","الوافر"],[366,"بروضة هذا النظم نزهت ناظري","https://www.aldiwan.net/poem68054.html","الطويل"],[463,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59119","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28615","المتقارب"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132315","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199149","المجتث"],[3842,"","https://poetry.dctabudhabi.ae/diwan/poem/20039","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111470","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111468","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58104","الوافر"],[4940,"وادٍ غير ذي يأسِ","https://www.poetsgate.com/ViewPoem.aspx?id=215165",""],[5753,"أنا والليل","https://www.poetsgate.com/ViewPoem.aspx?id=210864",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5861,"سلام على المصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=188059",""],[5918,"أُحبُّكِ فلتسألي الذَّارياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=177711",""],[5953,"سئمت المقام بنادي حلب","https://www.poetsgate.com/ViewPoem.aspx?id=93858",""],[6070,"بثوبٍ مِنَ الثَّلجِ البَريءِ تلحَّفا","https://www.poetsgate.com/ViewPoem.aspx?id=197532",""]],"verses":[["بِعَشرِ تَحِيّاتٍ إِذا الشَمسُ أَشرَقَت","وَعَشرٍ إِذا اِصفَرَّت وَحانَ رُجوعُها",0,"ع",3,0],["بعشر نهنيه ويمناه في الندى","بخمس يهنينا الغمام مطيرا",1,"ر",2,0],["بِعَشرِ تَحِيّاتٍ إِذا الشَمسُ أَشرَقَت","وَعَشرٍ إِذا اِصفَرَّت وَحانَ وُقوعُها",2,"ع",3,0],["بِعِشرينَ مِن صُغرى النُجومِ كَأَنَّها","وَإِياهُ في الخَضراءِ لَو كانَ يَنطِقُ",3,"ق",1,0],["بعشق الأمر الذي تعشقه","فاذا ما استنكرته استنكره",4,"ر",2,0],["بعشرِ فيه العوا وخمس ومارسٌ","بعاشرِه يبدُو السماكُ ويظهرُ",5,"ر",1,0],["بعشر دقائق حررت فاقبل","وغض الطرف عن عيب الحبيب",6,"ب",1,0],["بِعَشر جَماد أَوّل كان نُسخَة","بِعام لَه تاريخ مَجد مختم",7,"م",1,0],["بعشواءَ من فرطِ البكاء كأنما","تواعدَ نارُ الحيِّ بَيْناً ونورُها",8,"ر",3,0],["بِعَشْرَةِ الآفٍ مُسَوَّمَةٍ لَهَا","مَطَالِعُ فِي أفْقِ العُلَى وَمَغَارِبُ",9,"ب",1,0],["بِعَشْر أَيْدِيهِنَّ وَالضُغْبُوسا","حَصْبَ الغُواةِ العَوْمَجَ المَنْسُوسا",10,"س",2,0],["بِعِشرينَ أَنفَقتُها في الصُّدودِ","وَجُدتُ بِها في زَمانِ النَّوى",11,"ا",1,0],["بعَشيَّةٍ فَصلَ الربيعِ خَرَجتُ كي","أبغي لنفسي بعضَ ما رغباتِها",12,"ت",3,0],["بَعَشائِهِ السِر تالي رَخصِهِ","من رُسلِهِ الأَقَدامَ رمزاً للنَقا",13,"ا",1,0],["بعشر صوم أتانا","له جوادٌ علاه",14,"ا",2,0],["بِعَشرِ مِئينَ لِلمُلوكِ سَعى بِها","لِيُحمَدَ سَيّارُ بنُ عَمرٍو فَأَسرَعا",15,"ع",2,0],["بِعِشرينَ حُسناً فُقنَ بَعدَ هِلانَةٍ","تَحُز بِانتِقاها خِيرَةَ المُتَخَيِّرِ",16,"ر",1,0],["بعشرين هكطور مثلك لا","أبالي إذا ما الغبار علا",17,"ل",2,0],["بِعِشرِينَ حُسناً فُقنَ غَيرَ هِلاَنَةٍ","لَهُ بِانتِقَاها خِيرَةُ المُتَخَيِّرِ",18,"ر",1,0],["بعشرٍ مع ثمانٍ قد توالَتْ","من الآياتِ في الذِّكْرِ الجليلِ",19,"ل",1,0],["بعشبةٍ من يقين رِيُّهَا أمَلٌ","وحسن ظن تَرَبَّى في حِمَى الشمسِ",20,"س",1,0],["بعشق واموت ف الغناوي","وساعات بدوب م الأنين",21,"ن",1,0],["بعشرة ألآف والفين مشية","لها في تراب الزعفران خطورها",22,"ر",3,0],["بعشقي إليكَ الآنَ أرنو لجَنّةٍ","ففيها حبوري أن بقربِكَ تبقيني",23,"ن",2,0],["بِعشقٍ لَهُ ليسَ مِنْ ذا الوُجودِ","ومَا بَعدَ أَشْيَائِه الفَانِيَة",24,"ي",2,0],["بعشرهم الحجج البالغات","وبالثاني العشر المرتقب",25,"ب",1,0],["بعشرِ الوَصايا قَدْ تَعَلَّقَ صُبْحُهُ","ينادي على سقراطَ هاتِ التفَلْسُفا",26,"ف",2,0]]}