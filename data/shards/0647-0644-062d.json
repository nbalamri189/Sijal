{"poems":[[53,"أشكو إليك مدامعا تكف","https://www.aldiwan.net/poem29967.html","الكامل"],[24,"هل حبل رملة قبل البين مبتور","https://www.aldiwan.net/poem21897.html","البسيط"],[93,"عمر قطعت مداه قبل أوان","https://www.aldiwan.net/poem11222.html","الكامل"],[30,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[27,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[51,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[51,"هل حاكم عدل الحكومة","https://www.aldiwan.net/poem66013.html","مجزوء الكامل"],[105,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[102,"جنى عليك الحسن يا وردتي","https://www.aldiwan.net/poem33063.html","أحذ المديد"],[52,"هل حدثتك النفس فيما قد ترى","https://www.aldiwan.net/poem26923.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55342","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[113,"عذري اليك غرام لا اكيفه","https://www.aldiwan.net/poem40885.html","عموديه"],[118,"إن وجها رأيته ليلة السب","https://www.aldiwan.net/poem49368.html","الخفيف"],[184,"لاموا الحسود وأكثروا في ذمه","https://www.aldiwan.net/poem44072.html","الكامل"],[202,"هل حان أن تتعطفا","https://www.aldiwan.net/poem53245.html","مجزوء الكامل"],[279,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[280,"يا صاح أيقظ راقد العود","https://www.aldiwan.net/poem32809.html","السريع"],[361,"هل حبل شماء قبل البين موصول","https://www.aldiwan.net/poem1715.html","البسيط"],[400,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[456,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[503,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[549,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[565,"هل حاكم يعدي على ظبية","https://www.aldiwan.net/poem69552.html","السريع"],[584,"لي من هواك بعيده وقريبه","https://www.aldiwan.net/poem17420.html","الكامل"]],"verses":[["هَل حُسنُ ذاكَ الدَهرِ مُرتَجَعٌ","أَم طيبُ ذاكَ العَيشِ مُؤتَنَفُ",0,"ف",1,0],["هَل حَبلُ رَملَةَ قَبلَ البَينِ مَبتورُ","أَم أَنَتَ بِالحِلمِ بَعدَ الجَهلَِ معذورُ",1,"ر",1,1],["هَلْ حَلَّ خَطْبٌ بِالشَّآمِ وَأَهْلِهِ","إِلاَّ تَقَاسَمَ شَجْوَخُ القُطْرَانِ",2,"ن",1,0],["هَل حَبلُ خَرقاءَ بَعدَ الهَجرِ مَرمومُ","أَم هَل لَها آخِرَ الأَيّامِ تَكليمُ",3,"م",1,0],["هَل حُلَّتِ الوَدّاءُ بَعدَ مَحَلِّنا","أَو أَبكُرُ البَكَراتِ أَو تِعشارُ",4,"ر",1,0],["هل حكمةٌ أنَّ قفلَ كفك لا","يفتَح إلا بمِفتَح العُذَرِ",5,"ر",1,0],["هل حاكمٌ عدلُ الحكو","مةِ مُنصفٌ لي من ظَلومِ",6,"م",1,1],["هل حارب الله إلا كلُّ ذي سَفَهٍ","أو شاغَبَ الحقَّ إلا كلُّ مأجورِ",7,"ر",1,0],["هلْ حسبوا غضَك لمّا دنا","سهلَ الجنى",8,"ن",2,0],["هَل حَدَّثَتكَ النَفسُ فيما قَد تَرى","فَلَرُبَّما صَدَقَت أَماني الأَنفُسِ",9,"س",1,1],["هَلْ حِمىً أَنْتُمْ بَنُوهُ يُضَامُ","لا يُضَامُ الحِمَى وَفِيهِ كِرَامُ",10,"م",1,1],["هَلْ حَبا الآدَابَ تاجٌ مِثْلَما","صاحِبُ التَّاج بِمِصْرٍ قَدْ حَباها",11,"ا",3,0],["هل حسبتم حساب يوم عصيبٍ","يُشعلُ الشيبُ فيه رأسَ الوليد؟",12,"د",1,0],["هل حرف القول حسادي وملت لهم","وحاسد القول بهتانا يحرفه",13,"ف",2,0],["هل حباك الإله بالحسن إلّا","لنرى فيك آيهُ تتجلى",14,"ل",2,0],["هل حاسد حسد الفقير على القرى","أو حاسد أحدا على القبح",15,"ح",1,0],["هل حان أن تتعطَّفا","أم بَعدُ قلبُك ما اشتفى",16,"ف",2,1],["هل حيلة في لقاء صد عن أملي","فيه من الدهر تبديل وتحويل",17,"ل",1,0],["هَل حَدَق الغزلانِ غازَلنَنا","أَم لَحَظاتُ الخُرَّدِ الغيدِ",18,"د",1,0],["هَل حَبلُ شَمّاءَ قَبلَ البَينِ مَوصولُ","أَم لَيسَ لِلصُرمِ عَن شَمّاءَ مَعدولُ",19,"ل",1,1],["هل حاسد أنت لما ناله","أم طامع فيما لديه وفي",20,"ي",1,0],["هل حملَتْ لا حملَتْ بعدنا","عنك الصَّبا عَرْفاً لمستنشقِ",21,"ق",1,0],["هل حطّ موسى من السماءِ فاختلفا","عمّن أحاطوهُ واحتذوا به مَثلا؟",22,"ل",2,0],["هلْ حظُّنا منها وإن عظمتْ بها الن","نَعماء إلّا مَشْربٌ أو مطعمُ",23,"م",1,0],["هَلْ حَاكِمٌ يُعْدِي عَلَى ظَبْيَةٍ","ظَالِمَةٍ فِي كُلِّ أَحْوَالِهَا",24,"ل",3,1],["هَلْ حُرْمَةٌ أَوْ رَحْمَةٌ لِمُتيَّمٍ","قَدْ قَلَّ فِيكَ نَصِيرُهُ وَنَصِيبُهُ",25,"ب",2,0]]}