{"poems":[[55,"أشكو إليك مدامعا تكف","https://www.aldiwan.net/poem29967.html","الكامل"],[24,"هل حبل رملة قبل البين مبتور","https://www.aldiwan.net/poem21897.html","البسيط"],[95,"عمر قطعت مداه قبل أوان","https://www.aldiwan.net/poem11222.html","الكامل"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[29,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[53,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[53,"هل حاكم عدل الحكومة","https://www.aldiwan.net/poem66013.html","مجزوء الكامل"],[107,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[104,"جنى عليك الحسن يا وردتي","https://www.aldiwan.net/poem33063.html","أحذ المديد"],[54,"هل حدثتك النفس فيما قد ترى","https://www.aldiwan.net/poem26923.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55342","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[119,"عذري اليك غرام لا اكيفه","https://www.aldiwan.net/poem40885.html","عموديه"],[124,"إن وجها رأيته ليلة السب","https://www.aldiwan.net/poem49368.html","الخفيف"],[190,"لاموا الحسود وأكثروا في ذمه","https://www.aldiwan.net/poem44072.html","الكامل"],[208,"هل حان أن تتعطفا","https://www.aldiwan.net/poem53245.html","مجزوء الكامل"],[286,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[287,"يا صاح أيقظ راقد العود","https://www.aldiwan.net/poem32809.html","السريع"],[368,"هل حبل شماء قبل البين موصول","https://www.aldiwan.net/poem1715.html","البسيط"],[409,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[510,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[556,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[572,"هل حاكم يعدي على ظبية","https://www.aldiwan.net/poem69552.html","السريع"],[591,"لي من هواك بعيده وقريبه","https://www.aldiwan.net/poem17420.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138226",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48770","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64056","الكامل"],[917,"","https://poetry.dctabudhabi.ae/diwan/poem/34516","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70863","السريع"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129528","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59715","البسيط"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138089",""],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44928","الخفيف"],[1381,"","https://poetry.dctabudhabi.ae/diwan/poem/98198","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49967","البسيط"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101913","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126670","البسيط"],[1891,"","https://poetry.dctabudhabi.ae/diwan/poem/27048","البسيط"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76645","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202170","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123040","الرجز"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101439","السريع"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101422","السريع"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131318","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201491","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101609","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89119","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88890","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109887","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91397","الرمل"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36773","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66583","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102968","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75719","المنسرح"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36380","الدوبيت"],[4089,"","https://poetry.dctabudhabi.ae/diwan/poem/198743","البسيط"],[4201,"","https://poetry.dctabudhabi.ae/diwan/poem/143818","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94512","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94385","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94494","البسيط"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/19008","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73289","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83143","البسيط"],[2052,"هَل حكم ينصفني فِي هوى","https://www.poetsgate.com/ViewPoem.aspx?id=189602",""],[4767,"شمس الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=179940",""],[4814,"ليل الصامتين","https://www.poetsgate.com/ViewPoem.aspx?id=193676",""],[4830,"آهاتُ شعبي","https://www.poetsgate.com/ViewPoem.aspx?id=198931",""],[4830,"ياصَبيَّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=210819",""],[4852,"منتهى تيهي","https://www.poetsgate.com/ViewPoem.aspx?id=214411",""],[4984,"لَوْلَا ..","https://www.poetsgate.com/ViewPoem.aspx?id=201164",""],[2365,"هل حكيم يردّ داء المشيب","https://www.poetsgate.com/ViewPoem.aspx?id=96142",""],[5246,"يا نسيم الصبح هل أخبرتني","https://www.poetsgate.com/ViewPoem.aspx?id=187067",""],[5296,"شفاهُ حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=155351",""],[5324,"ما عاد سجيل العراق يقضّهم .","https://www.poetsgate.com/ViewPoem.aspx?id=207471",""],[5351,"سؤال الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=202130",""],[5582,"طَيْفٌ سَرَى وَثِيابُ اللَّيْلِ أَخْلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=63545",""],[5638,"ملحمة حر","https://www.poetsgate.com/ViewPoem.aspx?id=197920",""],[5750,"مطرٌ على الرمقِ الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=214642",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[402,"عمر قطعت مداه قبل أوان","https://www.poetsgate.com/ViewPoem.aspx?id=36485",""],[5956,"عساك اْخترتَني؟","https://www.poetsgate.com/ViewPoem.aspx?id=192131",""],[5956,"أقصوصة شاعر وحانوت","https://www.poetsgate.com/ViewPoem.aspx?id=193640",""],[5956,"هل حاتم الطيىء نحو الأرض قد عادا؟","https://www.poetsgate.com/ViewPoem.aspx?id=194010",""],[5956,"عساك اْخترتَني بدلاً من التدخين؟","https://www.poetsgate.com/ViewPoem.aspx?id=194190",""]],"verses":[["هَل حُسنُ ذاكَ الدَهرِ مُرتَجَعٌ","أَم طيبُ ذاكَ العَيشِ مُؤتَنَفُ",0,"ف",1,0],["هَل حَبلُ رَملَةَ قَبلَ البَينِ مَبتورُ","أَم أَنَتَ بِالحِلمِ بَعدَ الجَهلَِ معذورُ",1,"ر",1,1],["هَلْ حَلَّ خَطْبٌ بِالشَّآمِ وَأَهْلِهِ","إِلاَّ تَقَاسَمَ شَجْوَخُ القُطْرَانِ",2,"ن",1,0],["هَل حَبلُ خَرقاءَ بَعدَ الهَجرِ مَرمومُ","أَم هَل لَها آخِرَ الأَيّامِ تَكليمُ",3,"م",1,0],["هَل حُلَّتِ الوَدّاءُ بَعدَ مَحَلِّنا","أَو أَبكُرُ البَكَراتِ أَو تِعشارُ",4,"ر",1,0],["هل حكمةٌ أنَّ قفلَ كفك لا","يفتَح إلا بمِفتَح العُذَرِ",5,"ر",1,0],["هل حاكمٌ عدلُ الحكو","مةِ مُنصفٌ لي من ظَلومِ",6,"م",1,1],["هل حارب الله إلا كلُّ ذي سَفَهٍ","أو شاغَبَ الحقَّ إلا كلُّ مأجورِ",7,"ر",1,0],["هلْ حسبوا غضَك لمّا دنا","سهلَ الجنى",8,"ن",2,0],["هَل حَدَّثَتكَ النَفسُ فيما قَد تَرى","فَلَرُبَّما صَدَقَت أَماني الأَنفُسِ",9,"س",1,1],["هَلْ حِمىً أَنْتُمْ بَنُوهُ يُضَامُ","لا يُضَامُ الحِمَى وَفِيهِ كِرَامُ",10,"م",1,1],["هَلْ حَبا الآدَابَ تاجٌ مِثْلَما","صاحِبُ التَّاج بِمِصْرٍ قَدْ حَباها",11,"ا",3,0],["هل حسبتم حساب يوم عصيبٍ","يُشعلُ الشيبُ فيه رأسَ الوليد؟",12,"د",1,0],["هل حرف القول حسادي وملت لهم","وحاسد القول بهتانا يحرفه",13,"ف",2,0],["هل حباك الإله بالحسن إلّا","لنرى فيك آيهُ تتجلى",14,"ل",2,0],["هل حاسد حسد الفقير على القرى","أو حاسد أحدا على القبح",15,"ح",1,0],["هل حان أن تتعطَّفا","أم بَعدُ قلبُك ما اشتفى",16,"ف",2,1],["هل حيلة في لقاء صد عن أملي","فيه من الدهر تبديل وتحويل",17,"ل",1,0],["هَل حَدَق الغزلانِ غازَلنَنا","أَم لَحَظاتُ الخُرَّدِ الغيدِ",18,"د",1,0],["هَل حَبلُ شَمّاءَ قَبلَ البَينِ مَوصولُ","أَم لَيسَ لِلصُرمِ عَن شَمّاءَ مَعدولُ",19,"ل",1,1],["هل حاسد أنت لما ناله","أم طامع فيما لديه وفي",20,"ف",2,0],["هل حملَتْ لا حملَتْ بعدنا","عنك الصَّبا عَرْفاً لمستنشقِ",21,"ق",1,0],["هل حطّ موسى من السماءِ فاختلفا","عمّن أحاطوهُ واحتذوا به مَثلا؟",22,"ل",2,0],["هلْ حظُّنا منها وإن عظمتْ بها الن","نَعماء إلّا مَشْربٌ أو مطعمُ",23,"م",1,0],["هَلْ حَاكِمٌ يُعْدِي عَلَى ظَبْيَةٍ","ظَالِمَةٍ فِي كُلِّ أَحْوَالِهَا",24,"ل",3,1],["هَلْ حُرْمَةٌ أَوْ رَحْمَةٌ لِمُتيَّمٍ","قَدْ قَلَّ فِيكَ نَصِيرُهُ وَنَصِيبُهُ",25,"ب",2,0],["هل حبكم للجاه يدفعكم إلى","عمل سخيف فيه كل قادح",26,"ح",1,0],["هل حين تحتفل المدائن والقرى","بك يرجف الوادي عليه حداد",27,"د",1,0],["هل حظُّ خدِّك من ربيعِ زمانِنا","إِلا كَحظِّ قلوبنا من صيفه",28,"ف",2,0],["هَل حَلَّتِ الشَمسُ فيهِ دونَ أَبرُجِها","أَو غُيِّبَ البَدرُ فيهِ فَهوَ مَستورُ",29,"ر",1,0],["هلْ حيلةٌ لي فيكِ من بعدما","تباعدتْ منا ومنك الديارْ",30,"ر",1,0],["هل حفظوا الود كما حفظته","أم حملوا العهد على ظهر القلى",31,"ا",1,0],["هل حبيبي يرتجي صب بكم","عطفة أو زورةً تجلو الشجن",32,"ن",1,0],["هل حبيب على الزمان وفي","ضوؤه الطلق غير ضوء الشموس",33,"س",1,0],["هَل حَلالٌ دِماؤُنا","لِلظِباءِ الرَبائِب",34,"ب",1,0],["هل حلّ بالعَذْلِ لاحٍ من أخي كمَدٍ","ما ظلّ بالحبّ داعي الوجد يعقِدُه",35,"د",2,0],["هل حانَ للصبّ قربٌ من أَحبته","أَوحان منه على الفقدان مُصْطَبرُ",36,"ر",1,0],["هل حك ناصية السهى","بالكف ذو الباع القصير",37,"ر",1,0],["هل حروب البسوس مثل سواها","أو تحاكي الغطمطم الأنداء",38,"ا",2,0],["هل حرضتني على السير الحثيث سوى","بيد تضوّر منها الذئب والنمر",39,"ر",1,0],["هَل حُبُّكَ اليَومَ عَن شَنباءَ مُنصَرِفُ","وَأَنتَ ما عِشتَ مِجنونٌ بِها كَلِفُ",40,"ف",1,1],["هل حاد بي من مذهب عن واجب","أو لم يقدني للجميل ذمام",41,"م",1,0],["هل حافظٌ عَهْدَ ودّي من حَفِظْتُ له","على النَّوى عَهْدَ ودٍّ لا أُضْيِّعُهُ",42,"ع",2,0],["هل حلّ عينيه عمى","أم حلّ قلبه عمه",43,"م",2,0],["هَلْ حَكَمٌ يُنصِفُني من هَوى","مُصَارِعٍ يَصرَعُ أُسْدَ الشَّرَى",44,"ر",2,1],["هَلْ حَكَمٌ يُنصفُني فَهْوَ لي","مُصَارِعٌ يَصْرَعُ أُسْدَ الشَّرَى",45,"ر",2,1],["هل حبيبي شمسٌ وإلاّ هلالٌ","أم من الحور أم من الوِلْدنِ",46,"ن",1,0],["هَل حَدَّثَتكُم قَطّ أنفُسُكُم بِذَا","فَسَلُوا نُفُوسَكمُ عَنِ الإِيمَانِ",47,"ن",1,0],["هل حازها في بدر أو أحد أو ال","فتح المبين وبيعة الرضوان",47,"ن",1,0],["هل حقوقٌ ما تقضت بعد ما","في أراك الشعب ناوحت الحماما",48,"م",2,0],["هل حاكم أشكو اليه ظُلامتي","حتى يزيل الطرق عن طرُقاتي",49,"ت",2,0],["هل حيينا قبل الوجود وهل نبعث","بعد الردى وفي أي أرض",50,"ض",1,0],["هل حادث العباسُ عابسَ حادثٍ","إلا تبسم ضاحكاً بالبشر",51,"ر",1,0],["هل حلَّ وِرْدٌ له حلوٌ لِوُرَّدِهِ","لمهمل المهمل اللوَّام للهمم",52,"م",1,0],["هل حَلَّ مضجعيَ النُغُولُ تغلُّباً","أم هل تَحقَّقَ في الأَنام زِنائي",53,"ا",2,0],["هَل حَبيبُ القَلب وافى","هَل أَنيسُ النَفس وَالى",54,"ل",2,0],["هَل حَبلُ خَولَةَ بَعدَ الهَجرِ موصولُ","أَم أَنتَ عَنها بَعيدُ الدارِ مَشغولُ",55,"ل",1,1],["هَل حَلّ ذَلِكَ في الشَرعِ القَويم لَهُ","أَم ذاكَ قانونُ مَعلومٍ بِلا سَقَمِ",56,"م",1,0],["هل حسبوه راضياً ان يرى","دماء مخلوقاته تهرق",57,"ق",1,0],["هَلْ حاكِمٌ يُنْصِفُ قَلْبِي فَقَدْ","تَحَكَّمَ الحُبُّ عَلَيْهِ وَجارْ",58,"ر",1,0],["هل حيلة تهدي إليك فاهتدي","ولو أن مسكنها شفار حديد",59,"د",1,0],["هل حاكم من طبعه السماح","يسلك بيننا سبيل القصد",60,"د",1,0],["هل حك للانسان مثل ظفره","لم يقض للمحبوب حق قدره",60,"ه",1,0],["هَل حلو حلو اللمى لصاد","حام الهَوى وَحوله وحلا",61,"ل",2,1],["هَل حَرُّ أَضالعي يُلاقي بَردا","أَو أصعدُ ذَلِكَ الكَثيبَ الفَردا",62,"د",2,1],["هل حرقة القلب تطفي قول: أوّاهُ؟","أم ترتوي وجنتي من دمع مجراهُ",63,"ا",2,1],["هل حسن كافور كمس","ك في حكومة ذي اعتبار",64,"ر",1,0],["هل حل قتل الصبّ في شرع الهوى","أم جاز أن يصمي الخَليلُ خليله",65,"ل"