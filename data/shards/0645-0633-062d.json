{"poems":[[55,"قنا آل فهر لا قنا غطفان","https://www.aldiwan.net/poem29661.html","الطويل"],[55,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[24,"مسح النبي جبينه","https://www.aldiwan.net/poem21894.html","مجزوء الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[53,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[31,"لقد غدوت على الندمان لا حصر","https://www.aldiwan.net/poem6163.html","البسيط"],[93,"أنا لست في دنيا الخيال ولا الكرى","https://www.aldiwan.net/poem8868.html","عموديه"],[64,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[47,"لولا تعنفني لقلت المنزل","https://www.aldiwan.net/poem65578.html","الكامل"],[68,"ونصرانية بتنا جوارا","https://www.aldiwan.net/poem39662.html","الوافر"],[82,"إني لأبسط للقبول إذا سرت","https://www.aldiwan.net/poem31477.html","الكامل"],[33,"أدخل الله رب موسى وعيسى","https://www.aldiwan.net/poem42206.html","الخفيف"],[76,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[76,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[104,"هواك أصبح نسيا","https://www.aldiwan.net/poem32994.html","المجتث"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[50,"عج للوقوف على راح وريحان","https://www.aldiwan.net/poem65297.html","البسيط"],[48,"غدوت مريض العقل والدين فالقني","https://www.aldiwan.net/poem22294.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142013","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141913","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[29,"وأَقبَّ كالسِّرحان تم له","https://www.poetsgate.com/ViewPoem.aspx?id=180957",""],[0,"قفا نبك من ذِكرى حبيب ومنزل ( معلقة )","https://www.poetsgate.com/ViewPoem.aspx?id=4730",""],[33,"أدخلَ اللهُ، ربُّ موسى وعيسى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18978&r=&rc=241",""],[113,"شمس الضحى وأهلة الأعياد","https://www.aldiwan.net/poem16500.html","الكامل"],[173,"كم أرجع الزفرات في أحشائي","https://www.aldiwan.net/poem1594.html",""],[177,"أنكر العبد بزه وحلاه","https://www.aldiwan.net/poem4381.html","عموديه"],[203,"عثرت في مدارها الأيام","https://www.aldiwan.net/poem45167.html","الخفيف"],[234,"حللت عقد المعاني فاعتلى الكلم","https://www.aldiwan.net/poem50824.html","البسيط"],[303,"ما لها تشرق حمرا أتراها","https://www.aldiwan.net/poem36835.html","عموديه"],[369,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[369,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[408,"وبي معذر خد ورد وجنته","https://www.aldiwan.net/poem46748.html","البسيط"],[416,"مسحت ربيعة وجه معن سابقا","https://www.aldiwan.net/poem67526.html","الكامل"],[435,"لقد زرت من أهوى وقد زار آخر","https://www.aldiwan.net/poem40254.html","الطويل"],[438,"حمد السرى من كنت وجه صباحه","https://www.aldiwan.net/poem12584.html","الكامل"],[466,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[504,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[520,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107238","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66748","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70905","الكامل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216852","الهزج"],[1033,"","https://poetry.dctabudhabi.ae/diwan/poem/18179","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64634","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78122","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78041","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79846","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79842","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77799","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66284","الرمل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198392","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137441",""],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124680","الخفيف"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124670","السريع"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146355","الخفيف"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146318","الكامل"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145880","الرمل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126263","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62820","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216765",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66532","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59494","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102959","الكامل"],[3986,"","https://poetry.dctabudhabi.ae/diwan/poem/20924",""],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81296","المنسرح"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105505","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72643","الكامل"],[4916,"الضيق عمَي والجروح عيالي","https://www.poetsgate.com/ViewPoem.aspx?id=135375",""],[5055,"قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=106078",""],[3591,"أناني منديل الحبيبة مرسلا","https://www.poetsgate.com/ViewPoem.aspx?id=149399",""],[5106,"ذَاْكَ عُذْرٌ تَاْفِهٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137255",""],[5121,"مسح الظّلام","https://www.poetsgate.com/ViewPoem.aspx?id=213686",""],[5281,"مُلهمتي","https://www.poetsgate.com/ViewPoem.aspx?id=199304",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5370,"أمومتي","https://www.poetsgate.com/ViewPoem.aspx?id=85528",""],[5431,"أتى مسرعا قلبي إليك ليسجدا","https://www.poetsgate.com/ViewPoem.aspx?id=191581",""],[5455,"الريح والناي","https://www.poetsgate.com/ViewPoem.aspx?id=213958",""],[5598,"فوانيس السماء","https://www.poetsgate.com/ViewPoem.aspx?id=213905",""],[5616,"إلى من كان صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=205215",""],[5742,"مناجاة ودعاء","https://www.poetsgate.com/ViewPoem.aspx?id=206896",""],[5809,"المطلع","https://www.poetsgate.com/ViewPoem.aspx?id=205135",""],[5976,"الحب بقلوب المخاليق","https://www.poetsgate.com/ViewPoem.aspx?id=30822",""],[2336,"والله لا أنسى النعامة ليلة","https://www.poetsgate.com/ViewPoem.aspx?id=52748",""],[520,"لك ان تقول اذا اردت وتفعلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577604",""]],"verses":[["مَسَحتُ بِحِلمي ضِغنَهُ عَن جَنانِهِ","فَلَمّا أَبى مَسَّحتُهُ بِسِناني",0,"ن",2,0],["مُسِحَت جِباهُ الوانِياتِ وَلُطِّمَت","مِن دونِ غايَتِها العِتاقُ القُرحُ",1,"ح",1,0],["مَسَحَ النَبِيُّ جَبينَهُ","فَلُه بَياضٌ بِالخُدودِ",2,"د",1,1],["مِسَحٍّ إِذا ما السابِحاتُ عَلى الوَنى","أَثَرنَ غُباراً بِالكَديدِ المُرَكَّلِ",3,"ل",1,0],["مسح شيراز عينها","شغلُها والتنغُّف",4,"ف",1,0],["مُسَحسِحَةٍ تَنفي الحَصى عَن طَريقِها","يُطَيِّرُ أَحشاءَ الرَعيبِ اِنثِرارُها",5,"ر",3,0],["مُسحَنفِراً مِن جِبالِ الرومِ تَستُرُهُ","مِنها أَكافيفُ فيها دونَهُ زُوَرُ",6,"ر",1,0],["مِسحاجُ عونٍ طَوَتهُ البيدُ صَيفَتَهُ","فَالضِلعُ كاسِيَةٌ وَالكَشحُ مُضطَمِرٌ",7,"ر",1,0],["مَسَحَت بِإِصبَعِها الحَياةُ جُفونَهُ","فَرأى المَحاسِنَ فَاِنتَقى وَتَخَيَّرا",8,"ر",2,0],["مُسِحتْ على الأنواءِ راحَتُهُ","فانساقَ منها العارضُ الهَطِلُ",9,"ل",1,0],["مَسَحوا أَكُفَّهُم بِكَفِّ خَليفَةٍ","نَجَمَت بِدَولَتِهِ الحُقوقُ الأُفَّلُ",10,"ل",1,0],["مَسَحتُ يَدي عَلى خَدٍّ أَسيلٍ","فَعادَت فِيَّ بَعدَ المَوتِ روحُ",11,"ح",1,0],["مَسَحَتْ كراقيةٍ عليّ بكفّها","ونقابُها ندٌّ من الزّهَرِ النّدي",12,"د",2,0],["مَسَحَتهُ مِن كَفِّها بِقَميصي","حينَ طافَت بِالبَيتِ مَسحاً رَفيقا",13,"ق",2,0],["مَسَحَت جُفونَ الرَكبِ مِن سِنَةِ الكَرى","وَلَوَتهُمُ طَرَباً عَلى الأَكوارِ",14,"ر",1,0],["مَسَحتُ لَهُ عَن ناظِرِيَّ صَبابَةً","وَأَقلِل بِدَمعي مِن قَضاءِ ذِمامِ",15,"م",1,0],["مَسَحَ الأَذى وَمَحا وَصِيَّةَ بُطرِسٍ","ماحي العُروشِ وَماسِحُ التيجانِ",16,"ن",1,0],["مَسَحتْه ظهراً مِنكَ طالَ مُنيفهُ","حتَّى تَمنَّى لو يكونكَ يذبُلُ",17,"ل",1,0],["مسحتُ آثارَ حُبّ","كانت على شفتيّا",18,"ي",2,0],["مَسَحَتْ ثُغورُ الشامِ أدمُعَها بهِ","ولقد تَبُلُّ التُّرْبَ وهي هُمُول",19,"ل",1,0],["مَسحولَةٌ مُزَّةٌ كَالمِسكِ قَرقَفَةٌ","تُطَيِّرُ الهَمَّ عَن حَيزومِ حَرّانِ",20,"ن",1,0],["مَسَحتُ يَدَي مِن كُلِّ هَذا فَلَيتَني","أَبَهتُ لِشَأني قَبلَ شَيبِ المَسائِحِ",21,"ح",1,0],["مسحَ الهلالُ دمَ الصليبِ وضمّدتْ","جُرْحَ الأهلَّةِ راحةُ الصلبانِ",22,"ن",1,0],["مَسَحَتْ راحةُ الكَرَى أعيُنَ الناس","فَنَامَتْ وَنَامَ فيها الغرامُ",23,"م",1,0],["مسحتُ عن جفنِها الأسيانِ دمعتهُ","حتى ترقرق فيه الأنسُ والجزَلُ",24,"ل",1,0],["مسح الذهولُ عليكما","يده، فما تتحوّلانْ",25,"ن",1,0],["مَسَحَتْ مِصْرُ بهِ عَيْنَ الكَرَى","بَعْدَ أَنْ طالَ عَلَى مِصْرٍ كَراها",26,"ا",3,0],["مُسْحَنْفِر الجنبين مُلْتَئمٍ","ما بين شِيمَتِهِ إلى الغُرِّ",27,"ر",1,0],["مسحٍّ إذا ما السابحاتُ على الونا","أثرنَ غباراً بالكديد المركل",28,"ل",1,0],["مسحتهُ من كفها بقميصي،","حِينَ طَافَتْ بِکلبَيْتِ مَسْحاً رَفِيقا",29,"ق",2,0],["مَسح المُنى مِن زور طَيفك راحَةً","مِن بَعد ما غَسل البُكاء رُقادي",30,"د",2,0],["مَسَحوكُمُ كَالضَّبعِ حَتّى أُوثِقَت","جُددُ الجِبالِ بِرِجلِها العَرجاءِ",31,"ا",2,0],["مَسَحَت كَفُّهُ عَلَيَّ مَسِيحاً","قَصَدَ الضُّرَّ عَامِداً فَشَفَاهُ",32,"ا",2,0],["مسحتهُ الجنانُ أم مسختهُ","وتولاهُ جللٌ أم عزامُ",33,"م",1,0],["مسحوبة الذَّيْل ما تَنْبو مصمِّمة","في كلّ طَوْدٍ بحَدٍّ ليسَ يَنْثلِمُ",34,"م",1,0],["مَسَحَ النورُ دموع الليلِ عَنْ","وجنْةِ الأزهارِ إذْ قبَّلَ فاها",35,"ا",3,0],["مَسحْتُ له العَينَيْنِ منّي تَشكُّكاً","وما كان طَرْفي بين مُغْفٍ ويَقْظان",36,"ن",1,0],["مسَح الدُّموعَ عنِ الجفونِ مُغالطاً","لكنْ رأَيْنا جَيْبَهُ مَبْلولا",37,"ل",2,0],["مسحتُ آثار لثمي خيفةً بيدي","حتّى اكْتَسَتْ أرجاً من نشرهِ العَبَق",38,"ق",1,0],["مَسَحَت رَبيعَةُ وَجهَ مَعنٍ سابِقاً","لَمّا جَرى وَجَرى ذَوو الأَحسابِ",39,"ب",1,1],["مسحت جبيني باللبان فقال لي","مشيراً لبيتٍ ما جرى بيننا عتب",40,"ب",1,0],["مَسحا البلادَ بعدْلِ سيرٍ ودِّ لو","عادَ المسيحُ فعاد في أمْساحه",41,"ح",2,0],["مسحنفر الخطو غطى الشمس عثيره","فيه السَّوابقُ والغرُّ المناجيد",42,"د",1,0],["مَسَحوا لِحاهُم ثُمَّ قالوا سالِموا","يا لَيتَني في القَومِ إِذا مَسَحوا اللِحى",43,"ا",1,0],["مسحت بنو رزيك غيرة لاحق","ما أملوه بسابق لم يلحق",44,"ق",1,0],["مسحت بنو رزيك غرتك التي","جعلتك عزتها أغر محجلا",45,"ل",2,0],["مسَحَ الإِلهُ على النَّوَاصِي مِنهُمُ","فهُمُ الملوكُ بِمسحةِ الرَّحمنِ",46,"ن",1,0],["مسحنفِرٌ في غَيِّه متتابعٌ","في الشتم مَثِّلُهُ بِخيلٍ يَسْجَعُ",47,"ع",1,0],["مسْحَنْفرٍ مُثْعنْجرٍ مُغْلَنْطِفٍ","هتانِ محلول النطاق مجَلْجِل",48,"ل",1,0],["مسحّ لا يواري العي","رُ منه عصرَ اللّهب",49,"ب",1,0],["مَسَحناكَ مَسحَ الكَلبِ إِذ أَنتَ باسِطٌ","ذُناباكَ حَتّى اِشتَلتَ لِلناسِ أَعقَدا",50,"د",2,0],["مسحته من ربه بركات","حسبه بينهن باء وراء",51,"ا",2,0],["مَسَحتُ بِأَطراف البَنان مَدامِعي","فَعُدنا خضاباً في الأَكُف كَما تَرى",52,"ر",2,0],["مَسَحَت مَدامِعُهُ بِراحَة لُطفِها","فَاخضرَّ آس عذارهِ مِن كَفِها",53,"ه",2,0],["مسحت قلبَ العُلى فرحتُه","بيدٍ ما تركت فيه نُدوبا",54,"ب",2,0],["مسحت غبارَ الداءِ منك بصحَّةٍ","كانت لوجه المكرُمات جلاءا",55,"ا",3,0],["مسح الإِلَه جبينها بجماله","وَجلا غَريب جمالها بجلال",56,"ل",1,0],["مسح الدمع يدٌ من مقلتي","ويدي من جورها تشكو السقاما",57,"م",2,1],["مسحَ الدّموعَ عن اليتامى رحمةً","أكرمْ بهِ في رحمةِ الآباءِ",58,"ا",2,0],["مُسحَنفِرٌ تُذري سَنابِكُه الحَصى","فَكأنَّ تَذراهُ نَوىً مَعجومُ",59,"م",1,0],["مسحت باطراف البنان مدامعي