tps://www.poetsgate.com/ViewPoem.aspx?id=206762",""],[5072,"إليكِ من فراش المرض","https://www.poetsgate.com/ViewPoem.aspx?id=53686",""],[5145,"ناصر الإسلام عيد ألف عام","https://www.poetsgate.com/ViewPoem.aspx?id=108072",""],[5277,"لحن الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=185565",""],[5277,"منْ أوراق عاشقٍ بغداديٍّ..","https://www.poetsgate.com/ViewPoem.aspx?id=202037",""],[5277,"طائفُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=208587",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5497,"كجنةٍ عرضت","https://www.poetsgate.com/ViewPoem.aspx?id=209013",""],[5497,"مر السحائب","https://www.poetsgate.com/ViewPoem.aspx?id=210555",""],[5533,"الصَّمْتُ مَلاذٌ وسِتَار","https://www.poetsgate.com/ViewPoem.aspx?id=177099",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5809,"هوى خاص","https://www.poetsgate.com/ViewPoem.aspx?id=205369",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[5942,"بغداد. يا لغة الدنيا وجنتها","https://www.poetsgate.com/ViewPoem.aspx?id=215593",""],[5956,"الأسلوبُ الحديديُّ","https://www.poetsgate.com/ViewPoem.aspx?id=185589",""],[5956,"الحِسّ الحيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=192121",""],[6093,"كالحق ينزل في ضيافة باطل","https://www.poetsgate.com/ViewPoem.aspx?id=205866",""],[6124,"سوريا","https://www.poetsgate.com/ViewPoem.aspx?id=109745",""],[6229,"ملاكي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65181&r=&rc=8",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""]],"verses":[["كَجَنَّةٍ كَانَ فِيهَا","أحِبَّةٌ آهِلُونَا",0,"ن",2,0],["كَجَامِعَة كُنْتَ حَتَّى المَمَا","تِ أَسَاساً لِبُنْيَانِهَا الْقَائِمِ",1,"م",1,0],["كَجِرْحٍ قَدْ أُلَطِّفْهُ بِلَمْسِي","وَإِنْ هُوَ مَسَّهُ غَيْرِي أُضَامُ",2,"م",1,0],["كَجَرباءَ دُسَّت بِالهَناءِ فَأُقصِيَت","بِأَرضٍ خَلاءٍ أَن تُفارِقَها الإِبلُ",3,"ل",1,0],["كَجيدِ الرَئمِ أَتلَع لا قَصيراً","لَهُ غُضنٌ وَلا قَفراً عَطولا",4,"ل",2,0],["كجبال تَرى البراكينَ فيها","تقذف الموت جارفاً والنُحوسا",5,"س",2,0],["كَجَمرِ الغَضا هَبَّت بِهِ بَعدَ هَجعَةٍ","مِنَ اللَيلِ أَرواحُ الصِبا فَتَنَسَّما",6,"م",2,0],["كَجَفنَةَ وَالقَمقامِ عَمروُ بنِ عامِرٍ","وَأَولادِ ماءِ المُزنِ وَاِبني مُحَرَّقِ",7,"ق",1,0],["كجمالِ دين الله وابنِ شهابهِ","لا الظلمُ حيث يرى ولا الظلماء",8,"ا",2,0],["كجمال دين الله إنَّ له هوىً","بجميله وهوى سواه بحمله",9,"ل",2,0],["كجليب رَيَّا الروضِ بات يُشيعه","نفح الصِّبا في ليلة مِدْجان",10,"ن",1,0],["كجمال هذا العالَم البسَّامِ","واخفقْ مع العِطْر المرفرفِ في الفضا",11,"ض",2,0],["كَجيادِ السَبقِ لَن تُغنِيَها","أَدَواتُ السَبقِ ما تُغني الفِطَر",12,"ر",1,0],["كَجُنودِ عَمروٍ أَينَما رَكَزوا القَنا","عَفّوا يَداً وَمُهَنَّداً وَسِنانا",13,"ن",2,0],["كَجَبينٍ وَعارِضٍ وَقَوامٍ","وَثُغورٍ وَأَعيُنٍ وَخُدودِ",14,"د",1,0],["كَجُنود اللَه طارَت خَيلُهُم","يَوم بَدرٍ في سَماءِ القسطل",15,"ل",1,0],["كَجَبرٍ وَعبد اللَه طابَ ثَراهُما","وَلا زالَ فَوّاح الشَذى ريِّق النَدى",16,"د",2,0],["كَجُبَّةِ الساجِ فَحافاتُها","صُبحٌ جَلا خُضرَةَ أَهدامِها",17,"م",3,0],["كَجَزورِ الأَيسارِ لا كَبِدٌ في","ها لَباغٍ وَلا عَلَيها سَنامُ",18,"م",1,0],["كَجاري السَرابِ تَرى لَمعَهُ","وَلَستَ بِواجِدِهِ عِندَكَم",19,"م",1,0],["كَجُذوَةِ موقِدٍ وَسِراجِ لَيلٍ","وَماءِ حَبِيَّةٍ وَشَفا ذُبالِ",20,"ل",1,0],["كَجَأْبٍ يَرْتَعِي بِجُنُوب فَلْجٍ","تُؤَامَ البَقْلِ في أَحْوَى مَرِيعِ",21,"ع",1,0],["كَجَمْرِ الغَضَى فَوْقَ النَّقَا هَبَّتِ الصَّبَا","لهُ مَوْهِناً مِنْ عَارِضٍ مُبَتَسِّمِ",22,"م",1,0],["كَجَنَى الكَحْصِ ما تَرامى إليها النْ","نَمْلُ قَصْراً للحَمْلِ عيراً فَعِيرا",23,"ر",2,0],["كجَوارٍ سَابِحَاتٍ خُرَّدٍ","سَابِقاتٍ فِي تبَارِيهَا وَحَسْرَى",24,"ر",2,0],["كجدار ينهار ، فوق جدار","كغبار ، يستنزف الريح جنسا",25,"س",2,0],["كجراد له حوافير خيل","كملاه ، من بولها تتحسا",25,"س",2,0],["كجنين في نهدي أم","لهفى تتمنى أن تحبل",26,"ل",1,0],["كجمر الغضا هبت به، بعد هجعة","من الليل، أروح الصبَّا، فتنسما",27,"م",2,0],["كجليبٍ من البضائعِ يأتيكم من","العالمينَ وجةٌ جليب",28,"ب",1,0],["كجنة يفوح طيب روضها","والشهد عطريا حكى زلالها",29,"ل",3,0],["كَجِنَاسٍ مُلَفَّقٍ أَو جِنَاسٍ","تَمَّ أو لَمحةٍ مِنَ التَّوشِيعِ",30,"ع",1,0],["كَجودِ المُظَفَّرِ سَيفِ الإِمامِ","وَعُدَّتِهِ المُصطَفى المُنتَجَب",31,"ب",1,0],["كَجَامِ بِلَّوْرٍ بِهِ","قُرَاضَةٌ مِنَ الذَّهَبْ",32,"ب",1,0],["كَجودِ اِبنِ مَسعود الفَتى الواهِبِ اللُّها","وَمُخجِلِ مُنهَلِّ الحَيا في اِنسِكابِهِ",33,"ب",2,0],["كَجَوارٍ قُمنَ في ال","خِدمَةِ مِن حَولِ السِماطِ",34,"ط",1,0],["كجدك تركي الذي جاء وحده","وفي كفه من صنعة الهند أعضب",35,"ب",1,0],["كجناحِ الطَّيرِ مُنبسِطٌ","لَكُما مُنبَسِطٌ إبطي",36,"ط",2,0],["كَجَوارِي الرَّمْلِ جَارِيَة","كُلُّ تَعطير بِتَعْطيلِ",37,"ل",1,0],["كَجُودِكَ أو كَجُودِ أَبِيكَ هامٍ","عَميمُ الْوَدْقِ مُنْبَجِسٌ هَطُولُ",38,"ل",1,0],["كَجَيبِ الدِفنِسِ الورها","ءَ ريعَت وَهيَ تَستَفلي",39,"ي",1,0],["كَجُمانَةِ البَحرِيِّ جاءَ بِها","غَوّاصُها مِن لُجَّةِ البَحرِ",40,"ر",1,0],["كَجرد الصافِنات قَد اِمتَطوها","وَفي يَدهم لِطاعتها عنانُ",41,"ن",1,0],["كَجَمرِ غَضاً هَبَّت لَهُ وَهوَ ثاقِبٌ","بِمَروَحَةٍ لَم تَستَتِر رِيحُ شَمأَلِ",42,"ل",1,0],["كجمعِ سُلَيْمانَ النبيِّ بصِهْرِكُمْ","ذوي يَمَنٍ والشامِ والجِنِّ والإنسِ",43,"س",1,0],["كجوهرة الغوّاص كانت يتيمةً","على اللمس والتقليبِ أغلى وأثمنا",44,"ن",2,0],["كجوهرةِ الغوّاصِ دلّاهُ حظُّه","عليها فأهوَى ما استطاع وعمَّقا",45,"ق",2,0],["كجراحِ الهوى لهُنّ جِراحٌ","ليس تُرقى ولا يُصابُ دَواها",46,"ا",3,0],["كَجَيبِ الدَفنِسِ الوَرها","ءِ ريعَت بَعدَ إِجفالِ",47,"ل",1,0],["كجيش الإمام العدل من آل فيصل","به كل فتاك له يصحب النصر",48,"ر",1,0],["كجسمكَ جسمي أَصبح اليوم بالياً","ولكنَّ ما بِي عاد للنَّاسِ بَاديَا",49,"ي",2,1],["كَجُودِكَ أَوْ كَخُلْقِكَ يَوْمَ سِلْمٍ","فَذَا فَضْلٌ وَذَا حَسنٌ وسَهْلُ",50,"ل",1,0],["كَجَيبِ الدفُيسِ الوَرها","ريعَت وَهيَ تَستَفلي",51,"ل",2,0],["كَجَوهَرٍ مُختَلِفٍ أَلوانُهُ","أَسلَمَهُ سِلكُ نَظامٍ فَاِنتَثَرْ",52,"ر",1,0],