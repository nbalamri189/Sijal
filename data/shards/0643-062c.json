{"poems":[[93,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[93,"لقد فدح الخطب في قاسم","https://www.aldiwan.net/poem11334.html","المتقارب"],[93,"قوامك لا يعادله قوام","https://www.aldiwan.net/poem11346.html","الوافر"],[30,"عفا الزرق من أطلال مية فالدحل","https://www.aldiwan.net/poem29547.html","الطويل"],[30,"خليلي اسألا الطلل المحيلا","https://www.aldiwan.net/poem29549.html","الوافر"],[88,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[11,"أتعرف أطلالاَ ونؤيا مهدم","https://www.aldiwan.net/poem268.html",""],[23,"ألم ترنا أولاد عمرو بن عامر","https://www.aldiwan.net/poem21343.html","الطويل"],[72,"وعدت بطيف خيالها هيفاء","https://www.aldiwan.net/poem18174.html","الكامل"],[72,"ما مثل قلبي ساليا عن مثله","https://www.aldiwan.net/poem19480.html","الكامل"],[51,"يا هل تعود سوالف الأزمان","https://www.aldiwan.net/poem66471.html","الكامل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[85,"سر يا صليب الرفق في ساح الوغى","https://www.aldiwan.net/poem63731.html","الطويل"],[66,"خلياني أجر فضل برودي","https://www.aldiwan.net/poem38801.html","الخفيف"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[102,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[50,"يا ابن موسى ماذا يقول الإمام","https://www.aldiwan.net/poem62248.html","الخفيف"],[50,"ونبئت قوما بهم جنة","https://www.aldiwan.net/poem62253.html","المتقارب"],[46,"وبالي فيك يا دنيا وبالي","https://www.aldiwan.net/poem23231.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[11,"أتَعْرِفُ أطْلالاً ونُؤياً مُهَدَّما","https://www.poetsgate.com/ViewPoem.aspx?id=16870",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[113,"مهلا احادي العيس واتركها لها","https://www.aldiwan.net/poem40615.html","عموديه"],[130,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[141,"حمى النوم أجفان صب وصب","https://www.aldiwan.net/poem11724.html","المتقارب"],[153,"يا حسنها من وردة","https://www.aldiwan.net/poem55494.html","مجزوء الرجز"],[167,"أراه الهوى ما لم يكن في حسابه","https://www.aldiwan.net/poem1608.html",""],[233,"يا علي يومنا أو","https://www.aldiwan.net/poem31893.html","مجزوء الرمل"],[237,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[268,"سبحت في الماء كالبط","https://www.aldiwan.net/poem35271.html","المديد"],[273,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[278,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[285,"وقد أختلس الطعنة","https://www.aldiwan.net/poem1888.html","الهزج"],[285,"أصرمت حبل الوصل من فتر","https://www.aldiwan.net/poem1918.html","أحذ الكامل"],[351,"أدر راح الصفا ولك الأمان","https://www.aldiwan.net/poem39769.html","الوافر"],[361,"غشيت بِقرا فرط حول مكمل","https://www.aldiwan.net/poem1723.html","الطويل"],[436,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[456,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[456,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[512,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[541,"تقيم المأتم الأعلى","https://www.aldiwan.net/poem1763.html","الهزج"],[562,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[573,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[584,"فديتك كم علي عليك عذل","https://www.aldiwan.net/poem17649.html","الوافر"]],"verses":[["كَجَنَّةٍ كَانَ فِيهَا","أحِبَّةٌ آهِلُونَا",0,"ن",2,0],["كَجَامِعَة كُنْتَ حَتَّى المَمَا","تِ أَسَاساً لِبُنْيَانِهَا الْقَائِمِ",1,"م",1,0],["كَجِرْحٍ قَدْ أُلَطِّفْهُ بِلَمْسِي","وَإِنْ هُوَ مَسَّهُ غَيْرِي أُضَامُ",2,"م",1,0],["كَجَرباءَ دُسَّت بِالهَناءِ فَأُقصِيَت","بِأَرضٍ خَلاءٍ أَن تُفارِقَها الإِبلُ",3,"ل",1,0],["كَجيدِ الرَئمِ أَتلَع لا قَصيراً","لَهُ غُضنٌ وَلا قَفراً عَطولا",4,"ل",2,0],["كجبال تَرى البراكينَ فيها","تقذف الموت جارفاً والنُحوسا",5,"س",2,0],["كَجَمرِ الغَضا هَبَّت بِهِ بَعدَ هَجعَةٍ","مِنَ اللَيلِ أَرواحُ الصِبا فَتَنَسَّما",6,"م",2,0],["كَجَفنَةَ وَالقَمقامِ عَمروُ بنِ عامِرٍ","وَأَولادِ ماءِ المُزنِ وَاِبني مُحَرَّقِ",7,"ق",1,0],["كجمالِ دين الله وابنِ شهابهِ","لا الظلمُ حيث يرى ولا الظلماء",8,"ا",2,0],["كجمال دين الله إنَّ له هوىً","بجميله وهوى سواه بحمله",9,"ل",2,0],["كجليب رَيَّا الروضِ بات يُشيعه","نفح الصِّبا في ليلة مِدْجان",10,"ن",1,0],["كجمال هذا العالَم البسَّامِ","واخفقْ مع العِطْر المرفرفِ في الفضا",11,"ض",2,0],["كَجيادِ السَبقِ لَن تُغنِيَها","أَدَواتُ السَبقِ ما تُغني الفِطَر",12,"ر",1,0],["كَجُنودِ عَمروٍ أَينَما رَكَزوا القَنا","عَفّوا يَداً وَمُهَنَّداً وَسِنانا",13,"ن",2,0],["كَجَبينٍ وَعارِضٍ وَقَوامٍ","وَثُغورٍ وَأَعيُنٍ وَخُدودِ",14,"د",1,0],["كَجُنود اللَه طارَت خَيلُهُم","يَوم بَدرٍ في سَماءِ القسطل",15,"ل",1,0],["كَجَبرٍ وَعبد اللَه طابَ ثَراهُما","وَلا زالَ فَوّاح الشَذى ريِّق النَدى",16,"د",2,0],["كَجُبَّةِ الساجِ فَحافاتُها","صُبحٌ جَلا خُضرَةَ أَهدامِها",17,"م",3,0],["كَجَزورِ الأَيسارِ لا كَبِدٌ في","ها لَباغٍ وَلا عَلَيها سَنامُ",18,"م",1,0],["كَجاري السَرابِ تَرى لَمعَهُ","وَلَستَ بِواجِدِهِ عِندَكَم",19,"م",1,0],["كَجُذوَةِ موقِدٍ وَسِراجِ لَيلٍ","وَماءِ حَبِيَّةٍ وَشَفا ذُبالِ",20,"ل",1,0],["كَجَنَى الكَحْصِ ما تَرامى إليها النْ","نَمْلُ قَصْراً للحَمْلِ عيراً فَعِيرا",21,"ر",2,0],["كجَوارٍ سَابِحَاتٍ خُرَّدٍ","سَابِقاتٍ فِي تبَارِيهَا وَحَسْرَى",22,"ر",2,0],["كجمر الغضا هبت به، بعد هجعة","من الليل، أروح الصبَّا، فتنسما",23,"م",2,0],["كجليبٍ من البضائعِ يأتيكم من","العالمينَ وجةٌ جليب",24,"ب",1,0],["كجنة يفوح طيب روضها","والشهد عطريا حكى زلالها",25,"ل",3,0],["كَجِنَاسٍ مُلَفَّقٍ أَو جِنَاسٍ","تَمَّ أو لَمحةٍ مِنَ التَّوشِيعِ",26,"ع",1,0],["كَجودِ المُظَفَّرِ سَيفِ الإِمامِ","وَعُدَّتِهِ المُصطَفى المُنتَجَب",27,"ب",1,0],["كَجَامِ بِلَّوْرٍ بِهِ","قُرَاضَةٌ مِنَ الذَّهَبْ",28,"ب",1,0],["كَجودِ اِبنِ مَسعود الفَتى الواهِبِ اللُّها","وَمُخجِلِ مُنهَلِّ الحَيا في اِنسِكابِهِ",29,"ب",2,0],["كَجَوارٍ قُمنَ في ال","خِدمَةِ مِن حَولِ السِماطِ",30,"ط",1,0],["كجدك تركي الذي جاء وحده","وفي كفه من صنعة الهند أعضب",31,"ب",1,0],["كجناحِ الطَّيرِ مُنبسِطٌ","لَكُما مُنبَسِطٌ إبطي",32,"ط",2,0],["كَجَوارِي الرَّمْلِ جَارِيَة","كُلُّ تَعطير بِتَعْطيلِ",33,"ل",1,0],["كَجُودِكَ أو كَجُودِ أَبِيكَ هامٍ","عَميمُ الْوَدْقِ مُنْبَجِسٌ هَطُولُ",34,"ل",1,0],["كَجَيبِ الدِفنِسِ الورها","ءَ ريعَت وَهيَ تَستَفلي",35,"ي",1,0],["كَجُمانَةِ البَحرِيِّ جاءَ بِها","غَوّاصُها مِن لُجَّةِ البَحرِ",36,"ر",1,0],["كَجرد الصافِنات قَد اِمتَطوها","وَفي يَدهم لِطاعتها عنانُ",37,"ن",1,0],["كَجَمرِ غَضاً هَبَّت لَهُ وَهوَ ثاقِبٌ","بِمَروَحَةٍ لَم تَستَتِر رِيحُ شَمأَلِ",38,"ل",1,0],["كجمعِ سُلَيْمانَ النبيِّ بصِهْرِكُمْ","ذوي يَمَنٍ والشامِ والجِنِّ والإنسِ",39,"س",1,0],["كجوهرة الغوّاص كانت يتيمةً","على اللمس والتقليبِ أغلى وأثمنا",40,"ن",2,0],["كجوهرةِ الغوّاصِ دلّاهُ حظُّه","عليها فأهوَى ما استطاع وعمَّقا",41,"ق",2,0],["كجراحِ الهوى لهُنّ جِراحٌ","ليس تُرقى ولا يُصابُ دَواها",42,"ا",3,0],["كَجَيبِ الدَفنِسِ الوَرها","ءِ ريعَت بَعدَ إِجفالِ",43,"ل",1,0],["كجيش الإمام العدل من آل فيصل","به كل فتاك له يصحب النصر",44,"ر",1,0],["كجسمكَ جسمي أَصبح اليوم بالياً","ولكنَّ ما بِي عاد للنَّاسِ بَاديَا",45,"ي",2,1],["كَجُودِكَ أَوْ كَخُلْقِكَ يَوْمَ سِلْمٍ","فَذَا فَضْلٌ وَذَا حَسنٌ وسَهْلُ",46,"ل",1,0]]}