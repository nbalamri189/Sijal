{"poems":[[93,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[93,"لقد فدح الخطب في قاسم","https://www.aldiwan.net/poem11334.html","المتقارب"],[93,"قوامك لا يعادله قوام","https://www.aldiwan.net/poem11346.html","الوافر"],[30,"عفا الزرق من أطلال مية فالدحل","https://www.aldiwan.net/poem29547.html","الطويل"],[30,"خليلي اسألا الطلل المحيلا","https://www.aldiwan.net/poem29549.html","الوافر"],[88,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[11,"أتعرف أطلالاَ ونؤيا مهدم","https://www.aldiwan.net/poem268.html",""],[23,"ألم ترنا أولاد عمرو بن عامر","https://www.aldiwan.net/poem21343.html","الطويل"],[72,"وعدت بطيف خيالها هيفاء","https://www.aldiwan.net/poem18174.html","الكامل"],[72,"ما مثل قلبي ساليا عن مثله","https://www.aldiwan.net/poem19480.html","الكامل"],[51,"يا هل تعود سوالف الأزمان","https://www.aldiwan.net/poem66471.html","الكامل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[85,"سر يا صليب الرفق في ساح الوغى","https://www.aldiwan.net/poem63731.html","الطويل"],[66,"خلياني أجر فضل برودي","https://www.aldiwan.net/poem38801.html","الخفيف"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[102,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[50,"يا ابن موسى ماذا يقول الإمام","https://www.aldiwan.net/poem62248.html","الخفيف"],[50,"ونبئت قوما بهم جنة","https://www.aldiwan.net/poem62253.html","المتقارب"],[46,"وبالي فيك يا دنيا وبالي","https://www.aldiwan.net/poem23231.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[11,"أتَعْرِفُ أطْلالاً ونُؤياً مُهَدَّما","https://www.poetsgate.com/ViewPoem.aspx?id=16870",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""]],"verses":[["كَجَنَّةٍ كَانَ فِيهَا","أحِبَّةٌ آهِلُونَا",0,"ن",2,0],["كَجَامِعَة كُنْتَ حَتَّى المَمَا","تِ أَسَاساً لِبُنْيَانِهَا الْقَائِمِ",1,"م",1,0],["كَجِرْحٍ قَدْ أُلَطِّفْهُ بِلَمْسِي","وَإِنْ هُوَ مَسَّهُ غَيْرِي أُضَامُ",2,"م",1,0],["كَجَرباءَ دُسَّت بِالهَناءِ فَأُقصِيَت","بِأَرضٍ خَلاءٍ أَن تُفارِقَها الإِبلُ",3,"ل",1,0],["كَجيدِ الرَئمِ أَتلَع لا قَصيراً","لَهُ غُضنٌ وَلا قَفراً عَطولا",4,"ل",2,0],["كجبال تَرى البراكينَ فيها","تقذف الموت جارفاً والنُحوسا",5,"س",2,0],["كَجَمرِ الغَضا هَبَّت بِهِ بَعدَ هَجعَةٍ","مِنَ اللَيلِ أَرواحُ الصِبا فَتَنَسَّما",6,"م",2,0],["كَجَفنَةَ وَالقَمقامِ عَمروُ بنِ عامِرٍ","وَأَولادِ ماءِ المُزنِ وَاِبني مُحَرَّقِ",7,"ق",1,0],["كجمالِ دين الله وابنِ شهابهِ","لا الظلمُ حيث يرى ولا الظلماء",8,"ا",2,0],["كجمال دين الله إنَّ له هوىً","بجميله وهوى سواه بحمله",9,"ل",2,0],["كجليب رَيَّا الروضِ بات يُشيعه","نفح الصِّبا في ليلة مِدْجان",10,"ن",1,0],["كجمال هذا العالَم البسَّامِ","واخفقْ مع العِطْر المرفرفِ في الفضا",11,"ض",2,0],["كَجيادِ السَبقِ لَن تُغنِيَها","أَدَواتُ السَبقِ ما تُغني الفِطَر",12,"ر",1,0],["كَجُنودِ عَمروٍ أَينَما رَكَزوا القَنا","عَفّوا يَداً وَمُهَنَّداً وَسِنانا",13,"ن",2,0],["كَجَبينٍ وَعارِضٍ وَقَوامٍ","وَثُغورٍ وَأَعيُنٍ وَخُدودِ",14,"د",1,0],["كَجُنود اللَه طارَت خَيلُهُم","يَوم بَدرٍ في سَماءِ القسطل",15,"ل",1,0],["كَجَبرٍ وَعبد اللَه طابَ ثَراهُما","وَلا زالَ فَوّاح الشَذى ريِّق النَدى",16,"د",2,0],["كَجُبَّةِ الساجِ فَحافاتُها","صُبحٌ جَلا خُضرَةَ أَهدامِها",17,"م",3,0],["كَجَزورِ الأَيسارِ لا كَبِدٌ في","ها لَباغٍ وَلا عَلَيها سَنامُ",18,"م",1,0],["كَجاري السَرابِ تَرى لَمعَهُ","وَلَستَ بِواجِدِهِ عِندَكَم",19,"م",1,0],["كَجُذوَةِ موقِدٍ وَسِراجِ لَيلٍ","وَماءِ حَبِيَّةٍ وَشَفا ذُبالِ",20,"ل",1,0],["كَجَنَى الكَحْصِ ما تَرامى إليها النْ","نَمْلُ قَصْراً للحَمْلِ عيراً فَعِيرا",21,"ر",2,0],["كجَوارٍ سَابِحَاتٍ خُرَّدٍ","سَابِقاتٍ فِي تبَارِيهَا وَحَسْرَى",22,"ر",2,0],["كجمر الغضا هبت به، بعد هجعة","من الليل، أروح الصبَّا، فتنسما",23,"م",2,0],["كجليبٍ من البضائعِ يأتيكم من","العالمينَ وجةٌ جليب",24,"ب",1,0]]}