{"poems":[[65,"لك ما يروقه الغمام الهاطل","https://www.aldiwan.net/poem46192.html","الكامل"],[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[49,"ياقرح لم يندمل الأول","https://www.aldiwan.net/poem25211.html","السريع"],[23,"ففدى أمي لعوف كلها","https://www.aldiwan.net/poem21382.html","الرمل"],[74,"رشقتني من اللحاظ بغمزه","https://www.aldiwan.net/poem19000.html","الخفيف"],[45,"حسم الصلح ما اشتهته الأعادي","https://www.aldiwan.net/poem9554.html","الخفيف"],[30,"ورث الخلافة سبعة آباءه","https://www.aldiwan.net/poem5216.html","الكامل"],[30,"لا قوم أكرم من تميم إذ غدت","https://www.aldiwan.net/poem5479.html","الكامل"],[63,"خطرات هي العلا وارتياح","https://www.aldiwan.net/poem51733.html","الخفيف"],[82,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[46,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[33,"يا نعم قد طالت مماطلتي","https://www.aldiwan.net/poem41843.html","الكامل"],[69,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[30,"طرقت نوار ودون مطرقها","https://www.poetsgate.com/ViewPoem.aspx?id=21604",""],[33,"يَا نُعْمُ، قَدْ طَالَتْ مُمَاطَلَتي،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19026&r=&rc=289",""],[146,"من رأى المجد يثير القلاصا","https://www.aldiwan.net/poem58437.html","الخفيف"],[147,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[147,"قسما بسؤددك الذي لا يدعى","https://www.aldiwan.net/poem11776.html","الكامل"],[147,"قد كفى الله وهو نعم الكافي","https://www.aldiwan.net/poem11780.html","الخفيف"],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[240,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[275,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[369,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[369,"وجد الصبا للعاشقين رسولا","https://www.aldiwan.net/poem60791.html","الكامل"],[369,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[369,"أتراها تظنني الطيف لطفا","https://www.aldiwan.net/poem60838.html","الخفيف"],[369,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[369,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[369,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[369,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[369,"فعلت هذه الجفون الضواري","https://www.aldiwan.net/poem60874.html","الخفيف"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[369,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[369,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[369,"وجدي بلومك يا عذول يزيد","https://www.aldiwan.net/poem60944.html","الكامل"],[369,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[369,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[369,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[398,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[422,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[445,"منن بأيسر شكرها أعييتني","https://www.aldiwan.net/poem34915.html","الكامل"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[469,"سر الحسود بما أساء وارجفا","https://www.aldiwan.net/poem3261.html","عموديه"],[469,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[520,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104611","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90571","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119895","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119887","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120068","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119916","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119897","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119898","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61032","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64834","الكامل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20573","الرمل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35709","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80005","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79962","الخفيف"],[2082,"","https://poetry.dctabudhabi.ae/diwan/poem/22574","الكامل"],[2169,"","https://poetry.dctabudhabi.ae/diwan/poem/141429","الكامل"],[2169,"","https://poetry.dctabudhabi.ae/diwan/poem/141422","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53138","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53143","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53152","الكامل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28084","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82177","الكامل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18036","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140047",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62924","الطويل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32364","الكامل"],[3655,"","https://poetry.dctabudhabi.ae/diwan/poem/205648","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119662","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123513","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54478","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54462","الكامل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105503","الخفيف"],[4742,"مَا زلتُ مَجهولاً ، وَ حُبّكَ يَكبُرُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=187688",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5725,"ميّاسة الرمح","https://www.poetsgate.com/ViewPoem.aspx?id=177621",""],[5725,"لدن القوام","https://www.poetsgate.com/ViewPoem.aspx?id=208950",""],[5725,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=211771",""],[6178,"قبلة ماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85528&r=&rc=4",""],[147,"قَدْ كَفى اللَّهُ وَهْوَ نِعْمَ الْكَافِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27436&r=&rc=3",""]],"verses":[["فَفداكَ منْ رَيْبِ الحَوادثِ ناقِصٌ","في المَكْرُماتِ وفي المَعايِبِ كامِلُ",0,"ل",1,0],["فَفِدىً لِقَومي عِندَ كُلِّ عَظيمَةٍ","نَفسي وَراحِلَتي وَسائِرُ مالي",1,"ل",2,0],["فَفِديَةُ المَأسورِ مَقبولَةٌ","وَفِدِيَةُ المَيِيتِ لا تُقبَلُ",2,"ل",1,0],["فَفِدىً أُمّي لِعَوفٍ كُلِّها","وَبَني الأَبيَضِ في يَومِ الدَرَك",3,"ك",1,1],["ففداه كلّ امرئٍ يطلق الشات","م في لحمه ويحفظ خبزه",4,"ز",2,0],["فَفَدى رَأيَكَ الَّذي لَم تُفَدهُ","كُلُّ رَأيٍ مُعَلَّمٍ مُستَفادِ",5,"د",1,0],["فَفَداكَ كُلُّ مُجاوِرٍ جيرانُهُ","وَرَدوا بِذِمَّةِ حَبلِهِ لَم يُصدَرِ",6,"ر",1,0],["فَفَدَوهِ لا لِثَوابِهِ وَلَقَد يُرى","بِيَمينِهِ نَدَبٌ مِنَ الأَغلالِ",7,"ل",1,0],["ففِداكَ الهُمامُ والمَلِكُ المَر","جُوُّ للبَذلِ والفَتى الجَحْجاحُ",8,"ح",1,0],["ففداك مَنْ للمالِ أسْرٌ عنده","إذْ لم يزَلْ للمال منك سراحُ",9,"ح",1,0],["فَفَدى نَفسَهُ بِكُلِّ شَوارٍ","وَصَهيلٍ في أَرضِهِ وَنَهيقِ",10,"ق",1,0],["فَفَديتُ مَن أُشفى بِرُؤيَتِهِ","وَأَبى وَكانَ كَثيرَةً عِلَلُه",11,"ل",2,0],["فَفَدَيتُ حامِلَهُ وَحاضِرَهُ","وَفَدَيتُ ما يَسمو بِهِ جَمَلُه",11,"ل",2,0],["فَفَدَوكَ مَولوداً وَقَيتَ نُفُوسَهُم","شِيباً وَشُبَّاناً مَعاً وَكُهُولا",12,"ل",2,0],["فَفِداءٌ لِبَني قَيسٍ عَلى","ما أَصابَ الناسَ مِن سُرٍّ وَضُر",13,"ر",1,0],["فَفَدَاهُمْ مِنَ المَنُونِ وَكَانُوا","بَيْنَ أَيْدِي المَنُونِ أَكْرَمُ فَادِي",14,"د",2,0],["فَفَدِ ابتُلِيتَ بِمَا زَعَمْتَ لَنَا","إنْ أنْتَ كُنْتَ لَنَا على أمْرِ",15,"ر",1,0],["فَفَدَيْتُ مَن أُشْفَى بِرُؤيَتِهِ","وأبى ،وكان كثيرة ً عدله",16,"ل",2,0],["ففداه كلُّ جَهم المُحيَّا","مانعٌ عسجدَه والرَّصاصا",17,"ص",2,0],["فَفَداكَ ذو مُلكٍ يُصيخُ لِبَربَطٍ","شَغَلَتهُ عَن أَوتارِهِ أَوتارُهُ",18,"ر",2,0],["فَفَدَتكَ مِن صَرفِ النَوائِبِ أُمَّةٌ","لَولاكَ كانَت لِلنَوائِبِ مَرتَعا",19,"ع",2,0],["فَفِداءٌ لِعَدلِكَ المالِىءِ الأَر","ضَ وَكانَت غُفلاً مِنَ الإِنصافِ",20,"ف",1,0],["فَفِداءُ مَجدِكَ أُمَّةٌ هَمَّت بِهِ","زَمَناً فَما وَجَدَت إِلَيهِ سَبيلا",21,"ل",2,0],["فَفداهُ بنفسهِ ذلك اللي","ثُ عليٌّ ونعم هذا الفداءُ",22,"ا",2,0],["فَفَدى نفسهُ ببذلِ خضوعٍ","حينَ مِنها لم يبق إلّا الذماءُ",22,"ا",2,0],["فَفَدَت كَفَّكَ الَّتي جودُها الكَو","ثَرُ كَفٌّ عَطائُها غِسلينُ",23,"ن",1,0],["ففدت أرينةُ بالهدايا نَفسها","وبلادها وسِلاحها الإرفاد",24,"د",1,0],["ففَدِّهم بالروح","في القُربِ والنُزوحِ",25,"ح",1,0],["ففِداءٌ لراحتَيْكَ الورَى طُرْ","راً جَواداً برُوحِه وضَنين",26,"ن",1,0],["ففِداءٌ لِما وَطئتَ من الأرْ","ض حسودٌ إذا سُرِرْتَ حزين",26,"ن",1,0],["ففدَتْكَ أملاكٌ تُريكَ فَعالُهمْ","حسَباً على سِمَنِ الجسومِ هَزيلا",27,"ل",2,0],["ففِداءُ مَجْدِك حاسِدوه فإنّهمْ","يَرجونَ أمراً ما إليه سَبيل",28,"ل",1,0],["ففَداهُ مِن الرَّدى كُلُّ نِكْسٍ","يَدَّعي نِسبةَ العُلا وهْو يُنفَى",29,"ف",2,0],["ففَداكُمْ من الرّدى كُلُّ نِكْسٍ","حين لم يُؤْتَ بالمدائحِ مُتْعه",30,"ع",2,0],["ففَداه في الأقوامِ كُلُّ مُزنّدٍ","لثنيّةِ العَلْياء غيرُ طَلوع",31,"ع",1,0],["ففَداكَ في الحُسّادِ كُلُّ مُدافِعٍ","دونَ العُلا والمكرماتِ مُدَفَّع",32,"ع",1,0],["ففَداكَ امْرؤٌ له بَطْنُ كَفٌ","يُخْرَجُ الرَفدُ منه بالمِنْماص",33,"ص",1,0],["ففِداءٌ لأحمدَ النّاسُ إلاّ","أهلَه من حوادثِ الأقدار",34,"ر",1,0],["ففَداكَ الزّمانُ يا خيرَ أَهلي","هِ إذا الحادثاتُ قَدَّمْن نَذرا",35,"ر",2,0],["فِفداءُ كفِّكَ وهْي بحرُ سماحةٍ","قومٌ إذا ورَد العُفاةُ استَحْجَروا",36,"ر",3,0],["ففَداهُ مَنْ لا يَنالُ مَداهُ","في عُلاهُ وللمعالِي حُدود",37,"د",1,0],["ففَداهُ في الأقوامِ كُلُّ مُقَصِّرٍ","يَنْميهِ لُؤْمٌ طارِفٌ وتليد",38,"د",1,0],["ففَداك مَنْ بارَى عُلاك ونَقْصُه","وصْفاً لفَضْلِك ليس بالمَحْدود",39,"د",1,0],["ففَداهُ في الأقوامِ كلُّ مُقَصرٍ","يَسْعى إلى نَيْلِ العَلاء بمُسْعِد",40,"د",1,0],["ففَداكَ مِن رَيْبِ الحوادثِ حاسدٌ","يغدو إلى ما نِلْتَه طَمّاحا",41,"ح",2,0],["ففَدى العُداةُ مِنَ الحِمامِ ورَيْبِه","وهمُ وإن رغمِوا أقلُّ فِدائه",42,"ا",3,0],["فَفَدى الخَلقُ كفَّه","بَل فَدى الخلقُ خنصره",43,"ر",2,0],["ففداه من لديه ما له","بمكان الرّوح من نفس الجبان",44,"ن",1,0],["ففداؤك الأَملاكُ يومَ سمعتَني","لهفانَ فِي أَسرِ الأَسى ففديتَني",45,"ن",2,0],["ففِداك مُعْطٍ يبذُلُ ال","نُعمَى ولا يختارُها",46,"ر",3,0],["ففداهُ ما اسودَّ من طلعه النَّقع","وما احمرًّ من خدود الصفاح",47,"ح",1,0],["ففدى صلاح الدين كل متوج","كالنجم يفيد الشمس من أن تكسفا",48,"ف",2,0],["ففداها ما أباحت من دمي","وتباريح الأسى قولي فداها",49,"ا",3,0],["ففدى لقطب الدين مالك دولة","شغلته عن أوتاره الأوتار",50,"ر",1,0],["فَفدانا لمّا فدانا بِذبحَيه","نِ عَظيمينِ في اقتدارٍ وقَدرِ",51,"ر",1,0],["ففِداهُ علمتهُ كَبشُ ضأنٍ","وفِدائي كبشُ الملوكِ الغُرَّ",51,"ر",1,0],["فَفد يا حَبرَ آدابٍ علينا","فمَقدمُكَ السّعيدُ نراهُ عُرسا",52,"س",2,0],["ففداء يحيى من عوائده","أن لا يرى في عوده ثمرُ",53,"ر",1,0],["ففداء العلاء نجل علي","من قريب الندى عليه بعيد",54,"د",1,0],["ففداك يا هبة الإله معاشر","لا يعشرون ندي يديك السافحا",55,"ح",2,0],["ففداء لك يا جارى الندى","صور جامدة تحكي الصور",56,"ر",1,0],["ففداء الوزير كل بخيل","كاذب الوعد ربه دينارُه",57,"ر",2,0],["ففداء هون الدين كل فتى","يقلي السماح ويعشق المنعا",58,"ع",2,0],["ففدتك النفوس مِن كُل سوء","هاكَ نَف