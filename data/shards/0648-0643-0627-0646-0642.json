{"poems":[[53,"أيا راكبا ترمي به الليل جسرة","https://www.aldiwan.net/poem29913.html","الطويل"],[55,"يا لائمي في العشق مه","https://www.aldiwan.net/poem26228.html","مجزوء الكامل"],[55,"قد جمع الله لي شملي بقربكم","https://www.aldiwan.net/poem26397.html","البسيط"],[55,"ردت علي هدية لو أنها","https://www.aldiwan.net/poem26407.html","الكامل"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[71,"الحمد لله واجب الشكر","https://www.aldiwan.net/poem3812.html","المنسرح"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[89,"البحر يغلى كان البحر بركان","https://www.aldiwan.net/poem44779.html","البسيط"],[85,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[28,"وكوم تنعم الأضياف عينا","https://www.aldiwan.net/poem5381.html","الوافر"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[80,"يوم كأن نسيمه","https://www.aldiwan.net/poem31222.html","مجزوء الكامل"],[87,"ويلاه من نار الهوى","https://www.aldiwan.net/poem8195.html","مجزوء الرجز"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[74,"وعاذر قد كان لي عاذلا","https://www.aldiwan.net/poem13215.html","السريع"],[102,"عرفت أديبا فأحببته","https://www.aldiwan.net/poem32921.html","المتقارب"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[48,"يا بؤس كلبي سيد الكلاب","https://www.aldiwan.net/poem62453.html","الرجز"],[48,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[50,"غمض الحديد بصاحبيك فغمضا","https://www.aldiwan.net/poem62354.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85842","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19689","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142323","الكامل"],[77,"فتحت سعودك كل باب مبهم","https://www.poetsgate.com/ViewPoem.aspx?id=34204",""],[45,"أمّا الخَيالُ، فإنّهُ لمْ يَطْرُقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32849",""],[99,"الى صديقة جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=347&r=&rc=53",""],[140,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[158,"أهلا بطرس من إمام مدته","https://www.aldiwan.net/poem59120.html","الرجز"],[184,"قد سقط العار فلا عار","https://www.aldiwan.net/poem43823.html","السريع"],[202,"بيني وبينك يا ظلوم الموقف","https://www.aldiwan.net/poem53234.html","الكامل"],[208,"يا أيها المولى الذي جوده","https://www.aldiwan.net/poem13320.html","السريع"],[221,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[227,"لوم لئيم كلما اشتد خاب","https://www.aldiwan.net/poem51237.html","السريع"],[233,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[250,"طوى دارها طي الكتاب المنمنم","https://www.aldiwan.net/poem1431.html",""],[285,"أرحلت من سلمى بغير متاع","https://www.aldiwan.net/poem1916.html","الكامل"],[346,"رددت في بذاك الملتقى نفسا","https://www.aldiwan.net/poem20399.html","البسيط"],[362,"وجد الصبا للعاشقين رسولا","https://www.aldiwan.net/poem60791.html","الكامل"],[362,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[369,"قل للأحبة يصبرون قليلا","https://www.aldiwan.net/poem57171.html","الكامل"],[406,"أحبابنا كيف اللقاء ودونكم","https://www.aldiwan.net/poem31715.html","عموديه"],[406,"يا ثانيا للنفس وهو","https://www.aldiwan.net/poem32283.html","مجزوء الكامل"],[429,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[434,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[438,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[466,"حمام من لست له ذاكرا","https://www.aldiwan.net/poem59556.html","السريع"],[496,"هذا فؤادي أحصدته الأسهم","https://www.aldiwan.net/poem3705.html","الكامل"],[534,"أجدك ما لعينك لا تنام","https://www.aldiwan.net/poem23869.html","الوافر"],[549,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[549,"عادت إلي بغيضة فتوددت","https://www.aldiwan.net/poem48072.html","الكامل"],[565,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"يا قوم عشقي ابن فلان غدا","https://www.aldiwan.net/poem2859.html","السريع"],[573,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"]],"verses":[["وَكانَ قَنيصاً أَفلَتَتهُ حِبالَةٌ","وَأَينَ حِبالٌ بَعدَها وَشِراكُ",0,"ك",1,0],["وَكَأَنَّ قَلبي مِن هَوا","هُ في وَثاقٍ لَيسَ يُطلَق",1,"ق",1,0],["وَكانَ قَد غابَ لَمّا غِبتِ عَن جَسَدي","قَلبي وَأورِثتُ همّاً فَتَّتَ الكَبِدا",2,"د",2,0],["وَكَأَنَّ قَلبي مِن حَرارَةِ ما بِهِ","أَمسى يُقَلَّبُ فَوقَ صَخرَةِ مَوقِدِ",3,"د",1,0],["وَكانَ قِيَادُ الصَّعْبِ صَعْبَاً مُمَنَّعَاً","فَأَلقَى إِلَى الدُّنْيَا مَقَادَةَ إِذْعَانِ",4,"ن",1,0],["وَكَأَنَّ قَوْسَ الْغَيْمِ بَعْضَ قِسيِّهَا","وَذَوو الذَّوَائِبِ بَعْضَ تِلْكَ الأَسْهُمِ",5,"م",1,0],["وَكانَ قَد نامَ مِن كَلالَتِهِ","وَطاحَ عَنهُ الرِدا وَلا يَدري",6,"ي",1,0],["وكأنْ قد أتى الحسيْنُ بشيراً","باتِّصالِ الفُتُوح بعد السُّدودِ",7,"د",1,0],["وكان قلبي أبداً ظرفه","وكان سمعي أبداً قمعه",8,"ع",2,0],["وكان قبل تواريه يصارعه","ثم اختفى وذويه ثم ما بانوا",9,"ن",3,0],["وَكانَ قَد رَعى الخَطي","بَ وَوَعى ما خَطَبا",10,"ب",2,0],["وَكَأَنَّ قَصرَ الساجِ خُلَّةُ عاخِقٍ","بَرَزَت لِوامِقِها بِوَجهٍ مونِقِ",11,"ق",1,0],["وَكانَ قِرى الهُمومِ إِذا اِعتَرَتني","زَماعاً لا أُريدُ بِهِ بِدالا",12,"ل",2,0],["وكأنَّ قُدْساً أو مَتالِعَه","وهبَ الوَقارَ له تَوَقُّرُه",13,"ر",2,0],["وكأنّ قَطْرَ سمائهِ","دُرٌّ هَوى من نظم سِلكِ",14,"ك",1,0],["وَكَانَ قَلْبِي رَاشِدَاً","لَكِنَّهُ الْيَوْمَ غَوَى",15,"و",2,0],["وكان قلبي إلى رُؤياكِ باصِرَتي","حتى اتَّهَمْتُ عليكِ العينَ والحَدَقا",16,"ق",2,0],["وَكانَ قَلبي دونَهُ واقِداً","وَماءُ جَفني فَوقَهُ جائِلا",17,"ل",2,0],["وَكانَ قَريراً بِآماله","فَأَدعو لَهُ اللَه أَلّا تَخيب",18,"ب",1,0],["وَكَأَنَّ قِهزَةَ تاجِرٍ جيبَت لَهُ","لِفُضولِ أَسفَلِها كِفافٌ أَسوَدُ",19,"د",1,0],["وَكانَ قَد مَزَّقَ ثَوبَ المُلكِ","طَوائِفٌ إيمانُهُم كَالشَركِ",20,"ك",1,0],["وَكانَ قَد كَنّى اِبنَهُ بِثَعلَبِ","كَذا يَكونُ العَرَبِيُّ وَاِقلِبِ",20,"ب",1,0],["وكأنَّ قارِئَهُ بِيَوْمِ عَرُوبَةٍ","لَكَ يُعْرِبُ التَّسْبِيحَ والتقْدِيسا",21,"س",2,0],["وكأنّ قُدسَ ويذبُلاً رَفَدا ذُرَى","أعلامِهِ حتى رَسَتْ أركانُها",22,"ن",3,0],["وَكانَ قَد أَجزى عَنِ القَصّابِ","وَعَن شِراءِ الجَلَبِ الجَلّابِ",23,"ب",1,0],["وكان قاتلَ كسرى","به فتى الرومِ قيصر",24,"ر",1,0],["وَكَأَنَّ قَلبي عِندَ كُلِّ مُصيبَةٍ","عَظمٌ تَكَرَّرَ صَدعُهُ فَتَهَيَّضا",25,"ض",2,0],["وكان قبل جباناً","من الصغير يلاع",26,"ع",1,0],["وكان قبل الها","إذ لم يكن ما سواه",27,"ا",2,0],["وكان قد راعى الخطي","ب ووعى ما خطبا",28,"ب",2,0],["وكأنّ قلبي في الضلوع جنازةٌ","أمشي بها وحدي وكلّي مأتمُ",29,"م",1,0],["وكأن قوس الغيم بعض قسيها","وذرى الذوائب بعض تلك الأسهم",30,"م",1,0],["وَكأنّ قَصرَ السّاجِ خُلّةُ عاشقٍ،","بَرَزَتْ لِوَامِقِها بوَجْهٍ مُونِقِ",31,"ق",1,0],["وكانَ قلبي قبل أن تلوحي","مقبرةً ميِّتَةَ الزُهورِ",32,"ر",1,0],["وكأَنَّ قلبي والمهامهُ بيننا","جىٌّ على وادى العِضاهِ حُلولُ",33,"ل",1,0],["وكان قد أتلفه بعتقه","فوجبت قيمته في ذمته",34,"ت",2,0],["وكان قبل الدارِ جيرانها","فاليومَ لا دارٌ ولا جارُ",35,"ر",1,0],["وكأنَّ قوس الحاجبين مقوّساً","سَهمٌ فويلٌ للذي يستهدفُ",36,"ف",1,0],["وكان قبل اليوم لا يشتري","فكيف في ذا الزمن الخامل",37,"ل",1,0],["وَكانَ قَد أَوشَكَ أَن يُقَبِّلا","جَبينَها المُضطَربَ المُشتَعِلا",38,"ل",2,0],["وكان قد طاب لكم عفُوه","فعاد مُرّاً منه ما كان طاب",39,"ب",1,0],["وَكَأَنَّ قُدساً ماثِلاً","في الدِستِ مِنهُ إِذا تَوَسَّد",40,"د",1,0],["وَكانَ قَديماً طائِشاتٍ سِهامُهُ","فَأَصبح يَرمينا بأنفذ أَسهُم",41,"م",1,0],["وَكَأَنَّ قِنطَرَةً بِمَوضِعِ كورِها","مَلساءَ بَينَ غَوامِضِ الأَنساعِ",42,"ع",1,0],["وكانَ قَلبيَ يَشكُو طُولَ وَحشَتهِ","صَدْرِي وَقَد قَرَّ في صَدْري وقد أنِسَا",43,"س",2,0],["وكأنّ قَرْعَ شِفاهِهمْ بنِعالِها","حتّى تُعلِّمَهمْ لها التَّقْبيلا",44,"ل",2,0],["وكان قَلْبانا على عَهْدٍ مضَى","بُرْجَى هوىً لكنْ ثَبَتُّ وانقلب",45,"ب",1,0],["وكأنَّ قَلبي رامَ يُبدي سَلوةً","لليأسِ فاتَّخذَ الدُّموعَ رسولا",46,"ل",2,0],["وكأن قلبي حين يخطر ذكركم","لهب الضرام تعاورته الريح",47,"ح",1,0],["وكأنَّ قلبي حينَ يَخْ","طُرُ ذِكرُكم في كفّ ضَابِث",48,"ث",1,0],["وكان قلباً فغدا طائراً","له من الأكوارِ أوكارُ",49,"ر",1,0],["وكان قد غفلت عني حوادثهُ","في بغلة كنت أقضي فوقها أربي",50,"ب",2,0],["وكان قد أيبس الجدب السطور ومذ","هم أرضعوه جرى بالرسل مايته",51,"ت",2,0],["وَكانَ قَد أَسلَمَني النُصحُ ما","يَعجَزُ عَن إِدراكِهِ ذِهني",52,"ن",2,0],["وَكأنَّ قامَتَها وَنَغمة لَفظها","غُصنٌ عَلَيهِ بُلبل يَتَرَنَّمُ",53,"م",1,0],["وَكانَ قِوامَنا وَالرَأسَ فينا","فَنَحنُ اليَومَ لَيسَ لَنا قِوامُ",54,"م",1,0],["وكأنّ قلبِي يوم بينِكُمُ","شطرٌ أقام وعندكمْ شطرُ",55,"ر",1,0],["وَكأَنّ قَلبي وَهوَ غَيرُ مُقَلْقَلٍ","مُلئتْ بقُربك حافَتاهُ وَجيبا",56,"ب",2,0],["وَكَان قِيَادُهُ بِيَدِي ذَلِيْلاً","فَصَعَّبَتِ الحَوَادِثُ مِنْ قِيَادِهْ",57,"د",2,0],["وكان قد يكفر من كان اعتقد","إمامة لأحد دون أحد",58,"د",1,0],["وكان قصدي في جميع ما ذكر","أن أشبع القول به واختصر",58,"ر",1,0],["وكان قد أمر أن يشاورا","من كان منهم لديه حاضرا",58,"ر",2,0],["وكان قد أقام فيمن خلفا","وصيه عليهم مستخلفا",58,"ف",2,0],["وكان قد عاقدة في وعده","أن يجعل الأمر له من بعده",58,"ه",1,0],["وكان قد أخره حتى اشتكى","فقال ي من بينهم أخّرتكا",58,"ك",2,0],["وكان قد قال النبي إني","أخبركم أن عليا مني",58,"ي",1,0],["وكان قد أخرج من زكاته","في حالة الركوع من صلاته",58,"ه",1,0],["وكان قد يقول فيما قد ذكر","لو كان ما ادعيتم وجه الخبر",58,"ر",1,0],["وكان قد صلى النبي وحده","فيه فهموا أن يصلوا بعده",58,"ه",1,0],["وكان قد قضى برجم حامل","في محفل أيضا من المحافل",58,"ل",1,0],["وكان قد خطبهم في عيد","فنفروا قبل انقضا التحميد",58,"د",1,0],["وكان قد شاوره الرسول","إذ رميت وقال ما تقول",58,"ل",1,0],["وكان قد أوصى علي إذ ظعن","بالناس فيما روي لى الحسن",58,"ن",1,0],["وكان قد أوصى إلى أخيه","دون بنيه وبني أبيه",58,"ه",1,0],["وكان قد أوصى الحسين إذ غير","بأمره إلى عليّ فاستتر",58,"ر",1,0],["وكان قد أقام بعض ولده","مقامه لما رأى من جلده",58,"ه",1,0],["وكان قد يرثه النبوة","على قياس القول بالسوية",58,"ه",1,0],["وكان قد يقول فيما يعتقد","إن الحسين بن علي قد عهد",58,"د",1,0],["وكان قالوا رجلا ضريراً","أصل قولا فغدا مشهورا",58,"ر",2,0],["وكان قد أصل للتعدي","قولا ضعيفا ليس بالمعتد",58,"د",1,0],["وكان قد قتلهم تقتيلا","بكل فج زمنا طويلا",58,"ل",2,0],["وكان قبْل اليوم مات الهوى","وفيه قد عاش مِن اليَوْم",59,"م",1,0],["وكان قَدْماً ذَوُو الأَقدارِ لي خَدما","فصرتُ منه أَرَى الأَقدار لي خَدما",60,"م",2,0]]}