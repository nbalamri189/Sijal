//www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5186,"يوم كأسبوع وشهر كعام","https://www.poetsgate.com/ViewPoem.aspx?id=156514",""],[5281,"مُقلةُ الحُسْنِ..رسولنا محمدٌ صلى الله عليه وسلَّم","https://www.poetsgate.com/ViewPoem.aspx?id=200143",""],[5376,"إنِّي جَزِعْتُ وما لنا الا هو","https://www.poetsgate.com/ViewPoem.aspx?id=188286",""],[5376,"أرَّا ومارَّا والعواصمُ واحدُ","https://www.poetsgate.com/ViewPoem.aspx?id=196641",""],[5409,"أصقر تهامة والأبطحين","https://www.poetsgate.com/ViewPoem.aspx?id=155485",""],[5409,"بيني وبينك ألف القدر","https://www.poetsgate.com/ViewPoem.aspx?id=155500",""],[5542,"مالي أراك تقلبُ النظرا","https://www.poetsgate.com/ViewPoem.aspx?id=9683",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[5848,"البقية في حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=50592",""],[5937,"قانون جذبها","https://www.poetsgate.com/ViewPoem.aspx?id=211881",""],[5939,"جحود","https://www.poetsgate.com/ViewPoem.aspx?id=178579",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[5993,"ليل العذاب","https://www.poetsgate.com/ViewPoem.aspx?id=186538",""],[6093,"رامٍ رماني بسوءٍ ( المجتث)","https://www.poetsgate.com/ViewPoem.aspx?id=175999",""],[6117,"سطوة الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=183708",""],[2220,"لما تأدبتَ بي يا منتهى ألمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11422&r=&rc=296",""]],"verses":[["وَكانَ قَنيصاً أَفلَتَتهُ حِبالَةٌ","وَأَينَ حِبالٌ بَعدَها وَشِراكُ",0,"ك",1,0],["وَكَأَنَّ قَلبي مِن هَوا","هُ في وَثاقٍ لَيسَ يُطلَق",1,"ق",1,0],["وَكانَ قَد غابَ لَمّا غِبتِ عَن جَسَدي","قَلبي وَأورِثتُ همّاً فَتَّتَ الكَبِدا",2,"د",2,0],["وَكَأَنَّ قَلبي مِن حَرارَةِ ما بِهِ","أَمسى يُقَلَّبُ فَوقَ صَخرَةِ مَوقِدِ",3,"د",1,0],["وَكانَ قِيَادُ الصَّعْبِ صَعْبَاً مُمَنَّعَاً","فَأَلقَى إِلَى الدُّنْيَا مَقَادَةَ إِذْعَانِ",4,"ن",1,0],["وَكَأَنَّ قَوْسَ الْغَيْمِ بَعْضَ قِسيِّهَا","وَذَوو الذَّوَائِبِ بَعْضَ تِلْكَ الأَسْهُمِ",5,"م",1,0],["وَكانَ قَد نامَ مِن كَلالَتِهِ","وَطاحَ عَنهُ الرِدا وَلا يَدري",6,"ر",2,0],["وكأنْ قد أتى الحسيْنُ بشيراً","باتِّصالِ الفُتُوح بعد السُّدودِ",7,"د",1,0],["وكان قلبي أبداً ظرفه","وكان سمعي أبداً قمعه",8,"ع",2,0],["وكان قبل تواريه يصارعه","ثم اختفى وذويه ثم ما بانوا",9,"ن",3,0],["وَكانَ قَد رَعى الخَطي","بَ وَوَعى ما خَطَبا",10,"ب",2,0],["وَكَأَنَّ قَصرَ الساجِ خُلَّةُ عاخِقٍ","بَرَزَت لِوامِقِها بِوَجهٍ مونِقِ",11,"ق",1,0],["وَكانَ قِرى الهُمومِ إِذا اِعتَرَتني","زَماعاً لا أُريدُ بِهِ بِدالا",12,"ل",2,0],["وكأنَّ قُدْساً أو مَتالِعَه","وهبَ الوَقارَ له تَوَقُّرُه",13,"ر",2,0],["وكأنّ قَطْرَ سمائهِ","دُرٌّ هَوى من نظم سِلكِ",14,"ك",1,0],["وَكَانَ قَلْبِي رَاشِدَاً","لَكِنَّهُ الْيَوْمَ غَوَى",15,"و",2,0],["وكان قلبي إلى رُؤياكِ باصِرَتي","حتى اتَّهَمْتُ عليكِ العينَ والحَدَقا",16,"ق",2,0],["وَكانَ قَلبي دونَهُ واقِداً","وَماءُ جَفني فَوقَهُ جائِلا",17,"ل",2,0],["وَكانَ قَريراً بِآماله","فَأَدعو لَهُ اللَه أَلّا تَخيب",18,"ب",1,0],["وَكَأَنَّ قِهزَةَ تاجِرٍ جيبَت لَهُ","لِفُضولِ أَسفَلِها كِفافٌ أَسوَدُ",19,"د",1,0],["وَكانَ قَد مَزَّقَ ثَوبَ المُلكِ","طَوائِفٌ إيمانُهُم كَالشَركِ",20,"ك",1,0],["وَكانَ قَد كَنّى اِبنَهُ بِثَعلَبِ","كَذا يَكونُ العَرَبِيُّ وَاِقلِبِ",20,"ب",1,0],["وكأنَّ قارِئَهُ بِيَوْمِ عَرُوبَةٍ","لَكَ يُعْرِبُ التَّسْبِيحَ والتقْدِيسا",21,"س",2,0],["وكأنّ قُدسَ ويذبُلاً رَفَدا ذُرَى","أعلامِهِ حتى رَسَتْ أركانُها",22,"ن",3,0],["وَكانَ قَد أَجزى عَنِ القَصّابِ","وَعَن شِراءِ الجَلَبِ الجَلّابِ",23,"ب",1,0],["وكان قاتلَ كسرى","به فتى الرومِ قيصر",24,"ر",1,0],["وَكَأَنَّ قَلبي عِندَ كُلِّ مُصيبَةٍ","عَظمٌ تَكَرَّرَ صَدعُهُ فَتَهَيَّضا",25,"ض",2,0],["وكان قبل جباناً","من الصغير يلاع",26,"ع",1,0],["وكان قبل الها","إذ لم يكن ما سواه",27,"ا",2,0],["وكان قد راعى الخطي","ب ووعى ما خطبا",28,"ب",2,0],["وكأنّ قلبي في الضلوع جنازةٌ","أمشي بها وحدي وكلّي مأتمُ",29,"م",1,0],["وكأن قوس الغيم بعض قسيها","وذرى الذوائب بعض تلك الأسهم",30,"م",1,0],["وَكأنّ قَصرَ السّاجِ خُلّةُ عاشقٍ،","بَرَزَتْ لِوَامِقِها بوَجْهٍ مُونِقِ",31,"ق",1,0],["وكانَ قلبي قبل أن تلوحي","مقبرةً ميِّتَةَ الزُهورِ",32,"ر",1,0],["وكأَنَّ قلبي والمهامهُ بيننا","جىٌّ على وادى العِضاهِ حُلولُ",33,"ل",1,0],["وكان قد أتلفه بعتقه","فوجبت قيمته في ذمته",34,"ت",2,0],["وكان قبل الدارِ جيرانها","فاليومَ لا دارٌ ولا جارُ",35,"ر",1,0],["وكأنَّ قوس الحاجبين مقوّساً","سَهمٌ فويلٌ للذي يستهدفُ",36,"ف",1,0],["وكان قبل اليوم لا يشتري","فكيف في ذا الزمن الخامل",37,"ل",1,0],["وَكانَ قَد أَوشَكَ أَن يُقَبِّلا","جَبينَها المُضطَربَ المُشتَعِلا",38,"ل",2,0],["وكان قد طاب لكم عفُوه","فعاد مُرّاً منه ما كان طاب",39,"ب",1,0],["وَكَأَنَّ قُدساً ماثِلاً","في الدِستِ مِنهُ إِذا تَوَسَّد",40,"د",1,0],["وَكانَ قَديماً طائِشاتٍ سِهامُهُ","فَأَصبح يَرمينا بأنفذ أَسهُم",41,"م",1,0],["وَكَأَنَّ قِنطَرَةً بِمَوضِعِ كورِها","مَلساءَ بَينَ غَوامِضِ الأَنساعِ",42,"ع",1,0],["وكانَ قَلبيَ يَشكُو طُولَ وَحشَتهِ","صَدْرِي وَقَد قَرَّ في صَدْري وقد أنِسَا",43,"س",2,0],["وكأنّ قَرْعَ شِفاهِهمْ بنِعالِها","حتّى تُعلِّمَهمْ لها التَّقْبيلا",44,"ل",2,0],["وكان قَلْبانا على عَهْدٍ مضَى","بُرْجَى هوىً لكنْ ثَبَتُّ وانقلب",45,"ب",1,0],["وكأنَّ قَلبي رامَ يُبدي سَلوةً","لليأسِ فاتَّخذَ الدُّموعَ رسولا",46,"ل",2,0],["وكأن قلبي حين يخطر ذكركم","لهب الضرام تعاورته الريح",47,"ح",1,0],["وكأنَّ قلبي حينَ يَخْ","طُرُ ذِكرُكم في كفّ ضَابِث",48,"ث",1,0],["وكان قلباً فغدا طائراً","له من الأكوارِ أوكارُ",49,"ر",1,0],["وكان قد غفلت عني حوادثهُ","في بغلة كنت أقضي فوقها أربي",50,"ب",2,0],["وكان قد أيبس الجدب السطور ومذ","هم أرضعوه جرى بالرسل مايته",51,"ت",2,0],["وَكانَ قَد أَسلَمَني النُصحُ ما","يَعجَزُ عَن إِدراكِهِ ذِهني",52,"ن",2,0],["وَكأنَّ قامَتَها وَنَغمة لَفظها","غُصنٌ عَلَيهِ بُلبل يَتَرَنَّمُ",53,"م",1,0],["وَكانَ قِوامَنا وَالرَأسَ فينا","فَنَحنُ اليَومَ لَيسَ لَنا قِوامُ",54,"م",1,0],["وكأنّ قلبِي يوم بينِكُمُ","شطرٌ أقام وعندكمْ شطرُ",55,"ر",1,0],["وَكأَنّ قَلبي وَهوَ غَيرُ مُقَلْقَلٍ","مُلئتْ بقُربك حافَتاهُ وَجيبا",56,"ب",2,0],["وَكَان قِيَادُهُ بِيَدِي ذَلِيْلاً","فَصَعَّبَتِ الحَوَادِثُ مِنْ قِيَادِهْ",57,"د",2,0],["وكان قد يكفر من كان اعتقد","إمامة لأحد دون أحد",58,"د",1,0],["وكان قصدي في جميع ما ذكر","أن أشبع القول به واختصر",58,"ر",1,0],["وكان قد أمر أن يشاورا","من كان منهم لديه حاضرا",58,"ر",2,0],["وكان قد أقام فيمن خلفا","وصيه عليهم مستخلفا",58,"ف",2,0],["وكان قد عاقدة في وعده","أن يجعل الأمر له من بعده",58,"ه",1,0],["وكان قد أخره حتى اشتكى","فقال ي من بينهم أخّرتكا",58,"ك",2,0],["وكان قد قال النبي إني","أخبركم أن عليا مني",58,"ي",1,0],["وكان قد أخرج من زكاته","في حالة الركوع من صلاته",58,"ه",1,0],["وكان قد يقول فيما قد ذكر","لو كان ما ادعيتم وجه الخبر",58,"ر",1,0],["وكان قد صلى النبي وحده","فيه فهموا أن يصلوا بعده",58,"ه",1,0],["وكان قد قضى برجم حامل","في محفل أيضا من المحافل",58,"ل",1,0],["وكان قد خطبهم في عيد","فنفروا قبل انقضا التحميد",58,"د",1,0],["وكان قد شاوره الرسول","إذ رميت وقال ما تقول",58,"ل",1,0],["وكان قد أوصى علي إذ ظعن","بالناس فيما روي لى الحسن",58,"ن",1,0],["وكان قد أوصى إلى أخيه","دون بنيه وبني أبيه",58,"ه",1,0],["وكان قد أوصى الحسين إذ غير","بأمره إلى عليّ فاستتر",58,"ر",1,0],["وكان قد أقام بعض ولده","مقامه لما رأى من جلده",58,"ه",1,0],["وكان قد يرثه النبوة","على قياس القول بالسوية",58,"ه",1,0],["وكان قد يقول فيما يعتقد","إن الحسين بن علي قد عهد",58,"د",1,0],["وكان قالوا رجلا ضريراً","أصل قولا فغدا مشهورا",58,"ر",2,0],["وكان قد أصل للتعدي","قولا ضعيفا ليس بالمعتد",58,"د",1,0],["وكان قد قتلهم تقتيلا","بكل فج زمنا طويلا",58,"ل",2,0],["وكان قبْل اليوم مات الهوى","وفيه قد عاش مِن اليَوْم",59,"م",1,0],["وكان قَدْماً ذَوُو الأَقدارِ لي خَدما","فصرتُ منه أَرَى الأَقدار لي خَدما",60,"م",2,0],["وكان قديماً كالح الوجه عابسا","فلما رأى منها السفور تبسَّما",61,"م",2,0],["وكان قلائي فيه من قبل لقيتي","أنكر في عرفي بيان معارفي",62,"ي",1,0],["وكأنّ قلبي حين يَذْكُر أحمداً","ووصيَ أحمدَ نيطَ من ذي مِخلبِ",63,"ب",1,0],["وكان قديماً مشهد الشمس وحدها","فعاد حديثاً مشهد الشمس والبدر",64,"ر",1,0],["وكان قريباً من عياني وحوزتي","فأصبحت أرجو أن يقربه الوهم",65,"م",1,0],["وكان قد اغترَّ اللعينُ بلينكم","وأعظمُ نارٍ حيث لا لَهبٌ يبدو",66,"د",2,0],["وَكانَ قَد أَزعَجَه السِرحان","وَهَلَكت مِن عِندِهِ خرفانُ",67,"ن",1,0],["وَكانَ قَد نامَ بِرُكن المَخزنِ","يَبكي وَيَشكو مِن صُروف الزَمَنِ",68,"ن",1,0],["وَكانَ قالَ إِن فيها كنزا","من يَلقَهُ في الأَرض يَزدَد عزّا",69,"ز",2,0],["وَكانَ قَضى الصَيف في الغناء","وما سَعى في ذُخرة الشِتاء",70,"ا",2,0],["وَكانَ قَصدي أَوّلا ثَغر سَلا","حَيثُ الفُؤاد دائِماً بِها سَلا",71,"ل",2,0],["وكان قد عَمَّهُمْ عَفواً لو اعترفوا","لعمَّهم فضلُه لكنَّهم جحدوا",72,"د",3,1],["وكان قريب العهد بالكون فانقضى","على عجل من شأنه سابق الأجل",73,"ل",1,0],["وكان قومي ولم تَغدُر لهم ذِمَمٌ","كطالبِ الدَينِ مُستَوفٍ ومُزدادِ",74,"د",1,0],["وكان قلبي في الهوى طائعي","وعاصيا من كان يغويني",75,"ن",2,0],["وكان قاب أو أدنى حين خصصه","بقربه وعليه بالرضا عطفا",76,"ف",2,0],["وكان قاب أو أدنى حين خاطبه","في مشهد رفعت عنه الحجابات",77,"ت",1,0],["وكان قاب أو أدنى من منزله","عند الملك الكبير الأعظم العظما",78,"م",2,0],["وكان قد خطبني فتية","ذات جمال بارع غنية",79,"ه",1,0],["وكان قد خِيل بأن لم يعد","منهم مقيم في ضلالٍ وتيهْ",80,"ي",2,0],["وكان قضى العمر في بريه","فجربهُ اليوم في جلده",81,"د",2,0],["وَكانَ قَضاءٍ صمتُنا عَنهُ واجِبٌ","وَسلّم في الأَحداثِ مَن كانَ يَصمُتُ",82,"ت",1,0],["وَكان قَد أَبصَر قَبل ذَلِكا","تِلكَ الجمال شرداً رواتكا",83,"ك",2,0],["وكان قيامي فيه مثل قعودي","وكان اجتهادي كالتقاعد جاثما",84,"م",2,0],["وكأن قامته قناة محاربٍ","تهتز تحت لواء فرعٍ أسحم",85,"م",1,0],["وكان قريباً من غريب له تقى","ولب بعيداً من جهول الأقارب",86,"ب",1,0],["وَكانَ قَد أَسَّسَ بَيتَ المَقدِسِ","بورِكَ في الأَساسِ وَالمُؤَسِّسِ",87,"س",1,0],["وَكانَ قَد وَصّاهُ بِاِستِمامِهِ","داودُ إِذ أَشفى عَلى حِمامَهِ",87,"ه",1,0],["وَكانَ قِراكَ إِذا ما لَقوكَ","لِساناً بِما سَرَّهُم يُنعِمُ",88,"م",1,0],["وكان قد أصفاه رب العزه","طبعا كأنه من الملوك ابتزه",89,"ه",1,0],["وَكانَ قربك أَسنى ما حظيت به","فَبانَ كل نفيسٍ بعده وَسني",90,"ن",2,0],["وَكَأَنَّ قَتلاها كِعابِ مُقامِرٍ","ضَرَبَت عَلى شَزَنٍ فَهُنَّ شَواعي",91,"ع",2,0],["وكان قد ملكت قلبي محاسنُها","خبراً تحققه يربي على الخبرِ",92,"ر",1,0],["وَكانَ قَبلُ يَهودٌ يَذكُرونَ لَهُم","إِطلالَ عَهدِ رَسولٍ صادِقٍ عَلَمِ",93,"م",1,0],["وكان قُصارى بُغيتي منك نَظرةً","وطرفي إلى مرأى علاكَ طموح",94,"ح",1,0],["وكأنَّ قلبى طائرٌ وكأنَّما","قَفصُ الضلوع انشقَّ عنه فطارا",95,"ر",2,0],["وكان قلبى معهُ اذ مضَى","كلاهُما راح فلم يرجع",96,"ع",1,0],["وكأنَّ قلبَكَ فى دموعِك ذائبٌ","وكأن لحمكَ عن عظامِك يُنزع",97,"ع",1,0],["وكان قلبي عليك مرتعدا","وانت تنساب غير مرتعد",98,"د",1,0],["وَكَأَن قَد هَجَرتهُ عَن قِلَىً","فَهوَ مِنها في بُكاءٍ مُتَّصِل",99,"ل",1,0],["وكان قصر المعالي","فيها عديم اللزوم",100,"م",1,0],["وكان قد ناد مني خادم","لحيته بالدمع مبتله",101,"ل",2,0],["وكأن قلبي للجآذر كعبة","فلهم صلاتي دائما وسجودي",102,"د",2,0],["وكأنَّ قوسَ الغيم جنكٌ مذهبٌ","وكأنما صوبُ الحيا أوتارُهُ",103,"ر",2,0],["وكان قاتلُه منكم لمصرعِهِ","مثلَ الأُحيمرِ إِذ قفَّى على إِرَمِ",104,"م",1,0],["وكأن قطر الطل في أهدابه","دمعٌ مرته فواتر الأجفان",105,"ن",1,0],["وكان قوم يرونا أمة نجحت","قرناً وعفت على آثارها الحقب",106,"ب",1,0],["وكأن قلبي منزل","بسوى الهوى لا يعمر",107,"ر",1,0],["وكان قبلك قلب السيف مضطربا","فقر بعدك قلب السيف في الخلل",108,"ل",1,0],["وكان قديماً مهبط المجد والعلى","ومصعد غطريف ترجى مواهبه",109,"ب",2,0],["وكان قرب سرير الملك مجلسه","فقد تباعد منه بعد ما اقتربا",110,"ب",2,0],["وكان قد ملكها جاهل","لا تصلح الدنيا لجهالها",111,"ل",3,0],["وكان قد صلّى صلاةَ الظهرِ","بهم صلاةَ الخوفِ ذات قصر",112,"ر",1,0],["وكان قد حج ومات في الحرم","دفن في الحجون موفور الحرم",113,"م",1,0],["وكان قبلا بطلا شجاعا","في الحرب بالكثير لن يراعا",113,"ع",2,0],["وكان قد فوّض امر الفتوى","في حلب كذاك له يروى",113,"ر",3,0],["وكان قد رأى الفقيه الحنفى","عبد الكريم صاحب الفضل الوفي",113,"ي",1,0],["وكان قرّةَ عينيه ونورهما","ولم يزلْ منه بينَ السمع والبصرِ",114,"ر",1,0],["وكان قسيم النار والخلد في غدٍ","ولم يك من ناهٍ سواه وآمر",115,"ر",1,0],["وكأن قلبي كلما همعت","عينى خضم موجه همى",116,"م",2,0],["وكان قرص الشمس إذا","ه ببهجته وحبه",117,"ب",2,0],["وَكانَ قَيد اللَّحظِ في حُسنِهِ","فَصارَ لا يُوما بِلَحظ إِلَيهِ",118,"ي",2,0],["وكأّن قذف المنجنيق بها","صعق غدا يهمي ويطردُ",119,"د",1,0],["وكان قد سألنِيه ابن سعيد","ذو الشرف الوضاح والرأي السديد",120,"د",1,0],["وكان قد شرد عنها الكرى"