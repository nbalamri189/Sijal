"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83120","المتقارب"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139281","السريع"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119576","المتقارب"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107138","الوافر"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99098","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120375","الوافر"],[4959,"يَا لَيْتَ إِعْلَامَنَا ...","https://www.poetsgate.com/ViewPoem.aspx?id=214667",""],[5002,"نقاط وحروف","https://www.poetsgate.com/ViewPoem.aspx?id=204115",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[4119,"خذوا حديث غرامي عن ضنا بدني","https://www.poetsgate.com/ViewPoem.aspx?id=16232",""],[4119,"غدرتم بنا غدر الشباب الذي مضى","https://www.poetsgate.com/ViewPoem.aspx?id=16117",""],[3591,"لكم بفؤادي كلما قدم العهدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149423",""],[5135,"حديث الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=203055",""],[5183,"صفو الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186608",""],[5200,"رماك الله يا يحيى بن عيسي","https://www.poetsgate.com/ViewPoem.aspx?id=200797",""],[5282,"على ضفاف الروح.. نسري","https://www.poetsgate.com/ViewPoem.aspx?id=214051",""],[5376,"لا تقرب اليأس في موجاته خطر","https://www.poetsgate.com/ViewPoem.aspx?id=188433",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5376,"لكل نفس ٍ اذا جادت مآثرها","https://www.poetsgate.com/ViewPoem.aspx?id=188531",""],[5413,"المعلقة الضائعة","https://www.poetsgate.com/ViewPoem.aspx?id=208590",""],[5582,"لِمن مربع بالسفحِ أَقوت ملاعبه","https://www.poetsgate.com/ViewPoem.aspx?id=63464",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5691,"فخ وبصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=206216",""],[5809,"ام عامر","https://www.poetsgate.com/ViewPoem.aspx?id=205352",""],[5853,"((لمن ..أغني ؟))","https://www.poetsgate.com/ViewPoem.aspx?id=175660",""],[1920,"كن للخير مفتاحا","https://www.poetsgate.com/ViewPoem.aspx?id=191388",""],[6052,"أبواب النفوس","https://www.poetsgate.com/ViewPoem.aspx?id=34966",""],[6070,"رحى الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=188815",""],[6082,"المصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=58835",""],[6277,"ما ذم شعرك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64471&r=&rc=34",""]],"verses":[["فَلا تَغرُرَن عَينَيكَ يا خابِطَ الدُجى","قِبابٌ بَناها اللُؤمُ حَيثُ بَناها",0,"ا",3,0],["فَلا تَغبِطونا إِذ أَقَمنا وَأَنتُمُ","عَلى ظَعَنٍ إِنَّ اللِقاءَ سَريعُ",1,"ع",1,0],["فَلا تُغضِ عَن يَومِ العَدوِّ وَلَيلِهِ","وَثُمَّ طُلوعٌ بِالأَذى وَغِيابُ",2,"ب",1,0],["فَلاَ تُغْفِلاَ أَنْ تُنْهِيَا عَنْ أَخِيكُمَا","هَدِيّةَ طِيب مِنْ كَرِيمِ سَلاَمِهِ",3,"م",2,0],["فلا تُغضبوا الإسلام إن سيوفه","مواضٍ كما قد كُنّ في سالف الحُقب",4,"ب",1,0],["فلا تَغرُرك أوجههم بياضاً","فإن طباعهم كطباع زنج",5,"ج",1,0],["فلا تغُررك أحزاب شداد","بأنّ لهم أقاويلاً لِطافا",6,"ف",2,0],["فَلا تَغتَرِر بِالناسِ ماكُلُّ مَن تَرى","أَخوكَ إِذا أَوضَعتَ في الأَمرِ أَوضَعا",7,"ع",2,0],["فلا تَغْبِطنَّ المترفين فإنهم","على قدْرِ ما يكسوهُمُ الدهرُ يَسْلبُ",8,"ب",1,0],["فلا تغضبنَّ أبا جَعْفرٍ","فإني صَدقْتُك عينَ اليقين",9,"ن",1,0],["فَلا تَغرُركَ أَلسِنَةٌ مَوالٍ","تُقَلِّبُهُنَّ أَفإِدَةٌ أَعادي",10,"د",2,0],["فَلا تُغلِيَن بِالسَيفِ كُلَّ غَلائِهِ","لِيَمضي فَإِنَّ القَلبَ لا السَيفَ يَقطَعُ",11,"ع",1,0],["فَلا تُغرَر مِنَ الأَيّامِ وَاِنظُر","إِلى أَقسامِها عَمَّن زُوينا",12,"ن",2,0],["فَلا تَغتَرِر بِرَواءِ الرِجالِ","وَإِن زَخرَفوا لَكَ أَو مَوَّهوا",13,"ه",3,0],["فَلا تَغبِطَنَّ الحَيَّ في طولِ عُمرِهِ","بِشَيءٍ تَرى إِلّا بِما تَغبِطُ المَيتا",14,"ت",2,0],["فلا تَغْتَرِرْ نفسي بشاهِدِ حالِها","فلله عِلمُ الغيبِ والغيبُ مُنْتَظَرْ",15,"ر",1,0],["فَلا تَغُرَّنكَ شُمٌّ مِن جِبالِهِمُ","وَعِزَّةٌ في زَمانِ المُلكِ قَعساءُ",16,"س",3,0],["فَلا تَغبِطَنَّ بَعضَ خُدّامِها","فَكُلُّهُمُ دائِبٌ في خَسارِ",17,"ر",1,0],["فَلا تَغبِطَنَّ ذَوي نِعمَةٍ","فَإِنَّ المَنايا غِضابٌ هُدُر",18,"ر",1,0],["فَلا تَغبِطَنّي أَن رُزِقتُ نَضارَةً","مِنَ الدَهرِ وَاِنظُر مَرجَعي وَمَآلي",19,"ل",2,0],["فَلا تَغبِطَنَّ ذَوي نِعمَةٍ","فَخَلفَهُمُ وَقعَةٌ صَيلَمُ",20,"م",1,0],["فَلا تَغُرَّنكَ في الأَيّامِ خادِعَةٌ","مِنَ الحِسانِ بِوَحيٍ أَو بِكَلّامِ",21,"م",1,0],["فلا تغررك ألسنةٌ موالٍ","تقلبهن أفئدةٌ أعادي",22,"د",2,0],["فلا تَغبِطَن إنساً بِشَيءٍ يُنالُهُ","مِنَ الدَّهرِ لا مالٍ ولا عَيشِ واجِدِ",23,"د",1,0],["فَلا تَغُرَّنْكَ أَشْبَاهٌ تَمُرُّ بِهَا","هَيْهَاتَ مَا كُلُّ طِرْفٍ سَابِقٌ أَرِنُ",24,"ن",1,0],["فَلاَ تُغْرِيَانِي بِالسُّلُوِّ فَقَدْ أَبَى","إِبَائِي سُلُوّاً حِينَ يُسْقَطُ فِي يَدِي",25,"د",2,0],["فلا تغد طوعاً لأمثالها","متى ما تُغرَّرْ بها تَنْقَد",26,"د",1,0],["فلا تَغْبِطنَّ المترفين فإنهم","على حسب ما يكسوهُم الدهرُ يَسلب",27,"ب",1,0],["فلا تغرنك أنياب محددة","تصطك غيظاً لأمر عارض طاري",28,"ر",2,0],["فلا تغتررْ يوماً بإبْرَاق عُودِها","وكُنْ في فعالِ الصالحاتِ نَبِيهَا",29,"ي",3,0],["فلا تغتررْ من صاحبٍ بصداقةٍ","بدتْ مِنه في حالٍ يقدمها غُلُّ",30,"ل",1,0],["فلا تغْررْك ألسنةٌ عِذابٌ","تدُوفُ وراءها سُمّاً نقيعَا",31,"ع",2,0],["فلا تغترر بالمدح فالغدر ديدنٌ","لديه ومن عاداته الهجو إِن طوي",32,"و",2,0],["فَلاَ تَغتَرِر بالصَّفوِ مِنهُ فَصفمُوهُ","يُشَابُ إِذَا ما شِئتَ أن يَتَمَخَّضَا",33,"ض",2,0],["فَلا تُغفِلِ الإِطنابَ في النَظمِ وَالنَثرِ","لَقَد شَرَحَ المَولى لِأَحمَدَ صَدرَهُ",34,"ه",1,0],["فَلا تَغُرَّنَّكَ الدُنيا وَزِينَتُها","وَلَو حَبَتكَ بِحُمرِ الخَيلِ وَالنَعَمِ",35,"م",1,0],["فَلا تَغتَرِر بِالعَيشِ واحذَر فَإنما","صَفاءُ اللَيالي هُدنَةٌ من مُحارِبِ",36,"ب",1,0],["فلا تغترّ منه بعين صدق","ولاحظه بها إن كنت باصر",37,"ر",1,0],["فلا تغرنك هذي الدنا","فلم تُدم من حالها حالا",38,"ل",2,0],["فلا تغرنّ بالآمالِ أنفُسَنا","وللفرنسيسِ جوسٌ في نواحينا",39,"ن",2,0],["فَلاَ تَغْرَ الْحَوَادِثُ بِي فَحَسْبِي","جَفَاؤُكُمُ مِنَ النُّوَبِ الشِّدَادِ",40,"د",1,0],["فلا تغترر واعلم بأني عاجز","كسول أخو نوم فأعذر أخاكا",41,"ك",2,0],["فَلا تَغُرَّنكَ قَينَةٌ أَبَداً","وَدَع وِصارَ القِيانِ في النارِ",42,"ر",1,0],["فلا تغترر من لطفه بك دائما","فان انقلاب القلب أسرع طرآن",43,"ن",1,0],["فَلا تَغتَرَّ بِالدُنيا وَذَرها","فَما تسوى لَكَ الدُنيا خِلالا",44,"ل",2,0],["فلا تغرَّنْك أعوامٌ بها مرضٌ","ولا تهولنْك أتعابٌ بها فَرَق",45,"ق",1,0],["فلا تغد تطير","بها من غير قيمات",46,"ت",1,0],["فلا تغبِطَنَّ بِهِ نِعمةً","وعَلَّقْ يمينَكَ ياصاحِ بِهْ",47,"ه",1,0],["فلا تَغُرَّنَّكَ الَّليالي","فَبَرقُها الخلب الكذوب",48,"ب",1,0],["فَلا تَغبِطَنَّ أَمرأً في غَدٍ","سيقسِمُهُ السَيف مِن نِصفِهِ",49,"ف",2,0],["فلا تغتَرِرْ منه بدُرٍّ نظَمْتُهُ","فما ليَدَيْهِ منه شيءٌ سوى السِّلْكِ",50,"ك",1,0],["فلا تغربت عن أَهل وعن وطن","فقلت كل غريب فهو مغترب",51,"ب",1,0],["فلا تغلل حجاك بما تعاني","وما عانيت وافترض التاسي",52,"س",2,0],["فلا تُغمَزْ قناتُكمُ ببوعٍ","ولا يُسبر لكم غَوْرٌ وعُمقُ",53,"ق",1,0],["فلا تغررْك ألسنةٌ رطابٌ","بطائنهنَّ أكبادٌ صَوادي",54,"د",2,0],["فلا تَغُرَّنَّك تفَّاحةٌ","منها ولا بارقةٌ خالبُ",55,"ب",1,0],["فَلا تَغضبوا من سابقٍ بَلَغ المَدا","وَلوموا الّذي لم يُعْطَ سَبْقاً فيسبقا",56,"ق",2,0],["فَلا تغمصوها نعمةً إنْ تؤُمِّلَتْ","بِعينِ الحِجى أوفتْ على كلّ نعمةِ",57,"ه",1,0],["فَلا تَغضبي مِن صَنيعِ الزّمانِ","فما لكِ شيءٌ سوى الغضبةِ",58,"ه",1,0],["فَلا تَغشَ المَظالِمِ لَن تَراهُ","يُمَتَّعُ بِالغِنى الرَجُلُ الظَلومُ",59,"م",1,0],["فلا تَغتَرِر ما عِشتَ من مُتجَمِّلٍ","بِظَاهِرِ وُدّ قد تُغَطَّى البَطَائِنُ",60,"ن",1,0],["فلا تغررك مردته فإنّي","رأيت القبح إحدى اللحيتين",61,"ن",1,0],["فَلا تَغتَرِر بِرجالِ الزَّمانِ","فَإنَّ لِكُلِّ زَمانٍ رِجالا",62,"ل",2,0],["فَلا تَغفَلوا عَن قَطع دابر نسلهم","فَقَد ملأوا بِالفسق كُل المَلاحم",63,"م",1,0],["فلا تغفلن عن الواجبات","ولو كنت في غفلات الكرى",64,"ر",2,0],["فلا تغرَّنَّكَ الجسومَ إذا","أَتتك مثلَ النخلِ المواقيرِ",65,"ر",1,0],["فلا تغرَّنك أثوابٌ وألسنة","ولا يغُرنْك منهمْ لاحظ لحظا",66,"ظ",2,0],["فلا تغترر جهلا بما منه قد بدا","فليس لبابُ الأمر ما أنت مبصر",67,"ر",1,0],["فلا تغضبوا ممن رماكم الى الردى","كفانيَ ما عاناه قلبي كفانيا",68,"ي",2,0],["فَلا تغترر بِالناس واِختر أبرّهم","فَليس يساوي صادق البرّ كاذبُه",69,"ب",2,0],["فلا تغالب دموعا، كلما ظفرتْ","محمومةً، صدّها كِبْرٌ وسلطان",70,"ن",1,0],["فلا تغضب عروسك وهي بكر","فتجمعها بأرملة المعري",71,"ر",2,0],["فَلا تَغُرَّنكَ مِن دُنياكَ نَومَتُها","فَما صِناعَةُ عَينَيها سِوى السَهَرِ",72,"ر",1,0],["فلا تغترر يوماً إذا ما تبسّمت","تريك ابتسام الثغر والطبع أغلب",73,"ب",1,0],["فلا تغطيه شهايد زور","ولا ثعذار ولا أيمان",74,"ن",1,0],["فلا تغرنك الدنيا وزينتها","في ضمن إحسانها للمرء أحزان",75,"ن",1,0],["فلا تغبطه إن أصبح","بين الناس ذا وفر",76,"ر",1,0],["فلا تغتر بالتقريب منه","فإنَّ الله ينظر ما صنعتا",77,"ت",2,0],["فَلا تَغضَبنَ قَد تُستَعارُ ظَعينَةٌ","وَتُرسِلُ أُخرى كُلَ ذَلِكَ يَفعَلُ",78,"ل",1,0],["فلا تغترر بالحلم عن ظلم ظالم","سيأخذه أخذا وبيلا وعن يد",79,"د",1,0],["فلا تغترر ممن يسامح في الدنا","وأدّ حقوق الناس تسلم وترشد",79,"د",1,0],["فلا تغش قوما رحمة الله فيهم","ثوى قاطع قد جاء ذا يتوعّد",80,"د",1,0],["فلا تغالي في مجافاته","وقد تحكَّمتِ به فارفقي",81,"ق",2,0],["فلا تغتررْ في لينِ قولٍ وتأمننْ","إذا لم تطب منه لديكَ المخابرُ",82,"ر",1,0],["فلا تغترر بالكائنات بأسرها","وكل الذي تلقى زوال إلى محو",83,"و",1,0],["فَلا تَغُرَّنَّكُم دُنيا وَلا طَمَعٌ","لَن تَنعَشوا بِزِماعِ ذَلِكَ الطَمَعا",84,"ع",2,0],["فَلا تَغدونَّ إِلى واعِظٍ","فَلَستَ بمُنتَفِعٍ بِالعظاتِ",85,"ت",1,0],["فلا تغترر بالليث عند خدورهِ","فكم خادرٍ فاجا بوثبة صائلِ",86,"ل",1,0],["فلا تُغْفِل ملاحظتي، فجاهي","بما اكْتسبته آمالي رَهين",87,"ن",1,0],["فلا تغترّ باسم الدين يوماً","ففي كل الأنام يهود مال",88,"ل",1,0],["فلا تغترر بالأكثرين ورأيهم","فإن قليلَ الناس أرفع أذواقا",89,"ق",2,0],["فلا تغرنّهم منا ملاينة","فالنار قد تنتضي من ناضر السلم",90,"م",1,0],["فلا تغضبي يا مصر منهم فإنّهم","أهابَ بهم في حلبة الغيِّ مقصدُ",91,"د",1,0],["فَلاَ تُغِبْ نَاظِراً تَلْقَاكَ عَبْرَتُهُ","فالشَّمْسُ تُسْبِلُ دَمْعَ الأَعْيُنِ الرُّمُدِ",92,"د",1,0],["فَلا تُغزِنا آلُ الرِبابِ كَتيبَةً","معَدِّيَّةً أَو غَيرَ مَن قَد تَمَعدَدا",93,"د",2,0],["فلا تغتمَّ مما صار منها","ولا تهتمَّ من أمرٍ يصي