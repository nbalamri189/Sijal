14,"","https://poetry.dctabudhabi.ae/diwan/poem/65001","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64885","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108770","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141255","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101032","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109772","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77285","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201763",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200756","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112591","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132719","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132582","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100829","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87362","السريع"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97895","الكامل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117021","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89111","المتدارك"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74022","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86339","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92362","الكامل"],[4755,"لِلحُزنِ في وطني \"السّعيدِ\" مَنازلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=196917",""],[4796,"قالوا: سيأتي العيد","https://www.poetsgate.com/ViewPoem.aspx?id=181224",""],[4852,"كل الحشا أقداح","https://www.poetsgate.com/ViewPoem.aspx?id=215562",""],[5135,"لقد كَذَبُوني","https://www.poetsgate.com/ViewPoem.aspx?id=201883",""],[5190,"العرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179298",""],[5351,"عذاب اليوم..","https://www.poetsgate.com/ViewPoem.aspx?id=203746",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5358,"مجرى الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=183421",""],[5431,"امرأة ترغب بالانفصال...","https://www.poetsgate.com/ViewPoem.aspx?id=202032",""],[5431,"ياليتني...","https://www.poetsgate.com/ViewPoem.aspx?id=202666",""],[5691,"وكر الجواسيس... ويوم النكبة","https://www.poetsgate.com/ViewPoem.aspx?id=206158",""],[5736,"بلاغة حرف","https://www.poetsgate.com/ViewPoem.aspx?id=208880",""],[5789,"مغازلة الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=201410",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5837,"راس جسّاس","https://www.poetsgate.com/ViewPoem.aspx?id=182881",""],[5953,"يا محضر الغيد بالصمان بالغار","https://www.poetsgate.com/ViewPoem.aspx?id=93853",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[5970,"ودع حبيب القلب يوم المولد","https://www.poetsgate.com/ViewPoem.aspx?id=130617",""],[6068,"لثغة -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175925",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""],[6318,"السهم الأخير وفتىًُ يفَجَّر نفسَهَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66168&r=&rc=18",""]],"verses":[["قالوا سَكَتَّ وَقَد خُوصِمتَ قُلتُ لَهُم","إِنَّ الجَوابَ لِبابِ الشَرِّ مِفتاحُ",0,"ح",1,1],["قَالُوا سَلاَ حَرَّكَتْ أَشْوَاقَه فَسَلاَ","وَاللَّهِ مَا كُنْتُ يَوْماً عَنكَ بِالسَّالِي",1,"ل",2,0],["قالوا سَلا عَنكِ غَدراً وَاِبتَغى بَدَلاً","وَكانَ بِالأَمسِ مِن أَوفى رَعاياكِ",2,"ك",1,0],["قالوا سررت زائراً بقادم","حجَّ شهاباً ثم عادَ بدرا",3,"ر",2,1],["قالوا سقى الماءُ بطنَ وهبٍ","فقلت أنَّى وكيف ذاكا",4,"ك",2,1],["قالوا سينبغ عبقريّ مثله","قلنا بلى لو أنجب الآباء",5,"ا",2,0],["قالوا سينغ عبقري مثله","قلنا بلى لو انجب الآباء",6,"ا",2,0],["قالوا سيرجع حيا بعد ميتته","وهل سيرجع معدوم من العدم",7,"م",1,0],["قالوا سلا عمن احب فؤاده","اما السلو فانه بهتان",8,"ن",1,0],["قالوا سَلَوتَ لِبُعدِ العَهدِ قُلتُ لَهُم","سَلَوتُ عَن صِحَّتي وَالبُرءُ مِن سَقَمي",9,"م",2,0],["قالوا سَيُسليكَ العِذارُ سَفاهَةًً","وَحَصادُ عُمري في نَباتِ عِذارِهِ",10,"ر",2,0],["قالوا سَيَملِكُنا إِمامٌ عادِلٌ","يَري أَعادينا بِسَهمٍ صارِدِ",11,"د",1,0],["قالوا سَمِعنا حَديثاً عَنكَ قُلتُ لَهُم","لايُبعِدُ اللَهُ إِلّا مَعشَراً لَبَسوا",12,"س",3,0],["قالوا سيقبل يوم فيه مسعدة","فقلت أَيَّان ذاك اليوم أَيَّانا",13,"ن",2,0],["قالوا سنحيا جميعا","بعد الردى خالدينا",14,"ا",1,1],["قالوا: سيمْلِكُنا إمامٌ عادلٌ،","يرمي أعادينَا بسهمٍ صارد",15,"د",1,0],["قالوا سيجمع أشعاري جهابذة","من الشباب هواهم طبع ديواني",16,"ن",2,1],["قالوا سكنتَ السفح قل","تُ وهل يرد الحرَّ قِنّا",17,"ن",2,0],["قالوا سواىَ يطيلُ الشِعر قلت لهم","علي في مثل يحيى إن أطل نكرُ",18,"ر",1,0],["قالوا سبا مهجتي فقلتُ لهم","ما في يدِ العبدِ ملكُ مولاهُ",19,"ه",1,0],["قالوا سواها لو استبدلت قلت لهم","نعم تبدلت بالاسقام والغير",20,"ر",1,0],["قالوا سلاَ عنكَ فاسْلُ عن مَحَبَّته","فقلتُ مَنْ لي بأَنْ أَسْلُوه حينَ سَلاَ",21,"ل",2,0],["قالوا سواه صانعٌ كلَّ ما","يأتي به في السرّ والجهرِ",22,"ر",1,0],["قالوا سَلوا السُفّارَ إِن شَهِدوا بِما","أَبصَرتهُم حَقّاً بِلا نُكرانِ",23,"ن",1,0],["قالوا سَفاهاً قَد هَفَوتَ بِزَلَّةٍ","فَلِما اُلامُ وَلي لِسانٌ قَد هَفا",24,"ف",2,0],["قالوا سَفَكتَ دَماً عَزيزاً سَفكُهُ","وَيَدُ المَكارِمِ لا يُراقُ لَها دَمُ",25,"م",1,1],["قالوا سَلا صَدَقوا","عَن السُلوان لَيسَ عَن الحَبيبِ",26,"ب",1,1],["قالوا سَمعنا وهم لا يَسمعون وقد","أَوروا بجنبيَّ ناراً باِقتباسِهمِ",27,"م",1,0],["قالوا سفيه لصرفي عنهم بصري","ورغبتي عن ذوي العصيان في البشر",28,"ر",1,1],["قالوا سفيه لتفويضي إلى ملك","أمري عن الكون في صفوو في كدر",28,"ر",1,0],["قالوا سفيه لحبي خالقي ملكي","ولم أكن للبرايا أشتكي ضرري",28,"ر",2,0],["قالوا سفيه لكوني لم أخف أحدا","وما رجوت سوى الرحمن ذي القدر",28,"ر",1,0],["قالوا سفيه لقفوي نهج ملجإنا","للشيخ سيدي فحل الخير في الخبر",28,"ر",1,0],["قالوا سُبحانَكَ ما هَذا","بَشَراً لَما فتن البَشَرا",29,"ر",2,0],["قالوا سلا قلت الكَرَى جَفْنُه","قالوا جَنَى قلت ثِمارَ الهوى",30,"ه",3,0],["قالوا سواك هواك قبلك صابهم","هيهات فوق مصاب ذاك أصابني",31,"ن",2,0],["قالوا سهرتَ والعيو","نُ المسهَراتُ نوَّمُ",32,"م",1,0],["قالوا سخِطتَ على الأنام وإنما","سخطي لجهلهمُ بوجه رضائي",33,"ي",1,0],["قالوا سفهتَ نعم سفهتُ صبابةً","والحبُّ ما تركَ الحليم مسفّهاً",34,"ه",2,0],["قالوا سلكْنا طريقاً لا اعْوِجاجَ به","وفيه قَنْطَرَةٌ بالشِّرْكِ حدباءُ",35,"ا",2,0],["قالوا سَلَوتَ فَقُلتُ الصَّبرُ في كَلفي","قالوا يَئستَ فَقُلتُ البُرءُ في سَقَمي",36,"م",2,0],["قالوا سَباكَ بِحُسنهِ عَجَباً لهم","أَوَ مِثلُ هذا الحُسنِ لا يَسبيني",37,"ن",2,0],["قالوا سَلَوْتَ فقلتُ حاشَ لمنْ","عشق الفضائلَ أنْ يقال سَلا",38,"ل",2,0],["قالوا سمعنا بأن القلب منك سلا","فقلت عمن سواكم ذا من القدم",39,"م",1,0],["قالوا سمعنا عنك قولا قلته","قال نعم بيعتكم لي فلته",40,"ه",1,0],["قَالُوا سَمِعْنَا في البِلادِ قَضِيَّةً","مَضْمُونها أَنْ قَدْ قَضَى القِسّيسُ",41,"س",1,1],["قالوا سَمِعنا وأطعنا كلُّنا","وأسرعوا بالأَلسنِ اشتغالَها",42,"ل",3,0],["قالوا سَمعنا أَنيناً مِنهُ أَورثنا","بثّاً وَعَنا تَوارى جسمُه الفاني",43,"ن",2,0],["قالوا سَمِعنا وَأَطَعنا قَولك","أَنتَ لَنا وَنَحنُ يا سَيِّد لَك",44,"ك",1,0],["قالوا سَيَقتُلُكَ الغَرا","مُ فَقُلتُ مالَكُمُ وَقَتلي",45,"ل",2,1],["قالوا سمعنا فلما أن قضى غدروا","والطهر أحمد ما واروه في الجبن",46,"ن",1,0],["قالوا سمعنا وفي أكبادهم حرق","وكل مستمع للقول يجحده",47,"د",2,0],["قالوا سَيُنْبيكَ عَنْهُ الْبَيْنُ قُلْتُ لَهُمْ","مَا الْيَوْمُ أَوَّلُ تَوْديعي ولا الثّاني",48,"ن",2,0],["قالوا سَلَوْتَهمْ فقُلْ","تُ كَذَبْتُمُ حاشا وكلاَّ",49,"ل",2,0],["قالوا سلوتَ فقُلْتُ لمْ","قالوا أَتَسْلو قُلْتُ لَنْ",50,"ن",1,0],["قالُوا سَلَوْتَ قُلْتُ عن سُلوانِهمْ","قَلْبي مِنَ السُّلوانِ قاعٌ صَفْصَف",51,"ف",1,0],["قالوا سما هذا النهار بنوره ال","زاهي وفاخر كل عيد سابق",52,"ق",1,1],["قالوا سليمان في دنياه كان له","من النسا مئة من دون نقصان",53,"ن",1,0],["قالوا سلا بعدنا لو أنهم علموا","ماذا لقيت غداة البين ما قالوا",54,"ل",3,0],["قالوا سلكتَ بنظم الشعر خير سنن","وان رأيك فيه صائبٌ وحسن",55,"ن",1,1],["قالوا سَمِعتَ دِفاعَهُ وَنَراكَ يا","مَطعونُ هِجتَ سُيوفَ لَحظِ الطاعِنِ",56,"ن",1,0],["قالوا ستخلد قلت كيف وهل","يُجدي الضياءُ وماله راءِ",57,"ا",2,0],["قالوا سيجرفُ