{"poems":[[4,"انع الكريم للكريم أربدا","https://www.aldiwan.net/poem21159.html","الرجز"],[53,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[53,"نكهت شنطف ففاح كنيف","https://www.aldiwan.net/poem65728.html","الطويل"],[102,"الضباب .. وشمس هذا الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=50327",""],[136,"صبغت بدمع عاشقك الخدودا","https://www.aldiwan.net/poem54860.html","الوافر"],[164,"إذا كان من عاداك يصبح نادما","https://www.aldiwan.net/poem58900.html","الطويل"],[214,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[240,"يا من رأى حد الحسام مضاءه","https://www.aldiwan.net/poem31747.html","الكامل"],[240,"ما سمع الناس ولا أبصروا","https://www.aldiwan.net/poem31959.html","السريع"],[438,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[463,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124612","الكامل"],[1380,"","https://poetry.dctabudhabi.ae/diwan/poem/21306","الطويل"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100686","الوافر"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105412","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141737","السريع"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120526","الطويل"],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""]],"verses":[["يُحذي وَيُعطي مالَهُ لِيُحمَدا","أُدماً يُشَبَّهنَ صُواراً أُبَّدا",0,"د",2,0],["يحذق الناس ما تعاطوا وما أح","سب مدحاً في مثلكم محذوقا",1,"ق",2,0],["يحذر الفيل أن يموت غريقاً","فيه لا أن يموت فيه خنيقا",2,"ق",2,0],["يحذر الميت رمسه ، وجنسن","قاذف وجهه ، إلى المهد رمسّا",3,"س",2,0],["يُحَذِّرُهم ويُغرِيهم وَيغرِى","بِهِم تِيهاً مُضَلَلَةً وبِيدَا",4,"د",2,0],["يحذر من لاقا وينذر قومه","مغايظ لاقوها تحر الغلاصما",5,"م",2,0],["يحذرني عنه العذول بجهله","وعندي تحذير العذول هو الاغرا",6,"ر",2,0],["يَحذو أَوامِرَكَ المُطاعَةَ جاهِداً","فيها وَيَنتَهِجُ السَبيلَ الأَقوَما",7,"م",2,0],["يَحذِفُ في الدَستِ بِأَعضادِهِ","كَأَنَّهُ المَلّاحُ في المَعبَرِ",8,"ر",1,0],["يحذَرُ عزماً كلَّ ذي انتفاضِ","وإذا العدى ناراً على ارتِماضِ",9,"ض",1,0],["يحذَرُ منها العُصْمُ فرطَ خُدَعِي","يا لَلرجالِ من يحطُّ العُصُما",10,"م",2,0],["يحذر منه العقل حتى يكبه","بكانونه يشويه لم يدر ماجرا",11,"ر",2,0],["يحذو محاذي صالحي أسلافه","المتسيّرين بسيرة القرآن",12,"ن",1,0],["يحذِّرُني المَوتَ ابنُ حبناءَ وَالفَتى","إِلى المَوتِ يَغدو جاهِداً وَيروحُ",13,"ح",1,1],["يحذرك الأحبة وقع كيدي","فليس بذاك مذعورا مهولا",14,"ل",2,0],["يحذر بي عقب السلو نزوله","ويغري فؤادي بالغرام صعوده",15,"د",2,0],["يحذرها الكافر في كفره","كمثل ما يحذرها المستقيم",16,"م",1,0],["يحذيه أي يجرحه وقد حذا","نعلا بنعل ورد اللفظ كذا",17,"ذ",2,0],["يحذرنا من حينه في غرامه","وينذرنا الآفات من دائه المعدي",18,"د",2,0],["يحذر الناس كي لا يسمعوا كتبا","تدعو إلى الله من قد ند وانصرفا",19,"ف",2,0]]}