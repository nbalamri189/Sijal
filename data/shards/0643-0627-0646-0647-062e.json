{"poems":[[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[189,"انظر إلى المجلس الأعلى وما جمعت","https://www.aldiwan.net/poem14138.html","البسيط"],[409,"عذل العذول لباب السمع ما ولجا","https://www.aldiwan.net/poem34095.html","البسيط"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90723","البسيط"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31497","البسيط"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202344","البسيط"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103141","البسيط"]],"verses":[["كأنه خليفة قد أقدما","يفسد في الأرضِ ويسفكُ الدما",0,"م",2,0],["كَأَنَّهُ خارِجاً مِن جَنبِ صَفحَتِهِ","سَفّودُ شَربٍ نَسوهُ عِندَ مُفتَأَدِ",1,"د",1,0],["كَأَنَّهُ خَاضَ نَهْرَ الصُّبْحِ فَانْتَبَذَتْ","يُمْنَاهُ وَانْبَثَّ فِي أَعْطَافِهِ الطَّفَلُ",2,"ل",1,0],["كأنه خَلَلَ الأشجارِ لؤلؤةٌ","نَظْمُ الزُّمردِ فيها غير منفسحِ",3,"ح",1,0],["كأنه خاف من نار الغرام وما","درى بأن لنا مما يخاف رجا",4,"ج",2,0],["كأنَّهُ خَدُّ مومُوقٍ يُقبلُهُ","فَمُ الحبيب وقد أبدَى به خَجلا",5,"ل",2,1],["كَأَنَّهُ خالِدٌ في بَعضِ مِرَّتِهِ","وَبَعضُ ما يَنحَلُ القَومُ الأَكاذيبُ",6,"ب",1,0],["كأنه خاف أن ينسى السماح فما","يزال منه له درس يردده",7,"د",2,0],["كأنه خلاق ميمٍ في تعقفه","مداده ذوب عقيانٍ يصفره",8,"ر",2,0]]}