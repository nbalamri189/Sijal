{"poems":[[95,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[95,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[74,"رب عيش نصبت كأس مدامه","https://www.aldiwan.net/poem19674.html","الخفيف"],[64,"يا ليل طوبى لمعشر رقدوا","https://www.aldiwan.net/poem52438.html","المنسرح"],[47,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[46,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[33,"ليت هندا أنجزتنا ما تعد","https://www.aldiwan.net/poem42576.html","الرمل"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[48,"أكمها ليس بينهم بصير","https://www.aldiwan.net/poem22479.html","الوافر"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20249","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55092","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142000","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141939","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116998","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[92,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[47,"شَطَّ مِنْ ساكِنِ الغُوَيْرِ مَزَارُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31263",""],[93,"مرآة الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=53067",""],[48,"أكُمْهاً ليس بينَهُمُ بصيرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=18581",""],[136,"أكمام جنبت لقاء الشدة","https://www.aldiwan.net/poem54870.html","الرجز"],[141,"إنني فكرت في عمر","https://www.aldiwan.net/poem68025.html","المديد"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[310,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[406,"خير أمة","https://www.aldiwan.net/poem10301.html","عموديه"],[409,"سيان من يعذر أو يعذل","https://www.aldiwan.net/poem33487.html","السريع"],[487,"أسرت بدور أم بدت هالات","https://www.aldiwan.net/poem24292.html","الكامل"],[580,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"],[580,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64870","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64694","المجتث"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108579","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141294","الكامل"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107033","الرجز"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11231","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69420","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104785","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96038","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53080","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77438","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126229","الرجز"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111230","الرجز"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132305","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137211",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65942","الكامل"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101879","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62914","المنسرح"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202270","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110063","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128894","الخفيف"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133260","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135780","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111440","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28765","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89594","المديد"],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[4690,"نافِخُ الفَقَاقيع","https://www.poetsgate.com/ViewPoem.aspx?id=179923",""],[4775,"عادات \"ريمات\"","https://www.poetsgate.com/ViewPoem.aspx?id=175229",""],[4802,"سلة أوجاعي","https://www.poetsgate.com/ViewPoem.aspx?id=32784",""],[4821,"غُرّةُ الكَوْن ذاتُ بِش","https://www.poetsgate.com/ViewPoem.aspx?id=120390",""],[5092,"نعمْ هي لي","https://www.poetsgate.com/ViewPoem.aspx?id=139680",""],[5212,"وارث النَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=211736",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[307,"ملكة الدار","https://www.poetsgate.com/ViewPoem.aspx?id=214581",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5574,"يا أيّها الرّسام","https://www.poetsgate.com/ViewPoem.aspx?id=206043",""],[5642,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=123668",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5956,"إخلاصُك المعروفُ عنك","https://www.poetsgate.com/ViewPoem.aspx?id=194138",""]],"verses":[["أَكْمَلُ الْجُودِ مَا بِهِ كَثُرَ الصَّفْ","وَةُ فِي أُمَّةٍ وَقَلَّ الطَّغَامُ",0,"م",1,0],["أَكْمِلْ بَلاغَكَ يَا حَكِيمُ وَقلْ","أَحَيَاتُنَا خَيْرٌ مِنَ العَدَمِ",1,"م",1,0],["أكمل العالمين فضلاً فما نس","أل ربَّ العباد غير دوامه",2,"م",2,0],["أكمَهُ ضَلَّ الطريقَ منفرداً","ما عندَهُ من هُداتِه أحَدُ",3,"د",1,0],["أَكمَلَ اللَهُ في أَبا الحَسَنِ الحُس","نى الَّتي أُغرِيَت بِها أَوطارُه",4,"ر",2,0],["أَكمَلتَ مِنهُ بَعدَ نَقصٍ كُلَّ ما","نَقَصَتهُ أَيدي الكُفرِ بَعدَ كَمالِ",5,"ل",1,0],["أَكَما يَنعَتُني تُبصِرنَني","عَمرَكُنَّ اللَهَ أَم لا يَقتَصِد",6,"د",1,0],["أُكْمِلَتْ خِلْقَتي وَشَيبي وما لي","في حُجُورٍ اُخْتٌ وَلا فِي مِهَارَهْ",7,"ر",2,0],["أَكُمهاً لَيسَ بَينَهُمُ بَصيرٌ","أَما لَكُم إِلى العَلياءِ هادِ",8,"د",1,1],["أَكمِلوا نَقصَهُ يَكُن عَبقَرِيّاً","مِثلَ طَهَ مُبَرَّزاً في الطُروسِ",9,"س",1,0],["أَكْمَلْتَ لِلعُقْبَى جِهَادَكْ","فَارْقُدْ عَنِ الدُّنْيَا رُقَادَكْ",10,"ك",1,1],["أكما شاؤوا غنائي","وكما شاؤوا نُواحي",11,"ي",1,0],["أكماته البيضاء تحت سمائه","الزرقاء أطفال تنام وتحلمُ",12,"م",1,0],["أكما ينعِتُني تُبصرنَني","عمرُكُنَّ اللَه لم لا يقتَصد",13,"د",1,0],["أَكْمَلَ الدينَ بِالزَّوَاجِ فَأَسْدَى","مَثَلاً لَوْ دَرَى الشَبَابُ رَشِيدا",14,"د",2,0],["أكُمُّ به الأفواهَ حقا وباطلا","وأخْنُقُ أنفاسا به ومواهبا",15,"ب",2,0],["أكْمَلَ الله في أبي الحَسَنِ الحُسْ","نَى، التي أُغرِيَتْ بها أوْطَارُهْ",16,"ر",2,0],["أكمن إلى الوزر عامدا","ويضحك مختالا إذا مسّه الوزر ؟",17,"ر",1,0],["أكُمْهاً ليس بينَهُمُ بصيرٌ!","أما لكُمُ، إلى العلياءِ، هادي؟",18,"د",2,1],["أكمَامُ جُنِّبتُ لقاءَ الشدةِ","ونلتِ محضَ الحُبِّ والمودَّةِ",19,"ه",1,1],["أَكمَلَ الوادِيُّ صَنعَتَهُ","في لُبابِ الشِعرِ فَاندَمَجا",20,"ج",2,0],["أكملَ اليومَ دينَهم رضيَ الإس","لام ديناً وتمّت النعماءُ",21,"ا",2,0],["أكملت جامعها فها تاريخه","هو والمقدم في الصنيع سواءُ",22,"ا",2,0],["أكمل اللهُ به الإسلامَ ديناً","خالياً من كلِّ نُقْصٍ وأَتمَّهْ",23,"م",2,0],["أكمل من يمشي على ظهرها","وخير من عنه العلى ينقل",24,"ل",1,0],["أكميت ظلم أم عقار سلافة","أمرام خل عندها راحات",25,"ت",1,0],["أَكْمِنُ في كُمِّي دموعي حَياً","فهل عَلِمْتمْ أَنَّ كٌمِّي كَمِين",26,"ن",1,0],["أَكْمَلُ الخلق في الشمائِل وَزْناً","وبذَوقِ صَحَّ اعْتِبَارُه",27,"ر",2,0],["أكمل العالمين خلقا وخلقا","فهو ملء العيون ملء الصدور",28,"ر",1,0],["أكمل خلق الجميل ذاتا","وخير من خص بالأيادي",29,"د",2,0],["أكمل العالمين خلقا وخلقا","فهو ملء العيون والأكباد",30,"د",1,0],["أكمل العالمين روحا وذاتا","وصفاتا ومظهرا واستتارا",31,"ر",2,0],["أَكْملْتُ سِتّاً وأَرْبعينَ بِها","أَخْلَتْ هُمومي مِنْ راحَتي رَبْعي",32,"ي",1,1],["أكَملْتَ كلَّ المناقِبْ","يا خَيْرَ ماشٍ وَراكِبْ",33,"ب",1,1],["إكمالهُ تسويةٌ في وصفه","لكل خط قد مضى من صنفه",34,"ه",1,0],["أكمدت يا ليث المعامع حاسدي","ودفعت عني الفاجر النباحا",35,"ح",2,0],["أكمل رسالته وكن للأسرة ال","غرّاء حولك أمّها وأباها",36,"ا",3,0],["اكمل فيه دينه المبينا","ثم ارتضى الاسلام فيه دينا",37,"ن",2,0],["أَكُمَّثرى يَزيدُ الحَلقَ ضيقاً","أَحَبُّ إِلَيكَ أَم تينٌ نَضيجُ",38,"ج",1,1],["أُكمِلتَ خُلقاً وَخَلقاً مِثلَهُ حَسَناً","وَالخَلقُ لِلخُلقِ تَتمِيمٌ وَتَكمِيلُ",39,"ل",1,0],["أُكَمِّلُها حِسّاً وَلم أَدرِ لِلَّذِى","فَعَلتُ وَقُلتُ أَىُّ مَعناهُ اُثبِتِ",40,"ت",1,0],["أكمي كمي ومن كان الوصي له","اباً فذاك كمي فوق كل كمي",41,"م",2,0],["أَكُمَاةٌ على متون الجياد","أم صقورٌ تطير بالآساد",42,"د",1,1],["أَكمَلُ الخَلقِ صورَةً يُبدِعُ ال","لَهُ تَعالى مِن نورِهِ ما يَشاءُ",43,"ا",2,0],["أكملُ أو بِعِدلِهِ فى خُلقٍ","كان بمعنى أو بخلقٍ جَسَدا",44,"د",2,0],["أكمل مولود يعز مثله","ان النساء مثله لا تلد",45,"د",1,0],["أكمامُهُ بِسَنى الجِيادِ تَفَتَّقَت","وتَكَلَّلَت بالشارَةِ الحَمراءِ",46,"ا",2,0],["اكميل شمعون المفدى دمت في","نعم ومجدك دائماً يزداد",47,"د",1,1],["أكمثل من عرف العواقب أن يرى","متلذذاً بمعيشة ونكاح",48,"ح",1,0],["أكمام وشقيق وجنتاه","أم هو الريحان حول الجلنار",49,"ر",1,0],["أَكمى وأرمى منه بصارمةٍ","لا تتقيها الدُّروعُ الدَّرَقُ",50,"ق",1,0],["أكمل من عبد كلال وحجر","لو جمعا لم يبلغا منه العشر",51,"ر",1,0],["اكملوا بالسَداد كلَّ كَمالٍ","تمموا بالجِهادِ كُلَّ تِمامِ",52,"م",1,0],["أكما يزعمون من بعد موتي","أنا أغدو مع النسيم السائر",53,"ر",1,0],["أكمه تُنسَبُ لاِبنِ مهدي","رابيةٌ في القاع مثل النّهدِ",54,"د",1,0],["أكمامها وتنسّقت","فيها الفواكه بانتظام",55,"م",1,0],["إكمالَ فضلكَ وبالنبيِّ","صلِّ عليه أبدَ العليِّ",56,"ي",1,0],["أَكمَنَت إيهٍ إِذاً مِنكِ المَدَد","لَهَبُ الشَهوَةِ وَالحُبُّ الذي",57,"ي",1,0],["أَكمَلَ القَوسَ آلةً لَيسَ تبرا","طَرَفَيها بِخَالِصِ التِّبرِ حَلَّى",58,"ل",2,0],["أكمل الكاملين كل كمال","منه فضلا سرى الى الفضلاء",59,"ا",2,0],["اكمد بِدائِكَ هَل رَأَيتَ كَذا","بَدراً يَلوحُ بِخَدِّهِ البَدرُ",60,"ر",1,0],["أَكَمالاً كَيفَ لِنتَ لَنا","لِسِوانا كَيفَ لَم تَلِنِ",61,"ن",1,0],["أكملتَ يا ربُّ ديناً لن نضام به","والعزّ للدين هذا خير منسجم",62,"م",1,0],["أكْمِلِ التَّنْصيبَ هَيّا","وانْتَخِبْ للْحُسْنِ مَسْخَا",63,"خ",2,0],["أكمل الحب انتصارا للهزيمه","قال عودي كشري ناب النميمه",64,"م",2,1],["أكمل لك وجع خوف ووجع فقر ووجع ضيقة","وعلى كيفك ترتبني حلالك بالغلا أوجاعي",65,"ع",2,0],["أكْملُ الكاملين ما كان مثْلٌ","لسناك الفريد شأوا وأمرا",66,"ر",2,0],["أكمَّدُ كلَّ صبحٍ جرحَ ليلي","بماء الصبرِ , يحرقني الكِمادُ",67,"د",1,0],["أكمَلتَ دينَ الحقِّ حقَّ كمالِهِ","حتّى ارتقى جَبَلاً على الأديانِ",68,"ن",1,0],["أكمل مشاوير الحياة وعش لنا","ذخرا فمجدك قدوة الشبان",69,"ن",1,0],["أكملتُ ديني بالقرانِ وأنّه","حُسنُ المتاعِ مودّةً وودودا",70,"د",2,0],["أكْمَلْتَ دِينَ الحَقِّ يا خيرَ الورى","وَ أنَلْتَنَا شرفًا يَدُومُ أثِيلا",71,"ل",2,0],["٩- أكملْ - فديْتُكَ - لوحةً قد زُخرِفتْ","بمُبادراتٍ لن تضيعَ مَليّا",72,"ي",2,0],["أكملت حظَّها لدينا فشدّت","رحلَها للمسيرِ نحو النصيبِ",73,"ب",1,0],["اكمله الله بلطفه ولم","تبق به من نعمة لم تتمم",74,"م",1,0],["أكملْ تلاقينا فإنه واجبٌ","ما بيننا أيقِظْ لقانا الهاجدا",75,"د",2,0]]}