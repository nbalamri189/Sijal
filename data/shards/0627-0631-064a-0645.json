diwan/poem/92012","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135226","الهزج"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69988","البسيط"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119387","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119383","البسيط"],[4201,"","https://poetry.dctabudhabi.ae/diwan/poem/143811","المتقارب"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83412","السريع"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136446",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4884,"أرى الظّلمَ كالدّجّالِ أعورَ","https://www.poetsgate.com/ViewPoem.aspx?id=201727",""],[4884,"بِشُؤْمِ المُتنبِّي","https://www.poetsgate.com/ViewPoem.aspx?id=201772",""],[5038,"تعال نغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=188834",""],[3591,"لا زاهدٌ في الدنيا كلٌّ لقد كذبا","https://www.poetsgate.com/ViewPoem.aspx?id=149398",""],[5135,"خَيلُ البشائر","https://www.poetsgate.com/ViewPoem.aspx?id=201871",""],[5224,"أراني أراك ولست أراك","https://www.poetsgate.com/ViewPoem.aspx?id=121303",""],[5320,"من أين هذا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=41630",""],[5363,"طوبي ليبيا ابْتسمي","https://www.poetsgate.com/ViewPoem.aspx?id=144294",""],[5582,"أَرَى ماءَ الجُفُونِ جَرَى وَفاضَا","https://www.poetsgate.com/ViewPoem.aspx?id=187175",""],[5582,"كَئِيبٌ ما النَّسِيمُ سَرَى عَلِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=63608",""],[5758,"إلى ابن زريق البغدادي","https://www.poetsgate.com/ViewPoem.aspx?id=200531",""],[5992,"أرى مُرهفاً للبرق سُلَّ على الدجى","https://www.poetsgate.com/ViewPoem.aspx?id=41828",""],[6090,"أشرق كالبدر بآفاق السما","https://www.poetsgate.com/ViewPoem.aspx?id=170918",""],[6120,"حبيب العيون","https://www.poetsgate.com/ViewPoem.aspx?id=213474",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""],[6198,"حمائم الشجن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79298&r=&rc=72",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""],[463,"على أيّ لائمة ٍ أربعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60121&r=&rc=177",""],[6260,"الشهيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6170&r=&rc=0",""],[5567,"قالت الشهباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69064&r=&rc=4",""],[6364,"قبر في المرج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82466&r=&rc=5",""]],"verses":[["أَرى مُلوكاً كَالبِهامِ غَفلَةً","في مِثلِ طَيشِ النَعَمِ الجَوافِلِ",0,"ل",1,0],["أَرى مَوضِعَ المَعروفِ لَو أَستَطيعُهُ","وَأُغضي وَلَو شاءَ الغِنى لِيَ لَم أُغضِ",1,"ض",1,1],["أَرى ماءَ وَجهِ المَرءِ مِن ماءِ عِرضِهِ","فَحِذرَكِ لا يَقطُر عَلى العارِ قاطِرُه",2,"ر",2,1],["أرى مَلَلاً حيثُ التَفَتُّ يُهيبُ بي","وما كُنتُ أخْشى أن أُفارِقَ عنْ قِلى",3,"ل",2,0],["أَرى مِصرَ وَالسودانَ وَالهِندَ واحِداً","بِها اللُردُ وَالفيكُنتُ يَستَبِقانِ",4,"ن",1,0],["أَرى مِصرَ وَالأَنوارُ مِنها مُوَرَّدٌ","وَمِنها لُجَينِيٌّ وَمِنها مُذَهَّبُ",5,"ب",1,0],["أَرى مِنّا قَريباً بَيتَ زَورٍ","وَزَورٌ لا يَزورُ وَلا يُزارُ",6,"ر",1,1],["أرى مستقبل الأيام أولى","بمَطْمَح من يحاول أن يسودا",7,"د",2,1],["أرى معجز الرسل انْطوى بانْطوائِهم","ومعجزهُ حتَّى القيامة ينشر",8,"ر",1,0],["أرى منْ تعاطَى ما بلغْتُم كَرَائمٍ","مَنالَ الثريَّا وهو أكْمهُ مُقْعَدُ",9,"د",1,0],["أرى ماءً وبي عطشٌ شديدٌ","ولكنْ لا سبيل إلى الورودِ",10,"د",1,1],["أرى مُطرياتي عِبنَني ورفَضْنني","وذو الشَيب أهلٌ أن يُعاب ويرفضا",11,"ض",2,0],["أرى مجدهم مثل الجبال فإنها","بُنَى اللهِ إذ مجد الورى كالصنائع",12,"ع",1,0],["أَرى مُستَقبَلاً يَبدو عُجابا","وَعُنواناً يُكِنُّ لَنا كِتابا",13,"ب",2,0],["أَرى مِصرَ يَلهو بِحَدِّ السِلاحِ","وَيَلعَبُ بِالنارِ وِلدانُها",14,"ن",3,0],["أَرى مَرعَشاً يَستَقرِبُ البُعدَ مُقبِلاً","وَأَدبَرَ إِذ أَقبَلتَ يَستَبعِدُ القُربا",15,"ب",2,0],["أَرى مِن فِرِندي قِطعَةً في فِرِندِهِ","وَجَودَةُ ضَربِ الهامِ في جَودَةِ الصَقلِ",16,"ل",1,0],["أَرى مائَتي تَعَذَّرَ مُبتَغاها","وَكانَ الحَقُّ أَن أُعطى مِئينا",17,"ن",2,0],["أَرى مُضَرَ المِصرَينِ أَشرَقَ نورُها","إِذا قامَ فيها حينَ يَغدو بِلالُها",18,"ل",3,0],["أَرى مُضَرَ المِصرَينِ قَد ذَلَّ نَصرُها","وَلَكِنَّ قَيساً لا يُذَلُّ شَآمُها",19,"م",3,0],["أرى مَنَّ الحُسينِ بلا امتنانٍ","وإحسانَ الحسينِ بلا نَفادِ",20,"د",1,0],["أَرى مَن بِها يَقضي عَلَيَّ لِنَفسِهِ","وَلَم أَرَ مَن يَرعى عَلَيَّ وَلا يُبقي",21,"ق",2,0],["أَرى ما يَسوءُ النَفسَ مِن فِعلِ جاهِلٍ","فَآخُذُ في تَأديبِها بِخِلافِهِ",22,"ه",1,0],["أَرى ما يَلي نَجداً إِذا ما حَلَلتِهِ","جَميلاً وَأَهوى الغَورُ إِن تَتَتَهَّموا",23,"م",3,0],["أَرى مُستَقيمَ الطَرفِ ما أَمَّ نَحوَكُم","فَإِن أَمَّ طَرفي غَيرَكُم فَهوَ أَحوَلُ",24,"ل",1,0],["أَرى مَشاهِدَ مِن قَومي مُبَغَّضَةً","يَرضى العَمى وَيَوَدُّ المَوتَ رائيها",25,"ي",3,0],["أَرى مِصرَ في عَمياءَ يَقذِفُ جَوفُها","بَوائِقَ تودي بِالبَصيرِ وَبِالعَمي",26,"م",2,0],["أرَى مِنكَ قَوساً لَو تَغَمَّدَك المَدَى","بناب وباز لو صحبت غضنفرا",27,"ر",2,0],["أُرى مُستَقيم الطَرفِ ما الطَرفُ أَمَّكُم","وَإِن أَمَّ طَرفي غَيرَكُم فَهوَ أَحوَلُ",28,"ل",1,0],["أرى ملوكَ الأرض عُبْدانَهُ","وما بهِمْ فَقْرٌ إلى العِتْق",29,"ق",1,0],["أرى مدحَهُ كالمدح للهِ إنّهُ","قُنوتٌ وتسبيحٌ يُحَطُّ به الوِزر",30,"ر",1,0],["أَرى مُطعِمَ الرَمسِ اللِهَمَّ خَليلَهُ","سَيَأكُلُ مِن بَعدِ الخَليلِ وَيَشرَبُ",31,"ب",1,0],["أَرى مَقِرّاً في آخَرِ العَيشِ كائِناً","نَسيتَ لَهُ ما أَطعَمَتكَ الجَوارِسُ",32,"س",1,0],["أَرى مُهرِقَ الدَمَعاتِ يوجِبُ سَفحَهُ","جِناياتُ خَطبٍ أُثبِتَت في المَهارِقِ",33,"ق",1,0],["أَرى مَلَكاً طانَهُ لِلحِمامِ","فَكَيفَ يُوَقّى بَطينُ المَلِك",34,"ك",1,0],["أَرى مَرَضاً بِالنَفسِ لَيسَ بِزائِلٍ","فَهَل رَبُّها مِمّا تُكابِدُ شافيها",35,"ي",3,0],["أَرى من خلال الدمع حين أصبه","تعاسة أَيامي ببغداد ألوانا",36,"ن",2,0],["أرى مرهفاً مدهش الصيقلين","وبابة كل غلامٍ عتا",37,"ت",2,1],["أرى من فرندى قطعةً في فرنده","وجودةُ ضرب الهمام في جودة الصقل",38,"ل",1,0],["أرى ما أرى جسَداً عارياً","تضجُّ به الشهوةُ الجائعهْ",39,"ه",1,0],["أرى ما أرَى حَدَقيْ ساحر","تؤجّان بالنظرة الرائعهْ",39,"ه",1,0],["أرى ما أرى شَفتيْ غادةٍ","ترِفَّان بالقُبلَةِ الخادعهْ",39,"ه",1,0],["أرى ما أرى لهباً بل أشمُّ","رائحةَ الجسد المحترقْ",39,"ق",1,0],["أرى ملكاً تحف به موال","له نظر إلى الدنيا حديد",40,"د",1,1],["أَرَى مِثْلَ سُهْدِي في الكَوَكبِ","أَحَلَّ بِهِ مِثْلُ مَا حَلَّ بِي",41,"ب",2,1],["أَرى مِلءَ عَينَيَّ الرَدى فَأَخوضُهُ","إِذِ المَوتُ قُدّامي وَخَلفي المَعايِبُ",42,"ب",1,0],["أرَى ما أَرَى إلاَّ غُباراً أَثَارَه","خَمِيسُ اللَّيالي حِينما ثَارَ ثَائِرُه",43,"ر",2,0],["أرى مصر يلهو بالسلاح شبابُها","فيا لشباب بات بالنار لاهيا!",44,"ي",2,0],["أرى منكم فريقًا حين يمشي","يحكُّ بأنفه ظهر السحاب",45,"ب",1,0],["أرى مُضَرَ المِصْرَينِ أشرَفَ نُورُها،","إذا قامَ فِيها، حِينَ يَغْدُو، بِلالُها",46,"ل",3,0],["أرى مصر ولاة ً لا خلاق لهم","بئس الولاة وبئس الناس والزمن",47,"ن",1,1],["أَرَى مُسْتَكِيناً لأَقْرَانِهِ","إِذاً لاَ اسَغْتُ مِنَ الْمَاءِ عَذْبَا",48,"ب",2,0],["أرى متعاطيا للعلم يأتي","بتخليط وراي مستحيل",49,"ل",1,0],["أرى ما أشتهيه يفرّ منّي","وما لا أشتهيه إلي يأتي",50,"ت",2,1],["أرىما تمنحُ الدنيا هموماً","فأهنى العيشِ أمنٌ وافتقارُ",51,"ر",1,0],["ارى مدحه فرضا عليّ وواجبا","فكم قد صرت منه لى نوافله",52,"ل",2,0],["أَرَى مالَكَ للجَدْوَى","مُبَاحاً ليس يَنْصان",53,"ن",1,0],["أرى محنُ الأيام ماليّ مذ سَطَتْ","يدٌ ليس يخلو من شَباها ولا زَنْد",54,"د",1,0],["أَرى مَن لا تَشاقُ إِلَيهِ عَيني","وَأَسمَعُ ما تَصَمُّ عَلَيهِ أُذني",55,"ن",2,0],["أَرى ماءَ وَردِكُم قَد سَرَت","فَأَعدَت رَوائِحُهُ حُرقَتي",56,"ي",1,1],["أرى منهُ جنّاتٍ دوانٍ قطوفُها","وغيري يَرَى منهُ رِمالَ المفاوز",57,"ز",1,0],["أرى مهجةً حرّى إلى كلّ نجمةٍ","تطيرُ وقلباً تحتها يَتَمزَّق",58,"ق",1,0],["أرى مِحنَتي لي مِنحَةً ودُجُنَّتي","ضياءً يريني واضحاً كلَّ مُبهَم",59,"م",1,0],["أَرَى مِنْهُ بَدْرَ المُلْكِ دُونَ سِرارِهِ","وأبْصر بَحْرَ الجُودِ غَيْرَ غَرَامِهِ",60,"م",2,0],["أَرى ماءَ حَمّامِكُم كَالحَميمِ","نُكابِدُ مِنهُ عَناءً وَبُوسا",61,"س",2,1],["أَرى مَربَعُ الأَحبابش قَد صارَ خاوِياً","وَفارَقَهُ فُرسانُهُ وَعَواتِكُه",62,"ك",2,0],["أرى مَشهَدي بي مِنكَ عَنكَ خَصَّني","عَلى أَنَّهُ بَينَ الأَنامِ عُمومُ",63,"م",1,1],["أَرى محنَ الزَمان مقدّمات","عَلى منح يَجود بِها الإِلَهُ",64,"ه",1,1],["أَرى ميتة الصُعلوك في دار همّه","فَقيراً كما قَد ماتَ في مُلكه كِسرى",65,"ر",2,0],["أَرى ما كُلّ مَن يدعى حَبيبا","يَكون لِمَن يَموت جَوى وَريثا",66,"ث",2,1],["أُرَى مُخبِراً عَنها كَأَنّي مُخَبَّرٌ","وَمُستَيقِظاً فيها كَأَنِّيَ نائِمُ",67,"م",1,0],["أرى منكم أموراً لن تراها","وترضاها العدا حتى كأني",68,"ن",2,0],["أرى منكَ طولَ الدَّهرِ إقبالَ قابِلٍ","ومِن بَعدِها إعراضُ ضّدٍّ مُقابِلِ",69,"ل",1,1],["أَرى مَلَكُ المَوتِ يَدنو إِلَيهِ","وَهوَ يَعَضُّ عَلى كَفِّهِ",70,"ف",2,0],["أَرى مِنكَ وَجهَ الصَدِّ لا يَتَغيَّرُ","وَوَصلُكِ هِنداً في الهَوى يَتَعَذَّرُ",71,"ر",1,1],["أَرى مَروانَ عادَ كَذي نُحولٍ","مِنَ الهِندِيِّ قَد فَقَدَ الصِقالا",72,"ل",2,0],["أرى مديحي لآل البيت فرضاً","كمفتَرَضِ الصلاة أو الصيام",73,"م",1,0],["أرى ما يطمع الراجين فيه","فأطمعُ في نجاتك بعد يأس",74,"س",1,0],["أرى مدحك العالي عليَّ فريضةً","وغيرك لم أمدحه إلاَّ تطوّعا",75,"ع",2,0],["أرى مُطْلَقَ الأَمداح من حيث أطلقت","بغيرك يا مولاي لا تتقيَّد",76,"د",1,0],["أرى ماءَ حوضٍ كنتُ صفَّقتُ شِرْبَه","أُطرَّد عنه والغِرابُ تعومُ",77,"م",1,0],["أرى مَطاراً وجناحي ناقصٌ","فكيف لي نحوَكُمُ أن أصِلا",78,"ل",2,0],["أرى من قريبٍ شملَ عزّي مبدّداً","وقد كان ظني أنه بك جامعُ",79,"ع",1,0],["أرى مقصداً تم علي","ه عين بعود به المرجَعُ",80,"ع",1,0],["أرى مُلْكَ آلِ بُوَيْه أرتدَى","عَواراً بأن راح منه سليبا",81,"ب",2,0],["أرى منك أوصافاً كِراماً ببعضها","يُنال ويُحْوى للفتى شرفُ الفخر",82,"ر",1,0],["أرى معشراً ألفوا أياديك مشرعاً","وقولهمُ كالظلِ والظلُّ زائل",83,"ل",1,0],["أرى مَماتي حَياتي في محبّتهِ","ومحنتي وشَقائي أهنَأَ النِّعَمِ",84,"م",1,0],["أرى مقاماً عظيم الشأن أوهمني","في يقظتي أنها من جملة الحلم",85,"م",1,0],["أَرى مِن لُؤَيٍّ فِرقَةً لا يَصُدُّها","عَنِ الكُفرِ تَذكيرٌ وَلا بَعثُ باعِثِ",86,"ث",1,0],["أُرى مُستَقيمَ الطَّرفِ ما الطَّرفُ أمَّكُم","وإن رَامَ طَرفِي غيرَكُم فَهوَ أحوَلُ",87,"ل",1,1],["أرى معشراً غضاباً","لأن كنتُ ذا تِلادِ",88,"د",1,0],["أَرى مَدْح مَوْلانا عَليَّ فريضةً","سأَشْدُو بها شَدْوَ الحَمامِ مهُرِّجا",89,"ج",2,0],["أَرى مَعانيكَ تَبْدُو","حُسْنا