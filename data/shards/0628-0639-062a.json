{"poems":[[55,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[79,"يا هلالا يا قضيبا يا رشا","https://www.aldiwan.net/poem35869.html","الرمل"],[44,"بان الشباب كبين الهالك المودي","https://www.aldiwan.net/poem50335.html","البسيط"],[56,"جاؤوا من الشام المشومة أهلها","https://www.aldiwan.net/poem27430.html","الكامل"],[74,"حبذا يوم وصال","https://www.aldiwan.net/poem18405.html","مجزوء الرمل"],[74,"خلع أنشرت زمان الرياض","https://www.aldiwan.net/poem19118.html","الخفيف"],[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[47,"أيري وأيرك يا كوي","https://www.aldiwan.net/poem65529.html","مجزوء الكامل"],[104,"يا سراة البلاد يكفي البلادا","https://www.aldiwan.net/poem33129.html","الخفيف"],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[47,"أَيْرى وَأَيْرُكَ يَا كُوَيْرَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=32157",""],[101,"لحمُها .. وأظَافري","https://www.poetsgate.com/ViewPoem.aspx?id=16934",""],[164,"من فتى أعطاه موليه المنى","https://www.aldiwan.net/poem58957.html","الرمل"],[164,"من قلد العلما واقدم أعذرا","https://www.aldiwan.net/poem59178.html","الكامل"],[170,"بعت عبدا كان لي سكنا","https://www.aldiwan.net/poem46846.html","المديد"],[190,"بعت الجهالة بالأصالة","https://www.aldiwan.net/poem43488.html","مجزوء الكامل"],[214,"بعتم لنا باللف ما طاب نشره","https://www.aldiwan.net/poem13537.html","الطويل"],[240,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[275,"ذهب الحب فما أشقى الفتى","https://www.aldiwan.net/poem35593.html","الرمل"],[333,"الندامى وما أحب الندامى","https://www.aldiwan.net/poem54938.html","الخفيف"],[358,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[369,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[376,"أمنون بدت لنا أم جفون","https://www.aldiwan.net/poem57059.html","الخفيف"],[408,"أظبا كناس أم أسود عرين","https://www.aldiwan.net/poem46732.html","الوافر"],[440,"أيها ذا المدعي لسنا","https://www.aldiwan.net/poem25313.html","المديد"],[463,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[473,"بعت أبا أحمد رخيصا","https://www.aldiwan.net/poem59536.html","مخلع البسيط"],[484,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[520,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[520,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[556,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[563,"يا راحم الشيب في شيبه","https://www.aldiwan.net/poem33524.html","السريع"],[569,"عن حبكم صح قلبي","https://www.aldiwan.net/poem887.html",""],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122728","الرمل"],[740,"","https://poetry.dctabudhabi.ae/diwan/poem/204047",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38693","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120005","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120086","الكامل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75730","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64992","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136317","الخفيف"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74994","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123676","الرمل"],[2170,"","https://poetry.dctabudhabi.ae/diwan/poem/198620","الكامل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199825","المسحوب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27636","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109469","الرمل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123655","الرمل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126201","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93801","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118787","المديد"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65133","الخفيف"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113896","الكامل"],[3323,"","https://poetry.dctabudhabi.ae/diwan/poem/97839","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62875","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62858","الرمل"],[3613,"","https://poetry.dctabudhabi.ae/diwan/poem/127905","المجتث"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109990","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205653","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85221","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86546","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75712","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54425","المنسرح"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73124","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136572",""],[4816,"سامحكم الله","https://www.poetsgate.com/ViewPoem.aspx?id=8491",""],[4859,"نخوة العرب!","https://www.poetsgate.com/ViewPoem.aspx?id=187261",""],[4862,"ولم تزل العبرات مخنوقه","https://www.poetsgate.com/ViewPoem.aspx?id=55632",""],[5054,"سيفُ الصدق","https://www.poetsgate.com/ViewPoem.aspx?id=215054",""],[5055,"القاعه","https://www.poetsgate.com/ViewPoem.aspx?id=103541",""],[5056,"<< حالة عشق >>","https://www.poetsgate.com/ViewPoem.aspx?id=34075",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5187,"الضمير الضائع","https://www.poetsgate.com/ViewPoem.aspx?id=29240",""],[5409,"أرسلوها في الفضا قبا مهارا","https://www.poetsgate.com/ViewPoem.aspx?id=155278",""],[5463,"ذا غرامك يا بنيّه فاق ماهم يوصفون","https://www.poetsgate.com/ViewPoem.aspx?id=33249",""],[5533,"قَتْلُ البَراءَة","https://www.poetsgate.com/ViewPoem.aspx?id=177763",""],[5553,"امك ثم امك","https://www.poetsgate.com/ViewPoem.aspx?id=185920",""],[5732,"حار قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177943",""],[5739,"أرحب يالهلاك ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155471",""],[5756,"السفينة","https://www.poetsgate.com/ViewPoem.aspx?id=5180",""],[5823,"درب الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=59186",""],[5841,"الصراحة","https://www.poetsgate.com/ViewPoem.aspx?id=34956",""],[5919,"هبّ نشرُ المعنبرِ المخزونِ","https://www.poetsgate.com/ViewPoem.aspx?id=128683",""]],"verses":[["بِعتُ الشَبابَ بِهِ عَلى مِقَةٍ لَهُ","بَيعَ العَليمِ بِأَنَّهُ لا يَربَحُ",0,"ح",1,0],["بعْتُ فيكَ النّومَ بالسُهْدِ فلا","فَرْقَ عنْدي بيْنَ صُبْحٍ وعِشا",1,"ش",2,0],["بِعتُ الشَبابَ بِشَيبٍ بَيعَةً غَبَناً","يا لَكَ بَيعاً حَراماً غَيرَ مَردودِ",2,"د",1,0],["بِعتُم لِدُنيا غَيرِكُم جَهلاً لَكُم","عِزَّ الحَياةِ وَإِنَّهُ لَنَفيسُ",3,"س",1,0],["بعت في العشاقِ روحي","يا حبيبي بِسُتَيْتَه",4,"ت",2,0],["بعتهُ الروح بالتواصل يوماً","غير إنَّا لم نفترق عن تراض",5,"ض",1,0],["بعتَه واشتريت عيشاً هنيئاً","رابح البيع كيَّساً في الشراءِ",6,"ا",2,0],["بِعتَ حُلْو الكَرى بمُرِّ سُرى الظَّل","ماءِ تختاضُها مع المخْتاض",7,"ض",1,0],["بِعتِ العَدُوَّ بِكُلِّ شِبرٍ مُهجَةً","وَكَذا يُباعُ المُلكُ حينَ يُرامُ",8,"م",1,0],["بِعتَ الغُلامَ فَمَن يَحُك","كُ غَداً حَتارَكَ إِن أَحَكَّك",9,"ك",1,0],["بعتموه إِلى العَدو فَمِن أَي","ن يُلاقون مَلجأ وَمهادا",10,"د",2,0],["بعت الحياة فنلت أربح بيعة","لكنها رجعت لنا بخسار",11,"ر",1,0],["بِعْتَ الغُلامَ فَمَنْ يَحُكُّ","غَداً حَتَارَك إِنْ أَحَكَّكْ؟",12,"ك",1,0],["بعت شعري .. بحفنة من حجار","أخبريني . هل أسعدتك الحجار",13,"ر",1,0],["بعت لهو العيش بالجد ومن","لم يبع لهوا يجد غبنا",14,"ن",2,0],["بعت الهدى واعتضت منه ضلالة","نعم المبيع وبئس ذاك المشترى",15,"ر",2,0],["بعتُ عبداً كان لي سَكَناً","وَسكنتُ النارَ من مِحَنِهْ",16,"ن",2,1],["بعت الجهالة بالأصالة","وعدلت عن طرق البطاله",17,"ل",2,1],["بعتم لنا باللف ما طاب نشره","بديعا به يحلو لشعري التغزل",18,"ل",1,1],["بِعتُهُ مُهجَتي فَيالَكَ مِن صَف","قَةِ غَبنٍ راضٍ بِها المَغبونُ",19,"ن",1,0],["بعتُ بالمجدِ غراماً بعدهُ","راحتي قد أفلتَت من راحَتي",20,"ي",1,0],["بعتموني بفرقة أنا فيها","أوحد العاشقين خمرا وجاما",21,"م",2,0],["بِعت روحي صَبابَة بِكَ فاِرفق","بِفَتىً مِن قلاك يَرجو الإِقاله",22,"ل",2,0],["بعْتُ القضاءَ على البلادِ وصِيتَهُ","بقَضائهنّ وذاك خَيرُ بُيوعي",23,"ع",2,0],["بعتُها طالَما حَيِيتُ هُجُوعي","بدمُوعي فأيُّنا المَغبُونُ",24,"ن",1,0],["بعتُ الفؤادَ بوقفَةٍ يوم النّوى","فمضَى وعدتُ بصفقَةِ المغبون",25,"ن",1,0],["بِعتَنِي وكَساً بِلاَ ثَمَنٍ","كَيفَ لَو أُعطِيتَ بِي ثَمَنَا",26,"ن",2,0],["بعتُ بك الناسَ فلم أنصرفْ","بندمٍ من غَبَنِ الناسِ لي",27,"ل",2,0],["بِعتُ أَبا أَحمَدٍ رَخيصاً","بِلا مِكاسٍ لِمُشتَريهِ",28,"ه",1,1],["بعت المصوغ مجهزا عند الضرو","رة جيش رستم ساقه مأموما",29,"م",2,0],["بعت السواد على البياض فصح لي","في العين قار والفؤاد وقار",30,"ر",1,0],["بعت الخليج لكي يقوم بعذره","وله خشوع الخاضع المتذلل",31,"ل",1,0],["بعتنِي بالرّخيص من غير أن أن","كُثَ عهداً أو أنْ يحين بِياعي",32,"ع",2,0],["بعتك نفسي فترفق بها","من يشتري العبد على عيبه",33,"ب",2,0],["بعتم فلاناً رخيصاً","بغير ذنبٍ يرام",34,"م",1,0],["بعتقه فهو لوجه الحق","مولاه من بين جميع الخلق",35,"ق",1,0],["بِعتُكُم قَلبي بِأغلَى نَظرَةٍ","لا اأقالَ اللهُ مِنّا مَن أقالا",36,"ل",2,0],["بعتَ الدفاتر وهي آ","خرُ ما يباع من المتاع",37,"ع",1,0],["بِعتُهُ لِلحَبيبِ مَع كَونِهِ لي","طَرفاه حلّ بِحبّة مِلحِ",38,"ح",1,0],["بعت الأنام ولم أك والذي","يبقيه لي في ذاك بالمغبونِ",39,"ن",1,0],["بعت الكرام به على ثقة","علما بأني غير مغبونِ",40,"ن",1,0],["بعت عمري بَني حسيناً مطيعاً","في رِضاكم أَروم منه صبابه",41,"ب",2,0],["بِعْتُكَ الرُّوحَ بَيْعةً لَزِمَتْني","فعَلاَمَ الفراقُ بالأَبدانِ",42,"ن",1,0],["بعت روحي وبعت نفسي بوصل","منك لا شك والنقايض يلزم",43,"م",1,0],["بعت الحَياة بعز الوصل فاِكتحلت","عيني وَقَلبي بنقد الوصل مَسرور",44,"ر",1,0],["بعت طعاماً بسعر البيع محتسباً","إلى أن تبتغي في حبسه لعبا",45,"ب",2,0],["بعت روحي في هواه رغبة","ذبت من شوقي عليه كمدا",46,"د",2,0],["بعت الدواوين الأصول لكي أرى","بأصول أشجار شريت ممولا",47,"ل",2,0],["بعتوا وانا للحبّ شاري","ونمشي لكم في الامر خدّام",48,"م",1,0],["بعتم الرشد بالغَواية فينا","وهو رُشد الهداةِ والأحباب",49,"ب",1,0],["بعتهُ روحي ولم أندم على","بيعها منهُ وعفتُ البدلا",50,"ل",2,0],["بعتها لا عن رضي والدمع في","صحن خديها وخدى قد طرش",51,"ش",1,0],["بِعتُ كُلّي بكُلّهم فاتَّحَدنا","بعدَ ذا صِرتُ نائباً أىَّ نائِبِ",52,"ب",1,0],["بعت خيلي بالبخس ثم حميري","برخيص قد بعتها وبغالي",53,"ل",2,0],["بعت روحي منك يا قمري","وإليك الأمر بالثمنِ",54,"ن",1,0],["بعت ما لم يبع لقوتي اضطرارا","من جمع الكسا وكور العمامه",55,"م",2,0],["بعتوها طرحت شعوبا للهوا","ن وفي الفناء بها يبيد فريق",56,"ق",1,0],["بِعِترتي وَبِأَهلي بعدَ مُفتقدي","مِنهم أُسارى وَقَتلي ضرّجوا بدمِ",57,"م",1,0],["بعتُ حظّي من كل ما يُتَمَنَّى","غير حَظّى من الصديقِ اللبيبِ",58,"ب",1,0],["بعتُ أَفراحى وَودَّعتُ الجَذَلْ","يومَ راحَتْ في الخَليطِ المُحْتَملْ",59,"ل",1,1],["بعتَ الصَّفِي برخيصٍ","ومثلهُ المتنبي",60,"ب",2,0],["بِعتُ الثمينَ بابخسِ ال","أَثمانِ يا خُسرَ المَبيعِ",61,"ع",1,0],["بعت أَيامها بخسران نفسي","وَلَقد كانَ في السَماح الثراء",62,"ا",2,0],["بعتم كرى الغافي وطيب رقاده","وبه اشتريتم يقظة اليقظان",63,"ن",1,0],["بعت التصبر فيه حين شذا","فوه العذيب ببارق الثغر",64,"ر",1,0],["بعت الكرى يا صاح من نجم الدجى","والمشتري ألقاه في الميزان",65,"ن",1,0],["بِعُتُوٍّ يَجتَثُّ أَصلاً وَفَرعاً","ويُبيدُ الأَشجارَ غُصناً وزَهرا",66,"ا",1,0],["بعته قَلباً به قد خيما","وله فيه خيار المجلس",67,"س",1,0],["بعتُ بمصرٍ دمشقَ من غَررٍ","منّي فيا غبنَ صفقةِ البائعِ",68,"ع",1,0],["بعتُه رُوحيَ بلَى ما صحَّ لي","غيرَ مُرِّ الهجرِ منها ثَمنُ",69,"ن",1,0],["بعتابٍ يَطول عند التَلاقي","ببُكائي عشيةَ التوديع",70,"ع",1,0],["بعتب على خل لفيته مسى عصير","سلمت له قلبي الوفي وما لفابه",71,"ب",2,0],["بعتِ الكرامةَ كي تبقي ولا أمل","بمن يبيع حياة المجدِ بالعطبِ",72,"ب",1,0],["بعتم ضمائركم فليس بمنصفٍ","فيكم فأي