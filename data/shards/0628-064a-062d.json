{"poems":[[95,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[45,"أبعد نأي المليحة البخل","https://www.aldiwan.net/poem10113.html","المنسرح"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43833","البسيط"],[132,"مني السلام على الولى الوالي","https://www.aldiwan.net/poem50536.html","الكامل"],[203,"بي حبيب مس عقلي","https://www.aldiwan.net/poem45216.html","مجزوء الرمل"],[203,"ما لك عند الحبيب عذر","https://www.aldiwan.net/poem45597.html","مخلع البسيط"],[208,"لي حبيب قد شفني وبراني","https://www.aldiwan.net/poem53169.html","الخفيف"],[347,"صدق الظن واستبان الخفاء","https://www.aldiwan.net/poem55383.html","الخفيف"],[353,"بي رمد جاء كلمح بالبصر","https://www.aldiwan.net/poem20234.html","الرجز"],[422,"من مجيري من فؤاد كلما","https://www.aldiwan.net/poem54048.html","الرمل"],[458,"أيار كاد يذوب عطرا سابغا","https://www.aldiwan.net/poem61325.html","الكامل"],[567,"أخاف إذا أشار براحتيه","https://www.aldiwan.net/poem52973.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38567","الكامل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216709",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100321","الخفيف"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46831","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108051","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85054","السريع"],[4816,"باقي الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=8451",""],[4869,"القهر مبدع","https://www.poetsgate.com/ViewPoem.aspx?id=151622",""],[4908,"كومة الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=207314",""],[5002,"إرحل بعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=202375",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5155,"الذكريات والطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=176154",""],[5277,"طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=205648",""],[5725,"عهد","https://www.poetsgate.com/ViewPoem.aspx?id=195050",""],[5747,"شح العطا","https://www.poetsgate.com/ViewPoem.aspx?id=61681",""],[5848,"للصمت لذة","https://www.poetsgate.com/ViewPoem.aspx?id=49001",""],[5956,"جمال جديد","https://www.poetsgate.com/ViewPoem.aspx?id=182670",""]],"verses":[["بِيَ حُرْقَةٌ أَخْفَيْتُهَا عَنْهُمْ كَمَا","يُخْفِي الرَّمَادُ ذَوَاكِي النِّيرَانِ",0,"ن",1,0],["بي حَرُّ شَوقٍ إِلى تَرَشُّفِها","يَنفَصِلُ الصَبرُ حينَ يَتَّصِلُ",1,"ل",1,0],["بي حَسَراتٌ يَضيقُ عَنها","صَدري عَلى أَنَّهُ رَحيبُ",2,"ب",1,0],["بي حرّ شوق في الحشا مُتَوَقِّد","أَلاّ ينْطَفِي إلاّ ببَرْدِ وِصَالِ",3,"ل",1,0],["بي حبيبٌ مسَّ عقلي","فأصابَ العقلَ مسُّ",4,"س",1,1],["بي حسراتٌ عليكَ ما إن","يقوى على مسهنَّ صدرُ",5,"ر",1,0],["بي حذارٌ إذا أردتُ أُسميِّ","ه كأني أفطرتُ في رمضان",6,"ن",1,0],["بي حنين لعود تلك الليالي","يا أخي انها ليال وضاء",7,"ا",2,0],["بي حِدَّةٌ في العَيْنِ لَيْسَتْ في الأَثَرْ","فاعْتَبِروا فإنَّما الدُّنيا عِبَرْ",8,"ر",1,0],["بي حبيبٌ أنا ألقى في الهوى","منه ما ألقاه من كيد العِدى",9,"د",2,0],["بي حرقة الفنان مثلك قابعا","في خلوتي وتوثب الفنان",10,"ن",1,0],["بيَحيَى تَلهَجُ الفُضَلاءُ طُرّاً","كما لَهِجَ النُحاةُ بِسيبَويْهِ",11,"ي",2,0],["بِيَحيى بِذي المِحرابِ وَالِده كذا","بِيونسَ مَنْ أَنجيت مَن غرقٍ مُردي",12,"د",2,0],["بي حاجِباهُ كَذاكَ أَسودّ خالهُ","إِذ قامَ بَينَهُما بِرأيِ العينِ",13,"ن",1,1],["بي حلوين الوصايف","بي مزيونٍ اصيل",14,"ل",1,0],["بي حبيباً لم يرض الا بسخطي","ليته اسخط المحبَّ وارضى",15,"ض",2,0],["بِيَحْيَى المُرْتَضَى أحيا ال","إِلَهُ الخَلْقَ إِذْ هَمَدوا",16,"د",3,0],["بي حياءٌ نظيركم غير أني","بي غرامٌ علا حيا الوجنات",17,"ت",1,0],["بي حسن شعره مرسل","فيه فساد الحب عين الصلاح",18,"ح",1,0],["بي حب من تاجف وراه المزايين","لا شاف حسنه صايب الفكر يشرد",19,"د",1,0],["بيّحت سري وانت بعيوني البير","وسارت بك الخطوه لهمي عجوله",20,"ل",2,0],["بِي حُزِنُ يَعْقُوب لمَّا قَالَ قائلهم:","عُذْرًا أبانا... أَخُونَا تَاهَ فِي السبَقِ",21,"ق",1,0],["بي حلَّقتْ فلقد رجوتُ سحائبا","والغيث بالسلوان شد جذوري",22,"ر",2,0],["بيحيى بعيسى بالنبيين كلهم","بسرهم الأسنا بنورهم الأنمى",23,"م",2,0],["بي حنين إلى ربيع الطفولة","والعشيات بالندى مطلولة",24,"ل",2,1],["بي حشرجاتٌ قبلَ موتيَ أجّجتْ","وجدي..وزادي للمَعادِ قليلُ",25,"ل",1,0],["بي حسرة يا اله الكون عل غدا","ترتاح صنعاء اذ تحنو لها عدن",26,"ن",1,0],["بيحت لك من خافق الشوق مكنون","وش عاد باقي مااتضح من كلامي",27,"م",2,0],["بي حزن شاعر وابتسامات مجروح","ولي دمعتينٍ لا سهيت ذرفوني",28,"ن",2,0],["بي حقنتَ الخصبَ فاهنأ","انتهى عهدُ الدمارْ",29,"ر",1,0]]}