{"poems":[[79,"يمينا بيانع ورد الخدود","https://www.aldiwan.net/poem36617.html","المتقارب"],[95,"ليلى اجمعي الناس إلى محفل","https://www.aldiwan.net/poem11104.html","السريع"],[23,"بنو وائل وبنو واقف","https://www.aldiwan.net/poem21542.html","المتقارب"],[87,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[87,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[63,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[68,"ونصرانية بتنا جوارا","https://www.aldiwan.net/poem39662.html","الوافر"],[33,"ألا إني عشية دار زيد","https://www.aldiwan.net/poem41856.html","الوافر"],[33,"بعثت وليدتي سحرا","https://www.aldiwan.net/poem42479.html","مجزوء الوافر"],[33,"ألا هل هاجك الأظعان إذ","https://www.aldiwan.net/poem42591.html","مجزوء الوافر"],[76,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[76,"ياهزة الغصن الوريق","https://www.aldiwan.net/poem13198.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[108,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[111,"الله أكبر فاز المجد واغتبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66838&r=&rc=17",""],[33,"تَصَابَى القَلْبُ وَکدّكَرَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18896&r=&rc=159",""],[132,"يا زروة قد أورثت","https://www.aldiwan.net/poem50516.html","مخلع الكامل"],[203,"أأخشاه جفنا ما تسل قواضبه","https://www.aldiwan.net/poem45563.html","الطويل"],[246,"يا صاحب القصر الذي شاده","https://www.aldiwan.net/poem45754.html","السريع"],[276,"هب النسيم فما ست منه أشجار","https://www.aldiwan.net/poem52074.html","البسيط"],[305,"إذا قال سيف الله كروا عليهم","https://www.aldiwan.net/poem45457.html","الطويل"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[369,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[369,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[369,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[466,"ملك الشكر نوال","https://www.aldiwan.net/poem16095.html","مجزوء الرمل"],[466,"له بالمجد أنس مطمئن","https://www.aldiwan.net/poem16135.html","الوافر"],[469,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[498,"كأنما ادخر الرحمن معظمة","https://www.aldiwan.net/poem67336.html","البسيط"],[543,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130199","البسيط"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104484","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96656","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64834","الكامل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102301","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49983","الطويل"],[1544,"","https://poetry.dctabudhabi.ae/diwan/poem/111124","الوافر"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17654","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87832","الوافر"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45493","البسيط"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110659","الطويل"],[2693,"","https://poetry.dctabudhabi.ae/diwan/poem/100550","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48423","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92052","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132156","الوافر"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35533","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125852","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86425","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45038","الطويل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147294","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72849","المتقارب"],[4852,"فارش الأميال","https://www.poetsgate.com/ViewPoem.aspx?id=214335",""],[585,"هي لفتةٌ أوحت إلي الموعدا","https://www.poetsgate.com/ViewPoem.aspx?id=161932",""],[5324,"فنجان قهوتها.","https://www.poetsgate.com/ViewPoem.aspx?id=211948",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5582,"هَلْ لِلنَّوَى ذلِكَ الظَّبْيُ الأَغَنُّ سَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5776,"(أُتْسُوعةُ الهلاك )","https://www.poetsgate.com/ViewPoem.aspx?id=205841",""],[402,"ليلى أجمعي الناس إلى محفل","https://www.poetsgate.com/ViewPoem.aspx?id=36825",""],[5790,"ليل الوصال كليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=112054",""],[5937,"متحف الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=211894",""],[161,"وَجهُ المرآة","https://www.poetsgate.com/ViewPoem.aspx?id=204621",""],[4442,"لك من أبيك تحية وسلام","https://www.poetsgate.com/ViewPoem.aspx?id=171200",""],[3216,"أواه.. يا كسلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67793&r=&rc=2",""]],"verses":[["فهَزّ بكَ الدّينُ أعْطافَهُ","كَما اهْتزّ غُصْنُ الرِّياضِ المَجودْ",0,"د",1,0],["فَهزَّتِ الرَّأْفَةُ أَوْتَارَهَا","فِي نَفْسِكِ المِرْنَانَةِ الصَّافِيَهْ",1,"ي",2,0],["فَهَزَّت فَتىً ماجِداً عِرقُهُ","كَريمَ المَداخِلِ وَالمَخرَجِ",2,"ج",1,0],["فهززت نشئاً لا يحرك للعلا","إلا بذكر وقائع الأنجاد",3,"د",1,0],["فَهُزّوا العَرشَ بِالدَعَواتِ حَتّى","يُخَفِّفَ عَن كِنانَتِهِ العَذابا",4,"ب",2,0],["فهزَّتْ عِطْفَها طَرَباً إليه","وأَلقَتْ عن مَحاسِنها الخِمارا",5,"ر",2,0],["فَهَزَّت عِطفَها مَرَحاً وَقالَت","قَضى نَحباً فَأَحياهُ المَسيحُ",6,"ح",1,0],["فَهَزَّت رَأسَها عَجَباً وَقالَت","عَذَرتُكَ لَو تَرى مِنهُم غُفولا",7,"ل",2,0],["فَهَزَّت رَأسَها عَجَباً","وَقالَت مَن بِذا أَمَرَك",8,"ك",1,0],["فَهَزَّت رَأسَها عَجَباً","وَقالَت مازِحٌ مَزَحا",9,"ح",2,0],["فَهَزَّت إِلَيهِ عِطفَها كُلَّ رايَةٍ","تَهُزُّ عَلَيهِ الغُصنَ في الوَرَقِ النَضرِ",10,"ر",1,0],["فَهَزَزتُ مِن عِطفٍ نَدٍ","وَسَفَرتَ عَن وَجهٍ طَليقِ",11,"ق",1,0],["فهزُّوه صوارمَ مشرعاتٍ","تشقُّ بكلِّ مُعْتركٍ زحامهْ",12,"م",2,0],["فهززنا، لما هززناكَ، دنيا من","جمالٍ وجنَّةٍ من مَراحم",13,"م",1,0],["فهزَّ اعتلاجُ الْحُزنِ أَضلاعَ صَدْرِهِ","وأخْفَى نَشيجاً تحتَ طيِّ نحِيب",14,"ب",1,0],["فهز الغرب هزَّ الفلْ","ك بين الجزر والمد",15,"د",1,0],["فهزت الأرض بشراها وهيبته","كأن بالأرض ما بالسيف مخترطا",16,"ط",2,0],["فَهَزَّتْ رَأْسَهَا عَجَبَاً","وَقَالَتْ: مَنْ بِذَا أَمَرَا؟",17,"ر",2,0],["فهزمت جَيشَ الكفر والإش","راك بالجيش اللُّهامِ",18,"م",1,0],["فهزتْ قواماً كالرديني مشرعاً","وحينَ أحسُّ الشعرَ ماجتْ كتائبهْ",19,"ب",2,0],["فهزلُه أَنفذُ مِن جَدِّه","ورَهوُه أَسرَعُ مِن وَخده",20,"د",2,0],["فهزني الشوق لا دَمعي يكف وَلا","قَلبي اذا رمت منه الصبر صبار",21,"ر",1,0],["فَهَزَّ رُدَينِيّاً كَأَنَّ كُعوبَهُ","نَوى القَسبِ نَفّى التَمرَ عِندَ العَواجِمِ",22,"م",1,0],["فهَزَّهُ عِطفه فَنَنٌ رَطيبٌ","وجودُ بنانِه ثَمَرٌ جَنيّ",23,"ي",1,0],["فهُزَّ لها قِوامَ الدّينِ هَزّاً","يُنالُ بِمثْلِهِ الثّأْرُ المُنيم",24,"م",1,0],["فهزّ أعطافَها حدْوٌ يُطرِّبُها","هزَّ الغِناء لعِطْفِ الشّاربِ الثَّمِل",25,"ل",1,0],["فَهُزَّ لي عِطْفَ مولانا الوزيرِ وقُلْ","عنّي ومهما أقُلْ من قَولٍ اشْتَهَرا",26,"ر",2,0],["فهزّني نحوَك قلبٌ لم يزلْ","بالأكرمين كَلِفاً موَكَّلا",27,"ل",2,0],["فَهزيمانِ لهُ الَّلأوُ","اء والموْتُ الزُّؤامُ",28,"م",1,0],["فهَزَّامٌ إذا اشْتَجَرَ العَوالي","ومَهْزومٌ إذا ما عَنَّ عارُ",29,"ر",1,0],["فهزَّة شوقٍ خفيٍ إليك","وقد يكمن الشوق في ضمن حزن",30,"ن",1,0],["فَهَزَّهُ وَظبا الأَسيافِ مغمدَةٌ","وَاِستَلَّهُ غَيرَ مَنسوبٍ إِلى الفَلَلِ",31,"ل",1,0],["فهزَّني كصَديقٍ لي يُداعِبُني","وقالَ تِلكَ جُيوشُ المطعم البلدي",32,"د",2,0],["فهزهزت سيل احزاني سعود فتى","بسيل رهط دنا للفتك واقتربا",33,"ب",2,0],["فهزتني الأشواق للموت رغبة","لعلي إذا ما مت أحظى برؤياها",34,"ا",3,0],["فَهزّه عجبهُ مِن حيث ما اِجتَمعوا","عشرينَ ألفاً وَقالوا النصر قَد حَضرا",35,"ر",2,0],["فَهَزَزْتُ صارمَها لأَجْنيَ نَفْعَهُ","والرِّسلُ يَظْهرُ زُبْدُهُ مِنْ مَخْضِهِ",36,"ض",2,0],["فهزارها شحرورها ورشانها","سمائها دراجها والبلبل",37,"ل",1,0],["فهزّت على دِعصِ النّقا غصنَ بانة","وحلتّت نقابَ القز عن قمرٍ بدرِ",38,"ر",1,0],["فهزته النوى فرأته طوداً","وزاحمه الهوى فرآه صخرا",39,"ر",2,0],["فَهَزَّت إِلَيَّ الرَأسَ مِنّي تَعَجُّباً","وَعُضِّضَ مِما قَد فَعَلتُ الأَصابِعُ",40,"ع",1,0],["فَهَزَّت رَأسَها هَزّاً وَقالَت","أَراكَ مُفَتِّشاً بَينَ الحِسانِ",41,"ن",1,0],["فَهزَّ روقي رِماليٍّ كَأَنَّهُما","عودا مَداوِس يَأصول وَيَأصولُ",42,"ل",1,0],["فهز به أهل الولاء لحيدر","فهذا الهنا أهل الولاء به أحرى",43,"ر",2,0],["فهزموا الجند نصراً من إلههم","والسوء عنهم بعون اللَه قد صرفا",44,"ف",2,0],["فهزّ مثنَى جناحَيْهِ وحثّهُما","حثّ المُسابِقِ للأقْصى من الأمَدِ",45,"د",1,0],["فهزلٌ دلّخ الآمال حَتّى","سَقَطن بما احتملن عَلى الرسوم",46,"م",1,0],["فهزتني مكارمكم ففاضت","عليّ الشاعرية وهي مدُ",47,"د",1,0],["فَهَزّت دُوَين البيض بيضٌ وَأَشرَعَت","إِلى الطَّعنِ دُونَ السُّمرِ خَطيَّةٌ سُمرُ",48,"ر",1,0],["فهزت أخيل لرؤته","عواطف رفقٍ وفرط أسى",49,"س",2,0],["فهز القنا ومد المجنا","وصاح ابن فيلا هنا أقبلنا",50,"ن",2,0],["فهزت أبا الأرباب والناس رأفه","ولاحت لهيرا منه بالغيظ نظره",51,"ه",1,0],["فَهَزتَنِيَ البُشرى اِرتِياحاً وَبَهجَة","كَما اِهتَزَّ مِن ريحِ الصِبا الأَغصُنُ المَلد",52,"د",1,0],["فهز الناسُ أَرؤسَهُمْ","فقلت لهم هو الدُّلَر",53,"ر",1,0],["فهزني الشوق إلى خرعوبة","ألوى بها إلى النوى كاشحها",54,"ح",3,0],["فَهَزَّت لَهُ أَعطافَها وَتَزَيَنَّت","وَعَمَّ الهَنا في قُطرِها عِندَما أَثرى",55,"ر",2,0],["فهزج ورجز ظلال تغني","ووافر حبي نسيم عليل",56,"ل",1,0],["فهّز الثناء بأنفاسه","قضيبٌ جنى انسه المائسا",57,"س",2,0],["فهزتْ ..مَريمي أغصانَ قلبٍ","تُساقِطُ فوقها نبضا شهيَّا",58,"ي",2,0],["فهززت من عِطفي أعجب بالذي","أثنت عليّ وطاب لي أن أحمدا",59,"د",2,0],["فهزت رأسها نشوى","وقالت إسقني الثاني",60,"ن",2,0],["فهز جامعك المشهور بيرقه","مرحباً بلسان الفاتح البطل",61,"ل",1,0],["فَهَزَّهُ عُجْبُهُ مِنْ حَيْثُ ما اجْتَمَعُوا","عِشْرِينَ أَلْفاً وَقالَ النَّصْرُ قَدْ حَضَرَا",62,"ر",2,0],["فهزَّ وراعَ الدُّجى","وأخشى بأنْ يفتئتْ",63,"ت",1,0],["فهزت الرأفة أتارها","في نفسك المرنانة الصافيه",64,"ي",2,0],["فهززت غصنا من معاطفه","ورشفت جريالا من الثغر",65,"ر",1,0],["فهُزّي نخل قلبي تبصريني","على الطرقات منثورًا ، مُهَندَمْ",66,"م",1,0],["فهَزَّ الرَّأْسَ إِعْجَابًا","وَ إِصْرَارًا تَقَفَّاهُ",67,"ا",2,0],["فهززت للجلي القناة ولم يخن","قصباتها غمز ولا إعجام",68,"م",1,0],["فهزنى المى وأشتد بى سقمى وأشتقت يا حلمى للأرض والطين","للفجر يطلع من توتيل مبتسماً وللأصيل اذا حياك يحيينى",69,"ن",2,0]]}