{"poems":[[79,"يمينا بيانع ورد الخدود","https://www.aldiwan.net/poem36617.html","المتقارب"],[95,"ليلى اجمعي الناس إلى محفل","https://www.aldiwan.net/poem11104.html","السريع"],[23,"بنو وائل وبنو واقف","https://www.aldiwan.net/poem21542.html","المتقارب"],[87,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[87,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[63,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[68,"ونصرانية بتنا جوارا","https://www.aldiwan.net/poem39662.html","الوافر"],[33,"ألا إني عشية دار زيد","https://www.aldiwan.net/poem41856.html","الوافر"],[33,"بعثت وليدتي سحرا","https://www.aldiwan.net/poem42479.html","مجزوء الوافر"],[33,"ألا هل هاجك الأظعان إذ","https://www.aldiwan.net/poem42591.html","مجزوء الوافر"],[76,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[76,"ياهزة الغصن الوريق","https://www.aldiwan.net/poem13198.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[108,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[111,"الله أكبر فاز المجد واغتبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66838&r=&rc=17",""],[33,"تَصَابَى القَلْبُ وَکدّكَرَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18896&r=&rc=159",""],[132,"يا زروة قد أورثت","https://www.aldiwan.net/poem50516.html","مخلع الكامل"],[203,"أأخشاه جفنا ما تسل قواضبه","https://www.aldiwan.net/poem45563.html","الطويل"],[245,"يا صاحب القصر الذي شاده","https://www.aldiwan.net/poem45754.html","السريع"],[275,"هب النسيم فما ست منه أشجار","https://www.aldiwan.net/poem52074.html","البسيط"],[304,"إذا قال سيف الله كروا عليهم","https://www.aldiwan.net/poem45457.html","الطويل"],[368,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[368,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[368,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[368,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[461,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[464,"ملك الشكر نوال","https://www.aldiwan.net/poem16095.html","مجزوء الرمل"],[464,"له بالمجد أنس مطمئن","https://www.aldiwan.net/poem16135.html","الوافر"],[467,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[496,"كأنما ادخر الرحمن معظمة","https://www.aldiwan.net/poem67336.html","البسيط"],[541,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/17654","الطويل"]],"verses":[["فهَزّ بكَ الدّينُ أعْطافَهُ","كَما اهْتزّ غُصْنُ الرِّياضِ المَجودْ",0,"د",1,0],["فَهزَّتِ الرَّأْفَةُ أَوْتَارَهَا","فِي نَفْسِكِ المِرْنَانَةِ الصَّافِيَهْ",1,"ي",2,0],["فَهَزَّت فَتىً ماجِداً عِرقُهُ","كَريمَ المَداخِلِ وَالمَخرَجِ",2,"ج",1,0],["فهززت نشئاً لا يحرك للعلا","إلا بذكر وقائع الأنجاد",3,"د",1,0],["فَهُزّوا العَرشَ بِالدَعَواتِ حَتّى","يُخَفِّفَ عَن كِنانَتِهِ العَذابا",4,"ب",2,0],["فهزَّتْ عِطْفَها طَرَباً إليه","وأَلقَتْ عن مَحاسِنها الخِمارا",5,"ر",2,0],["فَهَزَّت عِطفَها مَرَحاً وَقالَت","قَضى نَحباً فَأَحياهُ المَسيحُ",6,"ح",1,0],["فَهَزَّت رَأسَها عَجَباً وَقالَت","عَذَرتُكَ لَو تَرى مِنهُم غُفولا",7,"ل",2,0],["فَهَزَّت رَأسَها عَجَباً","وَقالَت مَن بِذا أَمَرَك",8,"ك",1,0],["فَهَزَّت رَأسَها عَجَباً","وَقالَت مازِحٌ مَزَحا",9,"ح",2,0],["فَهَزَّت إِلَيهِ عِطفَها كُلَّ رايَةٍ","تَهُزُّ عَلَيهِ الغُصنَ في الوَرَقِ النَضرِ",10,"ر",1,0],["فَهَزَزتُ مِن عِطفٍ نَدٍ","وَسَفَرتَ عَن وَجهٍ طَليقِ",11,"ق",1,0],["فهزُّوه صوارمَ مشرعاتٍ","تشقُّ بكلِّ مُعْتركٍ زحامهْ",12,"م",2,0],["فهززنا، لما هززناكَ، دنيا من","جمالٍ وجنَّةٍ من مَراحم",13,"م",1,0],["فهزَّ اعتلاجُ الْحُزنِ أَضلاعَ صَدْرِهِ","وأخْفَى نَشيجاً تحتَ طيِّ نحِيب",14,"ب",1,0],["فهز الغرب هزَّ الفلْ","ك بين الجزر والمد",15,"د",1,0],["فهزت الأرض بشراها وهيبته","كأن بالأرض ما بالسيف مخترطا",16,"ط",2,0],["فَهَزَّتْ رَأْسَهَا عَجَبَاً","وَقَالَتْ: مَنْ بِذَا أَمَرَا؟",17,"ر",2,0],["فهزمت جَيشَ الكفر والإش","راك بالجيش اللُّهامِ",18,"م",1,0],["فهزتْ قواماً كالرديني مشرعاً","وحينَ أحسُّ الشعرَ ماجتْ كتائبهْ",19,"ب",2,0],["فهزلُه أَنفذُ مِن جَدِّه","ورَهوُه أَسرَعُ مِن وَخده",20,"د",2,0],["فهزني الشوق لا دَمعي يكف وَلا","قَلبي اذا رمت منه الصبر صبار",21,"ر",1,0],["فَهَزَّ رُدَينِيّاً كَأَنَّ كُعوبَهُ","نَوى القَسبِ نَفّى التَمرَ عِندَ العَواجِمِ",22,"م",1,0],["فهَزَّهُ عِطفه فَنَنٌ رَطيبٌ","وجودُ بنانِه ثَمَرٌ جَنيّ",23,"ي",1,0],["فهُزَّ لها قِوامَ الدّينِ هَزّاً","يُنالُ بِمثْلِهِ الثّأْرُ المُنيم",24,"م",1,0],["فهزّ أعطافَها حدْوٌ يُطرِّبُها","هزَّ الغِناء لعِطْفِ الشّاربِ الثَّمِل",25,"ل",1,0],["فَهُزَّ لي عِطْفَ مولانا الوزيرِ وقُلْ","عنّي ومهما أقُلْ من قَولٍ اشْتَهَرا",26,"ر",2,0],["فهزّني نحوَك قلبٌ لم يزلْ","بالأكرمين كَلِفاً موَكَّلا",27,"ل",2,0],["فَهزيمانِ لهُ الَّلأوُ","اء والموْتُ الزُّؤامُ",28,"م",1,0],["فهَزَّامٌ إذا اشْتَجَرَ العَوالي","ومَهْزومٌ إذا ما عَنَّ عارُ",29,"ر",1,0],["فهزَّة شوقٍ خفيٍ إليك","وقد يكمن الشوق في ضمن حزن",30,"ن",1,0],["فَهَزَّهُ وَظبا الأَسيافِ مغمدَةٌ","وَاِستَلَّهُ غَيرَ مَنسوبٍ إِلى الفَلَلِ",31,"ل",1,0],["فهزَّني كصَديقٍ لي يُداعِبُني","وقالَ تِلكَ جُيوشُ المطعم البلدي",32,"د",2,0],["فَهَزَّت إِلَيَّ الرَأسَ مِنّي تَعَجُّباً","وَعُضِّضَ مِما قَد فَعَلتُ الأَصابِعُ",33,"ع",1,0]]}