{"poems":[[77,"يمينا بيانع ورد الخدود","https://www.aldiwan.net/poem36617.html","المتقارب"],[93,"ليلى اجمعي الناس إلى محفل","https://www.aldiwan.net/poem11104.html","السريع"],[23,"بنو وائل وبنو واقف","https://www.aldiwan.net/poem21542.html","المتقارب"],[85,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[61,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[66,"ونصرانية بتنا جوارا","https://www.aldiwan.net/poem39662.html","الوافر"],[31,"ألا إني عشية دار زيد","https://www.aldiwan.net/poem41856.html","الوافر"],[31,"بعثت وليدتي سحرا","https://www.aldiwan.net/poem42479.html","مجزوء الوافر"],[31,"ألا هل هاجك الأظعان إذ","https://www.aldiwan.net/poem42591.html","مجزوء الوافر"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[74,"ياهزة الغصن الوريق","https://www.aldiwan.net/poem13198.html","مجزوء الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[106,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[31,"تَصَابَى القَلْبُ وَکدّكَرَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18896&r=&rc=159",""],[128,"يا زروة قد أورثت","https://www.aldiwan.net/poem50516.html","مخلع الكامل"],[199,"أأخشاه جفنا ما تسل قواضبه","https://www.aldiwan.net/poem45563.html","الطويل"],[241,"يا صاحب القصر الذي شاده","https://www.aldiwan.net/poem45754.html","السريع"],[271,"هب النسيم فما ست منه أشجار","https://www.aldiwan.net/poem52074.html","البسيط"],[300,"إذا قال سيف الله كروا عليهم","https://www.aldiwan.net/poem45457.html","الطويل"],[364,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[364,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[364,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[364,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[458,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[461,"ملك الشكر نوال","https://www.aldiwan.net/poem16095.html","مجزوء الرمل"],[461,"له بالمجد أنس مطمئن","https://www.aldiwan.net/poem16135.html","الوافر"],[464,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[493,"كأنما ادخر الرحمن معظمة","https://www.aldiwan.net/poem67336.html","البسيط"],[538,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"]],"verses":[["فهَزّ بكَ الدّينُ أعْطافَهُ","كَما اهْتزّ غُصْنُ الرِّياضِ المَجودْ",0,"د",1,0],["فَهزَّتِ الرَّأْفَةُ أَوْتَارَهَا","فِي نَفْسِكِ المِرْنَانَةِ الصَّافِيَهْ",1,"ي",2,0],["فَهَزَّت فَتىً ماجِداً عِرقُهُ","كَريمَ المَداخِلِ وَالمَخرَجِ",2,"ج",1,0],["فهززت نشئاً لا يحرك للعلا","إلا بذكر وقائع الأنجاد",3,"د",1,0],["فَهُزّوا العَرشَ بِالدَعَواتِ حَتّى","يُخَفِّفَ عَن كِنانَتِهِ العَذابا",4,"ب",2,0],["فهزَّتْ عِطْفَها طَرَباً إليه","وأَلقَتْ عن مَحاسِنها الخِمارا",5,"ر",2,0],["فَهَزَّت عِطفَها مَرَحاً وَقالَت","قَضى نَحباً فَأَحياهُ المَسيحُ",6,"ح",1,0],["فَهَزَّت رَأسَها عَجَباً وَقالَت","عَذَرتُكَ لَو تَرى مِنهُم غُفولا",7,"ل",2,0],["فَهَزَّت رَأسَها عَجَباً","وَقالَت مَن بِذا أَمَرَك",8,"ك",1,0],["فَهَزَّت رَأسَها عَجَباً","وَقالَت مازِحٌ مَزَحا",9,"ح",2,0],["فَهَزَّت إِلَيهِ عِطفَها كُلَّ رايَةٍ","تَهُزُّ عَلَيهِ الغُصنَ في الوَرَقِ النَضرِ",10,"ر",1,0],["فَهَزَزتُ مِن عِطفٍ نَدٍ","وَسَفَرتَ عَن وَجهٍ طَليقِ",11,"ق",1,0],["فهزُّوه صوارمَ مشرعاتٍ","تشقُّ بكلِّ مُعْتركٍ زحامهْ",12,"م",2,0],["فهززنا، لما هززناكَ، دنيا من","جمالٍ وجنَّةٍ من مَراحم",13,"م",1,0],["فهزَّ اعتلاجُ الْحُزنِ أَضلاعَ صَدْرِهِ","وأخْفَى نَشيجاً تحتَ طيِّ نحِيب",14,"ب",1,0],["فهز الغرب هزَّ الفلْ","ك بين الجزر والمد",15,"د",1,0],["فَهَزَّتْ رَأْسَهَا عَجَبَاً","وَقَالَتْ: مَنْ بِذَا أَمَرَا؟",16,"ر",2,0],["فهزمت جَيشَ الكفر والإش","راك بالجيش اللُّهامِ",17,"م",1,0],["فهزتْ قواماً كالرديني مشرعاً","وحينَ أحسُّ الشعرَ ماجتْ كتائبهْ",18,"ب",2,0],["فهزلُه أَنفذُ مِن جَدِّه","ورَهوُه أَسرَعُ مِن وَخده",19,"د",2,0],["فهزني الشوق لا دَمعي يكف وَلا","قَلبي اذا رمت منه الصبر صبار",20,"ر",1,0],["فَهَزَّ رُدَينِيّاً كَأَنَّ كُعوبَهُ","نَوى القَسبِ نَفّى التَمرَ عِندَ العَواجِمِ",21,"م",1,0],["فهَزَّهُ عِطفه فَنَنٌ رَطيبٌ","وجودُ بنانِه ثَمَرٌ جَنيّ",22,"ي",1,0],["فهُزَّ لها قِوامَ الدّينِ هَزّاً","يُنالُ بِمثْلِهِ الثّأْرُ المُنيم",23,"م",1,0],["فهزّ أعطافَها حدْوٌ يُطرِّبُها","هزَّ الغِناء لعِطْفِ الشّاربِ الثَّمِل",24,"ل",1,0],["فَهُزَّ لي عِطْفَ مولانا الوزيرِ وقُلْ","عنّي ومهما أقُلْ من قَولٍ اشْتَهَرا",25,"ر",2,0],["فهزّني نحوَك قلبٌ لم يزلْ","بالأكرمين كَلِفاً موَكَّلا",26,"ل",2,0],["فَهزيمانِ لهُ الَّلأوُ","اء والموْتُ الزُّؤامُ",27,"م",1,0],["فهَزَّامٌ إذا اشْتَجَرَ العَوالي","ومَهْزومٌ إذا ما عَنَّ عارُ",28,"ر",1,0],["فهزَّة شوقٍ خفيٍ إليك","وقد يكمن الشوق في ضمن حزن",29,"ن",1,0],["فَهَزَّهُ وَظبا الأَسيافِ مغمدَةٌ","وَاِستَلَّهُ غَيرَ مَنسوبٍ إِلى الفَلَلِ",30,"ل",1,0],["فهزَّني كصَديقٍ لي يُداعِبُني","وقالَ تِلكَ جُيوشُ المطعم البلدي",31,"د",2,0]]}