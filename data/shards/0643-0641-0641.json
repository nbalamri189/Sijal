{"poems":[[79,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[37,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[63,"وقائع مثل ما بدأت تعود","https://www.aldiwan.net/poem51729.html","الوافر"],[68,"أنظر إلى المجد كيف ينهدم","https://www.aldiwan.net/poem40298.html","المنسرح"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43885","الطويل"],[147,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[203,"كففت يدي عن الشر","https://www.aldiwan.net/poem45391.html","مجزوء الوافر"],[240,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[308,"كففت عن الأنام فمى وكفى","https://www.aldiwan.net/poem58268.html","الوافر"],[422,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[422,"بلغت بحمد الله ما أنا طالب","https://www.aldiwan.net/poem54188.html","الطويل"],[463,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[482,"همت غراما بالبروق اللمع","https://www.aldiwan.net/poem15223.html","الرجز"],[548,"أقيدوا القوم إن الظلم لايرضاه ديان","https://www.aldiwan.net/poem1761.html","الهزج"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100154","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64968","الطويل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102225","السريع"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35811","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132259","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53164","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53156","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48295","الطويل"],[548,"","https://poetry.dctabudhabi.ae/diwan/poem/20375","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129503","الوافر"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77733","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114483","الطويل"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96078","السريع"],[5121,"الكَأْسُ","https://www.poetsgate.com/ViewPoem.aspx?id=215480",""],[5873,"تباريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215466",""],[147,"بكَ اقتضى الدينُ ديناً كانَ قدْ وجبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27445&r=&rc=12",""]],"verses":[["كفَفْنا بكَ الأيّامَ عنْ غُلَوائِها","وقدْ رابَنا منْها التعسّفُ والكِبْرُ",0,"ر",1,0],["كَفَفتُ يَداً عَنها وَأَرضَيتُ سَمعَها","مِنَ القَولِ حَتّى صَدَّقَت ما وَعى لَها",1,"ل",3,0],["كفَفْتَ شَذاتَها فارتدَّ بأسٌ","كدُفَّاعِ الحريقِ وفاضَ جودُ",2,"د",1,0],["كَفَفتَ عَنَّ كَفَّ الخُطوبِ فَمِن","بَعدِكَ أَمسى الزَمانُ يَنتَقِمُ",3,"م",1,0],["كففت أكفَّ الظِّلمِ عن كلِّ مسلمٍ","عَرَضْنَ لمالٍ منه أو دَمٍ أوْ عِرْضِ",4,"ض",1,0],["كَفَفتَ عَنهُم وَلَو شِئتَ اِجتِياحَهُمُ","لَم تَتَّرِك مِنهُمُ رَأساً وَلاذَنَبا",5,"ب",2,0],["كففتُ يدي عن الشرِّ","وأصغيتُ لهُ أذني",6,"ن",2,1],["كَفَفتُ أَطماعِ عَنِ الناسِ فَما","كَفُّهُمُ نَوالَهُم بِضائِري",7,"ر",2,0],["كففت عن الأنام فمى وكفى","كأني بت في خرس ورعشه",8,"ه",1,1],["كففت أيديهم عن ما تمد له","فما استفادوا سوى الخذلان في الغلب",9,"ب",1,0],["كففتَ يدَ الأشرار من كلِّ وجهةٍ","فلا ثمَّ منهوبٍ ولا ثمَّ ناهبُ",10,"ب",1,0],["كفَفتَها تَرهبُ العطاءَ فما","أحسنَها لو تُكفُّ من شلَلِ",11,"ل",1,0],["كففتُ بعدَ جيرتي وبعدَهم","عنهمْ وعن لذَّةِ عيشي مطمعي",12,"ع",2,0],["كففنا عن بني هندٍ","وقُلنا القَومُ اخوانُ",13,"ن",1,0],["كففت وأكف دمعي في الطلول ولي","كف يسائل أين الركب قد بانا",14,"ن",2,0],["كَفَفْتُ يَدي عن وَصْلِهِ ولطالما","عَمَدْتُ ومالي بالصُّدودِ يَدانِ",15,"ن",1,0],["كففتُ عن قومي الأَذى إذ هُمو","يُؤذونني طُرّاً أشدَّ الأَذى",16,"ذ",2,1],["كَفَفتُ عَنِ المقاتِلِ بادِياتٍ","وَقَد هَيَّأت صَخرَةَ مَنجَنونِ",17,"ن",1,0],["كففت انسجام الدمع فانهلّ وانتثر","وعاد عقيقا بعدما كان كالدرر",18,"ر",1,1],["كففت كفّ الشر بالبأس وقد","قام لنصر الشرك كل مائل",19,"ل",1,0],["كففت خيل اللهو عن سباق","لما كُفِيتَ حَلْبَةَ الفراق",20,"ق",1,1],["كَفَّفرتُمُ مَن جَرَّدَ التَّوحِيدَ جَه","لاً مِنكُم بِحَقَائِقِ الإِيمَانِ",21,"ن",1,0],["كففتَهُ عن قلبِ أصحابك فى","ما نظَرُوا إليك لا لصارِفِ",22,"ف",1,0],["كفَفْتُ بك الأيامَ عن أن تُضيمَني","فجاهُكَ في كفّي حُسامٌ مُشهَّرُ",23,"ر",1,0],["كَفَفنا عَن بَني ذُهلٍ","وَقُلنا القَومُ إِخوانُ",24,"ن",1,0],["كففت كماتها بغرار عضب","حكى يوم الضرائب منتضاكا",25,"ك",2,0],["كففتُ المقلتين لِيشهدا لي","فَجَرَّحَتِ الدموعُ الشاهدينِ",26,"ن",1,0],["كففت طويلَ الشوقِ مني إليك يا","خليلي بطولِ الهجر والعتب والغضِّ",27,"ض",1,1],["كفَفتَ عن شتمي بلا إخنهٍ","ولم تورَّط كِفَّةً الحابلِ",28,"ل",1,0],["كَفُّ فَلَّاحٍ بَيْنَ غُصْنٍ وَغُصْنٍ","تَقْطَعُ الْعُنْقُودَ الّذِي لَا يُشَارُ",29,"ر",1,0],["كففتُ الردَّ عنهُ دون خوفٍ","فلمّا غرّهُ حلمي تمادى",30,"د",2,0],["كففتَ عنهمْ وَلوْ شئتَ اجتياحهمُ","لمْ تتركْ منهمُ رأساً وَ ذنبا",31,"ب",2,0]]}