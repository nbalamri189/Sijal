نعم صباحاً أيها الربع وانطقِ","https://www.poetsgate.com/ViewPoem.aspx?id=4799",""],[0,"قفا نبك من ذِكرى حبيب ومنزل ( معلقة )","https://www.poetsgate.com/ViewPoem.aspx?id=4730",""],[45,"مَرّتْ على عَزْمِها، وَلمْ تَقِفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32845",""],[16,"ذهبتَ من الهِجران في غير مذهب","https://www.poetsgate.com/ViewPoem.aspx?id=4907",""],[99,"صباح السكر","https://www.poetsgate.com/ViewPoem.aspx?id=577",""],[32,"شهِدتُ بأني لم تَغَيّر مودّتي،","https://www.poetsgate.com/ViewPoem.aspx?id=16013",""],[2,"صَحا القَلبُ عن سلمى وأقصرَ باطِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19479&r=&rc=5",""]],"verses":[["وَرُحنا سِراعاً وَالقُلوبُ مَشوقَةٌ","أَقامَت بِها الأَشجانُ واِرتَحَلَ الصَّبرُ",0,"ر",1,0],["ورُحْتُ غَبيَّ السِّنِّ عنْ كُلِّ مَضْحَكٍ","ومُنْكَسِرَ الألْحاظِ عنْ كُلِّ مَلْعَبِ",1,"ب",1,0],["ورَحِمْتُ كُلَّ فَضيلَةٍ مَغْصوبَةٍ","حتّى القَريضَ إذا ادَّعاهُ المُفْحَمُ",2,"م",1,0],["ورحت من سفر مضن إلى سفر","أضنى لأن طريق الراحة التعب",3,"ب",1,0],["وَرُحنا بِالسُيوفِ نَسوقُ فيهِم","إِلى رَبَواتِ مُعضِلَةٍ خَفِيَّه",4,"ي",2,0],["وَرَحَلْتَ عَنَّا الرَّكْبَ خَيْرَ خَلِيفَةٍ","أَثْنَى عَلَيْكَ اللهُ وَالإِسْلاَمُ",5,"م",1,0],["وَرُحٌّ كَالمُحارِ مُوَتَّداتٌ","بِها يَنضو الوَغى وَبِهِ يَذودُ",6,"د",1,0],["وَرُحنا غانِمين بِما أَرَدنا","وَراحوا نادِمينِ عَلى الخِلافِ",7,"ف",1,0],["وَرُحتُ إِلى حَيثُ المُنى تَبعَثُ المُنى","وَحَيثُ حَدا بي مِن هَوى النَفسِ ما حَدا",8,"د",2,0],["وَرُحتَ إِلى القَصرِ الَّذي غَضَّ طَرفَهُ","بُعَيدَ التَسامي أَن غَدا غَيرَهُ القَصرُ",9,"ر",1,0],["وَرُحنا وَراحَ الطَرفُ يُنفِضُ رَأسَهُ","مَتى ما تَرَقَّ العَينُ فيهِ تَسَفَّلِ",10,"ل",1,0],["وَرُحنا كَأَنّا مِن جُؤاثى عَشِيَّةٍ","نُعالي النِعاجَ بَينَ عَدلٍ وَمُحقَبِ",11,"ب",1,0],["وَرُحنا كَأَنَّ مِن جُؤاثى عَشِيَّةٌ","نُعالي النِعاجَ بَينَ عِدلٍ وَمُشنَقِ",12,"ق",1,0],["وَرُحنا بِكَاِبنِ الماءِ يُجنَبُ وَسطَن","تُصَوَّبُ فيهِ العَينُ طَوراً وَتَرتَقي",12,"ق",2,0],["وَرَحَّبَتْ سَمَاءٌ كَانَ فَرْقَدُهَا","مِلْءَ العُيُونِ فَبَانَ فَرْقَدُهَا",13,"د",3,0],["وَرُحْتَ أَيْأَسَ مَا رَا","حَ زَائِرٌ لِلْمَآتِمْ",14,"م",1,0],["وَرحلي عَلى عَوجاءَ حَرفٍ شِمِلَّةٍ","مِنَ الجُرشُعِّياتِ الضِخامِ المَحازِمِ",15,"م",1,0],["ورُحمى له من عاذر بان عذره","وأوهم نقصاً فضله متطاولُ",16,"ل",1,0],["ورُحت إلى التجدُّد في المعالي","تقود الناهضين بها وتُزجي",17,"ج",2,0],["ورحت أحتثّهم حدواً بقافية","غازلت في صدرها الآمال تشبيبا",18,"ب",2,0],["ورُحنا نَشاوىَ العِزّ يَهتف بعضنا","ببعضٍ هتافاً يُصعِق الظلم والحَيْفا",19,"ف",2,0],["ورحت وأهل الحيّ في قبضة الكرى","وفي الليل صمتٌ بالسكون مشوب",20,"ب",1,0],["وَرُحنا بِالقَلائِعِ كُلُّ نَهدٍ","مُطِلٍّ فَوقَهُ نَهدٌ مُطِلُّ",21,"ل",1,0],["ورحت أنقل عن أيوب أنعمه","نحو الصّلات فمن عطف وتوكيد",22,"د",1,0],["ورحت لو زادت دموعي عسى","عتابك الحلو لسمعي يزيد",23,"د",1,0],["ورحت أخطر في ألفاظها ألفاً","وكنت من دخلَ في هيبةِ الدال",24,"ل",1,0],["ورحت عن نعماه بالتواتر","أروي أحاديث عطا وجابر",25,"ر",1,0],["ورُحن يُجاذبنَ أردافهنَّ","لَواعبَ في نسوةٍ كالدُمى",26,"ا",1,0],["ورحنا مسرعين إليك شوقاً","مسارعةَ العليلِ إلى الطبيبِ",27,"ب",1,0],["ورحيقٌ كحريقٍ","في أباريق عقيقِ",28,"ق",1,0],["ورُحت منها طاعماً ناعماً","كأنما فزتَ بتمليك",29,"ك",1,0],["ورحنا على القُبّ العتاقِ وكلُّها","من العلقِ الوحشيِّ أقرحُ أرثمُ",30,"م",1,0],["وَرَحيقي ما سالَ مِن مُقلَةِ الفَجرِ","عَلى العُشبِ كَاللُجَينِ المُذابِ",31,"ب",1,0],["وَرُحتُ أَسأَلُ رَبّي","وَهُوَ اللَطيفُ الخَبيرُ",32,"ر",1,0],["وَرُحنا بَينَ مَصعوقٍ وَساهِ","كَمَن صَرَعَت عُقولُهُمُ المُدامُ",33,"م",1,0],["وَرُحتُ أَشكو إِلَيها وَهيَ ساهِيَةٌ","لَكِنَّما قَلبَها الخَفّاقُ يَقظانُ",34,"ن",1,0],["وَرُحتُ عَن تَوبَتِهِ سائِلاً","وَجَدتُها تَوبَةَ إِفلاسِ",35,"س",1,0],["وَرُحنا نَجُرُّ ذُيولَ العَفا","فِ وَنَسحَبُها فَوقَ ذاكَ الأَثَر",36,"ر",1,0],["وَرُحتُ أَظُنُّهُ قَولاً","يُكاذِبُني بِهِ لَعِبا",37,"ب",2,0],["وَرُحتُ لِرَسمِ اِسمِهِ لاثِماً","كَأَنّي لَثَمتُ اللَمى وَالشَنَب",38,"ب",1,0],["ورحابُ الفضاءِ تعبُقُ بالأَلحانِ","والعِطْرِ والضِّياءِ الجَميلِ",39,"ل",1,0],["وَرُحنَ وَقَد أَودَعنَ قَلبي أَمانَةً","لِبَثنَةَ سِرٌّ في الفُؤادِ كَمينُ",40,"ن",1,0],["ورحت تدعو اليه القوم منفردا","فلم يكن لك غير اللَه من وزر",41,"ر",1,0],["ورحابك الربوات إلا أنها","أرض الندَى وسماؤه المدرار",42,"ر",1,0],["وَرُحنا نُباهي الشَرقَ وَالغَربَ عِزَّةً","وَكُنّا حَديثَ الشامِتِ المُتَرَحِّمِ",43,"م",1,0],["وَرُحنا يَهُبُّ الشَرُّ فينا وَفيهِمُ","وَتَشمُلُ أَرواحُ القِتالِ وَتَجنُبُ",44,"ب",1,0],["ورحن وهْنَاً عن التجميرِ راشقةً","قلوبَنا بنبالٍ حُلوةِ الألمِ",45,"م",1,0],["وَرُحتُما وَالنُحوسُ تُنبِئُ عَن","حالٍ مِنَ الرائِحينَ مُختَلِفِ",46,"ف",1,0],["وَرَحَضتَ قِنَّسرينَ حَتّى أُنقِيَت","جَنَباتُها مِن ذَلِكَ البِرطيلِ",47,"ل",1,0],["وَرُحنا حَولَ شَرجَعِهِ كَأَنّا","نَشاوى رائِحونَ مِنَ الشُمولِ",48,"ل",1,0],["وَرَحلٍ حَمَلنا خَلفَ رَحلٍ وَناقَةٍ","تَرَكنا بِعَطشى لا يُزَجّى حَسيرُها",49,"ر",3,0],["وَرُحنا بِأُخرى ما أَجازوا وَبَرَّكَت","عَلى الحَوضِ مِنها جِلَّةٌ لَن تُثَوَّرا",50,"ر",2,0],["ورُحْتَ في الحُسْنِ أشكالاً مُقَسَّمةً","بينَ الهِلالِ وبينَ الغُصنِ والعُقَدِ",51,"د",1,0],["وَرَحبُ صَدرٍ كُلَّما هيمَنَت","فيهِ نَسيمُ المَدحِ زادَ اِرتِياح",52,"ح",1,0],["ورحلةُ العمر بي","نَ البكور والآصالِ",53,"ل",1,0],["ورحمتنَّ لي أزاهر ذكرى","علقت في ذبولها بالحياة",54,"ه",1,0],["ورحت أصغي وأصغي","لَم أُلفِ إلا صدايا",55,"ا",3,0],["ورَحبُ جَنابٍ حين ينزلُ للقِرى","وفصلُ خطابٍ حين يجتمع الحفلُ",56,"ل",1,0],["ورحتُ إلى غربةٍ مُرّةٍ","وراحَ إلى غُرْبَةً ساجيَه",57,"ي",2,0],["وَرَحمَةُ اللَّه تَترى منهُمُ أَبداً","عَلَيهِ ما كَرّتِ الآصالُ والبُكَرُ",58,"ر",1,0],["وَرَحلتَ في جَوْنِ القَتامِ عَرمرَمٍ","وَكَأنَّهُ لَيلٌ بِوَجهِكَ مُقمِرُ",59,"ر",1,0],["ورحتَ ببعضِ الرّوح فيك مودّعاً","بمؤنسة العوّادِ زُرْتَ بها اللّحدا",60,"د",2,0],["وَرُحبَ صَدرٍ لَوَ أَنَّ الأَرضَ واسِعَةٌ","كَوُسعِهِ لَم يَضِق عَن أَهلِها بَلَدُ",61,"د",1,0],["ورحْتُ خفيفَ الظهرِ عنْ منَّةِ امرئٍ","تهتَّكَ بالآثامِ وَهْوَ محجَّبُ",62,"ب",1,0],["ورحتُ أظمي وأسَقي من دمي زُمراً","راحت تُسقي أخا لؤمٍ وتُظميني",63,"ن",2,0],["ورُحْتُ أَطْفو على مَوْجَيْهِما قَلِقاً","أَكادُ أَحْسُدُ مَرْءًا فيهما غَرِقا",64,"ق",2,0],["وَرُحنَ فَبِتنَ فَوقَ البِئرِ حَتّى","بَدا لِلناظِرِ الصُبحُ البَليجُ",65,"ج",1,0],["وَرُحتُ كَأَنّي يَومَ راحَت جِمالُهُم","سُقيتُ دَمَ الحَيّاتِ حينَ اِنقَضى عُمري",66,"ي",1,0],["وَرُحنَ يُضاحِكُهُنَّ النَعيمُ","وَيَقتُلُني إِثرَهُنَّ البُكى",67,"ا",1,0],["وَرُحتُم يَهبُّ الشَرُّ مِن لَهَواتِكُم","مُدلّينَ أَن أَمسى بِكُم فاغِراً فَما",68,"م",2,0],["وَرُحتَ تَصُبُّ المالَ في غيرِ هِينَةٍ","تُريدُ بدينِ المسلمينِ الدَّواهيا",69,"ي",2,0],["وَرُحْتُ تُحابِيهم وتَشْفِي صُدورَهم","بِخرقَاءَ تستهوي الغَبِيَّ المُبَلَّدَا",70,"د",2,0],["وَرَحىً تَحتَنا وَأُخرى عَلَينا","كُلُّ مَرءٍ فيها طَحينٌ هَشيمُ",71,"م",1,0],["وَرُحتَ تَعمُرُ داراً لا بَقاءَ لها","وَأَنتَ عَنها وَإِن عُمِّرتَ مَنقُولُ",72,"ل",1,0],["وَرُحتُ بِها في زَورَقٍ قَد كَتَمتُها","وَمِن أَينَ لِلمِسكِ الذَكِيِّ كُتومُ",73,"م",1,0],["وَرُحتُ مِن عِرقِ الهَوى أُصَدّي","يا عَجَباً لِلعاجِزِ المُسَدّي",74,"ي",1,0],["ورحمةُ اللَّه في الآفاقِ قد نُشرتْ","والأرضُ تُبدي تباشيراً لمبداكا",75,"ك",2,0],["ورحت أعاطيه الحَنان بنظرة","كما راح يرنو العابد المتخشِّع",76,"ع",1,0],["ورحيقٌ عَطِرٌ من نفحه","يثْمَل الأعداءُ قبل الأصدقاءْ",77,"ا",2,0],["ورحلةِ الصيفِ في أوربا","وسحر أيامِها الوضاءِ",78,"ا",2,0],["ورُحْنا كأنّا نَمْتَطِي أخْدَرِيَّةً","أَضَرَّ بِها رَخْوُ اللِّبانِ عَنِيفُ",79,"ف",1,0],["ورَحِيلُ عَيْشِكَ كُلَّ رِحْلةِ ساعة","وفَناءُ طِيبِكَ في الزَّمَانِ الأَطْيَبِ",80,"ب",1,0],["وَرُحْتَ مَظْلُوماً وَمَا كُنْتَ إِذْ","حَكَمْتَ بِالبَاغِي وَلاَ الطَّامِعِ",81,"ع",1,0],["وَرُحْتَ بِالمَثَلِ الأَعْلَى تُجَنِّبُنَا","أَنْ بَنْخَسَ الدُرَّ أَوْ أَنْ نُغْلِيَ الصَّدَفَا",82,"ف",2,0],["وَرَحَمْتَ نَفْسَكَ أَمْ عَصَتْكَ فَأُسْقِ","طَتْ عَنْهَا تَكَالِيفُ الجِهَادِ السَّرْمَدِ",83,"د",1,0],["وَرُحْنَا وأُخْرَانَا بِطَاءٌ كأنَّنَا","أُسُودٌ على لَحْمٍ بِبِيشةَ ظُلَّعُ",84,"ع",1,0],["وَرُح وَاِغدُ لِلعِلمِ دَأباً تَرِث","بِهِ العِزَّ وَالنَسَبَ الأَبرَكا",85,"ك",2,0],["وَرحتَ مِنها سالِماً","لَيسَ عَلَيكَ مِن دَرَك",86,"ك",1,0],["وَرُحنا بِكَاِبنِ الماءِ يُجنَبُ وَسطَنا","تُصَوَّبُ فيهِ العَينُ طَوراً وَتَرتَقي",87,"ق",2,0],["وَرُحنا بِأَشخاصٍ كَأَشجارِ أَيكَةٍ","عَوارِيَ لَم يورِق لَهُنَّ قَضيبُ",88,"ب",1,0],["ورحا الموتِ لا تني تملأ الأر","ضَ ضجيجاً وتنثر الناس طحْنَا",89,"ن",2,0],["ورَحْمَةٌ رَفّافَةٌ لم تَدَعْ","قلْباً يُوارِي النارَ في صَخْرِهِ",90,"ر",2,0],["ورحيقُ الأزهارِ كم ضمَّ من رَوْ","ضٍ شَذِيِّ الشَّميمِ في قَطَراته",91,"ت",2,0],["ورحنا كأنا نمتطي اخدرية","حليٌّ بجَنْبى ثادق وجَفيفُ",92,"ف",1,0],["ورُحْنَ ينقشن في الأمواج من صورٍ","ما ليس ينقشه الرسَّامُ بالقلم!",93,"م",1,0],["ورحَّب الناس بالإسلام حين رأوا","أن الإخاء وأن العدل مغزاه",94,"ا",2,0],["ورحت بها في زروق قد كتمتها","ومن أين للمسك الذكي كتوم",95,"م",1,0],["ورُحْنَ كأسراب القطا نُعَّمَ الخُطَى","وقىَ اللهُ - من شَرٍّ يرادُ به - السِّرْبا",96,"ب",2,0],["ورُحْتُ رغَم جحودٍ عامدٍ أشرٍ","للحظِّ أُرجِعُ حالي والمقادير",97,"ر",1,0],["ورَحلْتَ خير مُودَّع عن موطنٍ","حاميتَ عنه ، وأُبتَ خيرَ إياب",98,"ب",1,0],["ورُحتُ منها على وَعدٍ بمغفرة","إنْ لم يُسدِّدْ خطايَ اليومَ شيطاني",99,"ن",2,0],["ورُحتُ أُشبِّهُ ما فاتني","من العيش بالبارق الخُلَّب",100,"ب",1,0],["ورحنا كأناً من جؤاثي عشية","ٌ نعالي النعاجَ بين عدلٍ ومشنق",101,"ق",1,0],["ورحنا بكابن الماء يجنب وسطنا","تصوبُ فيه العين طوراً ونرتقي",101,"ق",2,0],["ورُحنا راحَ الطرفُ ينفض رأسه","متى ما تَرَقَّ العينُ فيه تَسَفَّلِ",102,"ل",1,0],["وَرُحتُما، وَالنّحوسُ تُنبِىءُ عنْ","حَالٍ، مِنَ الرّائحينَ، مُختَلِفِ",103,"ف",1,0],["ورُحنا كأنَّا جُواثى عَشِيَّة","ً نُعالي النِّعاج بَينَ عِدلٍ ومُحقَبِ",104,"ب",1,0],["ورحت أخطّ كطفل صغير","كلاماً غريباً على وجه دفتر",105,"ر",1,0],["ورُحنَ، وقد أودَعنَ قلبي أمانة","ً لبثينة َ: سرٌّ في الفؤاد ، كمينُ",106,"ن",1,0],["ورحنا بهِ، ينضو الجيادَ، عشية ً","مُخْضَّبَة ً أرْساغُهُ وعَوَامِلُهْ",107,"ل",2,0]]}