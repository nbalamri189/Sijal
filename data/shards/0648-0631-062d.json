[377,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[380,"زجر الرعد مثقلات الغمام","https://www.aldiwan.net/poem48762.html","الخفيف"],[380,"حر قلبي من برد ريق شهي","https://www.aldiwan.net/poem48825.html","الخفيف"],[380,"طلل عكف عليه بأني","https://www.aldiwan.net/poem49201.html","مجزوء الكامل"],[380,"لئن حل في دين الهوى لكم ظلمي","https://www.aldiwan.net/poem49259.html","الطويل"],[391,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[400,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[402,"تنبه حظي بعد طول منام","https://www.aldiwan.net/poem46935.html","الطويل"],[403,"خطب عظيم فمنه الدمع ينحدر","https://www.aldiwan.net/poem33929.html","البسيط"],[403,"عجبا يعاتبني بلا ذنب","https://www.aldiwan.net/poem34115.html","الكامل"],[405,"ودعت حبي وفي يدي يده","https://www.aldiwan.net/poem50034.html","المنسرح"],[406,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[409,"وما أشكو تلون أهل ودي","https://www.aldiwan.net/poem32285.html","الوافر"],[416,"رعى الله عيشا رحت أشكر فضله","https://www.aldiwan.net/poem53849.html","الطويل"],[416,"أتانا عنك مولانا البشير","https://www.aldiwan.net/poem53895.html","الوافر"],[416,"بلغتم كمال الرشد أبناء راشد","https://www.aldiwan.net/poem54010.html","الطويل"],[416,"ألا من لأجفان أرقن رواء","https://www.aldiwan.net/poem54033.html","الطويل"],[416,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[432,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[432,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[432,"أظن البدر نازعك الكمالا","https://www.aldiwan.net/poem12760.html","الوافر"],[434,"ولم أنسه إذ قبل الركن خاليا","https://www.aldiwan.net/poem26357.html","الطويل"],[437,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[439,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[439,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[441,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[441,"تعز فعز حي لا يموت","https://www.aldiwan.net/poem14442.html","الوافر"],[441,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[452,"تزرد من فوقه سابغ","https://www.aldiwan.net/poem13904.html","المتقارب"],[452,"أيا من غدا في اللغز سباق غاية","https://www.aldiwan.net/poem13970.html","الطويل"],[458,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[458,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[458,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[458,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[458,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[458,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[461,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[464,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[464,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[464,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[464,"ولم أر يوماً كان أبهج منظراً","https://www.aldiwan.net/poem3507.html","عموديه"],[464,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[486,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[489,"خليلي عوجا فانظراني لعلني","https://www.aldiwan.net/poem403.html",""],[500,"أرح فؤادك من هم الوجودات","https://www.aldiwan.net/poem37713.html","البسيط"],[500,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[500,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[500,"بالله يا أيها الساري العشية لم","https://www.aldiwan.net/poem37966.html","البسيط"],[500,"تعلمنا الإشارة في طريق","https://www.aldiwan.net/poem37970.html","الوافر"],[500,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[500,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[515,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[515,"ما كنت آلف منزلي إلا به","https://www.aldiwan.net/poem12027.html","الكامل"],[515,"الحمد للعيس بعد العزم والهمم","https://www.aldiwan.net/poem12243.html","البسيط"],[515,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[538,"أتاك كما تأتي اللآلئ في العقد","https://www.aldiwan.net/poem48213.html","عموديه"],[542,"والله يعلم ما أقول فإنه","https://www.aldiwan.net/poem34037.html","الكامل"],[553,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[558,"شموسك يا سلمى علينا بوازغ","https://www.aldiwan.net/poem34364.html","الطويل"],[567,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[575,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[575,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[575,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"]],"verses":[["وَرُحنا سِراعاً وَالقُلوبُ مَشوقَةٌ","أَقامَت بِها الأَشجانُ واِرتَحَلَ الصَّبرُ",0,"ر",1,0],["ورُحْتُ غَبيَّ السِّنِّ عنْ كُلِّ مَضْحَكٍ","ومُنْكَسِرَ الألْحاظِ عنْ كُلِّ مَلْعَبِ",1,"ب",1,0],["ورَحِمْتُ كُلَّ فَضيلَةٍ مَغْصوبَةٍ","حتّى القَريضَ إذا ادَّعاهُ المُفْحَمُ",2,"م",1,0],["ورحت من سفر مضن إلى سفر","أضنى لأن طريق الراحة التعب",3,"ب",1,0],["وَرُحنا بِالسُيوفِ نَسوقُ فيهِم","إِلى رَبَواتِ مُعضِلَةٍ خَفِيَّه",4,"ي",2,0],["وَرَحَلْتَ عَنَّا الرَّكْبَ خَيْرَ خَلِيفَةٍ","أَثْنَى عَلَيْكَ اللهُ وَالإِسْلاَمُ",5,"م",1,0],["وَرُحٌّ كَالمُحارِ مُوَتَّداتٌ","بِها يَنضو الوَغى وَبِهِ يَذودُ",6,"د",1,0],["وَرُحنا غانِمين بِما أَرَدنا","وَراحوا نادِمينِ عَلى الخِلافِ",7,"ف",1,0],["وَرُحتُ إِلى حَيثُ المُنى تَبعَثُ المُنى","وَحَيثُ حَدا بي مِن هَوى النَفسِ ما حَدا",8,"د",2,0],["وَرُحتَ إِلى القَصرِ الَّذي غَضَّ طَرفَهُ","بُعَيدَ التَسامي أَن غَدا غَيرَهُ القَصرُ",9,"ر",1,0],["وَرُحنا وَراحَ الطَرفُ يُنفِضُ رَأسَهُ","مَتى ما تَرَقَّ العَينُ فيهِ تَسَفَّلِ",10,"ل",1,0],["وَرُحنا كَأَنّا مِن جُؤاثى عَشِيَّةٍ","نُعالي النِعاجَ بَينَ عَدلٍ وَمُحقَبِ",11,"ب",1,0],["وَرُحنا كَأَنَّ مِن جُؤاثى عَشِيَّةٌ","نُعالي النِعاجَ بَينَ عِدلٍ وَمُشنَقِ",12,"ق",1,0],["وَرُحنا بِكَاِبنِ الماءِ يُجنَبُ وَسطَن","تُصَوَّبُ فيهِ العَينُ طَوراً وَتَرتَقي",12,"ق",2,0],["وَرَحَّبَتْ سَمَاءٌ كَانَ فَرْقَدُهَا","مِلْءَ العُيُونِ فَبَانَ فَرْقَدُهَا",13,"د",3,0],["وَرُحْتَ أَيْأَسَ مَا رَا","حَ زَائِرٌ لِلْمَآتِمْ",14,"م",1,0],["وَرحلي عَلى عَوجاءَ حَرفٍ شِمِلَّةٍ","مِنَ الجُرشُعِّياتِ الضِخامِ المَحازِمِ",15,"م",1,0],["ورُحمى له من عاذر بان عذره","وأوهم نقصاً فضله متطاولُ",16,"ل",1,0],["ورُحت إلى التجدُّد في المعالي","تقود الناهضين بها وتُزجي",17,"ج",2,0],["ورحت أحتثّهم حدواً بقافية","غازلت في صدرها الآمال تشبيبا",18,"ب",2,0],["ورُحنا نَشاوىَ العِزّ يَهتف بعضنا","ببعضٍ هتافاً يُصعِق الظلم والحَيْفا",19,"ف",2,0],["ورحت وأهل الحيّ في قبضة الكرى","وفي الليل صمتٌ بالسكون مشوب",20,"ب",1,0],["وَرُحنا بِالقَلائِعِ كُلُّ نَهدٍ","مُطِلٍّ فَوقَهُ نَهدٌ مُطِلُّ",21,"ل",1,0],["ورحت أنقل عن أيوب أنعمه","نحو الصّلات فمن عطف وتوكيد",22,"د",1,0],["ورحت لو زادت دموعي عسى","عتابك الحلو لسمعي يزيد",23,"د",1,0],["ورحت أخطر في ألفاظها ألفاً","وكنت من دخلَ في هيبةِ الدال",24,"ل",1,0],["ورحت عن نعماه بالتواتر","أروي أحاديث عطا وجابر",25,"ر",1,0],["ورُحن يُجاذبنَ أردافهنَّ","لَواعبَ في نسوةٍ كالدُمى",26,"ا",1,0],["ورحنا مسرعين إليك شوقاً","مسارعةَ العليلِ إلى الطبيبِ",27,"ب",1,0],["ورحيقٌ كحريقٍ","في أباريق عقيقِ",28,"ق",1,0],["ورُحت منها طاعماً ناعماً","كأنما فزتَ بتمليك",29,"ك",1,0],["ورحنا على القُبّ العتاقِ وكلُّها","من العلقِ الوحشيِّ أقرحُ أرثمُ",30,"م",1,0],["وَرَحيقي ما سالَ مِن مُقلَةِ الفَجرِ","عَلى العُشبِ كَاللُجَينِ المُذابِ",31,"ب",1,0],["وَرُحتُ أَسأَلُ رَبّي","وَهُوَ اللَطيفُ الخَبيرُ",32,"ر",1,0],["وَرُحنا بَينَ مَصعوقٍ وَساهِ","كَمَن صَرَعَت عُقولُهُمُ المُدامُ",33,"م",1,0],["وَرُحتُ أَشكو إِلَيها وَهيَ ساهِيَةٌ","لَكِنَّما قَلبَها الخَفّاقُ يَقظانُ",34,"ن",1,0],["وَرُحتُ عَن تَوبَتِهِ سائِلاً","وَجَدتُها تَوبَةَ إِفلاسِ",35,"س",1,0],["وَرُحنا نَجُرُّ ذُيولَ العَفا","فِ وَنَسحَبُها فَوقَ ذاكَ الأَثَر",36,"ر",1,0],["وَرُحتُ أَظُنُّهُ قَولاً","يُكاذِبُني بِهِ لَعِبا",37,"ب",2,0],["وَرُحتُ لِرَسمِ اِسمِهِ لاثِماً","كَأَنّي لَثَمتُ اللَمى وَالشَنَب",38,"ب",1,0],["ورحابُ الفضاءِ تعبُقُ بالأَلحانِ","والعِطْرِ والضِّياءِ الجَميلِ",39,"ل",1,0],["وَرُحنَ وَقَد أَودَعنَ قَلبي أَمانَةً","لِبَثنَةَ سِرٌّ في الفُؤادِ كَمينُ",40,"ن",1,0],["ورحت تدعو اليه القوم منفردا","فلم يكن لك غير اللَه من وزر",41,"ر",1,0],["ورحابك الربوات إلا أنها","أرض الندَى وسماؤه المدرار",42,"ر",1,0],["وَرُحنا نُباهي الشَرقَ وَالغَربَ عِزَّةً","وَكُنّا حَديثَ الشامِتِ المُتَرَحِّمِ",43,"م",1,0],["وَرُحنا يَهُبُّ الشَرُّ فينا وَفيهِمُ","وَتَشمُلُ أَرواحُ القِتالِ وَتَجنُبُ",44,"ب",1,0],["ورحن وهْنَاً عن التجميرِ راشقةً","قلوبَنا بنبالٍ حُلوةِ الألمِ",45,"م",1,0],["وَرُحتُما وَالنُحوسُ تُنبِئُ عَن","حالٍ مِنَ الرائِحينَ مُختَلِفِ",46,"ف",1,0],["وَرَحَضتَ قِنَّسرينَ حَتّى أُنقِيَت","جَنَباتُها مِن ذَلِكَ البِرطيلِ",47,"ل",1,0],["وَرُحنا حَولَ شَرجَعِهِ كَأَنّا","نَشاوى رائِحونَ مِنَ الشُمولِ",48,"ل",1,0],["وَرَحلٍ حَمَلنا خَلفَ رَحلٍ وَناقَةٍ","تَرَكنا بِعَطشى لا يُزَجّى حَسيرُها",49,"ر",3,0],["وَرُحنا بِأُخرى ما أَجازوا وَبَرَّكَت","عَلى الحَوضِ مِنها جِلَّةٌ لَن تُثَوَّرا",50,"ر",2,0],["ورُحْتَ في الحُسْنِ أشكالاً مُقَسَّمةً","بينَ الهِلالِ وبينَ الغُصنِ والعُقَدِ",51,"د",1,0],["وَرَحبُ صَدرٍ كُلَّما هيمَنَت","فيهِ نَسيمُ المَدحِ زادَ اِرتِياح",52,"ح",1,0],["ورحلةُ العمر بي","نَ البكور والآصالِ",53,"ل",1,0],["ورحمتنَّ لي أزاهر ذكرى","علقت في ذبولها بالحياة",54,"ه",1,0],["ورحت أصغي وأصغي","لَم أُلفِ إلا صدايا",55,"ا",3,0],["وَرُحْتَ تَكْفُرُ بِالأصْنَامِ مُهْتَدِياً","مِنْ قَبْلِ أَنْ يُنْزِلَ اللهُ الكِتَابَ هُدَى",56,"د",2,0],["ورَحبُ جَنابٍ حين ينزلُ للقِرى","وفصلُ خطابٍ حين يجتمع الحفلُ",57,"ل",1,0],["ورحتُ إلى غربةٍ مُرّةٍ","وراحَ إلى غُرْبَةً ساجيَه",58,"ي",2,0],["وَرَحمَةُ اللَّه تَترى منهُمُ أَبداً","عَلَيهِ ما كَرّتِ الآصالُ والبُكَرُ",59,"ر",1,0],["وَرَحلتَ في جَوْنِ القَتامِ عَرمرَمٍ","وَكَأنَّهُ لَيلٌ بِوَجهِكَ مُقمِرُ",60,"ر",1,0],["ورحتَ ببعضِ الرّوح فيك مودّعاً","بمؤنسة العوّادِ زُرْتَ بها اللّحدا",61,"د",2,0],["وَرُحبَ صَدرٍ لَوَ أَنَّ الأَرضَ واسِعَةٌ","كَوُسعِهِ لَم يَضِق عَن أَهلِها بَلَدُ",62,"د",1,0],["ورحْتُ خفيفَ الظهرِ عنْ منَّةِ امرئٍ","تهتَّكَ بالآثامِ وَهْوَ محجَّبُ",63,"ب",1,0],["ورحتُ أظمي وأسَقي من دمي زُمراً","راحت تُسقي أخا لؤمٍ وتُظميني",64,"ن",2,0],["ورُحْتُ أَطْفو على مَوْجَيْهِما قَلِقاً","أَكادُ أَحْسُدُ مَرْءًا فيهما غَرِقا",65,"ق",2,0],["وَرُحنَ فَبِتنَ فَوقَ البِئرِ حَتّى","بَدا لِلناظِرِ الصُبحُ البَليجُ",66,"ج",1,0],["وَرُحتُ كَأَنّي يَومَ راحَت جِمالُهُم","سُقيتُ دَمَ الحَيّاتِ حينَ اِنقَضى عُمري",67,"ي",1,0],["وَرُحنَ يُضاحِكُهُنَّ النَعيمُ","وَيَقتُلُني إِثرَهُنَّ البُكى",68,"ا",1,0],["وَرُحتُم يَهبُّ الشَرُّ مِن لَهَواتِكُم","مُدلّينَ أَن أَمسى بِكُم فاغِراً فَما",69,"م",2,0],["وَرُحتَ تَصُبُّ المالَ في غيرِ هِينَةٍ","تُريدُ بدينِ المسلمينِ الدَّواهيا",70,"ي",2,0],["وَرُحْتُ تُحابِيهم وتَشْفِي صُدورَهم","بِخرقَاءَ تستهوي الغَبِيَّ المُبَلَّدَا",71,"د",2,0],["وَرَحىً تَحتَنا وَأُخرى عَلَينا","كُلُّ مَرءٍ فيها طَحينٌ هَشيمُ",72,"م",1,0],["وَرُحتَ تَعمُرُ داراً لا بَقاءَ لها","وَأَنتَ عَنها وَإِن عُمِّرتَ مَنقُولُ",73,"ل",1,0],["وَرُحتُ بِها في زَورَقٍ قَد كَتَمتُها","وَمِن أَينَ لِلمِسكِ الذَكِيِّ كُتومُ",74,"م",1,0],["وَرُحتُ مِن عِرقِ الهَوى أُصَدّي","يا عَجَباً لِلعاجِزِ المُسَدّي",75,"ي",1,0],["ورحمةُ اللَّه في الآفاقِ قد نُشرتْ","والأرضُ تُبدي تباشيراً لمبداكا",76,"ك",2,0],["ورحب الناس بالإسلام حين رأوا","أن الإخاء وأن العدل مغزاه",77,"ا",2,0],["ورحت أعاطيه الحَنان بنظرة","كما راح يرنو العابد المتخشِّع",78,"ع",1,0],["ورحيقٌ عَطِرٌ من نفحه","يثْمَل الأعداءُ قبل الأصدقاءْ",79,"ا",2,0],["ورحلةِ الصيفِ في أوربا","وسحر أيامِها الوضاءِ",80,"ا",2,0],["ورُحْنا كأنّا نَمْتَطِي أخْدَرِيَّةً","أَضَرَّ بِها رَخْوُ اللِّبانِ عَنِيفُ",81,"ف",1,0],["ورَحِيلُ عَيْشِكَ كُلَّ رِحْلةِ ساعة","وفَن