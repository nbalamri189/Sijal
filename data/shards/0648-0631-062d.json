أني","https://www.aldiwan.net/poem59430.html","الكامل"],[378,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[381,"زجر الرعد مثقلات الغمام","https://www.aldiwan.net/poem48762.html","الخفيف"],[381,"حر قلبي من برد ريق شهي","https://www.aldiwan.net/poem48825.html","الخفيف"],[381,"طلل عكف عليه بأني","https://www.aldiwan.net/poem49201.html","مجزوء الكامل"],[381,"لئن حل في دين الهوى لكم ظلمي","https://www.aldiwan.net/poem49259.html","الطويل"],[392,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[401,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[403,"تنبه حظي بعد طول منام","https://www.aldiwan.net/poem46935.html","الطويل"],[404,"خطب عظيم فمنه الدمع ينحدر","https://www.aldiwan.net/poem33929.html","البسيط"],[404,"عجبا يعاتبني بلا ذنب","https://www.aldiwan.net/poem34115.html","الكامل"],[406,"ودعت حبي وفي يدي يده","https://www.aldiwan.net/poem50034.html","المنسرح"],[407,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[410,"وما أشكو تلون أهل ودي","https://www.aldiwan.net/poem32285.html","الوافر"],[417,"رعى الله عيشا رحت أشكر فضله","https://www.aldiwan.net/poem53849.html","الطويل"],[417,"أتانا عنك مولانا البشير","https://www.aldiwan.net/poem53895.html","الوافر"],[417,"بلغتم كمال الرشد أبناء راشد","https://www.aldiwan.net/poem54010.html","الطويل"],[417,"ألا من لأجفان أرقن رواء","https://www.aldiwan.net/poem54033.html","الطويل"],[417,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[433,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[433,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[433,"أظن البدر نازعك الكمالا","https://www.aldiwan.net/poem12760.html","الوافر"],[435,"ولم أنسه إذ قبل الركن خاليا","https://www.aldiwan.net/poem26357.html","الطويل"],[438,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[440,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[440,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[442,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[442,"تعز فعز حي لا يموت","https://www.aldiwan.net/poem14442.html","الوافر"],[442,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[453,"تزرد من فوقه سابغ","https://www.aldiwan.net/poem13904.html","المتقارب"],[453,"أيا من غدا في اللغز سباق غاية","https://www.aldiwan.net/poem13970.html","الطويل"],[459,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[459,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[459,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[459,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[459,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[459,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[462,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[465,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[465,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[465,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[465,"ولم أر يوماً كان أبهج منظراً","https://www.aldiwan.net/poem3507.html","عموديه"],[465,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[487,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[490,"خليلي عوجا فانظراني لعلني","https://www.aldiwan.net/poem403.html",""],[501,"أرح فؤادك من هم الوجودات","https://www.aldiwan.net/poem37713.html","البسيط"],[501,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[501,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[501,"بالله يا أيها الساري العشية لم","https://www.aldiwan.net/poem37966.html","البسيط"],[501,"تعلمنا الإشارة في طريق","https://www.aldiwan.net/poem37970.html","الوافر"],[501,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[501,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[516,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[516,"ما كنت آلف منزلي إلا به","https://www.aldiwan.net/poem12027.html","الكامل"],[516,"الحمد للعيس بعد العزم والهمم","https://www.aldiwan.net/poem12243.html","البسيط"],[516,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[539,"أتاك كما تأتي اللآلئ في العقد","https://www.aldiwan.net/poem48213.html","عموديه"],[543,"والله يعلم ما أقول فإنه","https://www.aldiwan.net/poem34037.html","الكامل"],[554,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[559,"شموسك يا سلمى علينا بوازغ","https://www.aldiwan.net/poem34364.html","الطويل"],[568,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[576,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[576,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[576,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"]],"verses":[["ورحت إماماً رغم عزلك مثلما","عن النصر لم تمنع وطرفك رامد",0,"د",1,0],["وَرُحنا سِراعاً وَالقُلوبُ مَشوقَةٌ","أَقامَت بِها الأَشجانُ واِرتَحَلَ الصَّبرُ",1,"ر",1,0],["ورُحْتُ غَبيَّ السِّنِّ عنْ كُلِّ مَضْحَكٍ","ومُنْكَسِرَ الألْحاظِ عنْ كُلِّ مَلْعَبِ",2,"ب",1,0],["ورَحِمْتُ كُلَّ فَضيلَةٍ مَغْصوبَةٍ","حتّى القَريضَ إذا ادَّعاهُ المُفْحَمُ",3,"م",1,0],["ورحت من سفر مضن إلى سفر","أضنى لأن طريق الراحة التعب",4,"ب",1,0],["وَرُحنا بِالسُيوفِ نَسوقُ فيهِم","إِلى رَبَواتِ مُعضِلَةٍ خَفِيَّه",5,"ي",2,0],["وَرَحَلْتَ عَنَّا الرَّكْبَ خَيْرَ خَلِيفَةٍ","أَثْنَى عَلَيْكَ اللهُ وَالإِسْلاَمُ",6,"م",1,0],["وَرُحٌّ كَالمُحارِ مُوَتَّداتٌ","بِها يَنضو الوَغى وَبِهِ يَذودُ",7,"د",1,0],["وَرُحنا غانِمين بِما أَرَدنا","وَراحوا نادِمينِ عَلى الخِلافِ",8,"ف",1,0],["وَرُحتُ إِلى حَيثُ المُنى تَبعَثُ المُنى","وَحَيثُ حَدا بي مِن هَوى النَفسِ ما حَدا",9,"د",2,0],["وَرُحتَ إِلى القَصرِ الَّذي غَضَّ طَرفَهُ","بُعَيدَ التَسامي أَن غَدا غَيرَهُ القَصرُ",10,"ر",1,0],["وَرُحنا وَراحَ الطَرفُ يُنفِضُ رَأسَهُ","مَتى ما تَرَقَّ العَينُ فيهِ تَسَفَّلِ",11,"ل",1,0],["وَرُحنا كَأَنّا مِن جُؤاثى عَشِيَّةٍ","نُعالي النِعاجَ بَينَ عَدلٍ وَمُحقَبِ",12,"ب",1,0],["وَرُحنا كَأَنَّ مِن جُؤاثى عَشِيَّةٌ","نُعالي النِعاجَ بَينَ عِدلٍ وَمُشنَقِ",13,"ق",1,0],["وَرُحنا بِكَاِبنِ الماءِ يُجنَبُ وَسطَن","تُصَوَّبُ فيهِ العَينُ طَوراً وَتَرتَقي",13,"ق",2,0],["وَرَحَّبَتْ سَمَاءٌ كَانَ فَرْقَدُهَا","مِلْءَ العُيُونِ فَبَانَ فَرْقَدُهَا",14,"د",3,0],["وَرُحْتَ أَيْأَسَ مَا رَا","حَ زَائِرٌ لِلْمَآتِمْ",15,"م",1,0],["وَرحلي عَلى عَوجاءَ حَرفٍ شِمِلَّةٍ","مِنَ الجُرشُعِّياتِ الضِخامِ المَحازِمِ",16,"م",1,0],["ورُحمى له من عاذر بان عذره","وأوهم نقصاً فضله متطاولُ",17,"ل",1,0],["ورُحت إلى التجدُّد في المعالي","تقود الناهضين بها وتُزجي",18,"ج",2,0],["ورحت أحتثّهم حدواً بقافية","غازلت في صدرها الآمال تشبيبا",19,"ب",2,0],["ورُحنا نَشاوىَ العِزّ يَهتف بعضنا","ببعضٍ هتافاً يُصعِق الظلم والحَيْفا",20,"ف",2,0],["ورحت وأهل الحيّ في قبضة الكرى","وفي الليل صمتٌ بالسكون مشوب",21,"ب",1,0],["وَرُحنا بِالقَلائِعِ كُلُّ نَهدٍ","مُطِلٍّ فَوقَهُ نَهدٌ مُطِلُّ",22,"ل",1,0],["ورحت أنقل عن أيوب أنعمه","نحو الصّلات فمن عطف وتوكيد",23,"د",1,0],["ورحت لو زادت دموعي عسى","عتابك الحلو لسمعي يزيد",24,"د",1,0],["ورحت أخطر في ألفاظها ألفاً","وكنت من دخلَ في هيبةِ الدال",25,"ل",1,0],["ورحت عن نعماه بالتواتر","أروي أحاديث عطا وجابر",26,"ر",1,0],["ورُحن يُجاذبنَ أردافهنَّ","لَواعبَ في نسوةٍ كالدُمى",27,"ا",1,0],["ورحنا مسرعين إليك شوقاً","مسارعةَ العليلِ إلى الطبيبِ",28,"ب",1,0],["ورحيقٌ كحريقٍ","في أباريق عقيقِ",29,"ق",1,0],["ورُحت منها طاعماً ناعماً","كأنما فزتَ بتمليك",30,"ك",1,0],["ورحنا على القُبّ العتاقِ وكلُّها","من العلقِ الوحشيِّ أقرحُ أرثمُ",31,"م",1,0],["وَرَحيقي ما سالَ مِن مُقلَةِ الفَجرِ","عَلى العُشبِ كَاللُجَينِ المُذابِ",32,"ب",1,0],["وَرُحتُ أَسأَلُ رَبّي","وَهُوَ اللَطيفُ الخَبيرُ",33,"ر",1,0],["وَرُحنا بَينَ مَصعوقٍ وَساهِ","كَمَن صَرَعَت عُقولُهُمُ المُدامُ",34,"م",1,0],["وَرُحتُ أَشكو إِلَيها وَهيَ ساهِيَةٌ","لَكِنَّما قَلبَها الخَفّاقُ يَقظانُ",35,"ن",1,0],["وَرُحتُ عَن تَوبَتِهِ سائِلاً","وَجَدتُها تَوبَةَ إِفلاسِ",36,"س",1,0],["وَرُحنا نَجُرُّ ذُيولَ العَفا","فِ وَنَسحَبُها فَوقَ ذاكَ الأَثَر",37,"ر",1,0],["وَرُحتُ أَظُنُّهُ قَولاً","يُكاذِبُني بِهِ لَعِبا",38,"ب",2,0],["وَرُحتُ لِرَسمِ اِسمِهِ لاثِماً","كَأَنّي لَثَمتُ اللَمى وَالشَنَب",39,"ب",1,0],["ورحابُ الفضاءِ تعبُقُ بالأَلحانِ","والعِطْرِ والضِّياءِ الجَميلِ",40,"ل",1,0],["وَرُحنَ وَقَد أَودَعنَ قَلبي أَمانَةً","لِبَثنَةَ سِرٌّ في الفُؤادِ كَمينُ",41,"ن",1,0],["ورحت تدعو اليه القوم منفردا","فلم يكن لك غير اللَه من وزر",42,"ر",1,0],["ورحابك الربوات إلا أنها","أرض الندَى وسماؤه المدرار",43,"ر",1,0],["وَرُحنا نُباهي الشَرقَ وَالغَربَ عِزَّةً","وَكُنّا حَديثَ الشامِتِ المُتَرَحِّمِ",44,"م",1,0],["وَرُحنا يَهُبُّ الشَرُّ فينا وَفيهِمُ","وَتَشمُلُ أَرواحُ القِتالِ وَتَجنُبُ",45,"ب",1,0],["ورحن وهْنَاً عن التجميرِ راشقةً","قلوبَنا بنبالٍ حُلوةِ الألمِ",46,"م",1,0],["وَرُحتُما وَالنُحوسُ تُنبِئُ عَن","حالٍ مِنَ الرائِحينَ مُختَلِفِ",47,"ف",1,0],["وَرَحَضتَ قِنَّسرينَ حَتّى أُنقِيَت","جَنَباتُها مِن ذَلِكَ البِرطيلِ",48,"ل",1,0],["وَرُحنا حَولَ شَرجَعِهِ كَأَنّا","نَشاوى رائِحونَ مِنَ الشُمولِ",49,"ل",1,0],["وَرَحلٍ حَمَلنا خَلفَ رَحلٍ وَناقَةٍ","تَرَكنا بِعَطشى لا يُزَجّى حَسيرُها",50,"ر",3,0],["وَرُحنا بِأُخرى ما أَجازوا وَبَرَّكَت","عَلى الحَوضِ مِنها جِلَّةٌ لَن تُثَوَّرا",51,"ر",2,0],["ورُحْتَ في الحُسْنِ أشكالاً مُقَسَّمةً","بينَ الهِلالِ وبينَ الغُصنِ والعُقَدِ",52,"د",1,0],["وَرَحبُ صَدرٍ كُلَّما هيمَنَت","فيهِ نَسيمُ المَدحِ زادَ اِرتِياح",53,"ح",1,0],["ورحلةُ العمر بي","نَ البكور والآصالِ",54,"ل",1,0],["ورحمتنَّ لي أزاهر ذكرى","علقت في ذبولها بالحياة",55,"ه",1,0],["ورحت أصغي وأصغي","لَم أُلفِ إلا صدايا",56,"ا",3,0],["وَرُحْتَ تَكْفُرُ بِالأصْنَامِ مُهْتَدِياً","مِنْ قَبْلِ أَنْ يُنْزِلَ اللهُ الكِتَابَ هُدَى",57,"د",2,0],["ورَحبُ جَنابٍ حين ينزلُ للقِرى","وفصلُ خطابٍ حين يجتمع الحفلُ",58,"ل",1,0],["ورحتُ إلى غربةٍ مُرّةٍ","وراحَ إلى غُرْبَةً ساجيَه",59,"ي",2,0],["وَرَحمَةُ اللَّه تَترى منهُمُ أَبداً","عَلَيهِ ما كَرّتِ الآصالُ والبُكَرُ",60,"ر",1,0],["وَرَحلتَ في جَوْنِ القَتامِ عَرمرَمٍ","وَكَأنَّهُ لَيلٌ بِوَجهِكَ مُقمِرُ",61,"ر",1,0],["ورحتَ ببعضِ الرّوح فيك مودّعاً","بمؤنسة العوّادِ زُرْتَ بها اللّحدا",62,"د",2,0],["وَرُحبَ صَدرٍ لَوَ أَنَّ الأَرضَ واسِعَةٌ","كَوُسعِهِ لَم يَضِق عَن أَهلِها بَلَدُ",63,"د",1,0],["ورحْتُ خفيفَ الظهرِ عنْ منَّةِ امرئٍ","تهتَّكَ بالآثامِ وَهْوَ محجَّبُ",64,"ب",1,0],["ورحتُ أظمي وأسَقي من دمي زُمراً","راحت تُسقي أخا لؤمٍ وتُظميني",65,"ن",2,0],["ورُحْتُ أَطْفو على مَوْجَيْهِما قَلِقاً","أَكادُ أَحْسُدُ مَرْءًا فيهما غَرِقا",66,"ق",2,0],["وَرُحنَ فَبِتنَ فَوقَ البِئرِ حَتّى","بَدا لِلناظِرِ الصُبحُ البَليجُ",67,"ج",1,0],["وَرُحتُ كَأَنّي يَومَ راحَت جِمالُهُم","سُقيتُ دَمَ الحَيّاتِ حينَ اِنقَضى عُمري",68,"ر",2,0],["وَرُحنَ يُضاحِكُهُنَّ النَعيمُ","وَيَقتُلُني إِثرَهُنَّ البُكى",69,"ا",1,0],["وَرُحتُم يَهبُّ الشَرُّ مِن لَهَواتِكُم","مُدلّينَ أَن أَمسى بِكُم فاغِراً فَما",70,"م",2,0],["وَرُحتَ تَصُبُّ المالَ في غيرِ هِينَةٍ","تُريدُ بدينِ المسلمينِ الدَّواهيا",71,"ي",2,0],["وَرُحْتُ تُحابِيهم وتَشْفِي صُدورَهم","بِخرقَاءَ تستهوي الغَبِيَّ المُبَلَّدَا",72,"د",2,0],["وَرَحىً تَحتَنا وَأُخرى عَلَينا","كُلُّ مَرءٍ فيها طَحينٌ هَشيمُ",73,"م",1,0],["وَرُحتَ تَعمُرُ داراً لا بَقاءَ لها","وَأَنتَ عَنها وَإِن عُمِّرتَ مَنقُولُ",74,"ل",1,0],["وَرُحتُ بِها في زَورَقٍ قَد كَتَمتُها","وَمِن أَينَ لِلمِسكِ الذَكِيِّ كُتومُ",75,"م",1,0],["وَرُحتُ مِن عِرقِ الهَوى أُصَدّي","يا عَجَباً لِلعاجِزِ المُسَدّي",76,"د",2,0],["ورحمةُ اللَّه في الآفاقِ قد نُشرتْ","والأرضُ تُبدي تباشيراً لمبداكا",77,"ك",2,0],["ورحب الناس بالإسلام حين رأوا","أن الإخاء وأن العدل مغزاه",78,"ا",2,0],["ورحت أعاطيه الحَنان بنظرة","كما راح يرنو العابد المتخشِّع",79,"ع",1,0],["ورحيقٌ عَطِرٌ من نفحه","يثْمَل الأعداءُ قبل الأصدقاءْ",80,"ا",2,0],["ورحلةِ الصيفِ في أوربا","وسحر أيامِها الوضاءِ",81,"ا",2,0],["ورُحْنا كأنّا نَمْتَطِي أخْدَرِيَّةً","أَضَرَّ بِها رَخْوُ اللِّبانِ عَنِيفُ",82,"ف",1,0],["ورَحِيلُ عَيْشِكَ كُلَّ رِحْلةِ ساعة","وفَناءُ طِيبِكَ في الزَّمَانِ الأَطْيَبِ",83,"ب",1,0],["وَرُحْتَ مَظْلُوماً وَمَا كُنْتَ إِذْ","حَكَمْتَ بِالبَاغِي وَلاَ الطَّامِعِ",84,"ع",1,0],["وَرُحْتَ بِالمَثَلِ الأَعْلَى تُجَنِّبُنَا","أَنْ بَنْخَسَ الدُرَّ أَوْ أَنْ نُغْلِيَ الصَّدَفَا",85,"ف",2,0],["وَرَحَمْتَ نَفْسَكَ أَمْ عَصَتْكَ فَأُسْقِ","طَتْ عَنْهَا تَكَالِيفُ الجِهَادِ السَّرْمَدِ",86,"د",1,0],["وَرُحْنَا وأُخْرَانَا بِطَاءٌ كأنَّنَا","أُسُودٌ على لَحْمٍ بِبِيشةَ ظُلَّعُ",87,"ع",1,0],["وَرُح وَاِغدُ لِلعِلمِ دَأباً تَرِث","بِهِ العِزَّ وَالنَسَبَ الأَبرَكا",88,"ك",2,0],["وَرحتَ مِنها سالِماً","لَيسَ عَلَيكَ مِن دَرَك",89,"ك",1,0],["وَرُحنا بِكَاِبنِ الماءِ يُجنَبُ وَسطَنا","تُصَوَّبُ فيهِ العَينُ طَوراً وَتَرتَقي",90,"ق",2,0],["وَرُحنا بِأَشخاصٍ كَأَشجارِ أَيكَةٍ","عَوارِيَ لَم يورِق لَهُنَّ قَضيبُ",91,"ب",1,0],["ورحا الموتِ لا تني تملأ الأر","ضَ ضجيجاً وتنثر الناس طحْنَا",92,"ن",2,0],["ورَحْمَةٌ رَفّافَةٌ لم تَدَعْ","قلْباً يُوارِي النارَ في صَخْرِهِ",93,"ر",2,0],["ورحيقُ الأزهارِ كم ضمَّ من رَوْ","ضٍ شَذِيِّ الشَّميمِ في قَطَراته",94,"ت",2,0],["ورحنا كأنا نمتطي اخدرية","حليٌّ بجَنْبى ثادق وجَفيفُ",95,"ف",1,0],["ورُحْنَ ينقشن في الأمواج من صورٍ","ما ليس ينقشه الرسَّامُ بالقلم!",96,"م",1,0],["ورحت بها في زروق قد كتمتها","ومن أين للمسك الذكي كتوم",97,"م",1,0],["ورحنا نجيد سباب الدجى","ولم ندر كيف نضيء الشموع",98,"ع",1,0],["ورحلنا واللّيل في قبضة الأف","ق كتاب يروي أساطير دهر",99,"ر",1,0],["ورحيق عطر من نفحه","يمثل الأعداء قبل الأصدقاء",100,"ا",2,0],["ورُحْنَ كأسراب القطا نُعَّمَ الخُطَى","وقىَ اللهُ - من شَرٍّ يرادُ به - السِّرْبا",101,"ب",2,0],["ورُحْتُ رغَم جحودٍ عامدٍ أشرٍ","للحظِّ أُرجِعُ حالي والمقادير",102,"ر",1,0],["ورَحلْتَ خير مُودَّع عن موطنٍ","حاميتَ عنه ، وأُبتَ خيرَ إياب",103,"ب",1,0],["ورُحتُ منها على وَعدٍ بمغفرة","إنْ لم يُسدِّدْ خطايَ اليومَ شيطاني",104,"ن",2,0],["ورُحتُ أُشبِّهُ ما فاتني","من العيش بالبارق الخُلَّب",105,"ب",1,0],["ورحنا كأناً من جؤاثي عشية","ٌ