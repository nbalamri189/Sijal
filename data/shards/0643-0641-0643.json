.dctabudhabi.ae/diwan/poem/125446","الكامل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48260","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93535","الرمل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137401",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130747","البسيط"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147337","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101602","الخفيف"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143941","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112288","الرمل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76465","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32411","الكامل"],[4089,"","https://poetry.dctabudhabi.ae/diwan/poem/198743","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4790,"عيد حقيقي","https://www.poetsgate.com/ViewPoem.aspx?id=144350",""],[4854,"كَفْكِف دُمُوعَكَ يَا سُودَانُ","https://www.poetsgate.com/ViewPoem.aspx?id=216021",""],[4927,"صَبْرٌ ودُمُوْعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=29646",""],[4940,"جرح الصداقة","https://www.poetsgate.com/ViewPoem.aspx?id=210436",""],[4978,"تشطير دحنونة","https://www.poetsgate.com/ViewPoem.aspx?id=178199",""],[5000,"وردة,,,,,وحجر!.","https://www.poetsgate.com/ViewPoem.aspx?id=5820",""],[5032,"أرجوحة الحُلم","https://www.poetsgate.com/ViewPoem.aspx?id=188909",""],[5061,"ياضنيني","https://www.poetsgate.com/ViewPoem.aspx?id=147170",""],[3591,"كفكف دموعَ عيونٍ قد سفكن دماً","https://www.poetsgate.com/ViewPoem.aspx?id=149401",""],[5106,"ذَاْكَ عُذْرٌ تَاْفِهٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137255",""],[5136,"عاد عليك العيد عام فعام","https://www.poetsgate.com/ViewPoem.aspx?id=121722",""],[5136,"سيدي يا شرف الدين","https://www.poetsgate.com/ViewPoem.aspx?id=121936",""],[5152,"رجع الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=184335",""],[5212,"قُطبُ العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=212032",""],[5219,"لوعة الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=194342",""],[5219,"تاهت حروفي","https://www.poetsgate.com/ViewPoem.aspx?id=194907",""],[5254,"جرح العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=207814",""],[5268,"المَوتُ والحرِّيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=206993",""],[5321,"شَرَّك غَدَى","https://www.poetsgate.com/ViewPoem.aspx?id=152742",""],[5324,"أغمد حسامك وارتحل ياعنترة .","https://www.poetsgate.com/ViewPoem.aspx?id=207628",""],[5376,"كفْكفِ الدمعَ الذي ينتابُني","https://www.poetsgate.com/ViewPoem.aspx?id=194867",""],[5431,"كفكف دموعك لن تُراق وتهدرا","https://www.poetsgate.com/ViewPoem.aspx?id=192199",""],[5431,"وأفضل الفعل حب الله والناس","https://www.poetsgate.com/ViewPoem.aspx?id=194507",""],[5436,"بغداد .. يا مجد هارون ( علي محمد السليم )","https://www.poetsgate.com/ViewPoem.aspx?id=46675",""],[5612,"حلم العمر","https://www.poetsgate.com/ViewPoem.aspx?id=198379",""],[5625,"لامية القدس","https://www.poetsgate.com/ViewPoem.aspx?id=183065",""],[5660,"مَن لَم يُعَزِّز عِشقَهُنَّ ذَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=23711",""],[5674,"الدروب تخونني","https://www.poetsgate.com/ViewPoem.aspx?id=189654",""],[5725,"كفكف جراحك","https://www.poetsgate.com/ViewPoem.aspx?id=177487",""],[5742,"بيت السبحية","https://www.poetsgate.com/ViewPoem.aspx?id=206895",""],[5742,"سلوة الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=207145",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[5829,"كفكف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=162453",""],[5831,"سجدة كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=20398",""],[5842,"إشراقات الأمل / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[5887,"كفكف الدمع أنت على الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=37214",""],[5895,"قد أتت سلوى","https://www.poetsgate.com/ViewPoem.aspx?id=214162",""],[5943,"كفكف دموعكَ","https://www.poetsgate.com/ViewPoem.aspx?id=11276",""],[5944,"أيها الناي","https://www.poetsgate.com/ViewPoem.aspx?id=212711",""],[5952,"كفكف الدمعات","https://www.poetsgate.com/ViewPoem.aspx?id=203111",""],[5977,"كفكف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=213072",""],[6003,"كفكف دموعك !!!","https://www.poetsgate.com/ViewPoem.aspx?id=188924",""],[6056,"حمامة الأفكار","https://www.poetsgate.com/ViewPoem.aspx?id=130504",""],[6102,"نَدَم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185209",""],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""]],"verses":[["كَفكِف يَدَيكَ عَنِ النَوالِ وَبذلِهِ","حتَّى أكَفْكِفَ مِقْوَلِي أن يمدحا",0,"ح",2,0],["كَفكَفتُ دَمعي في الرِداءِ تَخالَهُ","كَالدُرِّ إِن قارَنتَهُ بِجُمانِ",1,"ن",1,0],["كَفكَفَ الباكونَ مِن أَدمُعِهِم","فَبَكَتهُم أُمَّهاتُ المُؤمِنينْ",2,"ن",1,0],["كَفكِفوا جودَكُم وَرُدّوا عَلَينا","ما سَلَبتُم غُلُبَّةً وَاِغتِيالا",3,"ل",2,0],["كَفْكِفْ دموعَكَ ليس ين","فَعُكَ البكاءُ ولا العويل",4,"ل",1,1],["كفكَفَ الغيمُ دمعَه فأرانا","زَهر الأقحوان والنَّمَّام",5,"م",1,0],["كَفكِف دموعًا على الأمواتِ تَذرفُها","يا صاح، وابكِ معي في مأتم الخلق",6,"ق",1,0],["كف كنّا ندعوه مولى مطاعا","وهو \" للإنجليز \" أطوع خادم",7,"م",1,0],["كفكرة .. جناحها أحمر","كجملة قيلت ولم تفهم",8,"م",1,0],["كَفْكِفا دَمْعي وقُولا لي كَفى","سامَحَ اللهُ فُؤادي وعَفا",9,"ف",2,1],["كَفْكَفَتْ دَمْعي وأقْصَتْ شَجَني","غِبْطَةٌ داوَتْ طِعانَ النّدمِ",10,"م",1,0],["كفكفت دمعها وكفكفت دمعي","وسألت العذراء عما دهاها",11,"ا",3,0],["كفكف الدمع فما","أثمن دمع البؤساء",12,"ا",2,0],["كَفكِف بربّك دمعكَ الهتّانا","وافرَح وهنّىء قلبكَ الولهانا",13,"ن",2,1],["كفكفي يا اخت دمعاً حائراً","ان في الدنيا سواكِ بؤساء",14,"ا",2,0],["كَفْكِفِ الدَّمعَ، واطرد اليأسَ حتى","لا ترى منه أسْهُماً ورِهَابا",15,"ب",2,0],["كفكف الدمعَ ما استطعت فإنِّي","لست أسطيع للمدامع ردَّا",16,"د",2,0],["كفكف القول ما استطعت فقد تؤ","ذنُ بالسُّكْر كثرةُ الاطْرابِ",17,"ب",1,0],["كَفْكَفَهُ الشَّوقُ فَكفَّ طَرفهُ","لِذَنْبهِ وقالَ حبَّاهُ اصْفَحِ",18,"ح",1,0],["كفكفِ الدمعَ يا أباهُ فهذا","ما قضى حكمُ ربِّكَ المتعالي",19,"ل",2,0],["كفكف دموعك أيها الوطن العز","يز ولا تسل منها على الأثواب",20,"ب",1,0],["كفك بالجود غدت صبة","تزوي بصوب الواكف الواجس",21,"س",1,0],["كفكف الدمع ساعة واستمع ما","قاله في رئيسك الراثونا",22,"ن",2,0],["كفكفوا الدمع فما يجدى وهل","فيه للراحل عود من غياب",23,"ب",1,0],["كفكفا عن حشايَ غرب ملامي","من جراح الجوى بها ما كفاني",24,"ن",2,0],["كَ فكيف يهنأُ بعد فقد رجائهِ","لبيك اني مثلما شاءَ القضا",25,"ض",2,0],["كفكفتِ بالكفِّ الجميلةِ أدمعي","وبنظرةٍ أطفأتِ نارَ غرامي",26,"م",2,0],["كفكفوا الدمع وضنوا بالأنين","واغضبوا للشمس والحق المبين",27,"ن",1,1],["كفكفتُ دمعكِ مِمَّا أنتِ شاكيةٌ","من البعادِ وما أدراكِ أدراكِ",28,"ك",1,0],["كَفكَفَت مِن دُموعِها وَاِستَعَدَّت","لِنَوالِ المُنى وَعَيش رَغيدِ",29,"د",1,0],["كَفكفي الأَدمُع يا عَين العُلى","فَأَبو الهادي عَن المَهديّ نابا",30,"ب",2,0],["كفك البحر لا يساويه جودا","وبه الغيث في الندى لا يقاس",31,"س",1,0],["كفكف دموعك فالدنيا لها الثكلُ","لم تصف يوماً لمن يسمو به الأملُ",32,"ل",1,1],["كَفْكِفْ دُخَانَ الوَهمِ فِي قِيثَارةٍ","مِنْ لَحْنِهَا تَحْيَا بِقَلْبٍ يَعْشَقُ",33,"ق",1,0],["كفكفي السيل إنه في دموعي","من عيوني يتدفّق",34,"ق",1,0],["كفكف قسيك يا فراق فإنه","لم يبق في قلبي لسهمك موضع",35,"ع",1,0],["كفكفي الدمعَ فما هذا الشّحوب","في مُحَيّاً كان لا يدري السَّقام",36,"م",1,0],["كفكفي دَمع الكلاب","واِمسَحي دمع الحَمير",37,"ر",1,0],["كفكرٍ يجوب الشرق والغرب طارقاً","بلاداً وفيه ذكر تلك المطارق",38,"ق",1,0],["كَفكِف دُموعَكَ أَن تَفي","ضَ بِناظِرٍ غَرِقَ بِمائِهِ",39,"ا",3,0],["كفٌّ كريمٌ فبحر الجودِ صنعته","ما غيّر الطبع لا مال ولا جاهُ",40,"ا",2,0],["كف كف الكفار كفا بكف","فاه فيه مسبح الحصباء",41,"ا",2,0],["كَفْكِفْ دموعَكَ يا عيدي فَقَدْ قَدِمَتْ","أنثايَ تَرْفُلُ في زي الأناشيدِ",42,"د",1,0],["كَفكِفْ دُمُوعَكَ وَاكتُمْ حَرَّةَ الأَلَمِ","يَا وَيحَ قَلبٍ عَلَى الآلَامِ مُنْكَتِمِ",43,"م",1,1],["كَفكِفْ دُمُوعَكَ يَا سُودَانُ إِنْ ذَرَفَتْ","مَا هَبَّ فِي العُربِ مِنْجَادٌ كَمُعتَصِمِ",43,"م",1,0],["كَفْكِفْ دُمُوْعَكَº فَالْفِرَاْقُ طَوِيْلُ","وَاصْبِرْº فَإِنَّكَ قُدْوَةٌº وَدَلِيْلُ",44,"ل",1,1],["كفكف دموعك يا زمان أفي النوى","هل لا يزال يئن فيك طريقُ؟!",45,"ق",1,0],["( كفكفت عن خدي الدموع هنيهةً )","وقطفت من حُمر الخدود نضارا",46,"ر",2,0],["كَفْكِفِ الدَّمعَ ووَدِّعْ مَنْ هجَرْ","واطوِ عهدًا خانَه قلبٌ غَدَرْ",47,"ر",1,1],["كَفْكفْ دُمُوعِكَ واحْلَمْ غَيْرَهُ، أ تَرى","هذا؟ومُفْتَرسُ الاحْلامِ لا يَدَعُ",48,"ع",1,0],["كفك علاج الجرح يومن تطبه","في وسط كفي والوله يشتويني",49,"ن",2,0],["كفكف دموعَ عيونٍ قد سفكن دماً","دنالى السرور وجيش اتلهم قد هزما",50,"م",2,1],["كَفْكَفِ الدَّمْعَ وَخَلِّيْ عِطْرَهَاْ ذِكْرَىْ لِأُنْسٍ","فَعَسَاْهَاْ مَكَّةً تَبْدُوْ .. فَنَأتِيْهَاْ اعْتِمَاْرَاْ",51,"ر",2,0],["كفك مزن برق صادق","بالثج إذ ما كان برق جهام",52,"م",1,0],["كفك الأبيض مثل","الحجر الأسود يلثم",53,"م",1,0],["كفك الفياض أضحى","من غوادي السحب أكرم",53,"م",1,0],["كَفْكِفْ مدادَك قد أوجعتَ أدوائي","واستنطقَ الحزنُ إِسْرَاري وَإِغْضَائِي",54,"ا",3,1],["كَفْكِفْ دُموعَكَ وانحَني بِرَجائِهِ","تَسأَلهُ عُذْراً لِلزِّيارَةِ مَنْ ضَعُفْ",55,"ف",1,0],["كفكف دموعا قد همت","من هجر خل قد سباك",56,"ك",1,0],["كفكف دموعك لا ترم .","وصلا ولا تطلب رجاء",57,"ا",2,0],["كفكف أمانيك إن العز قد هربا","والصبح منتحب والذل قد نصبا",58,"ب",2,1],["كفكفْ دموعَكَ قد وُلِدتَ بدولةٍ","فيها تآخى الموتُ بالحريَّةْ",59,"ي",2,0],["كفّك نداه أزرَى بهمّال الأمزان","كم روضةٍ بالقاع كفّك سببها",60,"ب",3,0],["كفكف دموعَك ..ليس ينفعُ نعيّهم","فلقد أتيتَ بليلةٍ متأخرة",61,"ر",2,0],["كفْكفِ الدمعَ الذي ينتابُني","نَزَفَ الدمعُ بعيني كالدِّمَا",62,"م",2,1],["كفكف دموعك لن تُراق وتهدرا","أرض الفرات كريمة مهما جرى",63,"ر",2,0],["كفكف دموعك واشرب فيض احساسي","إني وهبتك حبا دون مقياس",64,"س",1,1],["كفكف دموعك هذا الحزن يقتلني","وحرقة الدمع قد طاحت بأنفاسي",64,"س",2,0],["كفكف دموعك إنّ الحب تضحية","لمذبح الحب قد هيأت قُداسي",64,"س",2,0],["كفْكفْ دموعك َ \"عبد َالواحد ِ\" انهملتْ","(دمع ٌ لبغداد َدمع ٌ بالملايين) (6