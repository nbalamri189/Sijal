{"poems":[[110,"أخا الريم ما هذي العيون القواتل","https://www.aldiwan.net/poem16325.html","الطويل"],[161,"إذا لم يكن للصب من هجركم بد","https://www.aldiwan.net/poem58830.html","الطويل"],[236,"أترضون يا أهل بغداذ لي","https://www.aldiwan.net/poem32092.html","المتقارب"],[276,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[283,"يا راكب الناقة الوجناء يزجيها","https://www.aldiwan.net/poem32302.html","البسيط"],[304,"لقد خضبت كفها أحمرا","https://www.aldiwan.net/poem58064.html","المتقارب"],[378,"ألا يا أيها الخل الوفي","https://www.aldiwan.net/poem59168.html","الوافر"],[417,"إلى إحسان مولانا الرفاعي","https://www.aldiwan.net/poem54178.html","الوافر"],[459,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[465,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[469,"ما القاش إلا فلك","https://www.aldiwan.net/poem59668.html","مجزوء الرجز"]],"verses":[["فَماء حَياة ما تَحوز مَراشف","وَرَوضة حُسن ما تَضُم الغَلائِلُ",0,"ل",1,0],["فماء دموعي موقدٌ نارَ لوعتي","إذا رمتُ أطفيها به اضطرم الوقدُ",1,"د",1,0],["فَماءُ السَماحِ بِها لا يَغيضُ","وَريحُ المَكارِمِ لا تَركُدُ",2,"د",1,0],["فَماءُ حديدِهِ لهُمُ طَهُورٌ","يُصَبُّ عَلَيهِمُ بِيَد الطَّهورِ",3,"ر",1,0],["فَماءُ كانونَ في سَلسالِ رَبوَتِها","تُطفي بِهِ نارَ آبٍ حينَ تحميها",4,"ي",3,0],["فماء الشباب بذا ما زوى","وجمر الخضاب بذا ما انطفى",5,"ف",2,0],["فماء الشرع إن روَّى عَدِيّاً","فلم ينجُمْ به أصلٌ دعي",6,"ي",1,0],["فماء زلاله يروي غليلي","وروضي إن تنكرت المراعي",7,"ع",2,0],["فماءُ الندَى عَذبُ اللِّصابِ مُرَقْرَقٌ","وغصنُ المُنَى وَحْفُ النباتِ رطيبُ",8,"ب",1,0],["فماء الجود والنعمى نمير","وظل العدل والزلفى ظليل",9,"ل",1,0],["فَماءُ وَردي قَطرُهُ","وَعَنبَري نَسيمُهُ",10,"م",2,0]]}