{"poems":[[113,"أخا الريم ما هذي العيون القواتل","https://www.aldiwan.net/poem16325.html","الطويل"],[164,"إذا لم يكن للصب من هجركم بد","https://www.aldiwan.net/poem58830.html","الطويل"],[240,"أترضون يا أهل بغداذ لي","https://www.aldiwan.net/poem32092.html","المتقارب"],[280,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[287,"يا راكب الناقة الوجناء يزجيها","https://www.aldiwan.net/poem32302.html","البسيط"],[308,"لقد خضبت كفها أحمرا","https://www.aldiwan.net/poem58064.html","المتقارب"],[382,"ألا يا أيها الخل الوفي","https://www.aldiwan.net/poem59168.html","الوافر"],[422,"إلى إحسان مولانا الرفاعي","https://www.aldiwan.net/poem54178.html","الوافر"],[463,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[469,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[473,"ما القاش إلا فلك","https://www.aldiwan.net/poem59668.html","مجزوء الرجز"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19951","الطويل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79474","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49041","الطويل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105861","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132281","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132282","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115422","البسيط"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121390","الطويل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141544","الوافر"],[4679,"بذكراك لا ذكرى حبيبٍ ومنزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142719",""],[4984,"بكائية .. جدارية 04","https://www.poetsgate.com/ViewPoem.aspx?id=186856",""],[5338,"غفا في عينك الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=187946",""]],"verses":[["فَماء حَياة ما تَحوز مَراشف","وَرَوضة حُسن ما تَضُم الغَلائِلُ",0,"ل",1,0],["فماء دموعي موقدٌ نارَ لوعتي","إذا رمتُ أطفيها به اضطرم الوقدُ",1,"د",1,0],["فَماءُ السَماحِ بِها لا يَغيضُ","وَريحُ المَكارِمِ لا تَركُدُ",2,"د",1,0],["فَماءُ حديدِهِ لهُمُ طَهُورٌ","يُصَبُّ عَلَيهِمُ بِيَد الطَّهورِ",3,"ر",1,0],["فَماءُ كانونَ في سَلسالِ رَبوَتِها","تُطفي بِهِ نارَ آبٍ حينَ تحميها",4,"ي",3,0],["فماء الشباب بذا ما زوى","وجمر الخضاب بذا ما انطفى",5,"ف",2,0],["فماء الشرع إن روَّى عَدِيّاً","فلم ينجُمْ به أصلٌ دعي",6,"ي",1,0],["فماء زلاله يروي غليلي","وروضي إن تنكرت المراعي",7,"ع",2,0],["فماءُ الندَى عَذبُ اللِّصابِ مُرَقْرَقٌ","وغصنُ المُنَى وَحْفُ النباتِ رطيبُ",8,"ب",1,0],["فماء الجود والنعمى نمير","وظل العدل والزلفى ظليل",9,"ل",1,0],["فَماءُ وَردي قَطرُهُ","وَعَنبَري نَسيمُهُ",10,"م",2,0],["فَماءٌ بِلا مَرعى وَمَرعى بِغَيرِ ما","وَحَيثُ أَرى ماءَ وَمَرعىً فَمَسبَعا",11,"ع",2,0],["فماءُ عيشي كَدِرٌ","ونجمُ حالي مُنْكدِرْ",12,"ر",1,0],["فماءٌ يزيلُ السُّقمَ والماءُ باردٌ","وخمرٌ تعادي الهمّ والخمرةُ الحب",13,"ب",1,0],["فماءُ ثَنائِكَ العالي سَقاهُ","ومِن أَخلاقِكَ العُليا تَفَطَّر",14,"ر",1,0],["فماء العينين مولاه اجتباه","له قد آذن الملك السلام",15,"م",1,0],["فماء ولا ملح ولطف ولا هوى","وعلم ولا لد وسيف مصمّم",16,"م",1,0],["فماءُ عيني جرى من ماء وجنتها","ونارُ قلبي عدت من وقدها دائي",17,"ا",2,0],["فماءٌ بلا مرعىً ومرعىً بغيرِ ما","وحيثُ ترى ماءً ومرعىً فَمَسبَعُ",18,"ع",1,0],["فماء نظافة الإنجاء فيه","تقدمت الشمال على اليمين",19,"ن",1,0],["فماء زلال ينعش القلب ورده","به لذوي الأسقام أعذب منهل",20,"ل",1,0],["فَمَاءُ الْمَدِينَةِ عَذْبٌ وَقَدْ","رَضِينَا مِنَ الحَظِّ بِالعَافِيَّه",21,"ف",3,0],["فَمَاءُ الْعَيْنِ يَنْبَثقُ","وَنَارُ الشَّوْقِ تَحْتَرِقُ",22,"ق",1,0]]}