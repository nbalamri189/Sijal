{"poems":[[325,"والله ذي القدر العظيم ومن به","https://www.aldiwan.net/poem61776.html","الطويل"],[534,"مولاي ذا الكرامه","https://www.aldiwan.net/poem37163.html","منهوك المنسرح"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10411","المنسرح"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133155","المجتث"],[5282,"مناجاة وتفكر","https://www.poetsgate.com/ViewPoem.aspx?id=214033",""],[5720,"تَطفِيْف","https://www.poetsgate.com/ViewPoem.aspx?id=208516",""],[5956,"لَمْ أشبع منك ولن أشبعْ","https://www.poetsgate.com/ViewPoem.aspx?id=206807",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""]],"verses":[["وَاللَهُ ذي القَدرِ العَظيمِ وَمَن بِهِ","يَنجو المُصَدِّقَ مِن شَفيرِ الهاوِيَةِ",0,"ه",1,1],["واللهُ ذو الجَلالِ","يَحْفَظُ رَأْسَ الآلِ",1,"ل",1,0],["والله ذو النعمة والآلاء","يمتحن العباد بالبلاء",2,"ا",2,0],["وَاللَهِ ذي المَسجِدِ الحَرامِ وَما","جُلِّلَ مِن يُمنَةٍ لَها خُنُفُ",3,"ف",1,0],["والله ذكره فشا","لدى جميع الأنام",4,"م",1,0],["واللهُ ذُو العَرشِ يَرْعَاكُمْ برحْمَتِهِ","وقد أحَاطَ بما دَقَّتْ خَفاياهُ",5,"ا",2,0],["واللهُ ذو المنِّ كم من حاجةٍ صَعَدَتْ","إليهِ من سائلٍ قد قامَ في الَّليْلِ",6,"ل",1,0],["واللهِ ذهابي وإيابي","لا يتركني أتمتّعْ",7,"ع",1,0],["واللهِ ذا الحرمانُ أَولى يعتري","نفسَ الألَى أمروا به بُهتانا..",8,"ن",2,0],["و(َاللهُ) ذُو عَفوٍ، خَزائنُهُ","تَفِيضُ بِالغُفرانِ وَالكَرَمِ",9,"م",1,0]]}