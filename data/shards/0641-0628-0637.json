{"poems":[[74,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[68,"لم تخل منك خواطري ونواظري","https://www.aldiwan.net/poem40321.html","الكامل"],[76,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[50,"وفتية ساعة قد اجتمعوا","https://www.aldiwan.net/poem66260.html","المنسرح"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[119,"روض قد لألأ عسجده","https://www.aldiwan.net/poem41165.html","عموديه"],[244,"بمحمد صلوا عليه وسلموا","https://www.aldiwan.net/poem23835.html","الكامل"],[287,"امدد إلي يدا يعتادها الكرم","https://www.aldiwan.net/poem32458.html","البسيط"],[325,"هات اسقني من رائق الصهباء","https://www.aldiwan.net/poem67192.html","الكامل"],[460,"جاد الربيع بشوطى رسم منزلة","https://www.aldiwan.net/poem26639.html","البسيط"],[466,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[563,"أيها القوم السكارى","https://www.aldiwan.net/poem33840.html","مجزوء الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77482","الرجز"],[955,"","https://poetry.dctabudhabi.ae/diwan/poem/34999","الكامل"],[2085,"","https://poetry.dctabudhabi.ae/diwan/poem/202205","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53078","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27414","السريع"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120163","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97097","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204218","المتقارب"],[4815,"قبابُ الهَوى","https://www.poetsgate.com/ViewPoem.aspx?id=210628",""],[4858,"المرء بين الهوى والرّضا","https://www.poetsgate.com/ViewPoem.aspx?id=139676",""]],"verses":[["فبطنيَ شبعانٌ وظهري كأنه","لسانيَ ما بين البريَّة داف",0,"ف",1,0],["فَبِطيبِ ذِكرٍ مِنكَ تَبدَأُ يَقظَتي","وَبِشَخصِ طَيفِكَ تُختَمُ الأَحلامُ",1,"م",1,0],["فَبِطيبِ تُربِكَ أَيُّ بَيتِ قَصيدَةٍ","لَو أَنَّ ذاكَ البَيتَ كانَ يُعادُ",2,"د",1,0],["فبطّأت بي عن لذّتي تككٌ","ثم لطَفنا بحل ما عقدوا",3,"د",3,0],["فَبَطنُ السُلَيِّ فَالسِخالُ تَعَذَّرَت","فَمَعقُلَةٌ إِلى مُطارٍ فَواحِفُ",4,"ف",1,0],["فبطرته وبغرّته","ليل قد لألأ فرقده",5,"د",2,0],["فبطيبة انبَثَقَ الضيا متألقاً","لمع الخليج به وضاءَ القلزم",6,"م",1,0],["فَبَطنُها حَجَرُ الأَسباطِ مُنبَجِساً","وَظَهرُها حَجَرُ الإِسلامِ يُستَلَمُ",7,"م",1,0],["فَبِطولِهِ وَبِفَضلِهِ لا غَروَ أَن","وَحَّدَت فيهِ مَوَدَّتي وَإِخائي",8,"ا",2,0],["فَبَطنَ خاخَ فَأَجزاعَ العَقيقِ لِما","نَهوى وَمِن جَوِّ ذي عِبرَينِ أَهضاما",9,"م",2,0],["فبطاءُ خيلِ الطَّالبينَ سَريعةٌ","وسِراعُ خيلِ الهاربينَ بِطاءُ",10,"ا",2,0],["فبطون من ظهور","وظهور من بطون",11,"ن",1,0],["فَبَطشَ السَبع بِهنّ بَغته","وَوَضَع اللَحمة فَوقَ الفتّه",12,"ه",1,0],["فَبَطَحنَ مَيمونَ العَذابِ لِوَجهِهِ","وَتَرَكنَهُ مُتَقَطِّعَ الأَوداجِ",13,"ج",1,0],["فبطن منى أمسى كأن لم يكن به","مضاض ومن حيي عدي عمائر",14,"ر",1,0],["فبطشك إن تراخى عن أناس","فكم خلد له فيه خلود",15,"د",1,0],["فبطشه الأقوى على عزِّه","ينزل في الشدّة عن بطشي",16,"ش",2,0],["فبطبه سالت عليك مدامع","وبطبه انشقت عليك قلوب",17,"ب",1,0],["فَبِطَلقتَينِ تَبينُ مِن زَوجٍ لَها","لا رَدَّ إِلّا بَعدَ زَوجٍ ثاني",18,"ن",2,0],["فَبَطَشَ الغُلمانُ بالغُلمانِ","وَفَتَكَ الفُرسانُ بالفُرسانِ",19,"ن",1,0],["فبطيبةٍ وثرى الغري وكربلا","قد غيبت منكم شموس الدين",20,"ن",1,0],["فبطن الحصان وظهر الحصان","عليَّ بما قلته يشهدان",21,"ن",1,0],["فَبَطَحتُ دَمعِي في ثَرَاكَ مَحبَّةً","حتَّى تمكَّنَ مِنْ خُطايَ وَ شَلَّني",22,"ن",2,0],["فبطونُ حيتان البحار قرارُنا","لا حوت يونُسَ إذ رعى مَن قد حوى",23,"ا",1,0]]}