عليك الاستعباد",2,"د",1,0],["وأستعيذُ اللّه من عاذلٍ","فيه ضعيفِ العقلِ والعَقْدِ",3,"د",1,0],["واستَعِنْ في حاجتي واندبْ لها","من به رَاقَتْ على الناس عَتودُ",4,"د",1,0],["واستعْجَمتْ لكنَّها","كَتَبتْ إليك بلا رُسوم",5,"م",1,0],["وَاِستَعذَبوا الماءَ المُسَلسَلَ بَعدَما","نَضَبَ الغَديرُ وَجَفَّ ماءُ المَشرَعِ",6,"ع",1,0],["واستعرضَ الفنُّ الجبالَ","فكنتَ أنتَ الأحسنا",7,"ن",2,0],["وَاِستَعجَلو المَوتَ بِالعَذابِ","وَكُلُّهُم صائِرٌ إِلَيهِ",8,"ه",1,0],["وَاِستَعَرتُ التَهليلَ مِن جَدوَلِ الوا","دي وَضَحِكَ الرُضى مِنَ الغُدرانِ",9,"ن",1,0],["وَأَستَعمِلُ الكُحلَ الَّذي فيهِ حِدَّةٌ","وَأوهِمُ أَنَّ الدَمعَ مِن حِدَّةِ الكُحلِ",10,"ل",1,0],["واستعرضي الخيل ومدّى الع","يد بالجحفل فالجحفل",11,"ل",1,0],["وَاِستَعَدَّ الطَيرُ وَالوَحشُ لِذاك","في اِنتِظارِ السَيِّدِ العالي هُناك",12,"ك",1,0],["وَاِستَعيروا لِنَعشِهِ مِن ذُرى المِن","بَرِ عوداً وَمِن شَريفِ القَوائِم",13,"م",1,0],["وَاِستَعِر رُضوانَ عودَي قَصَبٍ","وَتَرَنَّم بِالقَوافي في القَصَب",14,"ب",1,0],["وَاِستَعيروها جَناحاً طالَما","شَغَفَ الصَبَّ وَشاقَ المُستَهاما",15,"م",2,0],["وَاِستَعدَّ العُبّادُ لِلمَولِدِ الأَك","بَرِ وَاِزَّيَّنَت لَهُ الغَبراءُ",16,"ا",2,0],["وَاِستَعارَ الحَديدُ لَوناً وَأَلقى","لَونَهُ في ذَوائِبِ الأَطفالِ",17,"ل",1,0],["واستعن في العلم والأع","مالِ بالصبرِ الجميلِ",18,"ل",1,0],["واستَعصَموا بِذُرى أَشَمَّ كَأَنَّهُم","عُصْمٌ أُتيحَ لَها هِزَبرٌ قَسْوَرُ",19,"ر",1,0],["واستَعذَبته المُعضلاتُ لأنّها","مستهدفاتُ مقاتِلِ الأمجادِ",20,"د",1,0],["وَاِستَعذَبوا الأَحزانَ حَتّى إِنَّهُم","يَتَحاسَدونَ مَضاضَةَ الأَحزانِ",21,"ن",1,0],["واسْتَعِدِّي وَاجْمعِي أهلَ القُرَى","لا تُبالي بالقُلوبِ النَّافِرَهْ",22,"ر",2,0],["واستعينوا بالأُلى سنُّوا العُلا","لبني الدنيا وهزّوا الخافقيْنْ",23,"ن",1,0],["واستعظَمَتْ ما لم يُخلِّدْ مثلَهُ","سابورُهَا قِدْماً ولا ساسانُها",24,"ن",3,0],["وَاِستَعارَت صِحَّةً أَجسامُنا","وَاِستَعانَت بِمَوداتٍ مِراضِ",25,"ض",1,0],["وأستعيض بسيري","عن البقاع بقاعا",26,"ع",2,0],["واستعرضي حورَ الجنانِ وأطلقي","لغة السماء وألهمي الشعراءَ",27,"ا",2,0],["وَاسْتَعْبَدَتْ لَكِ يَا مليكَةُ مَعْشَراً","حُرّاً يَشِقُّ عَلَيْه الاسْتِعْبَادُ",28,"د",1,0],["وَاسْتَعضْنَا مِنَ الْعُيُونِ بآثَا","رٍ فَلِلَّهِ مَا جَنَاهُ الْحِمَامُ",29,"م",1,0],["واستَعادَتْ حُسْن الشَّبَابِ وَكَانَتْ","رَمَقاً بَيْنَ كَبْرَةٍ وَزَمَانَهْ",30,"ن",2,0],["واستعجم القيد حين جابهه","بحجة كالصباح تبتدره",31,"ر",2,0],["واسْتَعزّتْ بِطلْعةِ المَلِكِ الفَا","رُوقِن زَيْنِ الحِمَى وَفخْرِ الحُمَاةِ",32,"ه",1,0],["واستَعضنا عن شبلِ غابٍ بشبلٍ","ليرى النَّاسُ كثرةَ الأشبال",33,"ل",1,0],["وأسَتْ عميقَ جِراحِها. إني أرى","أَكبادَها تشكو عميقَ جراح!",34,"ح",1,0],["واستعدي الاجناد من طاعة","الله فقد عزك النصير سواها",35,"ا",3,0],["واستعرضي زمر الأشعّة واسبحي","فيها بناظرك الكحيل الأحور",36,"ر",1,0],["واستعرضِ الأيامَ حافةً","مكتظَّةً بِتَبايُنِ الصُّوَر",37,"ر",1,0],["واستعيني بشاعر وأديب","وأزيحي عمَّا تَرينَ القِناعا",38,"ع",2,0],["وأستعطف التاريخ ضنّا بأمّتي","ليمحو ما أجزى به لا ليكتبا",39,"ب",2,0],["واستعرض القوم في بد فقنعهم","بمرط حنق بخيط الدهش منجدل",40,"ل",1,0],["واستعجلت بخطى العنّابِ مسرعة","والعود ينشدها رفقاً وإحسانا",41,"ن",2,0],["وأستعيضُ يداً تغني إشارتها","فإن بدا مشكل قامت تفسرهُ",42,"ر",2,0],["واستعذب الدأبَ في استيضاحِ غامضها","كأنه عنده ضرْب من الضرَبِ",43,"ب",1,0],["واستعطفته روادفٌ","كُثبانها نِعمَ المِهادُ",44,"د",1,0],["واستعذبوا ظلمى فمن أجلهم","أستغفر اللهَ لمن يظلِمُ",45,"م",1,0],["وَاِستَعانوا بِنُصرَةِ الرومِ وَالرَو","مُ هَباءٌ تَسفيهِ هَذي السَوافي",46,"ف",2,0],["وَاِستَعصِمُوا بِرِضائي وَاِحذَرُوا سَخَطي","فَجَرحُ مِثلي في أَمثالِكُم هَدَرُ",47,"ر",1,0],["واستعبرت أن رأتني تحت داهية","من الزمان بلا مال ولا خول",48,"ل",1,0],["واستعصمونا بالتقى بعد النهى","أين النهى من مخرج متحرّج",49,"ج",1,0],["واستعارَ الزمانُ ايامَ ذاكَ الأُ","نسِ والدهرُ لا يردُ العواري",50,"ر",2,0],["واستعمل الرفق تجد رفيقاً","ولا تجد لأحمق صديقاً",51,"ق",2,0],["وَاِستَعيدي بهِ هَوىً وَشَباباً","نيلك العَذبُ غَير بردونِيّا",52,"ي",2,0],["واستعِمِل الفِكَر في أُمٍّ يكون لها","نَجِلٌ وليس لها ثَدْيٌ ولا رَحِمُ",53,"م",1,0],["وَاِستعلنَ الحَقّ المُبين بِنورِهِ","بَينَ الجِبالِ الشُّمِّ مِن فارانِ",54,"ن",1,0],["وَاِستَعطِفوا الريحَ عَلَّ الريح حامِلَة","إِلى المُتَيَّمِ مِن أَكنافِكُم خَبَرا",55,"ر",2,0],["وَاِستَعِذ مِن أَوجُهٍ بِال","لُؤمِ وَالغَدرِ صِفاقِ",56,"ق",1,0],["وَاِستَعمِلوا عادَةَ الصَفحِ الَّتي شَهِدَ ال","بادونَ فيها لَكُم بِالفَضلِ وَالحَضَرُ",57,"ر",1,0],["واستعذ من هواك والنفس تقوى ال","روح بالله ربّنا المستعاذ",58,"ذ",1,0],["واستعطف البرق اليماني هل الى","تحمل اشواقي لهن سبيل",59,"ل",1,0],["واستعبر الطرف بعده فحكى","بذائب الدر جامد البرد",60,"د",1,0],["واستعمرت أقصى البلادِ ومهّدَت","سُبُلَ الحضارةِ والغنى بأدلّة",61,"ه",1,0],["واستَعذبِنَّ المنايا وامشينَّ على","ميَّادةِ الأرضِ أو خفاقةِ النجم",62,"م",1,0],["واِستَعطفوني بعذر","ان كان عذر يفيد",63,"د",1,0],["واستعذ بي غصص التَعذيب راضية","وَحكمى الحب علّ الحب يَرعاك",64,"ك",1,0],["وَاستَعينك يا فردا الجَلال عَلى","دهر يُحاول بعد الربح خسراني",65,"ن",2,0],["واسْتَعْلِ وَابْقَ فَما لِراجٍ مُنْيَةٌ","إِلا بَقاؤُكَ لِلْعُلى وَبَقاؤُهُ",66,"ا",3,0],["وَاِستَعظَمَ الأَخبارَ عَنكَ مَعاشِرٌ","فَاِستَصغَروا ما اِستَعظَموا بِالمَخبَرِ",67,"ر",1,0],["واِستعجلَت شدَّ النِطاق وودعت","توديعَ مختلسٍ بحَيرةِ مُبلِسِ",68,"س",1,0],["واستعطف الأحباب كيما يعطفوا","فهم هم أهل المكارم والثنا",69,"ن",2,0],["وَاِستَعادَ الثَنا لِأَبناءِ مِصرَ","وَأَفادَ المَلا بِغَيرِ مَلالَه",70,"ل",2,0],["وَاِستَعرَبَ المُعجَمُ فينا لِدا","زالَ العَمى وَاِندَمَلَ الجَراحُ",71,"ح",1,0],["واستَعبدَتْ نَفْسي فضا","ئلُه وعَبدُ الفضلِ حُرّ",72,"ر",1,0],["واستعرت اسمَهُ على ما أقاسي","هِ فصرتُ المؤيَّد المَنصورا",73,"ر",2,0],["واستعجل ابنُ هندٍ موتَهُ","فسَقَاه كأساً لِلْمنَيةِ أعفرا",74,"ر",2,0],["واستعمل الإنصاف إن كنت قد","حزت السويداء وحللت السواد",75,"د",1,0],["واستعظم الصبر وجدي حين باعدني","وسام للقلب سلوانا فما عطفا",76,"ف",2,0],["واستعملي الرفق في تعذيب ذي شجن","بغير طلعتك الزهراء لم يهم",77,"م",1,0],["واستعبرَتْ مُقلُ الغَمام فأضحكتْ","منها ثغورَ مفوّفٍ ومدبّجِ",78,"ج",1,0],["واستعْذَبَ العذْلَ لذكراهُمُ","وكان لا يعرِفُ نِسيانا",79,"ن",2,0],["واستعصمَتْ بمعاقِلٍ قَدْ أَصبَحَتْ","لِلْحَيْنِ وهي ق