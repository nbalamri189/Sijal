{"poems":[[55,"لقاؤك جر علي الفراقا","https://www.aldiwan.net/poem29933.html","المتقارب"],[55,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[36,"ألا يا ربع لبنى ما تقول","https://www.aldiwan.net/poem4926.html","الوافر"],[10,"مرهت عيني فعيني","https://www.aldiwan.net/poem21115.html","مجزوء الرمل"],[39,"لنا حوض الحجيج وساقياه","https://www.aldiwan.net/poem7431.html","الوافر"],[74,"يا بروقا على ربى يبرين","https://www.aldiwan.net/poem20165.html","الخفيف"],[74,"تهن بعوده عيدا سعيدا","https://www.aldiwan.net/poem20607.html","الوافر"],[53,"رب فتاة حرة المقلد","https://www.aldiwan.net/poem61887.html","الرجز"],[53,"ليهنك أن أفطرت لا متطلعا","https://www.aldiwan.net/poem66008.html","الطويل"],[47,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[30,"وبالمسجد الأقصى الإمام الذي اهتدى","https://www.aldiwan.net/poem5384.html","الطويل"],[63,"أنى يعود من الصبابة مفرقا","https://www.aldiwan.net/poem51535.html","الكامل"],[82,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[46,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[76,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[54,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[77,"فتقت لكم ريح الجلاد بعنبر","https://www.aldiwan.net/poem69080.html","الكامل"],[52,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[92,"تأبين الغراف الميت","https://www.poetsgate.com/ViewPoem.aspx?id=179098",""],[111,"سميري وهل للمستهام سمير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545431",""],[136,"هذه البئر قنة جار كما أن","https://www.aldiwan.net/poem54835.html","الخفيف"],[164,"عيد حظى بك والأعياد تقتتل","https://www.aldiwan.net/poem58929.html","البسيط"],[164,"سرور عم حتى ما عرفنا","https://www.aldiwan.net/poem59038.html","الوافر"],[234,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[234,"قد أغتدي قبل طلوع الفجر","https://www.aldiwan.net/poem51066.html","الرجز"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[287,"كم شج آلمه لوم الخلي","https://www.aldiwan.net/poem32301.html","الرمل"],[302,"سفرت أميمة ليلة النفر","https://www.aldiwan.net/poem33277.html","أحذ الكامل"],[435,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[469,"أهدى الضنا تذكارها","https://www.aldiwan.net/poem3495.html","عموديه"],[487,"فؤادي قد براه البين لما","https://www.aldiwan.net/poem24488.html","عموديه"],[563,"ألا ليت لو جاد لي الحب ليت","https://www.aldiwan.net/poem34722.html","المتقارب"],[591,"رأى الحسن في العشاق ممتثل الأمر","https://www.aldiwan.net/poem17532.html","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130134","الخفيف"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/33106","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120070","الرمل"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134228","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79861","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108499","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108945","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49591","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132253","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201717","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89518","البسيط"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199640","المسحوب"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100480","البسيط"],[2551,"","https://poetry.dctabudhabi.ae/diwan/poem/204420","الوافر"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48060","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74192","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74237","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74326","الخفيف"],[3178,"","https://poetry.dctabudhabi.ae/diwan/poem/144554","الكامل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99373","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89191","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89123","المتدارك"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61278","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138603",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45814","الطويل"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99174","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101375","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136550",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139787",""],[4750,"الرفيق","https://www.poetsgate.com/ViewPoem.aspx?id=180412",""],[4859,"هوية اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=192357",""],[5007,"وشم التيه","https://www.poetsgate.com/ViewPoem.aspx?id=174254",""],[5085,"قالت لنا","https://www.poetsgate.com/ViewPoem.aspx?id=188399",""],[5111,"قِيثَارَةُ العِشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212085",""],[5111,"هَيْتَ لكْ","https://www.poetsgate.com/ViewPoem.aspx?id=212150",""],[5302,"ليل ونهار","https://www.poetsgate.com/ViewPoem.aspx?id=200550",""],[5302,"موطن العز","https://www.poetsgate.com/ViewPoem.aspx?id=201148",""],[5450,"كرسي","https://www.poetsgate.com/ViewPoem.aspx?id=50289",""],[5504,"سطعت سيوف الهند باللّمعان","https://www.poetsgate.com/ViewPoem.aspx?id=124901",""],[5674,"كتمت دمعاتي لأسترها","https://www.poetsgate.com/ViewPoem.aspx?id=189082",""],[5704,"مسكين أنت يا وطني ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=200014",""],[5843,"مكاسر عود جاوي!","https://www.poetsgate.com/ViewPoem.aspx?id=51287",""],[5956,"الودُّ الأخوي","https://www.poetsgate.com/ViewPoem.aspx?id=192947",""],[5956,"حسبي ذكاؤك سابراً لحقيقتي","https://www.poetsgate.com/ViewPoem.aspx?id=193504",""],[6052,"كاسات الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=34649",""],[6056,"ملتقى الخطين","https://www.poetsgate.com/ViewPoem.aspx?id=130529",""],[6106,"موسم حج حكام الأمة للبيت الأبيض","https://www.poetsgate.com/ViewPoem.aspx?id=6305",""],[549,"يا إمامَ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=203002",""],[6171,"بيت شعري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86322&r=&rc=0",""]],"verses":[["نَحَرنا الدِنانَ عَلى صَدرِهِ","فَلِلَّهِ أَيَّ دِماءٍ أَراقا",0,"ق",2,0],["نَحَروا بِها نَحرَ الفَلاةِ وَقَلَّبوا","قَلبَ الظَلامِ عَلى ذَميلٍ مِسعَرِ",1,"ر",1,0],["نَحَرتُ النَفسَ حينَ سَمِعتُ مِنها","مَقالَتَها وَذاكَ لَها قَليلُ",2,"ل",1,0],["نَحَرَ الكومَ الصَفايا","وَالبِكارَ الخَلِفَه",3,"ف",2,0],["نحرِّم تارة ونُحِلَّ أخرى","وكان لنا المُمَرَّ من السحيلِ",4,"ل",1,0],["نحرت نصلك الكرى فلهذا","سالَ من مقلتي دمٌ من شجوني",5,"ن",2,0],["نحرتَ بهِ جميع عداكَ فانْحر","قروناً آخرين من الضَّحايا",6,"ي",2,0],["نَحْراً كصرْحِ المرمرِ المُمَرَّدِ","دافعْتُها فما اتقتني باليدِ",7,"د",1,0],["نحرتَ لصُغْراهنَّ حتى تركْتنا","نرى الفطر أضحى من إراقتكَ الدما",8,"م",2,0],["نَحَروا الأَسِنَّةَ بِالنُحورِ تَهاوُناً","بِالمَوتِ بَل مَرَناً عَلى المُرّانِ",9,"ن",1,0],["نَحَرنا وَأَبرَزنا القُدورَ وَضُمِّنَت","عَبيطَ المَتالي الكومِ غُرّاً مَحالُها",10,"ل",3,0],["نَحرٌ نَحَرتَ البُدْنَ فيه مُسَدَّداً","وفَتَكْتَ بالأعداءِ فيه موفَّقا",11,"ق",2,0],["نُحِرَتْ شؤوني بالبكاءِ عليه أمْ","عُصِرَتْ مدامعها من الفِرْصادِ",12,"د",1,0],["نُحِرَت رِكابُ القَومِ حَتّى يَغبُروا","رَجلى لَقَد عَنُفوا عَلَيَّ وَلاموا",13,"م",3,0],["نُحِرَ العَزاءُ عَلَيهِ لَم تُنحَر بِهِ","إِبِلٌ وَلَم تُعقَر عَلَيهِ جِيادُ",14,"د",1,0],["نُحِرَت عَلى حُرِّ الثَرى","بِسُقاتِ وابِلِها فَأَروى",15,"و",2,0],["نحرت بها العرب الأعاجم إنها","رُمْحٌ أمَقُّ ولَهْذَمٌ مَصْقول",16,"ل",1,0],["نَحَرَ القَبولَ من الدَّبورِ وسار في","جَمْعِ الهِرَقْل وعزمةِ الاسكندر",17,"ر",1,0],["نَحَرتُ هَجيرَهُ بِمُقَيَّلاتٍ","كَأَنَّ حَميمَ قُصَّتِهِنَّ قارُ",18,"ر",1,0],["نحرن عقيب الدار بازل ناكث","وأمس بصفين لهن هرير",19,"ر",1,0],["نُحرَتْ هنا كُومُ النياق وأوقدَتْ","نارُ القِرى للطارق المِحلال",20,"ل",1,0],["نحرن عقيب الدار بازل ناكث","وأمسى بصفين لهن هرير",21,"ر",1,0],["نَحَرُوا كُلَّ أكوِمٍ قَيسَرِىٍّ","وأُمُونٍ لِضَيفِهِم والجَارِ",22,"ر",1,0],["نحرتها بدراً تغني العُفاة بها","فما الشياه وما الأَبقار والإِبلُ",23,"ل",1,0],["نحرت لأجله الأكياس تبراً","إذا نحر الملوك إليه بدنا",24,"ن",2,0],["نحروه غيرَ مُذمَّم","نَحْرَ الهدايا للضّحيّه",25,"ي",2,0],["نحرت فيه الوحش أيَّ نحر","نحر الوصيّ جيشَ آل صخر",26,"ر",1,0],["نَحَرَ النَّبِيُّ بِكَفِّهِ أُضحِيةً","نَقَلَ الأَئِمَّةُ أَنَّها كَبشانِ",27,"ن",1,0],["نَحرَ أَعداءٍ وَقلبَ المَوكِبِ ال","سائِرِ الأَسنى وَصَدراً لِلنَدِيِّ",28,"ي",1,0],["نحرَت لواحظُها الحَجيجَ كَما","نحرَ الحَجيجُ بَهيمَةَ النَحرِ",29,"ر",1,0],["نحرت سيوف البرق اعناق الغما","م فسال منه دمعه المهطول",30,"ل",1,0],["نحرتْ روايا المزن في","عرصاتها وعشارها",31,"ر",3,0],["نحرت لضيف طيفك نوم جفني","فسال دم الكرى مثل الجماني",32,"ن",2,0],["نحرنا له أنفساً في منى","هواه وجمْرات همّي رميت",33,"ت",1,0],["نَحرْنَ جُفُونِي بالدُّمُوعِ وإِنَّما","سَلَبْنَ عُقُودَ الدُّرِّ مِنْ ذَلِكَ النَّحْرِ",34,"ر",1,0],["نحر الزق عندما ولد الصب","ح فجاءت في الحالتين عقيقه",35,"ق",2,0],["نَحَرتُها عَن سَعيدٍ ثُمَّ قُلتُ لَهُم","زوروا الحَطيمَ فَإِنّي غَيرُ مُرتَحِلِ",36,"ل",1,0],["نحرت بيضك للذم","ربه نحرا ولَبَّه",37,"ب",2,0],["نحر البر ناثراً برد عزمٍ","لف وعر الربى بسهل البطاح",38,"ح",1,0],["نحرا غداةَ النَفر هدياً قال لم","يُقبل سوايَ لوَ انَّ هدياً ينطق",39,"ق",1,0],["نحرت مطالعها الظلام فخلتها","صمصام عبد القادر الوضاء",40,"ا",2,0],["نحرت به العنا عن كل عانٍ","نحرت له البوازل والشياها",41,"ا",3,0],["نَحَرْتَ بهِ الكفَّارَ في كلِّ مَنْحَرٍ","إذا نُحِرَتْ بُزْلٌ هناكَ وكُومُ",42,"م",1,0],["نحرت لضيف الطيف جفنى عن الكرى","فأسبل يجري بالدماء على النحر",43,"ر",1,0],["نحرت بلاد الروم يا غصنها فما","لطائرِ قلبي في الجزيرة من وكن",44,"ن",1,0],["نَحَرتَ هَديَكَ فيهِ المُشرِكينَ ضُحىً","فَاِفخَر فَفَخرُ سِواكَ المَعزُ وَالضّانُ",45,"ن",1,0],["نحرّه سيداتٍ اطوالي","لا تمشيّ في مهاييله",46,"ل",2,0],["نحرت هديك فيها فاتبعت به","أبا النبيين إبراهيم إذا نحرا",47,"ر",2,0],["نحرت لهم وقلت: ألا هلموا","كلوا مما طهيت لكم سماحا",48,"ح",2,0],["نَحرَتْ بنا صَدْرَ الدَّبورِ فأَنْبطَت","قَلَقَ المضاجِعِ تَحْتَ جوٍّ أَكدَرَا",49,"ر",2,0],["نَحر العُلوم بشفرتيه فَلَم تَمُت","في عَصره لا رَيب وَهوَ مهند",50,"د",1,0],["نحر العُلوم بِفكرة لَو صافحت","جَبلاً لَضاقَ البر مِن أَوصاله",51,"ل",2,0],["نحر المُشركين بِالسَيف لَما","غَمصوا الحَق بِالهَوى وَالتواني",52,"ن",2,0],["نحروا لنا الخيلَ الإناثَ وأَصبحوا","رَجلى وكانت عدةَ وعَديدا",53,"د",2,0],["نحرت حتى السماء واقعة","فوقي والارض تحتنا تخسف",54,"ف",1,0],["نحرت منامي له قربةً","فدمعي دماء الذي أنحر",55,"ر",1,0],["نحرت أعداك بلا نصل","وفداؤك شانئك الأبتر",56,"ر",1,0],["نَحَرَ الأَسى إِنسانَ مُقلتِهِ","فَجَرى فَخضَّب رجله دَمُهُ",57,"م",2,0],["نحر الضلال بنحر أكرم فتيةٍ","إذ بان أهدى الفرقتين من الأضل",58,"ل",1,0],["نَحَرتُ بِهِ ما اللَه يَجعَلَهُ الفِدا","وَقائم يمن في يَمينك قائم",59,"م",1,0],["نحر الضفادع في الصنيع ولم يدع","للنمل دارجة ولا للقمل",60,"ل",1,1],["نحرتم وطعنتم قلب موطنكم","حتى يقال مطاعين مناحير",61,"ر",1,0],["نَحرت بدن اصطباري والرقاد فدى","لذات عقدٍ يُزين العقد مَنحرها",62,"ر",3,0],["نحرا بنحرهما الأعادي فاغتدت","صرعى وذلُّ البغى أهونُ ذلِّها",63,"ل",3,0],["نحّروه سعود والجود ابشروا به","فالمهمات الثقيله والخفيفه",64,"ف",2,0],["نحرَ الطغاةُ بلا حياءٍ مامضى","وجروا وراءَ المالِ من بعدِ القيمْ",65,"م",1,0],["نَحَرْتُ سِرِّي º فَخَطُّ الغَدْر مُتّصِل","يا من بقلب ربيع العمر منتعل!!",66,"ل",1,1],["نحْرٌ لها من فِضةٍ هوَ شاربٌ","مِن مَاءِ مِسْكٍ بالنَّدى مَبلوْلُ",67,"ل",1,0],["نَحْريْرَةٌ وَحَصِيْفَةٌ آرَاؤُهَا","صَمْتُ المَدى يرنُو لهَا يَحتَارُ",68,"ر",1,0],["نَحْرِيرَةٌ وَمَكِينَةٌ وَأصَََِِِلةٌ","وَجَهَنَّمٌ مَنْ مَسَّ َوهْجَتَهَا هَلَكْ",69,"ك",1,0],["نحرث الأرض والحياة ونبقى","في نواحيهما العراض شدادا",70,"د",2,0],["نحرق البغي في لظاها ونعفو","في اعتزاز ونرهب الأشرارا",71,"ر",2,0],["نحررها فتمنحنا يَدَ الرومان والفرسِ","بلادٌ ما لها دينٌ تدينُ لعابرٍ نجسِ