{"poems":[[55,"أأبقى كذا أبدا مستقلا","https://www.aldiwan.net/poem29898.html","المتقارب"],[55,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[55,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[65,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[3,"ترى هذه ريح أرض الشربه","https://www.aldiwan.net/poem124.html",""],[79,"لمن علم في هضبة الملك خفاق","https://www.aldiwan.net/poem35918.html","الطويل"],[79,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[37,"شجا أظعان غاضرة الغوادي","https://www.aldiwan.net/poem39157.html","الوافر"],[37,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[29,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[39,"ومن دون ذاك قسي المنون","https://www.aldiwan.net/poem7402.html","المتقارب"],[74,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[53,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[53,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[53,"أحباءنا ما كان لي عنكم صبر","https://www.aldiwan.net/poem64074.html","الطويل"],[31,"ألهى جريرا عن أبيه وأمه","https://www.aldiwan.net/poem6095.html","الطويل"],[72,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[87,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[30,"لعمري لقد أردى نوار وساقها","https://www.aldiwan.net/poem5375.html","الطويل"],[63,"على غير عتب ما طويت عتابها","https://www.aldiwan.net/poem51781.html","الطويل"],[60,"غر جهولا أمله","https://www.aldiwan.net/poem30924.html","مجزوء الرجز"],[68,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[46,"حماد من نوء له حماد","https://www.aldiwan.net/poem29694.html","الرجز"],[54,"ومن دون ما أبديت لي يقتل الفتى","https://www.aldiwan.net/poem26839.html","الطويل"],[77,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[50,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[50,"أحسن من وصف دارس الدمن","https://www.aldiwan.net/poem65306.html","المنسرح"],[52,"دعيني يا أميرة من سرار","https://www.aldiwan.net/poem63804.html","الوافر"],[48,"يؤدبك الدهر بالحادثات","https://www.aldiwan.net/poem22159.html","المتقارب"],[48,"ألا تتفقون الله رهط مسلم","https://www.aldiwan.net/poem22202.html","الطويل"],[48,"أرى فتيي دنياك إن حرج الفتى","https://www.aldiwan.net/poem23511.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62205","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[108,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[92,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[146,"أيا بؤس قوم حسان الشخوص","https://www.aldiwan.net/poem58400.html","المتقارب"],[147,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[164,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[190,"من طالب الناس بالإنصاف أحقدهم","https://www.aldiwan.net/poem44175.html","البسيط"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[214,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[233,"وابأبي من حسن الظن في","https://www.aldiwan.net/poem51051.html","السريع"],[274,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[279,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[279,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[284,"أقول واليوم بهيم خطبه","https://www.aldiwan.net/poem60605.html","الرجز"],[286,"قوامك ثم لحظك يا غلام","https://www.aldiwan.net/poem32625.html","الوافر"],[286,"إذا ما رأينا حسن وجه أبي الفتح","https://www.aldiwan.net/poem32823.html","الطويل"],[291,"لعمري لئن جدت عداوة بيننا","https://www.aldiwan.net/poem1908.html","الطويل"],[302,"حماة الديار","https://www.aldiwan.net/poem36297.html","عموديه"],[308,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[352,"نصف شهبا قد أرسلتها أهلة","https://www.aldiwan.net/poem20225.html","الطويل"],[353,"أأكشف حالا ستره في النهى شرط","https://www.aldiwan.net/poem15762.html","الطويل"],[353,"متى منا محب مدعينا","https://www.aldiwan.net/poem15978.html","الوافر"],[357,"بقدر النهى بين الورى يشرف القدر","https://www.aldiwan.net/poem40345.html","الطويل"],[367,"فلا تأمنونا إننا رهط جندب","https://www.aldiwan.net/poem1709.html","الطويل"],[368,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[368,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[370,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[400,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[407,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[410,"هي البدر لكن تستر مدى الدهر","https://www.aldiwan.net/poem50169.html","الطويل"],[413,"ومن علقت بالصالح الملك كفه","https://www.aldiwan.net/poem32218.html","الطويل"],[443,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[443,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[445,"فدونك من جزء الضياء مسائلاً","https://www.aldiwan.net/poem14413.html","الطويل"],[456,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[461,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[461,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[461,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[461,"بطرفك والمسحور يقسم بالسحر","https://www.aldiwan.net/poem56173.html","الطويل"],[461,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[461,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[464,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[469,"ألا طرقت ليلى فأحزن ذكرها","https://www.aldiwan.net/poem50373.html","الطويل"],[469,"تذكرت ليلى أن تغنت حمامة","https://www.aldiwan.net/poem50460.html","الطويل"],[473,"أقول بعمان وهل طربي به","https://www.aldiwan.net/poem4737.html","الطويل"],[473,"أفالآن لما بايعوا لضلالة","https://www.aldiwan.net/poem4740.html","الطويل"],[503,"هل العناية إلا أن ترى رجلا","https://www.aldiwan.net/poem38034.html","البسيط"],[532,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[554,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[561,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[561,"إن الذي أكد وعدي وفاه","https://www.aldiwan.net/poem33660.html","السريع"],[578,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"],[981,"","https://poetry.dctabudhabi.ae/diwan/poem/96523","المتقارب"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/18998","الطويل"]],"verses":[["وَمِن دونِ ضَيمي فِناءُ الرِماحِ","وَبيضُ القَواضِبِ ذَفّاً وَفَلّا",0,"ل",2,0],["وَمِن دَواءِ الداءِ أَن","ماطَلَ كَيٌّ عاجِلُ",1,"ل",1,0],["وَمِن دارِ أَحبابٍ نَبُلُّ طُلولَها","بِماءِ الأَماقِيَ أَو نُحَيّي جَنابَها",2,"ب",3,0],["ومنْ دونِهِ أمَدٌ نازِحٌ","إذا أَمَّهُ الطَّرْفُ أوهَى قُواهْ",3,"ا",2,0],["وَمِن دارِ عَبلَةَ نارٌ بَدَت","أَمِ البَرقُ سَلَّ مِنَ الغَيمِ عَضبَه",4,"ب",2,0],["ومنْ دونِ ما رامُوهُ للهِ قُدْرَةٌ","ومن دونِ ما أمّوهُ للفتْحِ أغْلاقُ",5,"ق",1,0],["ومن دونِ ما تَبْغيهِ يا ملِكَ العُلا","جيادُ المَذاكي والمحجَّلَةُ الغُرُّ",6,"ر",1,0],["وَمِن دُونِ الَّذي أَمَّلتُ وُدًّا","ولَو طالبتُها خَرطُ القَتادِ",7,"د",1,0],["وَمِن دون حَيثُ اِستُوقِدَت مِن مُجالِخٍ","مَراحٌ وَمُغدًى للمَطِيِّ وَسَبسَبُ",8,"ب",1,0],["وَمِن دونِهِ تيهٌ كَأَنَّ شِخاصَها","يَحُلنَ بِأَمثالٍ فَهُنَّ شَوافِعُ",9,"ع",1,0],["ومن دون ذاك قِسي المنو","ن لا الفوقُ نَبْلاً ولا النُّصَّلُ",10,"ل",1,1],["ومن دُرَر","فيها سمر",11,"ر",1,0],["ومَندل الهند الذي يُرتَضَى","يُقسَم في الناس ولا نُذكرُ",12,"ر",1,0],["ومن دونِ ما قد سُمْتني في كرائمي","يقول امرُؤٌ نعم البُعولُ المقابر",13,"ر",1,0],["ومن دونه هولٌ ومن تحته ردىً","ومن فوقه سيفٌ ومن تحته بحر",14,"ر",1,0],["وَمِن دونِهِ يَحطاطُ أَوسُ بنُ مُدلِجٍ","وَإِيّاهُ يَخشى طارِقٌ وَزَنيقُ",15,"ق",1,0],["وَمِن دونِها أَن لا تُلِمَّ بِخاطِرٍ","قُصورُ الوَرى عَن وَصلِها وَقُصورُها",16,"ر",3,0],["ومن دموع السحب","إلى انكماش الأرنب",17,"ب",1,0],["وَمِن دونِ أَبوالِ الأُسودِ بَسالَةٌ","وَصَولَةُ أَيدٍ يَمنَعُ الضَيمَ طولُها",18,"ل",3,0],["ومِن دونِها نَيْلُ الغَمامِ إذا سرَتْ","نُجومُ القَنا الخَطّيِّ تُزْجي قِبابَها",19,"ب",3,0],["وَمَن دَنا مِن حَتفِهِ","لَم تُغنِ عَنهُ حِيَلُه",20,"ل",2,0],["وَمَن دَنا فَتَدَلّى نَحوَ خالِقِهِ","كَقابِ قَوسَينِ أَو أَدنى إِلى العُنُقِ",21,"ق",1,0],["وَمِن دَواءٍ سَنَةٍ جَمادِ","وَحَلَبَت مِن روقِهِ العَتادِ",22,"د",1,0],["وَمِن دونِ ما أَبدَيتَ لي يَقتُلُ الفَتى","وَيُمسي جَليدُ القَومِ وَهُوَ ضَعيفُ",23,"ف",1,1],["ومِن دون شِعْبٍ أنتَ حاميه معرَكٌ","وبيءٌ وتصْعيدٌ كَريهٌ وتصويب",24,"ب",1,0],["وَمَن دَعاني إِلَيهِ","طَرفٌ أَحَمُّ كَحيلُ",25,"ل",1,0],["وَمِن دِيارٍ عَفَت مَعالِمُها","رَيحانَةٌ رُكِّبَت عَلى أُذُنِ",26,"ن",1,0],["وَمُندَلِثٍ يُمارينا بِجَهدٍ","فَقُلتُ لَهُ تَعَلَّم ثُمَّ مارِ",27,"ر",1,0],["وَمِن دونِها اِختَلَفَت غالِبٌ","وَأَبعَدَ عُثمانُها جُندُبا",28,"ب",2,0],["وَمِن دونِ ما أَبدَيتُمُ خُضِبَ القَنا","وَمارَ نَجيعُ الخَيلِ في الهَبَواتِ",29,"ت",1,0],["وَمَن دايَنَ الأَيّامَ فَهيَ مَلِيَّةٌ","عَلى غَيِّها بِاللَيِّ وَالسَلَجانِ",30,"ن",1,0],["وَمِن دَونِ ذاكَ هَوِيٌّ لَهُ","هَوِيَّ القُطامِيّ لِلأَرنَبِ",31,"ب",1,0],["ومِنْ دُونِ حَيْثُ اسْتَوْقَدَتْ مِنْ ضَئِيَدةٍ","تَنَاهٍ بِهَا طَلْحٌ غَرِيبٌ وتَنْضُبُ",32,"ب",1,0],["ومن دمِ الشهداءِ الباعثين به","جيلاً من الحقِّ أو دنيا من الأملِ",33,"ل",1,0],["ومِن دونِها يومٌ من الشمسِ عاطِلٌ","وليلٌ بأطرافِ الأسِنّةِ حال",34,"ل",1,0],["وَمِن دُوَلِ المُستَهتِرينَ وَمَن غَدا","بِهِم طالِباً لِلنورِ في الظُلُماتِ",35,"ت",1,0],["ومِنْ دون الوصول إليه كانتْ","رُءُوسٌ في الهواء بها يُطاحُ؟",36,"ح",1,0],["ومن دون ذلك أن تَصطلوا","سعيرَ الحياة ، وان تَسغَبوا",37,"ب",3,0],["ومن دون ذلك تُشوَى الوجوهُ","وتُقذَى العيونُ ويُفرَى الادَمْ",38,"م",1,0],["وَمِن دونِ هَذا العِزِّ سَيفُ خِلافَةٍ","يَفوقُ الظُبى سَفحاً وَيَفضُلُها حَدّا",39,"د",2,0],["ومن درى بان ورد ظله","يقوى على حر الهجير صبرا",40,"ر",2,0],["ومن دعاهم إلى فحش ومخزية","وسوء فل وتخليط أجابوه",41,"ه",1,0],["وَمِن دونِ علمٍ كيفَ تحصلُ قوّةٌ","نَكفُّ بِها عنّا منَ المُعتدي الضرّا",42,"ر",2,0],["ومن دون الورى لما عناني","رماني بالبعاد وبالعناء",43,"ا",2,0],["ومن دعاني للمهمّ الذي","يُسَهِّل المستصعَب الوَعْرا",44,"ر",2,0],["ومن دموعكِ هاتيكَ السموطُ حكت","أبياتَ نونيّةٍ فيها شكاوينا",45,"ن",2,0],["وَمِنْ دُونِهم بِالسَّمْهَرِيةِ خَنْدقُوا","فَعَبَّدت الأَسْيافُ نَحْوَهُمُ طُرْقَا",46,"ق",2,0],["وَمَنْ دَانَ هَذا الدّينَ حَقّاً بِنَصْرِه","فَلَيْسَ له مِنْ أهْلِ دُنْيَاهُ خاذِلُ",47,"ل",1,0],["وَمِنْ دَجاجاتٍ إِذا ما كرْدِنَتْ","كَأَنَّما شَكَّ فُؤادِي شِيشُها",48,"ش",3,0],["وَمِن دُرِّ الحَبابِ لَها نِظامٌ","أَلا يا حَبَّذا ذاكَ النِظامُ",49,"م",1,0],["وَمن دينُهُ أَن لا مَساسَ وَإِنّهُ","لَيَقتُلُ مَن يَهواهُ بِالجِدِّ في المَزحِ",50,"ح",1,0],["وَمِن دونِهِ طَعنٌ كَأَنَّ رَشاشَهُ","عَزالى مَزادٍ وَالأَسِنَّةُ تَرذُمُ",51,"م",1,0],["وَمن دمِ كلِّ","شهيدٍ مداد",52,"د",1,0],["ومن دأب نفس المرء أن تكره السرى","فتحمده عند الصباح بشكران",53,"ن",1,0],["وَمِن دَمِها لِلأرْضِ خَدٌّ مُضَرَّجٌ","يَهِيمُ بِهِ قَلْبٌ وَيُفْتَنُ نَاظِرُ",54,"ر",1,0],["وَمِن دَرِّ ما اِستَخرَجَتهُ مِن قَرارِهِ","لِجيدِ العُلى سَمطٌ وَفي أُذُنها قَرطُ",55,"ط",1,0],["وَمِن دَرَجِ الصُعودِ إِلى المَعالي","إِلى دَرِ الهَوانَ بِهِ هَوَينا",56,"ن",2,0],["وَمَن دَأبه فعلُ الجَميل وَحَظّه","بِما فيهِ خَير لِلوَرى وَلَهُ الأَجرُ",57,"ر",1,0],["وَمِن دونِ أَحراسٍ وَقَد نَدَروا بِهِ","فَما خامَ حَتّى حَسَّه بِالأَصابِعِ",58,"ع",1,0],["ومِن دونها زُرْقُ الأسنّةِ شُرَّعٌ","إذا وردَتْها العَينُ ظلّتْ تَذودها",59,"د",3,0],["ومن دونِ فاتنةِ البِيضِ بيِضٌ","ومن دونِ ساكنةِ البيدِ بِيد",60,"د",1,0],["وَمِن دونِ تَصريفِ المُنى حَرفُ عِلَّةٍ","وَلَيسَ لَها إلّا عَزيمَةُ جازِمِ",61,"م",1,0],["ومن دفاف تُحيت الجنب نافذَةً","حمراءُ يخرجُ من حافاتِها النفسُ",62,"س",1,0],["ومن دون هذا أخرج الترك جدكم","ولو عاش أخلاكم بِحَدِّ البواتر",63,"ر",1,0],["وَمِن دونِها سوران سُورٌ مِنَ النَوى","وَسورٌ مِنَ الأَسيافِ وَالأسل السُمرِ",64,"ر",1,0],["ومِن دُونِهِ إن رابَ خطبٌ ذَوابلٌ","وبيضٌ وجردٌ لا القَتادَةُ والخُرْطُ",65,"ط",1,0],["ومِنْ دُونِ سِتْرَيْ عِفَّتِي وتَجَمُّلِي","لَرَيْبٌ وصَرْفٌ للزَّمانِ يَجُورُ",66,"ر",1,0],["ومِنْ دوننا آنِساتُ الدِّيارِ","نِهابَ الحِمى مُوحِشاتِ الطُّلُولِ",67,"ل",1,0],["ومن دان باستحلال أَكل لميتة","بغير اضطرار عند ما هي تؤكل",68,"ل",1,0],["ومن دمعةُ العاصي عليه كدمعتي","كأني جزءُ منه بد بُتَّ فانشطر",69,"ر",1,0],["ومن دمٍ تخوضه بلا دمٍ","على ثنايا البين أيدي البُدُنِ",70,"ن",1,0],["ومن دون ذلك رأيٌ يسد","دُ ناحيةَ الحادثِ المُفظِعِ",71,"ع",1,0],["ومن دونها البلدُ المقشعرُّ","يردّ ظباءَ المهارى ضباعا",72,"ع",2,0],["ومن دون ضيمي بسطةُ الأرض والسُّرى","وخوض الدياجي وامتعاضُ الفتى الحرِّ",73,"ر",1,0],["ومن دعا ومن سعى","واستنّ سبعاً وجَمَرْ",74,"ر",1,0],["ومن دونهاأن يخطبَ الليثُ هُدنةً","من الذئب أو يبكي من العطش الضبُّ",75,"ب",1,0],["ومن دون صبح العز ليلٌ مؤرِّقٌ","جعلتُ القوافي من تماديه سُمَّرا",76,"ر",2,0],["وَمَن دونَها مِن قِلَّةِ العَبرِ مُخرَمٌ","يُشَبِّهُهُ الرائي حِصاناً مُوَطَّنا",77,"ن",2,0],["وَمِن دونِ لَيلى سَبسَبٌ مُتَماحِلٌ","يُجيبُ صَداهُ اليَومَ حينَ يَصيحُ",78,"ح",1,0],["وَمِن دونِ ما أَسمو بِطَرفي لأَرضِهِم","مَفاوِزُ مُغبَرٌّ مِنَ التيهِ واسِعُ",79,"ع",1,0],["وَمِن دُون مَا حاوَلت مِن نكث عَهدهم","وأمكَ مَوتٌ يا ابنَ دَحمةَ ناقِعُ",80,"ع",1,0],["ومنْ دَهاهُ العَما عن نورِ مَشْهدهِ","فَقلبُهُ بِظلامِ الصَّدِّ مَكْمودُ",81,"د",1,0],["ومنْ دُونِ ما أَبْغِيهِ في كُلِّ مَوْطِنٍ","طِرادُ جِيادٍ وارْتِقاصُ صِعادِ",82,"د",1,0],["ومَن دافَعَ الأيّامَ عن مُهَجاتكمْ","وهنَّ أخيذاتٌ لأيدي المهالكِ",83,"ك",1,0],["ومن دعوناه للجلى اذا طرقت","والامر تفصيله قد كل عنه فمى",84,"م",2,0],["ومن درى ذاب ومن لا درى","وكلهم منطرح في حماه",85,"ا",2,0],["ومن دُونِ شُرب العيِن من ماءِ وجهه","ولم تَرْوَ مِنْه شربُ ماءِ المهنَّدِ",86,"د",1,0],["ومن دونِ ذلك خَرْطُ القَتاد","وطعنٌ وضرب يُقِرّ العُيونا",87,"ن",2,0],["وَمِن دونِ حوثُ إِستوقَدَت هُضبُ شابَةٍ","وَهُضبُ تَعارٍ كُلُّ عَنقاءَ عَيطَلِ",88,"ل",1,0]]}