{"poems":[[53,"أأبقى كذا أبدا مستقلا","https://www.aldiwan.net/poem29898.html","المتقارب"],[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[53,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[63,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[3,"ترى هذه ريح أرض الشربه","https://www.aldiwan.net/poem124.html",""],[77,"لمن علم في هضبة الملك خفاق","https://www.aldiwan.net/poem35918.html","الطويل"],[77,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[35,"شجا أظعان غاضرة الغوادي","https://www.aldiwan.net/poem39157.html","الوافر"],[35,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[27,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[37,"ومن دون ذاك قسي المنون","https://www.aldiwan.net/poem7402.html","المتقارب"],[72,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[51,"أحباءنا ما كان لي عنكم صبر","https://www.aldiwan.net/poem64074.html","الطويل"],[29,"ألهى جريرا عن أبيه وأمه","https://www.aldiwan.net/poem6095.html","الطويل"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[28,"لعمري لقد أردى نوار وساقها","https://www.aldiwan.net/poem5375.html","الطويل"],[61,"على غير عتب ما طويت عتابها","https://www.aldiwan.net/poem51781.html","الطويل"],[58,"غر جهولا أمله","https://www.aldiwan.net/poem30924.html","مجزوء الرجز"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[44,"حماد من نوء له حماد","https://www.aldiwan.net/poem29694.html","الرجز"],[52,"ومن دون ما أبديت لي يقتل الفتى","https://www.aldiwan.net/poem26839.html","الطويل"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[48,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[48,"أحسن من وصف دارس الدمن","https://www.aldiwan.net/poem65306.html","المنسرح"],[50,"دعيني يا أميرة من سرار","https://www.aldiwan.net/poem63804.html","الوافر"],[46,"يؤدبك الدهر بالحادثات","https://www.aldiwan.net/poem22159.html","المتقارب"],[46,"ألا تتفقون الله رهط مسلم","https://www.aldiwan.net/poem22202.html","الطويل"],[46,"أرى فتيي دنياك إن حرج الفتى","https://www.aldiwan.net/poem23511.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[90,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""]],"verses":[["وَمِن دونِ ضَيمي فِناءُ الرِماحِ","وَبيضُ القَواضِبِ ذَفّاً وَفَلّا",0,"ل",2,0],["وَمِن دَواءِ الداءِ أَن","ماطَلَ كَيٌّ عاجِلُ",1,"ل",1,0],["وَمِن دارِ أَحبابٍ نَبُلُّ طُلولَها","بِماءِ الأَماقِيَ أَو نُحَيّي جَنابَها",2,"ب",3,0],["ومنْ دونِهِ أمَدٌ نازِحٌ","إذا أَمَّهُ الطَّرْفُ أوهَى قُواهْ",3,"ا",2,0],["وَمِن دارِ عَبلَةَ نارٌ بَدَت","أَمِ البَرقُ سَلَّ مِنَ الغَيمِ عَضبَه",4,"ب",2,0],["ومنْ دونِ ما رامُوهُ للهِ قُدْرَةٌ","ومن دونِ ما أمّوهُ للفتْحِ أغْلاقُ",5,"ق",1,0],["ومن دونِ ما تَبْغيهِ يا ملِكَ العُلا","جيادُ المَذاكي والمحجَّلَةُ الغُرُّ",6,"ر",1,0],["وَمِن دُونِ الَّذي أَمَّلتُ وُدًّا","ولَو طالبتُها خَرطُ القَتادِ",7,"د",1,0],["وَمِن دون حَيثُ اِستُوقِدَت مِن مُجالِخٍ","مَراحٌ وَمُغدًى للمَطِيِّ وَسَبسَبُ",8,"ب",1,0],["وَمِن دونِهِ تيهٌ كَأَنَّ شِخاصَها","يَحُلنَ بِأَمثالٍ فَهُنَّ شَوافِعُ",9,"ع",1,0],["ومن دون ذاك قِسي المنو","ن لا الفوقُ نَبْلاً ولا النُّصَّلُ",10,"ل",1,1],["ومن دُرَر","فيها سمر",11,"ر",1,0],["ومَندل الهند الذي يُرتَضَى","يُقسَم في الناس ولا نُذكرُ",12,"ر",1,0],["ومن دونِ ما قد سُمْتني في كرائمي","يقول امرُؤٌ نعم البُعولُ المقابر",13,"ر",1,0],["ومن دونه هولٌ ومن تحته ردىً","ومن فوقه سيفٌ ومن تحته بحر",14,"ر",1,0],["وَمِن دونِهِ يَحطاطُ أَوسُ بنُ مُدلِجٍ","وَإِيّاهُ يَخشى طارِقٌ وَزَنيقُ",15,"ق",1,0],["وَمِن دونِها أَن لا تُلِمَّ بِخاطِرٍ","قُصورُ الوَرى عَن وَصلِها وَقُصورُها",16,"ر",3,0],["ومن دموع السحب","إلى انكماش الأرنب",17,"ب",1,0],["وَمِن دونِ أَبوالِ الأُسودِ بَسالَةٌ","وَصَولَةُ أَيدٍ يَمنَعُ الضَيمَ طولُها",18,"ل",3,0],["ومِن دونِها نَيْلُ الغَمامِ إذا سرَتْ","نُجومُ القَنا الخَطّيِّ تُزْجي قِبابَها",19,"ب",3,0],["وَمَن دَنا مِن حَتفِهِ","لَم تُغنِ عَنهُ حِيَلُه",20,"ل",2,0],["وَمَن دَنا فَتَدَلّى نَحوَ خالِقِهِ","كَقابِ قَوسَينِ أَو أَدنى إِلى العُنُقِ",21,"ق",1,0],["وَمِن دَواءٍ سَنَةٍ جَمادِ","وَحَلَبَت مِن روقِهِ العَتادِ",22,"د",1,0],["وَمِن دونِ ما أَبدَيتَ لي يَقتُلُ الفَتى","وَيُمسي جَليدُ القَومِ وَهُوَ ضَعيفُ",23,"ف",1,1],["ومِن دون شِعْبٍ أنتَ حاميه معرَكٌ","وبيءٌ وتصْعيدٌ كَريهٌ وتصويب",24,"ب",1,0],["وَمَن دَعاني إِلَيهِ","طَرفٌ أَحَمُّ كَحيلُ",25,"ل",1,0],["وَمِن دِيارٍ عَفَت مَعالِمُها","رَيحانَةٌ رُكِّبَت عَلى أُذُنِ",26,"ن",1,0],["وَمُندَلِثٍ يُمارينا بِجَهدٍ","فَقُلتُ لَهُ تَعَلَّم ثُمَّ مارِ",27,"ر",1,0],["وَمِن دونِها اِختَلَفَت غالِبٌ","وَأَبعَدَ عُثمانُها جُندُبا",28,"ب",2,0],["وَمِن دونِ ما أَبدَيتُمُ خُضِبَ القَنا","وَمارَ نَجيعُ الخَيلِ في الهَبَواتِ",29,"ت",1,0],["وَمَن دايَنَ الأَيّامَ فَهيَ مَلِيَّةٌ","عَلى غَيِّها بِاللَيِّ وَالسَلَجانِ",30,"ن",1,0],["وَمِن دَونِ ذاكَ هَوِيٌّ لَهُ","هَوِيَّ القُطامِيّ لِلأَرنَبِ",31,"ب",1,0],["ومن دمِ الشهداءِ الباعثين به","جيلاً من الحقِّ أو دنيا من الأملِ",32,"ل",1,0],["ومِن دونِها يومٌ من الشمسِ عاطِلٌ","وليلٌ بأطرافِ الأسِنّةِ حال",33,"ل",1,0],["وَمِن دُوَلِ المُستَهتِرينَ وَمَن غَدا","بِهِم طالِباً لِلنورِ في الظُلُماتِ",34,"ت",1,0],["ومِنْ دون الوصول إليه كانتْ","رُءُوسٌ في الهواء بها يُطاحُ؟",35,"ح",1,0],["ومن دون ذلك أن تَصطلوا","سعيرَ الحياة ، وان تَسغَبوا",36,"ب",3,0]]}