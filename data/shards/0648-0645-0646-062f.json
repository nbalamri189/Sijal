,"","https://poetry.dctabudhabi.ae/diwan/poem/81686","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83522","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83423","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72516","السريع"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216343",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120512","الطويل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35099","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139639",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124661","الرجز"],[4673,"","https://poetry.dctabudhabi.ae/diwan/poem/104489","الطويل"],[4691,"يا من تستر عني","https://www.poetsgate.com/ViewPoem.aspx?id=61705",""],[242,"حَبْلُ الدُّنَى يَا مُبْتَغيهِ رَثُّ","https://www.poetsgate.com/ViewPoem.aspx?id=38124",""],[4709,"إليها وحدها أهدي فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=214802",""],[4718,"لاتحسبني يوم اناديك محتاج","https://www.poetsgate.com/ViewPoem.aspx?id=137087",""],[4728,"عجبنا كيف نامن لدنيانا","https://www.poetsgate.com/ViewPoem.aspx?id=176868",""],[4755,"إلى الحُبِّ مِمَّا مَضَى أَبرَأُ","https://www.poetsgate.com/ViewPoem.aspx?id=202247",""],[4869,"الحراميه","https://www.poetsgate.com/ViewPoem.aspx?id=151546",""],[585,"ألا انظر وسل من شئت كيف الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=161914",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[3591,"يا حافظ الشعر ويا شاعراً","https://www.poetsgate.com/ViewPoem.aspx?id=149433",""],[5136,"بروحي طيفاً أتى في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=121707",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5152,"قصيدة: يارحمن ياصمدُ","https://www.poetsgate.com/ViewPoem.aspx?id=184380",""],[5190,"هو التاريخ شاهدنا","https://www.poetsgate.com/ViewPoem.aspx?id=175249",""],[5277,"إلا إنَّهُ الأضحى المباركُ","https://www.poetsgate.com/ViewPoem.aspx?id=205956",""],[5281,"تنومة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=200094",""],[592,"أشاقك من سعدي بتلك المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=128861",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5409,"طواك الموت قيثاراً بديعا","https://www.poetsgate.com/ViewPoem.aspx?id=155460",""],[5460,"أتيتك مشتاقا وما لي حاجة","https://www.poetsgate.com/ViewPoem.aspx?id=200729",""],[5518,"توسلت بالمختار أرجى الوسائل","https://www.poetsgate.com/ViewPoem.aspx?id=190036",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5616,"إيضاح شعري","https://www.poetsgate.com/ViewPoem.aspx?id=204839",""],[243,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=20959",""],[5658,"الهي قد أَعْطَيْتنِي مَا أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=189653",""],[5725,"على اي عود","https://www.poetsgate.com/ViewPoem.aspx?id=191981",""],[5725,"غافلت في وصلك","https://www.poetsgate.com/ViewPoem.aspx?id=200865",""],[5818,"دنسِ الدّنْيا","https://www.poetsgate.com/ViewPoem.aspx?id=193129",""],[5925,"أماه","https://www.poetsgate.com/ViewPoem.aspx?id=494",""],[5970,"هفت بفؤاد (أحمدكم) كعاب","https://www.poetsgate.com/ViewPoem.aspx?id=130639",""],[6049,"اسمن عذارك","https://www.poetsgate.com/ViewPoem.aspx?id=35631",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6259,"هي البدرُ لكن تستسرّ مدى الدهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59382&r=&rc=30",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""]],"verses":[["وَمِن دونِ ضَيمي فِناءُ الرِماحِ","وَبيضُ القَواضِبِ ذَفّاً وَفَلّا",0,"ل",2,0],["وَمِن دَواءِ الداءِ أَن","ماطَلَ كَيٌّ عاجِلُ",1,"ل",1,0],["وَمِن دارِ أَحبابٍ نَبُلُّ طُلولَها","بِماءِ الأَماقِيَ أَو نُحَيّي جَنابَها",2,"ب",3,0],["ومنْ دونِهِ أمَدٌ نازِحٌ","إذا أَمَّهُ الطَّرْفُ أوهَى قُواهْ",3,"ا",2,0],["وَمِن دارِ عَبلَةَ نارٌ بَدَت","أَمِ البَرقُ سَلَّ مِنَ الغَيمِ عَضبَه",4,"ب",2,0],["ومنْ دونِ ما رامُوهُ للهِ قُدْرَةٌ","ومن دونِ ما أمّوهُ للفتْحِ أغْلاقُ",5,"ق",1,0],["ومن دونِ ما تَبْغيهِ يا ملِكَ العُلا","جيادُ المَذاكي والمحجَّلَةُ الغُرُّ",6,"ر",1,0],["وَمِن دُونِ الَّذي أَمَّلتُ وُدًّا","ولَو طالبتُها خَرطُ القَتادِ",7,"د",1,0],["وَمِن دون حَيثُ اِستُوقِدَت مِن مُجالِخٍ","مَراحٌ وَمُغدًى للمَطِيِّ وَسَبسَبُ",8,"ب",1,0],["وَمِن دونِهِ تيهٌ كَأَنَّ شِخاصَها","يَحُلنَ بِأَمثالٍ فَهُنَّ شَوافِعُ",9,"ع",1,0],["ومن دون ذاك قِسي المنو","ن لا الفوقُ نَبْلاً ولا النُّصَّلُ",10,"ل",1,1],["ومن دُرَر","فيها سمر",11,"ر",1,0],["ومَندل الهند الذي يُرتَضَى","يُقسَم في الناس ولا نُذكرُ",12,"ر",1,0],["ومن دونِ ما قد سُمْتني في كرائمي","يقول امرُؤٌ نعم البُعولُ المقابر",13,"ر",1,0],["ومن دونه هولٌ ومن تحته ردىً","ومن فوقه سيفٌ ومن تحته بحر",14,"ر",1,0],["وَمِن دونِهِ يَحطاطُ أَوسُ بنُ مُدلِجٍ","وَإِيّاهُ يَخشى طارِقٌ وَزَنيقُ",15,"ق",1,0],["وَمِن دونِها أَن لا تُلِمَّ بِخاطِرٍ","قُصورُ الوَرى عَن وَصلِها وَقُصورُها",16,"ر",3,0],["ومن دموع السحب","إلى انكماش الأرنب",17,"ب",1,0],["وَمِن دونِ أَبوالِ الأُسودِ بَسالَةٌ","وَصَولَةُ أَيدٍ يَمنَعُ الضَيمَ طولُها",18,"ل",3,0],["ومِن دونِها نَيْلُ الغَمامِ إذا سرَتْ","نُجومُ القَنا الخَطّيِّ تُزْجي قِبابَها",19,"ب",3,0],["وَمَن دَنا مِن حَتفِهِ","لَم تُغنِ عَنهُ حِيَلُه",20,"ل",2,0],["وَمَن دَنا فَتَدَلّى نَحوَ خالِقِهِ","كَقابِ قَوسَينِ أَو أَدنى إِلى العُنُقِ",21,"ق",1,0],["وَمِن دَواءٍ سَنَةٍ جَمادِ","وَحَلَبَت مِن روقِهِ العَتادِ",22,"د",1,0],["وَمِن دونِ ما أَبدَيتَ لي يَقتُلُ الفَتى","وَيُمسي جَليدُ القَومِ وَهُوَ ضَعيفُ",23,"ف",1,1],["ومِن دون شِعْبٍ أنتَ حاميه معرَكٌ","وبيءٌ وتصْعيدٌ كَريهٌ وتصويب",24,"ب",1,0],["وَمَن دَعاني إِلَيهِ","طَرفٌ أَحَمُّ كَحيلُ",25,"ل",1,0],["وَمِن دِيارٍ عَفَت مَعالِمُها","رَيحانَةٌ رُكِّبَت عَلى أُذُنِ",26,"ن",1,0],["وَمُندَلِثٍ يُمارينا بِجَهدٍ","فَقُلتُ لَهُ تَعَلَّم ثُمَّ مارِ",27,"ر",1,0],["وَمِن دونِها اِختَلَفَت غالِبٌ","وَأَبعَدَ عُثمانُها جُندُبا",28,"ب",2,0],["وَمِن دونِ ما أَبدَيتُمُ خُضِبَ القَنا","وَمارَ نَجيعُ الخَيلِ في الهَبَواتِ",29,"ت",1,0],["وَمَن دايَنَ الأَيّامَ فَهيَ مَلِيَّةٌ","عَلى غَيِّها بِاللَيِّ وَالسَلَجانِ",30,"ن",1,0],["وَمِن دَونِ ذاكَ هَوِيٌّ لَهُ","هَوِيَّ القُطامِيّ لِلأَرنَبِ",31,"ب",1,0],["ومِنْ دُونِ حَيْثُ اسْتَوْقَدَتْ مِنْ ضَئِيَدةٍ","تَنَاهٍ بِهَا طَلْحٌ غَرِيبٌ وتَنْضُبُ",32,"ب",1,0],["ومن دمِ الشهداءِ الباعثين به","جيلاً من الحقِّ أو دنيا من الأملِ",33,"ل",1,0],["ومِن دونِها يومٌ من الشمسِ عاطِلٌ","وليلٌ بأطرافِ الأسِنّةِ حال",34,"ل",1,0],["وَمِن دُوَلِ المُستَهتِرينَ وَمَن غَدا","بِهِم طالِباً لِلنورِ في الظُلُماتِ",35,"ت",1,0],["ومِنْ دون الوصول إليه كانتْ","رُءُوسٌ في الهواء بها يُطاحُ؟",36,"ح",1,0],["ومن دون ذلك أن تَصطلوا","سعيرَ الحياة ، وان تَسغَبوا",37,"ب",3,0],["ومن دون ذلك تُشوَى الوجوهُ","وتُقذَى العيونُ ويُفرَى الادَمْ",38,"م",1,0],["وَمِن دونِ هَذا العِزِّ سَيفُ خِلافَةٍ","يَفوقُ الظُبى سَفحاً وَيَفضُلُها حَدّا",39,"د",2,0],["ومن درى بان ورد ظله","يقوى على حر الهجير صبرا",40,"ر",2,0],["ومن دعاهم إلى فحش ومخزية","وسوء فل وتخليط أجابوه",41,"ه",1,0],["وَمِن دونِ علمٍ كيفَ تحصلُ قوّةٌ","نَكفُّ بِها عنّا منَ المُعتدي الضرّا",42,"ر",2,0],["ومن دون الورى لما عناني","رماني بالبعاد وبالعناء",43,"ا",2,0],["ومن دعاني للمهمّ الذي","يُسَهِّل المستصعَب الوَعْرا",44,"ر",2,0],["ومن دموعكِ هاتيكَ السموطُ حكت","أبياتَ نونيّةٍ فيها شكاوينا",45,"ن",2,0],["وَمِنْ دُونِهم بِالسَّمْهَرِيةِ خَنْدقُوا","فَعَبَّدت الأَسْيافُ نَحْوَهُمُ طُرْقَا",46,"ق",2,0],["وَمَنْ دَانَ هَذا الدّينَ حَقّاً بِنَصْرِه","فَلَيْسَ له مِنْ أهْلِ دُنْيَاهُ خاذِلُ",47,"ل",1,0],["وَمِنْ دَجاجاتٍ إِذا ما كرْدِنَتْ","كَأَنَّما شَكَّ فُؤادِي شِيشُها",48,"ش",3,0],["وَمِن دُرِّ الحَبابِ لَها نِظامٌ","أَلا يا حَبَّذا ذاكَ النِظامُ",49,"م",1,0],["وَمن دينُهُ أَن لا مَساسَ وَإِنّهُ","لَيَقتُلُ مَن يَهواهُ بِالجِدِّ في المَزحِ",50,"ح",1,0],["وَمِن دونِهِ طَعنٌ كَأَنَّ رَشاشَهُ","عَزالى مَزادٍ وَالأَسِنَّةُ تَرذُمُ",51,"م",1,0],["وَمن دمِ كلِّ","شهيدٍ مداد",52,"د",1,0],["ومن دأب نفس المرء أن تكره السرى","فتحمده عند الصباح بشكران",53,"ن",1,0],["وَمِن دَمِها لِلأرْضِ خَدٌّ مُضَرَّجٌ","يَهِيمُ بِهِ قَلْبٌ وَيُفْتَنُ نَاظِرُ",54,"ر",1,0],["وَمِن دَرِّ ما اِستَخرَجَتهُ مِن قَرارِهِ","لِجيدِ العُلى سَمطٌ وَفي أُذُنها قَرطُ",55,"ط",1,0],["وَمِن دَرَجِ الصُعودِ إِلى المَعالي","إِلى دَرِ الهَوانَ بِهِ هَوَينا",56,"ن",2,0],["وَمَن دَأبه فعلُ الجَميل وَحَظّه","بِما فيهِ خَير لِلوَرى وَلَهُ الأَجرُ",57,"ر",1,0],["وَمِن دونِ أَحراسٍ وَقَد نَدَروا بِهِ","فَما خامَ حَتّى حَسَّه بِالأَصابِعِ",58,"ع",1,0],["ومِن دونها زُرْقُ الأسنّةِ شُرَّعٌ","إذا وردَتْها العَينُ ظلّتْ تَذودها",59,"د",3,0],["ومن دونِ فاتنةِ البِيضِ بيِضٌ","ومن دونِ ساكنةِ البيدِ بِيد",60,"د",1,0],["وَمِن دونِ تَصريفِ المُنى حَرفُ عِلَّةٍ","وَلَيسَ لَها إلّا عَزيمَةُ جازِمِ",61,"م",1,0],["ومن دفاف تُحيت الجنب نافذَةً","حمراءُ يخرجُ من حافاتِها النفسُ",62,"س",1,0],["ومن دون هذا أخرج الترك جدكم","ولو عاش أخلاكم بِحَدِّ البواتر",63,"ر",1,0],["وَمِن دونِها سوران سُورٌ مِنَ النَوى","وَسورٌ مِنَ الأَسيافِ وَالأسل السُمرِ",64,"ر",1,0],["ومِن دُونِهِ إن رابَ خطبٌ ذَوابلٌ","وبيضٌ وجردٌ لا القَتادَةُ والخُرْطُ",65,"ط",1,0],["ومِنْ دُونِ سِتْرَيْ عِفَّتِي وتَجَمُّلِي","لَرَيْبٌ وصَرْفٌ للزَّمانِ يَجُورُ",66,"ر",1,0],["ومِنْ دوننا آنِساتُ الدِّيارِ","نِهابَ الحِمى مُوحِشاتِ الطُّلُولِ",67,"ل",1,0],["ومن دان باستحلال أَكل لميتة","بغير اضطرار عند ما هي تؤكل",68,"ل",1,0],["ومن دمعةُ العاصي عليه كدمعتي","كأني جزءُ منه بد بُتَّ فانشطر",69,"ر",1,0],["ومن دمٍ تخوضه بلا دمٍ","على ثنايا البين أيدي البُدُنِ",70,"ن",1,0],["ومن دون ذلك رأيٌ يسد","دُ ناحيةَ الحادثِ المُفظِعِ",71,"ع",1,0],["ومن دونها البلدُ المقشعرُّ","يردّ ظباءَ المهارى ضباعا",72,"ع",2,0],["ومن دون ضيمي بسطةُ الأرض والسُّرى","وخوض الدياجي وامتعاضُ الفتى الحرِّ",73,"ر",1,0],["ومن دعا ومن سعى","واستنّ سبعاً وجَمَرْ",74,"ر",1,0],["ومن دونهاأن يخطبَ الليثُ هُدنةً","من الذئب أو يبكي من العطش الضبُّ",75,"ب",1,0],["ومن دون صبح العز ليلٌ مؤرِّقٌ","جعلتُ القوافي من تماديه سُمَّرا",76,"ر",2,0],["وَمَن دونَها مِن قِلَّةِ العَبرِ مُخرَمٌ","يُشَبِّهُهُ الرائي حِصاناً مُوَطَّنا",77,"ن",2,0],["وَمِن دونِ لَيلى سَبسَبٌ مُتَماحِلٌ","يُجيبُ صَداهُ اليَومَ حينَ يَصيحُ",78,"ح",1,0],["وَمِن دونِ ما أَسمو بِطَرفي لأَرضِهِم","مَفاوِزُ مُغبَرٌّ مِنَ التيهِ واسِعُ",79,"ع",1,0],["وَمِن دُون مَا حاوَلت مِن نكث عَهدهم","وأمكَ مَوتٌ يا ابنَ دَحمةَ ناقِعُ",80,"ع",1,0],["ومنْ دَهاهُ العَما عن نورِ مَشْهدهِ","فَقلبُهُ بِظلامِ الصَّدِّ مَكْمودُ",81,"د",1,0],["ومنْ دُونِ ما أَبْغِيهِ في كُلِّ مَوْطِنٍ","طِرادُ جِيادٍ وارْتِقاصُ صِعادِ",82,"د",1,0],["ومَن دافَعَ الأيّامَ عن مُهَجاتكمْ","وهنَّ أخيذاتٌ لأيدي المهالكِ",83,"ك",1,0],["ومن دعوناه للجلى اذا طرقت","والامر تفصيله قد كل عنه فمى",84,"م",2,0],["ومن درى ذاب ومن لا درى","وكلهم منطرح في حماه",85,"ا",2,0],["ومن دُونِ شُرب العيِن من ماءِ وجهه","ولم تَرْوَ مِنْه شربُ ماءِ المهنَّدِ",86,"د",1,0],["ومُندَمجِ العِطفَينِ يَجري وِشاحُه","على مِثلِ خُوطِ البانَةِ المتَأَوِّدِ",87,"د",1,0],["وَمِن دِمنَتَينِ بِجَنبِ الغَضا","وَأرسُمُنا بِالعَقيقِ الأُوَل",88,"ل",1,0],["ومن دَنسِ الرِّجسِ قد طُهِّروا","فيا فضلَ من بهمُ يَهتدي",89,"د",2,0],["وَمَن دقَّ أَبواب الكِرام تفتحت","لَهُ وَتَوارت عَن حِماه نَوائب",90,"ب",1,0],["وَمِن دونها للحفظ في كل بقعة","جسور لتيار المياه تقاوم",91,"م",1,0],["وَمِن دونِ ما مَنّى أُمَيَّةُ غَمرَةٌ","مِنَ المَوتِ ما يَخفى لِحينٍ خِلالُها",92,"ل",3,0],["ومَنْ دانَ مثلي بالودادِ لمِثْلكمْ","ففرْضٌ عليه رَعْيُه مدّةَ العُمْر",93,"ر",1,0],["ومن دونِ ذا يشتاقُ من كانَ ذا هَوى","ويعزُبُ عنه الحلمُ وهْوَ حليمُ",94,"م",1,0],["ومن دنس فيه تفاحش أنهم","أضلوا عن الإسلام من كان يسلم",95,"م",1,0],["وَمِن دونِها مَعبَرٌ واسِعٌ","وَأَجرٌ عَظيمٌ لِمَن يُؤجَرُ",96,"ر",1,0],["ومن دينه حبُّ السماحة والندى","ومن دينه بأبي التحسُّد والحرصا",97,"ص",2,0],["ومِنْ دينِه الإحسانُ والعدْلُ والتقى","وإكرامُ ذي الإملاقِ قبل سؤالهِ",98,"ل",2,0],["ومن دواه الهوى فالوجدُ يَهْتكه","ومن يبيتُ بداء الحب لم ينم",99,"م",1,0],["ومن دمائِكمْ غداً","فجَرُ العِراقِ طالِعُ",100,"ع",1,0],["ومن دون ملقاها مغاور عامر","وأسمر مياد وأجردُ شيظم",101,"م",1,0],["ومن دَرى مصيره إلى الثرى","أحال عِزّات الدُنى من مقلتيه",102,"ي",2,0],["ومن دينه فرض على كل مبصر","ومن حبه حتم على كل كيس",103,"س",1,0],["وَمِنْ دُرّ السحَاب لَهَا عقُود","ومن عَرْفِ النسيم لها سحابُ",104,"ب",1,0],["ومن دينه حب النبي وآله","وذلك دين لا محالة قيم",105,"م",1,0],["وَمِن دونِ بَدرِيَ بَدرُ الدُجى","سُمُوّاً عَلى الأَنجُمِ الزاهِيَه",106,"ي",2,0],["وَمِن دُونِهِ حَامَى أَخٌ ذُو حَظفِيظةٍ","كَرِيمُ النَّثَا وَالخِيمِ حُلوُ الشَّمَائِلِ",107,"ل",1,0],["وَمِن دون ما تَبغي عداتك نازل","مِن اللَه مَحتوم يبيد الأَعاديا",108,"ي",2,0],["ومن دونه بحر وَلَيل يَلُفّه","فَما ظَنُّه بِاللَيل في لُجّة البَحر",109,"ر",1,0],["ومن دونه عربٌ تريكم كفوفه","خيال حمار فوق حيطٍ ينهقُ",110,"ق",1,0],["ومن دنى إلى العلى","ولم يخالف من قصد",111,"د",1,0],["ومن دونِ فتحيَ فتحُ الوجوهِ","فعُدَّ الرّجوعَ من الفائده",112,"د",2,0],["وَمِن دون كُل الخَلق عولِجَت بِالأَسى","قَصاصاً وَحَسبي زَلَتي وَنَصائِلي",113,"ل",2,0],["وَمِن دونِهِ سَمَرٌ عِجافٌ صُدورُها","يقيلُ وَحَيُّ المَوتِ حَيثُ تقيلُ",114,"ل",1,0],["ومن دنا فتدلى نحو خالقه","لغاية دونها الأملاك تحتجب",115,"ب",1,0],["ومن دحرجَ الأعداءَ عنه أم التي","له دُحرجت تحتَ الظلامِ دُبابُها",116,"ب",3,0],["ومن دمها اقتنى جسداً طهوراً","يؤلِّهنا إلى أبد الدهور",117,"ر",1,0],["وَمِنْ دونِ أن يَغْتَرَّ بالعيشِ حازمٌ","حِمَامٌ بإحصاءِ النُّفُوسِ مُوَكّل",118,"ل",1,0],["ومن دلائلِ ما أُعْطِيْتَ من ظَفَرٍ","ألا يكونَ لهم رزقٌ ولا أجَل",119,"ل",1,0],["ومن دونها وخد المطي لواغبا","تجوب أكاماً في السرى وفيافيا",120,"ي",2,0],["ومن دونهُ يسمو الى المجد صاعداً","سموَّ دخان النار وهو وضيعُ",121,"ع",1,0],["وَمِن دالِعاتٍ أَلسُناً فَكَأَنَّها","لِحىً مِن رِجالٍ خاضِعينَ كَواسِجِ",122,"ج",1,0],["ومن داناه كان على سرور","ومن جافاه كان على اكتئاب",123,"ب",1,0],["ومن دهنها كأس يلذ لشارب","إليه اشتياقي لا إلى الكأس والخمر",124,"ر",1,0],["ومن دونه من ذي القرابة جائزٌ","وكالته من حيث يدنو وينزح",125,"ح",1,0],["ومن دروز أو حر","زأو كوز بالدغر",126,"ر",1,0],["ومن درّع أو قشّع","أو دمّع في القرّ",126,"ر",1,0],["ومن دكّك أو فكّ","ك أو بلّغك بالحر",126,"ر",1,0],["ومن دشَّش أو رشَّ","ش أو قشَّش يستدري",126,"ر",2,0],["ومن دهشم بالكرش","ويستبرد في النهر",126,"ر",1,0],["ومن دمَّج في الثلج","وف