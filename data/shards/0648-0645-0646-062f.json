ى الله يعافينا",203,"ن",2,0],["ومَن دَربُهُ الحُبُّ لم يَعنِهِ","إذا أَسرَعَ النَّاسُ أو أَبطَؤُوا",204,"ا",1,0],["ومن دون بِذره ولآ ميّه","مثل اللذي مآهو بدآري",205,"ر",2,0],["ومن دوحة الضاد البرابر إنهم","هم الأهل في أنسابهم والعشائر",206,"ر",1,0],["ومن دعا لي فهو اليوم منهمرٌ","عليه مني بصق الشائب اليفن",207,"ن",1,0],["ومن درى من نفسه قدره","أقدم مثل الأسد الكاسر",208,"ر",1,0],["ومن در راحته نكتفي","عن الدر في الزاخرات العظام",209,"م",1,0],["ومن دبر قدت بجذب قميصه","فتوسعه وصلا ويوسعها جرما",210,"م",2,0],["ومن دين إبراهيم ترفع للورى","مناراً مبيناً يوضح الحل والحرما",210,"م",2,0],["ومن دموعٍ تَ هُدُّ الروحَ أعرِفُها","أصلَ الشقاءِ، ومنهاالروحُ ترتَعِدُ",211,"د",1,0],["ومَن دَحَرَ التَّتَارَ عَلَى","ضِفَافِ النِّيلِ وانتَقَمَا",212,"م",2,0],["ومنْ دونِهِ الأيامُ يبعدنَ راحلاً","ويكتبنَ سفرَ الفقدِ في غيبةِ المعنى",213,"ن",2,0],["ومن (دَمُّونَ) جئتُ وكم شجونٍ","روى الشِّعرُ الأصيلُ بها قُدومَه",214,"م",2,0],["ومن دوسري مبغض متحامل","وآخر مرى غوى مماحل",215,"ل",1,0],["ومن دونه البحر الخضم وهوله","وأمواجه اللائي تشبه بالرعد",216,"د",1,0],["ومن درس الحياة فكل خطبٍ","يمر عليه لم يره فظيعا",217,"ع",2,0],["ومن دونه باب يلوح خلاله","صفائح ساج والحديد المسمر",218,"ر",1,0],["ومن دون كل الخلق عولجت بالأسى","قصاصا وحسبي زلتي وتضاؤلي",219,"ل",2,0],["ومن (دغال) و(بيت) في العلا ألِق","و(مسجد) سابح في النور كالحُلُم",220,"م",1,0],["ومن دفعِ الشراع بجوفِ ليلٍ","تفجَّرَ بالدخانِ وبالحَريقِ",221,"ق",1,0],["ومن دماء الضحايا في جوانبه","نار تمد اللسان المغلق الذربا",222,"ب",2,0],["وَمن دق بَابا غير بابك خاضعا","غَدا رَاجعا عَنهُ بصفقة مغبون",223,"ن",1,0],["ومن دان في دين الغرانيق هالك","شفيعاي عيناك اذا اقتيد مذنبُ",224,"ب",1,0],["ومن دموع بجنح الليل راجية","تناشد الصبح ان لا يكشف الغلسا",225,"س",2,0],["ومِنْ دنسِ الدّنْيا لِيرْضى خسيسها","تسوق شرِيفًا كي يقبِّل رأْسه",226,"ه",1,0],["ومن دماء الشهيد الحر يسفحها","على ضفا فيه نسقي ما غرسناه",227,"ا",2,0],["ومن دون الغرام العيش قفر","ذهاب قد تلاه غداً إياب",228,"ب",1,0],["ومن دون وصلش ما جزت ان كان ماجزتي","والحب وش هو بليا وصل ومواجه",