{"poems":[[53,"أأبقى كذا أبدا مستقلا","https://www.aldiwan.net/poem29898.html","المتقارب"],[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[53,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[63,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[3,"ترى هذه ريح أرض الشربه","https://www.aldiwan.net/poem124.html",""],[77,"لمن علم في هضبة الملك خفاق","https://www.aldiwan.net/poem35918.html","الطويل"],[77,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[35,"شجا أظعان غاضرة الغوادي","https://www.aldiwan.net/poem39157.html","الوافر"],[35,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[27,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[37,"ومن دون ذاك قسي المنون","https://www.aldiwan.net/poem7402.html","المتقارب"],[72,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[51,"أحباءنا ما كان لي عنكم صبر","https://www.aldiwan.net/poem64074.html","الطويل"],[29,"ألهى جريرا عن أبيه وأمه","https://www.aldiwan.net/poem6095.html","الطويل"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[28,"لعمري لقد أردى نوار وساقها","https://www.aldiwan.net/poem5375.html","الطويل"],[61,"على غير عتب ما طويت عتابها","https://www.aldiwan.net/poem51781.html","الطويل"],[58,"غر جهولا أمله","https://www.aldiwan.net/poem30924.html","مجزوء الرجز"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[44,"حماد من نوء له حماد","https://www.aldiwan.net/poem29694.html","الرجز"],[52,"ومن دون ما أبديت لي يقتل الفتى","https://www.aldiwan.net/poem26839.html","الطويل"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[48,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[48,"أحسن من وصف دارس الدمن","https://www.aldiwan.net/poem65306.html","المنسرح"],[50,"دعيني يا أميرة من سرار","https://www.aldiwan.net/poem63804.html","الوافر"],[46,"يؤدبك الدهر بالحادثات","https://www.aldiwan.net/poem22159.html","المتقارب"],[46,"ألا تتفقون الله رهط مسلم","https://www.aldiwan.net/poem22202.html","الطويل"],[46,"أرى فتيي دنياك إن حرج الفتى","https://www.aldiwan.net/poem23511.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[90,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[142,"أيا بؤس قوم حسان الشخوص","https://www.aldiwan.net/poem58400.html","المتقارب"],[143,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[160,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[186,"من طالب الناس بالإنصاف أحقدهم","https://www.aldiwan.net/poem44175.html","البسيط"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[210,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[229,"وابأبي من حسن الظن في","https://www.aldiwan.net/poem51051.html","السريع"],[270,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[275,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[275,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[280,"أقول واليوم بهيم خطبه","https://www.aldiwan.net/poem60605.html","الرجز"],[282,"قوامك ثم لحظك يا غلام","https://www.aldiwan.net/poem32625.html","الوافر"],[282,"إذا ما رأينا حسن وجه أبي الفتح","https://www.aldiwan.net/poem32823.html","الطويل"],[287,"لعمري لئن جدت عداوة بيننا","https://www.aldiwan.net/poem1908.html","الطويل"],[298,"حماة الديار","https://www.aldiwan.net/poem36297.html","عموديه"],[304,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[348,"نصف شهبا قد أرسلتها أهلة","https://www.aldiwan.net/poem20225.html","الطويل"],[349,"أأكشف حالا ستره في النهى شرط","https://www.aldiwan.net/poem15762.html","الطويل"],[349,"متى منا محب مدعينا","https://www.aldiwan.net/poem15978.html","الوافر"],[353,"بقدر النهى بين الورى يشرف القدر","https://www.aldiwan.net/poem40345.html","الطويل"],[363,"فلا تأمنونا إننا رهط جندب","https://www.aldiwan.net/poem1709.html","الطويل"],[364,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[364,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[366,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[396,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[403,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[406,"هي البدر لكن تستر مدى الدهر","https://www.aldiwan.net/poem50169.html","الطويل"],[409,"ومن علقت بالصالح الملك كفه","https://www.aldiwan.net/poem32218.html","الطويل"],[439,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[439,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[441,"فدونك من جزء الضياء مسائلاً","https://www.aldiwan.net/poem14413.html","الطويل"],[453,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[458,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[458,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[458,"بطرفك والمسحور يقسم بالسحر","https://www.aldiwan.net/poem56173.html","الطويل"],[458,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[458,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[461,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[466,"ألا طرقت ليلى فأحزن ذكرها","https://www.aldiwan.net/poem50373.html","الطويل"],[466,"تذكرت ليلى أن تغنت حمامة","https://www.aldiwan.net/poem50460.html","الطويل"],[470,"أقول بعمان وهل طربي به","https://www.aldiwan.net/poem4737.html","الطويل"],[470,"أفالآن لما بايعوا لضلالة","https://www.aldiwan.net/poem4740.html","الطويل"],[500,"هل العناية إلا أن ترى رجلا","https://www.aldiwan.net/poem38034.html","البسيط"],[529,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[551,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"إن الذي أكد وعدي وفاه","https://www.aldiwan.net/poem33660.html","السريع"],[575,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"]],"verses":[["وَمِن دونِ ضَيمي فِناءُ الرِماحِ","وَبيضُ القَواضِبِ ذَفّاً وَفَلّا",0,"ل",2,0],["وَمِن دَواءِ الداءِ أَن","ماطَلَ كَيٌّ عاجِلُ",1,"ل",1,0],["وَمِن دارِ أَحبابٍ نَبُلُّ طُلولَها","بِماءِ الأَماقِيَ أَو نُحَيّي جَنابَها",2,"ب",3,0],["ومنْ دونِهِ أمَدٌ نازِحٌ","إذا أَمَّهُ الطَّرْفُ أوهَى قُواهْ",3,"ا",2,0],["وَمِن دارِ عَبلَةَ نارٌ بَدَت","أَمِ البَرقُ سَلَّ مِنَ الغَيمِ عَضبَه",4,"ب",2,0],["ومنْ دونِ ما رامُوهُ للهِ قُدْرَةٌ","ومن دونِ ما أمّوهُ للفتْحِ أغْلاقُ",5,"ق",1,0],["ومن دونِ ما تَبْغيهِ يا ملِكَ العُلا","جيادُ المَذاكي والمحجَّلَةُ الغُرُّ",6,"ر",1,0],["وَمِن دُونِ الَّذي أَمَّلتُ وُدًّا","ولَو طالبتُها خَرطُ القَتادِ",7,"د",1,0],["وَمِن دون حَيثُ اِستُوقِدَت مِن مُجالِخٍ","مَراحٌ وَمُغدًى للمَطِيِّ وَسَبسَبُ",8,"ب",1,0],["وَمِن دونِهِ تيهٌ كَأَنَّ شِخاصَها","يَحُلنَ بِأَمثالٍ فَهُنَّ شَوافِعُ",9,"ع",1,0],["ومن دون ذاك قِسي المنو","ن لا الفوقُ نَبْلاً ولا النُّصَّلُ",10,"ل",1,1],["ومن دُرَر","فيها سمر",11,"ر",1,0],["ومَندل الهند الذي يُرتَضَى","يُقسَم في الناس ولا نُذكرُ",12,"ر",1,0],["ومن دونِ ما قد سُمْتني في كرائمي","يقول امرُؤٌ نعم البُعولُ المقابر",13,"ر",1,0],["ومن دونه هولٌ ومن تحته ردىً","ومن فوقه سيفٌ ومن تحته بحر",14,"ر",1,0],["وَمِن دونِهِ يَحطاطُ أَوسُ بنُ مُدلِجٍ","وَإِيّاهُ يَخشى طارِقٌ وَزَنيقُ",15,"ق",1,0],["وَمِن دونِها أَن لا تُلِمَّ بِخاطِرٍ","قُصورُ الوَرى عَن وَصلِها وَقُصورُها",16,"ر",3,0],["ومن دموع السحب","إلى انكماش الأرنب",17,"ب",1,0],["وَمِن دونِ أَبوالِ الأُسودِ بَسالَةٌ","وَصَولَةُ أَيدٍ يَمنَعُ الضَيمَ طولُها",18,"ل",3,0],["ومِن دونِها نَيْلُ الغَمامِ إذا سرَتْ","نُجومُ القَنا الخَطّيِّ تُزْجي قِبابَها",19,"ب",3,0],["وَمَن دَنا مِن حَتفِهِ","لَم تُغنِ عَنهُ حِيَلُه",20,"ل",2,0],["وَمَن دَنا فَتَدَلّى نَحوَ خالِقِهِ","كَقابِ قَوسَينِ أَو أَدنى إِلى العُنُقِ",21,"ق",1,0],["وَمِن دَواءٍ سَنَةٍ جَمادِ","وَحَلَبَت مِن روقِهِ العَتادِ",22,"د",1,0],["وَمِن دونِ ما أَبدَيتَ لي يَقتُلُ الفَتى","وَيُمسي جَليدُ القَومِ وَهُوَ ضَعيفُ",23,"ف",1,1],["ومِن دون شِعْبٍ أنتَ حاميه معرَكٌ","وبيءٌ وتصْعيدٌ كَريهٌ وتصويب",24,"ب",1,0],["وَمَن دَعاني إِلَيهِ","طَرفٌ أَحَمُّ كَحيلُ",25,"ل",1,0],["وَمِن دِيارٍ عَفَت مَعالِمُها","رَيحانَةٌ رُكِّبَت عَلى أُذُنِ",26,"ن",1,0],["وَمُندَلِثٍ يُمارينا بِجَهدٍ","فَقُلتُ لَهُ تَعَلَّم ثُمَّ مارِ",27,"ر",1,0],["وَمِن دونِها اِختَلَفَت غالِبٌ","وَأَبعَدَ عُثمانُها جُندُبا",28,"ب",2,0],["وَمِن دونِ ما أَبدَيتُمُ خُضِبَ القَنا","وَمارَ نَجيعُ الخَيلِ في الهَبَواتِ",29,"ت",1,0],["وَمَن دايَنَ الأَيّامَ فَهيَ مَلِيَّةٌ","عَلى غَيِّها بِاللَيِّ وَالسَلَجانِ",30,"ن",1,0],["وَمِن دَونِ ذاكَ هَوِيٌّ لَهُ","هَوِيَّ القُطامِيّ لِلأَرنَبِ",31,"ب",1,0],["ومن دمِ الشهداءِ الباعثين به","جيلاً من الحقِّ أو دنيا من الأملِ",32,"ل",1,0],["ومِن دونِها يومٌ من الشمسِ عاطِلٌ","وليلٌ بأطرافِ الأسِنّةِ حال",33,"ل",1,0],["وَمِن دُوَلِ المُستَهتِرينَ وَمَن غَدا","بِهِم طالِباً لِلنورِ في الظُلُماتِ",34,"ت",1,0],["ومِنْ دون الوصول إليه كانتْ","رُءُوسٌ في الهواء بها يُطاحُ؟",35,"ح",1,0],["ومن دون ذلك أن تَصطلوا","سعيرَ الحياة ، وان تَسغَبوا",36,"ب",3,0],["ومن دون ذلك تُشوَى الوجوهُ","وتُقذَى العيونُ ويُفرَى الادَمْ",37,"م",1,0],["وَمِن دونِ هَذا العِزِّ سَيفُ خِلافَةٍ","يَفوقُ الظُبى سَفحاً وَيَفضُلُها حَدّا",38,"د",2,0],["ومن درى بان ورد ظله","يقوى على حر الهجير صبرا",39,"ر",2,0],["ومن دعاهم إلى فحش ومخزية","وسوء فل وتخليط أجابوه",40,"ه",1,0],["وَمِن دونِ علمٍ كيفَ تحصلُ قوّةٌ","نَكفُّ بِها عنّا منَ المُعتدي الضرّا",41,"ر",2,0],["ومن دون الورى لما عناني","رماني بالبعاد وبالعناء",42,"ا",2,0],["ومن دعاني للمهمّ الذي","يُسَهِّل المستصعَب الوَعْرا",43,"ر",2,0],["ومن دموعكِ هاتيكَ السموطُ حكت","أبياتَ نونيّةٍ فيها شكاوينا",44,"ن",2,0],["وَمِنْ دُونِهم بِالسَّمْهَرِيةِ خَنْدقُوا","فَعَبَّدت الأَسْيافُ نَحْوَهُمُ طُرْقَا",45,"ق",2,0],["وَمَنْ دَانَ هَذا الدّينَ حَقّاً بِنَصْرِه","فَلَيْسَ له مِنْ أهْلِ دُنْيَاهُ خاذِلُ",46,"ل",1,0],["وَمِنْ دَجاجاتٍ إِذا ما كرْدِنَتْ","كَأَنَّما شَكَّ فُؤادِي شِيشُها",47,"ش",3,0],["وَمِن دُرِّ الحَبابِ لَها نِظامٌ","أَلا يا حَبَّذا ذاكَ النِظامُ",48,"م",1,0],["وَمن دينُهُ أَن لا مَساسَ وَإِنّهُ","لَيَقتُلُ مَن يَهواهُ بِالجِدِّ في المَزحِ",49,"ح",1,0],["وَمِن دونِهِ طَعنٌ كَأَنَّ رَشاشَهُ","عَزالى مَزادٍ وَالأَسِنَّةُ تَرذُمُ",50,"م",1,0],["وَمن دمِ كلِّ","شهيدٍ مداد",51,"د",1,0],["ومن دأب نفس المرء أن تكره السرى","فتحمده عند الصباح بشكران",52,"ن",1,0],["وَمِن دَمِها لِلأرْضِ خَدٌّ مُضَرَّجٌ","يَهِيمُ بِهِ قَلْبٌ وَيُفْتَنُ نَاظِرُ",53,"ر",1,0],["وَمِن دَرِّ ما اِستَخرَجَتهُ مِن قَرارِهِ","لِجيدِ العُلى سَمطٌ وَفي أُذُنها قَرطُ",54,"ط",1,0],["وَمِن دَرَجِ الصُعودِ إِلى المَعالي","إِلى دَرِ الهَوانَ بِهِ هَوَينا",55,"ن",2,0],["وَمَن دَأبه فعلُ الجَميل وَحَظّه","بِما فيهِ خَير لِلوَرى وَلَهُ الأَجرُ",56,"ر",1,0],["وَمِن دونِ أَحراسٍ وَقَد نَدَروا بِهِ","فَما خامَ حَتّى حَسَّه بِالأَصابِعِ",57,"ع",1,0],["ومِن دونها زُرْقُ الأسنّةِ شُرَّعٌ","إذا وردَتْها العَينُ ظلّتْ تَذودها",58,"د",3,0],["ومن دونِ فاتنةِ البِيضِ بيِضٌ","ومن دونِ ساكنةِ البيدِ بِيد",59,"د",1,0],["وَمِن دونِ تَصريفِ المُنى حَرفُ عِلَّةٍ","وَلَيسَ لَها إلّا عَزيمَةُ جازِمِ",60,"م",1,0],["ومن دفاف تُحيت الجنب نافذَةً","حمراءُ يخرجُ من حافاتِها النفسُ",61,"س",1,0],["ومن دون هذا أخرج الترك جدكم","ولو عاش أخلاكم بِحَدِّ البواتر",62,"ر",1,0],["وَمِن دونِها سوران سُورٌ مِنَ النَوى","وَسورٌ مِنَ الأَسيافِ وَالأسل السُمرِ",63,"ر",1,0],["ومِن دُونِهِ إن رابَ خطبٌ ذَوابلٌ","وبيضٌ وجردٌ لا القَتادَةُ والخُرْطُ",64,"ط",1,0],["ومِنْ دُونِ سِتْرَيْ عِفَّتِي وتَجَمُّلِي","لَرَيْبٌ وصَرْفٌ للزَّمانِ يَجُورُ",65,"ر",1,0],["ومِنْ دوننا آنِساتُ الدِّيارِ","نِهابَ الحِمى مُوحِشاتِ الطُّلُولِ",66,"ل",1,0],["ومن دان باستحلال أَكل لميتة","بغير اضطرار عند ما هي تؤكل",67,"ل",1,0],["ومن دمعةُ العاصي عليه كدمعتي","كأني جزءُ منه بد بُتَّ فانشطر",68,"ر",1,0],["ومن دمٍ تخوضه بلا دمٍ","على ثنايا البين أيدي البُدُنِ",69,"ن",1,0],["ومن دون ذلك رأيٌ يسد","دُ ناحيةَ الحادثِ المُفظِعِ",70,"ع",1,0],["ومن دونها البلدُ المقشعرُّ","يردّ ظباءَ المهارى ضباعا",71,"ع",2,0],["ومن دون ضيمي بسطةُ الأرض والسُّرى","وخوض الدياجي وامتعاضُ الفتى الحرِّ",72,"ر",1,0],["ومن دعا ومن سعى","واستنّ سبعاً وجَمَرْ",73,"ر",1,0],["ومن دونهاأن يخطبَ الليثُ هُدنةً","من الذئب أو يبكي من العطش الضبُّ",74,"ب",1,0],["ومن دون صبح العز ليلٌ مؤرِّقٌ","جعلتُ القوافي من تماديه سُمَّرا",75,"ر",2,0],["وَمَن دونَها مِن قِلَّةِ العَبرِ مُخرَمٌ","يُشَبِّهُهُ الرائي حِصاناً مُوَطَّنا",76,"ن",2,0],["وَمِن دونِ لَيلى سَبسَبٌ مُتَماحِلٌ","يُجيبُ صَداهُ اليَومَ حينَ يَصيحُ",77,"ح",1,0],["وَمِن دونِ ما أَسمو بِطَرفي لأَرضِهِم","مَفاوِزُ مُغبَرٌّ مِنَ التيهِ واسِعُ",78,"ع",1,0],["وَمِن دُون مَا حاوَلت مِن نكث عَهدهم","وأمكَ مَوتٌ يا ابنَ دَحمةَ ناقِعُ",79,"ع",1,0],["ومنْ دَهاهُ العَما عن نورِ مَشْهدهِ","فَقلبُهُ بِظلامِ الصَّدِّ مَكْمودُ",80,"د",1,0],["ومنْ دُونِ ما أَبْغِيهِ في كُلِّ مَوْطِنٍ","طِرادُ جِيادٍ وارْتِقاصُ صِعادِ",81,"د",1,0],["ومَن دافَعَ الأيّامَ عن مُهَجاتكمْ","وهنَّ أخيذاتٌ لأيدي المهالكِ",82,"ك",1,0],["ومن دعوناه للجلى اذا طرقت","والامر تفصيله قد كل عنه فمى",83,"م",2,0],["ومن درى ذاب ومن لا درى","وكلهم منطرح في حماه",84,"ا",2,0],["ومن دُونِ شُرب العيِن من ماءِ وجهه","ولم تَرْوَ مِنْه شربُ ماءِ المهنَّدِ",85,"د",1,0]]}