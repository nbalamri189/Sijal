,[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66128","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120495","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120556","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120488","الكامل"],[4852,"أنبائيه","https://www.poetsgate.com/ViewPoem.aspx?id=214301",""],[5031,"صرخة صامتة الى ابي الطيب المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=148227",""],[5212,"قبرُ البدور","https://www.poetsgate.com/ViewPoem.aspx?id=212057",""],[5224,"يا نديمي قم فإن الديك صاح","https://www.poetsgate.com/ViewPoem.aspx?id=121313",""],[5320,"حى راق","https://www.poetsgate.com/ViewPoem.aspx?id=43263",""],[5376,"يا جلق المجد والعلياء من زمن","https://www.poetsgate.com/ViewPoem.aspx?id=188535",""],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""],[5431,"تعريف المثقف","https://www.poetsgate.com/ViewPoem.aspx?id=183097",""],[5431,"والحب لا يتقسمُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198932",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[5725,"عرس بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177970",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5781,"فاكهةُ الشِّتاءِ ومُتعةُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185318",""],[5786,"حتّامَ دمعك في الأطلال ينسكبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50654",""],[5829,"اعلان حب هام","https://www.poetsgate.com/ViewPoem.aspx?id=150261",""],[5851,"بعض من نياط القلب","https://www.poetsgate.com/ViewPoem.aspx?id=175284",""],[5956,"حمداً لرب العالمين كثيرا","https://www.poetsgate.com/ViewPoem.aspx?id=206980",""],[520,"هذي مناجاة عبد رق حاسده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577501",""],[6177,"معراج العاشقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79590&r=&rc=26",""]],"verses":[["إِنّي شَرِبتُ مِنَ الهَوى","حَمراءَ صَرَّفَ ساقِياها",0,"ا",3,0],["أن يشأ فالصغار غير صغار","وعظام الرجال غير عظام",1,"م",1,0],["إِنّي شَكَرتُ وَقَد جَرَّبتُ أَنَّكُمُ","عَلى رِجالٍ وَإِن لَم يَشكُروا عُطُفُ",2,"ف",1,0],["إِن يَشغَبوا لا يُبالِ شَغبَهُمُ","أَو يَقصِدوا في الحُكومِ يَقتَصِدِ",3,"د",1,0],["إن يشبه الأسلاف أخلاق لقد","رضع الرجا منها الغمام المغدقا",4,"ق",2,0],["إِنيّ شَيخٌ كَبيرٌ","في عُلُوِّ الدارجاتِ",5,"ت",1,0],["إني شهيدٌ بأنك اليوم إن","غاب فُواقاً فُجِّعت بالصبر",6,"ر",1,0],["إن يُشْقني اللَّه بعد المحسنينَ به","فكم شقيتُ بحُسنٍ بعد بُستان",7,"ن",1,0],["إِنّي شَهِدتُ الحُسنَ غَيرَ مُزَيَّفٍ","بِئسَ الجَمالُ مُزَيَّفا وَمُزَوَّرا",8,"ر",2,0],["إِن يَشرَبِ الجِسمُ بَردَ الوَصلِ مُنتَعِشاً","يُهدي إِلَيهِ فُؤادي حَرَّ ما يَجِدُ",9,"د",1,0],["إِنّي شَهِدتُ كِراماً مِن مَواطِنِهِ","لَيسَت بِغَيبٍ وَلا تَقوالِ ذي هَذَرِ",10,"ر",1,0],["أَني شَفَيْتُ بِقُرْبِ مَجْدِكَ سَاعَةً","من لَهْفَةِ القَلْبِ المَشُوقِ غَلِيلا",11,"ل",2,0],["إنِّي شَمِمُتُ ثرًى عفناً يضمُّكما","وفي لُهاثيَ منه عِطرُ «دارين»",12,"ن",1,0],["إن يُشيروا بما علمتَ فإنّي","لأَدعُّ الهوى وأعصي المشيرا",13,"ر",2,0],["أَنّى شَبابُكَ قَد مَضى مَحمودا","وَدَعِ الغَوانِيَ إِن أَرَدنَ صُدودا",14,"د",2,1],["إن يَشأ أرسلها فوق الوجودْ","فإذا الكونُ هشيمٌ وهباءْ",15,"ا",2,0],["إن يشركوني في ليلى فلا رجعت","جبال نجد لهم صوتاً ولا البيد",16,"د",1,0],["إِني شَهِدْتُ شَهَادَةً العَيْنَيْنِ ما","عَانَيْتَ فِي الغدُوَاتِ وَالآصالِ",17,"ل",1,0],["ان يشرف الناس في الدنيا بثروتهم","فثروة القوم اخلاص وايقان",18,"ن",1,0],["أني شآمي إذا نسب الهوى","وإذا نسبت لموطن فعراقي",19,"ق",2,0],["إنّي شَرِبْتُ الكأسَ سُمًّا ناقِعًا","لِتُدارَ عِندَ شِفاهِكُمْ أَكوابُ",20,"ب",1,0],["إني شعفتُ بدله ودلاله","وبحسنِ منظره وإن لم يحسنِ",21,"ن",1,0],["أني شغلت بمعراضٍ أخي مللٍ","فلست أدري أفوق الأرض سكان",22,"ن",1,0],["إني شقيت بها منها فواضجرى","من المعيشة في أكناف أحزاني",23,"ن",2,0],["إِنّي شَكَرتُ لِظالِمي ظُلمي","وَغَفَرتُ ذاكَ لَهُ عَلى عِلمِ",24,"م",1,1],["إن يَشْكُرِ السّلطانُ غُرَّ فَضائلٍ","وشمائلٍ لك فالرّعيّةُ أشكَر",25,"ر",1,0],["إن يشأْ عند ذاك يَنثُرُ دُرّاً","أو يشَأْ بعد ذاك يَنظِمُ عِقْدا",26,"د",2,0],["أَن يَشتَبه أَمر فَأَقوالُهُ","حجة مَن يَبغي الصِراط القَويم",27,"م",1,0],["إِن يَشَربوا يَهَبوا وَإِن يَذَروا","يَتَواعَظوا عَن مَنطِقِ الهُجرِ",28,"ر",1,0],["إِنْ يُشْجَ أَلّا يُسَمَّى عارِضاً أَبَداً","يُسَلِّهِ أَنْ يُسَمَّى عارِضاً غَدِقا",29,"ق",2,0],["إني شقيت فهل من فضل عاطفة","علي تسعد جدي أو تساعده",30,"د",2,0],["إِن يَشكُر الناسُ ما أَولَيتَ مِن حَسَنٍ","فَقَد وَسَعتَ بَني حَوّاءَ إِنعاما",31,"م",2,0],["إن يشأ عنه قال وحدة حق","أو يشأ وحدة الوجود تحق",32,"ق",1,0],["إِن يُشترَط نَظرُ المُكَلَّفِ تَتَّفِق","آراؤُهُ في نَهجِها المُتَعاظِمِ",33,"م",1,0],["إِن يَشِب مَفرِقي فَإِنَّ قُرَيشاً","جَعَلَت بينَها الحُروبُ حُروبا",34,"ب",2,0],["إني شكرتك شكر الروض للمطر","يا ذا الندى والأيادي البيض في البشر",35,"ر",1,1],["إنْ يَشْتَبِهْ رأْيانِ في","شَيءٍ من الأشْيا عَلَيكْ",36,"ك",1,1],["إني شهيد العهد مط","ويّاً بقفر أو بقصر",37,"ر",1,0],["إني شكرتُ زماناً","كساني البرء بُردا",38,"د",2,0],["إن يشهدوا يوجد المعروف عَندهم","خِدناً وليس إذا غابوا بموجود",39,"د",1,0],["إني شهاب قد أعِد لرَجْمه","إن يَلْقَه يُنْكله كل نكول",40,"ل",1,0],["أَن يُشبِهوكَ وَلا شَبيهَ نَرى لَكُم","في الخَلقِ أَينَ مِنَ اللُجَينِ الزِئبَقُ",41,"ق",1,0],["ان يشحّ الزمان أو يخفر العهد","ويجفو فأنت فضل الزمان",42,"ن",1,0],["إِني شَيخ لَيسَ بي حراك","يَخشى وَما مِن عادَتي العراك",43,"ك",1,0],["اني شكوت من الزمان وأهله","دهراً ويؤلمني بأن لم أشكر",44,"ر",1,0],["إن يشترك لفظ في الاسم فاعتمد","جوازه وذاك نوع قد حمد",45,"د",1,0],["إِنْ يَشْتَكِ السَّيْفُ فِي يَوْمِ الوَغَى قِصَراً","فَوَصْلُهُ خَطْوُهَا زَحْفاً وَأَيْدِيهَا",46,"ي",3,0],["إن يشق أعلاي باللطام فقد","يسعد بالرهز بعده سفلي",47,"ل",2,0],["أن يشاقق في زينها الحسن الزا","كي فهذا مما جنته يداها",48,"ا",3,0],["إِن يَشتَفى كُلٌّ بِوَصلِ حَبِيبهِ","فَعَمِيدُ حُبِّى لَم يَزَل مُتَضَاعِفا",49,"ف",2,0],["إني شغلت به النفس الضعيفة إذ","أصحاب جنته الأعلون في شغل",50,"ل",1,0],["إني شريكك في صُلبٍ وفي رحم","وفي طباعٍ وفي مربى وفي لبن",51,"ن",1,0],["إن يشمتوا فلقد رغمت أنوفهم","بمفاخر شهدت