{"poems":[[53,"عاد الهوى بظباء مك","https://www.aldiwan.net/poem29630.html","مجزوء الكامل"],[88,"زهرة قد بدت من الأكمام","https://www.aldiwan.net/poem44428.html","الخفيف"],[27,"انظر خليلي بأعلى ثرمداء ضحى","https://www.aldiwan.net/poem5927.html","البسيط"],[4,"ما إن تعري المنون من أحد","https://www.aldiwan.net/poem21157.html","المنسرح"],[72,"قال العذول فزاد قلبا شيقا","https://www.aldiwan.net/poem19352.html","الكامل"],[64,"أقتلوني يا ثقاتي","https://www.aldiwan.net/poem67662.html","الرمل"],[51,"الحمد لله لا شريك له","https://www.aldiwan.net/poem64017.html","المنسرح"],[51,"أبو سليمان لا ترضى طريقته","https://www.aldiwan.net/poem66494.html","البسيط"],[91,"أنا لست في دنيا الخيال ولا الكرى","https://www.aldiwan.net/poem8868.html","عموديه"],[78,"يا جاهل الحب إن الحب لي سند","https://www.aldiwan.net/poem14242.html","البسيط"],[2,"هل تبلغني إلى الأخيار ناجية","https://www.aldiwan.net/poem25028.html","البسيط"],[90,"ياسيدي أسعف فمي ليقولا","https://www.aldiwan.net/poem56781.html","عموديه"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[50,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202695","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[90,"إبن الشام","https://www.poetsgate.com/ViewPoem.aspx?id=178945",""],[115,"يوم الشَّنق","https://www.aldiwan.net/poem24032.html","الكامل"],[117,"أشكو لذي الإحسان عبد المحسن","https://www.aldiwan.net/poem4333.html","الكامل"],[118,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[209,"كان الغرام بأرض كدت أذكرها","https://www.aldiwan.net/poem46277.html","البسيط"],[336,"إني شكرت لظالمي ظلمي","https://www.aldiwan.net/poem68646.html","أحذ الكامل"],[362,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[362,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[377,"الحمد لله الذي حمده","https://www.aldiwan.net/poem48751.html","السريع"],[425,"لا يبعدن قومي الذين هم","https://www.aldiwan.net/poem766.html",""],[436,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[513,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[551,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[556,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[561,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"]],"verses":[["إِنّي شَرِبتُ مِنَ الهَوى","حَمراءَ صَرَّفَ ساقِياها",0,"ا",3,0],["أن يشأ فالصغار غير صغار","وعظام الرجال غير عظام",1,"م",1,0],["إِنّي شَكَرتُ وَقَد جَرَّبتُ أَنَّكُمُ","عَلى رِجالٍ وَإِن لَم يَشكُروا عُطُفُ",2,"ف",1,0],["إِن يَشغَبوا لا يُبالِ شَغبَهُمُ","أَو يَقصِدوا في الحُكومِ يَقتَصِدِ",3,"د",1,0],["إن يشبه الأسلاف أخلاق لقد","رضع الرجا منها الغمام المغدقا",4,"ق",2,0],["إِنيّ شَيخٌ كَبيرٌ","في عُلُوِّ الدارجاتِ",5,"ت",1,0],["إني شهيدٌ بأنك اليوم إن","غاب فُواقاً فُجِّعت بالصبر",6,"ر",1,0],["إن يُشْقني اللَّه بعد المحسنينَ به","فكم شقيتُ بحُسنٍ بعد بُستان",7,"ن",1,0],["إِنّي شَهِدتُ الحُسنَ غَيرَ مُزَيَّفٍ","بِئسَ الجَمالُ مُزَيَّفا وَمُزَوَّرا",8,"ر",2,0],["إِن يَشرَبِ الجِسمُ بَردَ الوَصلِ مُنتَعِشاً","يُهدي إِلَيهِ فُؤادي حَرَّ ما يَجِدُ",9,"د",1,0],["إِنّي شَهِدتُ كِراماً مِن مَواطِنِهِ","لَيسَت بِغَيبٍ وَلا تَقوالِ ذي هَذَرِ",10,"ر",1,0],["أَني شَفَيْتُ بِقُرْبِ مَجْدِكَ سَاعَةً","من لَهْفَةِ القَلْبِ المَشُوقِ غَلِيلا",11,"ل",2,0],["إنِّي شَمِمُتُ ثرًى عفناً يضمُّكما","وفي لُهاثيَ منه عِطرُ «دارين»",12,"ن",1,0],["إن يُشيروا بما علمتَ فإنّي","لأَدعُّ الهوى وأعصي المشيرا",13,"ر",2,0],["أَنّى شَبابُكَ قَد مَضى مَحمودا","وَدَعِ الغَوانِيَ إِن أَرَدنَ صُدودا",14,"د",2,1],["إن يَشأ أرسلها فوق الوجودْ","فإذا الكونُ هشيمٌ وهباءْ",15,"ا",2,0],["إن يشركوني في ليلى فلا رجعت","جبال نجد لهم صوتاً ولا البيد",16,"د",1,0],["إِني شَهِدْتُ شَهَادَةً العَيْنَيْنِ ما","عَانَيْتَ فِي الغدُوَاتِ وَالآصالِ",17,"ل",1,0],["أني شآمي إذا نسب الهوى","وإذا نسبت لموطن فعراقي",18,"ق",2,0],["إنّي شَرِبْتُ الكأسَ سُمًّا ناقِعًا","لِتُدارَ عِندَ شِفاهِكُمْ أَكوابُ",19,"ب",1,0],["إني شعفتُ بدله ودلاله","وبحسنِ منظره وإن لم يحسنِ",20,"ن",1,0],["أني شغلت بمعراضٍ أخي مللٍ","فلست أدري أفوق الأرض سكان",21,"ن",1,0],["إني شقيت بها منها فواضجرى","من المعيشة في أكناف أحزاني",22,"ن",2,0],["إِنّي شَكَرتُ لِظالِمي ظُلمي","وَغَفَرتُ ذاكَ لَهُ عَلى عِلمِ",23,"م",1,1],["إن يَشْكُرِ السّلطانُ غُرَّ فَضائلٍ","وشمائلٍ لك فالرّعيّةُ أشكَر",24,"ر",1,0],["إن يشأْ عند ذاك يَنثُرُ دُرّاً","أو يشَأْ بعد ذاك يَنظِمُ عِقْدا",25,"د",2,0],["أَن يَشتَبه أَمر فَأَقوالُهُ","حجة مَن يَبغي الصِراط القَويم",26,"م",1,0],["إِن يَشَربوا يَهَبوا وَإِن يَذَروا","يَتَواعَظوا عَن مَنطِقِ الهُجرِ",27,"ر",1,0],["إِنْ يُشْجَ أَلّا يُسَمَّى عارِضاً أَبَداً","يُسَلِّهِ أَنْ يُسَمَّى عارِضاً غَدِقا",28,"ق",2,0],["إني شقيت فهل من فضل عاطفة","علي تسعد جدي أو تساعده",29,"د",2,0],["إِن يَشكُر الناسُ ما أَولَيتَ مِن حَسَنٍ","فَقَد وَسَعتَ بَني حَوّاءَ إِنعاما",30,"م",2,0],["إن يشأ عنه قال وحدة حق","أو يشأ وحدة الوجود تحق",31,"ق",1,0],["إِن يُشترَط نَظرُ المُكَلَّفِ تَتَّفِق","آراؤُهُ في نَهجِها المُتَعاظِمِ",32,"م",1,0]]}