m/ViewPoem.aspx?id=207731",""],[5183,"لشيخنا ابن عُبيد","https://www.poetsgate.com/ViewPoem.aspx?id=180219",""],[5198,"قلب للبيع","https://www.poetsgate.com/ViewPoem.aspx?id=136105",""],[5434,"البسيطا","https://www.poetsgate.com/ViewPoem.aspx?id=139690",""],[709,"سَلاَمٌ حَكَى في حُسْنِهِ لُؤلُؤَ الْعِقْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=2980",""],[5582,"أَلا حَدِّثانِي عَنْ رُسُومِ المَعاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63501",""],[5648,"ريح ضميرك","https://www.poetsgate.com/ViewPoem.aspx?id=154661",""],[402,"وأقبل الأمن بآلآئه","https://www.poetsgate.com/ViewPoem.aspx?id=36336",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5964,"على الخيف من أكناف برقة أطلال","https://www.poetsgate.com/ViewPoem.aspx?id=181306",""]],"verses":[["إِلى أَبي أَحمَدٍ صَدَعتُ بِها","قَلبَ الدُجى وَالضَميرُ يَضطَرِمُ",0,"م",1,0],["إِلى أَبلَجٍ كَالبَدرِ يُشرِقُ وَجهُهُ","سَناءً إِذا اِلتَفَّت عَلَيهِ المَواكِبُ",1,"ب",1,0],["إِلى اِبنِ أَبي العاصي بِدَوَّةَ أَرقَلَت","وَبِالسَفحِ مِن ذاتِ الرُبى فَوقَ مُظعِنِ",2,"ن",1,0],["إلى أبيك الوجه في قومه","أهديت بالتكريم هذا الكتاب",3,"ب",1,0],["إِلى إِبِلِ الزُرقِ أَوطانِ أَهلِها","يَحُلّونَ مِنها كُلَّ عَلياءَ مُعلَمِ",4,"م",1,0],["إِلى اِبنِ أَبي العاصي هِشامٍ تَعَسَّفَت","بِنا العيسُ مِن حَيثُ اِلتَقى الغافُ وَالرَملُ",5,"ل",1,0],["إِلى اِبنِ العامِريِّ إِلى بِلالٍ","قَطَعتُ بِنَعفٍ مَعقُلَةَ العِدالا",6,"ل",2,0],["إِلى اِبنِ أَبي موسى بِلالٍ تَكَلَّفَت","بِنا البُعدَ أَنقاضُ الغُرَيرِيَّةِ السُجرِ",7,"ر",1,0],["إِلى اِبنِ أَبي موسى بِلالٍ طَوَت بِنا","قلِاصٌ أَبوهُنَّ الجَديلُ وَداعِرُ",8,"ر",1,0],["إِلى اِبنِ أَسيدٍ خالِدٍ أَرقَلَت بِنا","مَسانيفُ تَعرَوري فَلاةً تَغَوَّلُ",9,"ل",1,0],["إلى ابن محمد أهدي كتابي","وقد يُهدَى القليل إلى الكريم",10,"م",1,1],["إِلى أَبي جَعفَرٍ خاضَت رَكائِبُنا","خِطارَ لَيلٍ مَهولِ الخَرقِ مَرهوبِ",11,"ب",1,0],["إِلى اِبنِ أَبي مُحَمَّدٍ اِستَقَلَّت","بِنا قَصدَ السُرى مَيلُ السُروبِ",12,"ب",1,0],["إِلى أَبي نَهشَلٍ ظَلَّت رَكائِبُنا","يَخدينَ مِن بَلَدٍ ناءٍ إِلى بَلَدِ",13,"د",1,0],["إِلى ابنِ أَميرِ المُؤمِنينَ تَناهَبَت","بِنا العيسُ دَيجوراً مِنَ اللَيلِ أَسوَدا",14,"د",2,0],["إِلى أَبيَضِ الأَخلاقِ ما مَرَّ أَبيَضٌ","مِنَ الدَهرِ إِلّا عَن جَداً مِنهُ أَو رِفدِ",15,"د",1,0],["إِلى اِبنِ نَهيكٍ إِنَّهُ اِنتَسَبَ النَدى","إِلى عَمِّهِ عَمِّ الكِرامِ وَخالِهِ",16,"ل",2,0],["إِلى أَبي يوسُفَ اِجتابَت رَكائِبُنا","تِلكَ الدَآدِئَ بِالروعانِ وَالظُلَما",17,"م",2,0],["إِلى اِبنِ أَبي موسى الَّذي سَجَدَت لَهُ","جُنوحاً عَلى الأَيدي مُلوكُ المَرازِبِ",18,"ب",1,0],["إِلى اِبنِ الإِمامَينِ اللَذَينِ أَبوهُما","إِمامٌ لَهُ لَولا النُبوَّةُ يُسجَدُ",19,"د",1,0],["إِلى اِبنِ أَبي الوَليدِ عَدَت رِكابي","وَراحَت وَهيَ جائِلَةُ الضِفارِ",20,"ر",1,1],["إِلى اِبنِ أَبي النَضرِ الكَريمِ فَعالُهُ","يُضِرُّ بِها إِدلاجُها وَالهَواجِرُ",21,"ر",1,0],["إلى ابنِ فَهْدٍ زَفَفْنا كلَّ آنسَةٍ","عذراءَ تُتحِفُهُ بالحَمْدِ إتحافا",22,"ف",2,0],["إِلى اِبنِ سَلمى سِنانٍ وَاِبنِهِ هَرِمٍ","تَنجو بِأَقتادِها عيدِيَّةٌ تَخِدُ",23,"د",1,0],["آلى اِبنُ عَبدٍ حينَ جاءَ مُحارِباً","وَحَلَفتَ فَاِستَمِعوا مِنَ الكَذّابِ",24,"ب",1,1],["إلى ابنِ تميم أسْنَدَتْ كلّ مَنْكِبٍ","إلى منكبِ الجوزاءِ غيرَ مزاحمِ",25,"م",1,0],["إلَى ابنِ خَلاصٍ اغتَربَت رِكَابِي","فأسلاَنِي نَدَاهُ عَنِ القُفُولِ",26,"ل",1,0],["إِلى ابنِ عُبَيدِ اللَهِ حَتّى لَقينَهُ","عَلى السَعدِ لَم يَزجُر لَها طَيرَ أَشأَمِ",27,"م",1,0],["إِلى أَبي الفَضلِ عَبّاسٍ وَلَيسَ إِلى","هَذا وَلا ذا دَعَت نَفسي دَواعيها",28,"ي",3,0],["إِلى أَبيكَ أَميرِ المُؤمِنينَ بِنا","نَفدٌ إِلَيهِ وَفَتحٌ ما بِهِ نَفَدُ",29,"د",1,0],["إِلى اِبنِ مُحَرَّقٍ أَعمَلتُ نَفسي","وَراحِلَتي وَقَد هَدَتِ العُيونُ",30,"ن",1,0],["إِلى اِبنِ يَعقوبٍ سُلَيكاً غَدا","كَاِبنِ عُمَيرٍ في المَنايا سُلَيك",31,"ك",1,0],["إلى ابن داودَ الّذِي تَقلَّعا","في جَبلَيْ شَذُونَةٍ تمنَّعا",32,"ع",2,0],["إِلى ابْنِ عفَّانَ وَفِيمَا تَلا","دِمَاؤُهُ تَجْرِي عَلى الأَسْطُرِ",33,"ر",1,0],["إِلَى ابْنِ عِيدٍ زَفَّهَا قَلْبُهَا","وَالنَّاسُ بِالأَعْيَادِ تَسْتَبْشِرُ",34,"ر",1,0],["إلى أبي يُوسُفٍ أَجتَابَتْ رَكَائِبُنَا","تِلكَ الدّآدىءَ، بالروْيَانِ، وَالظّلَمَا",35,"م",2,0],["إِلى ابنِ أُمَّا إِمَام البَدوِ والحَضرِ","جُودَ الجَدَا المُجتَدَى الصَّافي مِنَ الكَدَرِ",36,"ر",1,1],["إلى ابنِ أبِي النعامة والغُرَابِ","سلاماً مثلَ تَرشافِ الرُّضَابِ",37,"ب",1,1],["إلى أبناء هاشم قد نمته","ذوو الأحساب والشرف العميم",38,"م",1,0],["إِلى ابْنِ مَنْ فُتِحَتْ أُمُّ الكِتَابِ بِهِ","وَبِالصَّلاةِ عَلَى آبائِهِ خُتِما",39,"م",2,0],["إِلى اِبن هِندٍ خَذرَفَت أَخفافَها","تَهوي لمُعتَمِدٍ بعيد المُحدِسِ",40,"س",1,0],["إلى أبي البحرِ إني لست أنسُبُه","لجعفرٍ إن حساهُ شاربٌ نضَبا",41,"ب",2,0],["الى ابن يوسف تعزى","من حاز ارفع مجد",42,"د",1,0],["إلى ابن عليّ ذي الأيادي محمد","ونعم جليل قد تلاه جليل",43,"ل",1,0],["إلى ابن حِميرَ أفريقيّةُ انتسبت","لما غزاها ومنها ظافراً آبا",44,"ب",2,0],["إِلى ابنه الشيخ عبد الواحد اتصلت","أَسبابه فأبو عثمان مَولاه",45,"ا",2,0],["إِلى أَبي بكر الشامي من عمر","إِلى أَخيه عَلى نجم علياه",45,"ا",2,0],["إِلى اِبن مشيش لقطب مَن كان إرثهُ","مِنَ المدني الزيّاتي شيخه فلتدرِ",46,"ر",1,0],["إِلَى ابنِ الوَصِيِّ إِلَى ابن النَّبيِّ","إِلَى ابن الذَّبيح إِلَى ابن الخَليلِ",47,"ل",1,0],["إلى ابنتي من أفدِّيها ويُسعدني","لو استطعتُ بباقى العمر أُغنيها",48,"ي",3,1],["إلى ابن حبيب من ثنائي أَجَّله","ومن كل مالي ما يقل ولا يفي",49,"ف",2,1],["إلى أبي جعفرٍ الأبيِّ","إلى الوزيرِ البطلِ السَّخيِّ",50,"ي",1,0],["إلى ابن عليٍ خير داع إلى النَّدى","وعادِ بنعماهُ على الحادث الإدِّ",51,"د",1,0],["إِلى اِبنِ ثَلاثٍ بِالفَلاةِ كَأَنَّما","بِجَنبيهِ مِن لَفحِ السُمومِ جُروحُ",52,"ح",1,0],["إلى أبي العَلَميْنِ الرَّكْبُ قَدْ عَرجتْ","به الرِّجالُ وأمَّتْ خيرَ مُنْعرجِ",53,"ج",1,1],["إلى اِبنِ الكِرامِ الفاخرينَ ذوي العُلا","حليفِ النّدى المولى الحُسينِ أخي الرُشْدِ",54,"د",1,0],["إلى أبد الآباد من غير غاية","وإن كان في خلق جديد لقد غدا",55,"د",2,0],["إِلى ابنِ لَيلَى فَاِغتَدي وَروحي","إِلى فَتىً في الباعِ ذي مَندوحِ",56,"ح",1,0],["إِلى اِبنِ حَربٍ لا تَجِدهُ كَالبَرَم","لا عاجِزَ الهَوءِ وَلا جَعدَ القَدَم",57,"م",1,0],["إلى ابن آوى بل إلى خنزير","أعزز عليّ ذاك م مسير",58,"ر",1,0],["إلى أبي طالب كنت أنت له","وذاك قول الله لا شريك له",58,"ه",1,0],["إلى ابنه محمد مع عدة","أتاهم الراية عند الشدة",58,"ه",1,0],["إلى ابنِ سُلَيمانَ بنِ مَنصُورَ أرقَلَت","بِنا أرَحَبيّاتٌ مَرافِقُها فَتلًُ",59,"ل",1,0],["إلى ابنِ أميرِ المؤُمِنينَ سَرت بِنا","تَجُوبُ الفَلا تَجريدها ومَليعُها",60,"ع",3,0],["إلى ابنِ أميرِ المؤُمِنينَ حَدت بنا","سَواجِدُ مِن طُولِ السُّرى ورَواكِعُ",61,"ع",1,0],["إلى ابن أميرِ المؤمنين سرَت بنا","غريريَّة تنحُو من الشرق ماتَنحو",62,"ح",2,0],["إلى ابن عليٍّ أحمدَ بنِ مُحمَّدٍ","تُباري أعاريدِ الصَّبا وَتُواهِقُ",63,"ق",1,0],["إلى ابن أميرِ المؤمنين تَواهَقَت","بِنا مُقدَحِرّاتٌ تَخُبُّ وتَنغِضُ",64,"ض",1,0],["إِلى ابن أَبي العَلياء مَحمودٍ الَّذي","غَدا لمَليك العَصر أَوّلَ كاتب",65,"ب",1,0],["إِلى ابنِ عَليٍّ قَد رفعتُ قَضيَّتي","وَأَرجو بِهَذا أَنَّ قَدري يُرفَعُ",66,"ع",1,0],["إلى ابن سويدٍ المنتاش عرضي","وقد لعبتْ به النُّوَبُ الفظيعَه",67,"ع",2,0],["إلَى ابْنِ الَّذِي أَحْيَا الْبَرِيَّةَ عَدْلُهُ","فَشُبِّهَ بِالْفَارُوقِ فِيهمْ أَبِي حَفْصِ",68,"ص",1,0],["إلى أبوابنا تغدو البرايا","وتحدى العيس مرسلة هُياما",69,"م",2,0],["إِلى اِبن سنان عامرٍ عامر العلا","وَأورثها مِن والدٍ بعد والدِ",70,"د",1,0],["إِلى اِبنِ الأُلى شادوا الرَغائِبَ بِالظُبى","وَعَمّوا البَرايا بِاللُهى وَالرَغائِبِ",71,"ب",1,1],["إِلى ابنِ مَجْدٍ لَمْ يُخَرَّقْ أَدَمُهْ","إِلَى الأَمِينِ المُسْتَجارِ ذِمَمُهْ",72,"م",2,0],["إلى ابْنِ مُعزِّ الدِّين أَعْمَلْتُ جَسْرةً","ذَلولاً نُثارَ اللَّحمِ مُوبَقَةَ العَظْمِ",73,"م",1,0],["إِلى ابن الرشيدِ إِمامِ الهُدى","بَعثنا المَطِيَّ تجوبُ الفَلا",74,"ا",1,0],["إلى أَبعد الغايات حاز بمجده","وكلّ مجاز دونه مُتقاصِرُ",75,"ر",1,0],["إِلَى ابْنِ شِهَابِ الدِّينِ طَالَ تَغَرُّبِي","فَلَمَّا سَرَتْ عِيسِي لَهُ وَرِكَابِي",76,"ي",1,1],["إِلى اِبنِ جَميلٍ أَفنَتِ السَيرَ بِالسُرى","سِراعاً وَأَفناها دَوامُ الدَيامِمِ",77,"م",1,0],["إِلى اِبنِ أَميرِ المُؤمِنينَ وَمَن لَهُ","مُشابِهَةٌ لِلشَّمسِ يَتبَعُها البَدرُ",78,"ر",1,0],["إِلى اِبنِ بُرانٍ وَاِبنِ رُزّيكَ مَقصِدي","وَغَيرِهِما في عَصرِنا لَيسَ يُقصَدُ",79,"د",1,1],["إليَ أبلقي ونكارَ فا