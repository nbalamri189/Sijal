{"poems":[[79,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[47,"يفندون وهم أدنى إلى الفند","https://www.aldiwan.net/poem63480.html","الوافر"],[30,"رأيت بني مروان يرفع ملكهم","https://www.aldiwan.net/poem1276.html",""],[48,"أمالي الزمان على بنيه","https://www.aldiwan.net/poem23236.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42721","الطويل"],[92,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[119,"ساعرض عمن راح عني معرضا","https://www.aldiwan.net/poem40906.html","عموديه"],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[189,"أربع شبابي هل إليك رجوع","https://www.aldiwan.net/poem14577.html","الطويل"],[202,"لمغناك سح المزن أدمع باك","https://www.aldiwan.net/poem51909.html","الطويل"],[261,"وشعري سخفه لا بد منه","https://www.aldiwan.net/poem48576.html","الوافر"],[280,"أحن لأرباب المعارف بالترب","https://www.aldiwan.net/poem25617.html","الطويل"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[358,"بدت لك شمس الخدر من فلق السجف","https://www.aldiwan.net/poem40039.html","الطويل"],[447,"هو الرزء حتى كل قلب به جمر","https://www.aldiwan.net/poem14426.html","الطويل"],[505,"أهل دار مي وهي لله درها","https://www.aldiwan.net/poem38074.html","البسيط"],[519,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[519,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[556,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[556,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83316","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122551","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122749","الوافر"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130209","البسيط"],[1362,"","https://poetry.dctabudhabi.ae/diwan/poem/113644","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48949","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82213","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93708","السريع"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100425","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100309","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48318","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138552",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45815","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92062","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2530","الوافر"],[4431,"","https://poetry.dctabudhabi.ae/diwan/poem/204014","الوافر"],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[4981,"فَيضٌ مِن بردى أَمْ دموعُ دمشق؟","https://www.poetsgate.com/ViewPoem.aspx?id=190517",""],[585,"يا رائد القوم إن القوم أنضاء","https://www.poetsgate.com/ViewPoem.aspx?id=161878",""],[5320,"حضارة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=40425",""],[5616,"عواصم","https://www.poetsgate.com/ViewPoem.aspx?id=203338",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["وهَلْ داَفَعَتْ خَطْباً تَوَابعُ تُبَّعٍ","وَهَلْ دَرَأَت كَرْباً ِسَياسَةُ سَاسَانِ",0,"ن",1,0],["وَهَل دُموعٌ أَفاضَ النَهيُ رَيِّقَها","تُدني مِنَ البُعدِ أَو تَشفي مِنَ الكَمَدِ",1,"د",1,0],["وَهَل دَعوَتي مِن بَعدِ مَروانَ وَاِبنِهِ","لَها أَحَدٌ إِذ فارَقاها يُجيبُها",2,"ب",3,0],["وَهَل دونَ السَلامَةِ بُعدُ أَرضٍ","فَيُطوى بِالأَيانِقِ وَالجِمالِ",3,"ل",1,0],["وَهَلْ دَعْوَةُ الشُّورَى عَلَيَّ غَضَاضَةٌ","وَفِيهَا لِمَنْ يَبْغِي الْهُدَى كُلُّ فَارِقِ",4,"ق",1,0],["وهلْ دهرٌ أتى لمْ يَسْرِ فيه","يفيء ظِلالَهُ فِكرٌ وَريف",5,"ف",1,0],["وهل دلّلت لي الغوطتان لبانة","أحبّ من النعمى وأحلى وأعذبا",6,"ب",2,0],["وهل دمعتي تجرى افتقادا لغائب","اذا كان لا تجري عليّ دموعه",7,"ع",2,0],["وَهَل دَفَعَت عَن ماجِدِ بنِ مُحَمَّدٍ","وَقَد كانَ مِنهُ حِلُّها وَحَرامُها",8,"م",3,0],["وهل دَرَّجتْ ماءَ البُحَيرة شَمْأَلٌ","فلاحَتْ عليها للحَباب دُروع",9,"ع",1,0],["وهل دافعٌ عنكِ الفداءُ منيّةً","أهبَّتْ صباحاً في رِياضِ صفاكِ",10,"ك",1,0],["وهل دارٌ تكون بلا كنيفٍ","فيمكن عاقلاً فيها المقام",11,"م",1,0],["وَهل دَرَكٌ في أن تَقَربْتُ مِنهم","بأسْنَى أناسٍ أحرَزوا دَرَكَ القُرْب",12,"ب",1,0],["وَهَل دارُنا بالشِعب جامعةٌ لنا","وَهَل عائدٌ بالوَصل عيدٌ وموسمُ",13,"م",1,0],["وَهَل دَولَةُ المُرّان تعزى لفاتكٍ","يَصول بِها في العاشِقين سِوى عطفي",14,"ف",2,0],["وهل دول الأَيام من بعد موته","يحق لها الفتح المؤيد والنصر",15,"ر",1,0],["وهل دَرِبٌ في ساقَةِ الرَّكبِ عارِفٌ","يُديرُ لنا مَيْلَ الجَنائِبِ للدَّرْبِ",16,"ب",1,0],["وهل درى كيفَ ربُّ الحُسن رتّلها","والجوهرُ الفردُ منه كيفَ جزّاها",17,"ا",3,0],["وهل دُفِنَتْ منهُ الشّمائِلُ في الثّرى","فمركزُها الأصليُّ بين الكواكِبِ",18,"ب",1,0],["وهلْ دنُوُّكُمُ مُسلٍ ونحن إذا","كنّا جميعاً بطولِ الصَّدِّ نفترقُ",19,"ق",1,0],["وَهل درّ يوماً خيرُكمْ وهو نازحٌ","بشيءٍ سوى مسحي له وعِصابي",20,"ب",2,0],["وَهَل دونَ غايِ الجَهدِ تُدرِكُ غايَةً","وَدونَ اِختِرامِ النَفسِ تَعنو المَخارِمُ",21,"م",1,0],["وهل دَعوتَ فلم أُلَب","دون صحبي",22,"ي",1,0],["وَهَل دَرَجتَ صَباؤُهُما فَلاحا","كَما أغنَى بِظَهرِ الكَّفِ وَشمُ",23,"م",1,0],["وهل درى ذلك المولود والده","بأنه لسبيل المجد كيف درى",24,"ر",2,0],["وهل درست من بطن فجٍّ مسارحٌ","ومحَّت جنوبٌ رسمها ودبورُ",25,"ر",1,0],["وهل داملُ جرحٌ بدون ضمادِه","ومن لكَ بالجرح الذي ينزف الدَّما",26,"م",2,0],["وهل دمع عيني اللجوجين راجع","ليالي حل الحي هضب عران",27,"ن",1,0],["وَهَل دَرَت طيبةُ في أَنَّها","زادَت عُلَىً بِالسَيد العالم",28,"م",1,0],["وهل دافع صنين عنك نوائباً","وافقك من سود الوقاقع مربد",29,"د",1,0],["وهل دار السلام تفي سلامي","فذا وادي الغري يضيق فيه",30,"ي",2,0],["وهل درت الفيحاء لا فاح طيبها","تحمل فياحا شذا طيبها الداري",31,"ر",2,0],["وهلْ دان بالتوحيد مَنْ كان دائِماً","يُوالِي مُوالي شِرْكِه ويُظاهِرُ",32,"ر",1,0],["وهل درين العوادي الجاريات على","الصدر المعظم من رضت له جسدا",33,"د",2,0],["وَهَل دافع رَجم المَدافع معقل","تَخصص مِن ذاكَ الشَواظ بِراجم",34,"م",1,0],["وَهَل دُموعٌ عليهِ غَيرُ ذائبةٍ","إِذا تذاكر عهداً مِن تلاقينا",35,"ن",2,0],["وَهَل دافعٌ ما يجذب الدَهر من أَسى","إِلى نُقطة من مهجة مركزية",36,"ه",1,0],["وَهَل داعٍ فَيُسمَعَ عَبدَ عَمروٍ","لِأَخرى الخَيلِ تَصرَعُها الرِماحُ",37,"ح",1,1],["وهل داء أمر من التنائي","وهل عيش ألذ من التلاقي؟",38,"ق",2,0],["وهل دفن هم ٍ لإنهدام عقائدٍ","أم ِ الشوق للمنجي فذا همّك الخطرُ؟",39,"ر",1,0],["وهل دمشقُ سَتُرجَى اليومَ مِنْ بَشَرٍ","إنّ العطاءَ من الأشخاصِ مُهتَرِئ ُ",40,"ا",1,0],["وهل درى الملك الجبار كم ملكٍ","فإن حوته من الصعلوك أمعاء",41,"ا",2,0],["وَهلْ دُنْياكُمْ أَلفَتْ حَياة","تدنسها الجريمة فى الرغام",42,"م",1,0],["وهل دمشق التي حلّ الخراب بها","تشدّ قوساً لأهل القدس أو وترا؟",43,"ر",2,0],["وهل دعاك الداعي فقُمت لأمرهِ","وكنت أديب السير وخلعت النعلا",44,"ل",2,0]]}