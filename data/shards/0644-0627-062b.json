{"poems":[[55,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[55,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[55,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[79,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[49,"وقد أروح قرير العين مغتبطا","https://www.aldiwan.net/poem25333.html","البسيط"],[74,"يا سيدي لك نظم في محاسنه","https://www.aldiwan.net/poem18723.html","البسيط"],[53,"لأثبتن أبا عثمان في الغدره","https://www.aldiwan.net/poem62997.html","الطويل"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[108,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[108,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[92,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[96,"إني لأشمت بالجبار","https://www.poetsgate.com/ViewPoem.aspx?id=12813",""],[119,"نور قرب في حالة البعد اقبل","https://www.aldiwan.net/poem40850.html","عموديه"],[119,"يا رجال البطاح يا ساداتي","https://www.aldiwan.net/poem41205.html","عموديه"],[119,"سيدنا الشيخ على الخزام","https://www.aldiwan.net/poem41756.html","السريع"],[154,"لأهل الهوى في الدمع والسهد لذة","https://www.aldiwan.net/poem68549.html","الطويل"],[275,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[287,"لا والمطايا يعتسفن البيدا","https://www.aldiwan.net/poem32795.html","الكامل"],[310,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[369,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[399,"قيس وليلى","https://www.aldiwan.net/poem24310.html","عموديه"],[415,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[438,"قصر بمدرجه النسيم تحدثت","https://www.aldiwan.net/poem12641.html","الكامل"],[445,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[457,"يا طيب يوم للمدامة والصبا","https://www.aldiwan.net/poem13657.html","الكامل"],[463,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[466,"لا ثل عرشكم بني أسد","https://www.aldiwan.net/poem15170.html","أحذ الكامل"],[466,"عمت شهامته كما شملت","https://www.aldiwan.net/poem15608.html","أحذ الكامل"],[469,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[484,"أبتي كيف غالك الموت غدرا","https://www.aldiwan.net/poem37049.html","الخفيف"],[505,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[505,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[505,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[563,"لا ووجه مسفر حاز الجمالا","https://www.aldiwan.net/poem33532.html","الرمل"],[563,"حاولت في المرآة أنظر من أنا","https://www.aldiwan.net/poem33771.html","الكامل"],[572,"طلعت كالقمر التم بدر","https://www.aldiwan.net/poem69676.html","الرمل"],[578,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[580,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122654","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101506","الخفيف"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67845","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120073","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119898","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25356","الرجز"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101984","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118122","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128086","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125490","المتقارب"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198891","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27662","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87791","البسيط"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138923",""],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26115","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4702,"الحرف مايبلش وانا راعي الشان","https://www.poetsgate.com/ViewPoem.aspx?id=156955",""],[4709,"إليها وحدها أهدي فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=214802",""],[4984,"حادي النسيب","https://www.poetsgate.com/ViewPoem.aspx?id=176021",""],[5573,"ياخشف اشوف ان الهوى ماله حدود","https://www.poetsgate.com/ViewPoem.aspx?id=203090",""],[5616,"شقاوة","https://www.poetsgate.com/ViewPoem.aspx?id=203199",""],[5628,"قصيدة من زمن الانبعاث","https://www.poetsgate.com/ViewPoem.aspx?id=178706",""],[2110,"لا تبك رسما عفا ولا طللا","https://www.poetsgate.com/ViewPoem.aspx?id=156290",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[1376,"وافى يميل بعطفه وقد انتشى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599331",""],[6213,"يا أمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76311&r=&rc=59",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""],[572,"طَلَعَتْ كالقَمَرِ التّمَّ بَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9270&r=&rc=127",""]],"verses":[["لاثَ أَبطالُهُ عَمائِمَ بيضاً","لَبِسوا تَحتَها قَتيراً وَزَغفا",0,"ف",2,0],["لا ثُلَّ عَرشُ بَنَي بُوَيهٍ أَنَّهُم","غُدُرُ المَكارِمِ وَالجَنابُ الأَمرَعُ",1,"ع",1,0],["لا ثوا خُدودَهُمُ عَلى عَينِ النَقا","وَدُمى النَمارِقِ وَالغُصونِ المُيَّدِ",2,"د",1,0],["لآثَرْتُ كَتْمَ الوجْدِ بيْنَ جَوانِحي","وبلّغْتُ في القَلْبِ الهَوى ما يُريدُهُ",3,"د",2,0],["لاثَ اللِثامَ عَلى وَجهٍ أَسِرَّتُهُ","كَأَنَّها قَمَرٌ أَو ضَوءُ مِصباحِ",4,"ح",1,0],["لا ثروة المال في كفّي قاضيةٌ","حقًّا ولا ثروة الأشعار في فكري",5,"ر",2,0],["لأُثبتنّ أبا عثمان في الغدرَهْ","الناكثين بإخوان لهم برَرهْ",6,"ه",1,1],["لا ثأر يدرَك منك في المُّهَجِ الَّتي","أرديتها أوَ مِنْكِ يُدْرَك ثارُ",7,"ر",1,0],["لا ثَوَابٌ كفَاءُ فَضْلِكَ إِلاَّ","مَا يُثِيبُ اللّهُ العَلِيُّ القَديرُ",8,"ر",1,0],["لا ثغرَ يفتحُهُ ولا","عرشٌ يتاح له اعتلاؤه",9,"ا",3,0],["لاَثمُ الأعتاب فيه آمرٌ","والفتى الحرُّ به ما أضْيَعَه!",10,"ع",2,0],["لا ثورةُ النفسِ في الأشعارِ ألْمَسُها","إلا القليلَ ولا التأثيرُ في الخطب",11,"ب",1,0],["لاثَ العِمامةَ للجُلَّى ولستُ أرى","إلا العمائمَ في الإسلامِ تيجانا",12,"ن",2,0],["لاثم الراحة الشريفة في مش","هد مجد سما باشرف مرسل",13,"ل",1,0],["لاثم راحة النبي جهارا","بالوف من خلص السادات",14,"ت",1,0],["لاثم كف المفصطفى ملجأ الأق","طاب ذو الهمة غوث الأنام",15,"م",1,0],["لآثارِهِم إيثارُ كُلِّ متَيَّمٍ","يُنَافِسُ في المَحبُوبِ بِالثَّمَنِ الأغلَى",16,"ل",2,0],["لآثارِ ذاكَ العهدِ بتُّ مُقَبِّلاً","فلم أَكُ إِلا راهِباً قبَّلَ الصُّوَر",17,"ر",1,0],["لاثوا عمائِمَهُم عَلى هاماتِهِم","وَتَسربَلوا فَوقَ الرِكابِ بُرودا",18,"د",2,0],["لاثماً مُلتَزِماً سوقَ الشجَر","هيَ منهُ في حجُونٍ مِن لُجين",19,"ن",1,0],["لاثُوا العمائمَ سُؤْدَداً وتَعوَّدوا","بالبِيضِ ضَرْبَ مَعاقدِ التِّيجان",20,"ن",1,0],["لاثما كلّ موضع خطرت لي","لى عليه في ماضيات السنين",21,"ن",1,0],["لا ثَناني البِعادُ عنه وإن حَا","لَت أعادٍ من دُونِه وحُروبُ",22,"ب",1,0],["لاثَ الغمامُ عِمامةٌ مِسكيةٌ","فأقامَ في أرضٍ من الكافورِ",23,"ر",1,0],["لا ثَغْرَ دُونَكَ غَيْرَ ثُغْرَةِ نَحْرِهِ","إِلّا رجاءَ عوائِدٍ لَكَ عائِدَهْ",24,"د",2,0],["لاثت غلائلها على هاماتها","تحكي بهن قلانس الأعراب",25,"ب",1,0],["لآثارِها في كلِّ شهباءَ روضةٌ","وفي كلِّ عَمياءِ المياهِ قليبُ",26,"ب",1,0],["لا ثُلَّ عرشكم بني أسَدٍ","وبقيتمُ ما أورقَ السَّلَمُ",27,"م",1,1],["لا ثُلَّ عَرْشُكَ يا فتى مُضَرٍ","ما وَحَّدَ الؤَّحمن عارِفهُ",28,"ف",2,0],["لأثبتُ من رضوى جناناً إذا","رضوى دحتهُ ريحُ خوفٍ فطاحْ",29,"ح",1,0],["لاثم الرجل لاثم الجيد جاث","ناقد الرشد طارا فيك حجرا",30,"ر",2,0],["لاثِمُ زاكي كَفِّهِ","ضمنَ الحِمى في مَحْفَلِ",31,"ل",1,0],["لاثِمُ الرَّاحةِ الشَّريفةِ في رحْ","بٍ خَطيرٍ مأوى الأُسودِ وصِيدُهْ",32,"د",2,0],["لاثِمٌ راحَةَ طَهَ جَدِّهِ","بينَ جمٍّ من أُلوفٍ نُجُبِ",33,"ب",1,0],["لاثت الأقوام منه شغفاً","وبه قد ستروا منه كمالا",34,"ل",2,0],["لا ثغر في فمه وعن أسنانه","متعوِّضٌ بالدردر المسنون",35,"ن",1,0],["لاَثَتِ الكَوْرَ عَلَى مَفْرِقِهَا","فَرَأَيْنَا هَالَةً حَوْلَ القَمَرْ",36,"ر",1,0],["لاثوا مُدَثَّرَةَ السُجوفِ وَظَلّوا","فَوقض الخُدوجِ عَلى شَقيقَةِ ريمِ",37,"م",1,0],["لا ثَنَاءٌ إِلاَّ إِلَيْه تَنَاهِي","ه وفضلٌ إِلاَّ لَديه مَزيده",38,"د",2,0],["لاثُوا عِظامَهُمُ بحِقوي ماجدٍ","كالصِّل يَلدَغ دائماً ويُنَضنِض",39,"ض",1,0],["لا ثباتٌ ولا بقاءٌ لعهدٍ","لا احتفاظٌ بهِ تصون الولاءَ",40,"ا",2,0],["لأَثْوَابُ مَدْحِ جُدِّدَتْ فِي صِفَاتِهِمْ","لأَنَّ حَدِيثي لَمْ يَكُنْ عَنْهُمُ مولاَ",41,"ل",2,0],["لاثما من خده الور","د ومن فيه الأقاحي",42,"ح",2,0],["لاثت بمثل الدعص مئزرها","وجلت بعودا راكة طلعا",43,"ع",2,0],["لَأَثْنِيَنَّ صادِقاً بِعِلْمِي","بِفِعْلِ قَوْمِي فِي الغِنَى وَالعُدْمِ",44,"م",1,0],["لاثت على كشحي أردية الهنا","والبشر حتى ثلثت لي العيدا",45,"د",2,0],["لاثنين أو ثلاثة أو أربعة","تأتيك في تفسيرها منوّعه",46,"ه",1,0],["لاث القناع على الصباح وإنه","يسبي العقول معمماً ومشربشا",47,"ش",2,0],["لأثابها الحسنى ولم يطقق بها","ممحا ولم تألم بجس وريد",48,"د",1,0],["لآثارهم في الوَرَى مَنعَةً","رواسي رغم البلى خالِدات",49,"ت",1,0],["لإثمي لزلاتي ذخرت مديحه","ليلحقني عزا إذا ذل من ذلا",50,"ل",2,0],["لاثوا العمائم فوقَ أرؤسِهم وما","ستروا بها قِرطاً ولا إكليلا",51,"ل",2,0],["لاثَ العَمامة تُزهى فَوقَ لمتَّه","ما دَنَّست طُهرها الآثام وَالتُهَم",52,"م",1,0],["لأثيث الجعد روى نشراً","عن طيب للورد إذا وفر",53,"ر",1,0],["لا ثَغرَ أَمنَعُ مِن بَليَّةَ مَورِدا","وَقَعَت فَوارِسُنا بِهِ لِتَذودا",54,"د",2,0],["لا ثَقيلَ إِذا تَشَدَّقَ يَقسو","ضرسه في مُضَرَّساتِ المعاني",55,"ن",2,0],["لا ثائِرٌ لقتالهم","في النَّهْرَوان ولا أثرْ",56,"ر",1,0],["لِإِثراقَةٍ أَرضٍ خَيرَ الجِيادِ","وَميسَةَ مَهدِ قُرومِ الجِلادِ",57,"د",1,0],["لأثني عليك الثناء الجميل","وأهدي اليك الهنا والحبورا",58,"ر",2,0],["لا ثار عجّه يسبق العجّ دخان","يصطاد من جزل المعاني وفيره",59,"ر",2,0],["لأثملَ في بقايا العمر دوما","وأبقى في انتشاءٍ عانقيني",60,"ن",2,0],["لأثبت في الشعر انتمائي لمن مضوا","وما هو شوق من غرام ولا لوعه",61,"ع",2,0],["لاثار به لاهو يهيد ولا يهود","احساسه الي ماسمع منهو نهاه",62,"ا",2,0],["لا ثغرك الملموم يتقن بسمةً","وسماء وصلك لا تلمّ نجوما.!",63,"م",2,0],["لا ثمَ لا فالوردُ أنتِ وعطْرهُ","إنْ غبتِ عنّي فالحياةُ مماتُ",64,"ت",1,0],["لا ثم يمنى الرسول سيدنا ال","غوث الرفاعي أفضل الفضلا",65,"ل",2,0],["لا ثل عرش خلافةٍ مذ حطتها","قرأت على أعدائها لن تفلحوا",66,"ح",3,0],["لأَثْقَلْتَ ظَهْري بالصنيعِ فلم أكدْ","أَنُوءُ بِأعباءٍ ثقُلْنَ وأَوقَارِ",67,"ر",1,0],["لاث القناع على الصباح وانه","يسبي العقول معمَّما ومسرفا",68,"ف",2,0],["لا ثقب فيه يعيبه","بل ما احتوى أو ما اشتمل",69,"ل",1,0],["لا ثلوناً ولا نزوراً شطورا","في سماطي نادي علاه وثيرا",70,"ا",1,0],["لاَثَتِ الكُورَ على مفرِقهَا","فَرَأَيْنَا هالة ً حَوْلَ قَمَرْ",71,"ر",1,0]]}