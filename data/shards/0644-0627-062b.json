{"poems":[[53,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[77,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[47,"وقد أروح قرير العين مغتبطا","https://www.aldiwan.net/poem25333.html","البسيط"],[72,"يا سيدي لك نظم في محاسنه","https://www.aldiwan.net/poem18723.html","البسيط"],[51,"لأثبتن أبا عثمان في الغدره","https://www.aldiwan.net/poem62997.html","الطويل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[90,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[94,"إني لأشمت بالجبار","https://www.poetsgate.com/ViewPoem.aspx?id=12813",""],[115,"نور قرب في حالة البعد اقبل","https://www.aldiwan.net/poem40850.html","عموديه"],[115,"يا رجال البطاح يا ساداتي","https://www.aldiwan.net/poem41205.html","عموديه"],[115,"سيدنا الشيخ على الخزام","https://www.aldiwan.net/poem41756.html","السريع"],[150,"لأهل الهوى في الدمع والسهد لذة","https://www.aldiwan.net/poem68549.html","الطويل"],[270,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[282,"لا والمطايا يعتسفن البيدا","https://www.aldiwan.net/poem32795.html","الكامل"],[305,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[364,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[394,"قيس وليلى","https://www.aldiwan.net/poem24310.html","عموديه"],[409,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[432,"قصر بمدرجه النسيم تحدثت","https://www.aldiwan.net/poem12641.html","الكامل"],[439,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[452,"يا طيب يوم للمدامة والصبا","https://www.aldiwan.net/poem13657.html","الكامل"],[458,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[461,"لا ثل عرشكم بني أسد","https://www.aldiwan.net/poem15170.html","أحذ الكامل"],[461,"عمت شهامته كما شملت","https://www.aldiwan.net/poem15608.html","أحذ الكامل"],[464,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[479,"أبتي كيف غالك الموت غدرا","https://www.aldiwan.net/poem37049.html","الخفيف"],[500,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[500,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[500,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[558,"لا ووجه مسفر حاز الجمالا","https://www.aldiwan.net/poem33532.html","الرمل"],[558,"حاولت في المرآة أنظر من أنا","https://www.aldiwan.net/poem33771.html","الكامل"],[567,"طلعت كالقمر التم بدر","https://www.aldiwan.net/poem69676.html","الرمل"],[573,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[575,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"]],"verses":[["لاثَ أَبطالُهُ عَمائِمَ بيضاً","لَبِسوا تَحتَها قَتيراً وَزَغفا",0,"ف",2,0],["لا ثُلَّ عَرشُ بَنَي بُوَيهٍ أَنَّهُم","غُدُرُ المَكارِمِ وَالجَنابُ الأَمرَعُ",1,"ع",1,0],["لا ثوا خُدودَهُمُ عَلى عَينِ النَقا","وَدُمى النَمارِقِ وَالغُصونِ المُيَّدِ",2,"د",1,0],["لآثَرْتُ كَتْمَ الوجْدِ بيْنَ جَوانِحي","وبلّغْتُ في القَلْبِ الهَوى ما يُريدُهُ",3,"د",2,0],["لاثَ اللِثامَ عَلى وَجهٍ أَسِرَّتُهُ","كَأَنَّها قَمَرٌ أَو ضَوءُ مِصباحِ",4,"ح",1,0],["لا ثروة المال في كفّي قاضيةٌ","حقًّا ولا ثروة الأشعار في فكري",5,"ر",2,0],["لأُثبتنّ أبا عثمان في الغدرَهْ","الناكثين بإخوان لهم برَرهْ",6,"ه",1,1],["لا ثأر يدرَك منك في المُّهَجِ الَّتي","أرديتها أوَ مِنْكِ يُدْرَك ثارُ",7,"ر",1,0],["لا ثَوَابٌ كفَاءُ فَضْلِكَ إِلاَّ","مَا يُثِيبُ اللّهُ العَلِيُّ القَديرُ",8,"ر",1,0],["لا ثغرَ يفتحُهُ ولا","عرشٌ يتاح له اعتلاؤه",9,"ا",3,0],["لاَثمُ الأعتاب فيه آمرٌ","والفتى الحرُّ به ما أضْيَعَه!",10,"ع",2,0],["لا ثورةُ النفسِ في الأشعارِ ألْمَسُها","إلا القليلَ ولا التأثيرُ في الخطب",11,"ب",1,0],["لاثَ العِمامةَ للجُلَّى ولستُ أرى","إلا العمائمَ في الإسلامِ تيجانا",12,"ن",2,0],["لاثم الراحة الشريفة في مش","هد مجد سما باشرف مرسل",13,"ل",1,0],["لاثم راحة النبي جهارا","بالوف من خلص السادات",14,"ت",1,0],["لاثم كف المفصطفى ملجأ الأق","طاب ذو الهمة غوث الأنام",15,"م",1,0],["لآثارِهِم إيثارُ كُلِّ متَيَّمٍ","يُنَافِسُ في المَحبُوبِ بِالثَّمَنِ الأغلَى",16,"ل",2,0],["لآثارِ ذاكَ العهدِ بتُّ مُقَبِّلاً","فلم أَكُ إِلا راهِباً قبَّلَ الصُّوَر",17,"ر",1,0],["لاثوا عمائِمَهُم عَلى هاماتِهِم","وَتَسربَلوا فَوقَ الرِكابِ بُرودا",18,"د",2,0],["لاثماً مُلتَزِماً سوقَ الشجَر","هيَ منهُ في حجُونٍ مِن لُجين",19,"ن",1,0],["لاثُوا العمائمَ سُؤْدَداً وتَعوَّدوا","بالبِيضِ ضَرْبَ مَعاقدِ التِّيجان",20,"ن",1,0],["لاثما كلّ موضع خطرت لي","لى عليه في ماضيات السنين",21,"ن",1,0],["لا ثَناني البِعادُ عنه وإن حَا","لَت أعادٍ من دُونِه وحُروبُ",22,"ب",1,0],["لاثَ الغمامُ عِمامةٌ مِسكيةٌ","فأقامَ في أرضٍ من الكافورِ",23,"ر",1,0],["لا ثَغْرَ دُونَكَ غَيْرَ ثُغْرَةِ نَحْرِهِ","إِلّا رجاءَ عوائِدٍ لَكَ عائِدَهْ",24,"د",2,0],["لاثت غلائلها على هاماتها","تحكي بهن قلانس الأعراب",25,"ب",1,0],["لآثارِها في كلِّ شهباءَ روضةٌ","وفي كلِّ عَمياءِ المياهِ قليبُ",26,"ب",1,0],["لا ثُلَّ عرشكم بني أسَدٍ","وبقيتمُ ما أورقَ السَّلَمُ",27,"م",1,1],["لا ثُلَّ عَرْشُكَ يا فتى مُضَرٍ","ما وَحَّدَ الؤَّحمن عارِفهُ",28,"ف",2,0],["لأثبتُ من رضوى جناناً إذا","رضوى دحتهُ ريحُ خوفٍ فطاحْ",29,"ح",1,0],["لاثم الرجل لاثم الجيد جاث","ناقد الرشد طارا فيك حجرا",30,"ر",2,0],["لاثِمُ زاكي كَفِّهِ","ضمنَ الحِمى في مَحْفَلِ",31,"ل",1,0],["لاثِمُ الرَّاحةِ الشَّريفةِ في رحْ","بٍ خَطيرٍ مأوى الأُسودِ وصِيدُهْ",32,"د",2,0],["لاثِمٌ راحَةَ طَهَ جَدِّهِ","بينَ جمٍّ من أُلوفٍ نُجُبِ",33,"ب",1,0],["لاثت الأقوام منه شغفاً","وبه قد ستروا منه كمالا",34,"ل",2,0],["لا ثغر في فمه وعن أسنانه","متعوِّضٌ بالدردر المسنون",35,"ن",1,0],["لاَثَتِ الكَوْرَ عَلَى مَفْرِقِهَا","فَرَأَيْنَا هَالَةً حَوْلَ القَمَرْ",36,"ر",1,0],["لاثوا مُدَثَّرَةَ السُجوفِ وَظَلّوا","فَوقض الخُدوجِ عَلى شَقيقَةِ ريمِ",37,"م",1,0],["لا ثَنَاءٌ إِلاَّ إِلَيْه تَنَاهِي","ه وفضلٌ إِلاَّ لَديه مَزيده",38,"د",2,0]]}