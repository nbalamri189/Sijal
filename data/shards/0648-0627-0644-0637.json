w.aldiwan.net/poem17990.html","الكامل"]],"verses":[["وَالطاعِنُ الطَعنَةَ النَجلاءَ عَن جَلَدٍ","كَالقائِلِ القَولَةَ الغَرّاءَ عَن لَسَنِ",0,"ن",1,0],["وَأَلطافُ السَحابِ لِكُلِّ دارٍ","صَحِبنا رَبعَها خَضِلَ المَغاني",1,"ي",1,0],["وَالطَعنُ يَنتَجِعُ الأَجسادَ أَنفُسَها","وَالضَربُ يَبخَلُ بِالبُقيا عَلى القِمَمِ",2,"م",1,0],["وَإِلطافٌ تَساقَطَ مِنكَ وَهناً","عَلَيَّ كَما تَهَوَّرَتِ النُجومُ",3,"م",1,0],["وَالطَعنُ يَرجِعُ بِالقَنا وَصُدورُها","خَطّاطَةٌ خَلفَ الجِيادِ دَوامِ",4,"م",1,0],["وَالطاعِنينَ بِكُلِّ جَدٍّ مِدعَسٌ","وَالماطِرينَ بِكُلِّ نيلٍ مُرزِمِ",5,"م",1,0],["وَالطائِعُ المَرجوُّ إِن حُمِدَت","أَيدي الرِجالِ وَقَلَّ مَن يَسَلُ",6,"ل",1,0],["والطّيْرُ يَدْعو للصَّبوحِ مُكَرِّراً","فَتراهُ قدْ نَفَضَ الجَناحَ وصاحا",7,"ح",2,0],["وَالطَّبْعُ فَحْلٌ وَالْقَرِيحَةُ حُرَّةٌ","فَاقْبَلْهُ بَيْنَ نَجِيبَة وَنَجيبِ",8,"ب",1,0],["وَالطَّيْرُ قَدْ نَفَضَ الجَنَاحَ مُؤَذِّنَاً","وَالْوُرْقُ تَتْلُو وَالبَلاَبلُ تَخْطُبُ",9,"ب",1,0],["وَالطَيرَ لا تَلهو بِتَدويمِها","في مُلكِها الواسِعِ أَو تَصدَحُ",10,"ح",1,0],["وَالطَّبْعُ إنْ رَوَّضْتَهُ","ذَلَّلْتَ بِالطَّبْعِ الصِّعَابَا",11,"ب",2,0],["وَالطَيِّبونَ بَنوكَ قَتلى حَولَهُ","فَوقَ التُرابِ ضَواحِياً لا تُلحَدُ",12,"د",1,0],["والطير فالدوح ما فصح","غناه على العود قد اشتهر",13,"ر",1,0],["والطرافها توشّي","يعجب النيس من سديها",14,"ه",2,0],["والطباع العرجاء في كل شخص","تقتضي من ثقافة عُكازه",15,"ز",2,0],["والطَّيِبُونَ المُسَوَّمُونَ أُولو ال","أجنِحَةِ المُدرِكُونَ ما طَلَبُوا",16,"ب",3,0],["والطَّيِبُونَ المُبَرَّؤون من ال","آفَةِ والمُنجِبُونَ والنُجُبُ",16,"ب",1,0],["والطيبون المسومون أولي","الاجنحة المدركون ما طلبوا",17,"ب",3,0],["والطرفُ يركعُ في مشاهدِ أوجهٍ","عقدت بها طرر الشعورِ محارِبا",18,"ب",2,0],["والطرف يستجلي غزالاً آنساً","بالنيل لا ثورا على باناس",19,"س",1,0],["والطير تقربها الظبا فمن السماء","والأرض تغشاه الضيوف وتطرق",20,"ق",1,0],["والطاهر النسب العريق فحبذا","أصلٌ وفرعٌ في العلى يرضيكا",21,"ك",2,0],["والطالب الأخرى بعزمٍ للكرى","يفني ويحيي بالسجود ليالي",22,"ي",1,0],["والطبيبُ اللبيب من يُتبِع الدا","ءَ دواءً يشفيه لا الداءَ داءَ",23,"ا",2,0],["والطَّروقاتِ والمراكبِ والوِل","دانِ مثلِ الشَّوادنِ الأسرابِ",24,"ب",1,0],["والطيرُ أظْلالٌ علي","هِ لها هديلٌ أو صفيرُ",25,"ر",1,0],["والطيز عند الغناء مختلجٌ","تضْحك أشداقه إلى الكمر",26,"ر",1,0],["وَالطَلُّ غَيرِ الماسِ إِلّا أَنَّهُم","خُدِعوا بِرَقرَقَةَ النَدى عَن ماسي",27,"ي",1,0],["وَالطَودُ آفاتٌ تَلوحُ وَتَختَفي","وَالسَهلُ أَرصادٌ تَجيءُ وَتَقفُلُ",28,"ل",1,0],["وَالطائِفِيَّةُ أَنتَ أَوَّلُ مِعوَلٍ","في سورِها ثابِر عَلى تَهضِمِها",29,"م",3,0],["وَالطَيرُ لَحمٌ وَدَمٌ عِندَهُم","وَلَيسَ عِندي غَيرَ أَنغامِ",30,"م",1,0],["وَالطَلُّ في أَغصانِهِ","يَحكي عُقوداً في تَرائِب",31,"ب",1,0],["والطُّيورُ الطِّرابُ تشدو حواليه","وتلغو في الدَّوحِ مِنْ كلِّ جنْسِ",32,"س",1,0],["والطُّيورُ التي تُغنِّي وتقضي","عيْشَها في ترنُّمٍ وغَريدِ",33,"د",1,0],["وَالطُرُقُ الحُمرُ في جَوانِبِهِ","كَخَدِّ عَذراءَ نالَهُ العطرُ",34,"ر",1,0],["والطاعنون بنوك أن","ت كَسوتهم لحماً وجلدا",35,"د",2,0],["والطعن في الوطن العزيز وأهله","والمدح في قرع الوكيل الإهجص",36,"ص",1,0],["وَالطَيرُ في جَنَباتِ دُمَّرَ نُوَّحٌ","يَجِدُ الهُمومَ خَلِيُّهُنَّ وَيَأرَقُ",37,"ق",1,0],["وَالطالِبينَ لِحَقِّها","بَينَ السَكينَةِ وَالثَباتِ",38,"ت",1,0],["وَالطَيرُ مِلءُ الأَيكِ أَرؤُسُها","مِثلُ الثِمارِ بَدَت مِنَ السِدرِ",39,"ر",1,0],["وَالطَيرُ تَصدَحُ مِن خَلفِ العُيونِ بِها","وَلِلعُيونِ كَما لِلطَيرِ أَلحانُ",40,"ن",1,0],["وَالطَيرُ تَرسُفُ في الجِرا","حِ وَفي مَناقِرِها أَنين",41,"ن",1,0],["وَالطَيرُ أَقعَدَها الكَرى","وَالناسُ نامَت وَالوُجود",42,"د",1,0],["وَالطَريقُ مُتَّصِلٌ","نَحوَهُ وَمُنشَعِبُ",43,"ب",1,0],["وَالطَعامُ حاضِرُهُ","وَالمَزيدُ مُنتَهَبُ",43,"ب",1,0],["وَالطَعنُ شَزرٌ وَالأَرضُ واجِفَةٌ","كَأَنَّما في فُؤادِها وَهَلُ",44,"ل",1,0],["وَالطَعنُ يُحرِقُها وَالزَجرُ يُقلِقُها","حَتّى كَأَنَّ بِها ضَرباً مِنَ اللَمَمِ",45,"م",1,0],["وَالطَيرُ فَوقَ الحَبابِ تَحسَبُها","فُرسانَ بُلقٍ تَخونُها اللُجُمُ",46,"م",1,0],["وَالطُرقُ ضَيِّقَةُ المَسالِكِ بِالقَنا","وَالكُفرُ مُجتَمِعٌ عَلى الإيمانِ",47,"ن",1,0],["والطينة البيضاء وهي التي","من شأنها الإمساك والحبسُ",48,"س",1,0],["وَأَلطَفُ مِنهُ في الفُؤادِ مَحَلَّةً","ثَناءٌ تُبَقّيهِ القَصائِدُ أَو شُكرُ",49,"ر",1,0],["وَالطَرفُ أَجلَبُ زائِرٍ لِمَأونَةِ","ما لَم تُزِرهُ بِسَرجِهِ وَلِجامِهِ",50,"م",2,0],["وَالطيبُ يَزدادُ طيباً أَن يَكونَ بِها","وَإِن تَدَعهُ تَدَعهُ غَيرَ مِتفالِ",51,"ل",1,0],["والطرس أحسن ما يكو","ن إذا جرى فيه القلم",52,"م",1,0],["والطست والضارب في صنوف","من الثقيل ومن الخفيف",53,"ف",1,0],["والطُفْ فما زِلْتَ بنا لَطيفا","في سابحٍ تَحسَبُه مَعلوفا",54,"ف",2,0],["والطالبيّون انْتَحَتْكَ وفودُهُم","فرأَوا نَداكَ الغَمْرَ قرَّبَ مطلَبا",55,"ب",2,0],["وَاِلطُف لِكُلِّ اِمرِئٍ بِرِفقٍ","وَاِقبَل مِنَ الناسِ ما تَيَسَّر",56,"ر",1,0],["وَالطَيرُ مِن مُحَوِّمٍ","فيها وَمِن مُحَلِّقِ",57,"ق",1,0],["وَالطَلُّ فَوقَ المِياهِ مُنتَثِرٌ","فَهوَ لِكَأسِ الغَديرِ كَالحَبَبِ",58,"ب",1,0],["وَالطَيرُ غَنَّت بِمَنطِقٍ غَرِدٍ","يُغني النَدامى عَن نَفخَةِ القَصَبِ",58,"ب",1,0],["وَالطَلعُ في خَلَلِ الكِمامِ كَأَنَّهُ","حُلَلٌ تَفَتَّقُ عَن نُحورِ غَوانِ",59,"ن",1,0],["والطبُ مرحمة الجسوم ونبعُهُ","من ذلك الفيض العليّ الشان",60,"ن",1,0],["والطعنُ يلحقُ من سوابغِهِم","حَدَقَ الجرادِ بأعين الحَجَلِ",61,"ل",1,0],["وَالطائِرُ الطائِرُ في شانِهِ","يُلوي بِخَطِّ الطائِرِ الواقِعِ",62,"ع",1,0],["والطَّامِسِينَ من الجهالَةِ غَيْهَبَاً","والمُطْلِعِينَ مِنَ النُّهَى قِنْدِيلا",63,"ل",2,0],["والطَّيْشُ أن لا تَلْجَئِي","مِن حاكِمِيكِ إلى احتكامِ",64,"م",1,0],["والطّيرُ من غادٍ عليَّ ورائحٍ","تَهذِي بِقُربِ تجاورٍ ولِقاءِ",65,"ا",2,0],["والطائراتُ تفوتُ كلَّ مُحلِّقٍ","وتظلُّ ناهضةَ القوى تنطادُ",66,"د",1,0],["والطَّيرُ تُنشِدُ بِاختِلافِ لُغَاتِهَا","مُوسَى أدام اللهُ فِي تَمكِينِهِ",67,"ن",2,0],["وَالطَيرُ قَد غَنَّت لِشَطحِ رَواقِصٍ","فَوقَ الغَديرِ جَرَرنَ ثَوبَ تَبَختُرِ",68,"ر",1,0],["وَالطَيرُ قَد قامَت عَلَيهِ خَطيبَةً","لَم تَتَّخِذ إِلّا الأَراكَةَ مِنبَرا",69,"ر",2,0],["وَالطِلا وَالحُبابُ وَالرَوضَةُ الغَ","نّاءُ خَدٌّ وَمَبسَمٌ وَعِذارُ",70,"ر",1,0],["وَأَلطَفَ فيها الصُّنعَ حَتّى أَعارَها","بَياضَ الضُحى في نِعمَةِ الغُصُنِ النَدي",71,"ي",1,0],["وَالطّوطَ نَزرَعُهُ فيها فَنَلبَسُهُ","وَالصوفَّ نَجتَزُّهُ ما أَدفأَ الوَبَرُ",72,"ر",1,1],["والطاهرُ الذَّيْلِ والطَّوِيَّةِ أَوْ","يَكْفِي السَّعِيدَ الحَراكَ والنَّصْبَهْ",73,"ب",2,0],["والطَّاعِنُوا النَّجلاءَ يُدْخِلُ كَفَّهُ","في إثْرِها الآسي مكانَ المِرْوَدِ",74,"د",1,0],["وَالْطُفْ بِعَبْدِكَ في الدَّاريْنِ إنَّ لَهُ","صَبْراُ مَتى تَدْعُهُ الأهوالُ يَنْهَزِمِ",75,"م",1,0],["وَالطَّيْرِ وَالوَحْشِ وَالأسْماكِ مَعْ نَعَمٍ","يَتْلُوهُمُ الجِنُّ وَالأمْلاكُ وَالبَشَرُ",76,"ر",1,0],["وَالطَرفُ قَد زُمِّلَ في ثِيابِهِ","قائِدُهُ مِن أَرَنٍ يَشقى بِهِ",77,"ب",2,0],["وَالطَرفُ مِنكَ عَلى غا","ئبِ الضَميرِ دَليلُ",78,"ل",1,0],["والطنابيرِ والطبول","بالرقص والغناء",79,"ا",2,0],["والطعنُ والضربُ عندنا قُبَلٌ","ثمّ خصالٌ هناكَ نُخفيها",80,"ي",3,0],["وَالطيبُ يَزدادُ طيباً أَن يَكونَ بِها","في جيدِ واضِحَةِ الخَدَّينِ مِعطارِ",81,"ر",1,0],["وَالطَبعُ يَهوي إِلى ما شانَ يَطلُبُهُ","لَكِن يُجَرُّ إِلى ما زانَ بِالمَسَدِ",82,"د",1,0],["وَالطَبعُ يَخفُرُ ذِمَّةً مِن ناسِكٍ","وَالعَقلُ يَكرَهُ جاهِداً إِخفارَها",83,"ر",3,0],["وَالطولُ في وَسطى البَنانِ لَعِلَّةٍ","كَالنَقصِ في إِبهامِها وَالخِنصِرِ",84,"ر",1,0],["وَالطِرفُ أَجفَرَهُ القَضاءُ فَخَصَّهُ","بِالرُخصِ ما فيهِ مِنَ الإِجفارِ",85,"ر",1,0],["وَالطَيرُ مِثلُ الإِنسِ تَعرِفُ رَبِّها","وَتَرى بِها الشَعراءَ وَالرُجّازا",86,"ز",2,0],["وَالطِرفُ يُضرَبُ وَالأَنعامُ مَأكَلَةٌ","وَالعيرُ حامِلُ ثِقلٍ وَهوَ مَنخوسُ",87,"س",1,0],["وَالطَيرُ وَالوَحشُ غاديها وَصالِحُها","وَاللَيثُ وَالشِبلُ وَالذَيّالُ وَالذَرَعُ",88,"ع",1,0],["وَالطَيرُ تَلتَمِسُ المَعاشَ غَوادِياً","في الأَرضِ وَهِيَ كَثيرَةُ الأَشراكِ",89,"ك",1,0],["وَالطَبعُ يَثبُتُ كَالهِضابِ وَمَن يَرُم","نَقلاً لَهُ يَعجَز وَيَعيَ بِنَقلِهِ",90,"ل",2,0],["وَالطَبعُ أَحكَمَهُ المَليكُ فَلَن تَرى","حَجَراً يَقولُ وَلا هِزبَراً يَبغُمُ",91,"م",1,0],["وَالطَيرَ جَمعاءَ ضُعفاها وَجارِحَها","حَتّى العُقابَ الَّتي حَدَّت أَشافيها",92,"ي",3,0],["والطّرْفُ يرْتاحُ إلى غُمْضِهِ","وَلَيسَ يَرْتاحُ إلى سُهْدِهِ",93,"د",2,0],["والطّيْرُ أغْرِبَةٌ علَيهِ بأسْرِها","فُتْخُ السَّراةِ وساكناتُ لَصَافِ",94,"ف",1,0],["وَالطاعِنُ الطَعنَةَ يَومَ الوَغى","يَذهَلُ مِنها البَطَلُ الباسِلُ",95,"ل",1,0],["والطول آلاف هناك ثلاثة","من هذه الأعوام فاحسب واعلم",96,"م",1,0],["والطعن يخرقها والزجر يقلقها","حتى كأن بها ضرباً من اللمم",97,"م",1,0],["والطير هدارٌ فأفقٌ أكدرٌ","يرمي الغمامَ به وأفقٌ يوفي",98,"ف",2,0],["والطوْقُ من لُبْسِ الحَمامِ عهِدتُه","وظِباءُ وَجْرَةَ ما لها أطْواقُ",99,"ق",1,0],["والطرف قد نبتت بالنبل جلدته","كأنه بين أنهار الدما شجره",100,"ر",2,0],["وَالطَّلُّ يَنْهَلُّ مِنْ مَسَاقِطِهِ","مِثْلَ عُقُودِ الْجُمَانِ مُنْتَثِرَهْ",101,"ر",2,0],["وَالطِّبَاقُ الْبَدِيعُ أَلْطَفُ شَيْءٍ","تَتَجَلَّى بِهِ مَعَانِي الْجَمَالْ",102,"ل",1,0],["وَالطِّيْبُ حِينَ تَذكَّى فِي خَمَائِلِه","دُجىً أَدَالَ هَنِيءَ النَّوْمِ مِنْ أَرَقِي",103,"ق",2,0],["وَالطَّائِرَاتُ يَكَادُ يُلْ","قَى عَنْ شَوَاكِلِهَا الرِّكَابُ",104,"ب",1,0],["وَالطَّائِرُ المرتاع فِي جَوِّهِ","يُنْذِر بِالمَأْسَاةِ فِي ذُعرِ",105,"ر",1,0],["وَالطَّالِعُ الْمَيْمُونُ فِي تَارِيخِهِ","حَيِّيّ الْعَلِي بِبُزُوغِ نَجْلِ مَحَمَّدِ",106,"د",1,0],["والطعام الذي تلذون من هم","صانعوه لكم سوى الفقراء",107,"ا",2,0],["وَالطَيرُ مِمّا اِستَحسَنَتكَ وَرُعتَها","ظَنّت أَبازٌ أَنتَ أَم طاووسُ",108,"س",1,0],["والطبيبُ الكِنْدِيُّ لم يُبْقِ في الطِّ","بِّ مَزِيداً لحاجةِ المسْتَزِيدِ",109,"د",1,0],["والطبُّ لا يصِلُ المَدَى إن لم تصِلْ","جَدْواه للأَرواحِ وَالأشباحِ",110,"ح",1,0],["والطرَسَ في يُمنْاه أبيضَ ناصِعًا","مثلُ اللواءِ على الكتيبة أحمرا",111,"ر",2,0],["والطيرُ فوقَ الغُصن غي","رُ الطيرِ داخلَ وكره",112,"ر",2,0],["والطير تجري على الاغصان عاكفة","تسبح الله جهرا في مغانيها",113,"ي",3,0],["وألطفُ ميزاتِ السياسيِّ أنّه","أديبٌ بأسرارِ البلاغةِ عالم",114,"م",1,0],["وألطافٍ ، كأنفُسهم عِذابٍ","وأسمارٍ ، كأوجُهِهمْ صِباح",115,"ح",1,0],["وَالطِّرْفُ أجْلَبُ زَائِرٍ لِمَؤونَةٍ،","مَا لمْ تُزِرْهُ بسَرْجِهِ وَلِجَامِهِ",116,"م",2,0],["والطائفيّة أنت أوّل معول","في سورها ، ثابرعلى تهديمها",117,"م",3,0],["وَالطّيبُ يَزْدادُ طِيباً أنْ يكُونَ بِها،","وَإنْ تَدَعْهُ غَيْرَ مِتْفَالِ",118,"ل",1,0],["والط