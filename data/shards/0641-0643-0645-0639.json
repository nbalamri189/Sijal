"الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94338","الوافر"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103269","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4396,"","https://poetry.dctabudhabi.ae/diwan/poem/111570","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133071","الرجز"],[4728,"خليليّ مرا دار سلمى (فصحى)","https://www.poetsgate.com/ViewPoem.aspx?id=176875",""],[4767,"ضمان الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179967",""],[4767,"وهْن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=211125",""],[4955,"دقائق عمرنا مرت دهوراً","https://www.poetsgate.com/ViewPoem.aspx?id=188775",""],[4978,"أحبكِ في صمت ولست بطامعِ","https://www.poetsgate.com/ViewPoem.aspx?id=177193",""],[5054,"ألم تر","https://www.poetsgate.com/ViewPoem.aspx?id=211425",""],[5155,"الربيع والفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=176155",""],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5232,"حَظٌّ جريح","https://www.poetsgate.com/ViewPoem.aspx?id=213613",""],[5277,"لحن الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=185565",""],[5320,"من أين هذا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=41630",""],[404,"طيوُر الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=191631",""],[5397,"بمد العمر قد ذهب الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=157906",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5582,"بريقٌ بِأَعْلَى الأَبْرَقَيْنِ تأَلَّقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63544",""],[5582,"عُوجُوا فَحَيُّوا مَغانِي رَبَّةِ الخالِ","https://www.poetsgate.com/ViewPoem.aspx?id=63561",""],[5691,"روح المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=206312",""],[5776,"دنا عامُ (الكروم)","https://www.poetsgate.com/ViewPoem.aspx?id=205840",""],[5804,"الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=191227",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[6024,"الجاهل","https://www.poetsgate.com/ViewPoem.aspx?id=186349",""],[6093,"سفيرنا القدوة","https://www.poetsgate.com/ViewPoem.aspx?id=188406",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""],[6290,"هَوَى الصِّبْيَانِ وَشْمٌ فِي قُلُوبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85167&r=&rc=4",""]],"verses":[["فكم عملٍ من مرسلٍ غير صالحٍ","وكم طالحٍ في الناس أنجب ملهما",0,"م",2,0],["فَكَم عَفَّرنَ مِن وَجهٍ كَريمٍ","غَداةَ لَقيتُهُم وَالنَقعُ كابِ",1,"ب",1,0],["فكم عللن قبلي من قرون","إلى أن شافها الحدثانُ شوفا",2,"ف",2,0],["فَكَم عَجَّبَت مِن ناظِرٍ مُتَأَمِّلٍ","وَكَم حَيَّرَت مِن سامِعٍ مُتَعَجِّبِ",3,"ب",1,0],["فَكَم عَنِّيَ الواشي هُناكَ وَبُيِّتَ ال","عَذولُ بِلَيلٍ سَرمَدٍ مُتَطاوِلُه",4,"ل",2,0],["فَكَمْ عَهْدِ صِدْقٍ مَرَّ فِيهِ وَأَعْصُرٍ","تَوَلَّتْ عِجَالاً دُونَ تَهْوِيمِ نَائِمِ",5,"م",1,0],["فَكَم عَصَبتُ بِرَأسي","وَكَم عَرَكتُ بِجَنبي",6,"ب",2,0],["فَكَم عَصَيتُنَّ مِن ناهٍ وَناهِيَةٍ","وَكَم فَضَحتُنَّ أَخوالاً وَأعماما",7,"م",2,0],["فكم عادة تختال تحت منصة","معصفرة السربال مصقولة الخد",8,"د",1,0],["فكم عبد بهم أضحى أميراً","ومهجور إلى المولى توصل",9,"ل",1,0],["فكم عافَيْتَني، وشَفَيْتَ دائي","وكم أَبْدَلْتَني يُسْرًا بِبُؤْسي",10,"س",2,0],["فَكَم عَوصَاءَ قَد حَلَّت وأعيَت","أتَتهُم فَأنثَنَت شَمسَ زَوَالِ",11,"ل",1,0],["فَكَم عِلاَجٍ لَهُ لَم يُدرِ بَاطِنُهُ","لِذِى الحِجَا عَن صَحِيحِ الكَشفِ قَد كَشَفَا",12,"ف",2,0],["فكم عالم فيهم وكم من مجاهدٍ","وكم من ولي قد تخيّرها رمسا",13,"س",2,0],["فكم عصبت للحق منه سجية","تؤدب بالأفكار من لا يؤدب",14,"ب",1,0],["فكم عيدٍ بها أَهْدَى وأَدْنَى","حبيباً كانَ أَبْعَده اجْتِناب",15,"ب",1,0],["فَكَم عذّبوهم كَي يَعودوا لشِركهم","فَما رَجَعوا وَالبعضُ قَد قُتلوا صبرا",16,"ر",2,0],["فكم على ضوئِها الفضيّ من صُوَرٍ","شتّى تجلّت لعيني ذات ألوان",17,"ن",1,0],["فكم عليكم بهِ للهِ من حججٍ","هل يغفرُ الذنبَ إلا بعدَ أعذارِ",18,"ر",1,0],["فكم عبقت أرجاءُ أرجاءِ طيبها","وريح الصبا عنها الشذا جاءنا يحكي",19,"ك",2,0],["فكم عليه صبا الأسحار هبّ وكم","حلّته أنفاسه منها نفائسه",20,"س",2,0],["فكم عثراتٍ للكرامِ جَبرتُها","وكم من جميلٍ للّئامِ وإجمال",21,"ل",1,0],["فَكَمْ عَادَ مُخضَرّاً مِنَ العَيْشِ أغْبَرا","وكَمْ عَادَ مُغْبَرّاً مِنَ العَيْشِ أرْفَغا",22,"غ",2,0],["فَكَمْ عَالِمٍ أرْدَتْ عُلاهُ وَمُعْلَمٍ","بِضَرْبٍ من التبكيتِ كالطّعنِ والضّربِ",23,"ب",1,0],["فَكَم عَينِ ظَبيٍ حَدَّقَت بِإِهابِهِ","إِلى صَيدِ ظَبي فَهوَ مِن بِأسِهِ كابي",24,"ب",2,0],["فكمْ عَنَتِ الوجوهُ له","وربضتْ أَنفسٌ شُمُسُ",25,"س",1,0],["فَكَم عَرضت لَك الجلّى وأجلت","عَنِ العزمِ المؤيّد روح قدسِ",26,"س",1,0],["فَكَم عَقَرتُ عَلى البَيداءِ مِن بَدَنٍ","أَكَلَهُ السَعيُ في قَصدي لِمَغناكِ",27,"ك",1,0],["فكَم عَزمةٍ أصبَحَت","وبالاً عَلى العازِمِ",28,"م",1,0],["فكم عالمٍ منهمُ عاملٍ","نبيلٍ وكم مِن همامٍ بطَلْ",29,"ل",1,0],["فكم عطف الدهر الخؤون لنازح","وأبدله ما لم يكن فيه يطمع",30,"ع",1,0],["فَكَم عَزمَةٍ لِلمَلكِ زادَت بِحِكمَةٍ","وَسَدَّت عَلى سُبُلِ الطَريقِ المَسالِكا",31,"ك",2,0],["فكم عذتُ من لَيْلِ الهمومِ بلَيْلَةٍ","تركتُ بِهَا الأَجفانَ حَسْرَى ونُوَّمَا",32,"م",2,0],["فكم عسفوا إِلَيْهِ لُجَّ بحرٍ","تَلاقَى الماءُ فِيهِ والسَّماءُ",33,"ا",2,0],["فكم عالمٍ زلت به النعل للشقا","وكم جاهل قد أطلق اللَه باعه",34,"ع",2,0],["فكم عاقه عند الرضاع اشتغالها","فيعتاض بالإعفاء بضع دقائق",35,"ق",1,0],["فكم عند ذكر الملوك لهم","بمثلك من مثل سائر",36,"ر",1,0],["فكم عزيزٍ له ولّت ضراغِمُه","وكم كِناسِ خِباً قد فرّ جُؤذرُهُ",37,"ر",2,0],["فكْم عشتُ مقروناً بقومٍ صحبتُهمْ","ولكنّني لم أنتفعْ بقِرانِ",38,"ن",1,0],["فكم عُقِرتْ من أجلهنّ شِمِلَّةٌ","وذاق الرّدى حتّى فَهِقْنَ بعيرُ",39,"ر",1,0],["فكم على الأَغصانِ من مُنشدٍ","بل كَمْ على الأَغْصانِ من مَعْبد",40,"د",1,0],["فكم عزّيتني عما دهاني","وقلت اكفف بكاءك والعويلا",41,"ل",2,0],["فَكَم عائِذٍ عَنّا وَعَنكُم وَبائِعٍ","حَميَّتَهُ فينا وَفيكُم بِدِرهَمِ",42,"م",1,0],["فكم عززتني ورفعتَ شأني","وكم أَجهدتَ في مَددي قواكا",43,"ك",2,0],["فَكَم عاشِقٍ قاسى الهَوانَ بحبّنا","فَصار عَزيزاً حينَ ذاق هوانا",44,"ن",2,0],["فَكَم عِندَها الأَعداءُ خَرّوا عَلى الثّرى","وَأَرؤُسُهم عَنهُم لَدَيها رَواكِعُ",45,"ع",1,0],["فَكَمْ عُذِلُوا عَلَى إْفَراطِ بَرٍ","فَمَا أصْغَوْا لِعَذْلِ العاذِلَيْنِ",46,"ن",1,0],["فكم عَزمة للشوق بين جوانحي","سيبعثها التذكارُ يوماً فتظهر",47,"ر",1,0],["فكم عُرْفٍ له في","صفحة اللبَّات منشورِ",48,"ر",1,0],["فكم على يده البيضاء قد ظهرت","كرامة خص في إظهارها وحبى",49,"ب",2,0],["فَكَمْ عَدُوّ بَغَى ظلْماً عَلَيّ وَهَل","إلاّكَ مُعْتَمَدِي فِيمَا مَضَى وَبَقِي",50,"ق",2,0],["فَكم عارضٍ مِن غيثهِ أنت خائب","وَإِن شمته لي مرعد المزنِ مُبرقا",51,"ق",2,0],["فَكَم عَليَّ بما يجري القضاء به","مِن نعجةٍ فتكت قسراً برئبالِ",52,"ل",1,0],["فكم عانقت غصناً في اعتدال","به ولثمت بدراً في كمالِ",53,"ل",1,0],["فكم عاتق للورد في وجناتها","ذبول ودمع الحزن ينهل ساكبه",54,"ب",2,1],["فكم عاشق ذاق يوم النوى","وقد غرد الحاديان المنونا",55,"ن",2,0],["فكمْ عارضِ مِنْ جَيْشِهِ أَمْطَرَ الرَّدَى","وأَرْعَدَ في أَرْضِ العَدُوِّ وأَبْرَقا",56,"ق",2,0],["فَكم عادى مُغالِبَهُ بشَرٍّ","وساقَ إلى مُواليهِ بِشَارَهْ",57,"ر",2,0],["فكمْ عَصِيٍّ عليهِ يَشْقَى","وكمْ مُنيبٍ لَدَيهِ يَسْعدْ",58,"د",1,0],["فكم عالم صاحوا به أنت جاهل","وكم جاهل قالوا له أنت عالم",59,"م",1,0],["فكم عبد عتا وعصى وأضحى","على فعل إلى النيران سُلم",60,"م",1,0],["فكَم علَت نفسِيَ فيها وغلَت","وفي مَوارِد المَعاصي وغَلَت",61,"ت",1,0],["فَكَم عَامِرٍ قَد أَلحَقَتهُ بِدَارِسِ","عَلَى عَارِفَاتٍ لِلطّعانِ عَوَابِسِ",62,"س",1,0],["فَكَم عَارِفٍ بِي وَهوَ يَحسُدُ رُتبتِي","فَيَمدَحُنِي سِرّاً وَيَشتمُنِي جَهرَا",63,"ر",2,0],["فكم علّلتِ بالآمال نفسي","ولم أَرَ ماءها إلاَّ سَرابا",64,"ب",2,0],["فكم عابد تلقه في ذوي","خشوع ونسك لرب العباد",65,"د",1,0],["فكم عبدٍ قضى الأيّام عزّاً","وكم حرٍّ أذاب العمر هونا",66,"ن",2,0],["فَكَم عِظَةٍ أَسدَت إِلَيَّ خُطوبُهُ","وَكَم كَشَفَت لي عَن عَدُوٍّ نَوائِبُه",67,"ب",2,0],["فكم علم حويت بحمد ربي","وإن شئتم علومي فاسمعوني",68,"ن",2,0],["فكم عبرةٍ أَعْطَتْ غرامي زِمامَها","عَشِيَّةَ أَعْمَلْنَ المطيَّ المُزَمَّمَا",69,"م",2,0],["فَكَم عَثرَةٍ فيهِ تُقالُ وَتائِبٍ","يُحَطُّ مِنَ الأَوزارِ عَنهُ حُمولُ",70,"ل",1,0],["فَكَم عاهَدوا عَهداً وَهم يَنقُضونَهُ","وَكَم حَلَفوا بِاللَهِ حَلفَةَ آثِمِ",71,"م",1,0],["فَكَم عَفَّ عَمَّن لَو جَزاهُ بِذَنبِهِ","لَطارَ مَعَ العَنقاءِ حَيثُ تُحَلِّقُ",72,"ق",1,0],["فكم عجائب من نعماء سوغني","عفواً فكل زماني عنده رجبُ",73,"ب",1,0],["فَكَم عَهِدَت أَن لا تَحولَ وَأَقسَمَت","وَلَيسَ لِمَخضوبٍ وَفاءٌ بِأَيمانِ",74,"ن",1,0],["فكم عقدت للتهاني مجلسا","به بدا ثغر الهنا مبتسما",75,"م",2,0],["فكم عانقوا من متلفات من الفنا","وما عانقوا إلاّ الضُّبا والعواليا",76,"ي",2,0],["فَكَم عارٍ كَسَوت وَكَم أَسير","فَكَكتَ وَكَم تَكفّلت الأَيامى",77,"م",2,0],["فَكم عارض يَجري عَلى الصَخر ماؤه","وَيَهوي بِأَرض تنبت الشيح حاصبه",78,"ب",2,0],["فكم على أوج العلى","من قدم له رسا",79,"س",2,0],["فكم عبد سامٍ بنيت ومعبد","وما ان لها من مشبهٍ ومثيل",80,"ل",1,0],["فكم عليل قد شفى وكم وقى","البلاد من داء وبيل سار",81,"ر",1,0],["فكم علما وكم فقهاء كانوا","وكم صلحا جهابذة وقرّا",82,"ر",2,0],["فكم عاجز واسعٍ ماله","وكم حازمٍ فقره مدقع",83,"ع",1,0],["فكم عسكر كالليل تحت ركابه","مجيب إلى طاعات من قد تفرِدا",84,"د",2,0],["فكم عاشرت فيهم من رفيق","بذلت لحبه خبزي ومائي",85,"ا",2,0],["فكم عابر منهمُ في الطريق","علينا الشقاء به قد عبر",86,"ر",1,0],["فكم عاشق قد مات قبلي صبابة","ولكنه من بعد ما مات قرّبا",87,"ب",2,0],["فكم عندها من ألف باغ ومسرف","يكيدونها كيد اللئام عداها",88,"ا",3,0],["فَكَم عكسَ المآرب والأماني","وكم أبلى من العَليا جديدا",89,"د",2,0],["فكم عارف نال المعالي ببعضها","ونال مراده في أقرب ساعة",90,"ه",1,0],["فَكَم عالم كالبحرِ فيها إذا انبَرَى","على مِنبَرٍ يَوماً تَلَقّظَ بِالدُّرِّ",91,"ر",1,0],["فكم عزيمة صبر فيك قد عقدت","فحلَّها لحظُك النفاثُ في العقد",92,"د",1,0],["فكم عاذل فيها تبين أنه","نصيح على تعذاله غير مؤتل",93,"ل",1,0],["فَكَم عرّضت بكر العلا لي نفسها","وَلَم يك غير الحظّ لي من معارضِ",94,"ض",1,0],["فَكَم عَرائِس افكار بِهِ اِفتَخَرَت","في دُر نُظم يَروقُ السَمعَ مَعناهُ",95,"ا",2,0],["فكم عتوا على الورى","بظلمهم وجورهم",96,"م",1,0],["فكم على حبها خاطرتُ من خطرٍ","وقلتُ دونكَ يا سهمَ الردى كبدي",97,"د",2,0],["فَكَم عَزيزٍ فَريدٍ هان جانبُه","وَكَم يَعزُّ ذليل حَوله أُمم",98,"م",1,0],["فَكَم عبرةٍ أَ