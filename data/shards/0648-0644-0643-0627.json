],[498,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[536,"حيثما سرت فالمعالي تسير","https://www.aldiwan.net/poem48186.html","عموديه"],[536,"ولك العزا فيما مضى","https://www.aldiwan.net/poem48205.html","عموديه"],[549,"ألا يا لقومي لاعتنان النوائب","https://www.aldiwan.net/poem47146.html","الطويل"],[549,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[549,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[549,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[549,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[556,"إنني غير من أحب وإني","https://www.aldiwan.net/poem33562.html","الخفيف"],[556,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[560,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[560,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[573,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[573,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[573,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"]],"verses":[["وَلَكَ التُراثُ مِنَ النَبِيِّ مُحَمَّدٍ","وَالبَيتُ وَالحَجَرُ العَظيمُ وَزَمزَمُ",0,"م",1,0],["ولكَ الأيادي ما يزالُ بذِكْرِها","يَطْوي الفَلا مَرِحُ النَّجاءِ فَنيقُ",1,"ق",1,0],["وَلَكَ الْجَوَارِي الْمُنْشَآتُ سَوَابِحاً","فِي الْيَمِّ أَمْثَالَ الصُّقُورِ الْحُوَّمِ",2,"م",1,0],["وَلَكَ السَّجَايَا الْعُزَّ وَالشِّيَمُ ألَّتِي","بِغَرِيبِهَا يَتَمَثَّلُ الْمُتَمَثَّلُ",3,"ل",1,0],["وَلَكَ الْوَقَارُ إِذَا تَزَلْزَلَتِ الرَّبَا","وَهَفَتْ مِنَ الرَّوْعِ الْهِضَابُ الْمُثَّلُ",3,"ل",1,0],["وَلَكَ الْجَبِينُ الطَّلْقُ وَالْخُلُقُ الَّذِي","لَحْظُ الْكَمَالِ بِلَحْظِهِنَّ مُوَكَّلُ",3,"ل",1,0],["ولَكان دِرْهَمُهُ الذي يسْمو بهِ","بدْرُ السّماءِ وشمْسُها دينارُهُ",4,"ر",2,0],["وَلَكَ الْكَتَائِبُ كَالْخَمَائِلِ أَطْلَعَتْ","زَهْرَ الأَسِنًّةِ فَوْقَ كُلِّ قَضِيبِ",5,"ب",1,0],["وَلَكَ الصِّبَا وَالزَّعْوُ وَالزَّمَنْ الرِّضى","وَاللَّهْوُ وَالسَّعْدُ المُطِيعُ الْخَادِمُ",6,"م",1,0],["وَلَكَ المَوَدَّةُ في قُلوبِ ذَوي النُهى","وَعَلى عَدُوِّكَ مَقتَةٌ وَدَمارُ",7,"ر",1,0],["ولك القباب الحمرُ تُرفع للندى","فترى العمائمَ تحتها كالأنجمِ",8,"م",1,0],["ولك العوالي السمرُ تُشرعُ للعدى","فتخرُّ صرعى لليدين وللفَمِ",8,"م",1,0],["ولك الأيادي البيضُ قد طوّقتها","صيدَ الملوك ذوي التلاد الأقدمِ",8,"م",1,0],["وَلَكانَ لي عَمّا سَأَل","تُ مِنَ الفِدا نَفسٌ أَبِيَّه",9,"ي",2,0],["ولك الوُدُّ كالذي كان من خِل","لك والصدرُ غيرُ ذي الشّحناءِ",10,"ا",2,0],["ولك العذر مثل قافيتي في","ك اتساعاً فإنها كالفضاءِ",10,"ا",2,0],["ولَكَ القولُ لا لنا ولك التَّسْ","ليمُ منَّا لمذهب الحكماءِ",11,"ا",2,0],["ولك المعاذةُ والسلامةُ منهما","بمَحاتِدٍ لك هن خير مَحَاتدِ",12,"د",1,0],["ولك الزقُّ والحِضانُ وتحظى","هي حقاً بلذَّةِ الافتراش",13,"ش",1,0],["ولك الفضلُ يا ابن يحيى عليه","غيرَ مُستنكرٍ ولا مدفوع",14,"ع",1,0],["ولك الوفورُ فإن رُزئْتَ رزيئةً","فرزيئة المرزوء لا المفجوعِ",15,"ع",1,0],["ولك النعمة لا أجحدها","ما بدا ضوء نهار فسطع",16,"ع",1,0],["ولك الله والنبي وأهلو","ه شهوداً والمسلمون جماعه",17,"ع",2,0],["ولك اللَّهُ إنْ عرضْتَ عليه","حاجتي أن تقول أهلاً وسهلا",18,"ل",2,0],["ولك اعتلاءُ الجَدّ في","خفضٍ وعيشٍ لا يُمَلُّ",19,"ل",1,0],["ولكان أوسعَ مُهلةً من غيره","لو تحسنُ الحوجاءُ في تمهيلِهِ",20,"ل",2,0],["ولكادا من التنافس في وج","هكَ خير الوجوه يجتمعان",21,"ن",1,0],["ولكَ التفَطُّن قبلَ كُل مُفَطَّنٍ","ولك التبَيُّن دونَ ذي التبيين",22,"ن",1,0],["ولك الغِلمانُ والخي","لُ وأنواعُ المطايا",23,"ا",3,0],["وَلَكَ الحُقولُ وَزَهرُها وَأَريجُها","وَنَسيمُها وَالبُلبُلُ المُتَرَنِّمُ",24,"م",1,0],["وَلَكانَ شَهدُ الأَرضِ في أَفواهِنا","وَهوَ الَّذيذُ أَمَرَّ مِن زَقّومِها",25,"م",3,0],["ولك الذين رفعتهم","حفروا بجوف الارض لحدا",26,"د",2,0],["ولك ابتداءات الفرز","دق في مقاطع جرول",27,"ل",1,0],["وَلَكَ المَدائِنُ وَالثُغورُ مَنيعَةً","في مَجمَعِ البَحرَينِ تَحتَ لِواكا",28,"ك",2,0],["وَلَكَ البَيانُ الجَذلُ في","أَثنائِهِ العِلمُ الغَزير",29,"ر",1,0],["وَلَكَ الريفُ وَالصَعيدُ وَتاجا","مِصرَ وَالعَرشُ عالِياً وَالرِداءُ",30,"ا",2,0],["وَلَكَ المُنشَآتُ في كُلِّ بَحرٍ","وَلَكَ البَرُّ أَرضُهُ وَالسَماءُ",30,"ا",2,0],["وَلَكَ الزَمانُ مِنَ الزَمانِ وِقايَةٌ","وَلَكَ الحِمامُ مِنَ الحِمامِ فِداءُ",31,"ا",2,0],["وَلَكَ الناسُ وَالبِلادُ وَما يَس","رَحُ بَينَ الغَبراءِ وَالخَضراءِ",32,"ا",2,0],["ولك الكتائب وهي مُشعَلَةٌ","والبيضُ في الهامات تشتعلُ",33,"ل",1,0],["ولك البسيطةُ حيثُ مدَّ غِطاءَهُ","ليلٌ وما كشفَ الغِطاءَ نَهارُ",34,"ر",1,0],["وَلَكانَ غَزوُ الرومِ بَعضَ مَآرِبي","وَهَمّي وَلا مِمّا أُطالِبُهُ الأَجرُ",35,"ر",1,0],["وَلَكَ السَلامَةُ وَالسَلامُ فَإِنَّني","غادٍ وَهُنَّ عَلى عُلاكَ حَبائِسُ",36,"س",1,0],["ولَكَ الظَّبيةُ الغَريرَةُ إنْ شِئْ","تَ فإن عِفْتَضها فظَبْيٌ غريرُ",37,"ر",1,0],["وَلَكَ الأَنعُمُ الَّتي كُلَّ حَدسٍ","بَينَنا غَيرَ شُكرِها مَنبوذُ",38,"ذ",1,0],["وَلَكَ الرُتبَةُ الَّتي قَصَّرَت دو","نَ عُلاها النيرانُ وَالفَرقَدانِ",39,"ن",1,0],["ولك السيف ساهراً","يقظاً غير مغمد",40,"د",1,0],["ولك الجيد أتلعا أودع الصانع فيه من قدرة ما يشاء","قدَّ من مرمر وشعشعه الفجر بورد وصب فيه الضياء",41,"ا",2,0],["ولك الحق لقد عاش الهوى","فيّ طفلاً ونما لم يعقل",42,"ل",1,0],["ولَكانَ في دَرْسِ العلومِ وحِفظِها","بَينَ الأَفاضلِ مبدأَ الأعدادِ",43,"د",1,0],["وَلَكَ الظَرفُ وَالمَلاحَةُ وَالحُس","نُ وَطيبُ الأَردانِ وَالأَخلاقِ",44,"ق",1,0],["وَلَكَ الوُدُّ دائِماً ما بَقينا","قاطِعاً بَعدُ كُنتَ لي أَو وَصولا",45,"ل",2,0],["ولكان عِنديَ يا وليدُ مُقَدَّماً","يَلْقَى لَدَيَّ البرَّ والإكراما",46,"م",2,0],["ولك العذرُ إن رقصتَ فَهذِي","نَشوةُ الحبِّ تأخُذُ المُخلِصينا",47,"ن",2,0],["وَلَكانَ في حَدَقِ الرِماحِ تَشاوُسٌ","وَلِأَلسُنِ البيضِ الرِقاقِ خِصامُ",48,"م",1,0],["وَلِكِ الهَمُّ حَيثُ كُنتُ وَكُنتُم","وَإِلَيكِ الأَحلامُ وَالأَشعارُ",49,"ر",1,0],["وَلَكَ المِنَّةُ فيها عَلَينا","لَم نَجِد مِثلَكَ في العالَمينا",50,"ن",2,0],["ولَكَ الأُمَّةُ التي غَبَطَتْهَا","بكَ لَمَّا أتيْتَها الأنبياءُ",51,"ا",2,0],["ولكَ الشَّفاعَةُ كأسُها وحِياضُها","ولكَ المَعِينُ تَعُلُّ منهُ وتُنْهِل",52,"ل",1,0],