{"poems":[[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[409,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[580,"حمزة كلب يعوي","https://www.aldiwan.net/poem2795.html","مجزوء الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66719","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63741","الرجز"],[2645,"","https://poetry.dctabudhabi.ae/diwan/poem/130236","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112628","الرجز"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130553","الرمل"],[5488,"تجنّب رذال الناس يا نسل الأجواد","https://www.poetsgate.com/ViewPoem.aspx?id=100729",""]],"verses":[["حَمزةٌ مع عبيدةٍ وعليٍّ","طَحَنوا الشركَ والرحا الهيجاءُ",0,"ا",2,0],["حمزة والطائفين به","من سيوف اللّه بل أسده",1,"د",2,0],["حَمْزةُ كلبٌ يَعْوِي","يُريدُ غيرَ الْهجْوِ",2,"و",1,1],["حمزةُ والطيارُ في جنّةٍ","فحيث ما شاءَ دعا جعفرُ",3,"ر",1,0],["حمزةَ والعباسِ والطيَّار","حَوَتْ قريشٌ عِمَّةَ الفَخَار",4,"ر",1,0],["حَمْزةَ الماجدَ الذي جَدَّلُوهُ","دَراعاً ذا حَفِيظةٍ غيرَ وَغْلِ",5,"ل",1,0],["حَمزَةَ المِقدامَ بَل عَبّاسَهُم","شَمسَ فَضلٍ في المَعالي أَمكَنا",6,"ن",2,0],["حمزةُ عمي أسدُ الرحمنِ","وجعفرُ الطيارُ في الجنانِ",7,"ن",1,0],["حمزةُ المبتاع بالمال الثنا","ويرى في بيعه أن قد غبَن",8,"ن",1,0],["حمزه وعلي وعثمان ما نسيت مقداد","بن أسود الكندي سموم الأعادي",9,"د",2,0]]}