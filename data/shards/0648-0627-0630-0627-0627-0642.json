رعى الله من إلى","https://www.aldiwan.net/poem47407.html","مجزوء الخفيف"],[556,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138280",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64874","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109061","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49948","البسيط"],[2025,"","https://poetry.dctabudhabi.ae/diwan/poem/203575",""],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10425","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205784","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74155","الكامل"],[3301,"","https://poetry.dctabudhabi.ae/diwan/poem/144899","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74055","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52971","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76470","الخفيف"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58029","الكامل"],[585,"أهلاً بثوبي العسكري فإنه","https://www.poetsgate.com/ViewPoem.aspx?id=161949",""],[5183,"هبة العليم","https://www.poetsgate.com/ViewPoem.aspx?id=180194",""],[5431,"نفحات الفن ...","https://www.poetsgate.com/ViewPoem.aspx?id=209138",""],[5612,"يا نَفْسُ مالَك !!","https://www.poetsgate.com/ViewPoem.aspx?id=182938",""],[5897,"إيه .. يا جنة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=176413",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[6102,"خامِس الفُصُول !!","https://www.poetsgate.com/ViewPoem.aspx?id=183982",""],[463,"منْ حاكمٌ وخصوميَ الأقدارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60069&r=&rc=125",""],[6251,"وجه الهلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76470&r=&rc=10",""]],"verses":[["وَإِذا اِقتَصَصتَ مِن ابنِ عَمِّكَ كَلمَةً","فَكُلومُهُ لَكَ إِن عَقِلتَ كُلومُ",0,"م",1,0],["وإذا أقامك لم يزد في غَمْزِهِ","إياك ملتمساً لأن تتأوَّدا",1,"د",2,0],["وإذا اقتضيتُ مطلتني ولويتَني","فلقيتُ منك شكاسة ومِراسا",2,"س",2,0],["وإذا أقْفَلَتْ على الأير كالكل","بة يوماً فقُفْلُها ما يُفَشُّ",3,"ش",1,0],["وَإِذا أَقولُ صَحَوتُ مِن أَدوائِها","هاجَ الفُؤادَ دُمىً أَوانِسُ حورُ",4,"ر",1,0],["وَإِذا اِقتَضَيتُكَ لَم تَزِد","عَن قَولِ إي وَاللَهِ غَد",5,"د",1,0],["وَإِذا أَقولُ سَلا تُجَدِّدُ ما بِهِ","مِنها عَقائِلُ حُبُّها المُتَرَدِّدُ",6,"د",1,0],["وَإِذا أَقاموا لِلمَعارِفِ رُكنَها","تَمَّ البِناءُ بِها وَقامَ السورُ",7,"ر",1,0],["وَإِذا أَقولُ عَسى وَلَيتَ وَرُبَّما","فَمَقالُ لا لِلصَبِّ مِن أَخبارِهِ",8,"ر",2,0],["وإذا أقرّ المشرِكونَ بفَضْلِهِ","قَسْراً فما أدراكَ ما الحُنفاء",9,"ا",2,0],["وَإِذا أَقبَلَ كادَت أَعيُنٌ","نَحوَهُ تَجرَحُ فيهِ بِالحَدَق",10,"ق",1,0],["وَإِذا أَقَلَّ لِيَ البَخيلُ عَذَرتُهُ","إِنَّ القَليلَ مِنَ البَخيلِ كَثيرُ",11,"ر",1,1],["وَإِذا أَقبَلَت تَهادى الهُوَينى","اِشرَأَبَّت ثُمَّ اِستَنارَ الفَضاءُ",12,"ا",2,0],["وَإِذا اِقتَضَيتَ مَعَ السَعادَةِ كابِياً","أَورَيتَهُ ناراً فَقيلَ عَفارُ",13,"ر",1,0],["وَإِذا اِقتَنَصنا لا يَجِفُّ خِضابُها","وَكَأَنَّ بِركَتَها مَداكُ عَروسِ",14,"س",1,0],["واذا اقترحت على الص","في الحرب ساء الاقتراح",15,"ح",1,0],["وإذا أقرّ المشركونَ بفضلهِ","قَسْراً فما أدراكَ ما الخُنفاء",16,"ا",2,0],["وإذا أقدمت في أمر","فعن غير انتكاس",17,"س",1,0],["وإذا أقسمَ الفَتى لا يَراهُ","فَرَقاً منه في يَمينٍ يَمين",18,"ن",1,0],["وَإِذا اِقتنيت سِوى التَوَكُ","ل فَالبِضاعة لِلاضاعة",19,"ع",2,0],["وإِذا أَقرَّتْ بالهَوى زَفَراتُهُ","لم يُغنِ عَنهُ وإِن أَصَرَّ جُحودُهُ",20,"د",2,0],["وإذا اقشعرَّتْ أرضِيَ استصرختهُ","فإذا لجينٌ تُربُها ونُضارُ",21,"ر",1,0],["وإذا اقشعرّ العامُ أغدقَ من ندَى","أيديهم الوادي ورَفَّ العودُ",22,"د",1,0],["وَإِذا اِقتَسمتم فالشَّوى","لهُمُ وحصّتُك السّنامُ",23,"م",1,0],["وإذا أقلَقَ الجوا","نِحَ شُغلٌ تفرّغا",24,"غ",2,0],["وَإِذا أقمتُ فلا أبا","لي مَن يرحّلُهُ القَضا",25,"ض",2,0],["وإذا اقتحمت الخطب لست بهائب","هولا كأنك في الخطوب غضنفر",26,"ر",1,0],["وإِذا أقامَ على الثُّغور مُخيِّما","مَلأَ المَلاَ مِنْ ضَيْغمٍ وعِرِيفِ",27,"ف",1,0],["وإذا أقفر الطريق فلا يشكو","انفرداً وعزلة في مكان",28,"ن",1,0],["وإذا أُقاربُ علاّت الصِّبا بهوى","على النُّهاة شموسٌ غير مُنقادِ",29,"د",1,0],["وإذا أقبل موسى","خلته يحمل قبرا",30,"ر",2,1],["وَإِذَا أقَرَّ بِهِ فَسَلهُ ثانِياً","أتَرَاهُ غَيرَ جَمِيعِ ذِي الأكوَانِ",31,"ن",1,0],["وَإذَا أقَرَّ بِأنَّهُ غَيرُ الوَرَى","عَبدٌ وَمعبُودٌ هُمَا شَيئَانِ",31,"ن",1,0],["وَإِذا أَقومُ بِخُطبَةٍ تَرضى بِها","وَإِذا أَقومُ بِخُطبَةٍ تُخزيني",32,"ن",2,0],["وإذا أقبل المساء ومالت","شمسه للمغيب تنوي رحيلا",33,"ل",2,0],["وَإِذا أَقَمت بِداره قامَت بِكَ ال","أَفراح مِن نور وَمِن إِشراق",34,"ق",1,0],["وإذا أقام ولم يحل عن حاله","عادى العقول وصالح الأرواحا",35,"ح",2,0],["وَإِذا أَقسم الوَرى أن يَبروا","فَذوو يعرب أبرّ يَمينا",36,"ن",2,0],["وإذا اقترحْت فتلك غيرُ مُجيبةٍ","لكن بمدحك قد وفتْ بنجيبةٍ",37,"ه",1,0],["وإِذَا أقلَعَت وَبَانَ لَهَا كَفٌّ","رَوَى الخَلقَ كَفُّهُ المِعطاءُ",38,"ا",2,0],["واذا اقبل الظَلام وامست","كل عين نخافها في سبات",39,"ت",1,0],["وَإِذا أَقولُ صَحَت عَمايَتُهُ","عادَ الهَوى لِلقَلبِ يَردَعُهُ",40,"ع",2,0],["وإذا اقْتَرَفْنا زَلَّةً عُدْنا له","بالثَّوْب في ندمٍ مع استغفار",41,"ر",1,0],["وإذا اقتحمت فمت تحت لوائه","حسبي بأن النصر من أعياده",42,"د",2,0],["وإذا أقام به الغريب حياته","فغداؤه ورداؤه ورُواؤه",43,"ا",3,0],["وإذا اقتربت لمست ألين مابها","وإذا ابتعدت فحضنها الجبروت",44,"ت",1,0],["وإذا اقْتَربْتِ ... فحُلْوةٌ ولَطيفةٌ","وإذا ابْتَعدْتِ ... فمُرَّةٌ وسَليطةْ",45,"ط",2,0],["وإذا اقتحمتِ على الهوى آفاقه","قدحتْ سهامك فيه كل زنادِ",46,"د",1,0],["وإذا أقر فإنه","ماضٍ بحكمٍ قد وجب",47,"ب",1,0],["وَإِذا اقتَحَمتُ الحَربَ كُنتُ وَجِيبَها","لَكِنَّنِي فِي الحُبِّ ثَغرٌ هامِسُ",48,"س",1,0],["وإذا اقشعرتْ أرضيَ استرختهُ","فإذا لجينٌ تربها ونضارُ",49,"ر",1,0],["وإِذا أَقْبَلَ الصَّبَاحُ تَهَادَى","بِكَ وَجْهُ الصَّبَاحِ مِلْءَ خَيَالي",50,"ل",2,0]]}