em.aspx?id=215975",""],[5997,"حديثُ الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=214298",""],[6048,"أنَا المُدانَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=197749",""],[6070,"يا أيُّها الضَّوءُ المُسافرُ في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=197531",""],[6070,"ما أجملَ الشِّعرَ حِينَ الرُّوحُ تَسْكبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=197535",""],[6106,"ما بين الهجرة والهجمة على سيد الخلق صلى الله عليه","https://www.poetsgate.com/ViewPoem.aspx?id=6303",""],[5309,"يبني المقامر كل يوم قبره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573889",""],[5309,"أتصوغ اشعارا وجل الناس","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573836",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[6318,"صِدْقُ الوَفَاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66153&r=&rc=3",""],[147,"أَمّا الْفِراقُ فَقَدْ عاصَيْتُهُ فَأَبى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27437&r=&rc=4",""]],"verses":[["يَبني وَبَينَ المُنى أَنّي أَقولُ لَها","بَيني وَبَينَكَ قَطعُ البيدِ وَالبيدِ",0,"د",1,0],["يَبني وَيَهدِمُ في الشِعرِ القَديمِ وَفي ال","شِعرِ الحَديثِ فَنِعمَ الهادِمُ الباني",1,"ن",2,0],["يَبْنِي وَيَغْرِسُ لا يُقَصِّرُ عَنْ مَدَى","فِي المَطْلَبَيْنِ وَلا يُطِيلُ كَلامَا",2,"م",2,0],["يَبني بُيوتاً خَراباً لا أَنيسَ بِها","ما بَينَ طَوقٍ إِلى عَمرِو اِبنِ كُلثومِ",3,"م",1,0],["يبني على آساسه","وَقِوامُ بنيانٍ بِأُسِّه",4,"س",2,0],["يبني العلا ونقول فيه فإنما","تأليفنا يُحذى على تأليفه",5,"ف",2,0],["يبني الكثيف من اللطيف وإنما","تكثيف ذي التحصين من تلطيفه",5,"ف",2,0],["يَبني بِمالِكُمُ القُصورَ لِأَهلِهِ","وَقُصورُكُم أَثوابُكُم وَالمَعمَلُ",6,"ل",1,0],["يبني فيرفع ما يبني بحكمته","ويأخذ الشيء بعد الشيء عن كثب",7,"ب",1,0],["يَبنونَ حائِطَ مُلكِهِم في هُدنَةٍ","وَعَلى عَواقِبِ شِحنَةٍ وَخِصامِ",8,"م",1,0],["يَبنونَ دارَ اللَهِ كَيفَ بَدا لَهُم","غُرُفاتِ مُثرٍ أَو سَقيفَةَ عافي",9,"ف",2,0],["يَبني كَما تُبنى الخَنادِقُ في الوَغى","تَحتَ النِبالِ وَصَوبِها السَحّاحِ",10,"ح",1,0],["يَبنونَ بِالدُستورِ حائِطَ مُلكِهِم","لا بِالصِفاحِ وَلا عَلى الأَرماحِ",10,"ح",1,0],["يَبنونَ لِلدُنيا كَما تَبني لَهُم","خِرَباً غُرابُ البَينِ فيها يَنعَقُ",11,"ق",1,0],["يَبنونَ لِلَّهِ الكِنانَةَ بِالقَنا","وَاللَهُ مِن حَولِ البِناءِ مُوَفِّقُ",11,"ق",1,0],["يَبني الشَرائِعَ لِلعُصو","رِ بِناءَ جَبّارٍ رَحيمِ",12,"م",1,0],["يَبني بِهِ رَبُّنا المَعالي","كَما بِكُم يَغفِرُ الذُنوبا",13,"ب",2,0],["يُبِنَّ ليَ البَدْرَ الذي لا أُريدُهُ","وَيُخْفِينَ بَدْراً مَا إلَيْهِ سَبيلُ",14,"ل",1,0],["يَبني وَيَعمُرُ ما يَبنيهِ مِن أَمَمٍ","فَالأَرضُ دارٌ لَهُ وَالناسُ عُبدانُ",15,"ن",1,0],["يَبني الخَرابَ وَإِنَّما","يُبنى الخَرابُ لِيَخرَبا",16,"ب",2,0],["يبني بركضِ الجرد من أرضه","سماءَ نقع يومَ حَرْبٍ عوان",17,"ن",1,0],["يبني لأُمَّتهِ الحياةَ جديدةً","للعلم فيها روعةٌ وجلالُ",18,"ل",1,0],["يبني الفتى يوماً ويبني غيرُه","فإذا البناءُ على الحوادث دائبُ",19,"ب",1,0],["يبنِي ويهدِمُ جاهِداً ما مِثلُه","في الدَّهرِ بنّاءٌ ولا هدّامُ",20,"م",1,0],["يَبني المَعاقِلَ مُغتَرّاً بِمَنعَتِها","وَيَحشُدُ القُذَّفَ الفَوهاءَ وَالقَضبا",21,"ب",2,0],["يَبني الحياةَ على أساسٍ ثابتٍ","من قُوةِ اللَّهِ التي لا تُهْدَمُ",22,"م",1,0],["يبني الهزار عَلى الغصون لنفسه","عشاً فتهدم عشه الغُربان",23,"ن",1,0],["يبني الرجال من اللحى","فخراً لأنفسهم ومجدا",24,"د",2,0],["يَبْنِي التَمَاثِيلَ الحِسَانَ وَفِي","كُلٍّ يَرُوعُ الصَّوْغُ وَالسِّرُّ",25,"ر",1,0],["يَبْنِي التُّجَارُ لِمَا يَدُولُ","وَأَنْتَ تَبْنِي لِلدُّهُورِ",26,"ر",1,0],["يبنون للفار العلى","ويزرعون للدنيا",27,"ي",2,0],["يبني لأوطانه ويرفعها","والمصلح الحق من علا حجره",28,"ر",2,0],["يُبنى بأشلاء الضحا","يا، ثم يُطلى بالدماء",29,"ا",2,0],["يبنون بالفضل السلامَ، ولَيْتَهُم","بالروح قد عَلمُوا على استتبابه!",30,"ب",2,0],["يبنون أنفسهم على أشلائه","وعلى حساب النَّيْل من أقطابه",30,"ب",2,0],["يبنون بالظلم دورا كي نمجّدهم","ومجدهم رجس أخشاب وأحجار",31,"ر",1,0],["يَبني بُيوتاً خَراباً لا أَنيسَ بها","مابَينَ طَوقٍ إِلى عَمْرو بنِ كُلثومِ",32,"م",1,0],["يبنا العمومه؟؟؟؟ لاتحسبونّي ...... شنت","لالا .. واللذي تصبح بذكره .... الاذاعه",33,"ع",2,0],["يبني على أساسه","وِقِوامُ بنيانٍ يأسه",34,"س",2,0],["يبني المعالي رفيعات قواعدها","سمكا وينشي لما يبنيه سكانا",35,"ن",2,0],["يبني لك المجد المؤثَّلَ أخرسٌ","بَهَرَتْ فصاحتُهُ ذوي الألباب",36,"ب",1,0],["يَبنونَ ما تَقِفُ الأَجيالُ حائِرَةً","أمامَه بين إعجابٍ وَإذعانِ",37,"ن",1,0],["يَبنى عَلى مَجدِكَ المَعروف مُجتَهِداً","لا مَجدَ حَقاً لِغَيرِ الوارِث الباني",38,"ن",2,0],["يَبني الفتى فيها الرجاءَ عَلى شَفا","وَيقرّ منهُ مقرّ من لا يفزعُ",39,"ع",1,0],["يَبني بناءَ الخالدينَ سفاهةً","وَالدهرُ يهدمُ عمرهُ ويضعضعُ",39,"ع",1,0],["يَبنِي فِيهَا بإِنَابَتِهِ","ما هَدَّمَهُ أيامَ صِبا",40,"ب",2,0],["يَبْني محَامِدَهُ بهَدْمِ تلادِه","والجُودُ في مال الكريمِ يُعِيث",41,"ث",1,0],["يَبْني لَهمْ غرفَ المجد الأَثيل فتىً","مُسَوّدٌ لا يداني جودَهُ هَرمُ",42,"م",1,0],["يَبني مَآثِرَهُ وَيَهدِمُ مالَهُ","وَالمَجدُ ثالِثٌ هَدمِهِ وَبِنائِهِ",43,"ا",3,0],["يَبْني فيَهْدي للصوا","بِ بما بناهُ وليس يُهدَمْ",44,"م",1,0],["يبنيه أروعُ قاطبٌ متبسّمٌ","غيرانُ يؤخذ صعبُه من لينهِ",45,"ن",2,0],["يَبنيِ بنو عبدِ الرحيم سياجَها","حوطاً عليك كما يحاط الغيلُ",46,"ل",1,0],["يبني ولم يمهرْ وإن","طلَّقَ لم يمتِّعِ",47,"ع",1,0],["يبني السفينَ اللامعاتِ سرابُها","ويُعَدّ مخدوعاً ترابُ فلاتِها",48,"ت",3,0],["يَبني عَلى مَجدِ آباءٍ لَهُ سَلَفوا","يَنمى لِمَن وَلَدوا المَهدُ الَّذي مَهَدوا",49,"د",3,0],["يبني على الفتح فاه","لرفع ذاك اللعاب",50,"ب",1,0],["يُبنَى لهُ القصْر في بَحْرِ الوغى حُفِرت","أَساسُه وعلى مَوْجِ السُّيوفِ بُني",51,"ن",2,0],["يبني العلا بالنَّدى جاهداً","وغيره للعلا هادمُ",52,"م",1,0],["يَبْني منارَ الأمْن في أرْجائها","بصوارمِ الإخلاص والإيمان",53,"ن",1,0],["يبني امرؤ يرتجي منها الوفا طمعا","على شفا جرف من غدرها هار",54,"ر",1,0],["يبن القنابل والفتا","والموت مختلف المرامي",55,"م",2,0],["يبني الفتى بالذل دار معيشةٍ","والذل للمجد المؤثل هادم",56,"م",1,0],["يبني وينقض مايشيده","فكأنه متبخر يفسو",57,"س",2,0],["يبني وياخذ خيره","ويْزَيِّد في العقار",58,"ر",1,0],["يَبني مَكارِمَ ذاهِبينَ جَحاجِحٍ","كانوا ثِمالً أَرامِلٍ وَرِياشا",59,"ش",2,0],["يبني المحامد بالمعروف منه كما","يبني المساجد بالآجر واللبن",60,"ن",1,0],["يبني خباؤك للمؤمل كعبة","وطوائف الحجاج فيه طوائف",61,"ف",1,0],["يُبنَى المنار له بأعلى مَعلَم","ويصدّ عنه غارةَ الفتَّاكِ",62,"ك",1,0],["يبني من الفخر ما كانت أوائلُه","تبنى ويَفعل أضعاف الذي فَعلوا",63,"ل",3,0],["يبني العلا ويهد ركن عدوه","فهو الزمان مهدم ومشيد",64,"د",1,0],["يبني القصور الشامخات ويبتني","مجداً ويذهب كل ما يبني سدى",65,"د",2,0],["يبني وأنتم تهدمون ومن له","أن يستوي البناء والهدام",66,"م",1,0],["يبني لهم بيتاً ولكن يغتدي","كيانه مهدّماً مخرّبا",67,"ب",2,0],["يبني على نفسه سفاها","كانه دودة الحرير",68,"ر",1,0],["يبنى على أساسه إن","تم إسعاد البلاد",69,"د",1,0],["يبني العلى وسواه يه","دم ما أبوه بنى وشاده",70,"د",2,0],["يبنى الشباب جلالها وجمالها","ويزود عنها غدوة وبكورا",71,"ر",2,0],["يُبنى لهُ في واسع الجنانِ","بيتٌ له رَبُّ العِباد باني",72,"ي",1,0],["يبني المعالي عن يد","هيهات مابان كهادم",73,"م",1,0],["يبنى لكم خيراً وبن","يان الكريم له أثاره",74,"ر",2,0],["يبنون للجسم المعالم لم يكن","يخفى هناك على الطبابة خافِ",75,"ف",1,0],["يبنون أبياتها واللحن يسكنها","ومن بنى البيت محتلاً كمن هدما",76,"م",2,0],["يبني الكرام لقومهم شرفا","فيدكه النفر الألى لوموا",77,"م",3,0],["يَبني عَلى صخرٍ فَلا يَخشى اذى","عصف الرِياح وَمهطل الأَمطارِ",78,"ر",1,0],["يَبني عَلي الحَق أَحكاماً يؤيدها","شَرعٌ وَعُرفٌ فَلا يَندكُّ مَبناهُ",79,"ا",2,0],["يبني كما يبني الألى","جدد المعالي من جديد",80,"د",1,0],["يبني القصورَ على الجماجمِ لا يرى","من للجريْمة هذه يستنكر",81,"ر",1,0],["يبني ويرفع للعلوم صروحَها","لا ينثني عزمٌ له أو يتعب",82,"ب",1,0],["يبني الشباب قلاعهم بعقولهم","وقلوبهم قد شيّدت بيت القصيد",83,"د",1,0],["يبني علينا العَنكبوت وكُلَّما","نِمْنَا أطلَّ على الصٍّليبِ مُؤَذِّنَا",84,"ن",2,0],["يَبْنِي عوَاصِمَ للأحْلامِ عَاشِقَةً","يَبْنِي قَصِيْدَ الْمُنَى يَطْويْ بِهَا مِحِنَا",85,"ن",2,0],["يُبْنَى الْمُضَارِعُ رَغْمَ أنْفِهِ إِنْ أبَى","هُنَّ البِنَا يُرقَى بِهِنَّ بِنَاءُ",86,"ا",2,0],["يبني كما كانت أوائله","تبني ويغرس محكم الغرس",87,"س",1,0],["يبنى الصناعة حرة","تحكى العهود الزاهرة",88,"ر",2,0],["يبنون في كل يومٍ من وساوسهم","صرحاً يباري الثريا فوق غرف",89,"ف",1,0],["يبنون للحقد الصروح ليرتموا","بين النذالة والعمالة والعمى",90,"م",2,0],["يبني ويهدم صرحه في ومضة","حتى يعود مجددا لبنائه",91,"ا",3,0],["يبني بحب الناس أجمل قلعة","جدرانها : الإيمان والأخلاقُ",92,"ق",1,0],["يبني الدعيّ بيوت العنكبوت وما","فيها لمتكئ العشاق من أُنسِ",93,"س",1,0],["يبني صروح العلم والعرفان في","تعليمه على أساس محكم",94,"م",1,0],["يَبْنِيْ حَضَارَتَهُ .. بِهِمَّتِهِ","حَتَّىٰ ارتَوَىٰ نُوراً .. مِن العَدَمِ",95,"م",1,0],["يبني ويصنعُ من أحلامهِ أَمَلَاً","لكي يرىٰ في عيونِ الناسِ ما رَهَنَا",96,"ن",2,0],["يبني مَواسمَهُ في كَفِّ أُمنيَةٍ","وكَمْ تموتُ أمانٍ في تَنَهُّدِهِ",97,"د",2,0],["يَبني لعُشّاقِ الحياةِ مَمالِكاً","كي تَرتوي كُلُّ العُصورِ بعَصرِهِ",98,"ر",2,0],["يبني صروحا للهوى","حتى يوافيه الأجل",99,"ل",1,0],["يَبْنُونَ فَخْراً عَلَى الأيامِ مُنْتَصِراً","لا يَنْثَنِي بِالدُّنَى تَعْلُو مَرَامِيهِ",100,"ي",2,0],["يبني الحزن من حولي سياج","ولهفتي لك تثور ف كل حين",101,"ن",1,0],["يبني حياته بعد الموت منشغلاً","بصَوْغِ موطنه من بعد تدميرِ",102,"ر",1,0],["يبنون أنفسَهم يداً عليا بها","بلغوا العُلا كأبيهمِ المِقياسِ",103,"س",1,0],["يبني قصور الحالمين ولا يرى","إلّا هواها لا سواهُ أثيثا",104,"ث",2,0],["يَبْنِي القَصيدة مِن شَوق وِمن لهفٍ","عِلى مَرايَا زُجاجِ الحُبِ تَنسَدلُ",105,"ل",1,0],["يبني قلاعَ النورِ فوقَ ربوعنا","بالعلمِ والإحسانِ والأفكار",106,"ر",1,0],["يبني قصوراً إلى النجماتِ في عَجَلٍ","وَيَهدمُ الظُلْمَ والظُّلَّامَ بالنفَسِ",107,"س",1,0],["يبني حضارتها على أسس الهدى","لا فرق بين أكابرٍ وسواد",108,"د",1,0],["يَبني المُقامِرُ كُلَّ يَومٍ قَبرَهُ","وَيَهُدُّ مَركَزَهُ وَيَهدِمُ فَخرَهُ",109,"ر",2,1],["يَبني قُصوراً في الهَواءِ وَبَعضُهُم","يَبني قُبورَ الفِكرِ وَالإحساسِ",110,"س",1,0],["يَبْنُونَ صُهيونَ فِردَوْساً بِدِيرَتِنا","وَيَقْلِبونَ عَلَيْنَا أَرْضَنَا سَقَرَا",111,"ر",2,0],["يَبْني التُّقى النُّصحَ بين الناس نَهْجَ وَفَا","ويَحْسب الظنُّ نهجَ النصح تجهيلا",112,"ل",2,0],["يَکبْنَ الْمُقَلَّدِ قَدْ قَلَّدْتَني مِنَناً","ماقارَبَ الْحَمْدُ أَدْناها وَلا كَرَبا",113,"ب",2,0]]}