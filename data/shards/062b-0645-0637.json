{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[159,"أنا أفدي مكتومة لا تسمى","https://www.aldiwan.net/poem55550.html","الخفيف"],[264,"نحن وفد القرى حللنا الخياما","https://www.aldiwan.net/poem35964.html","الخفيف"],[409,"بلد ما أقول فيها وقد","https://www.aldiwan.net/poem33911.html","الخفيف"],[484,"التفتنا فرأينا","https://www.aldiwan.net/poem37010.html","مجزوء الرمل"],[543,"حيثما سرت فالمعالي تسير","https://www.aldiwan.net/poem48186.html","عموديه"],[543,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[556,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70658","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128712","المديد"],[1588,"","https://poetry.dctabudhabi.ae/diwan/poem/146037","الرمل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126667","الخفيف"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113724","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205781","الخفيف"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124683","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203473","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131955","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128882","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4929,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=199291",""],[5388,"أقبل الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206922",""],[5431,"مهجة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205811",""],[5455,"وحده بوحده","https://www.poetsgate.com/ViewPoem.aspx?id=34435",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""]],"verses":[["ثم طارا بي في الفضاء إلى الجن","نَةِ حتى يغري بلومي الضمير",0,"ر",1,0],["ثم طاروا على ظهور الشياطي","ن خفافاً كما تطيرُ النسور",0,"ر",1,0],["ثُمَّ طافَت عِنايَةُ اللَهِ بِالفُل","كِ فَزالَت عَمَّن تُقِلُّ الشُرورُ",1,"ر",1,0],["ثم طار الهَزَارُ للعُش غِرِّي","داً وعاد الغريبُ للأوطان",2,"ن",1,0],["ثُمَّ طَالَ العِتابُ والعَضُّ وَالقَر","صُ ومَصُّ اللسانِ مِنها فَلَمَّا",3,"م",2,0],["ثُمَّ طُفنا بِرُكنِ كَعبَةِ مَثوا","كَ طَوافَ القُدومِ سَعياً قِياما",4,"م",2,0],["ثم طفنا بها وبالسعي فزنا","وعلى المروتين كان المدار",5,"ر",1,0],["ثم طارت عن براق","فرجعنا آسفينا",6,"ن",2,0],["ثُمَّ طوراً يَلوي عِنانَ حَديثٍ","إن له بانَ في الأُمورِ أُمورُ",7,"ر",1,0],["ثُمَّ طِبناَا والحمدلِلهِ نفساً","خَير سُؤلٍ ما جَاء بعدَ ارتقَابِ",8,"ب",1,0],["ثمّ طعينٌ هَمُّهُ","تقبيلُهُ مَن طَعَنَهْ",9,"ن",2,0],["ثُمَّ طَلَبت الإِذن في الرَحيل","مِنهُ فَلَم يَسمَح بِذا المَأمول",10,"ل",1,0],["ثم طابت بقربه طيبةُ اللّ","ه فيا حبذا النبي الهادي",11,"د",2,0],["ثم طف بالبيت واسع وكن","في رضى المولى على قدم",12,"م",1,0],["ثم طاعنت ليعفو","ر فولّى وهو خلفي",13,"ي",1,1],["ثم طارت فلا تراها تراها","طائرا في السماء ذا أوكار",14,"ر",1,0],["ثمّ طُفنا إفاضةً حول بيتِ اللَه","جلّ سبعاً من الطوفاتِ",15,"ت",1,0],["ثم طافوا بالبيت سبعاً وقد حط","ت من الوزر عنهم أعباء",16,"ا",2,0],["ثم طفنا بكعبة الحسن منها","واعتكفنا بها بهجر سواها",17,"ا",3,0],["ثم طوراً مرجع الخفق يرفض","ض كأن قد بكى بدمع هتون",18,"ن",1,0],["ثم طافت على ضفافِ السواقي","تلثمُ الزهرَ مقلتين وخدَّا",19,"د",2,0],["ثم طارت للروض أخرى لكي تج","مع قوتاً من حبه المنثور",20,"ر",1,0],["ثم طارت لديك ثم أطارت","ك لغصن من فوق غصن نضير",20,"ر",1,0],["ثم طيري بين أجواء الفضا","وانزلي في ذلك البيت الرحيب",21,"ب",1,0],["ثم طالعت في كتاب الليالي","ودرست الالفاظ ثم المعاني",22,"ن",2,0],["ثُمَّ طارا تَحتَ أَذيالِ الغَما","وَسَريعاً أَدرَكا حَدَّ الخِتام",23,"م",1,0],["ثم طفقير فريفيت ضرب","وفروثوون واحتاز السلب",23,"ب",1,0],["ثم طورٌ من المعاناة يتلو","آخر ٌ...، هاكذاٌ مدى الأيامِ",24,"م",1,0],["ثُمَّ طَوراً يَتَمادى","كَاشِفاً عَنْ مُحتواه",25,"ا",2,0],["ثمّ طلّت غمامة الشعر تسعى","واستفاضت على الترائب شوقا",26,"ق",2,0],["ثم طالع الشباك.. لينك قباله","وفي اقل من لمح البصر جاك طاير",27,"ر",1,0],["ثم طوفوا بالعتيق سبعة وارعوا الرفيق","واطلبوا لمع البريق ذاك وقت الجذبات",28,"ت",1,0]]}