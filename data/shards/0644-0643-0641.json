كامل"],[477,"أيها الحافظ عهدي","https://www.aldiwan.net/poem36873.html","مجزوء الرمل"],[477,"الحب باسم حبيبتي مقرون","https://www.aldiwan.net/poem37064.html","الكامل"],[491,"في الحلم ما ينهى ذوي الارحام","https://www.aldiwan.net/poem67284.html","عموديه"],[498,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[502,"أفنى الضنا جسدي وابلى بالي","https://www.aldiwan.net/poem38411.html","الكامل"],[513,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[513,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[549,"زرت هندا ومن ظلام قميصي","https://www.aldiwan.net/poem48109.html","الطويل"],[556,"إنني غير من أحب وإني","https://www.aldiwan.net/poem33562.html","الخفيف"],[556,"يا سقى الله لذة الموت لما","https://www.aldiwan.net/poem34935.html","الخفيف"],[560,"للشوق عندك مقعد ومقيم","https://www.aldiwan.net/poem52948.html","الكامل"],[565,"شارفتنا طلائع المهرجان","https://www.aldiwan.net/poem69480.html","الخفيف"]],"verses":[["لِكَفِّكَ فَوزَةُ القِدحِ المُعَلّى","وَمِنها صَولَةُ العَضبِ اليَماني",0,"ي",1,0],["لَكَ في الحَشى قَبرٌ وَإِن لَم تَأوِهِ","وَمِنَ الدُموعِ رَوائِحٌ وَغَوادي",1,"د",2,0],["لَكَ في الدَهرِ وَالكَمالُ مُحالٌ","صَفَحاتٌ ما بَينَ بيضٍ وَسودِ",2,"د",1,0],["لَكَ في سَبيلِ العِلمِ أَجرُ مُجاهِدٍ","وَالصَبرُ أَجرُ مُلازِمِ المِحرابِ",3,"ب",1,0],["لَكَ في دَمي حَقٌّ أَرَدتُ وَفاءَهُ","يَومَ الوَفاءِ فَقَصَّرَت أَشعاري",4,"ي",1,0],["لَكَ في المَعالي مَنزِلٌ أَعيا الوَرى","لا سوقَةٌ يَرقى إِلَيهِ وَلا مَلك",5,"ك",1,0],["لَكَ فِي ارْتِجَالِ جَلائِلِ الهِمَمِ","مَا عَزَّ لَوْ نَبْغِيهِ فِي الكَلِمِ",6,"م",1,1],["لك في الخلافة مظهرٌ لا يُفْرَعُ","من دون مرقبِهِ النجومُ الطُلَّعُ",7,"ع",1,1],["لك في الخلود مكانة ما نالها","فرعون في ديماسه وحفيره",8,"ر",2,0],["لك في العلم رتبة لن تسامى","فاضل القوم عندها مفضول",9,"ل",1,0],["لك في الأولى حظّ وفي طرق العلى","قدَمٌ وكفٌّ يحسنان سلوكا",10,"ك",2,0],["لك في مُكثري الرعيّةِ دوني","حَلَبٌ كيف شئت بل أحلابُ",11,"ب",1,0],["لك فيها تيقظٌ غير محتا","جٍ إلى أن يُعينه تيقيظُ",12,"ظ",1,0],["لك في الناس نثا ذك","ر كثير المتأفف",13,"ف",1,0],["لك فيه دون الأُلى ورِثوهم","من سهامٍ ثلاثةٍ سَهمان",14,"ن",1,0],["لك في البأس والندى عَزماتٌ","جثماتٌ أمضى من الخِرصان",14,"ن",1,0],["لك فِي هَنْكِ خَصلتانِ من الجَنْ","نةِ بَردٌ كبردها وصحونُ",15,"ن",1,0],["لَكَ في عالَمِ النَهارِ أَماني","وَرُأى وَالظَلامُ فَوقَكَ مُمتَد",16,"د",1,0],["لَكَ في فَضلِكَ المَحَلُّ الرَفيعُ","لا يُجاريكَ في البَديعِ البَديعُ",17,"ع",1,1],["لَكَ في المَعالي حُجَّةٌ لا تُدعى","لِمُعانِدٍ وَمَحَجَّةٌ لا تُهتَدى",18,"د",2,0],["لَكَ في ضَميري ماعَلم","تَ بِهِ مِنَ الوُدِّ الصَريحِ",19,"ح",1,0],["لَكَ في الأَرضِ دُعاءِ","سَدَّ آفاقَ السَماءِ",20,"ا",2,1],["لكِ في الغاباتِ مرعاكِ","ومَسْعاكِ الجميلْ",21,"ل",1,0],["لِكَفّيَ أَهدى في نَداها مِنَ العَطا","إِلى موردٍ عَذبٍ عَلى بَوحِ",22,"ح",1,1],["لك في روايات نظمت فصولها","درجات فضل هن عليونا",23,"ن",2,0],["لك في الشعر عزة قعساء","عجزت عن بلوغها الشعراء",24,"ا",2,0],["لك في تاريخ الملوك كتاب","يحمل الوحي والهدى واليقينا",25,"ن",2,0],["لك فيه بلاغة حيرتنا","أي روح نفثت في ابياتك",25,"ك",1,0],["لك في الحياة فلا تخف","من ان تفارقها ثبوت",26,"ت",1,1],["لك في الصدور محبة مسطورة","من ذا محبر تلكم الالواح",27,"ح",1,0],["لك في الموت حين تهلك","ورد بلا صدر",28,"ر",1,0],["لك فيها الحياة ما طبت عيشا","كل شيء فلا تبعها ببخس",29,"س",1,0],["لك في مهد المعالي دولة","حسب الطفل عليها والجنين",30,"ن",1,0],["لَكَ في الأَرضِ مَوكِبٌ لَيسَ يَألو الر","ريحَ وَالطَيرَ وَالشَياطينَ حَشرا",31,"ر",2,0],["لَكَ في طَيِّهِ حَديثُ غَرامٍ","ظَلَّ في خاطِرِ المُلَحِّنِ سِرّا",31,"ر",2,0],["لَكَ في الأَرضِ وَالسَماءِ مَآتِم","قامَ فيها أَبو المَلائِكِ هاشِم",32,"م",1,1],["لَكَ في ذَلِكَ الضَنى رِقَّةُ الرو","حِ وَخَفقُ الفُؤادِ في العُوّادِ",33,"د",1,0],["لَكَ في مَسائِلِهِ الكَلا","مُ العَفُّ وَالجَدَلُ الوَقور",34,"ر",1,0],["لَكَ في الأَجيالِ تِمثالٌ مَشى","وَجَدوا الرُشدَ عَلَيهِ وَالصَلاح",35,"ح",1,0],["لَكَ في الفَتحِ وَفي أَحداثِهِ","فَتَحَ اللَهُ حَديثاً وَخِطابا",36,"ب",2,0],["لَكَ في كُلِّ مُغارٍ غارَةٌ","وَعَلَيها الدَمعُ فيهِ وَالأَنين",37,"ن",1,0],["لَكِ في رُبى النيلِ المُبارَكِ جيرَةٌ","لَو يَقدِرونَ بِدَمعِهِم غَسَلوكِ",38,"ك",1,0],["لَكَ في المَجدِ أَوَّلٌ وَأَخيرُ","وَمَساعٍ صَغيرُهُنَّ كَبيرُ",39,"ر",1,1],["لَكَ في بَني غَنمِ بنِ تَغلِبَ نِعمَةٌ","فَهَلُمَّ أُخرى في بَني شَيبانِ",40,"ن",1,0],["لك في السفرجل منظر تحظى به","وتفوز منه بشمه ومذاقه",41,"ق",2,1],["لك في ابتداءِ العمرِ عزمُ مُؤيَّدٍ","وأناةُ مقتدرٍ وعدلُ إمامِ",42,"م",1,0],["لَكَ في رَسولِ اللَهِ أَعظَمُ أُسوَةٍ","وَأَجَلُّها في سُنَّةٍ وَكِتابِ",43,"ب",1,0],["لَكِ في فَمِ الأحداثِ دعوةُ صارخٍ","ينفِي القرارَ عن الشُّعوب النُوَّمِ",44,"م",1,0],["لَكَ في مُقارعةِ الخُطوبِ مَواقِفٌ","فيها لقومِكَ عِصمةٌ وأمانُ",45,"ن",1,0],["لكِ في المخافةِ عُذرُ كُلِّ مُجرّبٍ","عَرفَ السياسةَ والمُجرِّبُ يُعْذَرُ",46,"ر",1,0],["لكَ في كتابِ اللهِ خيرُ مُعلِّمٍ","فَكُنِ امرأً يَقِظَ الفُؤادِ حصيفا",47,"ف",2,0],["لَكِ في بني الإِسلامِ أَجرُ مُجَدِّدٍ","لِشرائعِ الآباءِ والأجدادِ",48,"د",1,0],["لكَ في الحُماةِ الصّابرينَ على الأذى","ذِكرٌ يزيدُكَ في النُّفوسِ جلالا",49,"ل",2,0],["لكِ في الغُزاةِ النّاهضين بقومهم","عِظةُ الشعوبِ وعبرةُ الأقطارِ",50,"ر",1,0],["لَكَ في قَضِيَّتِها مَواقِفُ باسِلٍ","لا الخَصمُ يَخدَعُهُ وَلا هُوَ يُغلَبُ",51,"ب",1,0],["لَكَ في المسلمينَ يا ابْنَ عُبيدِ ال","لهِ بَرقٌ مُباركُ الإيماضِ",52,"ض",1,0],["لَكَ في الإسلامِ من أعدائِهِ","خُلُقُ الذئبِ وطَبعُ الثعلبِ",53,"ب",1,0],["لك في غدٍ دَمُه إذا التقتِ الظُّبى","تحتَ العَجاجةِ والرِّماحُ الذُّبَّلُ",54,"ل",1,0],["لَكَ في التاريخ أَيام غرر","كَتبت بِالسَيف لا بِالقَلَم",55,"م",1,0],["لَكَ في ترب مَيسَلون دَفين","كان للذائِدين عَنكِ مثالا",56,"ل",2,0],["لكَ في الحيّ هالِكٌ بِكَ حيٌّ","في سبيلِ الهَوَى اسْتَلَذّ الهَلاَكَا",57,"ك",2,0],["لك في الذب من لسانك سيف","شهد اللَه أنه مصقول",58,"ل",1,0],["لك في الرجاء إذا أردت تشبُّثاً","حبل مَتى تمسك به يتجذَّم",59,"م",1,0],["لك في بغداد أَخو شغف","ما بالك لا تَتَفقده",60,"د",2,0],["لكِ في خيالي روضةٌ فينانةٌ","غَنَّى على أغصانِها شاديها",61,"ه",2,0],["لك فيّ العبرةُ المثلى فلا","تأمَنِ الزلةَ في أوج الصعود",62,"د",1,0],["لك في كلّ خيالٍ صورةٌ","برئت من وصمة العصر الجديد",62,"د",1,0],["لك فيها قصائد","جاوزتها الى الحضر",63,"ر",1,0],["لَكَ فِي تَأْسِيسِهِ قِسْطٌ","وَفِي التَّدْبِيرِ قِسْمُ",64,"م",1,0],["لَكَ فِيهِ بِتُّ قَوِيمٌ وَرَأْيٌ","وَاسِعُ الأُفْقِ سَاطِعُ الإِشْرَاقِ",65,"ق",1,0],["لَكَ في قَريضِكَ خُطَّةٌ آثَرْتَهَا","عَزَّتْ عَلَى الفُصَحَاءِ وَالبُلَغَاءِ",66,"ا",2,0],["لَكَ فِي نَهْضَةِ الشَّبَابِ أَيَاد","سَجَّلَتْهَا الْعَلى بِأَحْرُفِ نُورِ",67,"ر",1,0],["لكِ فِيهِ مِرْآةٌ إِذَا اسْتَطْلَعْتِهَا","رَاعَتْكِ أَلْوَانُ الجَمَالِ السَّاحِرِ",68,"ر",1,0],["لَكَ فِي النُّهَى بَعْدَ النَّوَى","شَفَقٌ وَلَكِنْ لاَ يَغِيبُ",69,"ب",1,0],["لَكَ فِي عَدْنٍ ثَوَابٌ خَالِدٌ","فَتَمَتَّعْ بِرضَى اللهِ وَطِبْ",70,"ب",1,0],["لَكِ فَضْلٌ عَلَيَّ مِنْ بَدْءٍ أَمْرِيْ","لَيْسَ عِنْدِي مَا عِشْتُ بِالمَمْنُونِ",71,"ن",1,0],["لَكِ فِي كُلِّ سَاعَةٍ مِنْ تُقَى النَّفْ","سِ الحَافِظِ الرَّشِيدِ الأَمِينِ",71,"ن",1,0],["لَكِ فِي نَهْضَةِ النِّسَاءِ مِسَاعٍ","حَرَّكَتْ فُضْلَيَاتِهَا مِنْ سُكُونِ",71,"ن",1,0],["لَكَ فِي الصَّحَافَةِ مُبْدِعاً وَمُجدِّداً","أَثَرٌ جَلِيلٌ فِي مَدَاهُ بَعِيدُ",72,"د",1,0],["لَكَ فِي الْعَيْشِ فَإِذَا لَمْ","يَكُ لِلْنَّاسِ نَفْعُهُ عَادَ زُهْدَا",73,"د",2,0],["لَكَ فِي كِتَابِ العَصْرِ أَبْهَجُ صُورَةٍ","خَلُدَتْ وَغَيْرُ الفَضْلِ لَيْسَ بِمُخْلَدِ",74,"د",1,0],["لك فى السماء نجومها فتلثمى","وعلى المهاد زهورها فتمنطقى",75,"ق",2,0],["لَكَ في الْعُلاَ كَعْبٌ وَكَ","فٌّ في الْمَكارِمِ حاتِمِيَّهْ",76,"ي",2,0],["لَكَ فِكْرَةٌ يَجْرِي الْهُدَى","فِيهَا وَتكْلؤُهَا الروِيَّهْ",76,"ي",2,0],["لك فتنة البِيِضِ الغواني","حين تَبْدُو من بعيد",77,"د",1,0],["لك في ساحة العدالة، يا محْ","مُودُ جولاتُ مِدْرَهٍ مِنْطبق",78,"ق",1,0],["لكَ في الشعر كلُّ معنىً رَقيقٍ","في بناء أقوى من الصُّفَّاح",79,"ح",1,0],["لك في الأرض والهواءِ مدارٌ","حار فيه مقوِّمُ البُلدان",80,"ن",1,0],["لك في جميع ربوعِها","ذكرٌ كنفحِ المسْك عاطر",81,"ر",1,0],["لك في سيرة النبيِّ عِظاتٌ","بالغاتٌ؛ فهل تريدُ مزيدا؟",82,"د",2,0],["لك في \" الَّتي \" راشَتْ جناحك رِفقةٌ","لولا جلادتُهم لماتوا جوعا",83,"ع",2,0],["لكَ 