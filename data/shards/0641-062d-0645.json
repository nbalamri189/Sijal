gate.com/ViewPoem.aspx?id=123994",""],[5273,"الريم","https://www.poetsgate.com/ViewPoem.aspx?id=179936",""],[5285,"أميرة الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=203533",""],[5285,"نوَّارة","https://www.poetsgate.com/ViewPoem.aspx?id=203655",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5324,"مرثيّة الغرم .","https://www.poetsgate.com/ViewPoem.aspx?id=207570",""],[5325,"خطب أناخ على الإسلام كلكله","https://www.poetsgate.com/ViewPoem.aspx?id=171970",""],[5365,"في رثاء الشاعر العراقي عبد الرزاق عبد الواحد","https://www.poetsgate.com/ViewPoem.aspx?id=191061",""],[5408,"إليّ ولا أحد","https://www.poetsgate.com/ViewPoem.aspx?id=190738",""],[5413,"أَمَا للعاشقين!!","https://www.poetsgate.com/ViewPoem.aspx?id=200573",""],[5431,"وشكرا للحياة فلم تخنّي...","https://www.poetsgate.com/ViewPoem.aspx?id=197212",""],[5502,"إن كنت تبحث عن تراث عمان","https://www.poetsgate.com/ViewPoem.aspx?id=124955",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5691,"أبشروا بالرفاه...!","https://www.poetsgate.com/ViewPoem.aspx?id=206155",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[5768,"عِيدُكُمْ مُبارَكٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215344",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5842,"عصفورة الأمل \\محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=150624",""],[5908,"هل لقلب المتيم المتبول","https://www.poetsgate.com/ViewPoem.aspx?id=170976",""],[5953,"سلام على أرض الحسين وحضرته","https://www.poetsgate.com/ViewPoem.aspx?id=93792",""],[5956,"تبَسُّمُ عاشقتي","https://www.poetsgate.com/ViewPoem.aspx?id=182048",""],[5956,"فراقُ شاطئ اللاذقية","https://www.poetsgate.com/ViewPoem.aspx?id=184917",""],[5956,"إذا استبصرتَ نيّاتي","https://www.poetsgate.com/ViewPoem.aspx?id=194411",""],[5956,"شكراً سُمَيّةُ قد أزلتِ مخاوفي","https://www.poetsgate.com/ViewPoem.aspx?id=202641",""],[6052,"شيخ القضية احمد","https://www.poetsgate.com/ViewPoem.aspx?id=35211",""],[6052,"قبة الامام علي الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=53825",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[6120,"أَيَا طَالِبَ الْبُعْد","https://www.poetsgate.com/ViewPoem.aspx?id=216032",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""],[6134,"يا سيداً حاز التفرد بالذكا","https://www.poetsgate.com/ViewPoem.aspx?id=169540",""],[6142,"حضن الطفل جده شيبة الحم","https://www.poetsgate.com/ViewPoem.aspx?id=155705",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[5309,"سمعت نسيم الصبح يتلو رواية","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573691",""]],"verses":[["فَحَمداً لِآلِ الفَوثِ إِنَّ أَكُفَّهُم","سِباطُ الحَواشي وَاللِمامُ جِعادُ",0,"د",1,0],["فَحَمْحَمَ مُهْري وامْتَرى الدّمْعَ صاحِبي","وقدْ كادَ يَبكي مُنْصُلي وسِناني",1,"ن",2,0],["فَحَمدُكَ المَرءَ ما لَم تَبلُهُ سَرَفٌ","وَذَمُّكَ المَرءَ بَعدَ الحَمدِ تَكذيبُ",2,"ب",1,0],["فَحَمَلتُ هَيكَلَ عَظمِها وَكَأَنَّني","حُمِّلتُ حينَ حَمَلتُ عودَ خِلالِ",3,"ل",1,0],["فَحَمَيتُما حَرَمَيهِما","رَغمَ الخُطوبِ الفاجِعَه",4,"ع",2,0],["فحمدك أحرى ما أفادت حقائب","وذكرك أسنى ما أقلّت رواحلُ",5,"ل",1,0],["فَحَمى مَقاتِلَهُ وَذادَ بِرَوقِهِ","حَميَ المُحارِبِ عَورَةَ الصُحبانِ",6,"ن",1,0],["فَحمَ الغَبِيُّ وَقُلتُ غَيرَ مُلَجلِجٍ","إِنّي لَمُشتاقٌ إِلى العَلياءِ",7,"ا",2,0],["فَحِمى جاسِمٍ فَأَبنِيَةِ الصُف","فَرِ مَغنى قَنابِلَ وَهِجانِ",8,"ن",1,0],["فحمينا نِساءَ قحطانَ حتَّى","عادَ دون الفتاةِ سِترٌ يُلَطُّ",9,"ط",1,0],["فَحُمَّت لَهُ أُصلاً وَقَد ساءَ ظَنُّهُ","مُصيفٌ لَها بِالجَبأَتَينِ مَشارِبُ",10,"ب",1,0],["فَحَملَقَ حَتّى رَأَيتُ الشَرَر","يَتيرِ سِراعاً إِلى مُهجَتي",11,"ي",1,0],["فحمداً أيها المفضال حمداً","لفضل أنت مبديهِ الكريم",12,"م",1,0],["فَحَمَدَ اللَهَ عَلى السَلامَه","وَحَفِظَ الجَميلَ لِلحَمامَه",13,"ه",1,0],["فَحَمَلَ القَومُ عَلى الحِمارِ","بِجُملَةِ الأَنيابِ وَالأَظفارِ",14,"ر",1,0],["فحمَلْنا مِلءَ الحقائبِ من أف","وافِ مدحٍ يبقى على الأحقابِ",15,"ب",1,0],["فحمّرَ ما ابيضّ من عَبرتي","وَبَيّضَ لِمّتيَ الداجيه",16,"ي",2,0],["فَحَمَت حَريمَ المُسلِمينَ مَصارِعٌ","تَرَكَت حَريمَ المُشرِكينَ مُباحا",17,"ح",2,0],["فحَمِدْتُ الطَّرِيقَ إذا أِشْهَدَتْ لِي","حينَ عايَنْتُها بِحُسْنِ مآلِ",18,"ل",1,0],["فحمِّلْ وريدي منكَ ثِقْلَ صَنيعةٍ","فإنّي لمَضْبورُ القَرا مُتلاحِك",19,"ك",1,0],["فحمدانُ بنو سيفٍ","محلُّ الطيبِ واللينِ",20,"ن",1,0],["فَحَملُ مَغازِلِ النِسوانِ أَولى","بِهُنَّ مِنَ اليَراعِ مُقَلَّماتِ",21,"ت",1,0],["فَحُمرٌ وَسودٌ حالِكاتٌ كَأَنَّها","سَوامُ بَني السَيّدِ اِزدَهَتهُ القَوائِمُ",22,"م",1,0],["فَحَملنا ماهِناً يُنصِفُنا","فَوقَ يَعبُوبٍ مٍنَ الخَيلِ أَجَش",23,"ش",1,0],["فحمى أَواخِرَهُ أَغَرْ","رُ مُعاوِدٌ تِلْكَ الملاحِمْ",24,"م",1,0],["فَحَمِدْتُ مِنْهَا بِرَّهَا","بِالْبَائِسِينَ الأَشْقِيَاءْ",25,"ا",2,0],["فَحَمَّلَ المَوجَ منْ أشجانِهِ حُمَماً","وشَدَّ يَضْرِبُ أُولاها بأُخْراها",26,"ا",3,0],["فَحَماني بِالصّراطِ المحلّى","وَهَداني لِلصِّراطِ السَوِيِّ",27,"ي",1,0],["فحملنا كل إكليل الوفا","ومشينا فوق هام النوب",28,"ب",1,0],["فحماها وسامها وكذاك ال","أسد تحمي عرينها وحماها",29,"ا",3,0],["فحمى أوخره أغر","معاود تلك الملاحم",30,"م",1,0],["فحملت \" البعثَ \" باليمنىَ لَهم","وعلى اليسرى هناء ورخاء",31,"ا",2,0],["فحملنا لك إكليل الوفا","ومشينا فوق هام النوبِ",32,"ب",1,0],["فحمٌ ذكت في حشاه نارُ","فقلتُ مسكٌ وجُلّنارُ",33,"ر",1,1],["فحمرةٌ واصفرارٌ ثم أزرق في","خدٍّ وشعر وطرْفٍ منك فتّاكِ",34,"ك",1,0],["فحمدٌ وشكر إِن ربَّك لم يكنَ","يكافي بغير الحمد لله والشكرَ",35,"ر",1,0],["فَحَمِّل نَوَاها عَنسَلاً شَمَّرِيَّةً","يُشَدُّ عَلَى مِثلِ السَّفِينَةِ كُورُها",36,"ر",3,0],["فحْمدِي لما أوليتَ يا بنَ محمدٍ","مقيمٌ على طول المَدَى متتابِع",37,"ع",1,0],["فحمّلني هواه وكنت غرّا","بما يلقى المحبّ من الحبيب",38,"ب",1,0],["فَحَماه منهم عليٌّ عليمُ","فَعليهِ الصلاة والتسليمُ",39,"م",1,0],["فَحَمَلت آمنةُ الأمينه","بِالدرّةِ الفَريدةِ المَكنونه",40,"ه",1,0],["فَحَملت بخيرِ خلق اللَّه","حبيبهِ خليلهِ الأوّاهِ",40,"ه",1,0],["فَحَملت بِمن بهِ توسّلوا","لربّهم فَبَلغوا ما أمّلوا",40,"ل",3,0],["فَحَملت بصاحبِ الآياتِ","أَكثرِ رسلِ اللَّه معجزاتِ",40,"ت",1,0],["فَحَمَلنا غُلامَنا فَوقَ طِرفٍ","وَأَشَرنا فَقالَ أَنّى أَشاروا",41,"ر",3,0],["فَحَملَقَ الحُرُّ في العاتي وَقالَ لَهُ","أَقضي غَداً أَو أَموتُ اليَومَ سِيّانِ",42,"ن",1,0],["فحملتُ منه ليثَ غاب باسلاً","شهمَ العزيمة ماضيَ الإقدام",43,"م",1,0],["فحملت أثقل محملا من ردفه","وفللت أصعب قوة من خصره",44,"ر",2,0],["فَحَمَّلونِيَ كُرهاً لِلبَخيلِ يَداً","لِسانُ شُكرِيَ عَن أَمثالِها نابِ",45,"ب",1,0],["فَحَمَّلتَني ما لا أَطيق وَانّما","يُكلّفني حُبيِّكَ أَن أَتَحَملا",46,"ل",2,0],["فحمدته وذممت مهه ثلاثة","المنع والأعجاب والاعجالا",47,"ل",2,0],["فحملتُ منك على مُزاولة النَوى","عِبئاً عليَّ مَع الزَمان ثَقيلا",48,"ل",2,0],["فحمد لرب خصنا بمحمد","وأخرجنا من ظلمة ودياجر",49,"ر",1,0],["فَحَمداً لَكَ اللَهمَّ يا مَن هباته","تجلُّ وَتَسمو أَن يُحيط بِها حصرُ",50,"ر",1,0],["فحمى حِمَى الدين الحنِيفِّي الَّذي","ما زال يَدفَعُ دونَهُ ويُحامِي",51,"م",2,0],["فَحَمَّلتُهُم ما لا يُطيقُ فُؤادُهُ","فَقَد حُنِيَت مِن ثِقلِهِنَّ الجَوانِحُ",52,"ح",1,0],["فحملته شوقاً حوته ضمائري","تميد له أعلام رضوى ولبنان",53,"ن",1,0],["فحمد ثم حمد ثم حمد","لمولانا الكريم المفضل الوال",54,"ل",1,0],["فحماه عن صهوات كل مطهَّم","وحماه عن رمح وسيف باتر",55,"ر",1,0],["فحملت العصا لتذكير نفسي","أنني صرت في الأنام غريبا",56,"ب",2,0],["فحملت من بعد الثمانين العصا","متيقنا إنذارها لحمامي",57,"م",2,0],["فحمِدْتُ الله لما أنْ بدا","طالعاً كالبدر في برج السعود",58,"د",1,0],["فَحَمِدْتُ المُرادَ ِفي ظِلِّ نُعْما","هُ على بَسْلِهِ ونِلْتُ المُرادا",59,"د",2,0],["فحمى ازدحامُ اللاثِميها فوزَها","معهمْ وقد ظفروا بأكرمِ مَلثَمِ",60,"م",1,0],["فحمى مسارحَها وكانتْ قبلَه","كالغيلِ فارقَهُ مقدَّمُ أُسْدِه",61,"د",2,0],["فَحَمَتْهُ طاعتُكَ الَّتِي لَوْ خانَها","طارَتْ إِلَيْهِ البِيضُ من أَغمادِها",62,"د",3,0],["فَحَمَّلْتُهُمْ وِزْراً ولَوْ خَفَّ مِنْهُمُ","جَناحِي لكانَ الطَّوْدُ أ