{"poems":[[55,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[90,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[97,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[46,"أي ندى بين الثرى والجبوب","https://www.aldiwan.net/poem30321.html","الرجز"],[76,"أيها التائه مهلا","https://www.aldiwan.net/poem13210.html","مجزوء الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[164,"أتاكم من يسترد الغصبا","https://www.aldiwan.net/poem58809.html","الرجز"],[168,"وله نابه وخطب جليل","https://www.aldiwan.net/poem67814.html","الخفيف"],[215,"أين قلبي وأين آثار قلبي","https://www.aldiwan.net/poem46575.html","الخفيف"],[287,"أين دهائي والهوى طالبي","https://www.aldiwan.net/poem32865.html","السريع"],[412,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[415,"لما رأوا وجدي بهم تجرموا","https://www.aldiwan.net/poem32531.html","الرجز"],[463,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[563,"عالم الحكمة هذا","https://www.aldiwan.net/poem34558.html","مجزوء الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111803","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141313","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114750","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140201",""],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146349","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112594","البسيط"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82842","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109945","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139750",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5956,"أبطال فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192326",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""]],"verses":[["أَيُّ نَدبٍ ما بَينَ بُردَيكَ وَالدَه","رُ أَجَدُّ اليَدَينِ مِن كُلِّ نَدبِ",0,"ب",1,0],["أين دين التوحيد منكم وأين ال","أوْب اللّه وحده والقُفول",1,"ل",1,0],["أين دنياك التي أوحت إلى","وتري كل يتيم النغم",2,"م",1,0],["أَينَ داوُودُ أَينَ أَينَ سُلَيما","نُ المَنيعُ الأَعراضِ وَالأَجنادِ",3,"د",1,0],["أَيُّ نَدىً بَينَ الثَرى وَالجَبوبِ","وَسُؤدُدٍ لَدنٍ وَرَأيٍ صَليبِ",4,"ب",1,1],["أَينَ دَمعٌ فيكَ يَجري","أَينَ جَنبٌ يَتَقَلّى",5,"ل",2,0],["أَينَ دَامِي الأظْفَارِ مِنْ قَاذِفْ النَّا","رِ وَمُفْنِي الدِّيَارِ بِالإِحْرَاقِ",6,"ق",1,0],["أين دعاويه التي بها أدعى","وأين ولى جيشه المعبا",7,"ب",2,0],["أَينَ دَعوى بَني سُلَيمةَ أَطوا","دُ المَعالي فتيانُها وَالكُهولُ",8,"ل",1,0],["أين دارٌ حوت جمالك صرفاً","كاحتواء التفاح روح الشمول",9,"ل",1,0],["أين دارٌ حوتك قد طال بحثى","عنك في كل منزل وقبيل",9,"ل",1,0],["أين دار حوتك يا وجد قلبي","كيف اسعى إليك أين سبيلي",9,"ي",1,0],["أَينَ دَهائي وَالهَوى طالِبي","تَيَّمَني حُبُّ أَبي طالِبِ",10,"ب",1,1],["أَيندَمِلُ الجَرحُ الرَغيب بِمِثلِهِ","إِلّا لا وَلَكِن يَستَطيرُ وَيَستَشري",11,"ر",2,0],["أَينَ دموعٌ كُلَّما غيَّضْتُها","تَدفَّقَتْ ومازَجَ الدّمعَ دَمُ",12,"م",1,0],["أين دُماكَ والهوى","سؤالنا أين همُ",13,"م",1,0],["أين دين الحق ممن","بالضلال الله آذى",14,"ذ",2,0],["أَيُّ ندبٍ وجيبنا فيهِ فرضٌ","فجعتنا بهِ يدُ الأقدارِ",15,"ر",1,0],["أين دار السّعد والنعمة في","حيّها والبشر يحتلّ حماها",16,"ا",3,0],["أينَ داوُدَ من أنابَ بِقَلبٍ","خَشيَةَ اللَهِ حَلَّ فيه الحياء",17,"ا",2,0],["أين دعواك في الهَوى","اصدرِي عنهُ أو رِدِي",18,"د",2,0],["أين دارُ السلام إذ هي دار","شيدتها العلوم والعلماء",19,"ا",1,0],["أين دين أتى بحرمانها من","ه ضللتم لا تعرفون الرشادا",20,"د",2,0],["أَين دَعواكَ والمَغاني مَغانِ","والمعاني كاللفظ حاز المعاني",21,"ن",2,1],["أئن دعا الحرب كنتم كالنعام به","وهمكم في جنى غنم وأسلاب",22,"ب",1,0],["أَينَ دارُ النَدى وَدارُ المَعالي","قالَ أَرَّختُ دارُ عَبدِ العَظيم",23,"م",1,0],["ايندب مندوب من اللَه قد رأَى","مَناهُ بحُبِّ اللَهِ فرضاً مؤَكَّدا",24,"د",2,0],["أيُّ ندبٍ أوى لأىِّ جوادٍ","ليس يدنو منه لعزٍ هوان",25,"ن",1,0],["أين دار المرضى ومن هو فيها","عن أولي الضيم رافع الآلام",26,"م",1,0],["أين درعي ماتمسكتم بها","خلفها الأمجاد من خلف الحصون",27,"ن",1,0],["أين دباباتها من نارنا؟","أين ذاك الكبرياء انحجبا؟",28,"ب",2,0],["أيْن دارٌ دامتْ بلقْيا الْأماني","تنْتشي عمْرًا حالمًا بارْتقاء",29,"ا",2,0],["أَينَ دَربِي؟ وَما لَدَيَّ جِهاتٌ!","أَينَ أَمضِي؟ وَما لَدَيَّ مَكانُ!",30,"ن",1,0]]}