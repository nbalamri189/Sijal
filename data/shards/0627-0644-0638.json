{"poems":[[53,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[27,"هاج الشجون برهبى ربع أطلال","https://www.aldiwan.net/poem5956.html","البسيط"],[27,"بئس الفوارس يوم نعف قشاوة","https://www.aldiwan.net/poem5981.html","الكامل"],[27,"أما أسيد والهجيم ومازن","https://www.aldiwan.net/poem6004.html","الكامل"],[27,"سرت الهموم فبتن غير نيام","https://www.aldiwan.net/poem6021.html","الكامل"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[43,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[31,"إن الخليط الذين كنت بهم","https://www.aldiwan.net/poem42043.html","المنسرح"],[105,"يا مالكا عنت الوجوه لعزه","https://www.aldiwan.net/poem42114.html","الكامل"],[105,"أبلغ ضيوفك حين يشهد جمعهم","https://www.aldiwan.net/poem43085.html","الكامل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"أأنت يا ابن رزام تغلب القدرا","https://www.aldiwan.net/poem43581.html","البسيط"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[102,"يا حسرتا ماذا دهى أهل الحمى","https://www.aldiwan.net/poem32944.html","الكامل"],[48,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[46,"الظلم في الطبع فالجارات مرهقة","https://www.aldiwan.net/poem22798.html","البسيط"],[46,"زعموا بأنهم صفوا لمليكهم","https://www.aldiwan.net/poem22990.html","الكامل"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49163","الكامل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85942","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54624","الكامل"],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""]],"verses":[["الظُلمُ وَالإِنصافُ مِن فِعلِ مَن","يَحكُمُ في الحاضِرِ وَالبادي",0,"ي",1,0],["الظاعِنونَ عَلى العَمياءِ إِن ظَعَنوا","وَالسائِلونَ بِظَهرِ الغَيبِ ما الخَبَرُ",1,"ر",1,0],["الظاعِنونَ عَلى أَهواءِ نِسوَتِهِم","وَالخافِضونَ بِدارٍ غَيرِ مِحلالِ",2,"ل",1,0],["الظاعِنونَ عَلى العَمى بِجَميعِهِم","وَالخافِضونَ بِغَيرِ دارِ مُقامِ",3,"م",1,0],["الظاعِنونَ عَلى هَوى نِسوانِهِم","وَالنازِلونَ بِشَرِّ دارِ مُقامِ",4,"م",1,0],["الظاعِنونَ عَلى العَمى بِجَميعِهِم","وَالنازِلونَ بِشَرِّ دارِ مُقامِ",5,"م",1,0],["الظلم ضيَّق في وجو","ه رجائنا طرق المكاسب",6,"ب",1,0],["الظَلامُ رايَتُها","وَهيَ جَيشُهُ اللَجِبُ",7,"ب",1,0],["الظُلمُ مِن شِيَمِ النُفوسِ فَإِن تَجِد","ذا عِفَّةٍ فَلِعِلَّةٍ لا يَظلِمُ",8,"م",1,0],["الظَبيُ فيهِ مِن خَلقِها شَبَهٌ","النَحرُ وَالمُقلَتانِ وَالعُنُقُ",9,"ق",1,0],["الظُّلمُ دِينٌ والتعسُّفُ شِرعةٌ","والغَدْرُ عَهدٌ والهَوى ميثاقُ",10,"ق",1,0],["الظُلمُ يَعصِفُ بِالقَياصِرِ فَاِنظُروا","كَم غالَ مِن تاجٍ وَمِن إِكليلِ",11,"ل",1,0],["الظُلمُ مَفسَدَةُ النُفوسِ وَما لَها","غَيرُ التَرَفُّقِ في الأُمورِ صَلاحُ",12,"ح",1,0],["الظّافرونَ بنو الإسلامِ لا فَزَعاً","يرى العِدَى في الوغَى منهم ولا خَوَرا",13,"ر",2,0],["الظلمُ أوردَها الغليلَ وإنَّهُ","لأشدُّ ما تَجِدُ السُّيوفُ وأبْرَحُ",14,"ح",1,0],["الظالمُ الباغي يسوس أُمورَهم","واللصُّ والجاسوسُ والسمسارُ",15,"ر",1,0],["الظاهِرُ العَبَراتِ","الباطِنُ الزَفَراتِ",16,"ت",1,0],["الظُلمُ في الطَبعِ فَالجاراتُ مُرهَقَةٌ","وَالعِرفُ يَستُرُ وَالميزانُ مَبخوسُ",17,"س",1,1],["الظُلمُ أَكثَرُ ما يَعيشُ بِهِ الفَتى","وَأَقَلُّ شَيءٍ عِندَهُ الإِنصافُ",18,"ف",1,0],["أَلَظّوا بِالقَبيحِ فَتابَعوهُ","وَلَو أَمَروا بِهِ لَتَجَنَّبوهُ",19,"ب",3,0],["الظامئينَ إلى الجهادِ فإن دُعُوا","وَردوا حِياضَ الموتِ عَذْبَ المَوْرِدِ",20,"د",1,0],["الظُلمُ أَجمَعُ وَالإِساءَةُ كُلُّها","بَغيُ القَوِيِّ عَلى الضَعيفِ المُرغَمِ",21,"م",1,0],["الظلمُ حيٌّ فيهِ نامٍ شائعٌ","والعدل ميت لا يجيب إذا دُعى",22,"ع",2,0],["الظِّلُّ يَسْدُرُ فِي غِوَايَتِهِ","لاَ يُرْعَوِي عَجُمٌ وَلاَ عَرَبُ",23,"ب",1,0],["الظَّالِمُوكِ قُضَاتُها","وهُمُ النِّيابةُ، والشُّهود",24,"د",1,0]]}