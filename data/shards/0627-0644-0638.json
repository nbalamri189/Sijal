oem.aspx?id=5434",""],[5764,"قويٌ لا رحيم","https://www.poetsgate.com/ViewPoem.aspx?id=175604",""],[5818,"من أجل ذلك ....","https://www.poetsgate.com/ViewPoem.aspx?id=181545",""],[5829,"هوى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=211774",""],[5842,"النورس المجروح/صباح الحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=128790",""],[5848,"من متى والقلب يصبر","https://www.poetsgate.com/ViewPoem.aspx?id=53099",""],[5848,"ظلم الشبابيك","https://www.poetsgate.com/ViewPoem.aspx?id=53097",""],[5910,"عُودوا إلى الرَّحمنِ","https://www.poetsgate.com/ViewPoem.aspx?id=210978",""],[5956,"البِرُّ بالوالدَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=192713",""],[5956,"ألمٌ ألمَّ به","https://www.poetsgate.com/ViewPoem.aspx?id=194579",""],[5956,"لو كان يقدر بالأمان أحاطني","https://www.poetsgate.com/ViewPoem.aspx?id=202395",""],[5956,"لا تحسبوا قدَماً لديَّ وحيدة كُسِرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=205169",""],[6035,"كم كان أَعْدَل لو أَزْرَى بنا الحَجرُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177617",""],[6046,"الظمأ الرهيب","https://www.poetsgate.com/ViewPoem.aspx?id=35226",""],[6070,"إعدلْ هداكَ اللهُ للإحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=188631",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""],[6093,"حبيبتي كالمُنسرح","https://www.poetsgate.com/ViewPoem.aspx?id=176618",""],[6184,"أمام مصحف عثمان في استنبول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78621&r=&rc=13",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[6339,"وطن النماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87894&r=&rc=6",""],[6343,"فاكهة الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86039&r=&rc=10",""]],"verses":[["الظُلمُ وَالإِنصافُ مِن فِعلِ مَن","يَحكُمُ في الحاضِرِ وَالبادي",0,"د",2,0],["الظاعِنونَ عَلى العَمياءِ إِن ظَعَنوا","وَالسائِلونَ بِظَهرِ الغَيبِ ما الخَبَرُ",1,"ر",1,0],["الظاعِنونَ عَلى أَهواءِ نِسوَتِهِم","وَالخافِضونَ بِدارٍ غَيرِ مِحلالِ",2,"ل",1,0],["الظاعِنونَ عَلى العَمى بِجَميعِهِم","وَالخافِضونَ بِغَيرِ دارِ مُقامِ",3,"م",1,0],["الظاعِنونَ عَلى هَوى نِسوانِهِم","وَالنازِلونَ بِشَرِّ دارِ مُقامِ",4,"م",1,0],["الظاعِنونَ عَلى العَمى بِجَميعِهِم","وَالنازِلونَ بِشَرِّ دارِ مُقامِ",5,"م",1,0],["الظلم ضيَّق في وجو","ه رجائنا طرق المكاسب",6,"ب",1,0],["الظَلامُ رايَتُها","وَهيَ جَيشُهُ اللَجِبُ",7,"ب",1,0],["الظُلمُ مِن شِيَمِ النُفوسِ فَإِن تَجِد","ذا عِفَّةٍ فَلِعِلَّةٍ لا يَظلِمُ",8,"م",1,0],["الظَبيُ فيهِ مِن خَلقِها شَبَهٌ","النَحرُ وَالمُقلَتانِ وَالعُنُقُ",9,"ق",1,0],["الظُّلمُ دِينٌ والتعسُّفُ شِرعةٌ","والغَدْرُ عَهدٌ والهَوى ميثاقُ",10,"ق",1,0],["الظُلمُ يَعصِفُ بِالقَياصِرِ فَاِنظُروا","كَم غالَ مِن تاجٍ وَمِن إِكليلِ",11,"ل",1,0],["الظُلمُ مَفسَدَةُ النُفوسِ وَما لَها","غَيرُ التَرَفُّقِ في الأُمورِ صَلاحُ",12,"ح",1,0],["الظّافرونَ بنو الإسلامِ لا فَزَعاً","يرى العِدَى في الوغَى منهم ولا خَوَرا",13,"ر",2,0],["الظلمُ أوردَها الغليلَ وإنَّهُ","لأشدُّ ما تَجِدُ السُّيوفُ وأبْرَحُ",14,"ح",1,0],["الظالمُ الباغي يسوس أُمورَهم","واللصُّ والجاسوسُ والسمسارُ",15,"ر",1,0],["الظاهِرُ العَبَراتِ","الباطِنُ الزَفَراتِ",16,"ت",1,0],["الظُلمُ في الطَبعِ فَالجاراتُ مُرهَقَةٌ","وَالعِرفُ يَستُرُ وَالميزانُ مَبخوسُ",17,"س",1,1],["الظُلمُ أَكثَرُ ما يَعيشُ بِهِ الفَتى","وَأَقَلُّ شَيءٍ عِندَهُ الإِنصافُ",18,"ف",1,0],["أَلَظّوا بِالقَبيحِ فَتابَعوهُ","وَلَو أَمَروا بِهِ لَتَجَنَّبوهُ",19,"ب",3,0],["الظامئينَ إلى الجهادِ فإن دُعُوا","وَردوا حِياضَ الموتِ عَذْبَ المَوْرِدِ",20,"د",1,0],["الظُلمُ أَجمَعُ وَالإِساءَةُ كُلُّها","بَغيُ القَوِيِّ عَلى الضَعيفِ المُرغَمِ",21,"م",1,0],["الظلمُ حيٌّ فيهِ نامٍ شائعٌ","والعدل ميت لا يجيب إذا دُعى",22,"ع",2,0],["الظامئ القلب من خير ومرحمة","فإنّ ألحّ سقاه الحقد والحسدا",23,"د",2,0],["الظِّلُّ يَسْدُرُ فِي غِوَايَتِهِ","لاَ يُرْعَوِي عَجُمٌ وَلاَ عَرَبُ",24,"ب",1,0],["الظَّالِمُوكِ قُضَاتُها","وهُمُ النِّيابةُ، والشُّهود",25,"د",1,0],["الظباء الأمويّات وفي","خدرها الدّنيا : حمى الله الظّباء",26,"ا",2,0],["الظاّلمان المالكان ونعمة","ما أسلفا من زلّة وجناح",27,"ح",1,0],["أَلَظَّ بِهذا الصُلحِ كُلُّ مُبَرَّأ","عَظيم اللِواءِ أَمرُهُ ثُمَّ يُحمَدُ",28,"د",1,0],["الظلم من شيم النفو","س وقاهُ ربّي من ظلوم",29,"م",1,0],["الظلم معنى قبيح","يسوءكم إن سألتم",30,"م",1,0],["الظلم مني محبوب ولا عجبٌ","إني لكل جميل الوجه ظلّام",31,"م",1,0],["أَلَظَّ بِهِنَّ يَحدوهُنَّ حَتّى","تَبَيَّنَ حولُهُنَّ مِنَ الوِساقِ",32,"ق",1,0],["الظلمُ من عاداتها وطباعها","فالويلُ للمغلوبِ والصعلوك",33,"ك",1,0],["الظلمُ من شِيَمِ الذين قد ادَّعوا","حريّةَ التفّكيرِ والتمليك",34,"ك",1,0],["الظاهِرِ المَلِكِ الغازي الغِياثِ مَتى","يُعذَل عَلى الجودِ يَزدَد في تَناهيهِ",35,"ي",2,0],["الظلم مهما زُينت الوانه","ظلمٌ وظلمُ الفكر عاتٍ عاهر",36,"ر",1,0],["ألظنٍّ وربما كان إثماً","كنتَ لو قد عصيتَه مأجورا",37,"ر",2,0],["الظاهر الآيات قام دليلها","والطاهر الأخلاق والأعراق",38,"ق",1,0],["الظلم مسلكه وخيم إنما","في الرافدين تمهدت طرقاته",39,"ت",2,0],["الظلم أن أشقى بآ","دابي وإن خلَّدن ذكري",40,"ر",2,0],["الظل أثبت من وداد أجلهم","وإذا طلبت تهزه فعسيب",41,"ب",1,0],["ألظظتَ في إِدارك ثأري فاعفُ قد","ألظظتَ فيه وزدتَ في الإِلظاظ",42,"ظ",1,0],["الظّرفُ فيكَ كَثير","وَالشّينُ فيكَ قَليلُ",43,"ل",1,1],["الظِّبا والحُبُّ دائي، فمتى","أَتَشافى وفؤادي قد أَبى؟",44,"ب",2,0],["الظاهر الباطن النور الذي بهرت","أنواره فانجلت عنا العمايات",45,"ت",1,0],["الظاهر بن الحاكم الزاكي الذي","حَكّمَهُ الله تَعَالى فَعَدلْ",46,"ل",1,0],["الظلم والجور في أيامك انطويا","طيّاً وخوّلت حيل البطل أهلاكَ",47,"ك",1,0],["الظَهرُ قِرطاسُهُ وَالسَوطُ يَطلُبُهُ","بِئسَ الكِتابُ بِعَقدٍ غَيرِ مَحلولِ",48,"ل",1,0],["الظ افتقاري ذا الجلال وذلتي","وباسمك ذا الاكرام فارحم ملظتي",49,"ي",1,0],["الظئر والرضيع أم وابنم","كل على صاحبه محرم",50,"م",1,0],["الظل ظل الأرز","خيم فوقه ظل البغاة",51,"ه",1,0],["الظلم وان وليس من","أمل يلوح بالعداله",52,"ل",2,0],["الظاهر الغازي الذي بشْرُهُ","بَشَّر عَافيه بنيل النجاحْ",53,"ح",1,0],["الظافر بن الناصر السامي إلى","شرف تودّ الشهب بعد مرامه",54,"م",2,0],["الظاهر بن الناصر المسهب في","مناقب جلَّت عن الإيجاز",55,"ز",1,0],["الظاهر الغازي الذي أيامه","أخفت مناقب أهل كل زمان",56,"ن",1,0],["الظاهر بن الناصر المحيي الورى","بحيا شفى منهم غليل أُوام",57,"م",1,0],["الظاهر المرتجى نوالاً","تغرق في جنبه البحار",58,"ر",1,0],["الظاهر بن الناصر الملك الذي","أخفى على كسرى وأنسى قيصرا",59,"ر",2,0],["الظاهر الغازي الذي صِيد العدا","تصدُّ عن عصيانه وتصدف",60,"ف",1,0],["الظلم أقطعه والعلم أنشره","فيسبح الناس في بحر من المنن",61,"ن",1,0],["الظبي جيدُك أجيد وبوده","لو كان مثلُك بالشنوفِ مُشنّفَا",62,"ف",2,0],["الظن مني لو فرضت لواحد","في الأعجمين خصصتني بالواحد",63,"د",1,0],["الظلم والأطماع والإعجاب","والشُّحَ المطاع وغيرها لن تسترا",64,"ر",2,0],["الظَّالِماتُ وهنَّ الشَّاكِياتُ بِأن","ضاءٍ تَبيتُ تُعانِي الهَجرَ والسَّهَرَا",65,"ر",2,0],["الظلم في الأرض سار كالظلام بها","وكاشف الظلم فيها كاشف الظلم",66,"م",1,0],["الظهر يأتي لا يشوق غذاؤه","نفسي فعندي بالنسيم غذاءُ",67,"ا",2,0],["الظاهر المعروف بالابداع","وما بدا من حسن الاختراع",68,"ع",1,0],["الظافرُون على الزّما","نِ الراتعون على الحريرِ",69,"ر",1,0],["الظلمُ علّمنا وَأي","قَظَنا وَكانَ هُوَ السهاد",70,"د",1,0],["الظَّرفُ وَقتٌ أو مَكانٌ ضُمِّنَا","فِى بِاطِّرَادٍ كَهُنَا امكُث أزمنَا",71,"ن",2,0],["أَلظالمو النَفس عُدواناً وَما ظَلَموا","وَالظُلم لِلنَفس تَعريض إِلى النَقم",72,"م",1,0],["الظلم يمرج بحره","والبغي مرفوع القبب",73,"ب",1,0],["الظلم مهما دعمتم من بنايته","لا بد يوماً على البانين ينهدم",74,"م",1,0],["الظلم يهدم ما بنت","كفَّاك فالحذر الحذر",75,"ر",1,0],["الظافر الملك الذي من ظفرا","بقربه نال العلاء الأكبرا",76,"ر",2,0],["الظّاعنينَ وودُّهم مستوطنٌ","والرَّاحلينَ وذكرُهم لم يرحلِ",77,"ل",1,0],["الظنَّ لا يغني فلا تحكموا","في دينكم أهواءكم والظنون",78,"ن",1,0],["الظَّاهريُّ مَناقِباً لا تَنطَوي","والنَّاصرِيُّ مَآثراً لا تُجحدُ",79,"د",1,0],["الظَبي أَنت وقد حوشيتَ من خَنَس","وَالبَدرُ أَنتَ مُوَقّىً كُلفَةَ الغيَر",80,"ر",1,0],["الظاعِنينَ عَلى العَمى قُدّامَهُم","وَالنّازِلينَ بِشَرِّ دارِ مُقامِ",81,"م",1,0],["الظلام يطول ويطول المسير","كاسفه شمس ارض ما تنبت لقاك",82,"ك",1,0],["الظُّلمُ طَاغٍ والعَدْلُ غائِبْ","والصَّمتُ شَعبٌ يُحْصِي العَجَائبْ",83,"ب",1,1],["الظاهر ان حظٍ بهالعمر مالي","حتى سواد العين يا حسرتي رااااح",84,"ح",1,0],["الظلُّ يرقبُ في الدروبِ خُطايا","وأناهُ زادتْ عن حدودِ أنايا",85,"ا",3,1],["الظبي يجفل من الحس الحذير","واحلو قدام عيني جفلته",86,"ت",2,1],["الظلم كفر ٍ يسوقه سوء الأخلاقي","والدين ساس العدل والحق عنوانه",87,"ن",2,0],["الظلم والله ظلم غالين الأقراب","يا قسي ظلم اللي من الناس غالي",88,"ل",2,1],["الظلم غيمة صيف مسرع وبنزال","والعدل يبطي بس يحيح هطوله",89,"ل",2,0],["الظُّلْمُ فِي مِصْرَ عَلَّمَنَا الْمَهَابَةَ مِنْ","كُلِّ الْأُمُورِ وَكُنَّا قَبْلُ لَمْ نَهَبِ",90,"ب",1,1],["الظلايم هضايم وأنت : لاتظلما","الله أكبر على اللي للبشر ظالمين",91,"ن",1,0],["الظلام يطول .. ويطول المسير","كاسفه شمسك ولا تنبت لقاك",92,"ك",1,0],["أ لِظُلْمِهمْ أروي؟ أم القومُ الَّذي","هَتَكوا وَعاثوا في الدُّنا كوَضيعِ",93,"ع",1,0],["الظُلْمُ القاهرُ حاصَرَهُ","واليومَ انتفَضَ لِيَهزِمَهُ",94,"م",2,0],["الظفو يبقى والاحساني","خالد لاهله وبسطوره",95,"ر",2,0],["الظلمُ لا يُبقي على وطنٍ ولا","تُعطى الحقوقُ لعاجزٍ مترددِ",96,"د",1,0],["الظلمُ أنتمْ وما عدلٌ ترومُ به","وما بَذَلْتَ لعدلٍ فيه مجهودا",97,"د",2,0],["الظلم كان ولم يزل","خصماً لفاعله ألدا",98,"د",2,0],["الظلم ينهشهم للذبح قد جمِعوا","حرب مشرعة كانوا لها حطبا",99,"ب",2,0],["الظبي ظبيك فاشعل قلبه الشبقا","تكفي يداك لكي تلقاه محترقا",100,"ق",2,1],["الظلمُ ثقبٌ في المجرة أسودٌ","يمتصُ أفئدة الشعوب ويُفْجِعُ",101,"ع",1,0],["الظاهر الله في الآفاق رفعته","والباطن الله مفطورٌ عليه دمي",102,"م",2,0],["الظلم فيكي سنين","والعدل ساعه يادوب",103,"ب",1,0],["الظاهر اني يافرح عنك محذوف","ياذا الفرح مالي توافيق ووفاق",104,"ق",1,0],["الظافرونَ بحقدهم وبمكرهم","هُمْ خاسرونَ وكلّ شئ عابرُ",105,"ر",1,0],["الظلام اليا تبرى من مدرات النهار","يبتدي عمره ضرير وينتهي عمره ضرير",106,"ر",1,1],["الظروف احيان تعطيك اختبار","لجل تدري وين موقعك السليم",107,"م",1,0],["الظِلُّ يزحفُ والمدافعُ أوشكَتْ","أنْ تُشعلَ الأكبادَ والنيرانا",108,"ن",2,0],["الظلُّ والماءُ السليلُ وبهجةٌ","في كلِّ منتزهٍ هنا الإغراء",109,"ا",2,0],["الظالم المغرور يفنى في الدجى","والحق يسمو فوق كل قرارِ",110,"ر",1,0],["الظنون السود غطّت 