{"poems":[[65,"هو ما ترى فأقل من تعنيفي","https://www.aldiwan.net/poem46129.html","الكامل"],[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[44,"أعصيت أمر ذوي النهى","https://www.aldiwan.net/poem50355.html","مجزوء الكامل"],[37,"ما عناك الغداة من أطلال","https://www.aldiwan.net/poem39094.html","الخفيف"],[95,"طفت والصبح طالباً في الجنان","https://www.aldiwan.net/poem11230.html","الخفيف"],[74,"روحي فداء مهفهف مياد","https://www.aldiwan.net/poem18606.html","الكامل"],[93,"من أين جئت وكيف عجت ببابي","https://www.aldiwan.net/poem8751.html","عموديه"],[40,"إني امرؤ لم أزل وذاك من الله","https://www.aldiwan.net/poem7834.html","المنسرح"],[87,"بأبي وروحي الناعمات الغيدا","https://www.aldiwan.net/poem63773.html","الكامل"],[47,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[30,"من نازع طاعة حتى تكون له","https://www.aldiwan.net/poem5223.html","البسيط"],[68,"إن الملوك لتعفو عند قدرتها","https://www.aldiwan.net/poem38666.html","البسيط"],[68,"لا زال ظلك للعفاة ظليلا","https://www.aldiwan.net/poem38745.html","الكامل"],[99,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[52,"يا صاح لا تجر في لومي وتأنيبي","https://www.aldiwan.net/poem64829.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[108,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[96,"وفاء القبور","https://www.poetsgate.com/ViewPoem.aspx?id=13790",""],[164,"لله في كل ما يجري به القدر","https://www.aldiwan.net/poem58869.html","البسيط"],[240,"خليفة الله الذي وعوده لا تخلف","https://www.aldiwan.net/poem31820.html","مجزوء الرجز"],[255,"حسن التأتي مما يعين على","https://www.aldiwan.net/poem14996.html","المنسرح"],[266,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[309,"العبد قد بناه","https://www.aldiwan.net/poem16835.html","مجزوء الرجز"],[438,"يا بن عدلان يا أخس الرجال","https://www.aldiwan.net/poem12457.html","الخفيف"],[438,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[438,"يا من يرى فضل الشتاء","https://www.aldiwan.net/poem12716.html","مجزوء الكامل"],[457,"مولاي صدر بني العلا","https://www.aldiwan.net/poem13768.html","مجزوء الكامل"],[505,"ما رده الباغي إذا ردت به","https://www.aldiwan.net/poem38052.html","الكامل"],[534,"الرازق الله فاترك الطمعا","https://www.aldiwan.net/poem37337.html","المنسرح"],[556,"إن كنت بالعفو ليس تعذرنا","https://www.aldiwan.net/poem47851.html","المنسرح"],[563,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[563,"إن كنت لم ترض عن النفس","https://www.aldiwan.net/poem34447.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87158","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34508","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145856","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62552","الرمل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216923",""],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35361","الكامل"],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/122389","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56311","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56169","الكامل"],[1196,"","https://poetry.dctabudhabi.ae/diwan/poem/204093","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136229","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46710",""],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137849",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49923","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79798","السريع"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116940","السريع"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52118","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124731","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71074","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89519","البسيط"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202379","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27159","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27917","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2272,"","https://poetry.dctabudhabi.ae/diwan/poem/131430","البسيط"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32622","المنسرح"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32588","المنسرح"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93637","الرجز"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131690",""],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21644","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65994","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94291","الكامل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48326","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48331","الكامل"],[3602,"","https://poetry.dctabudhabi.ae/diwan/poem/199806","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45908","الكامل"],[3652,"","https://poetry.dctabudhabi.ae/diwan/poem/198846","المنسرح"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131288",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135522","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135744","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135564","الكامل"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127770","المجتث"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4797,"تالي عصير","https://www.poetsgate.com/ViewPoem.aspx?id=29435",""],[4888,"ضياء الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=207674",""],[4929,"الكرامة في زمن العبيد","https://www.poetsgate.com/ViewPoem.aspx?id=199272",""],[5002,"سهم المنايا...","https://www.poetsgate.com/ViewPoem.aspx?id=205731",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5277,"هروب العائذين","https://www.poetsgate.com/ViewPoem.aspx?id=185702",""],[5409,"ذكراك وهي لها في الدهر تجديد","https://www.poetsgate.com/ViewPoem.aspx?id=155263",""],[5582,"عَرِّجْ فَهَذِي ( رُسُومُ ) الأَثْلِ وَالبانِ","https://www.poetsgate.com/ViewPoem.aspx?id=187310",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5730,"زدني جنونا","https://www.poetsgate.com/ViewPoem.aspx?id=210373",""],[5866,"قال من لا يعجزه نظم الحروف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[5887,"كفكف الدمع أنت على الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=37214",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""]],"verses":[["والعَبْدُ مُنْتَظِرٌ وهُنَّ مَواطِلٌ","ومنَ العَناءِ إطالَةُ التّسْويفِ",0,"ف",1,0],["والعَبْدُ كالمَوْلى رَميمٌ عَظْمُهُ","والطِّفْلُ كالشّيْخِ وكالكَهْلِ الفَتى",1,"ا",1,0],["وآلُ عبّاسَ لَقوا أعداءَهُ","فاحْتَكَمَتْ سُيوفُهُمْ على الطُّلى",1,"ا",1,0],["وَالعَبدُ يُضرَبُ بِالعَصا","وَالحُرُّ تَكفيهِ المَقالَه",2,"ل",2,0],["وَالعُبَيلاءُ مِنهُمُ بِيَسارٍ","وَتَرَكنَ العَقيقَ ذاتَ النِصالِ",3,"ل",1,0],["وَالْعَبِيرُ الَّذِي يُحَدِّثُ عَمَّا","فِي الضَّمِيرِ الأَخْفَى بِأَذْكَى بَيَانِ",4,"ن",1,0],["والعبدُ قد وافى الشتاء وجسمه","قد سابق الإبراقَ بالإرعاد",5,"د",1,0],["وَالعَبدَ في أَغلالِه وَحِبالِهِ","وَالمُلكَ في الديباج وَالأَطيابِ",6,"ب",1,0],["وَالعَبدُ لا يَطلُبُ العَلاءَ وَلا","يُعطيكَ شَيئاً إِلّا إِذا رَهِبا",7,"ب",2,0],["وَاِلعَب بِغَيرِ سِلاحِهِ فَلَرُبَّما","قَتَلَ الرِجالَ سِلاحُهُ مَردودا",8,"د",2,0],["وَالعَبدَلِيّونَ المِراضُ مِنَ الحَيا","مِثلَ اللُيوثِ تَميدُ في الأَخياسِ",9,"س",1,0],["وَالعَبطُ لِلنيبِ حَتّى لا تَهُبَّ لَها","ريحٌ وَيَقتُلُ بِالمَأدومَةِ القِرَرا",10,"ر",2,0],["وَالعَبدُ لَم يُفشِ أَسرارَ المَليكِ وَلَم","يَذكُر حَريماً وَلا في مُلكِهِ قَدَحا",11,"ح",2,0],["وَالعَبدُ مُشتَهِرٌ بِحُبِّكَ ناطِقٌ","بِجَميلِ ذِكرِكَ بُكرَةً وَأَصيلا",12,"ل",2,0],["والعباب العريض والأفق المو","حش واللانهاية الخرساء",13,"ا",2,0],["وَالعَبدُ زَوجُ الزَواني قَد نَفَختُ لَهُ","مِنّي بِسَجلٍ ذَنوباً غَيرَ مَشروبِ",14,"ب",1,0],["وَالعَبْقَرِيَّةُ قَدْ تُفَرِّقُ فِي حَلىً","شَتَّى مَظَاهِرِ وَحْيِهَا المْتُوَقِّد",15,"د",1,0],["والعبقريةُ أنْ تحلِّقَ وادعاً","فتفوتَ جُهْدَ الناصِبِ الكَدّاح",16,"ح",1,0],["والعبقريّةُ أينما وجَّهتها","تسمو بصاحبها على نظرائه",17,"ا",3,0],["والعبقريّ وإن جلّت موهبه","طفل السّريرة لا حقد ولا حذر",18,"ر",1,0],["والعبد مستعملٌ فيما يراد به","الفعل للعبد والجاري به القدرُ",19,"ر",1,0],["وَالعَبدُ كَيءٌ شامِطٌ","يُخشى عَلَيهِ التَلَفُ",20,"ف",1,0],["والعبدُ مذ كان في جَزارتِهِ","يَعرفُ من أين تؤكَلُ الكَتِفُ",21,"ف",1,0],["والعبد سيان في أوامره","لسانه أو لسان أرقمه",22,"م",2,0],["والعبد ليس يملك","شيئاً من مولاه",23,"ا",2,0],["والعبيدُ الذين عندك قالوا","عنك قولاً يقضي بصفعِ القَذالِ",24,"ل",1,0],["والعبْ بعِطفِك كالقضيب فإنما","أهدَتْ بوارِحَها لك البُرَحاءُ",25,"ا",2,0],["والعبدُ في أفعالهِ","عن خُلْقِ سيّدِه يُترجِمْ",26,"م",1,0],["والعبدُ عبدٌ لا يزال","على الدعاء لكم مُثابر",27,"ر",1,0],["والعبدُ في الأمرَيْنِ مأسورُ القَضا","تأتي لهُ من غيرِ سعيٍ قِسمتُهْ",28,"ت",2,0],["والْعَبْدُ لا يَسْتَطيعُ مَنْفَعَةً","إلا إذا اللهُ عَبْدَهُ نَفَعا",29,"ع",2,0],["والعبدُ علماً بحلمِ سيّدِهِ","يُذنِبُ عمداً وغيرَ مُعتمِدِ",30,"د",1,0],["والعبد ناظمها عبد الغني له","شمل على الرغم منه غير منتظمِ",31,"م",1,0],["والعبد منسوب لذا أو لذا","في نشأة الإطلاق والحبس",32,"س",1,0],["وَالعَبد صالح وَالكُتّاب قَد لبسوا","مِن جَور أَغا أَثوابَ أَحزان",33,"ن",1,0],["وَالعَبدُ فَهوَ خَليعُ ثَوبِ رِئاسَةٍ","قَد صار لا يَقوى عَلى الناموسِ",34,"س",1,0],["والعباءاتُ والزَّوايا ظلامٌ","لها أيدٍ مَخْفيِّةٌ وانقيادُ",35,"د",1,0],["والعبادات صنوف في التقى","ومن الأعمال بِرُّ الوالدينْ",36,"ن",1,0],["والعبدُ يُقْرعُ بالعصا","والحرُّ تكفيه المقالهْ",37,"ل",2,0],["وَالعَبدُ مِن فَرطِ الغَرامِ مُسائِلٌ","عَنكَ الرِفاقَ وَلِلنُجومِ مُسامِرُ",38,"ر",1,0],["والعبد هذا هو الحرّ الذي حصلَت","له الخلافة جلّ اللّه معطيه",39,"ي",2,0],["والعبدة السودا غدت","تلومني ملبلبهْ",40,"ب",2,0],["والعبد يا مولاي أضحى واقعاً","مما عراه بحيرة ملعونَهْ",41,"ن",2,0],["والعبد عبدك في قرب وفي بعد","وأنت مولاه إن تظعن وإن تقم",42,"م",1,0],["والعبد عبد ترى في شانه عجبا","وأمره فيه تعسير وتيسير",43,"ر",1,0],["والعبدُ فيه حمامةٌ تغريُدها","فيه المدحُ وطوقُها الإحسانُ",44,"ن",1,0],["والعبد في ملك العدالة سيد","اولته راحة باله التسويدا",45,"د",2,0],["والعبدُ لا تحلو عِبادَةُ ربّه","في نفسهِ إِلا بخوفِ عِقابهِ",46,"ب",2,0],["والعبد لا يُصلحُ من شأنِهِ","إلاَّ الذي يملِك من رقّه",47,"ق",2,0],["والعبدُ كالحر وإن ساءه","والأبغث الأغثر كالصفر",48,"ر",1,0],["والعبدليّات تحكي في تصنّعها","ضرائراً جئن في غنج وتزيين",49,"ن",1,0],["والعبد كفارة الأيمان تلحقه","بإذن سيده والدهرُ ذو خطل",50,"ل",1,0],["والعبد إن هو جاءه","رزق يساق بلا انقطاع",51,"ع",1,0],["والعَبْدَلِيّين والكَعْبين قاطِبَةً","والفائِضيّين أَهْلَ النَّفْعِ والضَّرَرِ",52,"ر",1,0],["وَالعَبدُ إِن صَلُحَت لِلَّهِ نِيَّتُهُ","لا بُدَّ يَبدو لَها في الكَونِ آثارُ",53,"ر",1,0],["والعبر بالطرف اختاروك واصطنعوا","منك أمراء ليس للأيدي بملتزم",54,"م",1,0],["وَالعَب كَما لَعِبَت أَوانِسُ نُهَّدٌ","وَاِرتَع كَما رَتَعَت ظِباءٌ شُرَّدُ",55,"د",1,0],["والعبدُ مفتقر إليه متكل","عليه مستند لذاته أبدا",56,"د",2,0],["والعبد في عزلةٍ عن كلِّ ما كتبتْ","كفٌ له أوهمت من كفه ديم",56,"م",1,0],["وَالعبدُ عندهُمُ فَليسَ بِفَاعلٍ","بَل فعلُهُ كَتَحرُّكِ الرَّجفَانِ",57,"ن",1,0],["وَالعَبدُ في التَّحقيقِ شِبهُ نَعَامَةٍ","قَد كُلِّفَت بِالحَملِ وَالطَّيرانِ",57,"ن",1,0],["والعبدُ يقرَؤهُ بصَوتٍ طَيِّبٍ","وَبِضِدِّهِ فَهُمَا لَهُ خَطَّانِ",57,"ن",1,0],["والعبد محتجب في عز مالكه","دقت معارفه في الدهر والزمن",58,"ن",1,0],["والعبد لا يحسن العلاء ولا","يعطيك شيئاً إلا إذا رهبا",59,"ب",2,0],["والعبدُ لا يطلب العَلاءَ ولا","يُعطيك شيئاً إذا رَهِبا",60,"ب",2,0],["