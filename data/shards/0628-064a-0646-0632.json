{"poems":[[55,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[99,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[463,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108767","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108777","الخفيف"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17733","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205812","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100211","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65362","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85066","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128935","الخفيف"],[5616,"قنديل","https://www.poetsgate.com/ViewPoem.aspx?id=205034",""]],"verses":[["بي نِزاعٌ يَطغى إِلَيكَ وَشَوقٌ","وَغَرامٌ وَزَفرَةٌ وَعَويلُ",0,"ل",1,0],["بي نزوع إلى الدموع الهوامي","غير أني أخاف من آلامي",1,"ي",1,1],["بي نزوعٌ إلى الخيال وبي","للتمنِّي حنينُ مُغتربِ",2,"ب",1,0],["بين زرود إلى أبان","يا شُقّة البعدِ بين ذينِ",3,"ن",1,0],["بين زهر الربى وزهر القناني","وحفيف الصبا ولحن المطوَّق",4,"ق",1,0],["بين زهرٍ زها وغصن تثنى","ونسيم زكا وماءٍ ترقرق",5,"ق",1,0],["بَينَ زَيدٍ وَبَينَ آلِ سَعيدٍ","أُعطِيَ الحِلمَ مِنهُمُ وَالقَبولا",6,"ل",2,0],["بي نزاع إلى العناق وفيها","لهفَة ٌشابها حياءُ الدلال",7,"ل",1,0],["بين زيافة وبين شموع","أكل النص من ذراها دئوبا",8,"ب",2,0],["بين زهر ورياض","بمغان مُطربات",9,"ت",1,0],["بين زهر الرياض في خير أنس","هازم جيشه جيوش العبوس",10,"س",1,0],["بين زهر النجوم تختال تيهاً","كفتاة تجر ذيل دلال",11,"ل",1,0],["بين زِقٍّ وقينةٍ أنا أَحيا","وعلى عزفِها الجميل أَميلُ",12,"ل",1,0]]}