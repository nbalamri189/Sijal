{"poems":[[55,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[53,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[91,"اخي الى الموت سلك","https://www.aldiwan.net/poem44697.html","مجزوء الرجز"],[46,"أعقبك الله صحة البدن","https://www.aldiwan.net/poem30336.html","المنسرح"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[69,"قل لعلي الذي صداقته","https://www.aldiwan.net/poem18135.html","المنسرح"],[48,"ما جدري أمات صاحبه","https://www.aldiwan.net/poem22597.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54758","الخفيف"],[264,"نظم عقد الدعاء در نضيد","https://www.aldiwan.net/poem35737.html","الخفيف"],[264,"لاح نور الدعا بأفق الطروس","https://www.aldiwan.net/poem35739.html","الخفيف"],[285,"يابن علي ما أضيعت على","https://www.aldiwan.net/poem60566.html","السريع"],[302,"يا ربيب الندى وترب المعالي","https://www.aldiwan.net/poem32950.html","الخفيف"],[376,"أخيلت للصب أشواقه","https://www.aldiwan.net/poem57270.html","الطويل"],[463,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[543,"يا سيدي عشت لي وبعدي","https://www.aldiwan.net/poem48239.html","عموديه"],[543,"التقى عاج بعاج","https://www.aldiwan.net/poem48253.html","عموديه"],[563,"يشف ثوب عنه لي مخيط","https://www.aldiwan.net/poem34404.html","الرجز"],[699,"","https://poetry.dctabudhabi.ae/diwan/poem/104491","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38324","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38209","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38256","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77505","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62478","الرمل"],[1006,"","https://poetry.dctabudhabi.ae/diwan/poem/145935","السريع"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133825","الخفيف"],[1122,"","https://poetry.dctabudhabi.ae/diwan/poem/98108","السريع"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112823","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49996","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125371","الخفيف"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131322","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53197","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53156","الرجز"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140041",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100355","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74157","الرجز"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110783","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112689","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112629","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112690","الرجز"],[3316,"","https://poetry.dctabudhabi.ae/diwan/poem/105682","الخفيف"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139968","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74033","المنسرح"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3865,"","https://poetry.dctabudhabi.ae/diwan/poem/203186","المنسرح"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107048","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73162","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133176","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33511","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139762",""],[4759,"كيف والعطر","https://www.poetsgate.com/ViewPoem.aspx?id=204029",""],[4767,"معين الحب","https://www.poetsgate.com/ViewPoem.aspx?id=183703",""],[5127,"عصينا مَنْ ﻻمَ بغيرِ اهتمامْ","https://www.poetsgate.com/ViewPoem.aspx?id=177358",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5689,"هنا بين هذا الدوح والزهرات","https://www.poetsgate.com/ViewPoem.aspx?id=143393",""],[5848,"أنت الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=50535",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""],[6225,"سميرُ الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80929&r=&rc=198",""],[2588,"شاخصة ( افتئات)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65586&r=&rc=18",""]],"verses":[["كَيفَ وَقَد طابَت أُصولُ دَوحَتي","تُمِرُّ لِلجانينَ يَوماً ثَمَري",0,"ر",2,0],["كيف والمكْرُ من سراياه والرَّأ","يُ أخوه والنصرُ من أمدادِهْ",1,"د",2,0],["كيف وأنّى ولِمْ أقمتُ وقد","بِنْتِ أكان الفؤاد من حجرِ",2,"ر",1,0],["كيف وجدت يا اخي","في جوف قبر منزلك",3,"ك",1,0],["كَيفَ وَجَدتَ الدَواءَ أَوجَدَكَ اللَ","هُ شِفاءً بِهِ مَدى الزَمَنِ",4,"ن",1,0],["كيف وَحَّدْتُم إِلهاً نَفَى التَّو","حِيدَ عنه الآباءُ والأَبناءُ",5,"ا",2,0],["كَيْفَ وُصُولِي إلَى الدَّجَاجَةِ","والبَيْضَةُ عِنْدِي كَأنَّها بَدَنَهْ",6,"ن",2,0],["كَيفَ وَفى لِلخَليلِ مُؤتَمَنٌ","وَطَبعُهُ بِالأَذاةِ مُبتَدِرُ",7,"ر",1,0],["كَيْف وَصْفِي مَا جَلَّ أَوْ دَقَّ مِنْهُ","وَالفنَا مُقْعِدي فَمَنْ لِي عَذيرُ",8,"ر",1,0],["كَيْفَ وَالرُّزْءُ فِي وَدُودٍ صَفِيٍّ","وَرَدَ الصَّفْوَ مِنْ معِينِ وِدَادِي",9,"د",2,0],["كيف والقلب وهو غيبٌ وفي الغي","ب لنظم الدعاء فيه يجيد",10,"د",1,0],["كيف والقلب في دجا الغيب أهدا","ه لشهمٍ من الردى محروس",11,"س",1,0],["كَيْفَ وَأَخْلاٌقكُ مَرضِيَّةٌ","أَصْحَبُها وَالْحالُ مَسْخُوطَهْ",12,"ط",2,0],["كَيفَ والوَجدُ قد أَباحَ اِصطباري","ودموعي لمّا تَزل في اِنهِمالِ",13,"ل",1,0],["كيفَ ولا جَفنٌ لَه ساعةً","من لَيلةٍ يُمكنُ إِطباقُهُ",14,"ق",2,0],["كيف والدَّهناء غابٌ دونَها","وظبا سعدٍ أسودٌ وقنَاها",15,"ا",3,0],["كيفَ ولي أنتَ عند ضَيقي","يا خيرَ مولى لِخيرِ عبدِ",16,"د",1,0],["كيفَ والقدُّ تثَنَّى","بينَنا والطَّرفُ ساج",17,"ج",1,0],["كيف وجود ربنا في عدم","يقال حلَّ أو هما خليط",18,"ط",1,0],["كيف ولي جفن جفاه الكرى","ولي بنار الشوق قلب مذاب",19,"ب",1,0],["كَيفَ وَالشّمسُ مِن جَواريهِ كانَت","مُذ تَبَدَّتْ مِن عالَمِ التكوينِ",20,"ن",1,0],["كَيفَ وَالبدرُ مِثالاً عُدِما","لَو بَدا مِثلٌ لَه لَم يرؤسِ",21,"س",1,0],["كَيفَ وَقَد أَجرَيتَ مِن قَبلِهِ","عَيناً تُسمّى عينَ الاِسكَندَرِ",22,"ر",1,0],["كَيفَ وَقَد مدّت لَكَ الأَيادي","لا خابَ مَن سَمّاك بالجَواد",23,"د",1,0],["كيف والمسك وإن ضُمَّ","فلا يرضى خفاءَ",24,"ا",2,0],["كيف وقد عاينتُ في ربعها","صدراً رئيساً سيّداً مِقْولا",25,"ل",2,0],["كيف والدوح لا يصفقّ إلا","أن تسمىّ ولا يرقصّ ظلا",26,"ل",2,0],["كيف والزهر لا تبوح ولا تتفق","إلا كما على اسمك يتلى",26,"ل",2,0],["كيف وفائي بالذي إن أزُر","قدَّمَ ل عَرّاً معَ الدالِ",27,"ل",1,1],["كيف وهو المصطفى والمجتني","سيد السادات محبوب الاحد",28,"د",1,0],["كيف والملهياتُ أصحنَ منّي","بائناتٍ مَتَّعْتُها بالطَّلاقِ",29,"ق",1,0],["كيف ولَّى بحرُ العلومِ وأبقى","ماءَ دَمعِ العُيُونِ أحمر قاني",30,"ن",2,0],["كَيفَ وَالحسن بِقَلبي قاطِن","لَم يرق طَرفي جمال مذ نزل",31,"ل",1,0],["كيف وقد قال المهيمنُ القديرْ","من فَضْلهِ لِباسُهُمْ فِيْهَا حَرِيرْ",32,"ر",1,0],["كيف وكل لا يماري أنه","خير ملوك الأرض عرب وعجم",33,"م",1,0],["كيف وقد قيدها تدبير من","سماحه وَقْفٌ على الإطلاق",34,"ق",1,0],["كيفَ والقَلبُ والهٌ بمغَانٍ","كُنَّ قِدماً مرابعاً للغواني",35,"ن",2,0],["كيف وشمس المرسلين جدكم","هل بعد ذا فخر لدى أهل النهى",36,"ا",1,0],["كيف وانت العين بل ضياؤها","والليل جؤشوش احمٌّ حلكه",37,"ك",2,0],["كَيفَ وَهُم مِنكَ وَأَنتَ مِنهُم","فَمن بَنو شيبان قل لي مَن هُم",38,"م",1,0],["كيف وعلمي أن لي سيدا","يرزقني من حيث لا أشعرُ",39,"ر",1,0],["كيف ومهما انتفت الشروط","فإنه لا يسلم المشروط",40,"ط",1,0],["كيف وَهُم أجَلُّ سادات العَرَب","وهُم سلالةُ النبيّ المَنتَجَب",41,"ب",1,0],["كيف وقد أكدها بالحلف","والعهد إنما بغير خلف",42,"ف",1,0],["كيف وأراك يا أخا الفضل قبر","وربيب العلى وحامي حماها",43,"ا",3,0],["كيفَ وعدن تحتَ ظلِ سيفه","والحورُ عن يمينه تُسلّم",44,"م",1,0],["كَيفَ ولّيتهم فُؤادي لا كَي","ف وَلَيسوا لما ولّوا أَكفاءَ",45,"ا",2,0],["كَيفَ وَذو النطق كُلَّما هدرت","شقشقة منه قلت ما قُسُّ",46,"س",1,0],["كَيفَ ورجس الفَحشاء قبلتها","وَحانَة الخندَريس مسجدها",47,"د",3,0],["كيف وفيها طهارتي وبها","أقلب ماء وأرفع الحدثا",48,"ث",2,0],["كَيفَ وَقَد بَاءَ ذَوُو الكِتمَانِ","لِلرُّشدِ بِاللَّعنَةِ فِى القُرآنِ",49,"ن",1,0],["كيف وكل غادة","عادتها سفك الدما",50,"م",2,0],["كيفَ والخدُّ منكَ يعرفُ قتلي","قلتَ ما عندَ مُقلتي لكَ ثارُ",51,"ر",1,0],["كيف وعشقي في الجناب الأمنع","غزيل أتلع",52,"ع",1,0],["كيفَ ولا يفقدُ التصابي","قلبي ولا يبردُ الغليلُ",53,"ل",1,0],["كيف وارى فيه بدراً زاهراً","بعدما تمَّ كمالاً وعَلا",54,"ا",1,0],["كيف والعطر الذي ما برحا","حفل النور صباحا وصحا",55,"ح",2,1],["كيف والشوق الذي جرحني","ما شممت العطر إلا جرحا",55,"ح",2,0],["كيف والبقعة التي أنتِ فيها","بقعةٌ بارك الإله الجليل",56,"ل",1,0],["كيفَ؟ وإنَّا قدْ علونا السنامْ","على الغرامِ وبَنَيْنَا الخيامْ",57,"م",1,0],["كيف والدينُ أن تكون المنايا","كالحاتٍ ولا يكون انحدارُ؟",58,"ر",1,0],["كيف والدينُ أن تُراق دمانا","في سماحٍ ولا يموتُ النهارُ؟",58,"ر",1,0],["كيف وجدت السابقين من الورى","أفي يقظة أم في وطا الفجرات؟",59,"ت",1,0],["كيف وانت الحلو! تشرب هماج","ليييييه حنيّتك تصبح حنين",60,"ن",1,0],["كيف وطعم الفراق يسرقنا","حقيقة صغري الطفل يدريها؟",61,"ي",3,0],["كَيفَ وَسَّعتِ لِلجُناةِ طَرِيقًا؟","وَلَنا بِتِّ حارِسًا بِالمَضِيقِ؟",62,"ق",1,0],["كيف ؟.. والليلُ يستجيب ويختارُ","وما غيَّرَ النهارُ مَهبّهْ",63,"ب",2,0],["كيف والشعب منذ مهده حتى","لحدهِ راسفٌ ( بقيد ) الحياةِ !",64,"ه",1,0]]}