https://www.aldiwan.net/poem54155.html","الوافر"],[426,"بغربي قاعة الأنوار أمست","https://www.aldiwan.net/poem40527.html","الوافر"],[429,"نضا عضبا من الجفن","https://www.aldiwan.net/poem12740.html","الهزج"],[434,"لهيب جوى قد أضمرته ضلوعه","https://www.aldiwan.net/poem2540.html","الطويل"],[436,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[436,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[438,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[441,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[456,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[456,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[456,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[456,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[456,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[456,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[456,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[456,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[456,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[456,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[456,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[459,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[459,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[459,"وخاطر من حديث المجد ساورني","https://www.aldiwan.net/poem15908.html","البسيط"],[459,"يفر الخطب قد أمهي شباه","https://www.aldiwan.net/poem16107.html","الوافر"],[459,"إذا ما بحار الأرض جاشت وأجلبت","https://www.aldiwan.net/poem16350.html","الطويل"],[462,"خليلي ما بال النجوم كأَّنما","https://www.aldiwan.net/poem3154.html","عموديه"],[462,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[462,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[462,"جهلاً نظرت برامتين","https://www.aldiwan.net/poem3478.html","عموديه"],[463,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[498,"أي قلب هام فيكم وسكن","https://www.aldiwan.net/poem37760.html","الرمل"],[498,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[512,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[512,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[512,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[527,"هل إلى وصل من هويت سبيل","https://www.aldiwan.net/poem37274.html","الخفيف"],[536,"هي النتائج فما","https://www.aldiwan.net/poem47459.html","عموديه"],[536,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[549,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[549,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[553,"ففر زهير خيفة من عقابنا","https://www.aldiwan.net/poem1924.html","الطويل"],[560,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[560,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[565,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[565,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["بَغى الذُلّانُ غايَتَنا وَأَنّى","يُقامُ المَجدُ بِالعَمَدِ القِصارِ",0,"ر",1,1],["بِغَيرِ شَفيعٍ نالَ عَفوَ المَقادِرِ","أَخو الجَدِّ لا مُستَنصِراً بِالمَعاذِرِ",1,"ر",1,1],["بِغَومٍ عَلى آثارِهِ وَقَدِ اِكتَسى","ظَلامَ الدَياجي غائِطٌ وَسُهوبُ",2,"ب",1,0],["بَغيضٌ إِلى الأَيّامِ أَنَّكَ لي حِمىً","وَغَيظُ بَني الأَيّامِ أَنَّكَ لي أَبُ",3,"ب",1,0],["بَغيضٌ إِلى قَلبي سِواهُ وَإِن غَدَت","لَهُ نِعَمٌ تَترى إِلَيَّ رِغابُ",4,"ب",1,0],["بَغى السَلمَ وَقَد أَشفى","عَلى مَزلَقَةِ الخَطبِ",5,"ب",1,0],["بِغاراتٍ كَوَلغِ الذِئبِ تَترى","عَلى الأَعداءِ بَيِّنَةِ العَداءِ",6,"ا",2,0],["بغْداذَ أيّتُها المَطيُّ فواصِلي","عَنَقاً تئِنُّ لهُ القِلاصُ الضُّمَّرُ",7,"ر",1,0],["بَغى وَاِدَّعى أَن لَيسَ في الأَرضِ مِثلُهُ","فَلَمّا اِلتَقَينا بانَ فَخرُ المُفاخِرِ",8,"ر",1,0],["بِغَيْضَةِ وحْشِ اللّيْلِ خوفٌ ووَحْشَةٌ","كأنّ فُؤادي وحْشَةً قد أعارَها",9,"ه",2,1],["بَغَتِ الأَرضُ وَالجِبالُ عَلَيها","وَطَغى البَحرُ أَيَّما طُغيانِ",10,"ن",1,0],["بِغادٍ مِنَ الوَسمِيِّ لَمّا تَصَوَّبَت","عَثانينُ وادِيهِ عَلى القَعرِ دَيَّما",11,"م",2,0],["بَغاكُم رِجالٌ عِندَ كُلِّ مَلَمَّةٍ","مُعينٌ عَلَيكُم ما اِستَطاعَ وَخاذِلُ",12,"ل",1,0],["بَغدادُ دارَ المُلوكِ كانَت","حَتّى دَهاها الَّذي دَهاها",13,"ا",3,1],["بِغَيرِ كِتابٍ واضِحٍ مِن مُهاجِرٍ","وَلا مُقعِدٍ مِنّي بِخَصمٍ أُجادِلُه",14,"ل",2,0],["بغداد يا خاذلتي إنني","أسكن بعد اليوم في الناصره",15,"ر",2,0],["بغَى ففرّق شملاً كان مجتمعاً","للمسلمين وشعباً كان مُلتئما",16,"م",2,0],["بغداد حسبك رقدة وسبات","أوَ ما تُمضُّك هذه النكبات",17,"ت",1,1],["بغيبة صيف لا يُؤَتي نطافَها","ليبلغها ما أخطأته المضبِّبُ",18,"ب",1,0],["بغصونٍ من أرضه كقدودٍ","وقدود من أهله كغصون",19,"ن",1,0],["بغطفٍ مثل منطقه رشيق","ولفظ يعجب الأسماع لحنا",20,"ن",2,0],["بغلَةُ النيك لؤلؤٌ فالْهُ عنها","تُعلَفُ الأيرَ ليس تُعلَفُ قَتَّا",21,"ت",2,0],["بغلٌ وبغلٌ هذا يضارطُ ذا","لا صحَّحَ اللَّه تلكمُ الجُثثا",22,"ث",2,0],["بغض تَراهُ ولا يراه","ولم يُقَصِّرْ به وُضُوحُه",23,"ح",2,0],["بِغَاشِيةٍ من رحمة اللّه لم تَرِثْ","نَسِيَّاتُهَا إلّا كَرَيْثِ نُقُودِها",24,"د",3,0],["بِغُصُنٍ غَضٍّ نَد","وظبيةٍ بالجَرَدِ",25,"د",1,0],["بِغَضب عضَّ يدي","وطِيبُه بالحَرَدِ",26,"د",1,1],["بغيتُ وأنت أولى من تَغاضى","لمعترفٍ وقد يبغي الخليطُ",27,"ط",1,0],["بُغاءٌ وتشويةٌ ونَوكٌ ولكنةٌ","وشؤمٌ كملتَ الشؤمَ كلّ كمالِ",28,"ل",1,0],["بُغْضِي لصادٍ أنني رجلٌ","أُصفِي المودَّةَ مني للحواميمِ",29,"م",1,1],["بُغايَةً إِنَّما يَبغي الصِحابَ مِن ال","فِتيانِ في مِثلِهِ الشُمُّ الأَناجيحُ",30,"ح",1,0],["بِغَريرَةٍ نَفَجَ النَعيمُ شَبابَها","غَرثى الوِشاحِ شَبيعَةِ الخَلخالِ",31,"ل",1,0],["بغَوجٍ لَبانُهُ يُتَمُّ بَريمُهُ","عَلى نَفثِ راقٍ خَشيَةَ العَينِ مُجلِبِ",32,"ب",1,0],["بَغدادُ في خَطَرٍ وَمِصرُ رَهينَةٌ","وَغَداً تَنالُ يَدُ المَطامِعِ جِلَّقا",33,"ق",2,0],["بَغى عَلَيهِم عُلوجُ التُركِ بَغيَهُمُ","لَم يَشحَذوا لِلوَغى سَيفاً وَلا صَقَلوا",34,"ل",3,0],["بُغضاً إِلى نَسلِنا بِالإِرثِ مُنتَقِلاً","إِلى بَينِهِم وَمِن جيلٍ إِلى ثانِ",35,"ن",1,0],["بِغَيرِ اِحتِفالٍ وَلا كُلفَةٍ","وَلا مَوعِدٍ بَينَنا يُنتَظَر",36,"ر",1,0],["بِغائِرَةٍ نَضا الخُرطومُ عَنها","وَسَدَّت مِن خِشاشِ الرَأسِ غارا",37,"ر",2,0],["بِغَيطَلَةٍ إِذا اِلتَفَّت عَلَينا","نَشَدناها المَواعِدَ وَالدُيونا",38,"ن",2,0],["بِغَبراءَ مِجزارٍ يَبيتُ دَليلُها","مُشوحاً عَلَيها لِلفَراقِدِ راعِيا",39,"ي",2,0],["بُغِتَ الشَّقيُّ فَصاح في هول القضا","متلفِّتاً للصَّائل المنْتابِ",40,"ب",1,0],["بغداد حيت منه عند قدومه","ضيفاً كريما حل في بغدادا",41,"د",2,0],["بغداد لم تشهد لفا","طِمة الجميلة من نظيره",42,"ر",2,0],["بغداد أمست وقد أزرى بها النوب","تبكي على عزها الماضي وتنتحبُ",43,"ب",1,1],["بغداد أشرف أرضٍ","إذ أنت فيها تحلُّ",44,"ل",1,0],["بَغلٌ أَتى الجَوادَ ذات مَرَّه","وَقَلبُهُ مُمتَلِئٌ مَسَرَّه",45,"ه",1,1],["بَغدادُ دارُ العالِما","تِ وَمَنزِلُ المُتَأَدِّباتِ",46,"ت",1,0],["بِغَيرِكَ راعِياً عَبِثَ الذِئابُ","وَغَيرَكَ صارِماً ثَلَمَ الضِرابُ",47,"ب",1,1],["بِغُرَّتِهِ في الحَربِ وَالسِلمِ وَالحِجا","وَبَذلِ اللُها وَالحَمدِ وَالمَجدِ مُعلَمُ",48,"م",1,0],["بغير أستاذ ولا مرشد","إلى اختيار الطرق الجابره",49,"ر",2,0],["بِغاءٌ يَعودُ عَلى نَفسِهِ","وَشُؤمٌ يَعودُ عَلى صاحِبِه",50,"ب",2,0],["بُغضِيَ العَسكَرَ مَن","بُغضِ مِساءِ اِبنِ صَباحِ",51,"ح",1,0],["بِغُزرِ يَدٍ مِنهُ تَقولُ تَعَلَّمَت","يَدُ الغَيثِ مِنها أَو تَقَيَّلَها البَحرُ",52,"ر",1,0],["بِغورِيَّةِ الشَأمِ الَّتي قَد تَحُلُّها","تَنوخُ وَلَخمٌ أَهلُها وَجُذامُها",53,"م",3,0],["بِغَلباءَ مِن جُمهورِها مُضَرِيَّةٍ","تُزايِلُ فيها أَذرُعَ القَومِ ل