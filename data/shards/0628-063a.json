/diwan/poem/54229","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[106,"سبق الفضاء!","https://www.poetsgate.com/ViewPoem.aspx?id=179491",""],[106,"تراشق القادة","https://www.poetsgate.com/ViewPoem.aspx?id=179639",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[30,"عفا الدَّحلُ منْ ميِّ فمحَّتْ منازلهُ","https://www.poetsgate.com/ViewPoem.aspx?id=3087",""],[90,"من لندن الى بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179081",""],[90,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[38,"أَلَمْ يَسْأَلِ الرَّكْبُ الدِّيَارَ الْعَوَافِيا","https://www.poetsgate.com/ViewPoem.aspx?id=21238",""],[89,"أوَ هل يعود إلى العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=55711",""],[53,"أيُّ العُيُونِ تُجَانِبُ الأقْذاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9806&r=&rc=3",""]],"verses":[["بَغى الذُلّانُ غايَتَنا وَأَنّى","يُقامُ المَجدُ بِالعَمَدِ القِصارِ",0,"ر",1,1],["بِغَيرِ شَفيعٍ نالَ عَفوَ المَقادِرِ","أَخو الجَدِّ لا مُستَنصِراً بِالمَعاذِرِ",1,"ر",1,1],["بِغَومٍ عَلى آثارِهِ وَقَدِ اِكتَسى","ظَلامَ الدَياجي غائِطٌ وَسُهوبُ",2,"ب",1,0],["بَغيضٌ إِلى الأَيّامِ أَنَّكَ لي حِمىً","وَغَيظُ بَني الأَيّامِ أَنَّكَ لي أَبُ",3,"ب",1,0],["بَغيضٌ إِلى قَلبي سِواهُ وَإِن غَدَت","لَهُ نِعَمٌ تَترى إِلَيَّ رِغابُ",4,"ب",1,0],["بَغى السَلمَ وَقَد أَشفى","عَلى مَزلَقَةِ الخَطبِ",5,"ب",1,0],["بِغاراتٍ كَوَلغِ الذِئبِ تَترى","عَلى الأَعداءِ بَيِّنَةِ العَداءِ",6,"ا",2,0],["بغْداذَ أيّتُها المَطيُّ فواصِلي","عَنَقاً تئِنُّ لهُ القِلاصُ الضُّمَّرُ",7,"ر",1,0],["بَغى وَاِدَّعى أَن لَيسَ في الأَرضِ مِثلُهُ","فَلَمّا اِلتَقَينا بانَ فَخرُ المُفاخِرِ",8,"ر",1,0],["بِغَيْضَةِ وحْشِ اللّيْلِ خوفٌ ووَحْشَةٌ","كأنّ فُؤادي وحْشَةً قد أعارَها",9,"ه",2,1],["بَغَتِ الأَرضُ وَالجِبالُ عَلَيها","وَطَغى البَحرُ أَيَّما طُغيانِ",10,"ن",1,0],["بِغادٍ مِنَ الوَسمِيِّ لَمّا تَصَوَّبَت","عَثانينُ وادِيهِ عَلى القَعرِ دَيَّما",11,"م",2,0],["بَغاكُم رِجالٌ عِندَ كُلِّ مَلَمَّةٍ","مُعينٌ عَلَيكُم ما اِستَطاعَ وَخاذِلُ",12,"ل",1,0],["بَغدادُ دارَ المُلوكِ كانَت","حَتّى دَهاها الَّذي دَهاها",13,"ا",3,1],["بِغَيرِ كِتابٍ واضِحٍ مِن مُهاجِرٍ","وَلا مُقعِدٍ مِنّي بِخَصمٍ أُجادِلُه",14,"ل",2,0],["بغداد يا خاذلتي إنني","أسكن بعد اليوم في الناصره",15,"ر",2,0],["بغَى ففرّق شملاً كان مجتمعاً","للمسلمين وشعباً كان مُلتئما",16,"م",2,0],["بغداد حسبك رقدة وسبات","أوَ ما تُمضُّك هذه النكبات",17,"ت",1,1],["بغيبة صيف لا يُؤَتي نطافَها","ليبلغها ما أخطأته المضبِّبُ",18,"ب",1,0],["بغصونٍ من أرضه كقدودٍ","وقدود من أهله كغصون",19,"ن",1,0],["بغطفٍ مثل منطقه رشيق","ولفظ يعجب الأسماع لحنا",20,"ن",2,0],["بغلَةُ النيك لؤلؤٌ فالْهُ عنها","تُعلَفُ الأيرَ ليس تُعلَفُ قَتَّا",21,"ت",2,0],["بغلٌ وبغلٌ هذا يضارطُ ذا","لا صحَّحَ اللَّه تلكمُ الجُثثا",22,"ث",2,0],["بغض تَراهُ ولا يراه","ولم يُقَصِّرْ به وُضُوحُه",23,"ح",2,0],["بِغَاشِيةٍ من رحمة اللّه لم تَرِثْ","نَسِيَّاتُهَا إلّا كَرَيْثِ نُقُودِها",24,"د",3,0],["بِغُصُنٍ غَضٍّ نَد","وظبيةٍ بالجَرَدِ",25,"د",1,0],["بِغَضب عضَّ يدي","وطِيبُه بالحَرَدِ",26,"د",1,1],["بغيتُ وأنت أولى من تَغاضى","لمعترفٍ وقد يبغي الخليطُ",27,"ط",1,0],["بُغاءٌ وتشويةٌ ونَوكٌ ولكنةٌ","وشؤمٌ كملتَ الشؤمَ كلّ كمالِ",28,"ل",1,0],["بُغْضِي لصادٍ أنني رجلٌ","أُصفِي المودَّةَ مني للحواميمِ",29,"م",1,1],["بُغايَةً إِنَّما يَبغي الصِحابَ مِن ال","فِتيانِ في مِثلِهِ الشُمُّ الأَناجيحُ",30,"ح",1,0],["بِغَريرَةٍ نَفَجَ النَعيمُ شَبابَها","غَرثى الوِشاحِ شَبيعَةِ الخَلخالِ",31,"ل",1,0],["بغَوجٍ لَبانُهُ يُتَمُّ بَريمُهُ","عَلى نَفثِ راقٍ خَشيَةَ العَينِ مُجلِبِ",32,"ب",1,0],["بَغدادُ في خَطَرٍ وَمِصرُ رَهينَةٌ","وَغَداً تَنالُ يَدُ المَطامِعِ جِلَّقا",33,"ق",2,0],["بَغى عَلَيهِم عُلوجُ التُركِ بَغيَهُمُ","لَم يَشحَذوا لِلوَغى سَيفاً وَلا صَقَلوا",34,"ل",3,0],["بُغضاً إِلى نَسلِنا بِالإِرثِ مُنتَقِلاً","إِلى بَينِهِم وَمِن جيلٍ إِلى ثانِ",35,"ن",1,0],["بِغَيرِ اِحتِفالٍ وَلا كُلفَةٍ","وَلا مَوعِدٍ بَينَنا يُنتَظَر",36,"ر",1,0],["بِغائِرَةٍ نَضا الخُرطومُ عَنها","وَسَدَّت مِن خِشاشِ الرَأسِ غارا",37,"ر",2,0],["بِغَيطَلَةٍ إِذا اِلتَفَّت عَلَينا","نَشَدناها المَواعِدَ وَالدُيونا",38,"ن",2,0],["بِغَبراءَ مِجزارٍ يَبيتُ دَليلُها","مُشوحاً عَلَيها لِلفَراقِدِ راعِيا",39,"ي",2,0],["بُغِتَ الشَّقيُّ فَصاح في هول القضا","متلفِّتاً للصَّائل المنْتابِ",40,"ب",1,0],["بغداد حيت منه عند قدومه","ضيفاً كريما حل في بغدادا",41,"د",2,0],["بغداد لم تشهد لفا","طِمة الجميلة من نظيره",42,"ر",2,0],["بغداد أمست وقد أزرى بها النوب","تبكي على عزها الماضي وتنتحبُ",43,"ب",1,1],["بغداد أشرف أرضٍ","إذ أنت فيها تحلُّ",44,"ل",1,0],["بَغلٌ أَتى الجَوادَ ذات مَرَّه","وَقَلبُهُ مُمتَلِئٌ مَسَرَّه",45,"ه",1,1],["بَغدادُ دارُ العالِما","تِ وَمَنزِلُ المُتَأَدِّباتِ",46,"ت",1,0],["بِغَيرِكَ راعِياً عَبِثَ الذِئابُ","وَغَيرَكَ صارِماً ثَلَمَ الضِرابُ",47,"ب",1,1],["بِغُرَّتِهِ في الحَربِ وَالسِلمِ وَالحِجا","وَبَذلِ اللُها وَالحَمدِ وَالمَجدِ مُعلَمُ",48,"م",1,0],["بغير أستاذ ولا مرشد","إلى اختيار الطرق الجابره",49,"ر",2,0],["بِغاءٌ يَعودُ عَلى نَفسِهِ","وَشُؤمٌ يَعودُ عَلى صاحِبِه",50,"ب",2,0],["بُغضِيَ العَسكَرَ مَن","بُغضِ مِساءِ اِبنِ صَباحِ",51,"ح",1,0],["بِغُزرِ يَدٍ مِنهُ تَقولُ تَعَلَّمَت","يَدُ الغَيثِ مِنها أَو تَقَيَّلَها البَحرُ",52,"ر",1,0],["بِغورِيَّةِ الشَأمِ الَّتي قَد تَحُلُّها","تَنوخُ وَلَخمٌ أَهلُها وَجُذامُها",53,"م",3,0],["بِغَلباءَ مِن جُمهورِها مُضَرِيَّةٍ","تُزايِلُ فيها أَذرُعَ القَومِ لامُها",54,"م",3,0],["بِغيدٍ وَأَطلاحٍ كَأَنَّ عُيونَها","نِطاقٌ أَظَلَّتها قِلاتُ الجَماجِمِ",55,"م",1,0],["بغرائبٍ مثلِ السيوفِ إضاءةً","وجَدَت من الفِكَرِ الدِّقاقِ صياقلا",56,"ل",2,0],["بِغُدُوٍّ من العُلى ورَواحٍ","واصطِباحٍ من النَّدى واغْتِباقِ",57,"ق",1,0],["بغيثٍ يجودُ إذا الغيثُ ضَنَّ","وليثٍ يَثورُ إذا النَّقْعُ ثارا",58,"ر",2,0],["بغرائبٍ تَهْدي اللُّبا","بَ من الثَّناءِ إلى اللَّبيبِ",59,"ب",1,0],["بِغَيرِ وِدادِكَ لَم أَقنَعِ","وَفي غَيرِ قُربِكَ لَم أَطمَعِ",60,"ع",1,1],["بغرائب الألوان مزدهر","وتراه بالأضواء مغمورَا",61,"ر",2,0],["بغلائل الأضواء وش","شَتها رِقاقُ الأَنمل",62,"ل",1,0],["بِغُرٍّ يَراها مَن يَراها بِسَمعِهِ","فَيَدنو إِلَيها ذو الحِجى وَهوَ شاسِعُ",63,"ع",1,0],["بِغُربَةٍ كَاِغتِرابِ الجودِ إِن بَرَقَت","بِأَوبَةٍ وَدَقَت بِالخُلفِ وَالكَذِبِ",64,"ب",1,0],["بَغَّضَتهُ الأَيّامُ مَدحي فَأَعفى","شُكرِيَ الجَزلُ مِن نَداهُ الطَفيفِ",65,"ف",1,0],["بَغَيتُ بِشِعري فَاِعتَلاهُ بِبَذلِهِ","فَلا يَبغِ في شِعرٍ لَهُ أَحَدٌ بَعدي",66,"د",2,0],["بغى فبغى ألطنبغا الفتحَ منشداً","ويا نفسُ جدِّي إنَّ دهرَك هازلُ",67,"ل",1,0],["بَغْيُ الأُلىَ خَذَلُوه مِن أنصارِه","والبَغيُ نَصرٌ للهُداةِ مُحقَّقُ",68,"ق",1,0],["بَغيتُمْ على المُسْتأْمنينَ وبَرّحتْ","على الضّعفِ منكم بالبرايا الفظائعُ",69,"ع",1,0],["بَغدادُ تَنظُرُ وَالأَحشاءُ خافِقَةٌ","وَالعَينُ دافِقَةٌ وَالقَلبُ مُرتَقِبُ",70,"ب",1,0],["بَغَتِ المُلوكُ عَلى الشُعوبِ وَغَرَّها","مِمَّن تَسوسُ تَجاوُزٌ وَسَماحُ",71,"ح",1,0],["بِغَيرِ شَذَاهُ مِن جُنُونِيَ لَم أفِق","كَأنَّ شَذَاهُ لِلممَجَانِينِ مَنزِلُ",72,"ل",1,0],["بِغَزير مِن علمه وَمُفيدٍ","وَقَريب مِن حفظه وَبَعيد",73,"د",1,0],["بَغاني لَدَيها بَعدَ ما خِلتُ أَنَّهُ","لَهُ الوَيلُ عَن بَغيٍ عَلَينا قَد اَضرَبا",74,"ب",2,0],["بَغدادَ فَوقَ جَمَلٍ مَغلولا","أَوَّلَ يَومٍ مِن جُمادى الأولى",75,"ل",2,0],["بِغَيرِ زادٍ وَلا شَرابٍ","وَلا حَميمٍ وَلا شَعيرِ",76,"ر",1,0],["بغى عليّ ولكن","أدعو له بالسلامه",77,"م",2,0],["بِغُدُوٍّ عَلى الأَعادي وَرَوحا","تٍ لَقينَ الحَياتِ مِن تَقريرِ",78,"ر",1,0],["بِغادَةٍ مَشفَرُها نَضيرُ","تُبدي يَساراً وَلَها تَعسيرُ",79,"ر",1,0],["بِغارَةٍ تَحتَ الشَفا أَسرابِ","بِالمَوتِ وَالحُرسِيَّةِ الغِضابِ",80,"ب",1,0],["بِغَبراءَ لَم تَحفِل بِطَلٍّ وَوابِلٍ","وَنَكباءَ تَسفي بِالعَشِيِّ سَوافيها",81,"ي",3,0],["بغداد تطلب ذِلتي وأُعزها","فانظر لبعد البون في الأضداد",82,"د",1,0],["بَغداد كانَت في زَما","ن غابر للعلم مهدا",83,"د",2,0],["بَغداد لي وطن إذا استذكرته","مرت على عيني له ألواحُ",84,"ح",1,1],["بغداد لَم تك غير دار سلامة","حتى تغير أَهلها وأَشاحوا",84,"ح",3,0],["بغداد فيها كرام","على الموالاة داموا",85,"م",3,0],["بَغداد لَيسَت كَما قد كنت تعرفها","فيما اِنقضى عهده من سابق العصرِ",86,"ر",1,1],["بَغداد مهبط روحي","في أَرضها هُزَّ مهدي",87,"ي",1,0],["بَغداد لَيسَت كَما كا","نت في زَمان الرشيد",88,"د",1,0],["بغداد لَيسَ اليوم دار سلامة","كلا وَلا هي منزل لوئام",89,"م",1,0],["بغناء جادتها من الليل مزنة","فَعادَت بها الأزهار باسمة الثغر",90,"ر",1,0],["بغداد منذ تأَسَّسَت","عُرفت بعاصمة السلام",91,"م",1,0],["بغوا مرة من بعد أخرى فَنالهم","أذى البَغي وَالتاريخ أَمر مكرر",92,"ر",1,0],["بغت شعراتٍ كالثغام فصادفت","حوالك سوداً ما حللن لمرتع",93,"ع",1,0],["بغوا على أحلافه الكرام","جيرته بالبلد الحرام",94,"م",1,0],["بِغَيْرِ الَّذِي يُرْضِي الضَّمِيرَ وَرَبَّهَا","وَوَاليَهَا لَيْسَتْ بِذَاتِ شَوَاغِلِ",95,"ل",1,0],["بَغْدَادُ فَاهْبِطْ أَيُّهَا النَّسْرُ","لاَ زِينةَ اليَوْمَ وَلاَ بِشْرُ",96,"ر",1,1],["بَغْدَادُ عَادَ العِزُّ فِيهَا عَلَى","بدْءٍ وَلأْياً قُضِيَ الثَّأْرُ",96,"ر",1,0],["بَغْدَادُ كَانَتْ مَنَاراً لِلْعُلُومِ فَمَا","لِلْعِلْمِ مِنْ طَالِبٍ إِلاَّ لَهَا طَلَبَا",97,"ب",2,0],["بُغْيَةٌ لِلْخَيْرِ حَالَتْ دُونَهَا","قَسْوَةُ المَوْتِ عَلى الشَّعْبِ الْفَقِيرِ",98,"ر",1,0],["بغداد يا وطن الجها","د ومرضع الأدب الخصيب",99,"ب",1,0],["بغداد يا شغف الجما","ل وملعب الغزل الطروب",99,"ب",1,0],["بغداد ما حمل السرى","مني سوى شبح مريب",99,"ب",1,0],["بُغضُ الحياةِ وخوفُ اللَه أخرَجني","وبيَعُ نفسي بما ليسَت لهُ ثمَنا",100,"ن",2,1],["بَغْدَادُ يَا بَلَد الرَشِيدِ","وَمَنَارَةَ الْمَجْدِ التَلِيدِ",101,"د",1,1],["بغْدَادُ يا دَارَ النهَى","وَالْفَنِّ يا بَيْتَ الْقَصِيدِ",101,"د",1,0],["بَغْدَادُ أيْنَ الْبُحْتُرِيُّ","وَأيْنَ أيْنَ ابْنُ الْوَلِيدِ",101,"د",1,0],["بَغْدَادُ يا وَطَنَ الأَدِيبِ","وَأَيْكَةَ الشعْر الْغَرِيدِ",101,"د",1,0],["بَغْدَادُ أَشْرَقَ نَجْمُهَا","وَبَدَا بِهَا سَعْدُ السعُودِ",101,"د",1,0],["بَغْدَادُ إِنَّا وَفْدَ مِصْرَ","نَفيضُ بالشوْقِ الأَكِيدِ",101,"د",1,0],["بغدادُ مصغيةٌ إلى أنغامه","ودمشقُ راقصةٌ على عيدانه",102,"ن",2,0],["بغداد، عذرًا للكنانة إن قست","في عتبها، والعَتْب للأحرار",103,"ر",1,0],["بغسلها في وَضَح النهار","يا ساسةَ أشبهَ بالتَّجَّارِ",104,"ر",1,0],["بَغْدَادُ، كم لك في قلب العروبة من","قَدْرٍ، إذا هانت الأقدارُ ما هانا",105,"ن",2,0],["بغدادُ قرةُ عينِ الشرق، بغدادُ","لحنٌ