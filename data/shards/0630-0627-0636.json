{"poems":[[41,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2411","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38168","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38160","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38241","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38199","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59785","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52094","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89254","الكامل"]],"verses":[["ذا ضَريرٍ يَصِرُّ مِثلَ صَريرِ ال","قَعوِ لَمّا أَصاحَهُ مَسَدُه",0,"د",2,0],["ذا ضَريرٍ يَشُكُّ آباطَها القُص","وى بِطَعنٍ يَفوحُ مُعتَنِدُه",0,"د",2,0],["ذا ضَريرٍ عَلى العَدُوِّ مُشيحاً","حينَ يَعيا الكَريمُ بِالنَقِماتِ",1,"ت",1,0],["ذا ضَريحُ الشَّريفِ سعدِ المَعاني","كَعبةِ الفَقه وهوَ قطبُ العلومِ",2,"م",1,1],["ذا ضريحٌ يسقيه غَيْثُ حنانٍ","ورِضاءٌ مِنَ الرّحيمِ الكريمِ",3,"م",1,1],["ذا ضريحٌ وروضةٌ من جِنانٍ","زُيِّنت بِالرّضا وَفضلِ الكريمِ",4,"م",1,1],["ذا ضَريحُ الفتى سَميِّ ابنِ عَوْفٍ","وَهوَ نَجلُ الفَتى النّجيبِ الفَخيمِ",5,"م",1,1],["ذا ضُلوع فيك تُصلي","ذا جفون فيك تُندى",6,"د",2,0],["ذا ضَريحٌ حَلَّ قَلبَهْ","طَائِعٌ مَا عَاشَ رَبهْ",7,"ب",2,1],["ذا ضيّقٌ عقلاً ورزقٌ واسعٌ","ذا واسعٌ عقلاً ورزقٌ ضيِّق",8,"ق",1,0]]}