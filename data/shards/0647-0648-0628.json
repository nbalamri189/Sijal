لتُه","فارجِعوه سالماً إن لم يَصِدْ",1,"د",1,0],["هو بغْلٌ وعدْتَنِيهِ فإن أخْ","لَفْتَ ضاهَتْ أخلاقَهُ أخلاقُك",2,"ك",1,0],["هو بحرٌ مِنَ البحورِ فراتٌ","ليس ملحاً وليس حاشاه ضحلا",3,"ل",2,0],["هو بالدَّل فتاةٌ","وهو بالزي غلامُ",4,"م",1,0],["هُوَ بُلبُلٌ عَبَقُ النُبُوَّةِ في أَغا","نيهِ وَفيها نَكهَةُ الصَهباءِ",5,"ا",2,0],["هُوَ بَدرٌ لِمُجتَلٍ","هُوَ غُصنٌ لِمُجتَني",6,"ن",2,0],["هُوَ بَدرٌ قَد تَجَلّى","نورُهُ في المَشرِقَينِ",7,"ن",1,0],["هو بالروح للذين بمصر","ينشدون استقلال مصر يمد",8,"د",1,0],["هو بِكر في ذي البلاد وللأط","فال فيه حماية عذراء",9,"ا",2,0],["هو بينهم ذاك الكسي","ر وكلهم للكل جابر",10,"ر",1,0],["هُوَ بَحرُ السَماحِ وَالجودِ فَاِزدَد","مِنهُ قُرباً تَزدَد مِنَ الفَقرِ بُعدا",11,"د",2,0],["هُوَ بَينَكُم سِرُّ الهُدى لَكِنَّهُ","لِجَلالِهِ السِرُّ الَّذي لَن يُستَرا",12,"ر",2,0],["هو بالباب واقفُ","والرًّدى منه خائفُ",13,"ف",1,0],["هو بحرٌ أطمُّ لجّاً وأطغى","منك موجاً في جيئةٍ وذهابِ",14,"ب",1,0],["هو بيتٌ يسري على عجلاتِ","سمتَ عينيك سقفهُ المزدان",15,"ن",1,0],["هُوَ بِالْمَتَانَةِ وَالسَّنَى مِرْآةُ مَا","بِكِ مِنْ وَفَاءٍ ثَابِتٍ وَذَكَاءِ",16,"ا",2,0],["هو بين الأنام في جسم عملا","قٍ ولكنَّهُ قصير الرداء",17,"ا",2,0],["هُوَ بَهجة الدُنيا وَفَرقَدَها الَّذي","بِسَناهُ أَرباب البَصائر تَهتَدي",18,"د",2,0],["هو باب اللَه أشكوه المنى","إنما السكون لغير اللَه ذل",19,"ل",1,0],["هو بحرُ المعروفِ والجودِ والفضل","فطوبَى لمن يرُى بفِنائِهْ",20,"ا",3,0],["هو بهجةٌ للناظرينَ وفرحةٌ","وبه التهاني والسرورُ الشاملُ",21,"ل",1,0],["هو بحرُ السخاءِ والجودِ والإحس","ان والفضلِ والهدى والرشادِ",22,"د",1,0],["هُوَ بُطرُسُ الحَبرُ المَعَظَّمُ مَن نَفَى","إِيمانُ بُطرُسَ عَنهُ عَثرَةَ بُطرسِ",23,"س",1,0],["هُوَ بَعدَ اللَهِ العَظيمِ عَظيمٌ","دونَ أَدنى مَقامِهِ العُظَماءُ",24,"ا",2,0],["هوَ بحرٌ ولستُ أدري وقد شق","قَ لِماذا لَم تغرقِ الأرجاءُ",24,"ا",2,0],["هوُ بحرُ التوحيدِ فاضَ وكلّ ال","أرض بالشرك بقعةٌ جدباءُ",24,"ا",2,0],["هو بدر الحي وغصن نقا","وغزال السرب وأغيده",25,"د",2,0],["هو بحرٌ الا ان حلا","وصفا للشارب مورده",25,"د",2,0],["هو بالغزل تلهى وأنا","فيه مفتون بصوغ الغزل",26,"ل",1,0],["هو بانٍ يوَدّ تَقويضَ رُكنٍ","شَيَّدَته مَظالِمُ الزُعَماءِ",27,"ا",2,0],["هو بَينَ الملاح يشبه إِسما","عيل بين الأَقيال وَالعظماء",28,"ا",2,0],["هو بالصدق وبالتو","فيق قد نال مراده",29,"د",2,0],["هُوَ بابُ الآمالِ بَل مُنتهى القَص","دِ وَأشهَى المُنى لِقَلبِ الشَجِيِّ",30,"ي",1,0],["هو بهجة الدنيا وَعصمة أَهلها","وَغياثها من كل خطب أَنكد",31,"د",1,0],["هُوَ بَدرُ الدينِ الَّذي بِسطاهُ","ذَلَّ أَهلُ التَثليثِ لِلتَوحيدِ",32,"د",1,0],["هو بحر الحياة سطحٌ وأعما","قٌ وغرقى آمالهم من حطام",33,"م",1,0],["هو بحر تحقيق فإن أظماكم","بحث فقوموا نحوه وردوه",34,"و",2,0],["هوَ بَعضُ الأَنام في روية العَين","وَإِن عُدَّ فاضِل فَهوَ كلُ",35,"ل",1,0],["هوَ بَعض النَبيِّ وَاللَه قَد صا","غَ جَميع النَبيِّ وَالبَعض ظُهرا",36,"ر",2,0],["هو بحرٌ ما له من ساحل","وحُسامٌ لم نقف منه على حد",37,"د",1,0],["هو بَحْرٌ وما يُكَدِّرُهُ الحا","سِدُ أَنْ باتَ فِيه يُلْقِي القَذَاتا",38,"ت",2,0],["هو بيضة الاسلام بل هو حَيَّةُ ال","وادي وقطب جماهر العلماء",39,"ا",2,0],["هو بدرٌ لا يعتريه محاق","فوق جيد يعطو لغصنِ خِلاف",40,"ف",1,0],["هو بحرٌ من عُلومٍ ونَدىً","وهو في الحلم وفي الصَّبْر جَبلْ",41,"ل",1,0],["هو بَحْرٌ من فَضائِلهِ","ومَديحي فيه منْ دُرَرِدْ",42,"ر",2,0],["هو باعث الآمال تعرفهُ الوغى","والدّارعون بقانص الفتّاك",43,"ك",1,0],["هو باقٍ والكُّ فانٍ وإن أع","ياك بالوهم يا جهول الغفول",44,"ل",1,0],["هو بين الأنبياء المصطفى","ولفضلٍ سادة الرسل عياله",45,"ل",2,0],["هو باقٍ في مقامِ الوَصفِ لو","صارَ من آهِ التَّنائي عَدَما",46,"م",2,0],["هو بينَ أَهلِ العصرِ أَكتَمُ واصِلٍ","وبحضْرَةِ الإِقْبالِ خيرُ مُعَظَّمِ",47,"م",1,0],["هو بينَ المُرْسَلينَ المُرْتجى","والإِمامُ المُجْتَبى والمُقْتَدى",48,"د",2,0],["هو بابُ اللهِ صَمْصامُ الوَحا","هو فُرقانُ التَّجَلِّي للهُدَى",48,"د",2,0],["هو باشانَا المُفَدَّى","خيرُ فَردٍ في البَرِيَّهِ",49,"ه",1,0],["هُو بدرُ الجمَالِ يَرنو لبَدرٍ","وغزالٌ مِن خلفِ ظِلِّه يَجري",50,"ر",2,1],["هو بل لا هو عندي","هو في ناء وداني",51,"ن",2,0],["هو باطن حجب الجهول المنكرا","بل ظاهر من نوره بهر الورى",52,"ر",2,0],["هو بالتكبر في الشعا","ر وبالتعاظم في الرداء",53,"ا",2,0],["هُوَ بحرُ العُلُومِ مَن خاضَ فيهِ","ذاقَ ماءَ الفُراتِ واصطادَ دُرّا",54,"ر",2,0],["هُو بغَّاءٌ وعرسه بغَّاءَه","ولها بعد ذا عليهِ الوِلايْه",55,"ا",3,1],["هُو بالصُّدِغ قَدْ تَزمَّل والصد","غُ عَليه بِمسكِه قَدْ تَدَثَّر",56,"ر",1,0],["هو بلسم لجراحنا في خطبنا","ولقلبنا كم فيه من تأساء",57,"ا",2,0],["هو بدرنا الوضاح في آفاقنا","فمتى يلوح البدر وهو تمام",58,"م",1,0],["هُوَ بَحرُ الشَريعَةِ اِبنُ السُنوسي","الَّذي عَنهُ سارَتِ الأَنباءُ",59,"ا",2,0],["هو بالرقاد يبيت مكتحلاً","إذ بالسهاد أبيت مكتحلا",60,"ل",2,0],["هُوَ بِالنَص وَالأَدلة حي ال","دلم الموحش المخوف خلاه",61,"ا",2,0],["هُوَ بَينهم بَدر مُنير قَد بَدا","يَزهو بِنُور عُلومه وَسَناها",62,"ا",3,0],["هُوَ بَين الوَرى أَجلّ إِمام","رَأيه في الأُمور رَأي سَديد",63,"د",1,0],["هُوَ بَحر في كُل علم خِضَمٌّ","مِنهُ يُروى مقرّب وَبَعيد",64,"د",1,0],["هُوَ بَدر لَهُ بِنُور عَليّ","في سَماء السُموّ يَعلو الرِكاب",65,"ب",1,0],["هُوَ بَحرٌ بلاغةً وبَديعاً","مِنهُما تِلكَ الدرُّ وَالمرجانُ",66,"ن",1,0],["هُوَ بَحرُ السّخاءِ كَيفَ وَأَضحى","يَمنَحُ الدُّرَّ وَهوَ غَيرُ ضَنينِ",67,"ن",1,0],["هو بالفِعل عَدوٌّ","وهو بالقَولِ صَديقُ",68,"ق",1,0],["هو باب أضحى يفوق على الأبوا","ابِ أبوابِ قصْرِ ذاتِ العمادِ",69,"د",1,0],["هو بابي وقدْ غدَا ذاتَ موتٍ","مرعِبٍ.. مغلقَاً على مصرَعَيِهِ!",70,"ي",2,0],["هو باق فينا، برغم المماتِ","عنه تحكي آلاؤهُ في الحياةِ",71,"ه",1,1],["هو بحر جود غير أن يمينه","تومي على العافي بدُرٍّ طافحِ",72,"ح",1,0],["هو باللحظ المهنَّى","إِذ غدا مثل المهنَّدْ",73,"د",1,0],["هو بالسماح من الورى","أحرى وبالإحسان أجدر",74,"ر",1,0],["هو بالأحزان مغتبق","هو بالأشجان مصطبحُ",75,"ح",1,0],["هو بغيتي هو منيتي هو راحتي","هو سؤل قلبي حبذا مذكوري",76,"ر",2,0],["هو بينَ الناسِ غضبا","نٌ وفي الخلوةِ راضِ",77,"ض",1,0],["هُوَ بَين الفرع وَالفَرق","قَد أَرانا الرُشد وَالغَيا",78,"ي",2,0],["هو بحر الطافٍ فلا عجبٌ إذا","أهدى بمدح المصطفى درراً غرر",79,"ر",1,0],["هو بدر النهى وهم في علاه","أنجمٌ في مطالع الفضل زُهر",80,"ر",1,0],["هو بدرٌ هوى من السَّبعةِ","الشُّهْبِ فسارتْ بنعشِه الجَوزا