{"poems":[[88,"حي هل يا أخا مصر","https://www.aldiwan.net/poem44435.html","مجزوء الخفيف"],[51,"يا بني طود المعالي طاهر","https://www.aldiwan.net/poem61898.html","الرمل"],[51,"أنجز الوعد إن خير مواعي","https://www.aldiwan.net/poem65788.html","الخفيف"],[51,"ذكر الأخفش القديم فقلنا","https://www.aldiwan.net/poem65885.html","الخفيف"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[91,"لله من عبث القضاء وسخره","https://www.aldiwan.net/poem8730.html","عموديه"],[70,"هات يا صاح غنني","https://www.aldiwan.net/poem42432.html","مجزوء الخفيف"],[70,"يا قضيبا من لجين","https://www.aldiwan.net/poem42676.html","مجزوء الرمل"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[89,"أي قدس يضم هذا البناء","https://www.aldiwan.net/poem44981.html","الخفيف"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[45,"لي حبيب قد لج في الهجر جدا","https://www.aldiwan.net/poem63498.html","الخفيف"],[81,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[102,"لا تسل عن سلامته","https://www.aldiwan.net/poem33066.html","مجزوء الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[109,"واها لموقفنا ببرقة تهمد","https://www.aldiwan.net/poem16187.html","الكامل"],[115,"ما العقد الكربة الدهماء حل","https://www.aldiwan.net/poem42167.html","الرمل"],[128,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[128,"يا حبذا بستان قيس الكامل","https://www.aldiwan.net/poem50535.html","الكامل"],[128,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[182,"رقص الهزار على الغصون الميس","https://www.aldiwan.net/poem67056.html","الكامل"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[210,"لحظ يسبيك مقلده","https://www.aldiwan.net/poem13325.html","المتدارك"],[221,"قطع الدهر حبال الأمل","https://www.aldiwan.net/poem55298.html","الرمل"],[223,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[225,"أطلع الكاس كوكبا في ازدهاء","https://www.aldiwan.net/poem55244.html","الطويل"],[259,"زدت يا بيروت نورا","https://www.aldiwan.net/poem35790.html","مجزوء الرمل"],[259,"هزنا الشوق للمقام السني","https://www.aldiwan.net/poem35969.html","الخفيف"],[271,"خطرت كغصن البانة المتأود","https://www.aldiwan.net/poem52072.html","الكامل"],[282,"ورد الورد سافرا عن خدود","https://www.aldiwan.net/poem32808.html","الخفيف"],[328,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[403,"لا فض من رب القوافي فوه","https://www.aldiwan.net/poem33367.html","الكامل"],[406,"إعترافي بعظم فضلك فضل","https://www.aldiwan.net/poem50135.html","الخفيف"],[406,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[416,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[432,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[441,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[452,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[461,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[461,"مسمهر البأس من مضر","https://www.aldiwan.net/poem15686.html","المديد"],[464,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[500,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[500,"يا حداة العيس مهلا فالحمى","https://www.aldiwan.net/poem37639.html","الرمل"],[500,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[500,"واد أبو البركات يوما يجتلي","https://www.aldiwan.net/poem37789.html","الكامل"],[500,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[538,"في البرايا صاح شهم","https://www.aldiwan.net/poem47434.html","عموديه"],[538,"هو بدر الجمال يرنو لبدر","https://www.aldiwan.net/poem48168.html","عموديه"],[558,"إن في قرع المثاني","https://www.aldiwan.net/poem33780.html","مجزوء الرمل"],[558,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[558,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[562,"طال ميعادنا فخلناه دهرا","https://www.aldiwan.net/poem52935.html","الخفيف"],[575,"هو بغاء وعرسه بغاءه","https://www.aldiwan.net/poem2793.html","الخفيف"],[575,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"]],"verses":[["هو بالفكر مذ سما","كان من نوره العمى",0,"م",2,0],["هو بالشعر أن شدا","يتجلّى لك الهدى",0,"د",2,0],["هوَ بازٌ صائد أرسلتُه","فارجِعوه سالماً إن لم يَصِدْ",1,"د",1,0],["هو بغْلٌ وعدْتَنِيهِ فإن أخْ","لَفْتَ ضاهَتْ أخلاقَهُ أخلاقُك",2,"ك",1,0],["هو بحرٌ مِنَ البحورِ فراتٌ","ليس ملحاً وليس حاشاه ضحلا",3,"ل",2,0],["هو بالدَّل فتاةٌ","وهو بالزي غلامُ",4,"م",1,0],["هُوَ بُلبُلٌ عَبَقُ النُبُوَّةِ في أَغا","نيهِ وَفيها نَكهَةُ الصَهباءِ",5,"ا",2,0],["هُوَ بَدرٌ لِمُجتَلٍ","هُوَ غُصنٌ لِمُجتَني",6,"ي",1,0],["هُوَ بَدرٌ قَد تَجَلّى","نورُهُ في المَشرِقَينِ",7,"ن",1,0],["هو بالروح للذين بمصر","ينشدون استقلال مصر يمد",8,"د",1,0],["هو بِكر في ذي البلاد وللأط","فال فيه حماية عذراء",9,"ا",2,0],["هو بينهم ذاك الكسي","ر وكلهم للكل جابر",10,"ر",1,0],["هُوَ بَحرُ السَماحِ وَالجودِ فَاِزدَد","مِنهُ قُرباً تَزدَد مِنَ الفَقرِ بُعدا",11,"د",2,0],["هُوَ بَينَكُم سِرُّ الهُدى لَكِنَّهُ","لِجَلالِهِ السِرُّ الَّذي لَن يُستَرا",12,"ر",2,0],["هو بالباب واقفُ","والرًّدى منه خائفُ",13,"ف",1,0],["هو بحرٌ أطمُّ لجّاً وأطغى","منك موجاً في جيئةٍ وذهابِ",14,"ب",1,0],["هو بيتٌ يسري على عجلاتِ","سمتَ عينيك سقفهُ المزدان",15,"ن",1,0],["هُوَ بِالْمَتَانَةِ وَالسَّنَى مِرْآةُ مَا","بِكِ مِنْ وَفَاءٍ ثَابِتٍ وَذَكَاءِ",16,"ا",2,0],["هو بين الأنام في جسم عملا","قٍ ولكنَّهُ قصير الرداء",17,"ا",2,0],["هُوَ بَهجة الدُنيا وَفَرقَدَها الَّذي","بِسَناهُ أَرباب البَصائر تَهتَدي",18,"د",2,0],["هو باب اللَه أشكوه المنى","إنما السكون لغير اللَه ذل",19,"ل",1,0],["هو بحرُ المعروفِ والجودِ والفضل","فطوبَى لمن يرُى بفِنائِهْ",20,"ا",3,0],["هو بهجةٌ للناظرينَ وفرحةٌ","وبه التهاني والسرورُ الشاملُ",21,"ل",1,0],["هو بحرُ السخاءِ والجودِ والإحس","ان والفضلِ والهدى والرشادِ",22,"د",1,0],["هُوَ بُطرُسُ الحَبرُ المَعَظَّمُ مَن نَفَى","إِيمانُ بُطرُسَ عَنهُ عَثرَةَ بُطرسِ",23,"س",1,0],["هُوَ بَعدَ اللَهِ العَظيمِ عَظيمٌ","دونَ أَدنى مَقامِهِ العُظَماءُ",24,"ا",2,0],["هوَ بحرٌ ولستُ أدري وقد شق","قَ لِماذا لَم تغرقِ الأرجاءُ",24,"ا",2,0],["هوُ بحرُ التوحيدِ فاضَ وكلّ ال","أرض بالشرك بقعةٌ جدباءُ",24,"ا",2,0],["هو بدر الحي وغصن نقا","وغزال السرب وأغيده",25,"د",2,0],["هو بحرٌ الا ان حلا","وصفا للشارب مورده",25,"د",2,0],["هو بالغزل تلهى وأنا","فيه مفتون بصوغ الغزل",26,"ل",1,0],["هو بانٍ يوَدّ تَقويضَ رُكنٍ","شَيَّدَته مَظالِمُ الزُعَماءِ",27,"ا",2,0],["هو بَينَ الملاح يشبه إِسما","عيل بين الأَقيال وَالعظماء",28,"ا",2,0],["هو بالصدق وبالتو","فيق قد نال مراده",29,"د",2,0],["هُوَ بابُ الآمالِ بَل مُنتهى القَص","دِ وَأشهَى المُنى لِقَلبِ الشَجِيِّ",30,"ي",1,0],["هو بهجة الدنيا وَعصمة أَهلها","وَغياثها من كل خطب أَنكد",31,"د",1,0],["هُوَ بَدرُ الدينِ الَّذي بِسطاهُ","ذَلَّ أَهلُ التَثليثِ لِلتَوحيدِ",32,"د",1,0],["هو بحر الحياة سطحٌ وأعما","قٌ وغرقى آمالهم من حطام",33,"م",1,0],["هو بحر تحقيق فإن أظماكم","بحث فقوموا نحوه وردوه",34,"و",2,0],["هوَ بَعضُ الأَنام في روية العَين","وَإِن عُدَّ فاضِل فَهوَ كلُ",35,"ل",1,0],["هوَ بَعض النَبيِّ وَاللَه قَد صا","غَ جَميع النَبيِّ وَالبَعض ظُهرا",36,"ر",2,0],["هو بحرٌ ما له من ساحل","وحُسامٌ لم نقف منه على حد",37,"د",1,0],["هو بَحْرٌ وما يُكَدِّرُهُ الحا","سِدُ أَنْ باتَ فِيه يُلْقِي القَذَاتا",38,"ت",2,0],["هو بيضة الاسلام بل هو حَيَّةُ ال","وادي وقطب جماهر العلماء",39,"ا",2,0],["هو بدرٌ لا يعتريه محاق","فوق جيد يعطو لغصنِ خِلاف",40,"ف",1,0],["هو بحرٌ من عُلومٍ ونَدىً","وهو في الحلم وفي الصَّبْر جَبلْ",41,"ل",1,0],["هو بَحْرٌ من فَضائِلهِ","ومَديحي فيه منْ دُرَرِدْ",42,"ر",2,0],["هو باعث الآمال تعرفهُ الوغى","والدّارعون بقانص الفتّاك",43,"ك",1,0],["هو باقٍ والكُّ فانٍ وإن أع","ياك بالوهم يا جهول الغفول",44,"ل",1,0],["هو بين الأنبياء المصطفى","ولفضلٍ سادة الرسل عياله",45,"ل",2,0],["هو باقٍ في مقامِ الوَصفِ لو","صارَ من آهِ التَّنائي عَدَما",46,"م",2,0],["هو بينَ أَهلِ العصرِ أَكتَمُ واصِلٍ","وبحضْرَةِ الإِقْبالِ خيرُ مُعَظَّمِ",47,"م",1,0],["هو بينَ المُرْسَلينَ المُرْتجى","والإِمامُ المُجْتَبى والمُقْتَدى",48,"د",2,0],["هو بابُ اللهِ صَمْصامُ الوَحا","هو فُرقانُ التَّجَلِّي للهُدَى",48,"د",2,0],["هو باشانَا المُفَدَّى","خيرُ فَردٍ في البَرِيَّهِ",49,"ه",1,0],["هُو بدرُ الجمَالِ يَرنو لبَدرٍ","وغزالٌ مِن خلفِ ظِلِّه يَجري",50,"ي",1,1],["هو بل لا هو عندي","هو في ناء وداني",51,"ي",1,0],["هو باطن حجب الجهول المنكرا","بل ظاهر من نوره بهر الورى",52,"ر",2,0],["هو بالتكبر في الشعا","ر وبالتعاظم في الرداء",53,"ا",2,0],["هُوَ بحرُ العُلُومِ مَن خاضَ فيهِ","ذاقَ ماءَ الفُراتِ واصطادَ دُرّا",54,"ر",2,0],["هُو بغَّاءٌ وعرسه بغَّاءَه","ولها بعد ذا عليهِ الوِلايْه",55,"ا",3,1],["هُو بالصُّدِغ قَدْ تَزمَّل والصد","غُ عَليه بِمسكِه قَدْ تَدَثَّر",56,"ر",1,0]]}