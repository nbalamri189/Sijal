نضيرا","https://www.poetsgate.com/ViewPoem.aspx?id=161872",""],[5174,"تَفَرَّدَ فِيكِ الضَّادُ","https://www.poetsgate.com/ViewPoem.aspx?id=185486",""],[5185,"الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=71576",""],[5187,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=33005",""],[5216,"مع سيرة الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=187130",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5284,"المُبعدون","https://www.poetsgate.com/ViewPoem.aspx?id=205895",""],[5376,"في الغوطة الغراء دمع نازف","https://www.poetsgate.com/ViewPoem.aspx?id=197288",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5431,"هي لعبة الأقدار حين تُضللُ","https://www.poetsgate.com/ViewPoem.aspx?id=198636",""],[5589,"ما لم يقله الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=187960",""],[5720,"وهو في الغارِ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=199039",""],[5758,"تراتيل الغيم","https://www.poetsgate.com/ViewPoem.aspx?id=207926",""],[5829,"هذي دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=214085",""],[6093,"بان لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=176082",""],[6106,"ما بين الهجرة والهجمة على سيد الخلق صلى الله عليه","https://www.poetsgate.com/ViewPoem.aspx?id=6303",""],[6152,"مسافرُ جسدا","https://www.poetsgate.com/ViewPoem.aspx?id=206454",""],[6177,"مديح الفصيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79433&r=&rc=22",""]],"verses":[["في الغابِ فَوقَ العُشبِ مُضطَجِعاً","في السَفحِ مُستَنِداً إِلى الصَخرِ",0,"ر",1,0],["في الغابِ في الجبلِ البعيدِ عن الورى","حيثُ الطَّبيعَةُ والجمالُ السَّامي",1,"م",2,0],["في الغابِ سِحْرٌ رائعٌ متجدِّدٌ","باقٍ على الأَيَّامِ والأَعوامِ",2,"م",1,0],["في الغابِ في تِلْكَ المخارف والرُّبى","وعلى التِّلاعِ الخُضْر ولآجامِ",2,"م",1,0],["في الغابِ دنيا للخيالِ وللرُّؤى","والشِّعرِ والتفكيرِ والأَحلامِ",2,"م",1,0],["في الغرب حيث كلا الجنسين يشتغل","لا يفضل المرأة المقدامة الرجل",3,"ل",1,1],["في الغرب مغتربا والشرق ملتفت","مشنَّف بحفيظ الدر مسمعه",4,"ع",2,0],["فَيا لَغَريبٍ فاجأَتهُ مَنِيَّةٌ","أَتَتهُ عَلى عَهدِ الشَبابِ تُلَحلِحُ",5,"ح",1,0],["فَيا لُغتي تيهي بجبرٍ عَلى اللُغى","وَيا وَطَني ردِّد بآثاره الصَدى",6,"د",2,0],["في الغدير الصَّافي وأُنشودة الطي","رِ وطيب الورود والياسَمينِ",7,"ن",1,0],["في الغيْثِ شبِهٌ من نَداكَ كأنّما","مسَحَتْ على الأنواءِ منك يَمين",8,"ن",1,0],["في الغيط فاليوم لا ظل ولا ثمرُ","حييت من كاتب أثرى به الأدبُ",9,"ب",1,0],["فِي الغَرْبِ وَالشَّرْقِ لَهُ مَشْهَدٌ","وَمَرْكَبَاهُ البَحْرُ وَالبَرُّ",10,"ر",1,0],["في الغوطتين وفي العراق","وفي مشارق ميسلون",11,"ن",1,0],["فيالغ وحدث عن علو مقامه","فكل علو جاء في مدحه طبقا",12,"ق",2,0],["فيا لغزالٍ في الحشاشة يرتعي","ويرعى ودادي يا رعى الله من يرعى",13,"ع",2,0],["في (الغوطتين) تلقّى لجنَه فلقدْ","واتاه ما لم يكنْ في النوح واتاك",14,"ك",1,0],["في (الغوطتين) إذا ما نسمةٌ خطرتْ","أنَّتْ كما أنَّ محزونٌ إذا جُهدا",15,"د",2,0],["في (الغوطتين) وَفيها منظر عجب","بحرٌ تعوم عليه ذاتُ ألواح",16,"ح",1,0],["في الغرام العُذرِيِّ للصب عُذْرٌ","فلهذا أضحى عَذولي عَذِيري",17,"ر",2,0],["في الغنى عنه صاحبي ومع الحا","جة خصمٌ لا أستطيع جدالَهْ",18,"ل",2,0],["في الغاديات يردنَ الصَّيْدَ ناصبةً","لأنفس الصِّيدِ أشراكاً من الحورِ",19,"ر",1,0],["في الغيب آتيةٌ من ال","آيات بعد الذاهبه",20,"ب",2,0],["في الغاب والغابُ مجازٌ لكمْ","ليثٌ بلا عذر الكرى يُطرِقُ",21,"ق",1,0],["في الغيب نور حقيقيٌّ يجل فلا","يهواه إلا الذي عمن سواه سرى",22,"ر",2,0],["في الغربِ طالعةٌ سحائبُ جيشها","ولها بروقٌ عندَنا ورُعودُ",23,"د",1,0],["في الغار فيما ذكر السكينة","فخصّه بالفضل فيها دونه",24,"ه",1,0],["في الغَزلِ أَصبَحَ وَلَنا بِهِ","مُتَحَرِّكاً قَطَعَ تَيضقُ طُروسُها",25,"س",3,0],["في الغيد إن دام الشباب يداً وإن","أزيل فلا تأمن هناك زوالها",26,"ل",3,0],["في الغيد سيوف لحظه أشهرها","للفتك وقال إنها مسنونه",27,"ه",1,0],["فِي الغَيِّ مَهْوَى سَيْفِكِ الكَهَامِ","أُعْطِيتِ سِلْماً حِينَ لَا سلامِ",28,"م",1,0],["في الغار مولودا بدا وهو القد","يم فأرضعته من حليب مريم",29,"م",1,0],["في الغَربِ أَم في الهِندِ فيما عَلِمتُمُ","أَمِ اليَمَنِ الأَقصى وَما ضَمَّ جِلَّقُ",30,"ق",1,0],["فيالغرام فيك جر على الحشا","جرائر لا انفك منها مدى العمر",31,"ر",1,0],["في الغاشيات يظل موئل يعرب","ولكل حر خيمة ولواء",32,"ا",2,0],["في الغُوطَتين مدافع قَصَفت","هَل كانَ ذاكَ لِحُرمة العُرس",33,"س",1,0],["في الغَربِ والجنوبِ مُدَّةَ عَشرَه","أيَّامِ بِالمُولِمِ المُعتَبَرَه",34,"ه",1,0],["في الغَلَقِ أَو مَوسِمِ الأسفارِ","أَو كلِّ فَصلٍ كانَ لا تُمَارِ",35,"ر",1,0],["في الغَلقِ يَجرُونَ لِذِي الجَزَايِر","مِن مُنفِيَه إنَّ بِهَا المَعَابِر",36,"ر",1,0],["في الغَفر وهوَ أَوَّلُ الميزانِ","في مُدَّةِ الدهورِ والأزمانِ",37,"ن",1,0],["في الغرب كل اللاجئين تخالهم","بين النعيم المستقر ملوكا",38,"ك",2,0],["في الغاية القصوى وأين مطالها","لمن اقتفى حسناته وتكلَّفا",39,"ف",2,0],["في الغم مع صرف ظرفٍ لا لكثرةٍ أو","مكانٍ أو شجرٍ في القلع قل نبظا",40,"ظ",2,0],["فيا لغةً حين الكلام تبسمت","ويا مبسماً زاد الكلام تبسُّما",41,"م",2,0],["في الغي مرسلة العنان كأنها","مرتابة بجزاء تلك الدار",42,"ر",1,0],["في الغصنِ أم عرائسٌ ملتثمه","أم كلماتٌ الغزت في كلمَه",43,"ه",1,0],["في الغار قد نسجت عليه عناكبٌ","والورق عشّش والعدوّ تحيرا",44,"ر",2,0],["فيا لغريب قد قضى ضامي الحشا","ويا لوحيد شط عنه أقاربه",45,"ب",2,0],["في الغرب قدوافي الحسين وجيشه","يدوي له في الشرق رعد صليل",46,"ل",1,0],["فيا لغزال للمعنى بحبه","تقلد من ألحاظه الصارم الهندي",47,"د",2,0],["في الغرب كانوا للجزائر جيرة","بحماهم الإسلام كان محصنا",48,"ن",2,0],["في الغرب أن السعد مذ بغر بهم","عن مقلتي بانت سعود سعادي",49,"د",2,0],["في الغرب حضرته والأرض قاطبة","ثناؤه بالدعاء الدهر موصول",50,"ل",1,0],["في الغيب في الملكوت استقطبت حرما","وأهله برحاب الله في السكن",51,"ن",1,0],["في الغارِ تبتكر الأقدارُ أنْدِيَةً","رُوحِيَّةً حَيثُ شَدَّ الروحُ حَنْجَرَتَكْ",52,"ك",1,0],["في الغاب تحت الظل فوق خميلةٍ","أنفٍ وحول الماء سال طهورا",53,"ر",2,0],["فَيَا لُغَة الفُرقَانِ كَمْ لَكِ حُظْوَةٌ","وَيَا لُغَة الإِعجَازِ كَمْ أَنَا مُغْرَمُ",54,"م",1,0],["في الغاب غاية أهلها ووحوشها","سيان فيه الناس والأنعام",55,"م",1,0],["في الغوطةِ لاقى مصرعهُ","مدحوراً تحتكِ يا شامُ",56,"م",1,0],["في الغارِ كُنتَ مهاجرًا نحوَ العُلا","وبنصرِ ربِّك كُنتَ دومًا واثِقا",57,"ق",2,0],["فِي الْغَارِ تَخْلُو وَتَاهَ الْفِكْرُ فِي لُجَجٍ","وَالنَّفْسُ قَدْ بَحَثَتْ عَنْ حَاذِقٍ فَهِمِ",58,"م",1,0],["فِى الغَارِ تَرْتعِدُ الأضْلاعُ في وَجَلٍ","خَوفًا إِذَا نَظَرُوا فِي مَوْضِعِ القَدَمِ",58,"م",1,0],["في الغربةِ الحمقاءِ يُقلقُ ليلَهم","موجُ اشتياقٍ والحديثُ عِتابُ",59,"ب",1,0],["في الغوطة الغراء دمع نازف","والقلب مرتعد الفرائص خائف",60,"ف",1,1],["في الغارِ وحديَ حيثُ الكلُّ غادرني","وخَلَّفوني وماحنُّوا وماعَطَفوا",61,"ف",3,0],["في الغيب أيدي الله تمسح حزننا","وتقدر الأجواء كيفَ سترسلُ",62,"ل",1,0],["في الغيم أحجية تقول بأننا","من كثرة الأصنام حّرمنا الكلأ",63,"ا",1,0],["في الغارِ يوصي أبا بكرٍ بفائدةٍ :","لا تحزَنَنَّ .. فإنَّ الله ثالثنا",64,"ن",2,1],["فِي الغَيْمِ آياتٌ مِنَ العِطْرِ الّذِي","اشْتَاقَ فانْكَسَرَ الغَمَامُ خَريرَا",65,"ر",2,0],["في الغوطتين ترى الرياض تضوّعت","من ياسمينٍ، ارضها وسماؤها",66,"ا",3,0],["في الغيدِ حسنٌ وحُسنُ العُرْبِ أحسنُهُ","وأحسنُ الحسنِ ما أنتَجْتَ لبنانُ",67,"ن",1,0],["في الغار نصر الله رافق عبده","والوعد وعد الله خير عتاد",68,"د",1,0],["في الغيم ألمحه في العابرات وفي","جو السماء تراءى لي محياه",69,"ا",2,0],["فيا لغتي كم كذبتك فعالهم","وقد مهروا في داهيات المطامع",70,"ع",1,0]]}