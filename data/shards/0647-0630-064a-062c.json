{"poems":[[90,"يا قوم إن العدى قد هاجموا الوطنا","https://www.aldiwan.net/poem44462.html","البسيط"],[90,"لمن تركت فنون العلم والأدب","https://www.aldiwan.net/poem45052.html","البسيط"],[80,"أنا في عذاب من فراقك","https://www.aldiwan.net/poem14026.html","مجزوء الكامل"],[80,"هذي جبال درن","https://www.aldiwan.net/poem14199.html","مجزوء الرجز"],[107,"أدر الحديث وطف على الأقوام","https://www.aldiwan.net/poem42048.html","الكامل"],[48,"يا سيد هل لك في ظبي تغازله","https://www.aldiwan.net/poem23105.html","البسيط"],[108,"هرم يهوى","https://www.poetsgate.com/ViewPoem.aspx?id=179481",""],[98,"طارق بن زياد في طريقه للأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=17510",""],[164,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[201,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[244,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[302,"هد الحمام لآل عبد مناف","https://www.aldiwan.net/poem33214.html","الكامل"],[308,"يقول إذ أبكرته قبلة","https://www.aldiwan.net/poem57993.html","السريع"],[382,"الله قد خلق الإنسان مرتسما","https://www.aldiwan.net/poem59268.html","البسيط"],[409,"قلب المتيم كل يذوده","https://www.aldiwan.net/poem33973.html","مجزوء الكامل"],[435,"أرج الصبابة من ثنائك عارف","https://www.aldiwan.net/poem40081.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138226",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138429",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138409",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109089","الكامل"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216841",""],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101025","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102724","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110315","الكامل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177829","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94148","البسيط"],[2943,"","https://poetry.dctabudhabi.ae/diwan/poem/111338","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204736","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130084","الكامل"],[3628,"","https://poetry.dctabudhabi.ae/diwan/poem/198747","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120200","الكامل"],[4691,"منك الأنوثة تقطر","https://www.poetsgate.com/ViewPoem.aspx?id=61787",""],[4858,"من شعب عمر المختار","https://www.poetsgate.com/ViewPoem.aspx?id=138201",""],[4858,"من وحي أدائي العمرة","https://www.poetsgate.com/ViewPoem.aspx?id=139900",""],[4869,"جهينه","https://www.poetsgate.com/ViewPoem.aspx?id=151641",""],[5074,"هذهِ قِصَّتي","https://www.poetsgate.com/ViewPoem.aspx?id=153510",""],[5092,"إلى الفاتنة","https://www.poetsgate.com/ViewPoem.aspx?id=139721",""],[5111,"هَذِيْ جَزَائِرنَا","https://www.poetsgate.com/ViewPoem.aspx?id=212099",""],[5273,"رسول الضياء","https://www.poetsgate.com/ViewPoem.aspx?id=186928",""],[5411,"كاهنة الأوراس","https://www.poetsgate.com/ViewPoem.aspx?id=191399",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5493,"أنينُ الأُمّة","https://www.poetsgate.com/ViewPoem.aspx?id=196995",""],[5510,"مرايا الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=206318",""],[5595,"هنا وقفنا","https://www.poetsgate.com/ViewPoem.aspx?id=150021",""],[5618,"القدس في عين شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=208919",""],[5621,"صهوة","https://www.poetsgate.com/ViewPoem.aspx?id=24565",""],[5674,"ياأبهى دواويني","https://www.poetsgate.com/ViewPoem.aspx?id=186060",""],[5720,"جمعيةُ التحفيظِ","https://www.poetsgate.com/ViewPoem.aspx?id=199528",""],[5725,"قضي بعرشك ظهر الجان ياسبأُ","https://www.poetsgate.com/ViewPoem.aspx?id=181731",""],[5725,"هذي جراحاتي","https://www.poetsgate.com/ViewPoem.aspx?id=211226",""],[5725,"سكن الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=213046",""],[5823,"عرس الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=15602",""],[5829,"سعير الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=152056",""],[5887,"رُغمَ الجراح الداميات بغزّةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27996",""],[5912,"جزيرة روحي","https://www.poetsgate.com/ViewPoem.aspx?id=205005",""],[5943,"ارحل معمرُ أيها الشِّريرُ","https://www.poetsgate.com/ViewPoem.aspx?id=61846",""],[5956,"الثلاثي المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=193163",""],[6024,"الجد","https://www.poetsgate.com/ViewPoem.aspx?id=186353",""],[6038,"اوسط الحلين","https://www.poetsgate.com/ViewPoem.aspx?id=25691",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[6070,"رسائل الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=189907",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[6262,"الرحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80112&r=&rc=10",""]],"verses":[["هذي جيوش بني التوحيد زاحفة","على العدى وعلى من ضلّ مفتتنا",0,"ن",2,0],["هذي جيوش الردى في الناس زاحفةً","لكنهنّ بلا نقع ولا لجب",1,"ب",1,0],["هَذي جُفوني أَقسَمَت","لا تَلتَقي مالَم تُلاقِكْ",2,"ك",1,0],["هَذي جِبال دَرَن","قَلبي بِها ذو دَرَنِ",3,"ن",1,1],["هَذِي جوانِحُنا وتِلكَ قُلوبُنا","مَلأَى الجوانبِ مِن هَوىً وغَرامِ",4,"م",1,0],["هَذي جِبِلَّةُ سوءٍ غَيرُ صالِحَةٍ","فَهَل سَوى اللَهُ مِن أَجنادِهِ جَبَلَك",5,"ك",1,0],["هذي جراحك عند الصمت مفصحةً","فيهنَّ: ألفُ لسان ناطقٍ، وفم",6,"م",1,0],["هذي جَزِيرةُ إِنْ جَهِلتُم أَمرَها","أَنْتُم بِها رَهْطٌ منَ الغُرَبَاءِ",7,"ا",2,0],["هذى جنان الخلد لا شك أتت","مسافة وهي إليك تترى",8,"ر",2,0],["هذي جرائِمنا وهل أربابُها","يرجونَ بعدُ الصفحَ والغُفرانا",9,"ن",2,0],["هذي جنود الله أنَقذَ بيته","بهم فقد عم الأنام ذهول",10,"ل",1,0],["هذي جموعُ المكرمات بأَسرِها","فصم المنونُ وِفاقَها بِخلافِ",11,"ف",1,0],["هذي جفوني وعذاري فقم","واحلف على المصحف والسيف",12,"ف",1,0],["هذي جهم ملأى من فلاسفةٍ","وخائفوا اللَه لم يَلووا على ضَرَم",13,"م",1,0],["هذي جنايات الغرا","م عليه قد قامت شهوده",14,"د",2,0],["هذي جفونك أم نبالٌ أرسلت","للعاشقين فكل صبٍ خائفُ",15,"ف",1,0],["هذي جوانحه التي لا تنطوي","إلا على سوء أتلك جوانح",16,"ح",1,0],["هذى جلائلك الحسان فانها","مثل اللآلئ زينت جيد الزمن",17,"ن",1,0],["هذي جلائله للعين قد وضحت","وضوح شمس فلم تحتج لاعلان",18,"ن",1,0],["هذي جنود الاعتدا فمتى الهدى","يرمي العِدا بصواعق وزلازلِ",19,"ل",1,0],["هذي جريدتنا إليك وقد وعت","نبذاً تسامى قصدها وفصولا",20,"ل",2,1],["هذي جِزيرَة صيد سِمكان","لَكِنّها مُوضَع سلاطين",21,"ن",1,0],["هذي جنود الإنجليز رأيتها","بالبدرشين تقتل الأطفالا",22,"ل",2,0],["هذي جدودٌ للمُلثّمِ بالمَدد","حامي الزمامِ ومنجدِ العيّان",23,"ن",1,0],["هذي جيوشك قد فتح","ت بها القلوب بلا وقائع",24,"ع",1,0],["هذي جنان الخلد تحت سيوفكم","وبها إليكم لوعة وهيام",25,"م",1,0],["هذي جمالته قالت مؤرخة","يزهو بهذا الحمى نور ابن عباس",26,"س",1,0],["هذي جسومهم تناهبها الظبا","قد كفنتها شمأل وجنوب",27,"ب",1,0],["هذي جنودك قد صفت محافظة","عليك من وخز عشاق كأشواك",28,"ك",1,0],["هذي جُموعهمُ تدلُّ صراحةً","أنَّ التي يبكون أفضل مَن خَطَر",29,"ر",1,0],["هذي جنان الله أنت نزيلها","فامض إلى حيث المقام السامي",30,"م",2,0],["هذي جنود الله عندك فاهدها","للحرب تنصر دينه المشكورا",31,"ر",2,0],["هذي جنود هواك في","قلبي الرحيبِ تعسكرُ",32,"ر",1,0],["هذي جرائمك الّتي طُوّقتَها","ستكون ويلاً يحطم الكُبَراء",33,"ا",2,0],["هذي جموعُ المسلمين تتابعت","لتطوفَ حولَ البيت وهيَ تُوَحّد",34,"د",1,0],["هذي جهينه والمواقف تجمل","ماض الزمن لو هو نطق لك ذكرها",35,"ر",3,0],["هذي جهينه لأعذب الطيب منهل","ومنها اليقين اللي يجيبه خبرها",35,"ر",3,0],["هَذِيْ جِرَاحَاتِيْ الَّتِيْ أَدْمَيْتَهَا","يَا أيُّهَا القَدَرُ المُذِلُّ المُفْجِعُ",36,"ع",1,0],["هذي جراحي تصطفيكِ طبيبةً","تبقينَ دائي في الهوى ودوائيهْ",37,"ي",2,0],["هَذِيْ جَزَائِرنَا يَا أيُّها النَّاسُ","مِنْ سِحْرِهَا أشْرَقَ الإبْدَاعُ وَالْمَاسُ",38,"س",1,1],["هذي جَهَنَّمُكَ التي قَدْ بُرِّزَتْ","أ وَمَا أتاكَ مِنَ الضّياءِ رَسُولُ؟",39,"ل",1,0],["هذي جُيوشي مِنَ الطَّاعون قَدْ نَفَقَتْ","وَاهْتَزَّ عَرْشي وَذا آخيل قَدْ ذُبِحا",40,"ح",2,0],["هَذِي جُنُودُ الكُفْر تَرْفَعُ صَوْتَها","تُؤذي الحبيبَ وتزدريهِ رَسُولا",41,"ل",2,0],["هَذِي جُسُورِي بِوَجْهِ الأرْضِ قَدْ كُسِرَتْ","فَكَيْفَ يَصْلُبُ ظَهْرٌ بَعدَمَا كُسِرَا؟!",42,"ر",2,0],["هذي جراحي على همٍّ تغازلني","فهل دريت بأنّ الصدر بي حطبُ",43,"ب",1,0],["هذي جراحاتنا ثكلى في منابتها","تضجُّ حيرى بدارٍ نَصْلُها الفِتنُ",44,"ن",1,0],["هذي جِراحي وهذا الشَوْقُ يَعْزِفُني","بمسْرحِ الْحُزْنِ غَصّاتٍ أُعانيها",45,"ي",3,0],["هذي جراحي تَئِنُّ داميةً","لها على القدسِ غَصَّةُ الشَّرِقِ",46,"ق",1,0],["هذي جراحي ضنىً بالروح نازفة","ما طاب جرح سواهُ ظل يدميني",47,"ن",2,0],["هذي جهودُ المخلصين تبلورتْ","وتعددتْ .. وبخيرها .. تتكاثرُ",48,"ر",1,0],["هذي جمالي قضاها السير من عطش","انى ودجلة نبع منك ينكفأُ",49,"ا",1,0],["هذي جراحي ما شكمت رعافها","جائتك نزفا لو تعزّ زفافها",50,"ف",3,1],["هذي جراحاتي العتيقة دثّرتْ","جرحاً قديماً بالسرائر غائلا",51,"ل",2,0],["هذي جموع الحق تشهد أنهم","غرسوا الخلود ، وصدرهم بركان",52,"ن",1,0],["هذي جدائلها حُلّت على عجلٍ","حتى تلوّن من سودائها السحر",53,"ر",1,0],["هذي جيوشُ الروس جرَّت عارها","خسأت جيوش الكفر والطغيان",54,"ن",1,0],["هذي جزيرةُ روحي قدْ غدت حلمي","متى رسا قاربُ الأحبابِ نحتفلُ",55,"ل",1,0],["هذي جسوم العاشقينَ بلادهم","أفلا تراها بالدماء تثورُ؟",56,"ر",1,0],["هذي جميع مطامحي في عيشتي:","فوز البنين بنهضةٍ ونعيمِ",57,"م",1,0],["هذي جيوش الخصم عدوا أقبلت","بمدافع من ذا لهن يقابل",58,"ل",1,0],["هذي جزات من يعشق الزين","يدري حياته ما تسوى بلاها",59,"ا",3,0],["هذي جريمتهم على لحمي المُمزّ","ق ِماله أبداً سبيل ُشفاء ِ",60,"ا",2,0],["هذي جراحي كما النيرانُ في كبدي","قَدْ أضرمَتْ خافقي في كلِّ أوضاعي",61,"ع",2,0],["هذي جيوش الهدى تدوي مجلجلة","تهتز مرعوبة منها أعادينا",62,"ن",2,0],["هذي جراحي سأغفو إنَّها وطني","هذي دمايَ رمادٌ في نهاياتي",63,"ت",2,0]]}