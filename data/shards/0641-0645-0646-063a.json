0,"","https://poetry.dctabudhabi.ae/diwan/poem/133123","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57992","الوافر"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140139",""],[5057,"بلا راعٍ .","https://www.poetsgate.com/ViewPoem.aspx?id=184021",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5351,"يمانيون يا طه تنادت","https://www.poetsgate.com/ViewPoem.aspx?id=202647",""],[5411,"(مَدَد)","https://www.poetsgate.com/ViewPoem.aspx?id=186138",""],[5628,"غيرة العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=179895",""],[5736,"امتثال","https://www.poetsgate.com/ViewPoem.aspx?id=213791",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6134,"ماذا حملتم على الايدي بلا حذر","https://www.poetsgate.com/ViewPoem.aspx?id=169551",""],[5309,"قفا نحمد الأيام ان كان يحمد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573526",""],[6346,"غزة والحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83386&r=&rc=2",""]],"verses":[["فَمَن غَيرُهُ لِليَعمَلاتِ يُقيمُها","إِذا وَقَعَت مَثنِيَّةً رُكُباتُها",0,"ت",3,0],["فَمِن غُلبٍ كَأَنَّهُمُ أُسودٌ","عَلى قُبٍّ ضَوامِرَ كَالظِباءِ",1,"ا",2,0],["فَمِن غَطارِفَةٍ في جِلَّقٍ نُجُبٍ","وَمِن غَطارِفَةٍ في أَرضِ حَورانِ",2,"ن",1,0],["فَمِن غُصونٍ تَميسُ تيهاً","وَمِن زُهورٍ تَضَوَّعُ طيبا",3,"ب",2,0],["فَمِن غادَةٍ في مَجالي الزِفافِ","إِلى غادَةٍ داؤُها مُعضِلُ",4,"ل",1,0],["فَمَن غابَ يَنوي نِيَّةً عَن حَبيبِهِ","وَهَجراً فَإِنّي غِبتُ عَنكَ لِأَشهَدا",5,"د",2,0],["فمن غيركم ترجى لديه انتباهة","لحظ يهب النائمون وما هبا",6,"ب",2,0],["فمن غنيّ بخفض العيش في دعة","ومن فقير بزجيّه ببلغتِه",7,"ت",2,0],["فمن غور قلبي هاكها عسكريّة","مجنّحة والشاعر الحرّ أهديه",8,"ي",2,0],["فمن غزلٍ كأنَّ السحرَ فيهِ","ومن عتبٍ كعافيةِ السقيمِ",9,"م",1,0],["فمن غيرِ ما سهدٍ أرى النَّومَ مُتعباً","ومن غيرِ ما حبٍّ أرى العيشَ خاليا",10,"ل",3,0],["فَمِنْ غِبِّ رَأْيٍ لا تُساءُ بِوِرْدِهِ","وَمِنْ وِرْدِ جُودٍ لا تُسَرُّ بِغِبِّهِ",11,"ب",2,0],["فمِن غلاء الشَّعيرِ عندي ورُخْ","صِ الشِّعْرِ أَضحَى ذا أَرسُمٍ دُرُس",12,"س",1,0],["فمن غزلٍ يروق لديك مني","ومن نغم يَلَذُّ وشرب كأس",13,"س",1,0],["فمن غربٍ الى غربٍ","وقد خابتْ مَساعينا",14,"ن",2,0],["فَمَنْ غَدَا مُرَجِّحا","لِسِرِّها مُصَحِّحا",15,"ح",2,0],["فمن غاب عن جانبي أو نأى","سيتبعه من دنا أو حضرْ",16,"ر",1,0],["فمن غمزات ألحاظ وكف","ومن ضم إلى قبل لطاف",17,"ف",1,0],["فمن غيرُها عوناً إذا الدهر ساقه","إلى مَنهج للناجيات خَدوعُ",18,"ع",1,0],["فَمَنْ غَرَّهُمْ أنَّ الدَّوَاهِي تَفُوقُهُمْ","إذا أوْقَدوا بالليل نَارَ الحُبَاحِبِ",19,"ب",1,0],["فمن غانيات يهنئننا","ومن خادمات ومن أعبد",20,"د",1,0],["فَمَن غيرُنا في المولَعين بحبِّكُم","تُقامُ له الراياتُ في الشَرقِ وَالغَربِ",21,"ب",1,0],["فمن غصب الإمارة إذ حواها","فما تحوى الوزارة بالغصوب",22,"ب",1,0],["فمن غَرس الرجا في قلب حُرٍ","أصابَ جَنى النجا غِبّ الحصاد",23,"د",1,0],["فَمن غدا في الهَوى راحَت عزيمته","وفاته من حَياة الخلد أَهناها",24,"ا",3,0],["فمن غير ديدالوس يخفي شنارها","ويرعى مهاد الطفل رعي المؤدبِ",25,"ب",1,0],["فمن غش ذا إسلام ليس بمسلمٍ","ألا فاحذروا الأثام قاصي ودانيا",26,"ي",2,0],["فمن غلبتْه شهوتُه","فشرٌّ من بهيمتِه",27,"ت",2,0],["فمن غربة تقصي وبين أحبة","تروح عني الهم أية ترويح",28,"ح",1,0],["فمن غالى بحبِّ علي","تولّاهُ الزعيم علي .",29,"ل",2,0],["فمن غدى منهمو بالسيف منتدبا","فإنما ذاك للشيطان قد كانا",30,"ن",2,0],["فَمَنْ غير اليمانيين جاءوا","بهذا اليوم يطوون البطاحا؟",31,"ح",2,0],["فَمَنْ غَيْر رَبِّيَ يَرْفَعُ ضُرِّي","وَيَعْفُو وَيَقْبَلُ مِنِّي اعْتِذارا",32,"ر",2,0],["فَمَنْ غيرُ عينيكِ يا حلْوتي","وّمّنْ غيرُ طلعتُك ِ المشرقه ْ",33,"ق",2,0],["فمن غير المؤكد أن أجافي","وفكرةُ أن أحيدَ، أقول لا .. لا",34,"ل",2,0],["فمن غيرة الرحمن جل جلاله","على حبه أن لم يكله لشدتي",35,"ت",2,0],["فمن غدا صابراً في الخطب محتسبا","ينال اكليل مجد العز والظفر",36,"ر",1,0],["فَمَن غَيرُكُم أَولى بِوُدِّ بِلادِنا","وَمَن غَيرُكُم أَهدى إِذا راحَ يُرشِدُ",37,"د",1,0],["فَمِنْ غَاصِبٍ مُسْتَبِدٍّ وَمِنْ","عَمِيلٍ بِحُضْنِ العَدُوِّ ارْتَمَى",38,"م",2,0]]}