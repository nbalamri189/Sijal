{"poems":[[10,"ألا ما لعينك أم ما لها","https://www.aldiwan.net/poem21129.html","المتقارب"],[30,"خليلي عوجا عوجة ثم سلما","https://www.aldiwan.net/poem29536.html","الطويل"],[80,"نحن في جنة نباكر منها","https://www.aldiwan.net/poem31497.html","الخفيف"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[69,"نارنجة في غصنها","https://www.aldiwan.net/poem28756.html","مجزوء الرجز"],[52,"أسقياني واعملا طربا","https://www.aldiwan.net/poem27246.html","المديد"],[50,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[50,"يا لقوم للزائر المنتاب","https://www.aldiwan.net/poem64812.html","الكامل"],[50,"أعاذل لا أنام على اقتسار","https://www.poetsgate.com/ViewPoem.aspx?id=22668",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""]],"verses":[["كَكِرفِئَةِ الغَيثِ ذاتِ الصَبيرِ","تَرمي السَحابَ وَيُرمى لَها",0,"ل",3,0],["كَكُدرِيَّةٍ أَوحَت لِوِردٍ مُباكِرٍ","كَلاماً أَجابَت داجِناً قَد تَعَلَّما",1,"م",2,0],["كَكُراتٍ مُحْمَرّةٍ من عَقيقٍ","تَدَّريها صوالِجٌ من زَبَرجَد",2,"د",1,0],["ككناسٍ بَغَمَتْ غزلانُهُ","من زئيرٍ راعها مِنْ أُسْدِ غاب",3,"ب",1,0],["ككرةٍ منْ ذهبٍ","جوكانها زبرجدُ",4,"د",1,0],["كَكُميتِ اللَونِ قَلَّدَها","فارِسٌ مِن لُؤلُؤٍ لَبَبا",5,"ب",2,0],["كَكَعبٍ أَو كَبِسطامِ بنِ قَيسٍ","أُصيبا ثُمَّ ما دَنِسا بِعارِ",6,"ر",1,0],["كَكُعوبِ القَناةِ مُشتَبِهاتٍ","وَكَأَنَّ الرَبابَ أُمُّ الكِتابِ",7,"ب",1,0],["ككعبٍ أن كبسطام بن قيس","أصيبا ثم ما دنسا بعار",8,"ر",1,0],["ككتابٍ كشَّفت عن صفحتيهِ","ثم غطيَّت عَنوةً عُنوانه",9,"ن",2,0]]}