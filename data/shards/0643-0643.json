{"poems":[[10,"ألا ما لعينك أم ما لها","https://www.aldiwan.net/poem21129.html","المتقارب"],[32,"خليلي عوجا عوجة ثم سلما","https://www.aldiwan.net/poem29536.html","الطويل"],[82,"نحن في جنة نباكر منها","https://www.aldiwan.net/poem31497.html","الخفيف"],[82,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[71,"نارنجة في غصنها","https://www.aldiwan.net/poem28756.html","مجزوء الرجز"],[54,"أسقياني واعملا طربا","https://www.aldiwan.net/poem27246.html","المديد"],[52,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[52,"يا لقوم للزائر المنتاب","https://www.aldiwan.net/poem64812.html","الكامل"],[52,"أعاذل لا أنام على اقتسار","https://www.poetsgate.com/ViewPoem.aspx?id=22668",""],[92,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[197,"أما ترى الزهرة قد لاحت لنا","https://www.aldiwan.net/poem12825.html","الرجز"],[226,"قائم فوق شاطىء النهر","https://www.aldiwan.net/poem55276.html","المنسرح"],[409,"يا ساري الريح ساعدني على وطري","https://www.aldiwan.net/poem33913.html","البسيط"],[534,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[580,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44624","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59090","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16733","المتقارب"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31638","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89013","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62992","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46012","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111448","الوافر"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90870","الرمل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45055","الكامل"],[4733,"أنا","https://www.poetsgate.com/ViewPoem.aspx?id=197875",""],[4737,"التنوير","https://www.poetsgate.com/ViewPoem.aspx?id=212156",""],[4852,"رضاب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=214270",""],[4862,"مربوطةً بسلسلة","https://www.poetsgate.com/ViewPoem.aspx?id=55634",""],[5277,"بعْني شذاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=206050",""],[5438,"تَكْوِينٌ لِذَاتِي","https://www.poetsgate.com/ViewPoem.aspx?id=202094",""],[5644,"ككل المآسي ..ستمضي","https://www.poetsgate.com/ViewPoem.aspx?id=201847",""],[5943,"حزينٌ حائرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34680",""],[6056,"الأ لفية ))(( المنبثقة","https://www.poetsgate.com/ViewPoem.aspx?id=130517",""]],"verses":[["كَكِرفِئَةِ الغَيثِ ذاتِ الصَبيرِ","تَرمي السَحابَ وَيُرمى لَها",0,"ل",3,0],["كَكُدرِيَّةٍ أَوحَت لِوِردٍ مُباكِرٍ","كَلاماً أَجابَت داجِناً قَد تَعَلَّما",1,"م",2,0],["كَكُراتٍ مُحْمَرّةٍ من عَقيقٍ","تَدَّريها صوالِجٌ من زَبَرجَد",2,"د",1,0],["ككناسٍ بَغَمَتْ غزلانُهُ","من زئيرٍ راعها مِنْ أُسْدِ غاب",3,"ب",1,0],["ككرةٍ منْ ذهبٍ","جوكانها زبرجدُ",4,"د",1,0],["كَكُميتِ اللَونِ قَلَّدَها","فارِسٌ مِن لُؤلُؤٍ لَبَبا",5,"ب",2,0],["كَكَعبٍ أَو كَبِسطامِ بنِ قَيسٍ","أُصيبا ثُمَّ ما دَنِسا بِعارِ",6,"ر",1,0],["كَكُعوبِ القَناةِ مُشتَبِهاتٍ","وَكَأَنَّ الرَبابَ أُمُّ الكِتابِ",7,"ب",1,0],["ككعبٍ أن كبسطام بن قيس","أصيبا ثم ما دنسا بعار",8,"ر",1,0],["ككتابٍ كشَّفت عن صفحتيهِ","ثم غطيَّت عَنوةً عُنوانه",9,"ن",2,0],["ككوكبٍ قَد حلَّ برجَ سعدِ","حتَّى اِستَقلَّ في جبينِ الماجدِ",10,"د",1,0],["كَكُرَةٍ مِن فِضّةٍ مَجلوَّةٍ","أَوفى عَلَيها صَولَجانٌ مِن ذَهَب",11,"ب",1,0],["ككتلة من دجى إذا اعتكر","الليل وكالعهن في ضيا البدر",12,"ر",1,0],["ككتبه سلوة للقلب فارجة","للكرب دافعة للهم والضجر",13,"ر",1,0],["ككَمَالِ مَنْ حازَ الْعُلَى","والحقَّ كُلّ الْمَجْدِ أَوْفَى",14,"ف",2,0],["كك يدٍ مستطيلةِ منه بالجُو","دِ لديها يدُ الغَمَامةِ شَلاَّ",15,"ل",2,0],["كَكَلبِ الصَيدِ يُمسِكُ وَهوَ طاوٍ","فَريسَتَهُ لِيَأكُلَها سِواهُ",16,"ه",1,0],["كَكُوبِ دُرّ تَغَشَّاهُ النُّضَارُ عَلَى","قُضْبِ الزبرجد يُبْدِي لحظَ شَهْلاَءِ",17,"ا",2,0],["كَكيسانَ يَكتُبُ غَيرَ الَّذي","يَقولُ المُحَدِّثُ وَالمُكتِبُ",18,"ب",1,0],["ككهيعص السُّورَهْ","فكَمْ مَعَانٍ تَحْتَهَا مَسْتُورهْ",19,"ه",1,0],["كَكَأْسٍ مِنْ عَقيقٍ فيهِ مِسْكٌ","وهَذا الحَقُّ أُيِّدَ بِالبَيانِ",20,"ن",1,0],["ككف ثان أو كخبن ثالث","يصير قبضا في البديء الحادث",21,"ث",1,0],["كَكَبير قَومٍ جَاءَ يَشهَدُ عِندَ ذِي","حُكمٍ يُريدُ دِفَاعَهُ بِلِيَانِ",22,"ن",1,0],["ككوكب يسير في سماءٍ","أو كعروس الكنز في الفرات",23,"ت",1,1],["ككواسرِ العُقبانِ طِرْ","نَ اليكَ بالاسدِ الضَّوارِي",24,"ر",2,0],["كَكاَنَ ظَلَّ بَاتَ أضحَى أصبَحَا","أمسَى وَصَارَ لَيسَ زَالَ بَرِحَا",25,"ح",2,0],["كَكانَ كادَ وَعَسَى لَكن نَدَر","غَيرُ مُضَارِعٍ لِهَذَينِ خَبَر",25,"ر",1,0],["كَكَم كأيِّن وَكَذَا وَيَنتَصِب","تَميِيزُ ذَينٍ أو بِهِ صِل مِن تُصِب",25,"ب",1,0],["كَكَتيبَة زِنجِيَّة مَلمومَةٍ","في قُبطُرِيٍّ ناصِعٍ مَسرودِ",26,"د",1,0],["ككوكبة الخريف إذا","بديجور الدجى ظهرت",27,"ت",1,0],["كَكوكَبِ الهَولِ الذي يَستَتَرُ","في الغَيمِ حيناً ثُمَّ حيناً يَظهَرُ",28,"ر",1,0],["كَكَوكَبَةِ الخَرِيفِ قَدِ استَحَمَّت","بِلُجِّ البَحرِ وَامتَطَتِ الرَّقِيعا",29,"ع",2,0],["كَكَونِهِ جِرماً لَهُ تَحَيُّزُ","أو عَرضاً لَهُ بهِ التَميزُ",30,"ز",1,0],["ككليم اللَه إلا أنه","لم يؤانس نور نار فوق طور",31,"ر",1,0],["كَكَبيرَةٍ بِنت الوَزيرِ","المُصطَفى الصافي السَريرَه",32,"ر",2,0],["ككلِّ النَّاس عُسرٌ يَعتريني","وزادي إنَّ بعدَ العُسرِ يُسرا",33,"ر",2,0],["ككلبِ الصَّيدِ نجعلُهُ مُطيعاً","ونطلقُهُ وراءَ مُخالفينا",34,"ن",2,0],["ككفٍ لَفَّ كفّاً حيث يأوي","يَمَامٌ في ظلامِي كادَ يَشْقَى",35,"ق",2,0],["ككلبةٍ مسعورةٍ","مربوطة بسلسلة",36,"ل",2,0],["ككلِّ وجهٍ تذوقُ الليلَ دهشتُهُ","لكنّهُ ليسَ وجهي ذاكَ بلْ حُرَقي",37,"ق",2,0],["كَكَعْبِ ''أَخِيلٍ'' أَسْقُطُ اليَوْمَ مُنْهَكًا","وَ فِي العَدَمِ الصُّوفِيِّ أَبْكِي لِأَفْرَحَا",38,"ح",2,0],["ككل المآسي وكل الخطوب","ستمضي وتترك بعض الندوبْ",39,"ب",1,1],["ككلِّ الناسِ من لحمٍ وعظمٍ","وغيرِ الناسِ في فكرٍ أشمِّ",40,"م",1,0],["ك / كفى كيفي وكيّفني بكيفه كيف كيّفناه","وكيّفته كفا ًيكفي وكف وكتف يكفيّني",41,"ن",2,0]]}