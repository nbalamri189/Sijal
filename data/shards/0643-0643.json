{"poems":[[10,"ألا ما لعينك أم ما لها","https://www.aldiwan.net/poem21129.html","المتقارب"],[30,"خليلي عوجا عوجة ثم سلما","https://www.aldiwan.net/poem29536.html","الطويل"],[80,"نحن في جنة نباكر منها","https://www.aldiwan.net/poem31497.html","الخفيف"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[69,"نارنجة في غصنها","https://www.aldiwan.net/poem28756.html","مجزوء الرجز"],[52,"أسقياني واعملا طربا","https://www.aldiwan.net/poem27246.html","المديد"],[50,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[50,"يا لقوم للزائر المنتاب","https://www.aldiwan.net/poem64812.html","الكامل"],[50,"أعاذل لا أنام على اقتسار","https://www.poetsgate.com/ViewPoem.aspx?id=22668",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[189,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[193,"أما ترى الزهرة قد لاحت لنا","https://www.aldiwan.net/poem12825.html","الرجز"],[221,"قائم فوق شاطىء النهر","https://www.aldiwan.net/poem55276.html","المنسرح"],[403,"يا ساري الريح ساعدني على وطري","https://www.aldiwan.net/poem33913.html","البسيط"],[529,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[575,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"]],"verses":[["كَكِرفِئَةِ الغَيثِ ذاتِ الصَبيرِ","تَرمي السَحابَ وَيُرمى لَها",0,"ل",3,0],["كَكُدرِيَّةٍ أَوحَت لِوِردٍ مُباكِرٍ","كَلاماً أَجابَت داجِناً قَد تَعَلَّما",1,"م",2,0],["كَكُراتٍ مُحْمَرّةٍ من عَقيقٍ","تَدَّريها صوالِجٌ من زَبَرجَد",2,"د",1,0],["ككناسٍ بَغَمَتْ غزلانُهُ","من زئيرٍ راعها مِنْ أُسْدِ غاب",3,"ب",1,0],["ككرةٍ منْ ذهبٍ","جوكانها زبرجدُ",4,"د",1,0],["كَكُميتِ اللَونِ قَلَّدَها","فارِسٌ مِن لُؤلُؤٍ لَبَبا",5,"ب",2,0],["كَكَعبٍ أَو كَبِسطامِ بنِ قَيسٍ","أُصيبا ثُمَّ ما دَنِسا بِعارِ",6,"ر",1,0],["كَكُعوبِ القَناةِ مُشتَبِهاتٍ","وَكَأَنَّ الرَبابَ أُمُّ الكِتابِ",7,"ب",1,0],["ككعبٍ أن كبسطام بن قيس","أصيبا ثم ما دنسا بعار",8,"ر",1,0],["ككتابٍ كشَّفت عن صفحتيهِ","ثم غطيَّت عَنوةً عُنوانه",9,"ن",2,0],["ككوكبٍ قَد حلَّ برجَ سعدِ","حتَّى اِستَقلَّ في جبينِ الماجدِ",10,"د",1,0],["كَكُرَةٍ مِن فِضّةٍ مَجلوَّةٍ","أَوفى عَلَيها صَولَجانٌ مِن ذَهَب",11,"ب",1,0],["ككتلة من دجى إذا اعتكر","الليل وكالعهن في ضيا البدر",12,"ر",1,0],["ككتبه سلوة للقلب فارجة","للكرب دافعة للهم والضجر",13,"ر",1,0],["ككَمَالِ مَنْ حازَ الْعُلَى","والحقَّ كُلّ الْمَجْدِ أَوْفَى",14,"ف",2,0],["كك يدٍ مستطيلةِ منه بالجُو","دِ لديها يدُ الغَمَامةِ شَلاَّ",15,"ل",2,0]]}