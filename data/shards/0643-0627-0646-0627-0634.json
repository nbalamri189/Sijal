{"poems":[[102,"وحدي هنا","https://www.aldiwan.net/poem24837.html","عموديه"],[95,"قوامك لا يعادله قوام","https://www.aldiwan.net/poem11346.html","الوافر"],[53,"شرب البيهقي والبين ناء","https://www.aldiwan.net/poem9232.html","الخفيف"],[87,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[520,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64238","البسيط"],[1603,"","https://poetry.dctabudhabi.ae/diwan/poem/117121","المتقارب"],[1785,"","https://poetry.dctabudhabi.ae/diwan/poem/198827","المنسرح"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89523","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21461","الطويل"],[3239,"","https://poetry.dctabudhabi.ae/diwan/poem/145264","المنسرح"],[3465,"","https://poetry.dctabudhabi.ae/diwan/poem/116605","البسيط"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101216","الوافر"],[3631,"","https://poetry.dctabudhabi.ae/diwan/poem/144739","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66428","المجتث"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32638","السريع"],[4306,"","https://poetry.dctabudhabi.ae/diwan/poem/121962","المنسرح"],[4749,"أقوال شعري بها أتعثر","https://www.poetsgate.com/ViewPoem.aspx?id=155993",""],[520,"فما استنشقت ريح الصباح خياشم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577633",""]],"verses":[["كأنّ أشباح الدجا","حولي أماني مستبدّ",0,"د",1,0],["كَأَنَّا شُعْلَتَانِ إِذَا اعْتَنَقْنَا","عَلَى ظَمَاءِ فَلَمْ يُرْوَ الأَوَامُ",1,"م",1,0],["كان أشقى الأنامِ فانبعث الحَا","ئنُ يا شُؤمَهُ عليه انبعاثا",2,"ث",2,0],["كأن اشباحه والليل ياخذها","سرائر الأرض تبديها وتخفيها",3,"ي",3,0],["كأنَّ أشواقيَ أشواقُها","أو أنها صاحبةُ الموعدِ",4,"د",1,0],["كانَ اِشتِفائيَ في دَمعي وَفي نَفسي","حَتّى اِفتَضَحتُ بِذا الجاري وَذا الطامي",5,"م",2,0],["كان أشهى للنفسِ من حَسْوَة الكأ","سِ وأحلَى من صادحاتِ الأغاني",6,"ن",2,0],["كأنا شواظا في الجوانح ساطعا","اذا قلت قد خف التوقد يحجم",7,"م",1,0],["كأن اشتعال الرزق في ليل نقعه","كواكب في قطع من الليل فاحم",8,"م",1,0],["كأنَّ أَشجارَهُ قد أُلبستْ حُللاً","خضراً وقد كُلِّلَتْ دراً ومرجانا",9,"ن",2,1],["كأَنَّا شَمَامِيُس في بيعَةٍ","تُقَسِّسُ في بَعْضِ عِيداتِها",10,"ت",3,1],["كأن أشجارها وقد كسيت","بدائعها من حليها المعجبْ",11,"ب",1,0],["كَأَنَّ اِشتِعالَ البيضِ في جَنَباتِهِ","سَنا البَرقَ وَالرَعدَ الهَماهِمُ وَالزَجرُ",12,"ر",1,0],["كَأَنَّ اشتِعالَ البَرق في حجَراتِهِ","ضِرامٌ شَرى في أَيكَةٍ يَتَشَيَّعُ",13,"ع",1,0],["كأن اشجارها مكارمه","تؤتي ثمار النهى وتجنيها",14,"ي",3,0],["كأنَّ أشكالَ وجهِ الحزمِ بينهما","ظلٌّ تلاقى عليه الشمسُ والقمرُ",15,"ر",1,1],["كأن أشعة الأنوار فيها","شموس وهي تسطع في المساء",16,"ا",2,0],["كان أَشْهى إِليَ قُرْب جِوَارٍ","مِنْ نصارى في دورها الأَصنامُ",17,"م",1,0],["كأَنَّ أشعب يقفو","آثارهم في اتباعِ",18,"ع",1,0],["كَأَنَّ إِشفاقي عَلَيهِ إِذا","غَدَوا إِشفاقي عَلى عِرضي",19,"ض",2,0],["كَأَنَّ أَشجارَهُ وقد نُشِرَتْ","ظِلالُ أَوراقهِ على ثَمَرِه",20,"ر",2,0],["كان اشتياقيَ ناراً أثارت","بقلبي براكينَ شوقٍ تفجرْ",21,"ر",1,0],["كأن اشتعال الزرق في ليل نقعه","كواكب في قطع من الليل فاحم",22,"م",1,0]]}