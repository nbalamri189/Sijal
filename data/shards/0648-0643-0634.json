"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83460","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66131","الطويل"],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31264","الكامل"],[4755,"هُطُول","https://www.poetsgate.com/ViewPoem.aspx?id=184806",""],[4762,"يا ليت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=212916",""],[4767,"النهج الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=179919",""],[4942,"ولد الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=188837",""],[4984,"افْتَحْ من العهد القديم ..","https://www.poetsgate.com/ViewPoem.aspx?id=191325",""],[585,"حياك منهمرُ الغوادي الجون","https://www.poetsgate.com/ViewPoem.aspx?id=161937",""],[5102,"لا تطلبي","https://www.poetsgate.com/ViewPoem.aspx?id=12887",""],[5365,"ياشام","https://www.poetsgate.com/ViewPoem.aspx?id=190818",""],[5409,"فنُّ البيان رثاك قبل لساني","https://www.poetsgate.com/ViewPoem.aspx?id=155483",""],[5431,"قصيدة وجودية ...","https://www.poetsgate.com/ViewPoem.aspx?id=207830",""],[243,"وحي النيروز","https://www.poetsgate.com/ViewPoem.aspx?id=20962",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5851,"قبس في منتصف الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=175274",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[161,"الغليان","https://www.poetsgate.com/ViewPoem.aspx?id=152728",""],[549,"يا إمامَ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=203002",""],[6124,"أغنية الكروان","https://www.poetsgate.com/ViewPoem.aspx?id=125178",""],[6127,"إليكِ يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=203112",""],[6072,"رُحى الحُب والحرب !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85442&r=&rc=29",""],[463,"أما لنجومِ ليلكَ بالمصلَّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60170&r=&rc=226",""],[5107,"صورة مناضل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83046&r=&rc=38",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""]],"verses":[["وَكَشَفتَ لِلأَيّامِ عَورَةَ مَقتَلي","حَتّى رَدَدنَ عَلَيَّ بَعدَكَ أَسهُمي",0,"م",2,0],["وَكَشحٍ لَطيفٍ كَالجَديلِ مُخَصَّرٍ","وَساقٍ كَأُنبوبِ السَقِيِّ المُذَلَّلِ",1,"ل",1,0],["وكشفت من تلك المعاني","الغر في لماح درك",2,"ك",1,0],["وَكَشفُ الغِطاءِ عَن الجِنِّ أَو","صُعودُ السَماءِ لِمَن يَرتَغِب",3,"ب",1,0],["وكشفتم ظلمات","لم تدع للناس شرقا",4,"ق",2,0],["وَكَشَفتَ أَسرارَ الوُجودِ لَهُم","وَجَعَلتَ كُلَّ مُبَعَّدٍ أَمَما",5,"م",2,0],["وَكَشَفتُ فَضلَ قِناعِهِ","بِيَدِيَّ عَن قَمَرٍ تَجَلّى",6,"ل",2,0],["وكشَّفَ البيتُ ذو الأطنابِ صفحتَه","كأنه فوقَ صَرحٍ من قَواريرِ",7,"ر",1,0],["وكشفتَ عن متهدِّمٍ جال الردى","متهجماً في صَرحه المنهارِ",8,"ر",1,0],["وكشمسِ الضحى ضياءً وكالظَّبْ","يِ قالتْ وكالغصونِ انثناءَ",9,"ا",2,0],["وَكَشَرنا وَكُبُولُ القَينِ تَنكِبُنا","كَالأُسدِ تَكشِرُ عَن أَنيابِها الرُوقِ",10,"ق",1,0],["وَكَشَّرَت أَشداقُهُ عَن نابِهِ","عَنَّ لَنا كَالرَألِ لا نَرى بِهِ",11,"ب",2,0],["وَكَشَفنا عَن بَياضِ ال","رِدفِ ثَوباً قَصَبِيّا",12,"ي",2,0],["وكشَّر الليلُ عن ال","أنيابِ كالمغاضبِ",13,"ب",1,0],["وَكَشَفتُ بُرقُعَها فَأَشرَقَ وَجهُها","حَتى أَعادَ اللَيلَ صُبحاً مُسفِرا",14,"ر",2,0],["وكشفت المستور فيك لايقن","ت بأن الوجود فيك تناهى",15,"ا",3,0],["وكشَفتَ كلَّ صحيفة مستورةٍ","وتركتَها عُرْياً بغير نِقاب",16,"ب",1,0],["وكشفتُ عن هذي الطبائع ثوبَها","وبسطتهنَّ حريصةً أن تُقبَضا",17,"ض",2,0],["وكشفت عن هذي النفوس غطاءها","وأبرزتَها مثل الاماءِ الحواسِر",18,"ر",1,0],["وكشَّفَتْ جَهْدَ ما اسطاعَتْ محاسنَها","ولم تدَعْ خافياً لو لا التقاليد",19,"د",1,0],["وكشّف للأخرى صفاء مغيّب","حبيب إلى قلبي ولكنّه صعب",20,"ب",1,0],["وكشح لطيفٌ لا يوَصَّف خصره","وعجزٌ من الرؤيا يصبّر مُغلما",21,"م",2,0],["وكَشحاً طِوَاءً لَيِّنَ اللَّمسِ مُونِقاً","غَدَا كُلُّ عُكنٍ مِنهُ مُشتَكِياً عُكنَا",22,"ن",2,0],["وكَشحاً كَالجَدِيلِ لَطِيفَ جَسٍّ","غَرِيرٌ مَن يُشبِّهُهُ جَدِيلا",23,"ل",2,0],["وَكَشَّفْتَ غيمَ الغَدْرِ عن قَمَرِ الوفا","فَأَشْرقَ نُورُ الوَصْلِ عن ظُلَمِ الجَفا",24,"ا",1,0],["وكشفك كربا ماورا الله كاشف","سواك له عنا ولا سامع ندا",25,"د",2,0],["وكشفتُ ليلةَ وصلِها عن ساقِها","فرأيتُها مِمْكارةً مَمْكورَهْ",26,"ه",1,0],["وكشفن عن جَعْدٍ كأنّ فروعه","أمست مغِيبا للدّجى أو مطلعا",27,"ع",2,0],["وَكَشَفتَ الغَمّاءَ عَن مَوطِنٍ لَو","لاكَ فيهِ لَم تُكشَفِ الغَمّاءُ",28,"ا",2,0],["وَكشفتَ سرَّ النفس وَهو مقنعٌ","ضلتْ محجةَ كنهِهِ الأَوهام",29,"م",1,0],["وكشف كل مهم","وجبر كل كسير",30,"ر",1,0],["وَكشّف ظلمةَ البؤسي بنعمى","فَأبصرَ موقعَ الشكرِ الكنودُ",31,"د",1,0],["وَكشّر عَن نيوبٍ قالحاتٍ","تراكم فوقَها خرء الذبابِ",32,"ب",1,0],["وكشفت بالتحقيق وجه غموضها","وغدوت فرداً ما سواك نبيلا",33,"ل",2,0],["وكشاف جار اللّه لي نحو أخذه","وتحقيقه شوق إليه شديد",34,"د",1,0],["وكشَفْتَ غامضَ ما تشابه فانجلَتْ","شُبَهٌ على وجه الحقيقة سود",35,"د",1,0],["وكشفْتَ من سرِّ العلوم غوامضاً","لولاك ما انكشَفَتْ لنا أسرارها",36,"ر",3,0],["وكشفتَ من سر العلوم غوامضاً","فيهن كانت حيرة الحكماء",37,"ا",2,0],["وكشح لطيف وخصر نحيف","رقيق كجسمي رهين الوهن",38,"ن",1,0],["وكشف المكر عن عات","يغش الناس بالتقوى",39,"ا",1,0],["وكشَّفتُ عن ولَدِ الجاثليق","وما عرفوا جاثليقاً نَسَلْ",40,"ل",1,0],["وكشّف هذه الغَمّاء جَدٌّ","عوائده بما تهوون سبقُ",41,"ق",1,0],["وكَشَرَتْ دُرْداً سنو","نَ أربَعٌ وقُلْحا",42,"ح",2,0],["وَكَشحُها لَطيفٌ","مُهَفهَفٌ خَضيدُ",43,"د",1,0],["وكشفاً عن الملكوت الذي","لأرواحه سر إقبالها",44,"ل",3,0],["وكشفت الحجاب عن عين قلبي","لا تلمني قضيت يا صاح نحبي",45,"ي",1,0],["وكشفت وجهها سليمى","وانهتك الستر والنقاب",46,"ب",1,0],["وكشفت بالآلات عن ألحانها","وشرحت فرط صبابةٍ وغرام",47,"م",1,0],["وكشَّف عَنَّا قِناع الصَّباح","فأَسْفر لي وجْهُك المسْفِرُ",48,"ر",1,0],["وكشح أهضم وخميص بطن","وقد في النعومة لن يراما",49,"م",2,0],["وكشفت عن ساق الوجوب حجابه","حتى تراءى الحق للإنسان",50,"ن",1,0],["وَكشفت الكرب عَني كلما","حل بي الإضرار مِنهُ وَالسقم",51,"م",1,0],["وكُشِّفتِ الأَستارُ دونَ بهائهِ","فدُكّت جبالٌ طالما جُعِلت مغنى",52,"ن",2,0],["وكشمِّ المعشوق يشتمه العا","شق في غفلة من الرقباء",53,"ا",2,0],["وكشفت أسرار العلى بشواهد","قامت مقام شواهد الكشاف",54,"ف",1,0],["وكشّاف الكروب إذا أرجحنَّت","بسيفكَ قام ذا الدين القويم",55,"م",1,0],["وكشفت مكروبا يعالجه الطبي","ب فكم شفى من دائه الفتاك",56,"ك",1,0],["وكشمير مما ربت بهجة","وطالت علواً بأقدارها",57,"ر",3,0],["وكشكٍ كمحراب بقبلي قاعةٍ","بها نورها من مغرب الحسن أشرقا",58,"ق",2,1],["وكشف أسمائك عجل المدد","والنصر والتفريج والفتح القريب",59,"ب",1,0],["وكشفا سنياً يا عليم مجلياً","بألطاف سراسم العليم كثيفتي",60,"ي",1,0],["وكشاف الكروب بلا بقاء","وملّاءُ القلوب بلا نزاع",61,"ع",1,0],["وكشرت نيهبم عن ناب مفترس","ضخم السواعد قالي الكف حرانا",62,"ن",2,0],["وكَشحٍ لَطيفٍ كالجدائلِ طَيُّهُ","كلَمسِ الدِمَقسِ ذاتُ خَلقٍ مُعَذلَجِ",63,"ج",1,0],["وكشفت عن دين النبي محمدٍ","ظلماً ولم تبق بها مرتابا",64,"ب",2,0],["وكشفتهم عن وجه ابيض اجد","لم يعرف الادبار والتعريدا",65,"د",2,0],["وَكَشَفتُم لنا الغِطاء فَشمنا","مِنهُ نُور الفَقاهة المَأنوسا",66,"س",2,0],["وكشف حجاب والمحيط وقطره","ومفتاح مصباح وشرح السائل",67,"ل",1,0],["وكُشيِّ الجاه ثلاثَه وافيَه","حتَّى على النَّتخات تلقى العافِيَه",68,"ه",1,0],["وَكَشَّفَ بِالكَشّافِ لا خابَ سَعيُهُ","مُغَطّى خَبيّاتٍ تَبَدَّت حَقائِقا",69,"ق",2,0],["وكشاف المعاني للمعاني","ثغور ليانه تبدي ابتساما",70,"م",2,0],["وكشفت نقابك عن محياً","يخجل الشمس من وراء النقاب",71,"ب",1,0],["وكشَّةَ الأفعَى ونفخَ الأصلَهْ","أنِّي أفئْتُ المِأَدةَ المُؤَبَّلَهْ",72,"ل",2,0],["وكشفت الحمية عن اكيل","أعد نيوبه او عن شريب",73,"ب",1,0],["وَكَشحٍ كَطيِّ السابِريِّ حبَت لَهُ","رَوادِفُ مِنها وَعَثَهُ فَتَخَضَّدا",74,"د",2,0],["وكشف ولا كشف وكم ههنا عنت","أسود لها فوق المجرة غابوا",75,"ب",3,0],["وكشفت أمراض الطبا","ع بجانب الطبع السليم",76,"م",1,0],["وكشحٍ رقيقٍ كم رقيقٍ برحبهِ","شخيصٍ لهُ خمران من غير خمرةِ",77,"ه",1,0],["وكشفت عن شعري لتلحقه به","فاستر على خل لسترك محوج",78,"ج",1,0],["وَكشف ستور الغيب عن كلّ كائِنٍ","بِأَسفار وجهٍ دونَهُ طلعة البَدرِ",79,"ر",1,0],["وكَشَّرَ غَيْظا عَنْ حِرابٍ لَوامعٍ","فَخِلْتُ قَضاءَ الله مُثِّلَ لي نِمْرا",80,"ر",2,0],["وكشيظ وكاظم وظهار","ثمت الظلف بعد والانعاظ",81,"ظ",1,0],["وَكَشَفَت عَن مَلِكِ المُلوكِ نَوائِباً","يَنتابُ دَولتِهِ وَلا تَنتابُها",82,"ب",3,0],["وكَشُعلَةٍ هَطَلَت بِسُمرَتِهَا عَلى","قَلبٍ لِغَيرِ هُطُولِهَا لا يَظمَأُ",83,"ا",1,0],["وكشفْتُ فصلا من فصول رواية","مدسوسة بالقلب ليست تُعْلَم",84,"م",1,0],["وكشف الوجه ظنوه ارتقاءً","وعدَّوه من الفعل النبيل",85,"ل",1,0],["وكشفتَ زيف الخانعينَ وبغيهم","يا سيدا لاذت به الأقدارُ",86,"ر",1,0],["وكشفت بالوحي القديمَ ولاحقا","وحسمت في صعب السؤال جوابا",87,"ب",2,0],["وكشفت من أعماق جرحك عن فمٍ","طلقٍ يحدث عن هوىً مكنون",88,"ن",1,0],["وكشاعر عربيد بتُّ بحانك","ويخونني التعبير في محرابكِ",89,"ك",1,0],["وكشَفتِ أسرارَ الحياةِ وكُنهَها","أشعَلتِ في مهدِ الوجودِ فتيلَه",90,"ل",2,0],["وكشفت عن أن الحقائق لم تزل","مجهولة المأوى بكل مكان",91,"ن",1,0],["وكشرفة للورد تزرعه","من نطفة قمرّية أورق",92,"ق",1,0],["وكشر السجن عن بابيه وارتفعت","حمر المشانق يغذوهن جزار",93,"ر",1,0],["وكشفَ الكُربة الدَّهْما .. ورفعَ الغُمة العَتْما","وقصمَ المُعتدي الطاغي الذي أودَى بنا قصْما",94,"م",2,0],["وكشَّفَ الدهُر عن أشرى نواجذِهِ","والغَدرُ في ملتقى عينيهِ يأتَمرُ",95,"ر",1,0],["وكشفت عن وجه القريض لثامه","حتى اطّلعت على ملامحه الألى",96,"ل",2,0],["وكشمسٍ تُهدي الحياةَ ، ولكن","بين أحشائها انفجارُ مُفَاعِلْ",97,"ل",1,0],["وَكَشْفُ السَّتْرِعَنْ حُرُمَاتِ أَهْليِ","وسِتْرُ المُعْتَدِي جَهْرًا يُحَمْلِقْ",98,"ق",1,0],["وكشفت الأستار عن خاطر الكون","لألتاح حلمه المنشودا",99,"د",2,0],["وَكَشَفَتْ مِنْ هَجْرِيْ وَكْرًا","أُغْنِيَةَ الكَرَوَانِ",100,"ن",1,0],["وكشفْتَ سِتْراً للخداعِ تبرقعوا","فيها، فلاذوا بالرياء حُشودا",101,"د",2,0],["وكشفتُ ما القمرُ النديُّ صَبا له","كيلا يقالَ لقد كتمتَ وباحا !",102,"ح",2,0],["وكشّفَ هذا الغماءُ جدٌّ","عوائدهُ بما تهوونُ سبقُ",103,"ق",1,0],["وكشّر حولك العملاء غيظًا","كما تبدي نواجذها الكلابُُ",104,"ب",1,0],["وكشفت سدف الدّجى","إذ لاحت الشمس المبينة",105,"ن",2,0]]}