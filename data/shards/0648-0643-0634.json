{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[93,"أبدعت في ديوان شعرك","https://www.aldiwan.net/poem9830.html","مجزوء الكامل"],[54,"لنقل الرمال وقطع الجبال","https://www.aldiwan.net/poem27413.html","المتقارب"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[91,"ما عز من لم يصحب الخذما","https://www.aldiwan.net/poem62738.html","عموديه"],[70,"يا حسن بعض الناس مهلا","https://www.aldiwan.net/poem42769.html","مجزوء الكامل"],[61,"أحبب إلي بإلف ذي مساعدة","https://www.aldiwan.net/poem51619.html","البسيط"],[97,"شَجنٌ على شَجنٍ وحرقةُ نارِ","https://www.aldiwan.net/poem24753.html","الكامل"],[69,"لست صخرا في حبي الخنساء","https://www.aldiwan.net/poem28873.html","الخفيف"],[40,"يا ليت ليلى رأتنا غير جازعة","https://www.aldiwan.net/poem42291.html","البسيط"],[48,"قد أغتدي والليل في إهابه","https://www.aldiwan.net/poem62456.html","الرجز"],[48,"فتكتني طيزناباذ","https://www.aldiwan.net/poem66209.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85812","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9936","الكامل"],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""]],"verses":[["وَكَشَفتَ لِلأَيّامِ عَورَةَ مَقتَلي","حَتّى رَدَدنَ عَلَيَّ بَعدَكَ أَسهُمي",0,"م",2,0],["وَكَشحٍ لَطيفٍ كَالجَديلِ مُخَصَّرٍ","وَساقٍ كَأُنبوبِ السَقِيِّ المُذَلَّلِ",1,"ل",1,0],["وكشفت من تلك المعاني","الغر في لماح درك",2,"ك",1,0],["وَكَشفُ الغِطاءِ عَن الجِنِّ أَو","صُعودُ السَماءِ لِمَن يَرتَغِب",3,"ب",1,0],["وكشفتم ظلمات","لم تدع للناس شرقا",4,"ق",2,0],["وَكَشَفتَ أَسرارَ الوُجودِ لَهُم","وَجَعَلتَ كُلَّ مُبَعَّدٍ أَمَما",5,"م",2,0],["وَكَشَفتُ فَضلَ قِناعِهِ","بِيَدِيَّ عَن قَمَرٍ تَجَلّى",6,"ل",2,0],["وكشَّفَ البيتُ ذو الأطنابِ صفحتَه","كأنه فوقَ صَرحٍ من قَواريرِ",7,"ر",1,0],["وكشفتَ عن متهدِّمٍ جال الردى","متهجماً في صَرحه المنهارِ",8,"ر",1,0],["وكشمسِ الضحى ضياءً وكالظَّبْ","يِ قالتْ وكالغصونِ انثناءَ",9,"ا",2,0],["وَكَشَرنا وَكُبُولُ القَينِ تَنكِبُنا","كَالأُسدِ تَكشِرُ عَن أَنيابِها الرُوقِ",10,"ق",1,0],["وَكَشَّرَت أَشداقُهُ عَن نابِهِ","عَنَّ لَنا كَالرَألِ لا نَرى بِهِ",11,"ب",2,0],["وَكَشَفنا عَن بَياضِ ال","رِدفِ ثَوباً قَصَبِيّا",12,"ي",2,0],["وكشَّر الليلُ عن ال","أنيابِ كالمغاضبِ",13,"ب",1,0],["وَكَشَفتُ بُرقُعَها فَأَشرَقَ وَجهُها","حَتى أَعادَ اللَيلَ صُبحاً مُسفِرا",14,"ر",2,0],["وكشَفتَ كلَّ صحيفة مستورةٍ","وتركتَها عُرْياً بغير نِقاب",15,"ب",1,0],["وكشفتُ عن هذي الطبائع ثوبَها","وبسطتهنَّ حريصةً أن تُقبَضا",16,"ض",2,0],["وكشفت عن هذي النفوس غطاءها","وأبرزتَها مثل الاماءِ الحواسِر",17,"ر",1,0],["وكشَّفَتْ جَهْدَ ما اسطاعَتْ محاسنَها","ولم تدَعْ خافياً لو لا التقاليد",18,"د",1,0]]}