{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[93,"أبدعت في ديوان شعرك","https://www.aldiwan.net/poem9830.html","مجزوء الكامل"],[54,"لنقل الرمال وقطع الجبال","https://www.aldiwan.net/poem27413.html","المتقارب"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[91,"ما عز من لم يصحب الخذما","https://www.aldiwan.net/poem62738.html","عموديه"],[70,"يا حسن بعض الناس مهلا","https://www.aldiwan.net/poem42769.html","مجزوء الكامل"],[61,"أحبب إلي بإلف ذي مساعدة","https://www.aldiwan.net/poem51619.html","البسيط"],[97,"شَجنٌ على شَجنٍ وحرقةُ نارِ","https://www.aldiwan.net/poem24753.html","الكامل"],[69,"لست صخرا في حبي الخنساء","https://www.aldiwan.net/poem28873.html","الخفيف"],[40,"يا ليت ليلى رأتنا غير جازعة","https://www.aldiwan.net/poem42291.html","البسيط"],[48,"قد أغتدي والليل في إهابه","https://www.aldiwan.net/poem62456.html","الرجز"],[48,"فتكتني طيزناباذ","https://www.aldiwan.net/poem66209.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85812","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9936","الكامل"],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[119,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[130,"سرى الطيف من لبنى فهاج الضنى وهنا","https://www.aldiwan.net/poem54730.html","الطويل"],[130,"أقلب لا يزال ولن يزولا","https://www.aldiwan.net/poem54776.html","الوافر"],[153,"أيا ربع صبري كيف طاوعك البلى","https://www.aldiwan.net/poem55799.html","الطويل"],[158,"بنى السيف علياه وشيدها الندى","https://www.aldiwan.net/poem58906.html","الطويل"],[164,"ولقد جذبت إلي عقرب صدغها","https://www.aldiwan.net/poem47063.html","الكامل"],[227,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[233,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[296,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[302,"يا رحمة الله زوري","https://www.aldiwan.net/poem16858.html","المجتث"],[303,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[303,"عوى الضبع الملفلف في الثياب","https://www.aldiwan.net/poem56599.html","البسيط"],[400,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[400,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[413,"الله يعلم والأنام شهود","https://www.aldiwan.net/poem53839.html","الكامل"],[413,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[413,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[426,"حذار حذار أخي الشجن","https://www.aldiwan.net/poem41411.html","المتقارب"],[441,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[456,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[456,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[456,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[551,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[556,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[556,"قلبي لعلم الإله باب","https://www.aldiwan.net/poem34962.html","مخلع البسيط"],[556,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[573,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[585,"دع للعبرات تنسجم انسجاما","https://www.aldiwan.net/poem11522.html","عموديه"]],"verses":[["وَكَشَفتَ لِلأَيّامِ عَورَةَ مَقتَلي","حَتّى رَدَدنَ عَلَيَّ بَعدَكَ أَسهُمي",0,"م",2,0],["وَكَشحٍ لَطيفٍ كَالجَديلِ مُخَصَّرٍ","وَساقٍ كَأُنبوبِ السَقِيِّ المُذَلَّلِ",1,"ل",1,0],["وكشفت من تلك المعاني","الغر في لماح درك",2,"ك",1,0],["وَكَشفُ الغِطاءِ عَن الجِنِّ أَو","صُعودُ السَماءِ لِمَن يَرتَغِب",3,"ب",1,0],["وكشفتم ظلمات","لم تدع للناس شرقا",4,"ق",2,0],["وَكَشَفتَ أَسرارَ الوُجودِ لَهُم","وَجَعَلتَ كُلَّ مُبَعَّدٍ أَمَما",5,"م",2,0],["وَكَشَفتُ فَضلَ قِناعِهِ","بِيَدِيَّ عَن قَمَرٍ تَجَلّى",6,"ل",2,0],["وكشَّفَ البيتُ ذو الأطنابِ صفحتَه","كأنه فوقَ صَرحٍ من قَواريرِ",7,"ر",1,0],["وكشفتَ عن متهدِّمٍ جال الردى","متهجماً في صَرحه المنهارِ",8,"ر",1,0],["وكشمسِ الضحى ضياءً وكالظَّبْ","يِ قالتْ وكالغصونِ انثناءَ",9,"ا",2,0],["وَكَشَرنا وَكُبُولُ القَينِ تَنكِبُنا","كَالأُسدِ تَكشِرُ عَن أَنيابِها الرُوقِ",10,"ق",1,0],["وَكَشَّرَت أَشداقُهُ عَن نابِهِ","عَنَّ لَنا كَالرَألِ لا نَرى بِهِ",11,"ب",2,0],["وَكَشَفنا عَن بَياضِ ال","رِدفِ ثَوباً قَصَبِيّا",12,"ي",2,0],["وكشَّر الليلُ عن ال","أنيابِ كالمغاضبِ",13,"ب",1,0],["وَكَشَفتُ بُرقُعَها فَأَشرَقَ وَجهُها","حَتى أَعادَ اللَيلَ صُبحاً مُسفِرا",14,"ر",2,0],["وكشَفتَ كلَّ صحيفة مستورةٍ","وتركتَها عُرْياً بغير نِقاب",15,"ب",1,0],["وكشفتُ عن هذي الطبائع ثوبَها","وبسطتهنَّ حريصةً أن تُقبَضا",16,"ض",2,0],["وكشفت عن هذي النفوس غطاءها","وأبرزتَها مثل الاماءِ الحواسِر",17,"ر",1,0],["وكشَّفَتْ جَهْدَ ما اسطاعَتْ محاسنَها","ولم تدَعْ خافياً لو لا التقاليد",18,"د",1,0],["وكشح لطيفٌ لا يوَصَّف خصره","وعجزٌ من الرؤيا يصبّر مُغلما",19,"م",2,0],["وكَشحاً طِوَاءً لَيِّنَ اللَّمسِ مُونِقاً","غَدَا كُلُّ عُكنٍ مِنهُ مُشتَكِياً عُكنَا",20,"ن",2,0],["وكَشحاً كَالجَدِيلِ لَطِيفَ جَسٍّ","غَرِيرٌ مَن يُشبِّهُهُ جَدِيلا",21,"ل",2,0],["وَكَشَّفْتَ غيمَ الغَدْرِ عن قَمَرِ الوفا","فَأَشْرقَ نُورُ الوَصْلِ عن ظُلَمِ الجَفا",22,"ا",1,0],["وكشفك كربا ماورا الله كاشف","سواك له عنا ولا سامع ندا",23,"د",2,0],["وكشفتُ ليلةَ وصلِها عن ساقِها","فرأيتُها مِمْكارةً مَمْكورَهْ",24,"ه",1,0],["وكشفن عن جَعْدٍ كأنّ فروعه","أمست مغِيبا للدّجى أو مطلعا",25,"ع",2,0],["وَكَشَفتَ الغَمّاءَ عَن مَوطِنٍ لَو","لاكَ فيهِ لَم تُكشَفِ الغَمّاءُ",26,"ا",2,0],["وَكشفتَ سرَّ النفس وَهو مقنعٌ","ضلتْ محجةَ كنهِهِ الأَوهام",27,"م",1,0],["وكشف كل مهم","وجبر كل كسير",28,"ر",1,0],["وَكشّف ظلمةَ البؤسي بنعمى","فَأبصرَ موقعَ الشكرِ الكنودُ",29,"د",1,0],["وَكشّر عَن نيوبٍ قالحاتٍ","تراكم فوقَها خرء الذبابِ",30,"ب",1,0],["وكشفت بالتحقيق وجه غموضها","وغدوت فرداً ما سواك نبيلا",31,"ل",2,0],["وكشاف جار اللّه لي نحو أخذه","وتحقيقه شوق إليه شديد",32,"د",1,0],["وكشَفْتَ غامضَ ما تشابه فانجلَتْ","شُبَهٌ على وجه الحقيقة سود",33,"د",1,0],["وكشفْتَ من سرِّ العلوم غوامضاً","لولاك ما انكشَفَتْ لنا أسرارها",34,"ر",3,0],["وكشفتَ من سر العلوم غوامضاً","فيهن كانت حيرة الحكماء",35,"ا",2,0],["وكشح لطيف وخصر نحيف","رقيق كجسمي رهين الوهن",36,"ن",1,0],["وكشف المكر عن عات","يغش الناس بالتقوى",37,"ا",1,0],["وكشَّفتُ عن ولَدِ الجاثليق","وما عرفوا جاثليقاً نَسَلْ",38,"ل",1,0],["وكشّف هذه الغَمّاء جَدٌّ","عوائده بما تهوون سبقُ",39,"ق",1,0],["وكَشَرَتْ دُرْداً سنو","نَ أربَعٌ وقُلْحا",40,"ح",2,0],["وَكَشحُها لَطيفٌ","مُهَفهَفٌ خَضيدُ",41,"د",1,0],["وكشفاً عن الملكوت الذي","لأرواحه سر إقبالها",42,"ل",3,0],["وكشفت الحجاب عن عين قلبي","لا تلمني قضيت يا صاح نحبي",43,"ي",1,0],["وكشفت وجهها سليمى","وانهتك الستر والنقاب",44,"ب",1,0],["وكشفت بالآلات عن ألحانها","وشرحت فرط صبابةٍ وغرام",45,"م",1,0],["وكشَّف عَنَّا قِناع الصَّباح","فأَسْفر لي وجْهُك المسْفِرُ",46,"ر",1,0],["وكشح أهضم وخميص بطن","وقد في النعومة لن يراما",47,"م",2,0]]}