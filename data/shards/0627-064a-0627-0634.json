6,"","https://poetry.dctabudhabi.ae/diwan/poem/94771","الوافر"],[4241,"","https://poetry.dctabudhabi.ae/diwan/poem/138845",""],[4362,"","https://poetry.dctabudhabi.ae/diwan/poem/146020","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117215","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66155","الرجز"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103129","المجتث"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33324","الوافر"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99111","الوافر"],[4782,"شطر الخامسة","https://www.poetsgate.com/ViewPoem.aspx?id=198465",""],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[3591,"أحبكمَ والشاهداتُ الحواسدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149376",""],[5111,"تُفَّاحَةُ المنْتَهَى","https://www.poetsgate.com/ViewPoem.aspx?id=212059",""],[5121,"حنانيكَ شِعركَ","https://www.poetsgate.com/ViewPoem.aspx?id=33867",""],[5183,"لشيخنا ابن عُبيد","https://www.poetsgate.com/ViewPoem.aspx?id=180219",""],[5221,"بوح الأمير","https://www.poetsgate.com/ViewPoem.aspx?id=188995",""],[5277,"حبيبي الأغرّ","https://www.poetsgate.com/ViewPoem.aspx?id=189722",""],[5277,"حُلْوُ الملامِحِ","https://www.poetsgate.com/ViewPoem.aspx?id=191105",""],[5323,"إجازة عقل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=207562",""],[5431,"يهيم كصوفيٍ إلى العشق سره","https://www.poetsgate.com/ViewPoem.aspx?id=189042",""],[5574,"نُوَّارتي","https://www.poetsgate.com/ViewPoem.aspx?id=206011",""],[5616,"أغنيةُ صمودٍ للمخيَّمِ الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205219",""],[5644,"مساكن الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=198561",""],[5725,"حفظتك في قلبي عراقا مبجلا","https://www.poetsgate.com/ViewPoem.aspx?id=179745",""],[5770,"على اليرموك","https://www.poetsgate.com/ViewPoem.aspx?id=178268",""],[5829,"ومضة","https://www.poetsgate.com/ViewPoem.aspx?id=183222",""],[5975,"أيحسنُ أن تضنّي؟","https://www.poetsgate.com/ViewPoem.aspx?id=52979",""],[5975,"وجدتُكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=53406",""],[6093,"كَلُؤْلؤَةٍ يحفُّ بها العَقِيقُ","https://www.poetsgate.com/ViewPoem.aspx?id=198220",""],[6124,"الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=159314",""]],"verses":[["أَيا شاكِياً مِنّي لِذَنبٍ جَنَيتُهُ","فَدَيتُكَ مِن شاكٍ إِلَيَّ حَبيبِ",0,"ب",1,1],["أيّ أشدّ من كفر قوم","جعلوا الحجّ للجنايات سترا",1,"ر",2,0],["أَيا شَيبي ظَلَمتَ وَياشَبابي","لَقَد جاوَرتُ مِنكَ بِشَرِّ جارِ",2,"ر",1,0],["أيا شجراً بين الرَّسيس فعاقلٍ","منحتُك ذمّي صادقاً غيرَ كاذبِ",3,"ب",1,1],["أيا شمس النهارِ سَناً وعزّاً","يقصِّر عنهما نظرٌ ولمسُ",4,"س",1,0],["أيا شجرات الله ليس بقاطعٍ","لك الدهر شرباً أنت فيه شوارع",5,"ع",1,1],["أيا شتراً على بخرٍ أليمٍ","إلى قذرٍ توقَّ مُهاتريكا",6,"ك",2,0],["أيا شاغلَ الشُّكرِ عن غيرِه","بما ذاعَ في الناس من شُكرِه",7,"ر",2,1],["أَيا شِبهَ لَيلى إِنَّ لَيلى مَريضَةٌ","وَأَنتَ صَحيحٌ إِنَّ ذا لَمُحالُ",8,"ل",1,0],["أَيا شِبهَ لَيلى لا تُراعي فَإِنَّني","لَكِ اليَومَ مِن بَينِ الوُحوشِ صَديقُ",9,"ق",1,1],["أَيا شُعبَةَ النَفسِ الَّتي لَيسَ غَيرُها","سَقَطتَ فَقَد أَفرَدتَ عودي لِكاسِرِ",10,"ر",1,0],["أَيا شَجَرَ العُرا أوسِعتِ رِيّاً","فَقَد جَفَّ العِضاهُ وَلَم تَجُفّي",11,"ف",2,1],["أَيا شيعَةَ إِسماعي","لَ إِنَّ الصَبرَ قَد عيلا",12,"ل",2,1],["أَيا شامِتاً بِوُرودِ الرَدى","سَيُورِدُكَ الحَوض مَن أَبهَضا",13,"ض",2,0],["أيا شمعة العمر ذوبي يلحّ","فتسخو وتومي : أأبدو شحيحه؟",14,"ح",2,0],["أيَا شَيخَنَا النَّجدِىيَّ إِنَّكَ عَارِفٌ","بَصِيرٌ لأسرَارِ الغوَايَةِ رَانِ",15,"ن",1,0],["أَيَا شَيخَ الشُّيُوخِ بِلاَ خِلاَفِ","ويَا شَيخَ التَّدَارُكِ والتَّلافي",16,"ف",2,1],["أيا شرفَ الدين المشَرِّف عصرِه","ومن حلَّ فيه بالعطايا البواهرِ",17,"ر",1,0],["أيا شَبيهَ الذي باعُوه إخوتُه","ويا سَمِيَّ الذي ألقَوهُ في النارِ",18,"ر",1,1],["أَيا شَمسَ المَلاحَةِ كُن لصَبٍّ","يُعايِنُ مِن لِحاظِكَ حَرب بَدرِ",19,"ر",1,0],["أَيا شِعبُ نَجدٍ رُقادي حَرام","مَتى قُوِّضَت عَن رُباكَ الخِيام",20,"م",1,1],["أيا شرفَ الدينِ الذي فَيضُ جودِهِ","براحتهِ قد أخجَلَ الغَيثَ والبَحرا",21,"ر",2,1],["أيا شعراءَ هذا العصرِ مَهلاً","وزهداً في المديحِ وفي الرثاء",22,"ا",2,0],["أيا شرفَ المُلْكِ والدّينِ والنْ","نَدى والمعالي بكُلٍّ تَليق",23,"ق",1,0],["أيا شادياً يَشتار حلوَ مديحها","أعد ذكرها يحلو لنا ذلك الحلو",24,"و",1,0],["أيا شَعبَ مارونَ الذي قام أُسُّهُ","على صخرة الإيمان وهو صقيل",25,"ل",1,0],["أيا شمس ارجعي رَجعاً سريعاً","لقد غلبت عليك يد الليالي",26,"ل",2,0],["أَيا شعبَ مِصرَ ويا نِيلَها","ويا دوْحةً روضُها مُخْصِبُ",27,"ب",1,0],["أيا شرف الإسلام دُمْتَ مُشرَّفاً","ولا زال ذا فخرٍ برتبتك الفخرُ",28,"ر",1,1],["أيا شادِناً أغرَى السّهاد بناظري","وأنحلَ جسمي حُبُّه وبراني",29,"ي",1,1],["أيا شديد جدال حين يلتقي ال","جمعان في معرك يا وافي الذمم",30,"م",1,0],["أيا شرف الدين الذي سوقُ يحده","بمعروفه بين البريّة نافق",31,"ق",1,1],["أيا شارباً كأس خمر الرقاد","ويا قاطعاً عمره بالتمادي",32,"د",2,1],["أيا شرف الدين ارعني سمع عارفٍ","بقولي إذا الأقوال ضاق مجالها",33,"ل",3,0],["أيا شَرفاً لدينِ اللهِ","رَبُّ العَرْشِ كافِلُهُ",34,"ل",2,0],["أيا شمس هذا الكون يا كعبة المنى","تدارك معنى بالبعاد مكبل",35,"ل",1,0],["أيا شَادِياً يشدُو بأَوصَافِ أَحمدٍ","أَعِدها علَى الأسماعِ حُيِّيتَ شَاديا",36,"ي",2,0],["أيا شعبَ بولونيا الشهيدَ ومَن بَنى","لِمَجدِه صَرحاً شامخاً ليس يُهدَمُ",37,"م",1,0],["أيا شَمسَ أرضٍ لا يغيبُ ضِياؤُها","ألا كيفَ حالِي حين عني يُغَيَّبُ",38,"ب",1,0],["أيا شجراتِ الوادِيَيْن لعلّني","أعوجُ بما تُظْلِلْنَهُ فأَقيلُ",39,"ل",1,1],["أَيا شمسِي منكِ أَشرَقُ بهجةً","وإِن حُجِّبت بالعُجْب في سُحُب الحُجْب",40,"ب",1,1],["أيا شِعبَ رَضوى ما لمنْ بكَ لا يُرى","فحتى متى تَخفى وأنتَ قريبُ",41,"ب",1,1],["أيا شمساً بروج الحسن حلَّت","بطلتها سنى الحسنى تلالا",42,"ل",2,1],["أَيَا شَجَرَاتِ الحَيِّ مِنْ شاطئ الوادِي","سَقَاكِ الحَيَا سُقْيَاكِ للدَّنِفِ الصَّادِي",43,"د",2,1],["أَيا شَمسَ الوِزارَةِ بدرَ عِزٍّ","عَلى الوُزراءِ طرّاً أَجمعينا",44,"ن",2,1],["أيا شاعراً لمْ تُعِقهُ الحتوف","وإنْ كانَ أسهَلُهَا يَفتكُ",45,"ك",1,0],["أَيا شَفَتَى مىٍّ أَمَا من شريعةٍ","من الموتِ إِلاَّ أَنتما تُورِدانِيا",46,"ي",2,1],["أيا شهاب الدين يا سيدي","قد هجم النذل علينا وغار",47,"ر",1,0],["أيا شيعة الحق طاب الممات","فيا قوم قوموا سراعا نَثُور",48,"ر",1,0],["أَيا شَجَرات الواديين إِلى النقا","بِعَين وَسيم هَل إلَيكَ رُجوع",49,"ع",1,1],["أيا شبل نصر اللَه تهناك رتبةٌ","لها وهي في ثاني الطباق اليد الطولى",50,"ل",2,1],["أيا شمسُ إنّي إن أتتْكِ مدائحي","وهنّ لآلٍ نُظّمتْ وقلائدُ",51,"د",1,1],["أيا شمر مهما كنت في الناس جاهلاً","فمثل حسين لست يا شمر تجهل",52,"ل",1,0],["أيا شمر هذا حجة اللَه في الورى","أعد نظراً يا شمر ان كنت تعقل",52,"ل",1,0],["أيا شمر لا تعجل على ابن محمد","فذو ترة في مثلها ليس يعجل",52,"ل",1,0],["أيا شمر من للجود بعد وجوده","ومن لبني الآمال بعد المؤمل",53,"ل",1,0],["أيا شمر من للفضل يرعاه ان تكن","قطعت بحد السيف راس المفضل",53,"ل",1,0],["أيا شَبَه الرّجَال ولا رِجالٌ","مِنَ الألباب فارغةَ الجِرابِ",54,"ب",1,0],["أَيا شَرَّحَيِّ بَني أَجيالِ طَييِّءٍ","وَبَينَ الوِحافِ السُودِ مِن سَروِ حِميَرا",55,"ر",2,1],["أيا شعر قد وافيتني حين لا أرى","لبيباً يعي ماذا أقول وأنظم",56,"م",1,1],["أيا شعراء الدهر هل في كؤوسكم","من الدهر صابٌ مثل ما ذقتُ من كأسي",57,"ي",1,1],["أَيا شِبهَ لَيلى جادَكِ الغَيثُ وَاِنبَرى","لَكِ الرُشدُ وَاِخضَرَّت عَلَيكِ المَراتِعُ",58,"ع",1,1],["أيا شيخ أني مستعينٌ على الهوى","ونفسي بكم ان لا أكون مهانا",59,"ن",2,0],["أيا شادناً قد لاحَ في زِيِّ ناسكِ","فباحَ بمكنونِ الهوى كلُّ ماسِكِ",60,"ك",1,1],["أيا شيخ المشايخ جئت ادّاً","ونكرا لا يسوغ ولا يجوز",61,"ز",1,0],["أيا شقيقَ الرَّوْضِ حَيَّاه الْحَيَا","فاحْمَرَّ وردُ خَدِّه من الْحَيَا",62,"ا",1,1],["أيا شيخ دعني الآن أقضي بحسرة","فمن حادث الأيام أني بسكرَة",63,"ه",1,0],["أيا شجرات النيل من يضمن القرى","إذا لم يكن جار الفرات ابن مزيد",64,"د",1,1],["أيا شريفاً قد نأتْ دارُهُ","وخُبْرُهُ طابَ وأخبارُهُ",65,"ه",1,1],["أيا شريفَ المُنْتَمى والذي","أضْحى إلى الغاياتِ سبّاقا",66,"ق",2,1],["أيا شيخ إبراهيمُ أنتَ تشوقني","وتترك لي من بعدك الوحشاتِ",67,"ت",1,0],["أيا شنزليزا لا مشى فيك غير من","أرونا بدوراً في الوجوه وأنجما",68,"م",2,0],["أيا شمس يوم الانتظار فاننا","بليل اختلاف لاصباح ولا عصر",69,"ر",1,0],["أيا شديد البطش منهم فانتصرْ","وخذهمُ أخذ عزيزٍ مقتدرْ",70,"ر",1,0],["أيا شافي الأمراض من كل ما شُفي","عُبَيدُك مضطرٌّ وتعلم ما خفي",71,"ي",1,1],["أَيا شَفَقاً في عالَمٍ جَوُّ أَرضِهِ","خَيالٌ عَلى الوادي المَهومِ ساهِرُ",72,"ر",1,0],["أَيا شَرحُ يا اِبنَ السِمطِ أَصبَحتَ راجِعاً","عَلى العَقبِ فَاِنظُر في رُجوعِكَ لِلعُقبِ",73,"ب",1,1],["أيا شهما تولد منه شهم","وإنك من سواك بذاك أليق",74,"ق",1,0],["أَيا شرفَ الدِّينِ شَرَّفتني","بإهداءِ رائقةٍ رائعَهْ",75,"ع",2,0],["أيا شمسَ الملوكِ بقيتَ شمساً","تنيرُ على الممالكِ والديارِ",76,"ر",1,0],["أَيا شرفَ الدِّين إنَّ الشَّتا","بكافاتهِ كفَّ آفاتهِ",77,"ت",2,1],["أيا شيخَ غادرتَ الصبا واليفهُ","وعدتَ تنادينا هلمّوا لإلفتي",78,"ي",1,0],["أيا شهمٌ تسامى عن شبيهِ","ويا ندبٌ همامٌ اصطفيهِ",79,"ه",1,1],["أيا شمر هذا ابن البتولة فاطم","وبضعة مَن من قد بات لله داعيا",80,"ي",2,0],["أيا شمر هذا خير ماشٍ وراكبِ","وخير فتىً لله قد طاف ساعيا",80,"ي",2,0],["أيا شمس الضحى، شمس المعالي","أبو نصر فردي من ضحاك",81,"ك",1,0],["أيا شادياً يشدو بأمداح أحمد","سماعك طبّ ليس يعقبه نكس",82,"س",1,0],["أَيا شَبابَ العُرْبِ إِنَّ الجهلَ قَدْ","اشْفى بِنا عَلى شفا داني الرَّدَى",83,"ا",1,0],["أيا شقيقي إخاء","ويا قسيمي صفاءِ",84,"ا",2,1],["أيا شمسي ويا قمري","ويا سمعي ويا بصري",85,"ر",2,1],["أيا شاهانشاه صلِ الأماني","بتجديد البشائر والتهاني",86,"ن",2,1],["أيا شطرَ المكارم والسجايا","وروّاد المعارف والفنون",87,"ن",1,0],["أيا شاعر الدار ويك استمع","عجائب في مدحهم تنسج",88,"ج",1,0],["أيا شاعراً انضم تحت لوائه","فأنت لواء الشعر والنثر عاقدُ",89,"د",1,0],["أيا شعيبُ ، فأين القسطُ يُنْصِفُنِي ؟؟","آهٍ.. شعيبُ فكمْ ذا الوزنُ يُرديني",90,"ن",2,0],["أيا شاعرَ الحبِّ أغدقت قولاً","فرنّتْ شجوني بلحنِ الهناءِ",91,"ا",2,0],["أيا شيخنا أحكمت كل عصية","فعدت من التوفيق بالحلل الخضر",92,"ر",1,0],["أيا شنقيط يا أرض المعالي","أريني ما أزف به شعوري",93,"ر",2,0],["أيا شمسُ غيبي فقد طالَ يومٌ","متى الوصلُ يأتي ويبدو القمرْ",94,"ر",1,1],["أيا شمسُ غيبي فقد طالَ يومي","متى الوصلُ يأتي ويبدو القمرْ",95,"ر",1,1],["أيا (شيهانة) الألق المقفى","أما استرعاك في العلياءِ بازُ ؟!",96,"ز",1,1],["أيا شاعر الوجدان عبد الإله يا","صديقا به نزهو كخلٍ مناصف",97,"ف",1,0],["١٤- أيا شمْسًا من الآمالِ كوني","رفيقةَ زهْرتي، يكفي الجُنوحُ",98,"ح",1,0],["أيا شعبَ العقيدةِ إنَّ قلبي","عليكَ وأنتَ في رَمَقٍ تجودُ",99,"د",1,0],["أيا شَوقٌ تفَشَّى في ضُلوعٍ","تُؤرِّقُها وتُضنيهَا زمانا",100,"ن",2,0],["ايا شجن العشاق مازلت ناسجا","لارواحنا ثوبا عفيفا مهلهلا",101,"ل",2,0],["أيا شيخ الجبال فدتك روحي","أسيراً قد وقفتُ له احتراما",102,"م",2,0],["ايا شعرا يؤانسني","وكم في الناس ايناسي",103,"ي",1,1],["أَيَاْ شَقْرَاْءُ وَالأَحْلامُ تَغْفو","إِذا مَاْ قُلْتُ يَاْ شَقْرَاْءُ حِنِّي",104,"ن",2,0],["أيا شمسَ حبي لياليَّ طالت","وطالَ المكوثُ ولم تشرقي",105,"ق",2,0],["أيَا شِعريْ ومَا شِعريْ عقُوقًا","وشرُّ الشِّعرِ قافيةٌ عقوقُ",106,"ق",1,0],["أيا شمسَ الضحى هلِّي على شباكِ أحبابي","ومرّي فوق دربٍ من حنينٍ ضمَّ أحبابي",107,"ب",2,0]]}