{"poems":[[77,"يا سراج الجمال يا ابن سراج","https://www.aldiwan.net/poem36668.html","الخفيف"],[86,"لله درك كنت من رجل","https://www.aldiwan.net/poem10491.html","أحذ الكامل"],[73,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[41,"يا مرحبا ألفا وألفا","https://www.aldiwan.net/poem42252.html","مجزوء الكامل"],[88,"من مبسم الغازي إلى الفاروق","https://www.aldiwan.net/poem44800.html","الكامل"],[51,"يا أبا إسحاق واقلب","https://www.aldiwan.net/poem65439.html","مجزوء الرمل"],[29,"يا مرسل الريح جنوبا وصبا","https://www.aldiwan.net/poem6196.html","الرجز"],[85,"قالوا الخليفة في فاس أحق بها","https://www.aldiwan.net/poem7518.html","البسيط"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[85,"يا مريضا بالمناصب","https://www.aldiwan.net/poem7766.html","مجزوء الرمل"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[28,"يا مر يا ابن سحيم كيف تشتمني","https://www.aldiwan.net/poem5498.html","البسيط"],[28,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[58,"يا مرحبا بالقائلين عدلا","https://www.aldiwan.net/poem30884.html","الرجز"],[97,"يا مرحباً بالورد في إبانه","https://www.aldiwan.net/poem24351.html","الكامل"],[97,"نار من الشوق إثر نار","https://www.aldiwan.net/poem24922.html","مجزوء البسيط"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[80,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[69,"يا مربعا لك في فؤادي مربع","https://www.aldiwan.net/poem28365.html","الكامل"],[81,"يا مرهبي دون سلطان يصول به","https://www.aldiwan.net/poem61499.html","البسيط"],[48,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[48,"يا مريضا زاد قلبي مرضا","https://www.aldiwan.net/poem64366.html","الرمل"],[50,"طال ليلي وبات قلبي جناحا","https://www.aldiwan.net/poem63974.html","الخفيف"],[46,"أما الحقيقة فهي أني ذاهب","https://www.aldiwan.net/poem23058.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85323","البسيط"],[81,"","https://poetry.dctabudhabi.ae/diwan/poem/11530","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"ذكرى فنان!","https://www.poetsgate.com/ViewPoem.aspx?id=179489",""],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[116,"يا مرسلاً لاذ الورى بجنابه","https://www.aldiwan.net/poem42163.html","الكامل"],[121,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[125,"هشت لمقدمه المدينه","https://www.aldiwan.net/poem23748.html","مجزوء الكامل"],[129,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[129,"ملك بدا ما به زيغ ولا خطل","https://www.aldiwan.net/poem50538.html","البسيط"],[130,"شعشع الخمر وهات","https://www.aldiwan.net/poem67438.html","مجزوء الرمل"],[133,"يا مرسل الزرع إلى السالمه","https://www.aldiwan.net/poem54693.html","عموديه"],[133,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[156,"صولج لامين في عذارين","https://www.aldiwan.net/poem55539.html","المنسرح"],[161,"يا من هو الملجأ والمعقل","https://www.aldiwan.net/poem58721.html","السريع"],[161,"من يقبل الصب من عاذله","https://www.aldiwan.net/poem58779.html","الرمل"],[161,"يزداد هجرا كل ما كلما","https://www.aldiwan.net/poem58866.html","السريع"],[173,"صوت صفير البلبل","https://www.aldiwan.net/poem26279.html","مجزوء الرجز"],[186,"كن من الدنيا على وجل","https://www.aldiwan.net/poem14629.html","المديد"],[198,"لا الأنس أنس ولا الأفراح أفراح","https://www.aldiwan.net/poem39809.html","البسيط"],[198,"إعزف على العود يا معبودي الثاني","https://www.aldiwan.net/poem39888.html","البسيط"],[198,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[200,"يا للغرام ويا لعز بنانه","https://www.aldiwan.net/poem45225.html","الكامل"],[200,"قولوا لهذا الرشا الهاجر","https://www.aldiwan.net/poem45589.html","السريع"],[205,"قل لمولاي يا بديع الزمان","https://www.aldiwan.net/poem53172.html","الخفيف"],[205,"يا مريضا قد أمرض","https://www.aldiwan.net/poem53246.html","مجزوء الخفيف"],[212,"يا ليلة العيد ماذا أنت صانعة","https://www.aldiwan.net/poem46320.html","البسيط"],[222,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[222,"قد رأيت المحال رأي عيان","https://www.aldiwan.net/poem55292.html","الخفيف"],[224,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[233,"يا مرسلا في الدجى من أرض كاظمة","https://www.aldiwan.net/poem14871.html","البسيط"],[233,"يا مرتحلا إلى المصلى غلسا","https://www.aldiwan.net/poem14920.html","الدوبيت"],[260,"يا مريض الجفون عذبت قلبا","https://www.aldiwan.net/poem35502.html","الخفيف"],[299,"لزوال جميع ما أنت رائي","https://www.aldiwan.net/poem36262.html","عموديه"],[321,"يا مراد النفوس يا خير خل","https://www.aldiwan.net/poem67121.html","الخفيف"],[329,"أطرق الشاكي ونام الموجع","https://www.aldiwan.net/poem55030.html","الرمل"],[343,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[354,"يا لائمي بهوى الذي في ذاته","https://www.aldiwan.net/poem40557.html","الكامل"],[362,"ان يكن صبك المتيم قد دل","https://www.aldiwan.net/poem68077.html","الخفيف"],[362,"لا وعينيك والجبين المفدى","https://www.aldiwan.net/poem68122.html","الخفيف"],[365,"قفا معي في هذه المعاهد","https://www.aldiwan.net/poem60949.html","السريع"],[372,"يا مرهف الإسلام في","https://www.aldiwan.net/poem57330.html","مجزوء الكامل"],[378,"يا مريم البكر منك الغوث أطلبه","https://www.aldiwan.net/poem59152.html","البسيط"],[378,"قف بي خليلي واستمح","https://www.aldiwan.net/poem66887.html","مجزوء الكامل"],[378,"يا صاح ما هذي الربا","https://www.aldiwan.net/poem66951.html","مجزوء الكامل"],[378,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[392,"يا مريدين السعاده والتعلم والعباده","https://www.aldiwan.net/poem54447.html","عموديه"],[392,"باسمك الله ابتدى","https://www.aldiwan.net/poem54499.html","عموديه"],[394,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[394,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[417,"ما لها مفرية بيدا فبيدا","https://www.aldiwan.net/poem53936.html","الرمل"],[417,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[430,"يا مري يا بنة طليان أعمدي نظرا","https://www.aldiwan.net/poem40072.html","البسيط"],[433,"هل لركب العراق بعد نجوده","https://www.aldiwan.net/poem12470.html","الخفيف"],[459,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[466,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"],[478,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[478,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[478,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[478,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[501,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[552,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[552,"ليس المشيب بذنب","https://www.aldiwan.net/poem48075.html","المجتث"],[559,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[559,"هذه نفحة عنبر","https://www.aldiwan.net/poem34553.html","مجزوء الرمل"],[559,"يا مرحبا يا مرحبا يا","https://www.aldiwan.net/poem34742.html","الكامل"],[563,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[563,"طيف بلبنان من مصر إلي سرى","https://www.aldiwan.net/poem52958.html","البسيط"],[563,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[587,"جادت عليك من السحاب سواري","https://www.aldiwan.net/poem17533.html","الكامل"]],"verses":[["يا مَريضَ الجُفونِ أمْرَضْتَ قَلْبي","فادّرِكْني فَفي يَدَيْكَ عِلاجي",0,"ج",2,0],["يا مُرسِلَ الأَمثالِ يَضرِبُها","قَد عَزَّ بَعدَكَ مُرسِلُ المَثَلِ",1,"ل",1,0],["يا مُرشِدي جَهلاً إِلى غَيرِهِ","أَغنى عَنِ المِصباحِ ضَوءُ الصَباح",2,"ح",1,0],["يَا مَرحَباً أَلفَاً وَأَلَفا","بِالكَاسِرَاتِ إِلَيَّ طَرفَا",3,"ف",2,1],["يا مرحباً بقدومكم من معشر","حرّ إلى الشرف الرفيع سبوق",4,"ق",1,0],["يا مرجَّىً غير مُجدٍ","وظنيناً غير مخلف",5,"ف",1,0],["يا مُرسِلَ الريحِ جَنوباً وَصَبا","إِن غَضِبَت زَيدٌ فَزِدها غَضَبا",6,"ب",2,1],["يا مرخيا لهوى النفس العنان أفق","واشفق على رمق باق به تودى",7,"د",2,0],["يا مراد الدهر من أعوامه","ما أتى من وفدها أو ذهبا",8,"ب",2,0],["يا مريضا بالمناصب","داؤك الداء العضال",9,"ل",1,1],["يا مُرسِلَ النَظَراتِ في الدُنيا وَما","فيها عَلى ضَجَرٍ وَضيقِ ذِراعِ",10,"ع",1,0],["يَأمُرُ السَيفُ في الرِقابِ وَيَنهى","وَلِمِصرٍ عَلى القَذى إِغضاءُ",11,"ا",2,0],["يَأمُرُ بِالسُلوانِ جَهلاً وَقَد","شاهَدَ ما بَثَّتهُ تِلكَ الدُموع",12,"ع",1,0],["يا مُرُّ يا اِبنَ سُحَيمٍ كَيفَ تَشتِمُني","عَبدٌ لِعَبدٍ لَئيمِ الخالِ مَكرومِ",13,"م",1,1],["يَأمُرنَني بِنَدى مُعاوِيَةَ الَّذي","قادَ اِبنُ خَمسَتِهِ لِكُلِّ لُهامِ",14,"م",1,0],["يا مَرحبا بِالقائِلينَ عَدلا","وَبِالصَلاةِ مَرحباً وَأَهلا",15,"ل",2,1],["يا مرحباً بالورد في إبَّانِه","وبموكبِ الآمالِ في بستانِه",16,"ن",2,1],["يا مرفأَ الروحِ لا تَدَعنِي","بلا دليلٍ ولا مَنار",17,"ر",1,0],["يَا مُرْجِعَ الصُّبْحِ كالمُهْرِ الحَرُونِ إلى","مَكَانِهِ مِنْ زَمَانٍ لَيْلُهُ رَكَدَا",18,"د",2,0],["يا مُرْويَ الرُّمح والأرماحُ ظامئةٌ","من الأسود الضَّواري بالدَّمِ الهَدَرِ",19,"ر",1,0],["يا مربعاً لك في فؤادي مربعُ","أتذلُّ بعدَ ابنِ الضياءِ وتخضعُ",20,"ع",1,1],["يا مُرهِبي دونَ سُلطانٍ يَصولُ بِهِ","وَمُخجِلي دونَ ذَنبٍ لا وَلا زَلَلِ",21,"ل",1,1],["يَأمُرنَني أَن أُخَلّي","مِن راحَتَيَّ حَياتي",22,"ت",2,0],["يا مَريضاً زادَ قَلبي مَرَضا","وَبِرَغمي كانَ ذا لا بِالرِضا",23,"ض",2,1],["يَأمُرونَ المُحِبَّ بِالصَبرِ عَمَّن","قَد بَرى الحُبُّ جِسمَهُ فَاِستَطاحا",24,"ح",2,0],["يا مَرحَباً بِالمَوتِ مِن مُتَنَظِّرٍ","إِن كانَ ثُمَّ تَعارُفٌ وَتَلاقِ",25,"ق",1,0],["يأمرها الجذب أن تَدانى","والدفع يأبى غير النفار",26,"ر",1,0],["يا مَرحَباً بِالوَجدِ في","كَ وَعَلى الصَبرِ العَفا",27,"ف",2,0],["يَا مَرْيَمُ اعْتَزَّي بِفَضْلٍ حُزْتِهِ","جَمُّ الصُّنُوفِ مُنَوَّعُ الآثَارِ",28,"ر",1,0],["يَا مُرْجِعَ المَاضِينَ مِنْ أَرْمَاسِهِمْ","فِي العَصْرِ مَا يَكْفِيهِ لِلأمْتَاعِ",29,"ع",1,1],["يَا مُرِخصاً مِنْ كُلِّ نَفْسٍ مَا غَلاَ","حَاشَا نُفُوسِ العِلْيَةِ النُّبَلاَءِ",30,"ا",2,0],["يَا مَرْحَباً بِالسَّيِّدِ البَطْرِيقِ","رَاعِي الرُّعَاةِ الصَّالِحِ الصَّدِّيقِ",31,"ق",1,1],["يا مَرْتعَ الآرامِ رَنحها الصِّبا","كيف المراتعُ فيكِ والآرام",32,"م",1,0],["يا مرسلَ اللحن؛ يبكينا، ويضحكنا","ويشعل القلب نيرانا، ويطفيه",33,"ي",2,0],["يا مُرُورَ الليلِ كَبرِتْ صَيحَتي","أَسأَلُ التَّقتِيلَ مَن ذا مَدَّ نَبحَك",34,"ك",1,0],["يا مرسلاً لاذ الورى بجنابه","وتمثل الأكوان في أعتابه",35,"ب",2,1],["يا مرحباً بربيعي جنةٍ وهوى","وحبذا من شهور الحول نيسان",36,"ن",1,0],["يا مرحباً بالهر إن","الهبر حليتنا الثمينة",37,"ن",2,0],["يا مريضَ الجفونِ أمرضتَ قلبي","فأعنِّي على علاج شِفائه",38,"ا",3,0],["يا مرشدي خير خلق اللهِ كلِّهمُ","ما ضرني أنني في الودِّ مُنتحلُ",39,"ل",1,0],["يأمُرُ الدَهرَ وَيَنهاهُ","بِبُهتانٍ وزُور",40,"ر",1,0],["يَا مُرسِلَ الزَّرعِ إلى السَّالِمَه","ظَلَمتَ لَم تَكُن هِىَّ الظَّالِمَه",41,"ه",1,1],["يَا مُرِيدَ المُريدَ سَوفَ تَرَقَّى","فَتُرَى زَائِغاُ مرِيداً رَجِيمَا",42,"م",2,0],["يَا مُرْهَفَيْ مُقْلَتَيْهِ دُونَكُما","قَلْبِي فَقُدَّاهُ نِصْفَيْنِ",43,"ن",1,0],["يأمركم أن تنقضوا قولكم","حاشاكمُ من ذا أَن تبخلوا",44,"ل",3,0],["يأمر الصب وينهى الهوى","قد تغشاه بما يشمله",45,"ل",2,0],["يا مرسلاً في الغيد ألحاظه","إِن الدما يعتدنَ سفك الدما",46,"م",2,0],["يَأْمُرُلِي بِخَلْعَةٍ","حَمراء كَالدَم دَمَلي",47,"ل",2,0],["يا مريضاً لم يجد أَلما","أنت لو تدرِي أبو العِلل",48,"ل",1,0],["يا مرتع الروح يا ملهى طفولتنا","إني إليك وربّ البيت جنّاح",49,"ح",1,0],["يا مرتع الروح والأشجان ثائرة","إني على العهد ما كرّ الجديدان",50,"ن",1,0],["يا مرحبا بك يا بش","ر الوصل والفضل العميم",51,"م",1,0],["يا مريَ زيديني هوىً فهواكِ نو","رٌ لم أزل أسري على مشكاتهِ",52,"ت",2,0],["يا مرهفَ الأعطافِ ماذا الذي","ترهفهُ من لحظكَ الساحرِ",53,"ر",1,0],["يا مريض الجفون أمرضتَ جسمي","مرضاً من تمرُّض الأجفانِ",54,"ن",1,0],["يا مريضاً قد أمرَضَ ال","حُسنَ والظَّرفَ والوفا",55,"ف",2,1],["يا مرسل العيد ما شاءت عواطفهُ","ولو أراد قضيت العمر في عيد",56,"د",1,0],["يأمر شلاله فيزكي","الزرع والضرع والثمر",57,"ر",1,0],["يأمر الماء بالوقوف فينصا","ع وإن شاء لج في الجريان",58,"ن",1,0],["يا مَرهَماً لِقَلبِيَ المَوجوعِ","يا مَلَكاً يَطوفُ في دُموعي",59,"ي",1,0],["يا مُرسِلاً في الدُجى مِن أَرضِ كاظِمَةٍ","خَيالُهُ مُعرِضاً عَنّي بِلا سَبَبِ",60,"ب",1,1],["يا مُرتَحِلاً إِلى المُصَلّى غَلَسا","إِن جُزتَ بِساكِنِ الحِمى قِف نَفَسا",61,"س",2,1],["يا مريض الجفون عذّبت قلباً","لم يبت قطّ من هواك خليّا",62,"ي",2,1],["يأْمرُ اللبُّ بالتصبرِ لكنْ","ليس يقضي بسلوةٍ بلهاءِ",63,"ا",2,0],["يا مُرادَ النُفوسِ يا خَيرَ خِلٍّ","زانَ بِاللُطفِ حِليَةَ الأَمجادِ",64,"د",1,1],["يا مريض العمر عجل دفنه","قبل أن تعشيك أضواء الحياه",65,"ه",1,0],["يا مربع السحر","وموطن الاحلام",66,"م",1,0],["يا مَرحَباً بِحبيبنا وَصِفاتِهِ","تَاللَهِ ما راب الجَميل بِصَدِّهِ",67,"ه",1,0],["يا مُرادي وَاِنظُر بِلُطف اِلَيهِ","وَتُبصِر في حالِهِ وَتَأَمّل",68,"ل",1,0],["يا مُرادي بِاللَهِ أَعرَضت عَن عَب","دِكَ هُزلا أَم أَنتَ أَعرَضت جَدّا",69,"د",2,0],["يا مُرْضِيَ الآمالِ بالمالِ ندىً","ومُكرِمَ القُصّادِ والقصائد",70,"د",1,0],["يا مُرهفَ الإسلامِ في","قَولي وإجماعِ الجَماعَه",71,"ع",2,1],["يا مريمُ البِكرُ منكِ الغوثَ أطلبُهُ","لأجل كُثْر مراحمْك فإنيَ عيْ",72,"ي",1,1],["يا مريمُ البكرُ من عهد الصبا شغفاً","خرجتُ أرجو الهدى منك لأنيَ غيْ",72,"ي",1,0],["يا مريم البكر جثماني وعافيتي","والعمر أودعتها فيك وفيك حُيَي",72,"ي",1,0],["يا مريم البكر ضوءُ الحلم يدركني","ينيرني في دجى الدنيا فلستُ بشي",72,"ي",1,0],["يا مريم البكر لا زالت عجائبُها","أستشعر الغوث منها لي كغيث الري",72,"ي",1,0],["يا مريم البكر أمَّ اللَهِ فيك نجا","كل الملائك والناس اشفعي بيَ كي",72,"ي",1,0],["يا مريم البكر غُوثيني بمكرمةٍ","وسكِّني بالدوا آلامَ داء الكَي",72,"ي",1,0],["يا مريم البكر كوني اليوم سامعةً","صلاتنا واقبلي مني بُكا عينَي",72,"ي",1,0],["يا مريم البكر فيك عيشنا أبداً","وفوزنا وهنانا والثناء الحي",72,"ي",1,0],["يا مريم البكر من يدعُ اسمَكِ أبداً","في ضره فاز بالإنعام بعدَ الطي",72,"ي",1,0],["يا مريم البكر أنت العونُ في خطرٍ","وكل ضيقٍ وأمرٍ قد يشُقُّ علَي",72,"ي",1,0],["يا مريم البكر إشفي كلَّ منسحقٍ","قلباً بِطبِّ حنوٍّ جاز منك إلَي",72,"ي",1,0],["يا مريم البكر التي","مَن أَمَّها يوماً رجح",73,"ح",1,0],["يا مريمُ البكرُ التي","أضواؤها لن تَغربا",74,"ب",2,0],["يا مريمُ البِكرُ ارحَميني إِنَّني","شَوقي أمامي والقَضاءُ وَرائي",75,"ي",1,0],["يا مريمُ البكرُ ارحَمينِ بنَظرَةٍ","كيما أراكِ ولاتَ حينَ فَنائي",75,"ي",1,0],["يا مريمُ البكرُ اِرحَمينِ بنعمةٍ","في مأربي مَع أَزمَتي وَعنائي",75,"ي",1,0],["يا مريدين السعاده والتعلم والعباده","اطلبوها باجتهاد ما على جده زياده",76,"د",2,1],["يأمر الناس بالتقى","والصلاة وبالصيام",77,"م",1,0],["يا مَرحَباً اِذ ظَل يَردي مَرحباً","وَالجَيش بَينَ مكبِّرٍ وَمُهَلِّل",78,"ل",1,0],["يا مَرحبَ الكفرِ مَن أَذاقَكَ مِن","حَرِّ الظُبا ما كَرهتَ سُقياه",79,"ا",2,0],["يا مريد الخير والخير به","لا عدمناك مراداً ومريدا",80,"د",2,0],["يأمُرُ القلبَ بالسلوّ ومن لي","بفؤادٍ يُرضيه أن يتسلّى",81,"ل",2,0],["يا مري يا بنة طليان أعمدي نظراً","يا أخت هاروت سحراً فاتقي اللَه",82,"ه",1,1],["يا مريضَ الجفونث من غير سُقمٍ","والذي يُمرِضُ القلوبَ بجيدِه",83,"د",2,0],["يا مرسَلاً إن كنت مُبلغَ ميِّتٍ","تحت الصفائح قولَ حيٍّ مرسِلِ",84,"ل",1,0],["يا مَرقَدَ السَّيِّدِ المَعصوم..يا ألَقا ً","مِن الشَّهادَةِ يَحمي كلَّ مِسكين ِ",85,"ن",1,0],["يا مربعاً قبلَ أن تنأى جآذِرُه","قد كانَ مألَفَ اِصداري واِيرادي",86,"د",2,0],["يا مربعَ الأحبابِ كم مِن وقفةٍ","لي في عراصِكَ بينَ تلكَ الأربعِ",87,"ع",1,0],["يا مربعاً راعَ الفِرا","ق ظبيه والجؤذرا",88,"ر",2,0],["يا مُرخصي الدمعَ هذى الورقُ ساجعةٌ","في البانِ تُظهِرُ مِن تطريبها عَجَبا",89,"ب",2,0],["يا مُريدي سِرْ على هذا القَدَمْ","فهو واللهِ أَمينُ العاقِبهْ",90,"ه",1,0],["يا مُرَّةً وَيظنّ ذائقُها","أبَدَ الزّمانِ بأنّها شَهْدُ",91,"د",1,0],["يا مُرّةَ الظُّلمِ طَعماً","وَحُلْوَةَ الظَّلمِ شِرْبا",92,"ب",2,0],["يا مرادي حين قلت ويا","جلَّ قصدي حين لم أقل",93,"ل",1,0],["يا مريض النفس عنك ال","عارف النحرير أخبر",94,"ر",1,0],["يا مرحبا يا مرحبا يا مرحبا","هذا الحبيب أتى وكان مغيَّبا",95,"ب",2,1],["يا مِراض الجُفُونِ لم تتركي من","نا صحيحاً وما لَنا منكِ راقِ",96,"ق",1,0],["يا مُرسِلَ الطَّيفِ لو علَّمْتهُ كَرَماً","أُنْسَ اللقاءِ كما علَّمتَني السَهَرا",97,"ر",2,0],["يا مرِيضَ الجفونِ ليسَ عليها","حَرَجٌ تتَّقيهِ في كلِّ مِلّهْ",98,"ل",2,0],["يأمر فيه الناس بالوصايا","عن تركوا خيرا من العطايا",99,"ي",2,0],["يأمر بالتقديم والتأخير","عليه والعزل وبالتأمير",99,"ر",1,0],["يا مَرضاً صِرتُ به","في منزلي مُغْتَرِبَا",100,"ب",2,0],["يا مَرْبَعَ الأطراب والأَتْرابِ بَلْ","يَا مَرْبَعَ الأَنْواءِ وَالأَنْوَارِ",101,"ر",1,0]]}