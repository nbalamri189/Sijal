{"poems":[[77,"يا سراج الجمال يا ابن سراج","https://www.aldiwan.net/poem36668.html","الخفيف"],[86,"لله درك كنت من رجل","https://www.aldiwan.net/poem10491.html","أحذ الكامل"],[73,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[41,"يا مرحبا ألفا وألفا","https://www.aldiwan.net/poem42252.html","مجزوء الكامل"],[88,"من مبسم الغازي إلى الفاروق","https://www.aldiwan.net/poem44800.html","الكامل"],[51,"يا أبا إسحاق واقلب","https://www.aldiwan.net/poem65439.html","مجزوء الرمل"],[29,"يا مرسل الريح جنوبا وصبا","https://www.aldiwan.net/poem6196.html","الرجز"],[85,"قالوا الخليفة في فاس أحق بها","https://www.aldiwan.net/poem7518.html","البسيط"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[85,"يا مريضا بالمناصب","https://www.aldiwan.net/poem7766.html","مجزوء الرمل"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[28,"يا مر يا ابن سحيم كيف تشتمني","https://www.aldiwan.net/poem5498.html","البسيط"],[28,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[58,"يا مرحبا بالقائلين عدلا","https://www.aldiwan.net/poem30884.html","الرجز"],[97,"يا مرحباً بالورد في إبانه","https://www.aldiwan.net/poem24351.html","الكامل"],[97,"نار من الشوق إثر نار","https://www.aldiwan.net/poem24922.html","مجزوء البسيط"],[80,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[69,"يا مربعا لك في فؤادي مربع","https://www.aldiwan.net/poem28365.html","الكامل"],[81,"يا مرهبي دون سلطان يصول به","https://www.aldiwan.net/poem61499.html","البسيط"],[48,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[48,"يا مريضا زاد قلبي مرضا","https://www.aldiwan.net/poem64366.html","الرمل"],[50,"طال ليلي وبات قلبي جناحا","https://www.aldiwan.net/poem63974.html","الخفيف"],[46,"أما الحقيقة فهي أني ذاهب","https://www.aldiwan.net/poem23058.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85323","البسيط"],[81,"","https://poetry.dctabudhabi.ae/diwan/poem/11530","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"ذكرى فنان!","https://www.poetsgate.com/ViewPoem.aspx?id=179489",""],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[113,"يا مرسلاً لاذ الورى بجنابه","https://www.aldiwan.net/poem42163.html","الكامل"],[118,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[122,"هشت لمقدمه المدينه","https://www.aldiwan.net/poem23748.html","مجزوء الكامل"],[126,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[126,"ملك بدا ما به زيغ ولا خطل","https://www.aldiwan.net/poem50538.html","البسيط"],[127,"شعشع الخمر وهات","https://www.aldiwan.net/poem67438.html","مجزوء الرمل"],[130,"يا مرسل الزرع إلى السالمه","https://www.aldiwan.net/poem54693.html","عموديه"],[130,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[153,"صولج لامين في عذارين","https://www.aldiwan.net/poem55539.html","المنسرح"],[158,"يا من هو الملجأ والمعقل","https://www.aldiwan.net/poem58721.html","السريع"],[158,"من يقبل الصب من عاذله","https://www.aldiwan.net/poem58779.html","الرمل"],[158,"يزداد هجرا كل ما كلما","https://www.aldiwan.net/poem58866.html","السريع"],[170,"صوت صفير البلبل","https://www.aldiwan.net/poem26279.html","مجزوء الرجز"],[183,"كن من الدنيا على وجل","https://www.aldiwan.net/poem14629.html","المديد"],[195,"لا الأنس أنس ولا الأفراح أفراح","https://www.aldiwan.net/poem39809.html","البسيط"],[195,"إعزف على العود يا معبودي الثاني","https://www.aldiwan.net/poem39888.html","البسيط"],[195,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[197,"يا للغرام ويا لعز بنانه","https://www.aldiwan.net/poem45225.html","الكامل"],[197,"قولوا لهذا الرشا الهاجر","https://www.aldiwan.net/poem45589.html","السريع"],[202,"قل لمولاي يا بديع الزمان","https://www.aldiwan.net/poem53172.html","الخفيف"],[202,"يا مريضا قد أمرض","https://www.aldiwan.net/poem53246.html","مجزوء الخفيف"],[209,"يا ليلة العيد ماذا أنت صانعة","https://www.aldiwan.net/poem46320.html","البسيط"],[219,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[219,"قد رأيت المحال رأي عيان","https://www.aldiwan.net/poem55292.html","الخفيف"],[221,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[230,"يا مرسلا في الدجى من أرض كاظمة","https://www.aldiwan.net/poem14871.html","البسيط"],[230,"يا مرتحلا إلى المصلى غلسا","https://www.aldiwan.net/poem14920.html","الدوبيت"],[257,"يا مريض الجفون عذبت قلبا","https://www.aldiwan.net/poem35502.html","الخفيف"],[296,"لزوال جميع ما أنت رائي","https://www.aldiwan.net/poem36262.html","عموديه"],[318,"يا مراد النفوس يا خير خل","https://www.aldiwan.net/poem67121.html","الخفيف"],[326,"أطرق الشاكي ونام الموجع","https://www.aldiwan.net/poem55030.html","الرمل"],[340,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[351,"يا لائمي بهوى الذي في ذاته","https://www.aldiwan.net/poem40557.html","الكامل"],[359,"ان يكن صبك المتيم قد دل","https://www.aldiwan.net/poem68077.html","الخفيف"],[359,"لا وعينيك والجبين المفدى","https://www.aldiwan.net/poem68122.html","الخفيف"],[362,"قفا معي في هذه المعاهد","https://www.aldiwan.net/poem60949.html","السريع"],[369,"يا مرهف الإسلام في","https://www.aldiwan.net/poem57330.html","مجزوء الكامل"],[374,"يا مريم البكر منك الغوث أطلبه","https://www.aldiwan.net/poem59152.html","البسيط"],[374,"قف بي خليلي واستمح","https://www.aldiwan.net/poem66887.html","مجزوء الكامل"],[374,"يا صاح ما هذي الربا","https://www.aldiwan.net/poem66951.html","مجزوء الكامل"],[374,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[388,"يا مريدين السعاده والتعلم والعباده","https://www.aldiwan.net/poem54447.html","عموديه"],[388,"باسمك الله ابتدى","https://www.aldiwan.net/poem54499.html","عموديه"],[390,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[390,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[413,"ما لها مفرية بيدا فبيدا","https://www.aldiwan.net/poem53936.html","الرمل"],[413,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[426,"يا مري يا بنة طليان أعمدي نظرا","https://www.aldiwan.net/poem40072.html","البسيط"],[429,"هل لركب العراق بعد نجوده","https://www.aldiwan.net/poem12470.html","الخفيف"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[475,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[475,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[475,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[475,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[498,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[549,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[549,"ليس المشيب بذنب","https://www.aldiwan.net/poem48075.html","المجتث"],[556,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[556,"هذه نفحة عنبر","https://www.aldiwan.net/poem34553.html","مجزوء الرمل"],[556,"يا مرحبا يا مرحبا يا","https://www.aldiwan.net/poem34742.html","الكامل"],[560,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[560,"طيف بلبنان من مصر إلي سرى","https://www.aldiwan.net/poem52958.html","البسيط"],[560,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[584,"جادت عليك من السحاب سواري","https://www.aldiwan.net/poem17533.html","الكامل"]],"verses":[["يا مَريضَ الجُفونِ أمْرَضْتَ قَلْبي","فادّرِكْني فَفي يَدَيْكَ عِلاجي",0,"ي",1,0],["يا مُرسِلَ الأَمثالِ يَضرِبُها","قَد عَزَّ بَعدَكَ مُرسِلُ المَثَلِ",1,"ل",1,0],["يا مُرشِدي جَهلاً إِلى غَيرِهِ","أَغنى عَنِ المِصباحِ ضَوءُ الصَباح",2,"ح",1,0],["يَا مَرحَباً أَلفَاً وَأَلَفا","بِالكَاسِرَاتِ إِلَيَّ طَرفَا",3,"ف",2,1],["يا مرحباً بقدومكم من معشر","حرّ إلى الشرف الرفيع سبوق",4,"ق",1,0],["يا مرجَّىً غير مُجدٍ","وظنيناً غير مخلف",5,"ف",1,0],["يا مُرسِلَ الريحِ جَنوباً وَصَبا","إِن غَضِبَت زَيدٌ فَزِدها غَضَبا",6,"ب",2,1],["يا مرخيا لهوى النفس العنان أفق","واشفق على رمق باق به تودى",7,"د",2,0],["يا مراد الدهر من أعوامه","ما أتى من وفدها أو ذهبا",8,"ب",2,0],["يا مريضا بالمناصب","داؤك الداء العضال",9,"ل",1,1],["يا مُرسِلَ النَظَراتِ في الدُنيا وَما","فيها عَلى ضَجَرٍ وَضيقِ ذِراعِ",10,"ع",1,0],["يَأمُرُ السَيفُ في الرِقابِ وَيَنهى","وَلِمِصرٍ عَلى القَذى إِغضاءُ",11,"ا",2,0],["يَأمُرُ بِالسُلوانِ جَهلاً وَقَد","شاهَدَ ما بَثَّتهُ تِلكَ الدُموع",12,"ع",1,0],["يا مُرُّ يا اِبنَ سُحَيمٍ كَيفَ تَشتِمُني","عَبدٌ لِعَبدٍ لَئيمِ الخالِ مَكرومِ",13,"م",1,1],["يَأمُرنَني بِنَدى مُعاوِيَةَ الَّذي","قادَ اِبنُ خَمسَتِهِ لِكُلِّ لُهامِ",14,"م",1,0],["يا مَرحبا بِالقائِلينَ عَدلا","وَبِالصَلاةِ مَرحباً وَأَهلا",15,"ل",2,1],["يا مرحباً بالورد في إبَّانِه","وبموكبِ الآمالِ في بستانِه",16,"ن",2,1],["يا مرفأَ الروحِ لا تَدَعنِي","بلا دليلٍ ولا مَنار",17,"ر",1,0],["يا مُرْويَ الرُّمح والأرماحُ ظامئةٌ","من الأسود الضَّواري بالدَّمِ الهَدَرِ",18,"ر",1,0],["يا مربعاً لك في فؤادي مربعُ","أتذلُّ بعدَ ابنِ الضياءِ وتخضعُ",19,"ع",1,1],["يا مُرهِبي دونَ سُلطانٍ يَصولُ بِهِ","وَمُخجِلي دونَ ذَنبٍ لا وَلا زَلَلِ",20,"ل",1,1],["يَأمُرنَني أَن أُخَلّي","مِن راحَتَيَّ حَياتي",21,"ي",1,0],["يا مَريضاً زادَ قَلبي مَرَضا","وَبِرَغمي كانَ ذا لا بِالرِضا",22,"ض",2,1],["يَأمُرونَ المُحِبَّ بِالصَبرِ عَمَّن","قَد بَرى الحُبُّ جِسمَهُ فَاِستَطاحا",23,"ح",2,0],["يا مَرحَباً بِالمَوتِ مِن مُتَنَظِّرٍ","إِن كانَ ثُمَّ تَعارُفٌ وَتَلاقِ",24,"ق",1,0],["يأمرها الجذب أن تَدانى","والدفع يأبى غير النفار",25,"ر",1,0],["يا مَرحَباً بِالوَجدِ في","كَ وَعَلى الصَبرِ العَفا",26,"ف",2,0],["يَا مَرْيَمُ اعْتَزَّي بِفَضْلٍ حُزْتِهِ","جَمُّ الصُّنُوفِ مُنَوَّعُ الآثَارِ",27,"ر",1,0],["يَا مُرْجِعَ المَاضِينَ مِنْ أَرْمَاسِهِمْ","فِي العَصْرِ مَا يَكْفِيهِ لِلأمْتَاعِ",28,"ع",1,1],["يَا مُرِخصاً مِنْ كُلِّ نَفْسٍ مَا غَلاَ","حَاشَا نُفُوسِ العِلْيَةِ النُّبَلاَءِ",29,"ا",2,0],["يَا مَرْحَباً بِالسَّيِّدِ البَطْرِيقِ","رَاعِي الرُّعَاةِ الصَّالِحِ الصَّدِّيقِ",30,"ق",1,1],["يا مَرْتعَ الآرامِ رَنحها الصِّبا","كيف المراتعُ فيكِ والآرام",31,"م",1,0],["يا مرسلَ اللحن؛ يبكينا، ويضحكنا","ويشعل القلب نيرانا، ويطفيه",32,"ي",2,0],["يا مُرُورَ الليلِ كَبرِتْ صَيحَتي","أَسأَلُ التَّقتِيلَ مَن ذا مَدَّ نَبحَك",33,"ك",1,0],["يا مرسلاً لاذ الورى بجنابه","وتمثل الأكوان في أعتابه",34,"ب",2,1],["يا مرحباً بربيعي جنةٍ وهوى","وحبذا من شهور الحول نيسان",35,"ن",1,0],["يا مرحباً بالهر إن","الهبر حليتنا الثمينة",36,"ن",2,0],["يا مريضَ الجفونِ أمرضتَ قلبي","فأعنِّي على علاج شِفائه",37,"ا",3,0],["يا مرشدي خير خلق اللهِ كلِّهمُ","ما ضرني أنني في الودِّ مُنتحلُ",38,"ل",1,0],["يأمُرُ الدَهرَ وَيَنهاهُ","بِبُهتانٍ وزُور",39,"ر",1,0],["يَا مُرسِلَ الزَّرعِ إلى السَّالِمَه","ظَلَمتَ لَم تَكُن هِىَّ الظَّالِمَه",40,"ه",1,1],["يَا مُرِيدَ المُريدَ سَوفَ تَرَقَّى","فَتُرَى زَائِغاُ مرِيداً رَجِيمَا",41,"م",2,0],["يَا مُرْهَفَيْ مُقْلَتَيْهِ دُونَكُما","قَلْبِي فَقُدَّاهُ نِصْفَيْنِ",42,"ن",1,0],["يأمركم أن تنقضوا قولكم","حاشاكمُ من ذا أَن تبخلوا",43,"ل",3,0],["يأمر الصب وينهى الهوى","قد تغشاه بما يشمله",44,"ل",2,0],["يا مرسلاً في الغيد ألحاظه","إِن الدما يعتدنَ سفك الدما",45,"م",2,0],["يَأْمُرُلِي بِخَلْعَةٍ","حَمراء كَالدَم دَمَلي",46,"ي",1,0],["يا مريضاً لم يجد أَلما","أنت لو تدرِي أبو العِلل",47,"ل",1,0],["يا مرتع الروح يا ملهى طفولتنا","إني إليك وربّ البيت جنّاح",48,"ح",1,0],["يا مرتع الروح والأشجان ثائرة","إني على العهد ما كرّ الجديدان",49,"ن",1,0],["يا مرحبا بك يا بش","ر الوصل والفضل العميم",50,"م",1,0],["يا مريَ زيديني هوىً فهواكِ نو","رٌ لم أزل أسري على مشكاتهِ",51,"ت",2,0],["يا مرهفَ الأعطافِ ماذا الذي","ترهفهُ من لحظكَ الساحرِ",52,"ر",1,0],["يا مريض الجفون أمرضتَ جسمي","مرضاً من تمرُّض الأجفانِ",53,"ن",1,0],["يا مريضاً قد أمرَضَ ال","حُسنَ والظَّرفَ والوفا",54,"ف",2,1],["يا مرسل العيد ما شاءت عواطفهُ","ولو أراد قضيت العمر في عيد",55,"د",1,0],["يأمر شلاله فيزكي","الزرع والضرع والثمر",56,"ر",1,0],["يأمر الماء بالوقوف فينصا","ع وإن شاء لج في الجريان",57,"ن",1,0],["يا مَرهَماً لِقَلبِيَ المَوجوعِ","يا مَلَكاً يَطوفُ في دُموعي",58,"ي",1,0],["يا مُرسِلاً في الدُجى مِن أَرضِ كاظِمَةٍ","خَيالُهُ مُعرِضاً عَنّي بِلا سَبَبِ",59,"ب",1,1],["يا مُرتَحِلاً إِلى المُصَلّى غَلَسا","إِن جُزتَ بِساكِنِ الحِمى قِف نَفَسا",60,"س",2,1],["يا مريض الجفون عذّبت قلباً","لم يبت قطّ من هواك خليّا",61,"ي",2,1],["يأْمرُ اللبُّ بالتصبرِ لكنْ","ليس يقضي بسلوةٍ بلهاءِ",62,"ا",2,0],["يا مُرادَ النُفوسِ يا خَيرَ خِلٍّ","زانَ بِاللُطفِ حِليَةَ الأَمجادِ",63,"د",1,1],["يا مريض العمر عجل دفنه","قبل أن تعشيك أضواء الحياه",64,"ه",1,0],["يا مربع السحر","وموطن الاحلام",65,"م",1,0],["يا مَرحَباً بِحبيبنا وَصِفاتِهِ","تَاللَهِ ما راب الجَميل بِصَدِّهِ",66,"ه",1,0],["يا مُرادي وَاِنظُر بِلُطف اِلَيهِ","وَتُبصِر في حالِهِ وَتَأَمّل",67,"ل",1,0],["يا مُرادي بِاللَهِ أَعرَضت عَن عَب","دِكَ هُزلا أَم أَنتَ أَعرَضت جَدّا",68,"د",2,0],["يا مُرْضِيَ الآمالِ بالمالِ ندىً","ومُكرِمَ القُصّادِ والقصائد",69,"د",1,0],["يا مُرهفَ الإسلامِ في","قَولي وإجماعِ الجَماعَه",70,"ع",2,1],["يا مريمُ البِكرُ منكِ الغوثَ أطلبُهُ","لأجل كُثْر مراحمْك فإنيَ عيْ",71,"ي",1,1],["يا مريمُ البكرُ من عهد الصبا شغفاً","خرجتُ أرجو الهدى منك لأنيَ غيْ",71,"ي",1,0],["يا مريم البكر جثماني وعافيتي","والعمر أودعتها فيك وفيك حُيَي",71,"ي",1,0],["يا مريم البكر ضوءُ الحلم يدركني","ينيرني في دجى الدنيا فلستُ بشي",71,"ي",1,0],["يا مريم البكر لا زالت عجائبُها","أستشعر الغوث منها لي كغيث الري",71,"ي",1,0],["يا مريم البكر أمَّ اللَهِ فيك نجا","كل الملائك والناس اشفعي بيَ كي",71,"ي",1,0],["يا مريم البكر غُوثيني بمكرمةٍ","وسكِّني بالدوا آلامَ داء الكَي",71,"ي",1,0],["يا مريم البكر كوني اليوم سامعةً","صلاتنا واقبلي مني بُكا عينَي",71,"ي",1,0],["يا مريم البكر فيك عيشنا أبداً","وفوزنا وهنانا والثناء الحي",71,"ي",1,0],["يا مريم البكر من يدعُ اسمَكِ أبداً","في ضره فاز بالإنعام بعدَ الطي",71,"ي",1,0],["يا مريم البكر أنت العونُ في خطرٍ","وكل ضيقٍ وأمرٍ قد يشُقُّ علَي",71,"ي",1,0],["يا مريم البكر إشفي كلَّ منسحقٍ","قلباً بِطبِّ حنوٍّ جاز منك إلَي",71,"ي",1,0],["يا مريم البكر التي","مَن أَمَّها يوماً رجح",72,"ح",1,0],["يا مريمُ البكرُ التي","أضواؤها لن تَغربا",73,"ب",2,0],["يا مريمُ البِكرُ ارحَميني إِنَّني","شَوقي أمامي والقَضاءُ وَرائي",74,"ي",1,0],["يا مريمُ البكرُ ارحَمينِ بنَظرَةٍ","كيما أراكِ ولاتَ حينَ فَنائي",74,"ي",1,0],["يا مريمُ البكرُ اِرحَمينِ بنعمةٍ","في مأربي مَع أَزمَتي وَعنائي",74,"ي",1,0],["يا مريدين السعاده والتعلم والعباده","اطلبوها باجتهاد ما على جده زياده",75,"د",2,1],["يأمر الناس بالتقى","والصلاة وبالصيام",76,"م",1,0],["يا مَرحَباً اِذ ظَل يَردي مَرحباً","وَالجَيش بَينَ مكبِّرٍ وَمُهَلِّل",77,"ل",1,0],["يا مَرحبَ الكفرِ مَن أَذاقَكَ مِن","حَرِّ الظُبا ما كَرهتَ سُقياه",78,"ا",2,0],["يا مريد الخير والخير به","لا عدمناك مراداً ومريدا",79,"د",2,0],["يأمُرُ القلبَ بالسلوّ ومن لي","بفؤادٍ يُرضيه أن يتسلّى",80,"ل",2,0],["يا مري يا بنة طليان أعمدي نظراً","يا أخت هاروت سحراً فاتقي اللَه",81,"ه",1,1],["يا مريضَ الجفونث من غير سُقمٍ","والذي يُمرِضُ القلوبَ بجيدِه",82,"د",2,0],["يا مرسَلاً إن كنت مُبلغَ ميِّتٍ","تحت الصفائح قولَ حيٍّ مرسِلِ",83,"ل",1,0],["يا مربعاً قبلَ أن تنأى جآذِرُه","قد كانَ مألَفَ اِصداري واِيرادي",84,"ي",1,0],["يا مربعَ الأحبابِ كم مِن وقفةٍ","لي في عراصِكَ بينَ تلكَ الأربعِ",85,"ع",1,0],["يا مربعاً راعَ الفِرا","ق ظبيه والجؤذرا",86,"ر",2,0],["يا مُرخصي الدمعَ هذى الورقُ ساجعةٌ","في البانِ تُظهِرُ مِن تطريبها عَجَبا",87,"ب",2,0],["يا مُريدي سِرْ على هذا القَدَمْ","فهو واللهِ أَمينُ العاقِبهْ",88,"ه",1,0],["يا مُرَّةً وَيظنّ ذائقُها","أبَدَ الزّمانِ بأنّها شَهْدُ",89,"د",1,0],["يا مُرّةَ الظُّلمِ طَعماً","وَحُلْوَةَ الظَّلمِ شِرْبا",90,"ب",2,0],["يا مرادي حين قلت ويا","جلَّ قصدي حين لم أقل",91,"ل",1,0],["يا مريض النفس عنك ال","عارف النحرير أخبر",92,"ر",1,0],["يا مرحبا يا مرحبا يا مرحبا","هذا الحبيب أتى وكان مغيَّبا",93,"ب",2,1],["يا مِراض الجُفُونِ لم تتركي من","نا صحيحاً وما لَنا منكِ راقِ",94,"ق",1,0],["يا مُرسِلَ الطَّيفِ لو علَّمْتهُ كَرَماً","أُنْسَ اللقاءِ كما علَّمتَني السَهَرا",95,"ر",2,0],["يا مرِيضَ الجفونِ ليسَ عليها","حَرَجٌ تتَّقيهِ في كلِّ مِلّهْ",96,"ل",2,0],["يأمر فيه الناس بالوصايا","عن تركوا خيرا من العطايا",97,"ي",2,0],["يأمر بالتقديم والتأخير","عليه والعزل وبالتأمير",97,"ر",1,0],["يا مَرضاً صِرتُ به","في منزلي مُغْتَرِبَا",98,"ب",2,0],["يا مَرْبَعَ الأطراب والأَتْرابِ بَلْ","يَا مَرْبَعَ الأَنْواءِ وَالأَنْوَارِ",99,"ر",1,0]]}