habi.ae/diwan/poem/141966","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199493","المتقارب"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116996","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23663","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142337","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[106,"أنا وابناي","https://www.poetsgate.com/ViewPoem.aspx?id=179447",""],[106,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[77,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[96,"إمرأة وشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=17498",""],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[11,"أرَسْماً جديداً، من نَوَارَ، تعَرّفُ","https://www.poetsgate.com/ViewPoem.aspx?id=16863",""],[90,"النفثة!","https://www.poetsgate.com/ViewPoem.aspx?id=179076",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[45,"تروح رواحا على أبلق","https://www.poetsgate.com/ViewPoem.aspx?id=33085",""],[45,"ألَمّتْ، وَهَلْ إلمامُها لكَ نَافِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=31221",""],[99,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""],[99,"صباح السكر","https://www.poetsgate.com/ViewPoem.aspx?id=577",""],[51,"مستبعدٌ هيهات إعتاقُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29920",""],[51,"أيَّها السيدُ الذي فاق في الجو","https://www.poetsgate.com/ViewPoem.aspx?id=30451",""],[39,"لَحَى اللَّهُ قَوْماً أَسْلَمُوا يَوْمَ بَابِلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=4265",""],[74,"وأغيدَ في صدر النديّ لحسنهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13969&r=&rc=10",""],[88,"تجنب من سقيم الرأي قرباً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19584&r=&rc=87",""]],"verses":[["وَأَغدو عَلى رَيعانِ خَيلٍ تَلُفُّها","صُدورُ القَنا وَالنَقعُ عالٍ أَحَمُّهُ",0,"م",2,0],["وَأَغارُ اليَومَ إِن مَر","رَ عَلى فيكَ اللِثامُ",1,"م",1,0],["وَأَغبَطُ رَحلَ الهَمِّ في ظَهرِ عَزمَةٍ","مُواشِكَةٍ مِن عَجرَفٍ وَنِقالِ",2,"ل",1,0],["وَأُغضي عَنِ الأَقدارِ وَهيَ تَنوبُني","وَما نَظَري عِندَ الأُمورِ كَليلُ",3,"ل",1,0],["وَأُغمِدَت عَنكَ نُصو","لُ الأَعيُنِ القَواتِلُ",4,"ل",1,0],["وَاِغتَنِمها قَبلَ الفِراقِ فَما تَع","لَمُ يَوماً مَتى يَكونُ التَلاقي",5,"ق",2,0],["وَإِغمادُكَ الأَسيافَ في كُلِّ هامَةٍ","وَرَكزُكَ أَطرافَ القَنا في الحَمالِقِ",6,"ق",1,0],["وَأَغضَيتُ اللَواحِظَ عَن ذُنوبٍ","وَمَوضِعُها لِعَيني غَيرُ خافِ",7,"ف",1,0],["وَأَغَرَّ مُختَلِسٍ مَكارِمَهُ","إِنَّ الكَريمِ يَرى النَدى خُلَسا",8,"س",2,0],["وَأَغدوا عَلى آثارِهِم وَوَدادَتي","لَوَ أَنَّهُمُ الغادونَ بَعدي عَلى إِثري",9,"ر",2,0],["وَأَغَرِّ الخَلقِ وَالخُلقُ لَهُ","نَسَبٌ رُدِّدَ في السَيفِ مِرارا",10,"ر",2,0],["وَأَغبِطُ كُلَّ فَتىً لا يَزالُ","عِبئاً عَلى الزاعِباتِ القِماحِ",11,"ح",1,0],["وَأَغزَرِهِم إِذا سُئِلوا عَطاءً","وَأَوحاهُم إِذا غَضِبوا ضِرابا",12,"ب",2,0],["وَأَغيَدَ مَحسودٍ عَلى نورِ وَجهِهِ","هَجَرتُ سِوى لَحظِ البَعيدِ المُجانِبِ",13,"ب",1,0],["وَأَغنى بِكَ مِن عُدمٍ","وَأَسقى بِكَ مِن جَدبِ",14,"ب",1,0],["وَأَغَرَّ إِنْ عَذَرَ الوَرَى","في حُبِّهِ عَذَلَ الحِجى",15,"ج",2,1],["وَأَغْيَدَ يَحْوي وَجْهُهُ الحُسْنَ كُلَّهُ","وَيُنْكِرُ أَنَّ البَدْرَ فيهِ شَريكُهُ",16,"ك",2,1],["وأغرَّ إنْ بسَطَ الَرَجّي نحوَهُ","كِلْتا يَدَيهِ لنائِلٍ لمْ تُقْبَضا",17,"ض",2,0],["وأغْضَيْتُ عَيْني عنْ مَهاها فلَمْ أُبَلْ","لَدَيْها بعَيْني جُؤذَرٍ وغَزالِ",18,"ل",1,0],["وأُغْضي على حُكْمِ الهَوى وهْوَ جائِرٌ","فما لسُلَيْمَى واعُهَيْداهُ تَغْدِرُ",19,"ر",1,0],["وأغْدِرُ وابْنا خِنْدِفٍ يَهْتِفانِ بي","ويَلْمَعُ حَدُّ السّيفِ منْ خِلَلِ الغِمدِ",20,"د",1,0],["وأغمَدَ السَّيْفَ مَذْروبَ الشَّبا ونَضَا","رأْياً أَبَى الحَزمُ أن يُؤتَى مِنَ الزَّلَلِ",21,"ل",1,0],["وَأَغَضُّ طَرفي ما بَدَت لي جارَتي","حَتّى يُواري جارَتي مَأواها",22,"ا",3,0],["وَاِغسِل يَدَيكَ مِنَ الزَمانِ وَأَهلِهِ","وَاِحذَر مَوَدَّتَهُم تَنَل مِن خَيرِهِ",23,"ر",2,0],["وَأَغْرَيْتَ بِالبُهْمِ الْعِلاَجَ تَحَفِّياً","فَلَمْ يُذْخَرِ الشِّيءُ الْغَرِيبُ وَلاَ السِّمْطُ",24,"ط",1,0],["واغْنَ بقُطْنِ الثّلْجِ عنْ مَتْجَرٍ","يُغْنيكَ عنْ جَمعٍ وعنْ حَلْجِ",25,"ج",1,0],["واغْزِلْهُ بالرّيحِ وهَيّئْ لهُ","مَرَمّةَ المَصْقولِ والكَنْجِ",25,"ج",1,0],["وأغْرَيْتُ سوسِي بالعُذَيْبِ وبارِقٍ","على وطَنٍ داني الجِوارِ منَ السّوسِ",26,"س",1,0],["وَأَغيثوا مِنَ الغَلاءِ نُفوساً","قَد تَمَنَّت مَعَ الغَلاءِ الحِماما",27,"م",2,0],["وَأَغيَدٍ أَسكَنتُهُ في الحَشا","وَقُلتُ يا نَفسُ بِهِ فَاِقنَعي",28,"ي",1,0],["واغِلٌ وارِشٌ نَماهُ طُفَيلٌ","أَرشَمٌ قَد مَلِلتُ مِن إِبرامِه",29,"م",2,0],["وَأَغرِسُ في مَحَبَّتِكَ الأَماني","فَأَجني المَوتَ مِن ثَمَراتِ غَرسي",30,"س",2,0],["وَاِغتَنِم صَفوَ اللَيالي","إِنَّما العَيشُ اِختِلاسُ",31,"س",1,0],["وأغفى أهلها إلا وشاة","ذا نام العواذل لا تنام",32,"م",1,0],["وَأُغضي على أَشياءَ مِنكِ تَريبُني","وَأُدعَي اِلى ما نَابَكُم فَأُجيبُ",33,"ب",1,0],["وَأَغَارَنِي قَلَمِي يَصِرُّ مُقَبِّلاً","تِلْكَ الحُرُوفَ بِمَلْثَمٍ رَنَّانِ",34,"ن",1,0],["وَأَغضَفَ قَد غادَرتُهُ وِاِدَّرَعتُهُ","بِمُستَنبَحِ الأَبوامِ جَمَّ العَوازِفِ",35,"ف",1,0],["وأغرى بنا الأحداث مُبْتكِراً لها","فلم يأتنا إلا بحادثة بِكر",36,"ر",1,0],["وأغبى العالمين فتىً أكول","لفِطنَتِه ببِطنَتِه انهزام",37,"م",1,0],["وأغنيتهم عن نَقْلهم في شرابهم","بمُزٍّ طريٍّ من نُقول الحقائق",38,"ق",1,0],["وَأَغفِرُ إِن زَلَّت بِمَولايَ نَعلَةٌ","وَلا خَيرَ في المَولى إِذا كانَ يُقرِفُ",39,"ف",1,0],["وَأَغفِرُ عَوراءَ الكَريمِ اِدِّخارَهُ","وَأَصفَحُ مِن شَتمِ اللَئيمِ تَكَرُّما",40,"م",2,0],["وَأَغضَبَ عندَ مَندَبة قيَاماً","وأحلَمَ في المَجَالسِ مُحتَبِينَا",41,"ن",2,0],["وَأَغيَدَ مُختالاً يَجُرُّ إِزارَهُ","كَثيرَ النَدى طَلقَ اليَدَينِ مُعَذَّلا",42,"ل",2,0],["وَأَغضوا فَإِنَّ المَجدَ عَنكُم وَأَهلُهُ","عَلى ما بِكُم مِن لُؤمِكُم مُتَعَزِّلُ",43,"ل",1,0],["وأغيدُ يشكو خصرهُ جورَ رِدفه","ويُمسي بليلِ الشعرِ وهوَ يعاتبه",44,"ه",1,1],["وأغرقت ابن بحر في بيان","أطاف به على لجج فساح",45,"ح",1,0],["وأغنّ أقسم لا عصيت عصابةً","تدعو إليه ولا أطعت مفندا",46,"د",2,0],["وأغيد في فيه المدامُ ولحظه","وفيّ وفي أعطافه نشوة السُّكْر",47,"ر",1,0],["وأغيد كلَّما تجنى","وَرَّثَ بين القلوب جمرا",48,"ر",2,1],["وأغنّ في الفقهاء رمت تسلياً","فأتى العذار بحسنه المخصوص",49,"ص",1,1],["وأغيد كلّ شيءٍ منه يعجبني","كأنما هو مخلوق على شرطي",50,"ي",1,1],["وأغيثوا قلباً رقيقاً يقاسي","من ذوي اللوم كلّ فظٍّ غليظ",51,"ظ",1,0],["وأغيد فتَّان اللواحظ فاتك","يروق حشا عشَّاقه ويروعها",52,"ع",3,0],["واغفر جنايةَ أيامٍ قد اعتذرت","وأبشر بسعدٍ على الأيام مؤتلف",53,"ف",1,0],["وأغرق عذَّالي بدمعي ولم أرد","ولكنه من يرجم البحر يغرق",54,"ق",1,0],["وأغان ومادحون سوى العب","د فلا نسبةٌ ولا بعض أكله",55,"ل",2,0],["وأغيد في عليا دمشق محلّه","وفي لحظِه من صنعة السحر بابل",56,"ل",1,0],["وأغيد قد خطّ العذار بخدّه","حروفاً نماها الحسن لابن هلال",57,"ل",1,0],["وأغدو بأنواع الجميل مطوّقاً","فأسجع في أوصافه مترنما",58,"م",2,0],["وأغيد لم أخف فيه الذنوبَ ولا","جرى على خده من عارضٍ قلمُ",59,"م",1,0],["وأغيد ينهب أرواحنا","ووجهه كالروض بسام",60,"م",1,1],["وأغرُّ لا يشكو النزيل ببابه","ضرراً ولا يتظلَّم المسكين",61,"ن",1,0],["واغلق لهاك وإن زفت حدائقها","فحسبيَ الودّ جنَّات ورضوانا",62,"ن",2,0],["وأغيد جارت في القلوب فعاله","وأسهرت الأجفان أجفانهُ الوسنى",63,"ن",2,1],["وأغيد قد أضنى العواذل أمره","فقل في أسى أضنى محبًّا وعذّلا",64,"ل",2,0],["واغتِفارٌ لهفوةٍ إنْ ألمَّت","واطِّرَاحُ التفسير والانتفاءِ",65,"ا",2,0],["وأغفلَ ظُلمِيهِ بقَصْدِيه راغباً","فواعجباً والدهرُ جمٌّ عجائبُهْ",66,"ب",2,0],["واغْرَمْ لهم من بعد ذا كُلِّه","ما نفل الملّاحُ والقاربُ",67,"ب",1,0],["واغرَمْ حُطاماً واغتنمْ سمعةً","فالزادُ ماضٍ والثّنا راتبُ",67,"ب",1,0],["وأغزرُهم دِرَّةً بعد ذا","كَ عَفْواً إذا الدَّرُّ عاصَى العِصابا",68,"ب",2,0],["واغتباطي بهِ اغتباطيَ بالبُر","ءِ وعطْف الحبيب بعد الصُّدودِ",69,"د",1,0],["واغتفرْ لي تَوَرُّديك اغتفاراً","من رأى حُسْنَه رأى توريدَكْ",70,"ك",1,0],["واغضب لها غضباً يقود رضاً","يشكرْك قائلها يدَ الدهر",71,"ر",1,0],["وأغضبها انصرافُ الطرفِ عنها","وفيه عليَّ خُسران ووكسُ",72,"س",1,0],["وأغداك حَيْنُك من بينهِم","لحرش الأفاعي مع الحُرَّش",73,"ش",1,0],["وأغنى الفقيرَ وحاط الغنيْ","يَ ما لم يَحُطْ والد ذو شفق",74,"ق",1,0],["واغبرَّ في دولته جانبي","وهو ربيعٌ عمَّ إغداقه",75,"ق",2,0],["وأغفلتَ مجازاتي","وتمجيدكَ أشغالي",76,"ل",2,0],["واغتالت الشيخَ الشقيْ","يَ فقيَّرتْه وهْو غافلْ",77,"ل",1,0],["وإغرامُنا بالظرفِ من نَثْرِ ناثرٍ","تخالُ به دُرّاً ومن نظْمِ ناظمِ",78,"م",1,0],["واغرَمِ المال واغنَمِ الحمد واعلم","أنَّ ذا المجدِ غارمٌ غنَّامُ",79,"م",1,0],["وَأَغبَرَ ما يَجتازُهُ مُتَوَضِّحُ ال","رِجالِ كَفَرقِ العامِرِيِّ يَلوحُ",80,"ح",1,0],["وَاِغتِرابُ القَوِيِّ عِزٌّ وَفَخرٌ","وَاِغتِرابُ الضَعيفِ بَدءُ الفَناءِ",81,"ا",2,0],["وَأَغرى جَفنَهُ بِالسُهدَ حَتّى","لِيُشفِقَ أَن يُطيفَ بِهِ المَنامُ",82,"م",1,0],["وَأَغارُ إِن هَبَّ النَسيمُ لِأَنَّهُ","مُغرىً بِهَزِّ قَوامِكَ المَيّاسِ",83,"س",1,0],["وَأَغضَبُ لِلفَضلِ الَّذي أَنتَ رَبُّهُ","لِأَجلِكَ لا أَنّي لِنَفسِيَ أَغضَبُ",84,"ب",1,0],["وَأَغدو خميصَ البَطنِ لا يَستَفِزُّني","إِلى الزاد حِرصٌ أَو فُؤادٌ مُوَكّلُ",85,"ل",1,0],["وَأَغدو عَلى القوتِ الزَهيدِ كَما غَدَا","أَزَلُّ تَهاداهُ التَنائِفُ أَطحَلُ",85,"ل",1,0],["وَأَغضى وَأَغضَت وَاِتَّسى وَاِتَّسَت بِهِ","مَراميلُ عَزّاها وَعَزَّتهُ مُرمِلُ",85,"ل",1,0],["وَأَغسَت عَلَيها طِرمِساءُ وَعُلِّقَت","بِهَجرٍ أَداوى رَكبِها وَهيَ نُزَّحُ",86,"ح",1,0],["وأُغنِّي بَيْنَ اليَنابيعِ للفجرِ","وأَشدو كالبلبلِ التَّيَّاهِ",87,"ه",1,0],["واغذُذِ السَّيْرَ فالنَّهارُ بعيدٌ","وسَبيلُ الحَيَاةِ جَمُّ الظَّلامِ",88,"م",1,0],["وأَغاني الرُّعاةِ تخفُقُ في الأَغوارِ","والسَّهْلِ والرُّبى والتُّلولِ",89,"ل",1,0],["وأغاني الرُّعاة أَيْنَ يُواريها","سُكُونُ الفَضا وأَيَّانَ تُمْسي",90,"ي",1,0],["وَاغْسِليهْ","بِدُمُوعِ الفَجْرِ مِنْ",91,"ن",1,0],["وأغنِّي مع البلابلِ في الغابِ","وأُصْغي إلى خريرِ الوادي",92,"ي",1,0],["وَأَغَنَّ يَلعَبُ بِالهُمومِ كَما غَدَت","أَرماحُ قَومي بِالعُداة لَواعِبا",93,"ب",2,1],["وَاِغفِر ذنوبي ولا تُضيِّق","عَن حَملِها صَدركَ الفسيحا",94,"ح",2,0],["وأغمى من جوع على الطفل أحمدٍ","فصاحت أغث ربي عليك المعول",95,"ل",1,0],["وَأَغَنَّ أَكحَلَ مِن مَها بِكَفَّيهِ","عَلِقَت مَحاجِرُهُ دَمي وَعَلِقتُهُ",96,"ت",2,0],["وَاِغفِر لِحاسِدِ نِعمَةٍ","بِالأَمسِ نالَكَ أَو وَقَع",97,"ع",1,0],["وَاِغنَموا ما سَخَّرَ اللَهُ لَكُم","مِن جَمالٍ في المَعاني وَالصُوَر",98,"ر",1,0],["وأَغِثْ واسْتَغِثْ بِرَبِّكَ في الأَزْ","لِ إذا جَلّحَتْ صُروفُ اللّيالي",99,"ل",2,0],["وَإِغارَةٌ فيما اِحتَواهُ كَأَنَّما","في كُلِّ بَيتٍ فَيلَقٌ شَهباءُ",100,"ا",2,0],["وَأَغرى الصَبابَةَ بِالعاشِقينَ","وَأَقتَلَها لِلمُحِبِّ العَميدِ",101,"د",1,0],["وَأَغيَدُ يَهوى نَفسَهُ كُلُّ عاقِلٍ","عَفيفٍ وَيَهوى جِسمَهُ كُلُّ فاسِقِ",102,"ق",1,0],["وَاِغتِفارٌ لَو غَيَّرَ السُخطُ مِنهُ","جُعِلَت هامُهُم نِعالَ النِعالِ",103,"ل",1,0],["وَأَغرَبُ مِن عَنقاءَ في الطَيرِ شَكلُهُ","وَأَعوَزُ مِن مُستَرفِدٍ مِنهُ يُجرَمُ",104,"م",1,0],["وأغبنُ في بيعي رشادي بضَلَّتِي","وأعلمُ أني خاسِرٌ وأبيعُ",105,"ع",1,0],["وأغالِطُ الواشينَ في","كَ وقولُهم عندي صحيحُ",106,"ح",1,0],["وأغيدَ لو خاصرتَهُ في سُجوفِه","لردَّ مشيبَ العارضَيْنِ شَبابَا",107,"ب",2,0],["وأَغُرُّ نفسي منهم طمعاً","فيهم فَيَملِكني له عُجْبُ",108,"ب",1,0],["وأغرَّ مطبوعِ النَّدَى شَرِقٍ","بالمجد فيضُ يمينِه سَكْبُ",108,"ب",1,0],["وَأَغدو إِلَيكَ عَلى حالَةٍ","أَروحُ عَلَيها بِلا مَكسَبِ",109,"ب",1,0],["وَأَغَرَّ يَرفَعُهُ أَبوهُ وَكَم","لِكَريمِ قَومٍ مِن أَبٍ يَضَعُه",110,"ع",2,0],["وَإِغبابُ الزِيارَةِ فيهِ بُقيا","وِدادِكَ وَاِستِراحَةُ عَظمِ ساقي",111,"ي",1,0],["وَأَغفَلَ صَرفُ الدَهرِ عِندي سَوائِراً","لِوَضعِ مُعادٍ أَو لِرَفعِ مُوالِ",112,"ل",1,0],["وَأَغَرَّ في الزَمَنِ البَهيمِ مُحَجَّلٍ","قَد رُحتَ مِنهُ عَلى أَغَرَّ مُحَجَّلِ",113,"ل",1,0],["وَأَغَرُّ لِلفَضلِ بنِ سَهلِ عِندَهُ","كَرَمٌ إِذا ما العَمُّ وَرَّثَ لوما",114,"م",2,0],["وَاِغتَرَّ أَهلُ البَذِّ في شُرَفاتِهِم","حَتّى أَصابَهُمُ بِسَيفِ الهَيثَمِ",115,"م",1,0],["وَأَغلَبُ ماتَنفَكُّ مِن يَقَظاتِهِ","رَبايا عَلى أَعدائِهِ وَطَلائِعُ",116,"ع",1,0],["وَأَغنَيتَني عَن مَعشَرٍ كُنتُ بُرهَةً","أُكافِحُمُ عَن نَيلِهِم وَأُقارِعُ",116,"ع",1,0],["وَأَغنَيتَ مَن لَم يَغنَ مِن أَبطَأِ السُرى","وَقَوَّمتَ دَرءَ الأَزوَرِ المُتَجانِفِ",117,"ف",1,0],["وَأَغيَدَ مِن مَنِّ النُعاسِ بِعَظمِهِ","كَأَنَّ بِهِ مِمّا سَرَينا بِهِ خَبلا",118,"ل",2,1],["واغتسل فهي مباح ماؤها","غير محظور على الجسم الوسخ",119,"خ",1,0],["وأغنَّ دَافعتُ الهَوى بوصالِه","وشَقِيتُ في حُبِّيه كيما أنعَما",120,"م",2,0],["وأغَيَدَ مُهتزِّ القَوامِ كأنّما","يَهُزُّ قَضِيباً حين يَهتزُّ مائِلا",121,"ل",2,0],["وأغنُّ قَدَّحَ عارضاهُ فلاَوَذَا","واخضَرَّ شاربُه فسار مقابِلا",122,"ل",2,0],["وأغلبُ لا تُغالبُه الليالي","إذا صالَتْ حوادثُها وَصَالا",123,"ل",2,0],["وأغصان تَقولُ إذا تَثَنَّتْ","أَخَمْراً ما سَقَتْهُنَّ السَّواقي",124,"ي",1,0],["وأغَرَّ يُكبرُه النَّديمُ جَلالةً","حتَّى يَغُضَّ له الجفونَ ويُطرِقا",125,"ق",2,0],["وأَغْيَدُ مُهتَزٌّ على صَحْنِ خَدِّهِ","غَلائِلُ من صِبْغِ الحَياءِ رِقاقُ",126,"ق",1,0],["وأَغَنَّ تَحسِبُ جِيدَه إبريقَه","ما قامَ يَسفَحُ عَبْرَةَ الإبريقِ",127,"ق",1,0],["وأغَرَّ يأنَفُ أن يَصُدَّ عَنِ الوَغى","حتَّى يُذِلَّ مَعاطِساً وأُنوفا",128,"ف",2,0],["وأَغَرَّ نهدٍ لو طَلبتُ به","شأوَ الجنائبِ بَذَّها حُضْرا",129,"ر",2,0],["وأغرَّ ما طَلَعَتْ أسِرَّةُ وَجْهِه","إلا استسرَّ البدرُ قبلَ سَرارِه",130,"ر",2,0],["وأغَرُّ مُغرىً بالصُّفوفِ يَشُقُّها","وظُبا السُّيوفِ يشقُّ جيبَ المِغْفَرِ",131,"ر",1,0],["وأغلَبَ إن سارَ في تَغِلبٍ","سمعْتَ لسُمرِ الرِّماحِ اشتِجارا",132,"ر",2,0],["وأَغلبَ رَحْبِ الباعِ يُنجِدُه الرَّدَى","إذا ما ارتدى في مأزَقٍ بنِجاد",133,"د",1,0],["وأَغنَّ كالَّرشإ الغَري","رِ نَشا خِلالَ الرَّبربِ",134,"ب",1,1],["وأَغَرَّ لو نَطَقَتْ رِحابُ مَحَلِّه","قالَتْ لطُلاَّبِ المَكارمِ مَرحَبا",135,"ب",2,0],["وأغناهمُ عن بديعِ السًّماع","بدائعُ ما ضُمِّنَتْهُ الكُتُب",136,"ب",1,0],["وأغرُّ يَحسُنُ منظراً وضَرائباً","كالسَّيفِ يحسُنُ رَوْنقاً ومَضارِبا",137,"ب",2,0],["وأغرَّ مصقولِ الأديمِ تخالُهُ","بَرْقَاً إذا جَمَعَ العتاقَ رهانُ",138,"ن",1,1],["وَاغضَب عَلى الطَمَعِ الَّذي اِس","تَدعاكَ تَطلُبُ ما لَدَيهِ",139,"ه",1,0],["وَأَغيَدٍ مُكتَمِلٍ حُسنُهُ","لَيسَ لَهُ في الناسِ مِن مُشبِهِ",140,"ب",2,1],["وَأَغضَيتُ لَمّا أَن رَأَيتُكَ كُلَّما","تَعَرَّضَ عَتبٌ لا تَغُضُّ وَلا يُغضي",141,"ي",1,0],["وَأَغَنَّ مِسكِيِّ الإِهابِ وَوَجهُهُ","يُبدي جَمالاً زانَهُ الإِشراقُ",142,"ق",1,1],["وَأَغَنَّ أَبدى مِن مَواجِبِ عودِهِ","نَغَماً أَصَحَّ بِهِ القُلوبَ وَأَمرَضا",143,"ض",2,1],["وَأَغراكَ الخِلافُ بِضِدِّ قَولي","فَكانَ الفِعلُ مِنكَ بِضِدِّ ذاكا",144,"ك",2,0],["وَأَغارُ مِن لَثمِ الكُؤوسِ لِثَغرِها","وَأَذوبُ مِن لَمسِ الحُلِيِّ لِجيدِها",145,"د",3,0],["وَأَغَرَّ تِبرِيِّ الإِهابِ مُرَدَّدٍ","سَبطِ الأَديمِ مُحَجَّلٍ بِبَياضِ",146,"ض",1,1],["وَاِغتَنِمِ الغَفلَةَ مِن صَرفِ القَضا","فَالمَوتُ كَالسَيفِ مَتى ما يُنتَضى",147,"ض",2,0],["وَأَغيَدُ طافَ","بِكَأسٍ وَحَيّا",148,"ي",2,0],["وَأَغيَدَ رَخصِ الجِسمِ كَالماءِ رِقَّةً","أُكابِدُ قَلباً مِنهُ كَالصَخرِ قاسِيا",149,"ي",2,0],["وَأَغزَرُ الناسِ عَقلاً مَن إِذا نَظَرَت","عَيناهُ أَمراً غَدا بِالغَيرِ مُعتَبِراً",150,"ر",2,0],["وَاِغنَم جَميلَ الذِكرِ فَه","وَ مِنَ الغَنائِمِ أَهنَأُ",151,"ا",1,0],["وَاِغزُ العِدى قَبلَ تَغزونا جُيوشُهُمُ","إِنَّ الشُجاعَ إِذا مَلَّ الغُزاةَ غُزي",152,"ز",2,0],["وأغانيكُم التي","هي في قمةِ القمَم",153,"م",1,0],["واغرب كما غرب الشعاع قضى","رفّت عليه جوانح الغسق",154,"ق",1,0],["واغتذى عند مولد الروح فيه","من ثُديّ الحياةِ أوّلَ شيِّ",155,"ي",1,0],["واغتنمْ من كلّ عيشٍ صَفْوَهُ","فألَذّ العيش صفوٌ يُغْتَنَمْ",156,"م",1,0],["وأغربُ ما أبصرتُ بعد مليكها","بها مُتْرَعٌ يعدي الشجاعةَ والبذلا",157,"ل",2,0],["وأغلبُ ظنّي أنّ ما في وشاحهِ","كساهُ نحولاً حبُّ ما في خلاخِلِه",158,"ل",2,0],["واغتربْ وارجُ المنى كم من فتىً","مُعْدَمٍ نالَ المُنى بَعدَ اغتراب",159,"ب",1,0],["وَأَغَرَّ يَلهو بِالمَكارِمِ وَالوَغى","إِنَّ المَكارِمَ لِلكَريمِ مَلاهِ",160,"ه",1,0],["وَاِغدُ قَريبَ الخَيالِ وَالحِسِّ مِن","مَنظَرِهِ تارَةً وَمُستَمَعِه",161,"ع",2,0],["وَاِغدُ عَلى مَوشِيِّهِ إِنَّهُ","بُردٌ لَعَمري تَصطَفيهِ النُفوس",162,"س",1,0],["وَأَغَنَّ مِن دُعجِ الظِباءِ مُرَبَّبٍ","بُدِّلنَ مِنهُ أَغَنَّ غَيرَ مُرَبَّبِ",163,"ب",1,0],["وأغيدٍ يسألني","ما المبتدا والخبرُ",164,"ر",1,1],["واغضبا مِنْ شاعرٍ","وإنْ أقلَّ وافتقرْ",165,"ر",1,1],["وَأَغَرُّ كَالإِغريضِ عَذ","بٌ لا يُغَيِّرُهُ اِنتِقاصُه",166,"ص",2,0],["وَاِغرَورَقَت عَينايَ حينَ أَسومُها","وَالقَلبُ هاجَ لِذِكرِها اِستِعبارا",167,"ر",2,0],["وَأَغيَدَ في صَدرِ النَدِيِّ لِحُسنِهِ","حُلِيُّ وَفي صَدرِ القَصيدِ نَسيبُ",168,"ب",1,1],["وَأَغَرَّ كادَ لَطافَةً وَطَلاقَةً","يَنسابُ ماءً بَينَنا مَسكوبا",169,"ب",2,1],["وَأَغرَبَ مِن لَوعَةٍ مَدمَعٌ","إِذا لَجلَجَت لَوعَةٌ أَعرَبا",170,"ب",2,0],["وَأَغَرَّ ضاحَكَ وَجهُهُ مِصباحَهُ","فَأَنارَ ذا قَمَراً وَذَلِكَ فَرقَدا",171,"د",2,1],["وَأَغيَدٍ حُلوِ اللِمى أَملَدٍ","يُذكى عَلى وَجنَتِهِ الجَمرُ",172,"ر",1,1],["وَأَغَرَّ أَروَعَ مِلءِ سَمعِ المُنتَقى","حُرِّ الكَلامِ وَمِلءِ عَينِ المُبصِرِ",173,"ر",1,0],["وَأَغَرَّ أَزهَرَ باتَ يَعبَقُ نَفحَةً","فَكَأَنَّ في بُردَيهِ رَوضاً أَزهَرا",174,"ر",2,0],["وَأَغدو بِواديها وَقَد نَضَحَ النَدى","مَعاطِفَ هاتيكَ الرُبى ثُمَّ أَقشَعا",175,"ع",2,0],["وَأَغيَدَ مَعسولِ اللَمى وَالمَراشِفِ","صَقيلِ المُحَلّى وَالحِلى وَالسَوالِفِ",176,"ف",1,1],["وَأَغَرَّ يُسفِرُ لِلعَوالي وَالعُلى","عَن حُرِّ وَجهٍ بِالحَياءِ مُلَثَّمِ",177,"م",1,1],["وَأُغشى فَيُحمى لي مِنَ الأَرضِ مَضجَعي","وَأُصرَعُ أَحياناً فَأَلتَزِمُ الأَرضا",178,"ض",2,0],["وأغَرَّ تُؤيِسُنِي قَسَاوةُ قَلبِهِ","مِنهُ ويُطمِعُنِي تَعَطّف لِينِهِ",179,"ن",2,0],["وَأَغَرَّ تَتلو الفَجرَ غُرَّتُهُ كَما","تَتلو لِقَلبي فاطِراً بِجُفونِهِ",180,"ن",2,0],["وَأَغرى فُؤادي بِالأَسى رَيضُ آسِهِ","وَأَورَدَني ماءَ الرَدى غَضُّ وَردِهِ",181,"د",2,0],["وأغوص في الشعر القديم فأنتقي","ما ليس ملتبساً ولا مبذولا",182,"ل",2,0],["وأغارُ منه إذا اطمأنَّ بها الكرى","ويُثيرنُي متوسّداً زَنديها",183,"ي",3,0],["وَاغمر جراحك في دَمي فَلَعَله","يَجدي فَتَبرأ بَعدَهُ يا مَوطِني",184,"ن",2,0],["وَأغيَرَ عِندَ المُحصَناتِ إِذا بَدَت","بُراهُنَّ وَاِتَعجَلنَ شَدَّ النَطائِقِ",185,"ق",1,0],["وَأَغيَدَ لا نِكسٍ وَلا واهِنِ القِوى","سَقَيتُ إِذا أولى العَصافِرِ صَرَّتِ",186,"ت",1,0],["وَاِغرَورَقَت لِاِنسِكابِ الماءِ مُقلَتُها","جاءَت بِثَلجٍ كَوَردٍ أَبيَضٍ نُثِرا",187,"ر",2,0],["وَأَغرَوني فَكانَ إِلَي","هِ ما قَد كانَ في سَكَري",188,"ر",2,0],["وَأغْراني به داعِي اقْتِراحٍ","عَلَيَّ لأَمْرِهِ أبَدَاً وُجُوبُ",189,"ب",1,0],["واغَيْرَنا حِينَ أَضْحَى الغارُ وهُوَ بِهِ","كِمَثْلِ قَلْبِيَ مَعْمُورٌ وَمَأْهُولُ",190,"ل",1,0],["وَأَغَاثَ اللهَ ذَا النُّونِ بهِ","بَعْدَ ما أَغْرَى بهِ في البَحْرِ نُونا",191,"ن",2,0],["واغْزُنَّ عَامِلَ أسْوانَ تنال بِهِ","جَنَّاتِ عَدْنٍ بإحْسَانٍ وَتَمْكِينِ",192,"ن",1,0],["وَأَغرَقَت قَلبي بِحارُ الهَوى","مِمّا بِهِ مِن طولِ أَوصابِهِ",193,"ب",2,0],["وَأَغروا بي تَأنيباً","مِنَ المُقبِلِ وَالمُدبِر",194,"ر",1,0],["وَاغدُ إِلى الخَمرِ بِإِبّانِها","لا تَمتَنِع عَنها لِتَحريمِ",195,"م",1,0],["وَاِغتِفالي المَولى لِأَختَلِسَ الغَم","زَةَ مِمَّن أُحِبُّهُ بِالبَنانِ",196,"ن",1,0],["وَأَغيَدَ مِطرابِ العَشِيَّاتِ مُرعَشٍ","مِنَ الخَمرِ لا يَلقاكَ إِلاّ نَديمُها",197,"م",3,0],["وَاِغتلَّها زَورُ أَبي وابِصٍ","شَتاً فَهَزَّتهُ المَآخيرُ",198,"ر",1,0],["وَأَغَنَّ يَحفِلُ عُصفُراً","وَكَأَنَّهُ جَمرٌ وَقودُ",199,"د",1,0],["وَأَغبَرَ رَقّاصِ الشُخوصِ مَضِلَّةً","مَوارِدُهُ مَجهولَةٌ وَسَباسِبُه",200,"ب",2,0],["وَإِغضائي عَلى البَزلاءِ وَهنٌ","وَوَجهُ سَبيلِها رَحبٌ فَضاءُ",201,"ا",2,0],["وَأَغرانا بِها طَبعٌ لَئيمٌ","وَأَعطَت مِن حَبائِلِها غُرورا",202,"ر",2,0],["وَأَغنَتِ الشَربَ إِلّا مِن جَميلِ نُهىً","مَن يَفتَقِر مِنهُ يوجَد شَرَّ مُفتَقَرِ",203,"ر",1,0],["وَاِغفِر لِعَبدِكَ ما يَجنيهِ مِن زَلَلٍ","وَلا تَأَيَّ بِسوءٍ مِن تَأَيّاكا",204,"ك",2,0],["واغْسِلاهُ بالدّمعِ إنْ كانَ طُهْراً","وادْفِناهُ بَيْنَ الحَشَى والفُؤادِ",205,"د",1,0],["وَأَغفِرُ لِلمَولى هَناةً تُريبُني","فَأَظلِمُهُ ما لَم يَنَلني بِمَحقِدي",206,"د",2,0],["واِغتنم اللذات ما","أعطتك دنياك يدا",207,"د",2,0],["واغنمي نَفح الصَّبا وانتقلي","في الصِّبا المِمراحِ من غُصنٍ لغصن",208,"ن",1,0],["وأغرقته موجةٌ غامرة","فأطبق الصمت وَرَانَ العدم",209,"م",1,0],["وأغرب من عنقاء في الطير شكله","وأعوز من مسترفدٍ منه يحرم",210,"م",1,0],["وأغرَوْا بحواءَ ما لُقِّنوا","وما حذَقُوا من طريدِ الجنانْ",211,"ن",1,0],["وأغرس في قلبهِ زهرةً","من الشرِّ راويةً ناميَهْ",211,"ه",1,0],["واغفري لي شِرَّةً عارمةً","في دمي لو أتأبَّى ما أباها",212,"ا",3,0],["وأغانٍ لمن شدا","ومعانٍ لمن فخَرْ",213,"ر",1,0],["وأُغنّي ويُغني لكَ حُبِّي وشبابي","وسلامٌ يا حبيبي",214,"ي",1,0],["وأغدو ولو أنّ الصّباحَ صوارِمٌ","وأسْرِي ولو أنّ الظّلامَ جَحافل",215,"ل",1,0],["وأَغَنَّ مِن سَدن المُلُو","كِ سَليلِ أَقْيالٍ خضارِمْ",216,"م",1,0],["وأَغَرَّ قد لَبِس الدُّجى","بُرْداً فَرَاقَكَ وهْو فاحِمْ",216,"م",1,0],["وَاغْنَما صَفْوَةَ الرَّبِيعِ بِدَاراً","فَالأَمَانِي مَعْقُودَةٌ بِالْبِدارِ",217,"ر",1,0],["وَاغْتَنِمْ عُمْرَكَ إِبَّانَ الصِّبَا","فَهْوَ إِنْ زَادَ مَعَ الشَّيْبِ نَقَصْ",218,"ص",1,0],["وَاغْنَمْ جِوَاراً لِلْمَلاَئِكِ طَاهِراً","لَيْسَ التَّحِيَّةُ فِيهِ إِلاَّ قِيلاَ",219,"ل",2,0],["وَاغْتَنِمْ رُؤيَةَ الأمِيرِ الَّذي مَدَّ","لَهُ اللهُ فِي الْمَفَاخِرِ مَدَّا",220,"د",2,0],["وأَغْضُوا عَنِ الفَحْشاءِ لا تَعْرِضُوا لها","ولا تَطْلُبُوا حَرْبَ العَشِيرَةِ بالقَلْبِ",221,"ب",1,1],["واغتدى كلُّ جدولٍ يتمنّى","وانبرى كلّ بلبُلٍ يتصدّى",222,"د",2,0],["واغبِراراٍ كأنما تركَ الغيمُ","عليه مذ جازَهُ آثارا",223,"ر",2,0],["وأغرتْ بيَ المستحيل .. اللذيذ ..","فأسلمني الأفق الموصدا..",224,"د",2,0],["واغتنم ركعتين زلفى إلى الل","ه إذا كنتَ فارغاً مستريحا",225,"ح",2,1],["وأغمد سيفه عن كل شيءٍ","وجرّد نصله لابني سمير",226,"ر",1,0],["وأغنيّك والصبابات حولي","زمر تحتسي قصيدي وتنهل",227,"ل",1,0],["وَأُغْمِضُ العَيْنَ حِيناً ثُمَّ أَفْتَحُهَا","عَلَى جَلاَلٍ بِنُورِ الْحَقِّ مُؤتَشِبِ",228,"ب",1,0],["وأغزو الشتاء بموقد فحمٍ","وأبسط من فوقه راحتيَّا",229,"ي",2,0],["وأغلاهم يراعًا حين يُشرَى","يراعُ الحرِّ بالثمَنِ الزهيد",230,"د",1,0],["وأغرى بها كف الغلاب فأصبحت","ذلولا ولم تسطع لامرته ردا",231,"د",2,0],["واغفر لأجل إمام المرسلين لنا","فى يوم لا تنفع الأموال والنشب",232,"ب",1,0],["واغفري لي شرّة عارمة","في دمي ، لو تأبّى ما أباها",233,"ا",3,0],["وأغاثَ اللهُ ذا النونِ بهِ","بعد ما أعرى به في البحرِ نونا",234,"ن",2,0],["وأغْفِرُ، إنْ زَلّتْ بمَوْلايَ نَعْلَة","ٌ ولا خير في المولى ، وإذا كان يقرفُ",235,"ف",1,0],["واغتنمِ العمرَ وساعاتِه","فانها تمر مرَّ الرياح",236,"ح",1,0],["وأغريتَهُ بالقرب حتَّى إذا دَنَا","إليكَ رأى منكَ الَّذي بَغَّضَ القُرْبا",237,"ب",2,0],["وأغريت بالتلطيف أسْحَرُ شاعراً","وأغدقت بالأموال اخْدَعُ كاتبا",238,"ب",2,0],["وأغراه حُبّاً بالأخيطلِ شعرُهُ","لو اسطاعَ نَصرانيةً لتنصَّرا",239,"ر",2,0],["وأغْفَتْ فلم أَدْرِ عن حَيرةٍ","بها : كيف إيقاظُها أو متى",240,"ا",1,0],["وأغْرقْتُ في إطراءِ من لا أهابُه","وساجلت بالتقريع من لا يساجَل",241,"ل",1,0],["وأغدو إليك على حالة","أرواح عليها بلا مكسب",242,"ب",1,0],["وأغْنَيْتَني عَن مَعشَرٍ كُنتُ بُرْهَةً","أُكَافِحُهُمْ عَن نَيْلِهِمْ، وأُقَارِعُ",243,"ع",1,0],["وأغتَسَلتُم بِنَدَى غَابَاتِهِ","وِاختَبَأتُم تَحتَ جِفنَيِه طَوِيلاَ",244,"ل",2,0],["وأغمضت عن طيباتك عيني","وأهملت شكوى القميص المعطر",245,"ر",1,0],["واغبرَّ في دولته جبي","وهو ربيعٌ عمَّ إغداقُهُ",246,"ق",2,0],["واغرمِ المال واغنَمِ الحمد واعلم","أنَّ المجد غارمٌ غنَّام",247,"م",1,0],["وأغيرَ عندَ المحصناتِ إذا بدَتْ","براهنَّ، واستعجلنَ شدَّ النَّطائقِ",248,"ق",1,0],["وأغيدَ في صدر النديّ لحسنهِ","حليّ وفي صدر القصيدِ سيبُ",249,"ب",1,1],["وأغراه الضلال فكان مني","كما كانم اليهود من المسيح",250,"ح",1,0]]}