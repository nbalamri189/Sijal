{"poems":[[53,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[53,"لقبها معشر مغنية","https://www.aldiwan.net/poem64524.html","المنسرح"],[53,"قد أناسي الهم نجواه","https://www.aldiwan.net/poem65897.html","مجزوء الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[287,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132419","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67970","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66538","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4767,"العيد","https://www.poetsgate.com/ViewPoem.aspx?id=129805",""],[4816,"البارحة","https://www.poetsgate.com/ViewPoem.aspx?id=199483",""],[4984,"يوم المجاهد","https://www.poetsgate.com/ViewPoem.aspx?id=181624",""],[5136,"يا بروحي المدلل البتاه","https://www.poetsgate.com/ViewPoem.aspx?id=121772",""],[5174,"رَفيفٌ إِلى مِشكاةِ الضَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=185374",""],[5277,"أغارُ","https://www.poetsgate.com/ViewPoem.aspx?id=197653",""],[5621,"صهوة","https://www.poetsgate.com/ViewPoem.aspx?id=24565",""],[6137,"ابعد من الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=174328",""],[6054,"لما انثنى الغصن فوق كثبانه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55253&r=&rc=8",""],[6315,"ابتِهَالٌ على خُيُوطٍ مُقَدَّسَة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87582&r=&rc=7",""]],"verses":[["تُجْذَبُ باستنشاقةٍ رخوةٍ","وربما انقادت ولم تُجذبِ",0,"ب",1,0],["تُجذَر فلساً على الغناء ولا","تسكت إلا وجَذرُها بدْرَهْ",1,"ه",1,0],["تُجذلُ البالَ وتغتا","لُ مدَى الهمّ الطويلِ",2,"ل",1,0],["تجذف الأحلام في ألواحه","ويتعرى عندهن السحر",3,"ر",1,0],["تَجُذُّ بِهِ الضَيمَ جَذَّ الخَليلِ","بِضَربِ اليَمينِ فَقارَ الصَنَم",4,"م",1,0],["تجذلت الأحكام فيه وعطلت","حدود وسيم الخسف ما الله يرفع",5,"ع",1,0],["تَجذب النِّسْعَ لَمْ يَؤُدْها كَلال","جَذْبَةَ الشوقِ للحبيبِ المقارب",6,"ب",1,0],["تَجْذِبُ أَطْرافَها حِياصَتُهُ","بُخْلاً بِما شَدَّ تَحْتَ هِمْيانِهْ",7,"ه",1,0],["تَجذِبُهُ سَلاسِلٌ مِن ذَهَبٍ","في راحتي ريح جَنُوبٍ أَو صبَا",8,"ا",1,0],["تجذب الأسعارُ أموالَ الحيارى","في سباقٍ نحو إفلاس الرصيدِ",9,"د",1,0],["تجذب غطاء رأسها والريح تجذبها","ويداعب أطرافها ميدول شْقيّر",10,"ر",1,0],["تجذب المغرضين ممن تمادوا","ما استفاقوا كأنهم رهن سكر",11,"ر",1,0],["تجذب الروح إن تجلى فمغن","طيس روحي إذا بدا محتلاه",12,"ا",2,0],["تَجَذَّرِينَ- بِرَغمِ الرِّيحِ- صامِدَةً","وَتَشمَخِينَ إِذا عَصفُ الهَوانِ أَطَلْ",13,"ل",1,0],["تجذّر فيهما وطنٌ وحزنٌ","تزمّل ثلجَه غضبٌ ونارُ",14,"ر",1,0],["تجذِبُني هُوَّةٌ أُدافِعُها","فتَرْتَمي هُوّةٌ على حَدَقي",15,"ق",2,0],["تجذبني اليها ذي الفتن مسلية","فأصون بالغيب قلبا قد هواني",16,"ن",2,0],["تجذب أطرافها حياصته","بخلا بما شد تحت هيمانه",17,"ن",2,0],["تَجَذَّري في ذُهُولِ الخَيلِ فانْتَخِبي","فِرَاسَةً تَقْرَأُ الأَحلامَ في غُرَّه",18,"ر",2,0]]}