[4755,"سَجَنُوا الغِلالَ","https://www.poetsgate.com/ViewPoem.aspx?id=200428",""],[4767,"مهرجان صفوى","https://www.poetsgate.com/ViewPoem.aspx?id=92537",""],[4578,"زف المدام على الصفا خدٍ وقد","https://www.poetsgate.com/ViewPoem.aspx?id=49400",""],[4858,"من شعب عمر المختار","https://www.poetsgate.com/ViewPoem.aspx?id=138201",""],[4926,"بحقِّك يا الله صل وسلِّم","https://www.poetsgate.com/ViewPoem.aspx?id=171099",""],[4984,"أسمى ما يرام","https://www.poetsgate.com/ViewPoem.aspx?id=181621",""],[5064,"ارتياد مستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=199112",""],[5136,"وابأبي مبتسم بارد","https://www.poetsgate.com/ViewPoem.aspx?id=121606",""],[5136,"ومهاة ذات صد وملل","https://www.poetsgate.com/ViewPoem.aspx?id=121643",""],[5136,"وابأبي مبسم رقيق","https://www.poetsgate.com/ViewPoem.aspx?id=121635",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5195,"هل يتاح للرواح","https://www.poetsgate.com/ViewPoem.aspx?id=186947",""],[5204,"وابأبى من زرتها ليلة","https://www.poetsgate.com/ViewPoem.aspx?id=200373",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5433,"جيتك بقايا","https://www.poetsgate.com/ViewPoem.aspx?id=36117",""],[5459,"لا زلت أتوق","https://www.poetsgate.com/ViewPoem.aspx?id=191023",""],[5573,"نامت عيون الجاهل الي ماعرف درب الرواه","https://www.poetsgate.com/ViewPoem.aspx?id=205469",""],[5748,"طرة ليل فوق صبح مبين","https://www.poetsgate.com/ViewPoem.aspx?id=26249",""],[402,"أيها البالغ الثريا مقاما","https://www.poetsgate.com/ViewPoem.aspx?id=36200",""],[402,"كانوا ثمانية من الندماء","https://www.poetsgate.com/ViewPoem.aspx?id=35048",""],[5829,"الى محمد","https://www.poetsgate.com/ViewPoem.aspx?id=153239",""],[5975,"أمنيات الورود","https://www.poetsgate.com/ViewPoem.aspx?id=53259",""],[6051,"وأبا كِدَامٍ بَعْدُ أَعْطَيْنَا بِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=85173",""],[6056,"طريق المدرسة","https://www.poetsgate.com/ViewPoem.aspx?id=130179",""],[6084,"حينى بالصبوح عند الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=170829",""],[6084,"زارني ليلا وقد نام الرقيب","https://www.poetsgate.com/ViewPoem.aspx?id=170819",""],[6115,"على شأن مايشره عليه خيار الناس","https://www.poetsgate.com/ViewPoem.aspx?id=181444",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[6299,"بِكَفَّيِّ مِنْها لِلْبَغيضِ عُرَاضة ٌ وَمَرْقَبَة ٍ عَنْقَاءَ يَقْصُرُ دُونَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19688&r=&rc=13",""]],"verses":[["وَإِباءٌ مُحَلِّقٌ بي عَنِ الضَي","مِ كَما راغَ طائِرٌ وَحشِيُّ",0,"ي",1,0],["وَأَبالَ الخَيلَ في كُلِّ حِمىً","يَمنَعُ الماطِرَ مُنهَلَّ العَزالي",1,"ل",2,0],["وآباؤُهُ مَنْ تَعْرفونَ مِنَ الوَرى","ولولا التُّقى عرَّفْتُكُمْ أمَّهاتِهِ",2,"ت",2,0],["وأبادَ بعضَهُمُ المَنونُ وبَعْضُهُمْ","في القِدِّ وهْوَ بما جَناهُ أبصَرُ",3,"ر",1,0],["وا بِأَبي الوَجهَ المَليحَ الَّذي","قَد عَشِقَتهُ الجِنُّ وَالإِنسُ",4,"س",1,0],["وا بِأَبي وَجهَكِ هذا الَّذي","أَتلَفَ نَفسي وَهوَ لا يَدري",5,"ر",2,1],["وا بِأَبي عَينَكِ هاتا الَّتي","تَنفُثُ في قَلبِيَ بِالسِحرِ",5,"ر",1,0],["وَأَبَاتَ الرَّجَاءُ حَاضِرَةَ المُلْ","كِ تُعِدُّ الزِّينَاتِ وَالأَعْلامَا",6,"م",2,0],["وأبان جاري الدمع عذرَ هيامه","لكن أضعتِ له حقوق الجارِ",7,"ر",1,0],["وَآبَ اِبنُ ذَيّالٍ بِأَسلابِ جارِكُم","فَسُمّيتُمُ بَعدَ الزُبَيرِ الزَوانِيا",8,"ي",2,0],["وَآبَ إِلى الأَقيانِ أَلأَمُ وافِدٍ","إِذا حُلَّ عَن ظَهرِ النَجيبَةِ كورُها",9,"ر",3,0],["وَآبَ اِبنُ ذَيّالٍ جَميعاً وَأَنتُمُ","تَعُدّونَ غُنماً رَحلَهُ المُتَمَزَّعا",10,"ع",2,0],["وَأَبانَ لُؤمَكَ أَنَّ أُمَّكَ لَم تَكُن","إِلّا لِشَرِّ مَقارِفِ الأَعرابِ",11,"ب",1,0],["وأبادَ الطغاةَ بأساً ورعباً","وأعاد الجميل فينا وأبدَى",12,"د",2,0],["وإباءُ الهوانِ عَدْوَى أتتْني","منك والعبدُ يَقْبل الإعداءَ",13,"ا",2,0],["وأباهُ الذي اقتدى بكَرَاهُ","وبتَسْهيد عيْنه تسْهيدَكْ",14,"ك",1,0],["وأباهُما شمساً تُمدُّ بنورها","نوريهما أبداً مِداداً دائما",15,"م",2,0],["وأبان ذلك إفكَ خصمِك فانثنى","وهو المَشينُ وأنت غير مشين",16,"ن",1,0],["واباحت له الطبيعة ان يخ","رج ما كان عندها مخزونا",17,"ن",2,0],["وأبان يخدعها نجيب إنه","بجمالها الفتان صبٌّ مولع",18,"ع",1,0],["وَآباءٍ أَحَبّوكَ","وَما أَنتَ لَهُم بِاِبنِ",19,"ن",1,0],["وَإِباءُ الرِجالِ أَمضى مِنَ السَي","فِ عَلى كَفِّ فارِسٍ مَسلولا",20,"ل",2,0],["وَإِبائي عَلى مُمَلَّكِ أَرضي","ما طَوَلّاهُ مِن عَطائي وَشَكمي",21,"م",2,0],["وَآبَ الوَفدُ وَفدُ بَني فُقَيمٍ","بِأَلأَمِ ما تَؤوبُ بِهِ الوُفودُ",22,"د",1,1],["وَأَبا أَبيكَ لِكُلِّ جائِحَةٍ","مَروانَ سَيفَ الدينِ ذا الأُثرِ",23,"ر",1,0],["وَأَباكَ إِذ كَشَفَ الإِلَهُ بِهِ","عَنّا العَمى وَأَضاءَ كَالفَجرِ",23,"ر",1,0],["وَأَباها المَزجُ لَمّا مُزِجَت","وَإِذا ما اِنتَسَبَت كانَ أَباها",24,"ا",3,0],["وَأَباحَ نَصلَ السَيفِ كُلَّ مُرَشَّحٍ","لَم يَحمَرِر دَمُهُ مِنَ الأَطفالِ",25,"ل",1,0],["وَآبَ إِلَيَّ رائِحُ الذِكرِ وَاِلتَقَت","عَلى القَلبِ أَحزانٌ فَأَصبَحنَ أَوصابا",26,"ب",2,0],["وَآبَ أَبوكُم قَد أَجَرَّ لِسانَهُ","يَمُجُّ عَلى عُثنونِهِ عَلَقَ الحَلبِ",27,"ب",1,0],["وابِأَبي أَلثَغَ لاجَجتُهُ","فَقالَ في غُنجٍ وَإِخناثِ",28,"ث",1,1],["وَأَبا مَيَّةَ المُهَذَّبَ وَالمَأ","مولَ وَالمُرتَجى لِرَيبِ الزَمانِ",29,"ن",1,0],["وابِأَبي مَن إِذا ذُكِرتُ لَهُ","وَطولُ وَجدي بِهِ تَنَقَّصَني",30,"ن",2,1],["وأباحَ طَرْفِي نَظْرْةً أمّلْتُها","فَغَدَوْتُ معروفاً وكُنْتُ مُنَكَّرا",31,"ر",2,0],["وأبانَ في يوم الغدي","رِ لكُلِّ جبّارٍ عَوِيّ",32,"ي",1,0],["وإباءٌ حميتَهُ من صغارٍ","وبريق من المواعد خُلّبْ",33,"ب",1,0],["وَأَبَاعِدٌ جَزَعُوا عَلَيْكَ وَلَمْ يَكُنْ","لَكَ بَيْنَهُمْ إِلاَّ أَخٌ وَصَدِيقُ",34,"ق",1,0],["وَأَبَانَ كَيْفَ الْحِلْمُ يَسْ","تَلُّ الْحُقُودَ مِنَ الْجَنَانِ",35,"ن",1,0],["وَأَبَانَ كَيْفَ مَعَ الثَّقَ","افَةِ يَنْتَقِي سَبَبُ الْهَوَانِ",35,"ن",1,0],["وَأَبَانَ كَيْفَ مُهَابَةُ السَّ","يْفِ المُجَرَّدِ وَالسِّنَانِ",35,"ن",1,0],["وَأَبَانَ مَا آتَتْ غِرَاسُكَ","مِنْ أَفَانِينِ المَجَانِي",35,"ن",2,0],["وَأَبَانَ لِلإبْدَالِ مِنْ حَال إِلَى","حَالٍ أَصَحَّ طَرَائِقِ الإِبْدالِ",36,"ل",1,0],["وَأَبَاتَهُمْ هَذَا المِزَاحُ مِنَ الرَّدَى","فِي شَرِّ مَا يُبْكِي مِنَ الأَرْزَاءِ",37,"ا",2,0],["وَأَبَانَتْ عَمَّا تَكِنُّ الطَّوَايَا","لِلزَّعِيمِ الحُرِّ النَّزِيهِ النَّبِيلِ",38,"ل",1,0],["وَأَبَاحَتْ جِيدَهَا مَنْ يَبْتَغِي","سَلْوَةً أَوْ زِينَةً أَوْ مَظْهَرَا",39,"ر",2,0],["وأبارك الأمّ الحياةَ لأنّها","أمّي وحظّي من جناها العلقمُ",40,"م",1,0],["وأباه لا يعتدون ويهدون","إلى المعتدي الأثيم الزوالا",41,"ل",2,0],["وأباد فتيتها الزمان وطالما","مرّ الزمان بفتية فأبادها",42,"د",3,0],["وأبا نواس في مجالس لهوه","قسم الليالي سكرة وذهولا",43,"ل",2,0],["وأب أبى سلطان دولة سره","إلا وصول بنيه للإسعاد",44,"د",1,0],["وأبان منهاج الأمان بهمة","أعيا علاها مدرك العقلاء",45,"ا",2,0],["وأباحه مهج العدا فكأنما","قد نصلت أرماحه بقضائه",46,"ا",3,0],["وآباؤه الغرُّ هُمْ سادةٌ","وأهل الندى والجفان الضخامْ",47,"م",1,0],["وأبان قدر فروضهِ","بغريب أنواعِ الحسابْ",48,"ب",1,0],["وَأَبانَ مَن مَلَكَ البَسيطَةَ فَضلَهُ","لَمّا اِصطَفاكَ لَهُ أَخاً وَخَليلا",49,"ل",2,0],["وَأَباحَنا سُلطانُكَ الأَمنَ الَّذي","لَو نَشتَريهِ بِالنَواظِرِ ما غَلا",50,"ل",2,0],["وَأَبانَ فَضلُكَ لِلزَمانِ فَضيلَةً","تَبقى إِذا دَرَسَت هِضابُ أَبانِ",51,"ن",1,0],["وأبان من علم الكلام وغيره","ما كان إذ ما كان غير مبين",52,"ن",1,0],["وَآباءِ صِدقٍ حينَ أُعزى وَهِمَّةٍ","عَلَت بِي عَلى هامِ النُجومِ الثَواقِبِ",53,"ب",1,0],["وَآباؤُهُ الغُرُّ الكِرامُ أُبُوَّتي","وَآسادُ غابي مِن رَآبيلِ غابِهِ",54,"ب",2,0],["وَآباؤُكَ الغُرُّ الكِرامُ أُبُوَّتي","وَبَحرُكَ مِن تَيّارِ آذِيِّهِ بَحري",55,"ر",2,0],["وَابأَبِي مَنْ لَسْتُ أَنْساهُ","وَمَنْ عَلَى الهِجْرانِ أَهْواهُ",56,"ه",1,1],["وَأبا بنيهِ السيّدَ المَعلوما","صلّوا عليهِ وَسلّموا تسليما",57,"م",2,0],["وابِأبي مَنْ أرتضي حُكْمَهُ","في مُهْجَتي وهو من الظالمين",58,"ن",1,0],["واباد اهل الشرك في أحد وفي","بدر لهم قد كان اردا مصرع",59,"ع",1,0],["وَأَباحوا اَبوابَهُم حاتِمِيّا","تٍ لمَن أَمَّهُم من الضيفانِ",60,"ن",1,0],["وَإِبابُ عبّاسٍ كسا","هُ جلابِباً لِلحُسن أَخرى",61,"ر",2,0],["وابِأبي من حَسَّن الظنَّ في","قصدي ومن أسلفني شكرا",62,"ر",2,1],["وابِأبِي من لان مَسّاً ومَن","لو عقدوه لانثنى وانعقدْ",63,"د",1,0],["وا بِأبِي الظّبيُ الذي لو بدا","للبدرِ قال البدرُ واظُلْمَتاهْ",64,"ا",2,1],["وابِأبي رَائِق الشبابِ ويَا","بَهْجَةَ خديهِ ما أُمَيْلِحَهَا",65,"ه",2,1],["وَأَبانَ كَعب جَدّهُ في خُطبَةٍ","بِعُروبَةٍ في سائِرِ الأخوانِ",66,"ن",1,0],["وَأَبادَ ذا يَزَنٍ وَأَر","دى ذا الكُلاعِ وذا رُعَينِ",67,"ن",1,0],["وَأَباريقٍ كَأَجيادِ","مَها السِربِ العَواطي",68,"ط",2,0],["وَأَبَاحَتْنِي مِنْ طُلاَهَا عِنَاقاً","وَارْتِشَافاً مِنْ ظَلْمِ ثَغْرٍ شَنِيبِ",69,"ب",1,0],["وَأَبَادَ مِنْ سُحْبِ الْجَهَا","لَةِ مَا تَكَاثَفَ أَوْ تَكَلَّدْ",70,"د",1,0],["وَأَبَاحَنَا أَسْرَارَهَا تِلْكَ التِي","أَمْسَتْ عَلَى مَنْ دُونَهُ مَحْرُوزَهْ",71,"ز",2,0],["وأبادَ مَنْ ألِفَ العنادَ فَلمْ يدَعْ","حَيّاً بأَطرافِ البلادِ لقاحا",72,"ح",2,0],["وا بِأَبي وَسنانُ أَجفانُهُ","صَحيحَةٌ مَكحولَةٌ بِالسَقام",73,"م",1,0],["وأَبانَ عَن عَزمٍ أَبا","دَ عَزائِم اللَّيث الهَصورِ",74,"ر",1,0],["وَإِباءٌ صعبُ الشكائمِ وعرٌ","في اِنقيادٍ للحقّ بالإِذعانِ",75,"ن",1,0],["وَإبانةٍ ببنانهِ ولسانهِ","طَلعت بهِ شُهباً حروف المعجمِ",76,"م",1,0],["وَأَبادَ أَخصَبَ رَوضَةً","وَأَغاضَ أَعذَبُ مَورِدِ",77,"د",1,0],["وابأهلي فداهما في الصبا الغضّ","بريئَينِ من أذىً أو معاب",78,"ب",1,0],["وَأَبان لِلأَعيان كُلّ فَضيلة","هِيَ في المَناقب قُرَّة الأَعيانِ",79,"ن",1,0],["وآبَ إلى أحبابِه وديارِه","مَشوقٌ إليهم حاضِرُ القلبِ غائب",80,"ب",1,0],["وأباحَها لمن استقلَّ نعيمها","فأباح منها أصعب الأشياءِ",81,"ا",2,0],["وابأبي شبهُ أَبي","غير شبيهٍ بِعَلي",82,"ي",1,1],["وأباحَ لي وِرد الرِّضَى كرماً وما","برحتْ عواطفُ بره تغشاني",83,"ن",2,0],["وأباحَ عرضي بالْهِجاء","وعرضُهُ عندي مَصُونُ",84,"ن",1,0],["وأبانت عُلاه آيات فضلٍ","لم تَزلْ في صحيفةِ المجدِ تُتْلاَ",85,"ل",2,0],["وإبائِي أراهُ عن حَمله المَنْ","نَ ضَعيفاً وهْو القَويُّ الرَّكوبُ",86,"ب",1,0],["وأبانَ بينهُمُ هَواكَ فما عَسى","بكَ فاعلٌ هذَا الهَوى وبيانُهُ",87,"ن",2,0],["وأباً ماجداً كريماً وجدّا","كيف كانت إذ ذاك خصماً ألدّا",88,"د",2,0],["وآبَ إلى جنَّات عدنٍ فأرِّخوا","عليٌّ بجنَّات الخلود مآبه",89,"ب",2,0],["وآباؤك الغُرُّ الميامين إنَّهم","غيوثٌ إذا جادوا ليوث إذا صالوا",90,"ل",3,0],["وأَبانَتْ عن عِتْقِها الخيلُ فيما","أَعرضته على لِسانِ الشَّبَاةِ",91,"ه",1,0],["وا بأبي مَعقِدُ زُنّارِه","أفي الزّنانيرِ الزّنابيرُ",92,"ر",1,0],["وأبان الفضلُ عن أربابِه","فقضى للمجد أوفى أربِ",93,"ب",1,0],["وأبانَ عن سعيٍ شريفٍ ناظمٍ","منهُ عقودَ مآثرٍ ومَعالِ",94,"ل",1,0],["وا بأبي مَنْ لم يدَعْ","فيّ مكاناً للألَمْ",95,"م",1,1],["وأبانَ نشرُ حديثِه وجنانِه","أنفاسَ زهرِ الروضةِ الغنّاءِ",96,"ا",2,0],["وابأبي ظبء يروق شخصه","عيني وروحي لفظه إذا نطق",97,"ق",1,0],["وأَباح كُلَّ حمىً لكُلِّ مُضَلِّل","غَاوٍ أَباحَ حمى الهدى وحماكِ",98,"ك",1,0],["وأبان عن علمٍ يعبّ عبابُه","وبراعةٍ قُرنتْ بفهم مقاصد",99,"د",1,0],["وأباحَ المجدَ نفساً حرّةً","أمر المجدُ عليها ونهاها",100,"ا",3,0],["وأباحَ في السلم القوافي ما","بين الجزيل هناك والجزل",101,"ل",1,0],["وابأبي أحور كالظبي لدن","القدِّ فرد الحسن كالبدر",102,"ر",1,1],["وأباحت رماحهُ من منيعٍ","وحمى حدُّ سيفهِ من حدِّ",103,"د",1,0],["وابأبي أنت وذاك الشنب","والويل من غنجك لي والْحَرَبْ",104,"ب",1,1],["وأبا سراج إن ذكرت ومَرْثِدا","وقبيصة بن ضرار الخواض",105,"ض",1,0],["وأبانَ رُشدَ عِبادِه بك فاِهتدَوا","بعد الضّلالِ بأوضحِ النّجدَينِ",106,"ن",1,0],["وأبا قُبَيس في حَشاهُ تصاعدَتْ","قبَساتُ وجْدٍ حرُّها يَصلي حِرا",107,"ر",2,0],["وأبان نقصان الملوك كماله","بغرائب المعروف والعرفان",108,"ن",1,0],["وَأَبان زَمزَم بَعدَ طُول خفائها","وَفدى أَباه ولِلفداء تَقبلا",109,"ل",2,0],["وأَباتَنِي صِفْرَ الأناملِ من أخٍ","آوي إليهِ أوْ أبلُّ أُوامي",110,"م",2,0],["وأباتَنِي قَلِقَ الوساد كأنّني اِس","تَبْطَنْتُ للجنبين شوكَ سَيالِ",111,"ل",1,0],["وا بِأَبي مَن يَقولُ لي بِأَبي","وَمَن فُؤادي لَدَيهِ مُرتَهَنُ",112,"ن",1,0],["وأبانوا دلائلاً بعقول","قصدهم رد ما يقول العنيد",113,"د",1,0],["وأبان بمدح الدين لنا","عن ملته والكفر هجي",114,"ج",2,0],["وأَبا عُبَيْدَةَ مثلَهُ وجهُيَنةً","وسِواهما من كاتبٍ ومتُرجِمِ",115,"م",1,0],["وآبائي بنو عُدس بن زيد","وَخالي البشر بش