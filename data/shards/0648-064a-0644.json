,"https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54604","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43659","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43858","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54245","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54306","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54298","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[106,"رحلات عزام","https://www.poetsgate.com/ViewPoem.aspx?id=179550",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[77,"دعاكَ بأقصى المغربينِ غريبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33820",""],[50,"لا تَبْغ شَرَّ امْرىء شَرًّا من الدَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=19924",""],[54,"انظر إليهِ وإلى ظرفهِ","https://www.poetsgate.com/ViewPoem.aspx?id=13921",""],[45,"بِمِثْلِ لِقَائِهَا شُفيَ الغَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32059",""],[80,"في كُنْهِ قَدْرِكَ للعقولِ تَحَيّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=3214",""],[80,"يَهدِمُ دارَ الحياة ِ بانيها","https://www.poetsgate.com/ViewPoem.aspx?id=3760",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[51,"لها ناظرٌ بالسحر في القلب نافثُ","https://www.poetsgate.com/ViewPoem.aspx?id=27261",""],[39,"أَسَاءَكَ تَقْوِيضُ الخَلِيطِ المُبَايِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=4309",""],[20,"بكر العاذلون في وضح الصب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70005&r=&rc=27",""],[88,"برزت تميس كخطرة النشوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19539&r=&rc=42",""],[87,"من خالفَ الحَزمَ خانَتهُ مَعاذِرهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23977&r=&rc=239",""]],"verses":[["وَيُليحُ مِن خَوفِ الأَذى","فَرَقاً وَيَدَّرِعُ الكُلوما",0,"م",2,0],["وَيلٌ لِمَغرورٍ عَصاكَ فَإِنَّهُ","مُتَعَرِّضٌ لِمَخالِبِ الضِرغامِ",1,"م",1,0],["وَيُلقي إِلَيهِ عَظيمُ الزَمانِ","مِنَ المَأثُراتِ الأَجَلَّ الأَجَلّا",2,"ل",2,0],["وَيْلي مِنَ النَّفَرِ الغادينَ إِذ ظَعَنوا","بِها وَقَلبيَ يَتلوها عَلى الأَثَرِ",3,"ر",1,0],["وَيَلْمَعُ طاغِي الشَّفْرَتَيْنِ بِراحَتِي","وَراءَ عَجاجٍ راشِحٍ بِدَمٍ سَجْمِ",4,"م",1,0],["وَيُلْبِسُ جِيَدَهُ أَطْواقَ نُعْمَى","يَشِفُّ وَراءَها أَغْلالُ مَنِّ",5,"ن",1,0],["ويَلُفُّ كاشِحُهُ جَوانِحَهُ على","جُرْحٍ بعالِيَةِ القَنا مَقْروفِ",6,"ف",1,0],["ويُلْحِفُهُمْ ظِلاً منَ العَدْلِ وارِفاً","ويَرْعاهُمُ بالنّائِلِ الغَمْرِ والباسِ",7,"س",1,0],["ويُلْقي لدَيْهِ المُعْتَفونَ رِحالَهُمْ","بأفْيَحَ لا يَعْتادُهُ المَحْلُ مُخْصِبِ",8,"ب",1,0],["ويلفِظُ سَمْعي مَنطِقاً لمْ تَفُهْ بهِ","على أنّهُ كالسِّحْرِ لا بل هو السّحْرُ",9,"ر",1,0],["وَيلٌ لِشَيبانٍ إِذا صَبَّحتُه","وَأَرسَلَت بيضُ الظُبى شُعاعَها",10,"ع",3,0],["وَيلي بَليتُ مِنَ السِقامِ","وَنَفى الهَوى عَني مَنامي",11,"ي",1,1],["وَيلي عَلى الشادِنِ ذي القُرطَقِ","أَبلَجَ مِثلُ القَمَرِ المُشرِقِ",12,"ق",1,1],["وَيلي عَلى الخالِ عَلى خَدِّها ال","أَيسَرِ وَالخالِ الَّذي بِالذِراع",13,"ع",1,0],["وَيلي عَلى غَدّارَةٍ","حَلَّت عَلَينا بِالسَوادِ",14,"د",1,0],["وَيلي وَلا لي ثِقَةٌ","أَشكو إِلَيهِ كُرَبي",15,"ب",2,0],["وَيلي وَعولي وَما لي حينَ تَفلِتُني","مِن بَعدِ ما أَحرَزَت كَفّي بِها الظَفَرا",16,"ر",2,1],["وَيَلبَسُنا اللَيلُ البَهيمُ إِذا دَجا","وَنُبصِرُ ضَوءَ الصُبحِ وَالفَجرُ ساطِعُ",17,"ع",1,0],["ويَلْبَسُني الموْلى الإمامُ محمّدٌ","فتُبْصِرُ منْهُ الشّمْسَ تُوِّجَتِ البَدْرا",18,"ر",2,0],["وَيَلْقَى رِكَابَ الْحَجِّ وَهْيَ طَلاَئِح","طِلاَحٌ وَقَدْ لَبَّى النِّدَاءَ لَبِيبُ",19,"ب",1,0],["وَيلُ الخَلِيِّ مِنَ الشَجِيِّ فَإِنَّهُ","نَصِبُ الفُؤادِ بِشَجوِهِ مَغمومُ",20,"م",1,0],["وَيلاهُ هَل جُزتَ الحُدو","دَ وَأَنتَ مُختَرِقُ السُتورِ",21,"ر",1,0],["وَيلٌ لِمَن يَستَعمِرونَ بِلادَهُ","القَحطُ أَيسَرُ خَطبِهِ وَالهونُ",22,"ن",1,0],["وَيلي على عُمَرٍ يَرضى بمُوفِيَةٍ","على الكفافِ ويَنهَى مُستَزيديها",23,"ي",3,0],["وَيُلامُ الحَليمُ إِن هُوَ يَوماً","راجِعَ الجَهلَ بَعدَ شَيبِ القَذالِ",24,"ل",1,0],["وَيلي عَلَيهِ وَيلَةً","أَصبَحتُ حِصني مُنكَسِر",25,"ر",1,0],["وَيلُ اِمِّهِ مِسعَرَ حَربٍ إِذا","أُلقِيَ فيها فارِساً ذا شَليل",26,"ل",1,0],["وَيلي عَلَيكَ إِذا تَهُبُّ","الريحُ بارِدَةً شَمالا",27,"ل",2,0],["وَيلايَ ما أُرحَمُ وَيلاً لِيَه","إِذ رَفَعَ الصَوتَ النَدى الناعِيَه",28,"ي",2,0],["وَيلَكَ مَن دَلّاكَ في نِسبَةٍ","قَلبُكَ مِنها الدَهرَ مَذعورُ",29,"ر",1,0],["وَيلُمِّها رَوحَة وَالريحُ مُعِصفَةٌ","وَالغَيثُ مُرتَجِزٌ وَاللَيلُ مُقتَرِبُ",30,"ب",1,0],["ويل لمرتئسٍ قد قام مجتهداً","يسعى بجعلك للنواب ديوانا",31,"ن",2,0],["ويلوح للنظر القريب بوجها","عقل الحليم وعصمة الصبيان",32,"ن",1,0],["ويلمّها طفلة باتت مروّعةً","وبتّ من حولها في الليل ارعاها",33,"ا",3,0],["ويل لمن خانوا البلاد وما أبت","للأجنبيّ نفوسهم أن تركنا",34,"ن",2,0],["وَيْلُمِّها عيشةً نكداءَ يابسةً","لم تُبق من جسمها غير الألاويح",35,"ح",1,0],["ويل لبغداد مما سوف تذكره","عنّي وعنها الليالي في الدواوين",36,"ن",1,0],["ويلبس من تذليله العزّ ضافياً","وينظره شزراً بعين احتقاره",37,"ر",2,0],["وَيلَكُم يا قَصَباتِ الجَوفان","جيئوا بِمِثلِ قَعنَبٍ وَالعَلهان",38,"ن",1,1],["وَيَلوحُ في قُبلِ النِجادِ إِذا اِنتَحى","نَهجاً يَضُرُّ بِكُلِّ رَعنٍ أَقوَدا",39,"د",2,0],["وَيَلعَنُ فَذَّ أُمَّتِهِ جِهَارَاً","إِذَا سَاسَ البَرِيَّةَ والخَلِيعَا",40,"ع",2,0],["وَيلُ اُمِّ شَعثاءَ شَيئاً تَستَغيثُ بِهِ","إِذا تَجَلَّلَها النَعظُ الأَفاقيعُ",41,"ع",1,0],["ويلاهُ من ثلجٍ صميمٍ إذا","تساكت الناسُ لديه صمخ",42,"خ",1,0],["ويل لجفنيّ لا جفنيك من سهرٍ","لكيله في الدجى خسر وتطفيف",43,"ف",1,0],["ويلاه من ساجي اللواحظ أهيف","ما لي عليه سوى البكاء مساعف",44,"ف",1,0],["ويلك إن يفتح باب القضا","فقلتُ بل ويليَ أن يغلقا",45,"ق",2,0],["ويلومني فيها خليٌ ما درى","الشمس أم تلك المليحة أزين",46,"ن",1,0],["ويَليكَ النُّقصانُ في آخرِ الشه","ر فيمحوك من أديم السماءِ",47,"ا",2,0],["ويلوذُ لائذُنا بها","إن حبلُنا اضطربَ اضطرابهْ",48,"ب",2,0],["ويلفظُ ما فيهِ فليس مُعاجلاً","غريقاً بغتٍّ يُزهقُ النفسَ كاربِ",49,"ب",1,0],["ويلحظ ألحاظاً مِراضاً كأنها","تُغانجُ من يرنو لها وتُخانثُهْ",50,"ث",2,0],["ويلكِ يا قدَّ البَرَسْتُوجَهْ","ما أنت والله بمغْنُوجَهْ",51,"ج",2,1],["ويل لمن نام عن مَراشده","سينقضي ليْلُهُ وما رقدَهْ",52,"د",2,0],["ويل لها تستحثُّ ويلاً","من حاربت غير مستشيره",53,"ر",2,0],["ويلْحَى نفسَهُ أن يعذِروه","وليس له على القدر الخيار",54,"ر",1,0],["ويُلقَى إلى حُوت استه حوتُ يونسٍ","وثعبانُ موسى في لِزازٍ فَتَستَرِطْ",55,"ط",1,0],["ويُلَفِّقُ الأخبارَ لا متحرِّجاً","فيها ولو بدم النبي أشاطا",56,"ط",2,0],["ويْلي عليه بل على","نفسٍ أبت إلا خضوعا",57,"ع",2,0],["ويُلْزمني فيه الزكاةَ معاشرٌ","ولم يَحْوِه ملكي وبالحقّ ألزموا",58,"م",3,0],["ويلبسُ حين نخلعُه عليكم","وساماً من وجوهِكُمُ الوِسامِ",59,"م",1,0],["ويْلاهُ إنْ نَظَرتْ وإن هِيَ أعْرضتْ","وقعُ السِّهام ونَزْعُهُنَّ أليم",60,"م",1,0],["ويلُ من لا يُريغ سيْبَ يديه","من يديه وويلُه من لسانه",61,"ن",2,0],["ويُلزُّ القرينَ منه بأَلوَى","مَرِس الحبل مُحْصَد الأقران",62,"ن",1,0],["وَيلُ أُمِّ قَتلى فَوَيقَ القاعِ مِن عُشَرٍ","مِن آلِ عُجرَةَ أَمسى جَدُّهُم هِصرا",63,"ر",2,1],["وَيلُمِّ لَذّاتِ الشَبابِ مَعيشَةً","مَعَ الكُثرِ يُعطاهُ الفَتى المُتلِفُ النَدي",64,"د",2,1],["وَيَلَذُّ نَفسي أَن تَكونَ شَقِيَّةً","وَيَلَذُّ قَلبي أَن يَكونَ عَميدا",65,"د",2,0],["وَيلاهُ مِن جورِ الزَمانِ بِنا","وَالوَيلُ مِنهُ لِكُلِّ مُغتَرِّ",66,"ر",1,0],["وَيلُ اللَيالي لَقَد قَلَّدنَني ذَرِباً","أَدنى إِلى مُهجَتي مِن مُهجَةِ الخَصِمِ",67,"م",1,0],["وَيُلفى ذو الغِنى وَلَهُ جَلالٌ","يَكادُ فُؤادُ صاحِبُهُ يَطيرُ",68,"ر",1,0],["وَيلاهُ يا قَلبُ إِلى","داعي الهَوى ما أَعجَلَك",69,"ك",1,0],["وَيلاهُ ما يَلقاهُ قَل","بي مِنكُمُ وَما لَقي",70,"ي",1,0],["وَيَلومُني فيكُم وَلَستُ أَلومُهُ","هَيهاتَ ماذاقَ الغَرامَ وَلا دَرى",71,"ر",2,0],["وَيَلَذُّ لِيَ العَتبُ الَّذي","صِدقُ الوَدادِ عَلَيهِ باعِث",72,"ث",1,0],["وَيُلزِمُني بِتَصديقِ ال","لَذي قَد قالَ مِن كَذِبِ",73,"ب",1,0],["وَيلحُظُنا الزاهي وَسعدُ سعودِهِ","غيورَينِ وَالصَبُّ المُحِبُّ غَيورُ",74,"ر",1,0],["ويل لمن يصيبه","شواظه المضطرم",75,"م",1,0],["ويل لمملكة قضى اهمالها","من اهلها ان يفشل استقلالها",76,"ل",3,1],["ويل لقطر لا يتا","ح لاهله بالحق جهر",77,"ر",1,0],["ويلي على بيضٍ نشر","ن من الأسى سود الذوائب",78,"ب",1,0],["ويلقى عليه في السلام وفي الوغى","رجاء يراع أو رجاء مهند",79,"د",1,0],["ويلوذ العليل فيها إلى الط","ب وهل ينفع العليل العليل",80,"ل",1,0],["وَيُلقي عَلى السُمّارِ كَفّاً دِعابُها","كَعَضَّةِ بَردٍ في نَواحي المَفاصِلِ",81,"ل",1,0],["وَيُلاقي نَصَباً مِمّا اِنطَوى","في بَني العَلّاتِ مِن ضِغنٍ وَشَر",82,"ر",1,0],["وَيلُمِّها خُطَّةً وَيلُمِّ قابِلِها","لِمِثلِها خُلِقَ المَهرِيَّةُ القودُ",83,"د",1,0],["وَيَلقى كَما تَلقي مِنَ السِلمِ وَالوَغى","وَيُمسي كَما تُمسي مَليكاً بِلا مِثلِ",84,"ل",1,0],["ويليه هرمس وهو مصدوع الصدا","المدفون فيه وبرقه اللماحُ",85,"ح",1,0],["ويلُ اُمِّهِ نصراً لَوَ اَنَّ رجالَهُ","زحفوا إِلى الأعداء قيْدَ الإِصْبَعِ",86,"ع",1,0],["ويلي فقلبي عراقِيٌّ يرِقُّ لهُ","وقلبُه جبليٌّ قد جَفَا وقَسَا",87,"س",2,0],["وَيلَكُم وَيبَكُم لَقَد هُتِكَ الشِع","رُ فَبَكّوا لِسِترِهِ المَهتوكِ",88,"ك",1,0],["وَيَلؤُمُ سائِلُ البُخَلاءِ حِرصاً","وَإِشفاقاً كَما لَأُمَ البَخيلُ",89,"ل",1,0],["وَيلٌ لِفِلجٍ وَالمِلاحِ وَأَهلِها","إِذا جابَ دينارٌ صَفاها وَفَرقَدُ",90,"د",1,1],["وَيُلقى الرَحلُ عَنكِ وَتَستَغيثي","بِمِلءِ الأَرضِ وَالمَلِكِ الهُمامِ",91,"م",1,0],["ويلقاني بِعزَّةِ مُستطيلٍ","وألقاه بِذلَّةِ مُستهامِ",92,"م",1,0],["ويُلِمُّ مِن شَعَثِ العُلى بشَمائلٍ","أحلَى من اللَّعَسِ المُمنَّع واللَّمَى",93,"م",2,0],["ويُلبسُه ساقي المدامةِ حُلَّةً","ولكنَّه في كفِّ شاربه يَعْرَى",94,"ا",1,0],["وَيَلتَمِسُ الإِحسانَ بَعدَ إِساءَةٍ","فَلا تَحسَبَنَّ اللَهَ غَيرَ مُعينِهِ",95,"ن",2,0],["وَيلي وَيالَهفي عَلى أَمرَدٍ","يُلصِقُ مِنّي القُرطَ بِالحِجلِ",96,"ل",1,0],["وَيَلطُفُ بي مِن بَعدِ إِعمالِ لَحظِهِ","وَكَيفَ يُرَدُّ السَهمُ بَعدَ مُروقِهِ",97,"ق",2,0],["وَيَلَذُّ لي تَذكارُكُم فَأُعيرُ","أُذناً لِغَيرِ حَديثِكُم لَم تَأذَنِ",98,"ن",1,0],["ويلي من الماءِ والتراب ومن","أحكامها ضِدّيْن حُكّمَا فيها",99,"ي",3,0],["ويلتقي طرفاهُ إن هَزَزْتهما","كأنّما طرفاهُ منه في غصنِ",100,"ن",1,0],["ويْلي على مملوكةٍ مَلَكَتْ","رقّي بحُسْنِ مَقالها وَيْلي",101,"ل",2,1],["ويُلْحِمُهُ ابنُهُ ما اختار نهساً","بِمِنْسَرِهِ المُدَمّى من أنيضِ",102,"ض",1,0],["ويلٌ لِحصنِ لَبَيطَ من يومٍ على","جَنَبَاتهِ يجري النجيعُ الأحمرُ",103,"ر",1,0],["وَيلٌ لَهُ إِن دامَ هَذا بِهِ","مِن حُرَقٍ تُقلِقُ أَحشاهُ",104,"ا",2,0],["وَيلٌ لِجِسمي مِن دَواعي الهَوى","وَيلٌ مَعي يَدخُلُ في القَبرِ",105,"ر",1,0],["وَيلُمِّ صَبٍّ رَمى صُعوبَتَكَ ال","أولى فَلانَت بِلينِ جانِبِهِ",106,"ب",2,0],["وَيلٌ لِأُمِّكَ أَقصِر إِنَّهُ حَدَثٌ","لَم يَعتَقِد مِثلَهُ قَلبٌ وَلا جَلَدُ",107,"د",1,0],["وَيُلوي بِأَحداثِ الزَمانِ اِنتِقامُهُ","إِذاما خُطوبُ الدَهرِ بِالناسِ أَلوَتِ",108,"ت",1,0],["وَيْلاهُ مِنْ نَارِ الْهَوَى","وَآهِ مِنْ طُولِ الْجَوَى",109,"و",2,1],["وَيْلُمِّهَا خَزْيَة طارَتْ بِشُنْعَتِها","صَحَائِفٌ وَجَرَتْ بِالذَّمِّ أَقْلامُ",110,"م",1,0],["وَيْلاهُ مِمَّا أُلاقِي","مِنْ لَوْعَتِي وَهُيَامِي",111,"م",2,0],["وَيْلاهُ مِنْ ظَبْيِ الْحِمَى إِنَّهُ","جَرَّعَنِي بِالصَّدِّ مُرَّ الْحِمَامْ",112,"م",1,0],["وَيَلْحَقُهَا مِنْ رَوْعَةِ السَّوْطِ جِنَّةٌ","فَتَمْرُقُ شُعْثاً مِنْ فِجَاجِ الْمَخَارِمِ",113,"م",1,0],["ويلي على المغرى بعليائِها","سيضحكُ اليومَ ويبكي غدا",114,"د",2,0],["ويلي على الشهباءِ ويلُ الشهبا","قَدْ أصبحتْ بينَ الوحوشِ نهبا",115,"ب",2,1],["وَيَلأَمُ شَتّى العُلى وَالحِلى","عَلى حينَ أَصبَحنَ أَيدي سَبا",116,"ب",2,0],["وَيَلزَمُهُ النَصرُ حُبّاً لَهُ","فَإِن سارَ سارَ وَإِن حَلَّ حَل",117,"ل",1,0],["وَيَلثُمنَ مابَينَ الكَثيبِ إِلى الحِمى","مَواطِئَ أَخفافِ المَطِيّ الرَواسِمِ",118,"م",1,0],["وِيلسُونُ يعرفها ويَشهدُ أنّها","فصلُ الخطابِ وإن أَبَى المُتذَمِّرُ",119,"ر",1,0],["وَيْليِ على الفَارسِ المِغوارِ إذ حَسرتْ","عنه الدُّروعُ وخانته السَّرابيلُ",120,"ل",1,0],["وَيلي عَلى الجيرَةِ الغالينَ يَأخُذُهُم","مِن طارِقِ البُؤسِ حَتّى العُريُ وَالسَغَبُ",121,"ب",1,0],["وَيَلُمِّها أُمَّةً في مِصرَ ضائِعَةً","الخَسفُ مَرتَعُها وَالذِئبُ راعيها",122,"ي",3,0],["وَيْلُمِّهِ من غَبيٍّ","لو كان يعرف قصدَكْ",123,"ك",1,0],["ويلقى الأذَى بعد الأذى في سبيلِهِ","فَيَرضَى ويُغضِي الجفنَ في اللَّهِ صابرا",124,"ر",2,0],["وَيل لِوَعد الشَيخ مِن","عَزمات آساد روابض",125,"ض",1,0],["ويلٌ لقلبي كيف لم يفتك به","مرأى تقلبُّها على جنبيها",126,"ي",3,0],["وَيَلمُّ بي أَلم أُخاتله بِما","يَصف الطَبيبُ فَيَستَكين وَيَخمَد",127,"د",1,0],["وَيَلوح الصَباح لَوناً فلَونا","كُلَما الشَمس قاربته اِستحالا",128,"ل",2,0],["وَيلُ أُمِّ قَومِيَ قَوماً إِذا قُحِطَ","القَطرُ وَآضَت كَأَنَّها أَدَمُ",129,"م",1,0],["وَيُلاقِ قِرنٌ قِرنَهُ","مَشيَ المُصافِحِ لِلمُصافِح",130,"ح",1,0],["وَيُلقي نَقا الحِنّاءَتَينِ بِرَوقِهِ","تَناويطَ أَولاجٍ كَخَيمِ الصَيادِنِ",131,"ن",1,0],["وَيَلعَنُ المَولى إِذا دَعاهُ","وَوَجهُهُ إِن جاءَ في قَفاهُ",132,"ه",1,0],["وَيلي مِنَ الناسِ وَمِن لَومِهِم","ما لَقِيَ الناسُ مِنَ الناسِ",133,"س",1,0],["وَيْلُمِّهِ شاعراً أخمَلتْمُوه ولم","نَعلمْ له عندنَا قدْراً ولا خَطَرا",134,"ر",2,0],["وَيلي عَلى الريمِ الغَري","رِ الشادِنِ الأَحوى الأَقَبِّ",135,"ب",1,0],["وَيلاهُ مِن نارِ شَوقٍ","تَرقى إِلى اللَهَواتِ",136,"ت",1,0],["وَيلَ الفُؤادِ المُعَنّى","مِنَ الفِراقِ المُشِتِّ",137,"ت",1,0],["وَيلي عَلى شادِنٍ سَباني","أَحسَنُ مِن جُؤذَرِ الفَلاةِ",138,"ه",1,0],["وَيَلومُني في حُبِّها نَفَرٌ","خالونَ مِن شَجوي وَمِن ضُرّي",139,"ي",1,0],["وَيَلقَونا مِنَ التيهِ","بِتَكليحٍ وَتَعبيسِ",140,"س",1,0],["وَيلُمِّهِ صِلُّ أَصلالٍ إِذا جَفَلوا","يَرَونَ كُلَّ مُعَيِّ القَولِ مِغلاقا",141,"ق",2,0],["وَيلي فَلَيسَ يَرى لي","حَقّاً وَلَيسَ يُنيلُ",142,"ل",1,0],["وَيلي وَما هَكَذا يا","وَيلي يَكونُ الخَليلُ",142,"ل",1,0],["وَيلي عَلَيها وَيلٌ يَحِلُّ مَعي","في القَبرِ بَيني وَبَينَ أَكفاني",143,"ي",1,0],["وَيلي عَلَيهِ وَوَيلَتي مِن بَينِهِ","ما كانَ إِلاّ كَالخِضابِ فَقَد نَضا",144,"ض",2,0],["وَيَلومُني الصَلِفُ الخَلِيُّ وَإِنَّما","بَكَرَت وَساوِسُها عَلَيَّ وُفودا",145,"د",2,0],["وَيلي عَلى رَوَعانِها","وَلِسانِها المَلِقِ الخَلوب",146,"ب",1,0],["وَيلُ اِمِّهِ نَبَطِيّاً فَضَّ خاتَمَها","بِفَيشَةٍ مِثلِ رَأسِ الكَلبِ جَوفاءِ",147,"ا",2,0],["وَيَلهَمُ نُسّاكَها تُربُها","كَما ظَلَّ يَلهَمُ كُفّارَها",148,"ر",3,0],["وَيَلَذُّ أَطعِمَةَ البَقاءِ وَخَيرُها","كَالسُمِّ يُخلَطُ بِالحِمامِ وَيُؤدَمُ",149,"م",1,0],["وَيَلحَقُ بِالثَرى جَسَدٌ هَباءٌ","عَلى حَرَكاتِهِ وَرَدَ السُكونُ",150,"ن",1,0],["وَيلُ اُمِّهِم مَعشَراً جُمّاً بُيوتُهُمُ","مِنَ الرِماحِ وَفي المَعروفِ تَنكيرُ",151,"ر",1,0],["وَيلُ اُمِّها صاحِباً يُصاحِبُها","مُعتَسِفُ الأَرضِ مُقفِرٌ جَهِلُ",152,"ل",1,0],["ويليهم أبو نواسٍ كئيباً","وهو ذاك الممراحةُ السكير",153,"ر",1,0],["ويل لشعري كيف ضاع وإنه","لألذُّ من عَودِ الشفاء لموجع",154,"ع",1,0],["ويل لغانية لها","بعل من الجهل استبدا",155,"د",2,0],["ويل أَهل السماء من عقرب جا","ءت إليهم تدبّ في الظلماء",156,"ا",2,0],["وَيلاه جار الهَوى عليّا","واِنتزع البين من يديّا",157,"ي",2,0],["وَيلي من الأيام إن جديدها","أَخنى عليَّ وَنالَ من اجلادي",158,"د",2,0],["وَيلي لَها إن صادمت","جرماً من الأجرام صلدا",159,"د",2,0],["ويلي له من حادث","يستنفد الأعمار حصدا",159,"د",2,0],["ويلي على كأسٍ معربدة","وعلى دم في الكأس مهراق",160,"ق",1,0],["ويَلْبَسُ من جُلودِ عِداهُ سِبْتاً","ويَرْفَعُ من رُؤوسِهِمُ النِّضَادا",161,"د",2,0],["ويُلْفَى المَرءُ في الدنيا صحيحاً","كحَرْفٍ لا يُفارِقُه اعْتِلال",162,"ل",1,0],["ويلوذ بالأنواء حين تحثحث","ويحس ما هالوا التراب وماحثوا",163,"ث",3,0],["وَيلٌ لِشَيبانٍ إِذا صَبَّحتُها","وَأَرسَلَت بيضُ الظُبى شُعاعَها",164,"ع",3,0],["ويَلُومُونَ فيك يَا أبنَةَ عَبد ال","لَّه والقَلبُ عندَكُم مَوهُوقُ",165,"ق",1,0],["وَيْلُمِّهِ إِذْ مَخَضَتْ هَلْ دَرَتْ","أَنَّ الرَّدَى فِي بَطْنِهَا الْعَاقِدَهْ",166,"د",2,0],["وَيْلُمِّهِ رُزءَاً أَطَارَ نَعِيُّهُ","بِالْقَلْبِ شُعْلَةَ مَارِجٍ وَقَّادِ",167,"د",1,0],["وَيْلاهُ مِنْ لَحْظِها الْفَتَّاكِ إِنْ نَظَرَتْ","وَآهِ مِنْ قَدِّها الْعَسَّالِ إِنْ سَنَحَتْ",168,"ت",1,0],["وَيْلاهُ مِنْ نارِ الْهَوَى إِنَّهَا","لَوْلا دُمُوعِي أَحْرَقَتْ أَضْلُعِي",169,"ي",1,0],["وَيْلاهُ مِنْ حَاجَةٍ فِي النَّفْسِ هَامَ بِهَا","قَلْبِي وَقَصَّرَ عَنْ إِدْرَاكِهَا بَاعِي",170,"ي",1,0],["وَيْلُمِّهِ سَكَناً لَوْلا الدَّفِينُ بِهِ","مِنَ الْمَآثِرِ مَا كُنَّا نُجَاوِرُهُ",171,"ر",2,0],["وَيْلَ القَوِيِّ اليَوْمَ مِنْ","ذَاكَ الضَّعِيفِ وَقَدْ هَجَمْ",172,"م",1,0],["وَيْلَهُمْ مَا أَفَادَهُمْ أَنْ يُثِيرُوا","فِتْنَةً مِنْ خَبَائِثِ الأَعْمَاقِ",173,"ق",1,0],["وَيَلْتَقِمُونَ جَنَاحَ الْخَمِي","سِ إِذَا الْعَوْنَ أَعْيَى عَلَى المُنْجِد",174,"د",1,0],["وَيَلْزَمُ تَقْوَى رَبِّهِ كُلَّ سَاعَةٍ","وَيَذْكُرُهُ بِالْحَمْدِ ذِكْراً مُرَدَّدا",175,"د",2,0],["وَيَلُوحُ كِسْرَى مُشْرِفاً مِنْ قَصْرِهِ","شَمْساً تُضِيءُ مَهَابَةً وَجَلاَلا",176,"ل",2,0],["وَيَلِي المَنَاصِبَ لَمْ يُكَابِدْ دُونَهَا","حُرَقُ المَشُوقِ وَلاَ هَوَانَ العَاشِقِ",177,"ق",1,0],["وَيَلْقِي الدُّرُوسَ بِأَيِّ مَعَانٍ","تُنِيرُ العُقُولَ وَلَفْظٍ يُحَبْ",178,"ب",1,0],["وَيَلُوحُ وَالأَخْطَارُ تُحْدِقُ بِي","أَنَّ الرَّدَى لاَبُدَّ مصْطَادِي",179,"د",2,0],["وَيلاهُ إِن كانَت وَفاةُ سُلالَتي","لِوَفاةِ كُلِّ حَفيظَةٍ وَوَفاءِ",180,"ا",2,0],["وَيلَتا ما رَضَعتُ ثَديَ الأَماني","يا بُنَيَّ حَتّى أَتاني الفِطامُ",181,"م",1,0],["وَيلاهُ إِنَّ الزَمانَ أَودى","بِواحِدٍ ما لَهُ مُساوِ",182,"و",1,0],["وَيلَتا ما أَنشر الدُن","يا لِأَهليها وَأَطوى",183,"و",2,0],["وَيلاهُ وَيلاهُ لا أشفى بِتَثنية","حَتّى أزيدَ وَلا أشفى بِتَثليثِ",184,"ث",1,0],["وَيلَتا مِنكَ ما أَرى من يُهَنّي","بِحَبيبٍ حَتّى أَرى مَن يُعَزّي",185,"ي",1,0],["ويلي على جيران كوخي إنّهم","ألعوبة الإفلاس والإعياء",186,"ا",2,0],["ويلي لهم من بؤس محياهم ويا","ويلي من الإشفاق بالبؤساء",186,"ا",2,0],["وَيْلاَهُ من يَوْمِ الخمي","سِ فإنَّهُ يومٌ عَبُوسْ",187,"س",1,1],["وَيْلَ المنونِ تطاولت أحْداثُها","فَلَوتْ قناةَ الأَرْوعِ الشَّعْشَاعِ",188,"ع",1,0],["وَيَلْقَاك في كُلِّ وَجْهٍ صَبِيحٍ","بِغَيْر الْمَلاَحَةِ لم يُصْقَلِ",189,"ل",1,0],["ويلطِمُ القيدَ لا يروّعه","حديدُ جبّاره ولا سقره",190,"ر",2,0],["ويلَ الشبابِ من النعومةِ إنَّها","أعراضُ سُمٍّ للشعوبِ وشيك",191,"ك",1,0],["ويلبس بُردَ الشباب قشيبًا","إذا خلع الجامدون الشبابا",192,"ب",2,0],["ويلٌ لهم! أئذَا جافى مطامِعهم","قانونُ دولتكم عَدُّوه مَبْتورا؟",193,"ر",2,0],["ويلقى ركاب الحجِّ وهي طلائعٌ","طِلاحٌ وقد لبى النداءَ لبيبُ",194,"ب",1,0],["وَيْلُ کمِّهِ نَبَطِيًّا فَضَّ خَاتَمَهَا","بفيشة ٍ مثل رأسِ الكلبِ جوفاء",195,"ا",2,0],["ويلكَ ! منْ دلاكَ في نسبة ٍ","قبلكَ منها الدهر مذعورُ ؟",196,"ر",1,0],["وَيَلْؤمُ سائِلُ البُخَلاءِ حِرْصاً","وإشْفَاقاً، كَمَا لَؤمَ البَخيلُ",197,"ل",1,0],["ويلٌ لحصن ليبطَ من يومٍ على","جنباتهِ يجري النجيع الأحمر",198,"ر",1,0],["ويلي من الماءِ والتراب ومن","أحكام ضِدين حُكّمَا فيها",199,"ي",3,0],["ويلوذُ لائذُنا بها","إن حبلُنا اضطراب اضطرابهْ",200,"ب",2,0],["ويلحفنَ لا ينقُصنَ في ذات بيننا","على الدهر معهوداً وهنَّ حوانثُ",201,"ث",1,0],["ويلقي نقَا الحنَّءتينِ بروقِهِ","تناويطَ أولاجٍ كخيمِ الصَّيادنِ",202,"ن",1,0],["وَيَلومونَ فيكِ يا اِبنَةَ عَبدِ الْ","له وَالقَلبُ عِندَكُم مَوثوقُ",203,"ق",1,0],["ويلوح للنظر القريب بوجهها","عقل الحليم وعصمة الصبيان",204,"ن",1,0],["وَيْلُمِّهِ سَكَناً، لَوْلاَ الدَّفِينُ بِهِ","منَ المآثرِ ما كنَّا نجاوزهُ",205,"ه",1,0]]}