{"poems":[[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[74,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"من اليوم تعارفنا","https://www.aldiwan.net/poem42673.html","الهزج"],[72,"تعالوا بنا نطوي الحديث الذي جرى","https://www.aldiwan.net/poem42918.html","الطويل"],[30,"ليبك على الحجاج من كان باكيا","https://www.aldiwan.net/poem5316.html","الطويل"],[83,"هو البين يا موسى وقد كنت ثاويا","https://www.aldiwan.net/poem61555.html","الطويل"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[102,"الغبار والمرائي الباطنية","https://www.poetsgate.com/ViewPoem.aspx?id=50349",""],[96,"تلك الأقانيم الثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=15662",""],[186,"من آل يارد شهم قد قضى فثوى","https://www.aldiwan.net/poem61193.html","البسيط"],[186,"مضى إلى الله لطف الله مرتحلا","https://www.aldiwan.net/poem66960.html","البسيط"],[214,"قف قليلاً يا حادي الركب","https://www.aldiwan.net/poem13301.html","الخفيف"],[353,"لو وجد اللائم بعض ماوجد","https://www.aldiwan.net/poem20074.html","مجزوء الرجز"],[443,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[521,"بزينب المم قبل ان يرحل الركب","https://www.aldiwan.net/poem48740.html","الطويل"],[567,"من آل يارد في هذا الضريح فتى","https://www.aldiwan.net/poem52590.html","البسيط"],[580,"فراق قضى للهم والقلب بالجمع","https://www.aldiwan.net/poem3053.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38950","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38390","الرمل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105440","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72263","الطويل"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105223","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122103","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122000","الكامل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95389","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123144","الرمل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128263","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94309","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93861","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58279","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200140","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100840","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100825","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135563","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125833","البسيط"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105531","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83363","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33277","الخفيف"],[5072,"رهو ٌ هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=51900",""],[5848,"حبيبة قلبي البارح","https://www.poetsgate.com/ViewPoem.aspx?id=53161",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"انظر لجابر صادحاً بسّاما","https://www.poetsgate.com/ViewPoem.aspx?id=210304",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""]],"verses":[["مِنَ اليَومِ يَستَدعي مَنازِلَكَ البُكا","إِذا ما طَوى الأَبوابَ مَرُّ المَواكِبِ",0,"ب",1,0],["من آل يحيى كتاب الفضل متصل","فيهم بكفٍّ قويّ العزم طماح",1,"ح",1,0],["مِنَ اليَومِ تَعارَفنا","وَنَطوي ماجَرى مِنّا",2,"ن",2,1],["مِنَ اليَومِ تاريخُ المَحَبَّةِ بَينَنا","عَفا اللَهُ عَن ذاكَ العِتابِ الَّذي جَرى",3,"ر",2,0],["مِنَ اليَومِ لِلحَجّاجِ لَمّا غَدَوا بِهِ","وَقَد كانَ يَحمي مُضلِعاتِ المَكالِفِ",4,"ف",1,0],["مِنَ اليَومِ أَرِّخ فيكَ أَوَّلَ شِقوَتي","وَآخِرَ عَهدي بِالفُؤادِ المُعَذَّبِ",5,"ب",1,0],["مِنَ اليَهُودِ استَفَدْتُمْ ذَا الجحودَ كما","مِنَ الغُرابِ استفادَ الدَّفْن قابِيلُ",6,"ل",1,0],["من ، إلى ، مثل ذباب يرتمي","مثل ذكرى ، لا تلاقي من تذكر",7,"ر",1,0],["من آل يعرب لا تلين قناته","أنف أشمّ وساعد مفتول",8,"ل",1,0],["مِن آلِ يارِدَ شَهمٌ قَد قَضى فَثوى","رَمساً عَلَيهِ رِضى الرَحمنِ مَسكوبُ",9,"ب",1,1],["مِن آلِ يونُسَ مِن أَجرَى الأَنامِ يَداً","في المَكرُماتِ جَليل الذِّكرِ وَالشّانِ",10,"ن",1,0],["من الى العرش قد سما كرما","وترقى إلى سما الحجب",11,"ب",1,0],["مِن آلِ يَغْمُورَ الذينَ مَجْدُهُمْ","تَشابَهَ الوَالدُ فِيهِ وَالوَلَدْ",12,"د",1,0],["من آل يوسكٍ اللائي مناقبُهم","تتلى بحسن روايات وأخبار",13,"ر",1,0],["من اليَوم زوراها فان ركابنا","غداة غدٍ عَنها دَعا اهلَها نُكب",14,"ب",1,0],["من آلِ يارَدَ في هذا الضَّريحِ فتىً","قد كانَ في دارِهِ روحاً ورَيحانا",15,"ن",2,1],["من اليَعْرُبِياتِ المصونَاتِ بالَّذِي","أَثارتْه خيلُ الغائرينَ مِنَ النَّقْع",16,"ع",1,0],["مَن إِلَيهِ كلُّ حِذقٍ قَد نَحا","فَتَبَدّى بِالذّكي الفطِنِ",17,"ن",1,0],["مَنْ إِلى ساحَةِ علياكَ اِنتَمى","يشرُفِ الدّهرَ ولَم يَتَخسَّسِ",18,"س",1,0],["من إليه يلجى ويرجى نداء","أمحل العام أو دهت لثواء",19,"ا",2,0],["من اليوم لا أغترُّ ما عشت بالجدِّ","ولا أطلب العتبى من الخل بالعتب",20,"ب",1,1],["من إليه قواصد الوفد تطري","مقفر البيد سهلها بالحزون",21,"ن",1,0],["من اليمين واليسارِ فالتي","زادت عليه وضعها لم يثبتِ",22,"ت",1,0],["مِنْ آلِ يَعْرُبَ فِي العَدِّ الصَّرِيحِ لَهُ","مَحَاتِدٌ رَقِيَتْ أَعْلَى مَرَاقِيهَا",23,"ي",3,0],["مِنْ آلِ يَعْرُبَ فِي الصَّمِيمِ جَحَاجِحٌ","بِهِمُ الْمَعَالِي أصَبَحَتْ فِي نَخْوَةِ",24,"و",2,0],["من إلى الرز في المناسف صبه","وبه قد أتى ليتحف صبه",25,"ب",2,1],["من إلى أعلى مقام","قد تسامى في ارتفاع",26,"ع",1,0],["من إليه الكون قد ألقى القياد","مجريا أحكامه فيما أراد",27,"د",1,0],["من إليهم تنتمي خدمته","في المعالي حاز أعلى نسبه",28,"ب",2,0],["من إليكم يعزى كفاه بيانا","ما حمى اللفظ من بديع معاني",29,"ن",2,0],["من اليمنيات التي حرُّ وَجْهها","يفوقُ صقالا صَفْحَةَ الصّارمِ الهِندي",30,"د",2,0],["من اليأس داوى الناسُ بالكيّ داءهم","كذاك يداويني ذوو السجن بالصبر",31,"ر",1,0],["من اليوم لا قلبي عليها بمشفق","ولا مدمعي خوف الفراق بساكب",32,"ب",1,0],["من اليوم فليرجمك من كان مؤمناً","وان مت فليلعنك من كان مسلما",33,"م",2,0],["من اليهود والنصارى لُعِنُوا","عند الذي بربه قد يؤمنُ",34,"ن",1,0],["مِنَ اليَمِّ أَمَّ الأَراغِسَ رِفقا","فَماثَلَ كالنحاسَ شَكلاً وَنُطقا",35,"ق",2,0],["من اليم بالنوء تصطدمان","فتلهم نارك كل مكان",36,"ن",1,0],["من اليهودُ فلولاكم وجيشُكُمُ","لما استطاعوا بأَن يمشوا على قدم",37,"م",1,0],["من اليعملات الشم ترتاح في السرى","متى غرد الحادي وغنى دليلها",38,"ل",3,0],["من اليَوم أدركت الحَياة سَعيدَةً","بطيبة إِذ طابَت بِأَحمد مرقدا",39,"د",2,0],["من إلى وجنتيهِ ينتسبُ الور","دُ ومن وجهه سراجٌ منيرُ",40,"ر",1,0],["منّا .. لِيَخذل َ هذا الماء ُ جرّتَه ُ","عزائُها فيه ما لا يغفر ُ الوَشَل",41,"ل",1,0],["من اليوم الصباح اصبحت لا معطى ولا محروم","تركت الحب لاهل الحب واللي يتبع اوهامه",42,"م",2,0],["من اليوم ذلك أدركتُ أني","بدربي إلى أن أشيدَ الجبالا",43,"ل",2,0],["من آل يعربَ آلِ سلمانَ الذي","ربّى اللواء الجابر الصمصاما",44,"م",2,0],["مَن إِلى سِحرِ حَرفِي ساقَهُ ظَنٌّ","وَ اشتَكانِي, فَلا أُهدِي لَهُ سَمعا",45,"ع",2,0]]}