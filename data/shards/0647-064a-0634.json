oem.aspx?id=161943",""],[5121,"سُلْطَانُ الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=49547",""],[5121,"إِنْتِعَاش","https://www.poetsgate.com/ViewPoem.aspx?id=52925",""],[5121,"عَرُوسُ النُّورِ / بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215366",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5190,"روح وريحان","https://www.poetsgate.com/ViewPoem.aspx?id=121512",""],[5277,"بعيدةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187712",""],[5338,"أين الحميا من لمى من أرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[5431,"أن يظلّوا كشعلة مستنيره...","https://www.poetsgate.com/ViewPoem.aspx?id=198462",""],[5444,"قبلة الأشواق والإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=205445",""],[5459,"الصديقة","https://www.poetsgate.com/ViewPoem.aspx?id=190904",""],[5459,"مُنساق ..","https://www.poetsgate.com/ViewPoem.aspx?id=196575",""],[5525,"يسعد صباحك","https://www.poetsgate.com/ViewPoem.aspx?id=840",""],[5765,"موتٌ ينادي للولادة !","https://www.poetsgate.com/ViewPoem.aspx?id=213304",""],[402,"هذي رحاب دياب نشهدنا القرى","https://www.poetsgate.com/ViewPoem.aspx?id=36515",""],[5784,"كيد النساء أداري..","https://www.poetsgate.com/ViewPoem.aspx?id=190618",""],[5848,"طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=48954",""],[5853,"((عروسة الجنوب))","https://www.poetsgate.com/ViewPoem.aspx?id=175631",""],[5853,"شهقة","https://www.poetsgate.com/ViewPoem.aspx?id=175695",""],[5956,"لله أشكو ذلّتي","https://www.poetsgate.com/ViewPoem.aspx?id=182498",""],[5956,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=194897",""],[5956,"ترعَى الصداقةَ كندةُ الحمدونُ","https://www.poetsgate.com/ViewPoem.aspx?id=207260",""],[6093,"قُبْلَةُ المِلْيَارِ","https://www.poetsgate.com/ViewPoem.aspx?id=199427",""],[6139,"قرة العين","https://www.poetsgate.com/ViewPoem.aspx?id=212332",""]],"verses":[["هِيَ شَمسٌ عَزَمَت أَ","لّا تُنيلُ الخَلقَ نَيلا",0,"ل",2,0],["هِيَ شِيمَةُ الأَحْرَارِ مِنْ قِدَمٍ وَكَمْ","جَارَتْ عَلَيْهَا شِيمَةُ العُبْدَانِ",1,"ن",1,0],["هِيَ شِيمَةٌ العُرْبِ الكِرَامِ وَسِنَّةٌ","مَأْثُورَةٌ بِتَعَاقُبِ الأَزْمَانِ",2,"ن",1,0],["هِيَ شُعْلَةٌ كَانَتْ تُثِ","يرُ قَرِيحَتِي وَتُنِيرُ ذِهْنِي",3,"ن",2,0],["هي شيمة عذرية عوّدتُها","قلباً شَعاعاً ما يُرى بالسالي",4,"ل",2,0],["هِيَ شَيءٌ وَبَعضُ شَيءٍ وَحيناً","كُلُّ شَيءٍ وَعِندَ قَومٍ هَباءُ",5,"ا",2,0],["هِيَ شامِيَّةٌ إِذا ما اِستَقَلَّت","وَسُهيلٌ إِذا اِستَقَلَّ يَمانِ",6,"ن",1,0],["هي شمس الروح في","برج التجلي وضحاها",7,"ا",3,0],["هي شامية إذا ما استقلت","وسهيل إذا استقل يماني",8,"ن",2,0],["هِيَ شَمَائِلُ خَيْرِ الرُّسْلِ مَنْ نَطَقَتْ","لَهُ الْجَمَادَاتُ إِفْصَاحاً وَتَبْيِينَا",9,"ن",2,0],["هِيَ شَمس حَقّ تُشرق الدُنيا بِها","عَميت نَواظر مَن بَغى أَن تَأفلا",10,"ل",2,0],["هي شيمة الأيام كف تبتني","مذ كانت الدنيا وكف تهدم",11,"م",1,0],["هي شيمةٌ منه احتوتْ متغرِّباً","وصبَتْ لمؤثرِ هجرةٍ وبِعادِ",12,"د",1,0],["هي شيمة الأيام في أبنائها","من قائمٍ ذي مهلةٍ وحصيدِ",13,"د",1,0],["هي شيمة الأيام في الح","الين من كدرٍ وصفو",14,"و",1,0],["هي شمس الضحى وبدر الدياجي","قد فنينا بها رضاء وسخطا",15,"ط",2,0],["هِيَ شَمْسٌ فَإِنْ مِثَالُكَ يَوْمَاً","لاَحَ فِيْهَا فَأَنْتُمَا شَمْسَانِ",16,"ن",1,0],["هي شمس دارك تستنير بها وقد","حضنت بنيك كما كفتك ضرائرا",17,"ر",2,0],["هيَ شمس قد قابَلَت بدرَ تمّ","ما لهُ في جماله من مثالِ",18,"ل",1,0],["هِيَ شَمس حسن أَشرَقَت تاريخها","لتفيدة زهو بِنُور محمد",19,"د",1,0],["هي شيمة عُذريةُ ما عذرنا","إن كان يبذُلُ فارسٌ ويُعوض",20,"ض",1,0],["هي شقوة كانت عليك وقد","زالت وقطع كان فارتحلا",21,"ل",2,0],["هي شامية إِذا ما استهلت","وسهيل إِذا استهل يمان",22,"ن",1,0],["هي شكلٌ للجودِ ينتجُ دأباً","وسواها قد جاءَ شكلاً عقيما",23,"م",2,0],["هي شمس لو لم تلذ لعيني","وترى الشمس تارة في انمحاء",24,"ا",2,0],["هي شمس حظك أشرقت أنوارها","ميمونة الأسحار والآصال",25,"ل",1,0],["هي شمسُ حسنٍ غيرَ أنَّ شعاعَها","للواحظِ القالي المشاجرِ تنْبضُ",26,"ض",1,0],["هِيَ شامِيَّةٌ إِذا ما اِستَهَلَّت","وَسُهَيلٌ إِذا اِستَهَلَّ يَماني",27,"ن",2,0],["هِيَ شِرْعَةُ الاسْلامِ نُورُ بَصِيرَةٍ","وَوِقَايِةٌ منْ شَرِّ ما نَخْشاهُ",28,"ا",2,0],["هي شمسٌ والهمُّ ليلٌ وليس الل","يل والشَّمس في الوجود يدوم",29,"م",1,0],["هي شطر شطر الغب تعقب رعدتي","عيا يترجم عن خفاف بصاق",30,"ق",1,0],["هي شربُ سُكّانِ الجنانِ وسَائلوا","عن ذاك من قرأ الكتابَ المُنْزلاَ",31,"ل",2,0],["هي شمس فكيف بالغرب تبدو","مع فقد العلامة الأخرويه",32,"ي",2,0],["هي شبه الغزال جيداً وعينا","ونفاراً كما حكته حكاها",33,"ا",3,0],["هي شمس لها العفاف حجاب","وهو شهم له المرؤة عاده",34,"د",2,0],["هي شمس أفق المجد عائشة التي","غنيت فضائلها عن التبيان",35,"ن",1,0],["هي شرعة في الحب قد حكمت على","أهل الغرام بها الغصون الميد",36,"د",1,0],["هي شمس في الدجا كافية عن","ضوء مصابح ونار تتضرم",37,"م",1,0],["هي شمس وبالرصافة حلت","وهي خود وفي الجمال نبيه",38,"ي",2,0],["هي شمس العلى تمثلها الشمس","كما مثل النجوم الماء",39,"ا",2,0],["هي شمس الضحى سناً وسناء","وهي ريم الفلا جفوناً وجيدا",40,"د",2,0],["هي شلال بهجة وبهاء","يتداعى وجداً ويخفق حسنا",41,"ن",2,0],["هي شعلةٌ من نوره فإذا","ما شاءَ أظلم أو أضاءَ بها",42,"ب",3,0],["هي شيبة الإسلام فاقدر قدرها","قد أعتقتك وحق قدر المعتق",43,"ق",1,0],["هي شقة الوادي فما في جوها","نسم ولا في طيها من مدرج",44,"ج",1,0],["هي شنشنات قد بدت من اخزم","نفثات مصدور لهن أنين",45,"ن",1,0],["هي شبه الحمام في الجو لكن","أين من صوتها هديل الحمام",46,"م",1,0],["هي شمس الهدى لمن ضلَّ دوما","ما رأى بها اهتدى قط لو ما",47,"م",2,0],["هي شمس ضاءت بغير استتار","زندها في كلا الجديدين وار",47,"ر",1,0],["هي شهدة أم خمرة","والحد بالشبهات يدرا",48,"ر",2,0],["هي شمس من مغرب الشمس لاحت","فشعرنا من القيام اقترابا",49,"ب",2,0],["هي شمسنا تسعى إلى عليائها","وصباحنا رغم الدجى سيعودُ",50,"د",1,0],["هي شمعتي ليلي استنار بها","هي راحتي إن مسني التعب",51,"ب",1,0],["هيَ شيئة الأقدار أن احيا لكي","أجدَ الجراح تشكل اللغة الفريدة ؟",52,"د",2,1],["هي شمسُ إسلام البطولةِ، شمسُ إيمانٍ أصيلْ","هي شمس مَن قهر الظلامَ بدرْبهِ النّكِد الطّويلْ",53,"ل",1,0],["هي شجو مطويّ الضلوع على جوىً","وزفير مبدٍ في النواح معيد",54,"د",1,0],["هِيَ شَهْقَةٌ وَكَأَنَّنِي بِتَوَحُّدِي","أَنْعَشْتُ كَوْنَ كَوَائِنِي فَتَلَوَّنَا",55,"ن",2,0],["هِي شَهْقَةٌ مَبْلُولَةٌ فِي صَحْوَتِي","قَدْ سَلْسَلَتْ فِي النَّبْضِ عُمْرِي الْحَالِيَا",56,"ل",3,0],["هِيَ شَمْسٌ إِنَّمَا سَلْسَالهَا","فِي هَلَاكِ الأَرْضِ لَمْ يَشْفِ الأَثِيلَاَ",57,"ل",2,0],["هِيَ شَمسُ هُولَندَا الَّتِي غَابَتْ ولَم","تَضرِبْ لِقَلبِي مَوعِداً لِلِقَائِهَا",58,"ا",3,0],["هيَ شَهرَ زَادُ الحُلمِ ، قَد صَفَحَت فَأَضْ ..","حَى شَهر يَارُ المَوتِ مِن عُتَقَائِهَا",59,"ا",3,0],["هيَ شمسُ قلبي لم تزلْ","هذي النساءُ لها كواكبْ",60,"ب",1,0],["هِيَ شِرْعَةُ اللهِ.. الْحَبِيبُ رَسولُهَا","مَنْ كَانَ للرَّحْمَنِ أَشْرَفَ مُنْتَجِ",61,"ج",1,0],["هي شمّاء استبعدتْ من رخاءٍ","بالبلاءات أُترعتْ مستطيره",62,"ر",2,0],["هي شوكةٌ للمعتدي،هي للذي","طلبَ العلومَ، وقبلةُ الإيمان",63,"ن",1,0],["هي شمسُ كل الصالحات وما لَها","دون الشموس المشرقات أفولُ",64,"ل",1,0],["هي شمسُ آفاقي .. ونورُ سريرتي ..","مُذْ أبْصَرَتْ عيني ضُحًى إِشراقَها ..",65,"ق",3,0],["هى شمسنا اللي في جبينك تلاجا","والا قمرنا اللي فقدناه من امس",66,"س",1,0],["هي شهقة الندم الغريق لما مضى","ذكرى اللهيب على رماد سنينِ",67,"ن",1,0],["هي شيمة العرب الكرام وسنة","ماثروة يتعاقب الزمان",68,"ن",1,0],["هي شرعةٌ لله لست بمنكرٍ","لكنني كيد النساء أداري",69,"ر",2,0],["هي شيخةٍ كل ما يقسي زمنها تلين","بياضها عن سوادٍ لفّ بعض الدروب !",70,"ب",1,0],["هي شمعتي الولهى شجون صبابتي","نورٌ مضيءٌ في دروب جوادي",71,"د",2,0],["هي شهقةٌ ولهانة الانطاقِ","عطر يضوع بروضة العشاقِ",72,"ق",1,1],["هي شر أنثى شاهدتها أمّتي","وأبث همّي للإله وشقوتي",73,"ي",1,0],["هي شعلةُ الإيمانِ تُشرق في الحشا","في الروحِ والوِجدانِ ليس مظهرا",74,"ر",2,0],["هي شابة تحوي براءة طفلةٍ","ولها ضميرٌ بالوداد متينُ",75,"ن",1,0],["هيَ شكرُ مصرَ مع الشَّآ","مِ مع الجزائرِ وَ اليَمنْ",76,"ن",1,0],["هيَ شَوقُ تونسَ والعرا","قِ مَعَ الكُوَيْتِ كَذَا عَدنْ",76,"ن",1,0],["هي شَمْسُهُمْ عِنْد الغُرُوْبِ وظلّهمْ","أَبْقَى سُكُونَ الجِسْمِ والأحْجَامِ",77,"م",1,0]]}