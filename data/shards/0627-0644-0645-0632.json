{"poems":[[85,"ذيب نرهن ذا الغفاره","https://www.aldiwan.net/poem54202.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85545","الكامل"],[301,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[302,"حي الشآم وربعها","https://www.aldiwan.net/poem36827.html","عموديه"],[370,"إن كنت تترعه كأسا لمكتئب","https://www.aldiwan.net/poem17314.html","البسيط"],[541,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"]],"verses":[["المزاح غلب عليّا","والهوى لشنّه فنّي",0,"ي",1,0],["المزهقون نفوسهم","لا يقدرون على الإعاده",1,"د",2,0],["المزح والدُعابَه","من شيمِ الصَحابَه",2,"ه",1,0],["(المزّةُ) العلياءُ ذا","ت الظلِّ والدوْحِ النضير",3,"ر",1,0],["المَزجُ غَوّاصُها وَالكَأسُ لُجَّتُها","وَاللُجُّ مِن ذَهَبٍ وَالدُرُّ مِن حَبَبِ",4,"ب",1,0],["المَزايا في الرَّزايَا","هُوَ دِيني باعتِقَاد",5,"د",1,0]]}