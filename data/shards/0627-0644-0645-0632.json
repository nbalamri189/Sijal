{"poems":[[85,"ذيب نرهن ذا الغفاره","https://www.aldiwan.net/poem54202.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85545","الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[303,"حي الشآم وربعها","https://www.aldiwan.net/poem36827.html","عموديه"],[371,"إن كنت تترعه كأسا لمكتئب","https://www.aldiwan.net/poem17314.html","البسيط"],[543,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16947","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46507","الرجز"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48255","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93691","الكامل"],[4806,"ماخنت ابنظر","https://www.poetsgate.com/ViewPoem.aspx?id=190863",""],[5848,"تلعثم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=53100",""],[5956,"رصاص وشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192450",""],[6131,"نَوابضُ الضَّادْ","https://www.poetsgate.com/ViewPoem.aspx?id=189282",""]],"verses":[["المزاح غلب عليّا","والهوى لشنّه فنّي",0,"ي",1,0],["المزهقون نفوسهم","لا يقدرون على الإعاده",1,"د",2,0],["المزح والدُعابَه","من شيمِ الصَحابَه",2,"ه",1,0],["(المزّةُ) العلياءُ ذا","ت الظلِّ والدوْحِ النضير",3,"ر",1,0],["المَزجُ غَوّاصُها وَالكَأسُ لُجَّتُها","وَاللُجُّ مِن ذَهَبٍ وَالدُرُّ مِن حَبَبِ",4,"ب",1,0],["المَزايا في الرَّزايَا","هُوَ دِيني باعتِقَاد",5,"د",1,0],["المَزحُ في مَوضِعِهِ","كَالجَدِّ في مَوضِعِهِ",6,"ه",1,0],["المزيَديّ الأَسديّ صدقه","وَمن إِذا كذَّب مَدح صدقه",7,"ه",1,0],["المزْدرِي بذَكا وحلمٍ راسخٍ","راسٍ إياساً وابنَ قيسِ الأحنفِ",8,"ف",1,0],["المزدهي بِجَديد أَثواب العُلى","وَعَلى سِواه مَعارة اسمالها",9,"ل",3,0],["ال مزعله الهوه يغرگ ابحضن الماي","وبس يسمع بأمه أتذب خبزهه يطوف",10,"ف",1,0],["المزهريه تناظرني وتنزف جراح","وانا اتهجى مواجعها وتنهيدها",11,"د",3,0],["المزح هذا قد يدسّ رصاصة","ويدك عرش الشعرِ وهو وطيدُ",12,"د",1,0],["المُزنُ روحٌ سرَتْ في غيمَةٍ هطلتْ","وَ الرَّمضُ في الصَّيفِ يَجتاحُ الثَّرَى بِرِضَا",13,"ض",2,0]]}