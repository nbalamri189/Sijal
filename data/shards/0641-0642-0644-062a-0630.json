{"poems":[[37,"تقطع من ظلامة الوصل أجمع","https://www.aldiwan.net/poem39137.html","الطويل"],[53,"أبو سليمان لا ترضى طريقته","https://www.aldiwan.net/poem66494.html","البسيط"],[30,"إذا شئت غناني من العاج قاصف","https://www.aldiwan.net/poem5017.html","الطويل"],[287,"تقول صحابي والمطي بنا تخدي","https://www.aldiwan.net/poem32793.html","الطويل"],[398,"وقائلة لم عرتك الهموم","https://www.aldiwan.net/poem53429.html","المتقارب"],[411,"يقولون كم تشقى بدرس تديمه","https://www.aldiwan.net/poem49445.html","الطويل"],[412,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83290","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87167","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44567","السريع"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62609","المتقارب"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78031","البسيط"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142768","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121182","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60873","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137170",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134089","الرجز"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104844","المتقارب"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35592","الطويل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143865","المجتث"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125882","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104894","المتقارب"],[4830,"رهيفُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=205693",""],[5512,"إسراف في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=206699",""],[6355,"داء لا مناص منه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66626&r=&rc=86",""]],"verses":[["فَقُلتُ ذَريني بِئسَ ما قُلتِ إِنَّني","عَلى البُخلِ مِنها لا عَلى الجودِ أَتبَعُ",0,"ع",1,0],["فقلت ذاك أجلُّ الخلقِ كلهمُ","أبوك آدم هل هذان سيان",1,"ن",1,0],["فَقُلتُ ذَريني مِن زِيادٍ فَإِنَّني","أَرى المَوتَ وَقّافاً عَلى كُلِّ مَرصَدِ",2,"د",1,0],["فَقُلتُ ذَروني لا أَبا لِأَبيكُمُ","فَبِالقَدحِ يَبدو السُقطُ قَسراً مِنَ الزِندِ",3,"د",1,0],["فَقُلتُ ذَريني عَلى غُصَّتي","فَاِنَّ الهمومَ بِقَدرِ الهِمَم",4,"م",1,0],["فقلتُ ذروني إنّما أنا كادِحٌ","لأكملَ ذاتي أو لأجَبرَ نقصاني",5,"ن",2,0],["فَقلت ذر عَنكَ لَومي لا تَفندني","يَكفيكَ ما قَد أَقاسيهِ مِن النوَبِ",6,"ب",1,0],["فَقُلتُ ذَروني وَالأَسى لَيسَ مُغنِياً","كَلامَ خَطيبٍ مَعَ كَلامِ خُطوبِ",7,"ب",1,0],["فَقُلتُ ذاكَ بِتَوفيقِ الإِلَه وَمن","سِواه أَولى بِمَدحي مِن بَني زَمَني",8,"ي",1,0],["فَقُلتُ ذا مَن طالَ في حُبِّهِ","مِنكُم لِيَ التَعنيفُ وَالزَجرُ",9,"ر",1,0],["فَقُلتُ ذا بِخاطِري لَقَد خَطَر","قَبل وَإِن قَدّره اللَّه صَدَر",10,"ر",1,0],["فقلت ذريني على حالتي","فإنَّ الهموم بقدر الهِمَمْ",11,"م",1,0],["فَقُلت ذا مَلِكٌ لِلشُهب يَحمل أَم","غَزال أُنس يُحاكي البَدر في الأُفُقِ",12,"ق",1,0],["فقلتُ ذاكَ على قدري ورفعته","دليلُ صِدقٍ إذا ما أُنعِمَ النَّظَرُ",13,"ر",1,0],["فقلت ذا ذهب لازلت اجهله","اما تراه جميل الشكل منتخبا",14,"ب",2,0],["فقلْتُ ذكرك في الدنيا باجمعِها","فقال نابي يَحْمِيَها وأظفاري",15,"ر",2,0],["فقلت ذا قول مهذار فلا تثقوا","به ولو جاء من لوقا به الخبر",16,"ر",1,0],["فقلت ذوبوا حرة","فرأيكم غير مشيد",17,"د",1,0],["فقلت ذريني على غصتي","فمثلي على مثلها لم يلم",18,"م",1,0],["فَقُلتُ ذَريني ربّ ساعٍ مُخيّب","وَلِلّه في كُلِّ الأُمورِ لَطائفُ",19,"ف",1,0],["فقلت ذا التيس من هو","فقال قاضي شلمبه",20,"ه",1,0],["فقلت ذا أرجٌ قد جاء من فَرَجٍ","وشعرُهُ كان قبل الآن يعجبني",21,"ن",2,0],["فقلت ذريني وقطع الفلاة","فأما لخير وأما لشر",22,"ر",1,0],["فقلتُ ذي دعوةُ العُشّاقِ مُذ بدَأتْ","فضّاحةَ الصّبِّ دوماً كيفما صنَعا",23,"ع",2,0],["فقلتُ ذابَ وريدي من تباعدِنا","وصرتُ من وَقَدِ الأشواقِ مصهورا",24,"ر",2,0],["فقلتُ ذلك داءٌ لا مناص لنا","من قبضته فكيف البُرْءُ يا أملي؟",25,"ل",2,0]]}