51392",""],[5431,"كأنّك...","https://www.poetsgate.com/ViewPoem.aspx?id=183031",""],[5431,"شفاه ثائرة ...","https://www.poetsgate.com/ViewPoem.aspx?id=210289",""],[5431,"الرحمى ....","https://www.poetsgate.com/ViewPoem.aspx?id=215240",""],[5582,"أَسِيرُ غَرامٍ ذائِبُ القَلْبِ مَعْمُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=63499",""],[5628,"الى قريتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=178470",""],[5628,"ميادة الحناوي تألق دائم *","https://www.poetsgate.com/ViewPoem.aspx?id=182932",""],[5763,"أطلال الشِعر","https://www.poetsgate.com/ViewPoem.aspx?id=27061",""],[5781,"حينَ يصيرُ الغيمُ أبيضَ","https://www.poetsgate.com/ViewPoem.aspx?id=202845",""],[402,"من عذيري والدمع جارس خين","https://www.poetsgate.com/ViewPoem.aspx?id=36541",""],[5791,"غزلٌ فتيّ ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208173",""],[5815,"عَلمْ","https://www.poetsgate.com/ViewPoem.aspx?id=192033",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5829,"وليس لعاشق عنها حياد","https://www.poetsgate.com/ViewPoem.aspx?id=204665",""],[5943,"دموع الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=34335",""],[5969,"سلام لمن رحلوا","https://www.poetsgate.com/ViewPoem.aspx?id=199203",""],[6029,"نشيج المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=189014",""],[6102,"رب القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=184158",""],[6124,"رسالة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=109743",""],[6125,"لماذا الحبُّ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=210965",""],[6320,"صُرُوفُ الدَّهْر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84358&r=&rc=55",""],[6345,"يؤرقني الضياعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78671&r=&rc=42",""]],"verses":[["يورِقُ مِنهُنَّ الحَصى","حَتّى يَكادُ يُجتَنى",0,"ن",2,0],["يورِدُها بَينَ نِطاعٍ فَالنَقا","زُرقَ جِمامٍ لَبِسَت يراعَها",1,"ع",3,0],["يُؤَرِّقُني التَذَكُّرُ حينَ أُمسي","فَأُصبِحُ قَد بُليتُ بِفَرطِ نُكسِ",2,"س",1,1],["يُورِدُ النَّادِرَاتِ أَظْرَفَ إِي","رَادٍ وَيَعْدُو أَخَفَهُنَّ المُجُونُ",3,"ن",1,0],["يوري زناد الفضل بالمجد والعلى","ولكنه الفعل البريءُ من القدح",4,"ح",1,0],["يؤرِّقني سَقْفٌ كأّنيَ تحته","من الوكفِ تحت المُدْجِنات الهواضبِ",5,"ب",1,0],["يُورِدُ من حِلِّه على كرمٍ","ثُم إلى العارفات إصداره",6,"ر",2,0],["يُورِّقُهُ إذا البرقُ استنارا","هوىً يقتادُ عَبْرتَه اقتسَارا",7,"ر",2,1],["يُورِدُها حوضَ المَنايا فتَرِدْ","فحينَ لاحَ الفجرُ مُنصاتَ العَمَد",8,"د",1,0],["يُؤَرِّقُهُ لَهيبُ الشَو","قِ بَينَ السَحرِ وَالكَبِدِ",9,"د",1,0],["يورَدنَ عَيناً قَد تَفَجَّرَ ماؤُها","زَوراءَ صافِيَةً كَذوبِ زُجاجِ",10,"ج",1,0],["يُوَرِّدُ خَدَّيْهِ الجِلادُ وسَيْفَهُ","فذَاكَ إذَا شَبَّهْتَهُ الأَسَدُ الوَرْدُ",11,"د",1,0],["يورِدُ الهَمَّ وَلا يُمرِضُهُ","حازِمٌ في الوِردِ مَحمودُ الصَدَر",12,"ر",1,0],["يُوَرِّثُها بَنوكَ بَني بَنيهِم","إِذا هَلِكوا وَمَنشَرُها جَديدُ",13,"د",1,0],["يُؤرِّقني تَذَكُّرُهَا مَبِيتاً","ويُقلقني تَذَكُّرُهَا مَقِيلا",14,"ل",2,0],["يُؤرّقُ جَفنِي مِنهُ غُنجُ مَحاجِرٍ","تَعدّ مِنامَ الجفنِ حِجراً مُحَجّرا",15,"ر",2,0],["يؤرَّخُ من ميلاد سعدك عَصْرُها","وتُحصَى بأعمار النسور دُهورُها",16,"ر",3,0],["يورحت إذا مع المعلين ذنبا","صروف الدهر بعد هوى إلينا",17,"ن",2,0],["يُؤَرِّقُهُ بَرقُ الغَمامِ إِذا سَرى","وَيُقلِقُهُ نوحُ الحَمامِ المُغَرِّدِ",18,"د",1,0],["يؤرقه طيف الخيال إذا سرى","وتذكي حشاه نفحة وهبوب",19,"ب",1,0],["يُؤَرِّقُه خوفٌ عليهم ليأمَنوا","إذا الدّهرُ أزجَى نحوَهم حادِثاً إدّا",20,"د",2,0],["يورثك هما وغما وامتحان","والخسر والنقص في دنيا ودين",21,"ن",1,0],["يُؤَرّقني فيه الحمامُ ونَوْحُه","وما كانَ وَجدي مثلَ وَجْد الحمائم",22,"م",1,0],["يؤرِّقني فيه تألُّقُ بارقٍ","كما اسْتلَّ ماضي الشّفرتين صقيل",23,"ل",1,0],["يؤرقني ويشغلني ويمضي","فيترك في الحشا همّا ثقيلا",24,"ل",2,0],["يؤرق بعدي عنك حتى كأنني","إلى النفي أمضي لا إلى جنة فيحا",25,"ح",2,0],["يُوري شهاب النجح من خلالها","لأعين العافين نوراً ساطعا",26,"ع",2,0],["يوري الدجى بموقدٍ","من جوده المشعشعِ",27,"ع",1,0],["يُوَرَّي حياءً والندامةُ غُصةٌ","لها خَدشةٌ في صدره ونُدوبُ",28,"ب",1,0],["يؤرّقني البرقُ الحجازيُ كلما","سرى والعيونُ المسهراتُ رقود",29,"د",1,0],["يؤرَّقُ ناظري كَلَفاً ووَجْداً","هديلٌ باتَ في الباناتِ ساجعْ",30,"ع",1,0],["يُؤرَّقُها بُعْدُهُ فوقَها","اِذا غابَ عن ناظِرَيْها طويلا",31,"ل",2,0],["يُؤرَّقُني حنينٌ وادكارُ","وقد خلتِ المرابعُ والديارُ",32,"ر",1,1],["يؤرِّقها ذكراكمُ كلَّ ليلةٍ","وأعينُ باقي العاشقينَ رقودُ",33,"د",1,0],["يوري النّوى أيَّ نارٍ في جوانحِه","أمَا تَرَوْنَ سَناها في نَواصِيهِ",34,"ي",2,0],["يُؤَرِّقُنا إِذا نِمنا","وَيَبعُدُ عَنكَ مَسرَبُها",35,"ب",3,0],["يُورِّدُ خَدَّيهِ طُولُ العِتابِ","وَيَصبِغُ وَجنَتَهُ بِالخَجَل",36,"ل",1,0],["يوري زنادك ما قدحت ولا ترى","إثر العطايا نادما تتسفُ",37,"ف",1,0],["يورّثه المجدَ المؤثّل يعربٌ","وَيرفعهُ في مشمخرّ العلا هودُ",38,"د",1,0],["يورّثه المجدَ الأثيل مظفّرٌ","وَغوث وهود والخلود ويشجبُ",39,"ب",1,0],["يُؤَرِّخُ ذُو الأَمْدَاحِ مِمَّا جَنَتْ بِهِ","يَدَاهُ تَوَارِيخَ السَّعَادَةِ وَالنَّصْرِ",40,"ر",1,0],["يؤرخ دم يا حيُّ نجِّح عليَّنا","أمير أميرَيِّ العلى والمكارم",41,"م",1,0],["يورِّد الكاس والصهباء ناصعة","إذا أراق عليها وجهه الخفرا",42,"ر",2,0],["يؤرقه بعادك كل ليل","توهم طول زفرته فطالا",43,"ل",2,0],["يؤرقني ذكر الحمى فتهزني","معاهد فيها مربعي وظلالي",44,"ل",2,0],["يؤرقني والعين بالشوق تأرق","سنا بارقٍ من نحوها يتألق",45,"ق",1,1],["يؤرقه برق يلوح وعبقة","تفوح وَوُرْقٌ فوق أوراقها تشدو",46,"د",2,0],["يوري يلاقي اوجَه العُداة","يَلقاك جَوّال بشاهقات",47,"ت",1,0],["يؤرقني في الدوح نوح حمامةٍ","تحن فلا يبقى لذي جلد صبرا",48,"ر",2,1],["يورط في حوض من الوحل غامرٍ","مجانينه حتى يفيقوا ويسغبوا",49,"ب",3,0],["يورطني في الحوض غمساً مكرراً","إلى عنقي منه إلى الرشد أضرب",49,"ب",1,0],["يورث شخصي الحي شخصيَ ميتاً","ولم أرَ قبلي ميتاً يرث الحيّا",50,"ي",2,0],["يؤرخه صفا الفرما","ن للعباس مبتسما",51,"م",2,0],["يؤرقه الوميض إذا تجلى","سنا برق بذي سلم وضال",52,"ل",1,0],["يؤرقني بعوضٌ في ليالٍ","بها عهدُ الأمان من الشموس",53,"س",1,1],["يورّي في الدجى لثم العوالي","فم الطعنات سنبكه الورِي",54,"ي",1,0],["يورِدُ السّيفَ في دِماءِ عِداهُ","فيُروّي في بَحْرِه ظَمْآنَهْ",55,"ن",2,0],["يورق عينيه صرف الزمان",