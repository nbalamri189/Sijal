{"poems":[[66,"سر السرائر مطوي بإثبات","https://www.aldiwan.net/poem67661.html","البسيط"],[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[87,"ذكر الحداثة جهلها وغرامها","https://www.aldiwan.net/poem7105.html","الكامل"],[47,"إن الحكيم له مقال سائر","https://www.aldiwan.net/poem65137.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[66,"سرّ السرائر مَطْوِيٌّ بِاثْبَات","https://www.poetsgate.com/ViewPoem.aspx?id=3135",""],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[435,"أسناء برق لاح أم","https://www.aldiwan.net/poem41420.html","مجزوء الكامل"],[556,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53144","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53108","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53040","المجتث"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118808","المديد"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132719","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[2052,"بالظاهر الملك الميمون طائره","https://www.poetsgate.com/ViewPoem.aspx?id=189619",""],[5277,"حمامةٌ هجرتْ هديلَها","https://www.poetsgate.com/ViewPoem.aspx?id=187687",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِالظَنِّ وَالوَهمِ نَحوَ الحَقِّ مَطلَبُهُم","نَحوَ السَماءِ يُناجونَ السَمَواتِ",0,"ت",1,0],["بالظِّلِّ والضَّوءِ الحزينِ الدَّامي","قَدْ سِرْتُ في غابي كفِكْرٍ هائمٍ",1,"م",1,0],["بالظهر من حمدون أو رمّانه","بيت تمل النفس فيها مقامها",2,"م",3,0],["بِالظَنِّ تَحتِمُهُ عَلَينا ظالِماً","وَالظَنُّ لَيسَ عَلى اليَقينِ بِواقِعِ",3,"ع",1,0],["بالظبى البيض وسمر الأسل","عقت البلغار والحلم قضى",4,"ض",2,0],["بالظنّ والوهم نحو الحقّ مطلبهم","نحوَ الهواء يناجون السماوات",5,"ت",1,0],["بِالظِلِّ ذي الثَلاثِ مَركوساً إِذا","عَلا بِهِ التَكريرُ في الدارِ اِنحَدَر",6,"ر",1,0],["بالظبي قد شبهتني","والظبي مرباه الاكم",7,"م",1,0],["بِالظُّبا ثمّ القَنا يَفْ","ري وَريداً وَتَريبا",8,"ب",2,0],["بالظرف رفع عامل أو ما يجر","يأتي على اعتماد خمس كاستقر",9,"ر",1,0],["بالظاهر الملك الذي زاد على","ما شاد أيوب وأعلى يوسف",10,"ف",1,0],["بالظاهر الغازي الذي ظهرت","بلزوم ظاهر أمره السور",11,"ر",1,0],["بالظاهر الملك غازي ب","ن يوسف وبخصبه",12,"ب",2,0],["بالظهور الصرف محتجب","أنت هذا صحَّ في الأثرِ",13,"ر",1,0],["بالظلم يجزي العداة الظالمين له","وظلمه العدل في تاديب مجترم",14,"م",1,0],["بِالظَّاهِرِ اخصُص مُنذُ مُذ وَحَتَّى","وَالكَافَ وَالوَاوَ وَرُبَّ وَالتا",15,"ت",2,0],["بالظاهر الملك الميمون طائره","لانت صروف الليالي حيث لم تكنِ",16,"ن",1,1],["بالظلِّ أرسمُ ذكرياتِ حبيبتي","فوق الجدارِ وفوقَ بابِ الدارِ",17,"ر",1,0],["بالظاهر النور بوجه الأثر","بالباطن الذات عن المستر",18,"ر",1,0]]}