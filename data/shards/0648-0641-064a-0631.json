{"poems":[[35,"تقطع من ظلامة الوصل أجمع","https://www.aldiwan.net/poem39137.html","الطويل"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[93,"ألصيد لهو الملوك من قدم","https://www.aldiwan.net/poem11360.html","المنسرح"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[92,"صبي الحياة الشقي العنيد","https://www.aldiwan.net/poem38958.html","المتقارب"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[44,"أفيكم فتى حي فيخبرني عني","https://www.aldiwan.net/poem29682.html","الطويل"],[44,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[46,"إذا دارت الكأس في دارهم","https://www.aldiwan.net/poem23439.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39608","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[140,"عزاء فما يصنع الجازع","https://www.aldiwan.net/poem58403.html","المتقارب"],[140,"نظرت ولم أبغ إلا شفائي","https://www.aldiwan.net/poem58423.html","المتقارب"],[141,"تفردت بالمجد دون الأمم","https://www.aldiwan.net/poem11809.html","المتقارب"],[208,"تهلل وجه صبحك يا نهار","https://www.aldiwan.net/poem13554.html","الوافر"],[221,"أمير الشعر لا نور وحق","https://www.aldiwan.net/poem41613.html","الرمل"],[268,"بكت لفتى يفني قواه تعمدا","https://www.aldiwan.net/poem35632.html","الطويل"],[268,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[273,"حرمت الرشاد لأني سفاها","https://www.aldiwan.net/poem25570.html","المتقارب"],[273,"تخيرت مختار الخليفة للعهد","https://www.aldiwan.net/poem25584.html","الطويل"],[303,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[326,"على أفقي سحابات","https://www.aldiwan.net/poem54953.html","الهزج"],[340,"قلبي يحدثني","https://www.aldiwan.net/poem55325.html","منهوك البسيط"],[363,"سبى الأطفال واجتز النواصي","https://www.aldiwan.net/poem44511.html","الوافر"],[369,"هو الحب يصنع ما يصنع","https://www.aldiwan.net/poem57326.html","المتقارب"],[377,"أمن بعد ما بان الفريق وأدلجا","https://www.aldiwan.net/poem48769.html","الطويل"],[400,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[413,"بدا مستهلا بالبشارة يهتف","https://www.aldiwan.net/poem53841.html","الطويل"],[436,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[436,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[438,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[498,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[549,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[556,"إليك من البعد قلبي دنا","https://www.aldiwan.net/poem33810.html","المتقارب"],[556,"لحرب نفوسنا قد جاء فارس","https://www.aldiwan.net/poem34448.html","الوافر"]],"verses":[["وَفي رَسمِ دارٍ بَينَ شَوطانَ قَد خَلَت","وَمَرَّ بِها عامانِ عَينُكَ تَدمَعُ",0,"ع",1,0],["وَفِي رُبَى لُبْنَانَ شَجْوٌ عَلَى","ذَاكَ الرَّئِيسِ الأَحْصَفِ الأَحْزَمِ",1,"م",1,0],["وَفِي رَمْيَاتِهِ يُوَزِّعُهَا","مِنْ غَيْرِ ضَنٍّ بِهَا وَلا نَدَمِ",2,"م",1,0],["وفي رضا اللَّه كُبرُ همَّتِهِ","والسعيُ فيما يُحبُّهُ دَأَبُهْ",3,"ب",2,0],["وفي رَاحِهنَّ غُصُونُ النَّخيلِ","يُحَرِّكْنَها في فَضَاءٍ يَضُوعْ",4,"ع",1,0],["وَفي رِقاقِ الأَرضِ وَالرِمالِ","عَلى دِماءِ الإِنسِ وَالأَوصالِ",5,"ل",1,0],["وَفي رَوضَةٍ نَبتِيَّةٍ صَبَغَت لَها","جَداوِلَها أَنوارُها صِبغَةَ الدُهنِ",6,"ن",1,0],["وَفي رَمضاءَ مِن رَمَضانَ تَغلي","بِهامَةِ لا الحَصورِ وَلا التَقِيِّ",7,"ي",1,0],["وَفي رَفعِ أَصواتِهِم بِالغِناءِ","دَليلٌ عَلى حَطِّ أَقدارِهِم",8,"م",1,0],["وفي روحها نشوةٌ حلوةٌ","كمهجورةٍ مُنِّيَتْ بالوصالْ",9,"ل",1,0],["وفي ركنِ خدْرهما مِغْزَلٌ","وفوقَ الأريكةِ قيثارتانْ",10,"ن",1,0],["وفي رأس ذا اسودٌ حالكٌ","وفي فرعِ ذا أبيضٌ ساطعُ",11,"ع",1,0],["وفي رونق السيف للناظرين","دليلٌ على حدّه والمَضاءِ",12,"ا",2,0],["وَفي رَوضِ أَيّامِكَ المونِقاتِ","تَنَزَّهَ طَرفُ المُنى فَلتَدُم",13,"م",1,0],["وفي روض الهنا أبدت محيا","عليه من سنا التاج الوقار",14,"ر",1,0],["وَفي راياتِها لَهفُ اليَتامى","لَهُ في كُلِّ ثانِيَتَين خَفقُ",15,"ق",1,0],["وفي رأسهِ نارُ الجحيمِ توقَّدت","فلم يرَ ماءً للسّعيرِ مُخمِّدا",16,"د",2,0],["وفي رقابِ العدى انفلّت صوارمُنا","واليومَ قد نزعوا منا السكاكينا",17,"ن",2,0],["وفي رَغَباتي لَهُمْ جِئْتُ إدّاً","فَهَلا رَغِبْتُ لِمَنْ أعْبُدُ",18,"د",1,0],["وَفي رَجَبٍ ما هُنِّئوا بانْعِقادِها","لِيَهْنِئهَا فَرْدُ الشهورِ إلى فَرْدِ",19,"د",1,0],["وَفي رِضاكَ رِضى المَولى وأثرتهُ","فَهوَ السعادةُ في الدارينِ والرحمُ",20,"م",1,0],["وفي راحتي العاجرة","الشلّاء آمال",21,"ل",1,0],["وفي راحتي الشلّا","ءُ نايٌ صامت ملجم",21,"م",1,0],["وفي رموسهم","كما هنا ترب",22,"ب",1,0],["وفيروزٌ غَداةَ أصاب فيكم","وأَضرَبَ في جُموعكُمُ استجارا",23,"ر",2,0],["وفي راحتَيهِ وفي مُقلَتي","وإن لَم يسَع ماءَها مشرَعُ",24,"ع",1,0],["وَفي رَكبِهُم بِالصَفائح وَالقَنا","فَلَستَ تَرى إِلّا وَشيجاً وَسملجا",25,"ج",2,0],["وفي رُقْيةِ الصحب اللديغ قضيةٌ","وقررها المختارُ حين أصابوا",26,"ب",3,0],["وفي رَجَبٍ بالخير وافى فبَشَّروا","بميلادِه والبشرُ إذ ذاك مسعف",27,"ف",1,0],["وَفِي رَبِّ العبادِ عَزَاءُ عِزٍّ","لِذُلٍّ غالَهُ عِزُّ العَزَاءِ",28,"ا",2,0],["وفي راحَتَيْ عبدِ الفعيلِ بنِ فاعِلِ","شِفائي وَفِي نُعمى مكارِمِهِ طِبِّي",29,"ب",2,0],["وفي رجاء بأن ترضى عليه ولا","يخيب عبدك فالراجيك لم يخب",30,"ب",1,0],["وفي رقيقِ نسيجِ الإخْتِيارِ على","نولِ المواهبِ حُكمُ العدلِ قَضَّاءُ",31,"ا",2,0],["وَفي راحَتي أَسعى وَمن دونِ راحتِي","ركوبُ شِماساتِ المتون صِعابِ",32,"ب",1,0],["وفي روض قلبي شدا طيرُكم","وخير جميع الورى خيرُكم",33,"م",1,0],["وفي روض القلوب له ثمار","بأشجار المحبة وهو غارس",34,"س",1,0]]}