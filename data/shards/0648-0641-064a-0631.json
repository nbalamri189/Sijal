","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133264","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135256","السريع"],[3878,"","https://poetry.dctabudhabi.ae/diwan/poem/31437","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111417","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125875","البسيط"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107046","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94516","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94610","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133094","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104894","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120367","الوافر"],[4660,"","https://poetry.dctabudhabi.ae/diwan/poem/143982","الطويل"],[4679,"أما لأبي البرية أن يعادا","https://www.poetsgate.com/ViewPoem.aspx?id=142720",""],[4755,"مَنَاحَة","https://www.poetsgate.com/ViewPoem.aspx?id=184225",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4578,"عينا بمنشور الهوى جيت والياً","https://www.poetsgate.com/ViewPoem.aspx?id=49614",""],[4578,"سهم النوائب لا يبقى ولا يذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=49427",""],[4927,"عيد الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=32634",""],[5111,"روسِيكَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=212161",""],[5111,"موَاوِيلُ النَّوَى","https://www.poetsgate.com/ViewPoem.aspx?id=212165",""],[5273,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=28764",""],[592,"أدم بالعوال يالطن في الضدان جدا","https://www.poetsgate.com/ViewPoem.aspx?id=128845",""],[5370,"ريجيم","https://www.poetsgate.com/ViewPoem.aspx?id=81626",""],[5431,"حبيبي ...","https://www.poetsgate.com/ViewPoem.aspx?id=189358",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5452,"أبي","https://www.poetsgate.com/ViewPoem.aspx?id=112516",""],[5616,"رزان","https://www.poetsgate.com/ViewPoem.aspx?id=203503",""],[402,"في أي جو بالأسى مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=36328",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5956,"وحيد","https://www.poetsgate.com/ViewPoem.aspx?id=185444",""],[6048,"معراجُ الوجع","https://www.poetsgate.com/ViewPoem.aspx?id=197747",""],[6124,"مَقَادِيرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=102715",""],[6148,"في رحاب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=201654",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""],[2220,"ويلتاح في جو السماءِ إذا انبرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11168&r=&rc=42",""]],"verses":[["وَفي رَسمِ دارٍ بَينَ شَوطانَ قَد خَلَت","وَمَرَّ بِها عامانِ عَينُكَ تَدمَعُ",0,"ع",1,0],["وَفِي رُبَى لُبْنَانَ شَجْوٌ عَلَى","ذَاكَ الرَّئِيسِ الأَحْصَفِ الأَحْزَمِ",1,"م",1,0],["وَفِي رَمْيَاتِهِ يُوَزِّعُهَا","مِنْ غَيْرِ ضَنٍّ بِهَا وَلا نَدَمِ",2,"م",1,0],["وفي رضا اللَّه كُبرُ همَّتِهِ","والسعيُ فيما يُحبُّهُ دَأَبُهْ",3,"ب",2,0],["وفي رَاحِهنَّ غُصُونُ النَّخيلِ","يُحَرِّكْنَها في فَضَاءٍ يَضُوعْ",4,"ع",1,0],["وَفي رِقاقِ الأَرضِ وَالرِمالِ","عَلى دِماءِ الإِنسِ وَالأَوصالِ",5,"ل",1,0],["وَفي رَوضَةٍ نَبتِيَّةٍ صَبَغَت لَها","جَداوِلَها أَنوارُها صِبغَةَ الدُهنِ",6,"ن",1,0],["وَفي رَمضاءَ مِن رَمَضانَ تَغلي","بِهامَةِ لا الحَصورِ وَلا التَقِيِّ",7,"ي",1,0],["وَفي رَفعِ أَصواتِهِم بِالغِناءِ","دَليلٌ عَلى حَطِّ أَقدارِهِم",8,"م",1,0],["وفي روحها نشوةٌ حلوةٌ","كمهجورةٍ مُنِّيَتْ بالوصالْ",9,"ل",1,0],["وفي ركنِ خدْرهما مِغْزَلٌ","وفوقَ الأريكةِ قيثارتانْ",10,"ن",1,0],["وفي رأس ذا اسودٌ حالكٌ","وفي فرعِ ذا أبيضٌ ساطعُ",11,"ع",1,0],["وفي رونق السيف للناظرين","دليلٌ على حدّه والمَضاءِ",12,"ا",2,0],["وَفي رَوضِ أَيّامِكَ المونِقاتِ","تَنَزَّهَ طَرفُ المُنى فَلتَدُم",13,"م",1,0],["وفي روض الهنا أبدت محيا","عليه من سنا التاج الوقار",14,"ر",1,0],["وَفي راياتِها لَهفُ اليَتامى","لَهُ في كُلِّ ثانِيَتَين خَفقُ",15,"ق",1,0],["وفي رأسهِ نارُ الجحيمِ توقَّدت","فلم يرَ ماءً للسّعيرِ مُخمِّدا",16,"د",2,0],["وفي رقابِ العدى انفلّت صوارمُنا","واليومَ قد نزعوا منا السكاكينا",17,"ن",2,0],["وفي رَغَباتي لَهُمْ جِئْتُ إدّاً","فَهَلا رَغِبْتُ لِمَنْ أعْبُدُ",18,"د",1,0],["وَفي رَجَبٍ ما هُنِّئوا بانْعِقادِها","لِيَهْنِئهَا فَرْدُ الشهورِ إلى فَرْدِ",19,"د",1,0],["وَفي رِضاكَ رِضى المَولى وأثرتهُ","فَهوَ السعادةُ في الدارينِ والرحمُ",20,"م",1,0],["وفي راحتي العاجرة","الشلّاء آمال",21,"ل",1,0],["وفي راحتي الشلّا","ءُ نايٌ صامت ملجم",21,"م",1,0],["وفي رموسهم","كما هنا ترب",22,"ب",1,0],["وفيروزٌ غَداةَ أصاب فيكم","وأَضرَبَ في جُموعكُمُ استجارا",23,"ر",2,0],["وفي راحتَيهِ وفي مُقلَتي","وإن لَم يسَع ماءَها مشرَعُ",24,"ع",1,0],["وَفي رَكبِهُم بِالصَفائح وَالقَنا","فَلَستَ تَرى إِلّا وَشيجاً وَسملجا",25,"ج",2,0],["وفي رُقْيةِ الصحب اللديغ قضيةٌ","وقررها المختارُ حين أصابوا",26,"ب",3,0],["وفي رَجَبٍ بالخير وافى فبَشَّروا","بميلادِه والبشرُ إذ ذاك مسعف",27,"ف",1,0],["وَفِي رَبِّ العبادِ عَزَاءُ عِزٍّ","لِذُلٍّ غالَهُ عِزُّ العَزَاءِ",28,"ا",2,0],["وفي راحَتَيْ عبدِ الفعيلِ بنِ فاعِلِ","شِفائي وَفِي نُعمى مكارِمِهِ طِبِّي",29,"ب",2,0],["وفي رجاء بأن ترضى عليه ولا","يخيب عبدك فالراجيك لم يخب",30,"ب",1,0],["وفي رقيقِ نسيجِ الإخْتِيارِ على","نولِ المواهبِ حُكمُ العدلِ قَضَّاءُ",31,"ا",2,0],["وَفي راحَتي أَسعى وَمن دونِ راحتِي","ركوبُ شِماساتِ المتون صِعابِ",32,"ب",1,0],["وفي روض قلبي شدا طيرُكم","وخير جميع الورى خيرُكم",33,"م",1,0],["وفي روض القلوب له ثمار","بأشجار المحبة وهو غارس",34,"س",1,0],["وفي رقه المنشور فصل فصوله","مميزة الأطوار عند عقوله",35,"ه",1,0],["وَفي رَوضة البَدر الجَمالية اِزدَرى","بِما قَد حَوَت ذات العِماد بِناه",36,"ن",3,0],["وَفي رحلة زادَ اِبتِهاجاً بِها اِسمَعوا","حَديثاً عَن المَجد الأَثيل مُعَنعنا",37,"ن",2,0],["وَفي رَأيه قَيسٌ وَفي الحلم أَحنَفٌ","وَفي كرّه عَمروٌ وَفي العلم ناجب",38,"ب",1,0],["وَفي رَوض ثَغر اِسكندرية حرَّكت","شَمائلُه لَما بَدا كُلَّ مياس",39,"س",1,0],["وَفي رَجبٍ أَحرزت أَرفع رُتبةٍ","بِها الحاسد المَخفوض مِما بِهِ هلك",40,"ك",1,0],["وَفي رَجب قَد طابَ مَولده الَّذي","بِمعراج خَير الأَنبياء تَشرّفا",41,"ف",2,0],["وَفي رَجب الأَصمّ عَلَيهِ فاضَت","سَحائب رَحمة مثل البِحار",42,"ر",1,0],["وَفي رَبيع غَدا مَجدي يُؤرّخه","رفاعة حاله حال بجنات",43,"ت",1,0],["وفي رميها الحصباءُ من جَمراتها","أتت بعدَ خوفِ الخَفيفِ في سَلمِ السّلم",44,"م",1,0],["وَفي رابِعِ الأَفلاكِ عَنهُ تَباعَدَت","مَخافَةَ كَسفٍ مِن مُحيّاهُ تَكسِفُهْ",45,"ف",2,0],["وَفي رُجوعِهِ رَأى ابن عُرس","في بَيته اللَطيف فَوق الكُرسي",46,"ي",1,0],["وَفي رِضاه فَابذلوا المَجهودا","وَأَرسلوا لِأَكلِهِ قَعودا",47,"د",2,0],["وفي رَذَاذَاتِ مَاءِ النِّيلِ مُنْتَجَعِي","(نَجْوَى) أُطارِحُ، أَوْ (روني) تُناجِينا",48,"ن",2,0],["وَفِي رَأسِ الغُثاءِ الزَّا","ئِفِ المَوْتُورِ مِنْشَارِي",49,"ر",2,0],["وفي ركانة ما لم يخف عنك وفي","أهل القليب وقد باءوا اعتبارات",50,"ت",1,0],["وفي ركانه أو في غورث عبر","لذي البصيرة أنبت أنه اعتصما",51,"م",2,0],["وَفي رِقاب أَعاديه يَرى أَبَداً","لِسَيفِهِ العَضب إِجمال وَتَفصيلُ",52,"ل",1,0],["وفي رقاب الورى لكُم مِننٌ","ما سَمعَ الناس صوتَ منكرِها",53,"ر",3,0],["وفي ربعه للوفود اتساعٌ","إذا ضاقت الأرض عَرضاً وطولا",54,"ل",2,0],["وَفي رَبعِ الحَبيبِ لَنا رَبيعٌ","وَنَورٌ ما حَوَتهُ النَيرَبانِ",55,"ن",1,0],["وفي ريقكَ المعسولِ لو أنّ روضةً","تُعَلَّلُ بالكافور والمسكِ والرّنْدِ",56,"د",1,0],["وفي رب البحيرة والسبايا","ورب الجنتين وذي رعين",57,"ن",1,0],["وفي رُبى يَثْرِبٍ غاياتُ كلِّ هوىً","يَجِلُّ عن مَوْقِع الأَشواق موقعُهُ",58,"ع",2,0],["وفي روضةِ المُختارِ أصبحَ هائماً","يروحُ ويَغدو بين تِلكَ الملاعبِ",59,"ب",1,0],["وفي رَوضَةِ المختارِ نُصبِحُ كلما","خرجنا عشقنا العودَ والعَودُ أحمَدُ",60,"د",1,0],["وفي رمضانَ صِحَّةٌ يَهتدي بها","قلوبُ رجالٍ عاينوا الأمر في العمى",61,"ا",1,0],["وفي رمضان قال لي تعرف الذي","تشاهده بين المهابةِ والأنس",62,"س",1,0],["وَفي رَوضَةِ السُّلَّانِ ثُلَّت عُروشُكُم","ذَوابِلُ في إِيمانِنا وَصفائِحُ",63,"ح",1,0],["وفي رأس انطلياس قد قام مصنع","الامير سليم من به افتخر المهد",64,"د",1,0],["وفي راسِ خَلفٍ خامسَ النَّعشِ تلتقي","وأمثَالُهُ الغربي مِنَ النَّطحَ قَد لُقِي",65,"ي",1,0],["وفي رجب كانتْ وفاةُ ولينا","لنصفٍ مَضى في عدَّةٍ فاسمعوا وَعُوا",66,"ع",3,0],["وفي روضة الأفراح غنت بلابل","بآيات ايناس على غصن البشرى",67,"ر",2,0],["وفي رياض السفحِ واللوّان","هبت رياحُ الشيح والحوذان",68,"ن",1,0],["وَفي رَفع رايات إِلَيكَ إِشارة","بِأَنكَ تَرقي في مُنى وَأَمان",69,"ن",1,0],["وفي ربوع اللوى والرقمتين فقف","ولا تمل عن عريب السفح من إظمِ",70,"م",1,0],["وفي رجب لاح السرور مؤرخا","تهاني العلا في بهجة مولد حسن",71,"ن",1,0],["وفي رشيد أحالوا فوق وارده","عليه من كل نوع ما يحرره",72,"ر",2,0],["وفي ربوعك آسادٌ إذا وثبوا","مالَ الزمانُ إلى ما نشتهي وصَبا",73,"ب",2,0],["وفي رُباكِ فتنةٌ","لكلِّ سمعٍ وَبَصر",74,"ر",1,0],["وَفِي رِيَاضِ بِيوُتِ الحَيِّ مِنْ إِضَمٍ","وَرْدٌ جَنِيٌّ وَفِي أَكْمَامِهَا القُضُبُ",75,"ب",1,0],["وفي رحاب جامع الميداني","المصطفى الملقي عالي الشان",76,"ن",1,0],["وفي رباط السادة السعديّه","ضريح شيخ كامل المزيه",76,"ه",1,0],["وفي رَكعة تأتي على الليل كلِّهِ","وظاهر قولٍ في مِثال الضمائرِ",77,"ر",1,0],["وفي ربوة الشعبين راهية أتت","عليهم فما أغنى دفاع بعسجد",78,"د",1,0],["وفي رَقَاق تحت ظل التمرِ","قد نزلوا عند أوان السَّحرِ",79,"ر",1,0],["وفي راحتي القرن الخشيبُ الذي به","أجُرُّ وأردى كلَّ أبلج ظالمِ",80,"م",1,0],["وفي راحتي مُرهفُ الشفرتينِ","خشيبٌ تعوَّد هرقَ الدمِ",81,"م",1,0],["وفي رمى الجمار أرى ذنوبى","محطمة وقد كانت جساما",82,"م",2,0],["وفي روايةٍ رأيتني بحينْ","صبيحها أسجد في ماء وطينْ",83,"ن",1,0],["وَفي رِئامٍ وَفي النجدَين مِن مَدرٍ","عَلا المَنارُ وَحَفَ الشيِّدُ إِيوانا",84,"ن",2,0],["وفي رَأسِها عُصفُورَةٌ وفِرَاخُها","ثَمانِيةٌ ما كادَ يَنقُفُ عُودُها",85,"د",3,0],["وفي رباك أَبو الهول المهيبُ له","مجدٌ على صفحات الدهر مرسوم",86,"م",1,0],["وفي ردائي حقيق بالعلى قمن","تضفو عليه ثياب الفخر والشرف",87,"ف",1,0],["وفي ريش ذاك الجفن قد راش مهجتي","وقد صاد في قوسيه قلباً وَقالبا",88,"ب",2,0],["وفي روض الجنائن حزتِ مثوىً","به طيب النفوس مع القرارِ",89,"ر",1,0],["وفي رجوعٍ بليلٍ بعد ذا سحراً","وشرحه ما جرى ناهيك من عظمِ",90,"م",1,0],["وفي روض خدك روض فمن","لطرفي يقطفه بالنظر",91,"ر",1,0],["وفي رهبانها قد صرت صبا","وغير مديحهم لم ابغ عقبى",92,"ب",2,0],["وفي ربعك الدنيا تزفّ محاسناً","وتفتر منك عن ثنايا مناقب",93,"ب",1,0],["وفي رصد الكواكب أتحفونا","بآلات بها العلم استفادا",94,"د",2,0],["وفي رَأسهِ تَغفُو وتَصحُو مَشَاهِدٌ","ظَلَامِيَّةٌ, أَصواتُها لَيسَ تَهدَأُ",95,"ا",1,0],["وفي رمضان منهم كان نهبٌ","وسفك دم ونقض للعهود",96,"د",1,0],["وفي روضة المنشور ينشي سجعه","فنوناً بأفنان الأنامل شاديا",97,"ي",2,0],["وفي ربيع قضى من للأنام يرى","ربيه فضل به للذي قد أمه وطرُ",98,"ر",1,0],["وَفِيْ رَفَحَ الشَّهِيْدَةِ اقْتِحَاْمٌ","وَإِذْلاْلٌ مِنَ الْوَغْدِ الذَّلِيْلِ",99,"ل",1,0],["وَفِيْ رَوَابِي الْهَوَى نَامَتْ نَوَارِسُهَا","بِالطَّيْفِ مُتْرَعَةٌ بِالدِّفْءِ تَغَشَانَا",100,"ن",2,0],["وَفِيْ رُوحِي تَتَوهُ دُنَى مُنَايَا","مَوَاوِيلُ النَّوَى تُذْكِي دُجَايَا",101,"ا",3,1],["وفيروزُ التي صَدَحَتْ","تعاتبُني هي الأخْرى",102,"ر",2,0],["وفي ربعها عمداً نخها ولا تهب","وقد نكحوهم جهراً علانية جردا",103,"د",2,0],["وفي رجيمي استمريت اسنتين","جدي اللي مات بغيت ألحقه",104,"ق",2,0],["وفي روحه تلقى نعيما مظللا","إذا...ْ يكتوي تُرمى بنارٍ فتشعلُ",105,"ل",1,0],["وفي رحمة الله الفسيحة طامعاً","ومن خوف زلاتي الفظيعة مشفقا",106,"ق",2,0],["وفي راحتيك الحيا والنّدى","ونحن كنبت الرّبى المعشب",107,"ب",1,0],["وفي رمضان تحتفل المقاهي","وفيها تكثر القططُ السمان!",108,"ن",1,0],["وفي ربى لبنان شجو على","ذاك الرئيس الحصف الأحزم",109,"م",1,0],["وفير كثير إن تواضعت الورى","إليهم ودانت بالسجود وخرتِ",110,"ت",1,0],["وفي روضة الرضوان طابت مراتعي","وحسبي منها زهرها وغديرها",111,"ر",3,0],["وفي رأيي النساء أعز منا","وأشرف دائما منا وأبهى",112,"ه",2,0],["وفي رُباها رَبا الشُبَّانُ في كبرٍ","وفي الصبايا بَغى من حقدِهِ قزمُ",113,"م",1,0],["وفي رخوٍ ليالينا تُباعدُنا","بفجرٍ من مُنى عُمري يُغنّيْنِيْ",114,"ن",2,0],["وفي رَبيْع ضَحُوكِ الثغر تسْبقهُ","نضارة الزهْر تحْوي كلَّ تلويْن",115,"ن",1,0],["وفي رَعْشةٍ للشِّفاهِ التي","تصَلِّي عليكَ عَسَى تغتنم",116,"م",1,0],["وفي رمضانٍ صيحة ٌ يهتدي بها","قلوبُ رجالٍ عاينوا الأمر في العمى",117,"ا",1,0]]}