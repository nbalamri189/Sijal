l","الطويل"],[517,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[517,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[517,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[540,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[540,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[553,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[553,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[553,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[553,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[553,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[560,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[560,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[560,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[563,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[571,"رب أمور قد بريت لحاءها","https://www.aldiwan.net/poem52036.html","الطويل"],[589,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/20473","الوافر"],[900,"","https://poetry.dctabudhabi.ae/diwan/poem/10409","المتقارب"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21407","الطويل"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2565","الوافر"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/19002","الوافر"]],"verses":[["ولا قر في نفسي سكون ولا اشتفى","بي الصدر من غيظي ولا خف واقد",0,"د",1,0],["وَلا قَرَعتُ مِن قُنوطٍ سِنّي","ياأَيُّها المَغرورُ لا تَهِجَّني",1,"ن",2,0],["وَلا قاطِعٌ بِالظَنِّ ما كُنتُ واصِلاً","وَرُبَّ مَغيظٍ قاطِعٍ بِالتَوَهُّمِ",2,"م",1,0],["وَلا قائِلٌ ما يَعلَمُ اللَهُ ضِدَّهُ","وَلَو نالَ مِن جِلدي قَناً وَنُصولُ",3,"ل",1,0],["وَلا قِرنَ إِلّا أَدمَعَ الطَعنُ نَحرَهُ","وَما غَسَلَتهُ بِالدُموعِ مَدامِعُه",4,"ع",2,1],["وَلا قَّبَضَت أَنامِلهُ","عَلى مالٍ زَواجِرُه",5,"ر",2,0],["وَلا قُلتُ إِنّي عِندَ الفَخا","رِ إِلّا لِغَيرِ أَبي أَحمَدِ",6,"د",1,0],["وَلا قُضُبُ الرِجالِ الصيدِ فَضلاً","عَنِ الأَصواتِ في حَليِ النِساءِ",7,"ا",2,0],["ولاقى رَئيسُ القَوْمِ عَمْرو بنُ جابِرٍ","طِعاناً يُنَسِّيهِ الهَدِيِّ المُقَلدا",8,"د",2,0],["ولا قَعيدٌ أَغَضَبٌ قَرنُهُ","هاجَ لَهُ مِن مَرتَعٍ هائِجُ",9,"ج",1,0],["وَلاَ قَرَّ قَلْبٌ فِي قَرَارِ ضُلُوعِهِ","وَلَمْ تَعْرِفِ الأَجْفَانُ مَا لذَّةُ الغَمْضِ",10,"ض",1,0],["ولا قلْبَ إلا خافِقٌ في شِغافِهِ","بِها وكَساها منْ نَسيجَتِهِ بُرْدا",11,"د",2,0],["وَلا قُلنا لَهُم نَفسٌ بِنَفسٍ","أَقيدونا بِها إِن لَم تَدوها",12,"و",3,0],["وَلا قامَ في أَيّامِكَ البيضِ ماجِدٌ","يُنازِعُكَ البابَ الَّذي كُنتَ تَقرَعُ",13,"ع",1,0],["وَلا قيلَ هَذا فَيلَسوفٌ مُوَفَّقٌ","وَلا قيلَ هَذا عالِمٌ وَخَبيرُ",14,"ر",1,0],["وَلا قَبلَ عَبّادٍ جَوى البَحرَ مَجلِسٌ","وَلا حَمَلَ الطَودَ المُعَظَّمَ رَفرَفُ",15,"ف",1,0],["وَلأَقِفْ للنَّدَى بِحَيْثُ أَرَادُوا","وَلَهُمْ مِنْ إِجَابَتِي مَا رَامُوا",16,"م",3,0],["وَلاقى القَينُ وَالنَخَباتُ غَمّاً","تَرى لوكوفِ عَبرَتِهِ اِنصِبابا",17,"ب",2,0],["وَلاقَيتَ خَيراً مِن أَبيكَ فَوارِساً","وَأَكرَمَ أَيّاماً سُحَيماً وَجَحدَرا",18,"ر",2,0],["وَلاقَيتَ مِنّا مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاِستَأخِرَن أَو تَقَدَّما",19,"م",2,0],["وَلاقَيتَ مِنّي مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاستَأخِرَن أَو تَقَدَّما",19,"م",2,0],["وَلاَقَينَا قُضَاعَةَ يَومَ كَلب","بِطَلحَةَ والكُماةِ مُقَنَّعِينَا",20,"ن",2,0],["ولا قهوةٌ أستغفر الله تجتلى","ومن عجبٍ أنْ قد حلا منه ما مرا",21,"ر",2,0],["ولأقلام صاحب السرّ والأنظ","ار والاحتجاب في الخافقين",22,"ن",1,0],["ولا قيدت عن مصر قافية الحيا","ولا عطّلت أبياتها من رويه",23,"ي",2,0],["ولا قسورٌ إن لم يجد ما يكُفُّهُ","من الصَّيدِ أضحى والسباعُ له لحَمْ",24,"م",1,0],["ولا قَعَدْتُمْ على ضَيْمٍ ولا ضَمَدٍ","لكنْ عفوتُمْ وفي أيديكُمُ النِّقَمُ",25,"م",1,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّاً","كَفَتهُ كُلَّ حازِيَةٍ وَراقي",26,"ق",2,0],["وَلاقى اِمرَأً لا يَنقُضُ القَومُ عَهدَهُ","أَمَرَّ القُوى دونَ الوُشاةِ فَأَحصَدا",27,"د",2,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّا","كَفَتهُ كُلَّ راقِيَةٍ وَحازي",28,"ز",2,0],["وَلا قُصوراً وَلا رِياضاً","وَلا جُنوداً وَلا إِماء",29,"ا",2,0],["وَلا قَدُّها غُصن وَلا خَيرَزانَةٌ","وَلا خَصرُها غَور وَلا رِدفُها نَجدُ",30,"د",1,0],["ولَأَقلامُك أمضى","من شبا رمح دُرَيْدِ",31,"د",1,0],["وَلاقَينَ مِن أَولادِ عُقدَةَ عُصبَةً","عَلى الماءِ يَنثونَ الذُحولَ المَوانِعا",32,"ع",2,0],["ولاقيت منهم كل خسف وجفوةٍ","فماذا عسى من بعد ذا أن أُلاقيا",33,"ي",2,0],["ولا قرقرت أوبربرت يوما","كما هيجت ديكا مالِطِيا",34,"ي",2,0],["وَلاقي العَبقَرِيّينَ","لِقاءَ النِدِّ لِلنِدِّ",35,"د",1,0],["وَلاقى دونَ ثايِهِمِ طِعاناً","يُلاقي عِندَهُ الذِئبَ الغُرابُ",36,"ب",1,0],["وَلا قَبضٌ عَلى البيضِ المَواضي","وَلا حَظٌّ مِنَ السُمرِ اللِدانِ",37,"ن",1,0],["ولا قرَّ لي بعدَ التفرُّقِ مضجعٌ","ولا طابَ لي بعدَ الرحيلِ مقامُ",38,"م",1,0],["وَلا قَبولي ما كُنتَ جُدتَ بِهِ","عَلَيَّ بِالأَمسِ خُلسَةَ الذيبِ",39,"ب",1,0],["وَلا قَمَرٌ إِلّا حُشاشَةُ غائِرِ","كَعَينِ طِماسٍ رَنَّقَت لِرُقادِ",40,"د",1,0],["وَلاقَت عَلى الزابِ الصَغيرِ حُماتُها","حِمامَ المَنايا إِذ عِمادٌ عَميدُها",41,"د",3,0],["وَلا قَصرَ بي عَن ضامِنٍ مُتَكَفِّلٍ","بَوائِقَ ما يَطوي الزَمانُ وَما يُبدي",42,"د",2,0],["وَلا قائِلٌ فيكَ إِلّا الجَمي","لَ وَإِن كانَ ما جِئتَ لا يَجمُلُ",43,"ل",1,0],["وَلاقَت مِنَ الحِرمازِ أَولادَ مِجشَإٍ","وَمِن مازِنٍ شَرِّ القَبائِلِ مَعشَرا",44,"ر",2,0],["وَلاقى شَديدَ الدَرءِ مُستَحصِدَ القِوى","تَفَرَّقُ بِالعِصيانِ عَنهُ عَواذِلُه",45,"ل",2,0],["وَلاقيهِ بِالتَرحيبِ وِالرَحرِ وَالقِرى","وَيَمّم لَهُ ما دُمتَ تَحتَ اِقتِدارِهِ",46,"ر",2,0],["وَلا قَلاني وَإِن كانَ المُسيءُ بِنا","إِلّا دَعَوتُ لَهُ الرَحمَنَ بِالرَشَدِ",47,"د",1,0],["وَلا قَلَّدَ الأَعناقَ مِن فَيضِ جودِهِ","قَلائِدَ بِرٍّ لا يَقومُ بِها الشُكرُ",48,"ر",1,0],["وَلا قيلَ يَوماً أَنَّهُ غَيرُ عالِمٍ","بِغَيرِ عُيوبِ الجارِ وَاللَومِ وَالجُبنِ",49,"ن",1,0],["وَلَأَقتُلُنَّ حَجاحِجاً مِن بَكرِكُم","وَلَأَبكِيَنَّ بِها جُفونَ عُيونِ",50,"ن",1,0],["ولاقِطٌ نظرةً عَجلى يكونُ بها","ليْ في الحياةِ وما ألقى بِها ، سَند",51,"د",1,0],["وَلا قُربُ نُعمٍ إِن دَنَت","وَلا نَأيُها يُسلي وَلا أَنتَ تَصبِرُ",52,"ر",1,0],["وَلا قَولُ واشٍ كاشِحٍ ذي عَداوَةٍ","وَلا بُعدُ دارٍ إِن نَأَيتِ وَلا قُربُ",53,"ب",1,0],["وَلا قِلتُ مِنهُ بَينَ ظِلٍّ لِعَطفَةٍ","تَنَدّى وَنورٍ لِلبَشاشَةِ مونِقِ",54,"ق",1,0],["وَلاقي بِمَأمولِ الرِضى مِنكِ مَوكِباً","تَوارَت لَهُ الجَوزاءُ وَاِستَحيَتِ الشِعرى",55,"ر",2,0],["وَلا قَرنٌ يُقَزَّزُ مِن طَعامٍ","وَلا نَصِبٌ وَلا مولى عَديمُ",56,"م",1,0],["وَلا قَولَها وَهناً وَقَد بَلَّ نَحرَها","سَوابِقُ دَمعٍ ما يَجِفُّ غَزَيرِ",57,"ر",1,0],["ولاقُوا المَوْتَ دُونَ حريمِ مِصْرٍ","وَصانُوا المَالَ مِنهُمْ وَالبَنِينا",58,"ن",2,0],["ولا قلّبت تلك السلاح أكفُّها","ولا وصلت تلك الأكفَّ الأنامل",59,"ل",1,0],["وَلا قَيسٌ أَخو لُبنى","وَلا عَمرٌ أَخو دَعدِ",60,"د",1,0],["وَلا قَطَعتُ عَلى حَرفٍ مُذَكَّرَةٍ","في مِرفَقَيها إِذا اِستَعرَضتَها فَتَلُ",61,"ل",1,0],["وَلا قَصَّرَت لي أُمُّ لَيلى بِشُربِها","حَنادِسَ أَوقاتٍ عَلَيَّ طِيالِ",62,"ل",1,0],["وَلاقَيتَ عِندي الخَيرَ تَحسَبُ عَيِّلاً","يُنافيكَ قَولٌ سَيِّئٌ وَشَتائِمُ",63,"م",1,0],["وَلا قُصورٌ لَها مُشَيَّدَةٌ","قَد مُوِّهَت عَسجَداً رَواشِنُها",64,"ن",3,0],["وَلاقَتبي عَلى العَودِ المُزَجّى","وَلا سَرجي عَلى الفَرَسِ الأَدَنِّ",65,"ن",1,0],["ولا قَلِقاتُ اللّيلِ باتَت كأنّها","من الأينِ والإدلاجِ بعضُ القنا اللُّدنِ",66,"ن",1,0],["ولاقَى دُوَيْنَ الوِرْدِ كلَّ مُغَيَّبٍ","عنِ الرّشْدِ يَقْتادُ الخَنا بزِمامهِ",67,"م",2,0],["وَلاَقاَهُ مِنّا فَارِسٌ غيرُ جَيدَرٍ","فَأَكرَهَ فِيهِ الرُمحَ حَتّى تَفَطَّرا",68,"ر",2,0],["ولا قبلَها قبل ولا بَعْدَ بَعْدَهَا","وقَبْليُّة الأبْعادِ فهْي لها حَتْم",69,"م",1,0],["ولاَ قَرْوَ إِلاَّ قَرْوَ رَيِّقِهِ ضُحىً","بِعَبْسٍ ونَجَّتْ طَيْرُهُ حِينَ أَسْفَرَا",70,"ر",2,0],["وَلا قَولَها لَولا العُيونُ الَّتي تَرى","لَزُرتُكَ فَاِعذُرني فَدَتكَ جُدودُ",71,"د",1,0],["ولا قنا الأسباط حول يوشعا","أعفّ من قناهما وأخشعا",72,"ع",2,0],["وَلاقَيتُ العِدا وَحَفِظتُ قَوماً","أَضاعوني وَلَم يَرعَوا جَنابي",73,"ب",2,0],["ولاَقَيتُ لَذَّاتِ الفَتَى وأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",74,"د",1,0],["وَلا قراءَتكَ السوراتِ بَينَهُمُ","مُرَتَّلاتٍ بِإِظهارٍ وَإِدغامِ",75,"م",1,0],["وَلا قَطّ آذى مُسلِماً بِلِسانِهِ","وَلا بِيَدَيهِ بَل هُوَ اِحتَمَلَ الأَذى",76,"ذ",2,0],["وَلا قَولَها لِيَ إِذ أَيقَنَت","بِما قَد أُريدُ بِها أَستَقِر",77,"ر",1,0],["ولا قُضَاةً يَهَابُونَ الجُنَاة؛ فهم","يُغْصُون إن أزهقوا الأرواحَ أو نهبوا",78,"ب",3,0],["ولا قلب إلا خافق في شغافه","ولا طرف إلا من مهابتها ارتدا",79,"د",2,0],["ولا قوماً يَرُدُّون الدّواهي","وقد خَرِسَتْ بألسْنةٍ فِصاح",80,"ح",1,0],["ولا قائلٌ : اصبحتُ منكم ، وقد أرى","غوايَتكم او انني غير مهتدي",81,"د",2,0],["ولاقت على الزب الصغير حماتها","حمام المنايا إذ عماد عميدها",82,"د",3,0],["ولا قدّها غصن ولا خيزرانة","ولا خصرها غور ولا ردفها نجد",83,"د",1,0],["وَلاَقَيْنَ مِنْ أوْلاَدِ عُقْدَة َ عُصْبَة","ً عَلَى الْمَاءِ يَنْثُونَ الذُّحُولَ الْمَوَانِع",84,"ع",1,0],["ولا قربُ نعمٍ إن دنتْ لك نافعٌ،","وَلاَ نأْيُهَا يُسْلي وَلاَ أَنْتَ تَصْبِرُ",85,"ر",1,0],["وَلاقَيتُ لَذّاتِ الغِنى وَأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",86,"د",1,0],["ولا قَعيدٌ أعْضبٌ قرنُهُ","هَاجَ لَهُ مِنْ مَرْتَعٍ هَائِجُ",87,"ج",1,0],["ولا قطعت قريباً لي لذلته","ولا وصلت غريباً خيفة",88,"ه",1,0],["ولا قضاة ولا أحكام أسلمها","برداً على العدل آتون من النار",89,"ر",1,0],["ولاقَيْتَها شَهْباءَ تَخْطرُ بالقَنا","وسَعْيَةُ يُدْعَى وسطها والسَّمَوَّلُ",90,"ل",1,0],["ولا قاطعاً شخصاً له وهو واصلٌ","ولا واصلٌ شخصاً له وهو قاطعُ",91,"ع",1,0],["ولاقت مثلها الصعدات حتى","تكسرت النصالُ على النصالِ",92,"ل",1,0],["ولا قوس السحاب إذا تجلّى","ولا الأقمار في كبدِ السماءِ",93,"ا",2,0],["وَلا قادَني سَمعي وَلا بَصَري لَها","وَلا دَلَّني رَايي عَلَيها وَلا عَقلي",94,"ل",2,0],["ولا قيتَ ربَّ التاج يرفعُ حُجْبَهَ","ويطردُ ما ناجيته التيهَ والكِبرا",95,"ر",2,0],["ولاقت به الفُرسُ أمَّ اللُّهَي","م وأْدَ البناتِ وذبحَ البنينا",96,"ن",2,0],["وَلاقى الأُلوفَ غَيرَ مُكتَرِثٍ بِها","هُمامٌ أَجابَ المَوتَ أَوَّلَ ما دَعا",97,"ع",2,0],