 أَو مَفاخِر دارِم","وَلا قَس لب قَطُّ أَو طَرفة العَبدِ",122,"د",1,0],["وَلاقَتْ علَى حُكْمِ السَّعَادَةِ بُرْدَها","ومَا بَرِحَتْ أثْنَاءَ شِقْوَتِهَا رَهْصا",123,"ص",2,0],["وَلاقَيتُ لِلأَعلاقِ أجْود مانِحٍ","يَميناً وَللأغْلاق أسْعدَ فاتِح",124,"ح",1,0],["وَلا قيدَتِ الخَيلُ العِتاقُ شَوازِباً","وَلا هُزَّ رُمحٌ في أَنامِلِ هَزّازِ",125,"ز",1,0],["وَلا قَرقَفٌ صَهباءُ صِرفٌ مُحيلَةٌ","يَفُضُّ زُكامَ المِنخَرَينِ عَتيقُها",126,"ق",3,0],["ولاقِهم بالبِشرِ","وحيِّهم بالشُكرِ",127,"ر",1,0],["ولأقبضن عنان قولي ها هنا","حسى وفي تعدادهم لم أطمع",128,"ع",1,0],["ولا قصر الا زناد عن نيل قصدها","سوى ضجر عجز تكاسل جثمان",129,"ن",1,0],["وَلاقيتُ برّاً قَد طَمى برّ بحره","فَجابَت لَه آمالُنا البرّ والبحرا",130,"ر",2,0],["ولا قاطع للناس نهج سبيلهم","ولا مفسد في الارض في كل وجهة",131,"ه",1,0],["وَلا قِرى لِنَزيلٍ دونَ قَريَتِهِ","وَلا هُدىً لِسَبيلٍ دونَ كَوكَبِهِ",132,"ب",2,0],["ولاقَيتَ مِن دُونِ الأَمَانِي خَلِيفَةً","بدِيهَتُه وَحيٌ وَعَزمَتُهُ لَمحُ",133,"ح",1,0],["ولاقيتَني فرداً فلاقيتَ ماجداً","وأنتَ حَسيرٌ في الوَثَاقِ أَسيرُ",134,"ر",1,0],["وَلا قُلتُ لِلأَعداءِ إِنّي سَحَرتُهُم","وَهَذا ثَنئي ثُمَّ ما هاجَهُم سِحري",135,"ر",2,0],["وَلا قُلتُ مَطروداً بِعامِ مَجاعَةٍ","وَلَكِن طَريدٌ مِن سُيولِ غَمامِ",136,"م",1,0],["ولا قال لا أرضى تعاليم بُطرسٍ","وما جاءنا بالبينات رسول",137,"ل",1,0],["ولا قال إني خائفٌ عند طاعتي","وفي الناس منهم قاتلٌ وقتيل",137,"ل",1,0],["ولاقيت كل العارفين بسفحها","وكل كريم ساكن برباها",138,"ا",3,0],["ولاقى به قوماً من الرسل كلها","يقول له يا مرحباً حين سلما",139,"م",2,0],["ولا قطعة اقتطعتها أو ولاية","كما هو دأب الناس في كل مورد",140,"د",1,0],["ولاقيت هابيلاً قتيل شقيقه","يواريه لما أن رآه غراب",141,"ب",1,0],["وَلأقتُلَنَّ العُدمَ قتلةَ ثائِرٍ","بِالجودِ من نَفحاتِ كَفِّ حُسَينِ",142,"ن",1,0],["وَلأَقضينَّ الدَهرَ غيرُ مُقَصِّرٍ","ما كانَ أَسلَفَنيه مِن أَحقادِهِ",143,"د",2,0],["ولاقيت صعب المرتقى غير ناكص","وأصعب ما ألقى رئاسة ناقص",144,"ص",1,0],["ولاقاهم وهل يخشى لقاهم","فتىً ألقى على اللَه اتكالا",145,"ل",2,0],["ولا قام يبغي نصرة الحق قائم","من الناس لولا سيف عزمك والجد",146,"د",1,0],["ولاقَيْتُمُ البيضَ والسُّمْرَ عَنَّا","ونحنُ بِعَقْوَتِكُمْ آمِنُونا",147,"ن",2,0],["ولاقى وْجوهَ الراغبينَ كأنَّما","أمانِيُّهُم يُصْبِحَنَ مْنهُ عَلَى وعْدِ",148,"د",1,0],["ولاقاكَ فاسْتَخْذى لديكَ تذلُّلاً","ليحتازَ من أدنى رضاكَ تَرَحُّما",149,"م",2,0],["ولا قَدَمٌ لا تَسْأَمُ الدَّهْرَ تَرْتَقِي","ذُرى كُلِّ صَعْبِ المُرْتَقَاةِ مُنِيفِها",150,"ف",3,0],["وَلا قَنَطٌ واليُسرُ لِلعُسرِ غالِبٌ","وَفِي العرْشِ رَبٌّ بالخَلائِقِ رَحْمانُ",151,"ن",1,0],["ولاق ضيفك طلق الوجه مبتسماً","ولو تعبَّس وجه الدهر مكتلحا",152,"ح",2,0],["ولاقى بعد ما لاقى المعادا","عتاد الباقيات الصالحات",153,"ت",1,0],["ولا قلب مذسار الموادع وادع","ولا عيش مذ طال التفرق طائل",154,"ل",1,0],["ولا قَرَنتُ حبَّه صبابةً","لا يطمع العاذلُ في سلوانِها",155,"ن",3,0],["ولا قامت الدنيا بسيرةِ عادلٍ","يُهابُ ولم يُنصَرْ لربّك دينُ",156,"ن",1,0],["ولا قدَرت على نفسي ولحظي","على ما نَمَّ من طيبٍ وحُسنِ",157,"ن",1,0],["ولا قسموا لها الإنصاف يوما","بكيلٍ في السماح ولا بوزنِ",157,"ن",1,0],["ولا قصير الإزار إن جذبَ ال","جدبُ بأذيال خائِض القُحَمِ",158,"م",1,0],["ولا قلّص الملكُ عاداتهِ","معي وهو في ثوبه رافلُ",159,"ل",1,0],["ولا قَرَى صَبابةً فؤادَه","إلا السلوَّ حاضراً والجَلَدا",160,"د",2,0],["ولا قَضَى اللّهُ على سيِّد","قضاءَهُ إلا اجتبَى سيِّدا",161,"د",2,0],["ولاقاه من الأيام يوم","كما من قبل لم يخلد قدار",162,"ر",1,0],["وَلا قَرَأتُ كِتاباً مِنكِ يَبلُغُني","إِلّا تَنَفَّستُ مِن وَجدٍ بِكُم صُعَدا",163,"د",2,0],["ولا قطفوا باللثمِ وردةَ خَدَّها","ولا هصروا في ثِني أبرادِها الغصنا",164,"ن",2,0],["ولاقى على الأوطان أهوال عاشق","عرته أهاويل على الطي والنشر",165,"ر",1,0],["ولا قفرة إلا وأمسيت صِلَّها","ولا حَضَرٌ إلا وظلْتُ له وَفْدا",166,"د",2,0],["ولا قيَّدْتُ ذاتي في نِطاقٍ","يُميلُ بها شُهودي عن رُبَاكِ",167,"ك",1,0],["ولا قِستُ السّما حين انتصرتُ","ولا شئتُ البكا حين هُزمتُ",168,"ت",1,0],["ولا قنَصَتْ أختُ الغَزالِ جوارِحي","ولا هيّجَتْ وُرْقُ الحَمامِ بَلابِلي",169,"ل",2,0],["ولا قدس الدهر فلولا جوره","لم يتحكم عاجز في قادر",170,"ر",1,0],["ولا قسمت ألحاظه بين مخلص","جميل السجايا أو عدو يجامله",171,"ل",2,0],["ولا قام في المحراب والحرب عاملاً","من البأس والإحسان ما الله قابله",171,"ل",2,0],["ولا قدم الشهر المحرم قبل ما","عداه سوى تقديمكم للمحرم",172,"م",1,0],["ولاقيتَ من عزٍّ منيعٍ وحُظوة","ورِفعَةِ جاهٍ وابتِسامِ ثُغورِ",173,"ر",1,0],["ولاقاك عن شَوق رجالُ حكومةٍ","تُبادِلك الودَّ الذي يَتجدَّدُ",174,"د",1,0],["وَلا قُذيتُ بعوراءٍ لَهُ مَرَقَتْ","سرّاً ودافع عنها النّاسُ إعلانا",175,"ن",2,0],["ولا قومٌ لَهمْ في قل","لَةِ العلياءِ بُنيانُ",176,"ن",1,0],["وَلا قلبَ إلّا وهو منك مُكلَّمٌ","وَلا لُبَّ إلّا وهو فيك مُذَهَّلُ",177,"ل",1,0],["وَلا قيّضَ اللّهُ التفرّقَ عنكمُ","ولا عَنَّ نأْيٌ بيننا وتصدُّعُ",178,"ع",1,0],["وَلا قُرّبتَ من جَدْبٍ","ولا بوعدتَ من خِصْبِ",179,"ب",1,0],["ولا قومي أرى قومي","ولا أهلي أرى أهلي",180,"ل",2,0],["ولأقلام التجلي","سمعت أذني صريفا",181,"ف",2,0],["ولا قائم إلا بها في وجوده","ولا صانع إلا بها هو صانع",182,"ع",1,0],["وَلا قَضِيّاً بِالقضَاءِ المُتَّهَم","في أُمَّةٍ سُوِّسَها بَعدَ أُمَم",183,"م",1,0],["ولا قاذِفٌ نَفسي وَنَفسي بريئة","وَكَيفَ اعتذاري بعد ما قد قذفتها",184,"ت",3,0],["ولا قبلها كانت عليهم فجائع","ولا سامهم من قبلها ذل سائم",185,"م",1,0],["وَلاقَيتُ الخُيورَ وَأَخطَأَتني","شُرورٌ جَمَّةٌ وَعَلَوتُ قِرني",186,"ن",2,0],["وَلاقى الشَقاءَ لَدى حَربِنا","دُحَيٌّ وَعَوفٌ وَإِخوانُها",187,"ن",3,0],["وَلا قُرزُلاً وَسطَ الرِجالِ جُنادِفاً","إِذا ما مَشى أَو قالَ قَولاً تَبَلتَعا",188,"ع",2,0],["وَلاقَينا بِأَبطَحِ ذي زَرودٍ","بَني شَيبانَ فَاِلتُهِموا اِلتِهاما",189,"م",2,0],["وَلاقَينا بِذي نَجَبٍ حُصَيناً","فَأَهلَكنا بِمُقلَتِنا أُساما",189,"م",2,0],["وَلاقي مِن نُفاثَةَ كُلَّ خِرقٍ","أَشَمَّ سَمَيدَعٍ مِثلِ الهِلالِ",190,"ل",1,0]]}