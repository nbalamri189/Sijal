diwan.net/poem12123.html","الرجز"],[516,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[516,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[539,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[539,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[552,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[552,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[552,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[552,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[552,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[559,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[559,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[562,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[570,"رب أمور قد بريت لحاءها","https://www.aldiwan.net/poem52036.html","الطويل"],[588,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["ولا قر في نفسي سكون ولا اشتفى","بي الصدر من غيظي ولا خف واقد",0,"د",1,0],["وَلا قَرَعتُ مِن قُنوطٍ سِنّي","ياأَيُّها المَغرورُ لا تَهِجَّني",1,"ن",2,0],["وَلا قاطِعٌ بِالظَنِّ ما كُنتُ واصِلاً","وَرُبَّ مَغيظٍ قاطِعٍ بِالتَوَهُّمِ",2,"م",1,0],["وَلا قائِلٌ ما يَعلَمُ اللَهُ ضِدَّهُ","وَلَو نالَ مِن جِلدي قَناً وَنُصولُ",3,"ل",1,0],["وَلا قِرنَ إِلّا أَدمَعَ الطَعنُ نَحرَهُ","وَما غَسَلَتهُ بِالدُموعِ مَدامِعُه",4,"ع",2,1],["وَلا قَّبَضَت أَنامِلهُ","عَلى مالٍ زَواجِرُه",5,"ر",2,0],["وَلا قُلتُ إِنّي عِندَ الفَخا","رِ إِلّا لِغَيرِ أَبي أَحمَدِ",6,"د",1,0],["وَلا قُضُبُ الرِجالِ الصيدِ فَضلاً","عَنِ الأَصواتِ في حَليِ النِساءِ",7,"ا",2,0],["ولاقى رَئيسُ القَوْمِ عَمْرو بنُ جابِرٍ","طِعاناً يُنَسِّيهِ الهَدِيِّ المُقَلدا",8,"د",2,0],["ولا قَعيدٌ أَغَضَبٌ قَرنُهُ","هاجَ لَهُ مِن مَرتَعٍ هائِجُ",9,"ج",1,0],["وَلاَ قَرَّ قَلْبٌ فِي قَرَارِ ضُلُوعِهِ","وَلَمْ تَعْرِفِ الأَجْفَانُ مَا لذَّةُ الغَمْضِ",10,"ض",1,0],["ولا قلْبَ إلا خافِقٌ في شِغافِهِ","بِها وكَساها منْ نَسيجَتِهِ بُرْدا",11,"د",2,0],["وَلا قُلنا لَهُم نَفسٌ بِنَفسٍ","أَقيدونا بِها إِن لَم تَدوها",12,"و",3,0],["وَلا قامَ في أَيّامِكَ البيضِ ماجِدٌ","يُنازِعُكَ البابَ الَّذي كُنتَ تَقرَعُ",13,"ع",1,0],["وَلا قيلَ هَذا فَيلَسوفٌ مُوَفَّقٌ","وَلا قيلَ هَذا عالِمٌ وَخَبيرُ",14,"ر",1,0],["وَلا قَبلَ عَبّادٍ جَوى البَحرَ مَجلِسٌ","وَلا حَمَلَ الطَودَ المُعَظَّمَ رَفرَفُ",15,"ف",1,0],["وَلأَقِفْ للنَّدَى بِحَيْثُ أَرَادُوا","وَلَهُمْ مِنْ إِجَابَتِي مَا رَامُوا",16,"م",3,0],["وَلاقى القَينُ وَالنَخَباتُ غَمّاً","تَرى لوكوفِ عَبرَتِهِ اِنصِبابا",17,"ب",2,0],["وَلاقَيتَ خَيراً مِن أَبيكَ فَوارِساً","وَأَكرَمَ أَيّاماً سُحَيماً وَجَحدَرا",18,"ر",2,0],["وَلاقَيتَ مِنّا مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاِستَأخِرَن أَو تَقَدَّما",19,"م",2,0],["وَلاقَيتَ مِنّي مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاستَأخِرَن أَو تَقَدَّما",19,"م",2,0],["وَلاَقَينَا قُضَاعَةَ يَومَ كَلب","بِطَلحَةَ والكُماةِ مُقَنَّعِينَا",20,"ن",2,0],["ولا قهوةٌ أستغفر الله تجتلى","ومن عجبٍ أنْ قد حلا منه ما مرا",21,"ر",2,0],["ولأقلام صاحب السرّ والأنظ","ار والاحتجاب في الخافقين",22,"ن",1,0],["ولا قيدت عن مصر قافية الحيا","ولا عطّلت أبياتها من رويه",23,"ي",2,0],["ولا قسورٌ إن لم يجد ما يكُفُّهُ","من الصَّيدِ أضحى والسباعُ له لحَمْ",24,"م",1,0],["ولا قَعَدْتُمْ على ضَيْمٍ ولا ضَمَدٍ","لكنْ عفوتُمْ وفي أيديكُمُ النِّقَمُ",25,"م",1,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّاً","كَفَتهُ كُلَّ حازِيَةٍ وَراقي",26,"ق",2,0],["وَلاقى اِمرَأً لا يَنقُضُ القَومُ عَهدَهُ","أَمَرَّ القُوى دونَ الوُشاةِ فَأَحصَدا",27,"د",2,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّا","كَفَتهُ كُلَّ راقِيَةٍ وَحازي",28,"ز",2,0],["وَلا قُصوراً وَلا رِياضاً","وَلا جُنوداً وَلا إِماء",29,"ا",2,0],["وَلا قَدُّها غُصن وَلا خَيرَزانَةٌ","وَلا خَصرُها غَور وَلا رِدفُها نَجدُ",30,"د",1,0],["ولَأَقلامُك أمضى","من شبا رمح دُرَيْدِ",31,"د",1,0],["وَلاقَينَ مِن أَولادِ عُقدَةَ عُصبَةً","عَلى الماءِ يَنثونَ الذُحولَ المَوانِعا",32,"ع",2,0],["ولاقيت منهم كل خسف وجفوةٍ","فماذا عسى من بعد ذا أن أُلاقيا",33,"ي",2,0],["ولا قرقرت أوبربرت يوما","كما هيجت ديكا مالِطِيا",34,"ي",2,0],["وَلاقي العَبقَرِيّينَ","لِقاءَ النِدِّ لِلنِدِّ",35,"د",1,0],["وَلاقى دونَ ثايِهِمِ طِعاناً","يُلاقي عِندَهُ الذِئبَ الغُرابُ",36,"ب",1,0],["وَلا قَبضٌ عَلى البيضِ المَواضي","وَلا حَظٌّ مِنَ السُمرِ اللِدانِ",37,"ن",1,0],["ولا قرَّ لي بعدَ التفرُّقِ مضجعٌ","ولا طابَ لي بعدَ الرحيلِ مقامُ",38,"م",1,0],["وَلا قَبولي ما كُنتَ جُدتَ بِهِ","عَلَيَّ بِالأَمسِ خُلسَةَ الذيبِ",39,"ب",1,0],["وَلا قَمَرٌ إِلّا حُشاشَةُ غائِرِ","كَعَينِ طِماسٍ رَنَّقَت لِرُقادِ",40,"د",1,0],["وَلاقَت عَلى الزابِ الصَغيرِ حُماتُها","حِمامَ المَنايا إِذ عِمادٌ عَميدُها",41,"د",3,0],["وَلا قَصرَ بي عَن ضامِنٍ مُتَكَفِّلٍ","بَوائِقَ ما يَطوي الزَمانُ وَما يُبدي",42,"د",2,0],["وَلا قائِلٌ فيكَ إِلّا الجَمي","لَ وَإِن كانَ ما جِئتَ لا يَجمُلُ",43,"ل",1,0],["وَلاقَت مِنَ الحِرمازِ أَولادَ مِجشَإٍ","وَمِن مازِنٍ شَرِّ القَبائِلِ مَعشَرا",44,"ر",2,0],["وَلاقى شَديدَ الدَرءِ مُستَحصِدَ القِوى","تَفَرَّقُ بِالعِصيانِ عَنهُ عَواذِلُه",45,"ل",2,0],["وَلاقيهِ بِالتَرحيبِ وِالرَحرِ وَالقِرى","وَيَمّم لَهُ ما دُمتَ تَحتَ اِقتِدارِهِ",46,"ر",2,0],["وَلا قَلاني وَإِن كانَ المُسيءُ بِنا","إِلّا دَعَوتُ لَهُ الرَحمَنَ بِالرَشَدِ",47,"د",1,0],["وَلا قَلَّدَ الأَعناقَ مِن فَيضِ جودِهِ","قَلائِدَ بِرٍّ لا يَقومُ بِها الشُكرُ",48,"ر",1,0],["وَلا قيلَ يَوماً أَنَّهُ غَيرُ عالِمٍ","بِغَيرِ عُيوبِ الجارِ وَاللَومِ وَالجُبنِ",49,"ن",1,0],["ولاقِطٌ نظرةً عَجلى يكونُ بها","ليْ في الحياةِ وما ألقى بِها ، سَند",50,"د",1,0],["وَلا قُربُ نُعمٍ إِن دَنَت","وَلا نَأيُها يُسلي وَلا أَنتَ تَصبِرُ",51,"ر",1,0],["وَلا قَولُ واشٍ كاشِحٍ ذي عَداوَةٍ","وَلا بُعدُ دارٍ إِن نَأَيتِ وَلا قُربُ",52,"ب",1,0],["وَلا قِلتُ مِنهُ بَينَ ظِلٍّ لِعَطفَةٍ","تَنَدّى وَنورٍ لِلبَشاشَةِ مونِقِ",53,"ق",1,0],["وَلاقي بِمَأمولِ الرِضى مِنكِ مَوكِباً","تَوارَت لَهُ الجَوزاءُ وَاِستَحيَتِ الشِعرى",54,"ر",2,0],["وَلا قَرنٌ يُقَزَّزُ مِن طَعامٍ","وَلا نَصِبٌ وَلا مولى عَديمُ",55,"م",1,0],["وَلا قَولَها وَهناً وَقَد بَلَّ نَحرَها","سَوابِقُ دَمعٍ ما يَجِفُّ غَزَيرِ",56,"ر",1,0],["ولاقُوا المَوْتَ دُونَ حريمِ مِصْرٍ","وَصانُوا المَالَ مِنهُمْ وَالبَنِينا",57,"ن",2,0],["ولا قلّبت تلك السلاح أكفُّها","ولا وصلت تلك الأكفَّ الأنامل",58,"ل",1,0],["وَلا قَيسٌ أَخو لُبنى","وَلا عَمرٌ أَخو دَعدِ",59,"د",1,0],["وَلا قَطَعتُ عَلى حَرفٍ مُذَكَّرَةٍ","في مِرفَقَيها إِذا اِستَعرَضتَها فَتَلُ",60,"ل",1,0],["وَلا قَصَّرَت لي أُمُّ لَيلى بِشُربِها","حَنادِسَ أَوقاتٍ عَلَيَّ طِيالِ",61,"ل",1,0],["وَلاقَيتَ عِندي الخَيرَ تَحسَبُ عَيِّلاً","يُنافيكَ قَولٌ سَيِّئٌ وَشَتائِمُ",62,"م",1,0],["وَلا قُصورٌ لَها مُشَيَّدَةٌ","قَد مُوِّهَت عَسجَداً رَواشِنُها",63,"ن",3,0],["وَلاقَتبي عَلى العَودِ المُزَجّى","وَلا سَرجي عَلى الفَرَسِ الأَدَنِّ",64,"ن",1,0],["ولا قَلِقاتُ اللّيلِ باتَت كأنّها","من الأينِ والإدلاجِ بعضُ القنا اللُّدنِ",65,"ن",1,0],["ولاقَى دُوَيْنَ الوِرْدِ كلَّ مُغَيَّبٍ","عنِ الرّشْدِ يَقْتادُ الخَنا بزِمامهِ",66,"م",2,0],["وَلاَقاَهُ مِنّا فَارِسٌ غيرُ جَيدَرٍ","فَأَكرَهَ فِيهِ الرُمحَ حَتّى تَفَطَّرا",67,"ر",2,0],["ولا قبلَها قبل ولا بَعْدَ بَعْدَهَا","وقَبْليُّة الأبْعادِ فهْي لها حَتْم",68,"م",1,0],["وَلا قَولَها لَولا العُيونُ الَّتي تَرى","لَزُرتُكَ فَاِعذُرني فَدَتكَ جُدودُ",69,"د",1,0],["ولا قنا الأسباط حول يوشعا","أعفّ من قناهما وأخشعا",70,"ع",2,0],["وَلاقَيتُ العِدا وَحَفِظتُ قَوماً","أَضاعوني وَلَم يَرعَوا جَنابي",71,"ب",2,0],["ولاَقَيتُ لَذَّاتِ الفَتَى وأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",72,"د",1,0],["وَلا قراءَتكَ السوراتِ بَينَهُمُ","مُرَتَّلاتٍ بِإِظهارٍ وَإِدغامِ",73,"م",1,0],["وَلا قَطّ آذى مُسلِماً بِلِسانِهِ","وَلا بِيَدَيهِ بَل هُوَ اِحتَمَلَ الأَذى",74,"ذ",2,0],["وَلا قَولَها لِيَ إِذ أَيقَنَت","بِما قَد أُريدُ بِها أَستَقِر",75,"ر",1,0],["ولا قُضَاةً يَهَابُونَ الجُنَاة؛ فهم","يُغْصُون إن أزهقوا الأرواحَ أو نهبوا",76,"ب",3,0],["ولا قلب إلا خافق في شغافه","ولا طرف إلا من مهابتها ارتدا",77,"د",2,0],["وَ لأقتلنَّ حجاحجاً منْ بكركمْ","ولأَبْكِيَنَّ بِهَا جُفُونَ عُيُونِ",78,"ن",1,0],["ولا قوماً يَرُدُّون الدّواهي","وقد خَرِسَتْ بألسْنةٍ فِصاح",79,"ح",1,0],["ولا قائلٌ : اصبحتُ منكم ، وقد أرى","غوايَتكم او انني غير مهتدي",80,"د",2,0],["ولاقت على الزب الصغير حماتها","حمام المنايا إذ عماد عميدها",81,"د",3,0],["ولا قدّها غصن ولا خيزرانة","ولا خصرها غور ولا ردفها نجد",82,"د",1,0],["وَلاَقَيْنَ مِنْ أوْلاَدِ عُقْدَة َ عُصْبَة","ً عَلَى الْمَاءِ يَنْثُونَ الذُّحُولَ الْمَوَانِع",83,"ع",1,0],["ولا قربُ نعمٍ إن دنتْ لك نافعٌ،","وَلاَ نأْيُهَا يُسْلي وَلاَ أَنْتَ تَصْبِرُ",84,"ر",1,0],["وَلاقَيتُ لَذّاتِ الغِنى وَأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",85,"د",1,0],["ولا قَعيدٌ أعْضبٌ قرنُهُ","هَاجَ لَهُ مِنْ مَرْتَعٍ هَائِجُ",86,"ج",1,0],["ولا قطعت قريباً لي لذلته","ولا وصلت غريباً خيفة",87,"ه",1,0],["ولا قضاة ولا أحكام أسلمها","برداً على العدل آتون من النار",88,"ر",1,0],["ولاقَيْتَها شَهْباءَ تَخْطرُ بالقَنا","وسَعْيَةُ يُدْعَى وسطها والسَّمَوَّلُ",89,"ل",1,0],["ولا قاطعاً شخصاً له وهو واصلٌ","ولا واصلٌ شخصاً له وهو قاطعُ",90,"ع",1,0],["ولاقت مثلها الصعدات حتى","تكسرت النصالُ على النصالِ",91,"ل",1,0],["ولا قوس السحاب إذا تجلّى","ولا الأقمار في كبدِ السماءِ",92,"ا",2,0],["وَلا قادَني سَمعي وَلا بَصَري لَها","وَلا دَلَّني رَايي عَلَيها وَلا عَقلي",93,"ل",2,0],["ولا قيتَ ربَّ التاج يرفعُ حُجْبَهَ","ويطردُ ما ناجيته التيهَ والكِبرا",94,"ر",2,0],["ولاقت به الفُرسُ أمَّ اللُّهَي","م وأْدَ البناتِ وذبحَ البنينا",95,"ن",2,0],["وَلاقى الأُلوفَ غَيرَ مُكتَرِثٍ بِها","هُمامٌ أَجابَ المَوتَ أَوَّلَ ما دَعا",96,"ع",2,0],["وَلاقَت طَيِّئٌ ضَرباً دِراكاً","أَطارَ طُلىً وَأَذرِعَةً وَسوقا",97,"ق",2,0],["ولاقى هوانا مثله لم يلاقه","وهسفا وخسفا موجعا ومغارما",98,"م",2,0],["ولأقدمن على التناول كلما","أعطيتني ولو ان عقلي يذهب",99,"ب",1,0],["ولا قال جهلا للولاية منصب","يقصر عنها للنبوة منصب",100,"ب",1,0],["ولا قومه تحمى الفصوص وكفرها","لدى الملك من إلقائها في التنانر",101,"ر",1,0],["ولا قظت الشربة كل يوم","أعدى من مياههم الذبابا",102,"ب",2,0],["وَلا قائِلٍ لِلدَّهرِ رِفقاً وَقَد طَمَت","أَواذِيُّهُ شَرّاً وَجاشَت غَوارِبُهْ",103,"ب",2,0],["وَلاقَيتُ في أَبناءِ عَمّي وَمعشري","ذآليلَ لا يَرقى إِلَيها المُجالِحُ",104,"ح",1,0],["وَلاقَيتُ مِن جَرّائِكُم ما عَلِمتَهُ","وَهَل أَحَدٌ مِن سائِرِ الناسِ جاهِلُه",105,"ل",2,0],["وَلاقى الرَعايا خافِضاً مِن جَناحِهِ","وَفي بُردِهِ لَيثٌ بِخفّانَ مُشبِلُ",106,"ل",1,0],["وَلاقى الرَعايا خافِضاً مِن جَناحِهِ","وَفي بُردَتَيهِ هَيبَةٌ وَجَلالُ",107,"ل",1,0],["وَلا قابِضٍ فَضلَ الغِنى عَن فَقيرِها","وَلا باسِطٍ كَفّاً لَها حينَ أُعدِمُ",108,"م",1,0],["وَلا قَضيب النَقا تَذوي مَعاطفه","في قَفرة بِمياه الدَمع تَزدَهر",109,"ر",1,0],["ولأَقْنَعَنَّ من المُنَى بخيالهِ","زُورا يُمَنِّينى بخُلْفِ عُداته",110,"ت",2,0],["ولا قلت اذ كانوا نجوما طوالعا","وغابوا بان الارض تختص بالشهب",111,"ب",1,0],["ولا قلت ان الارض حين ثوى بها","تغيب بها الشمس المنيرة والبدر",112,"ر",1,0],["ولا قلت ان البحر يحمل سائرا","لى ظهر لوح او يحيط به قبر",112,"ر",1,0],["ولاقاها بِصَدرٍ راضَ صَبراً","وَلاقَتهُ بِصَدرٍ ضاقَ صَبرا",113,"ر",2,0],["ولأقعدن على الطريق فاشتكي","في زي مظلوم وأنت ظلمتني",114,"ن",2,0],["ولا قَنِعتُ بزور الْوَعْدِ من رَشَإٍ","دون التّعانُقِ والتَّجميش والقُبَلِ",115,"ل",1,0],["ولاقى الأذى من قومه فهو صابر","ومرّ إلى ذات النخيل يُفيض",116,"ض",1,0],["وَلاقَينَ جبّارَ بنَ حمزةَ بعدَما","أَطابَ بشَكٍّ أَيَّ أَمرَيهِ أَفعَلُ",117,"ل",1,0],["ولا قصرت أيام من كنت فرعه","ولا انقض يوماً في الزمان جداره",118,"ر",2,0],["ولاقِ الصُّبحَ مُنبلِجاً","وشمَّ الزَّهرَ مُنفتِحا",119,"ح",2,0],["ولا قدرةٌ بعد الشتاتِ على العدى","بغيرِ اتحادٍ فيهِ توحيدُ غاية",120,"ه",1,0],["وَلا قَيْس حُب أَو مَفاخِر دارِم","وَلا قَس لب قَطُّ أَو طَرفة العَبدِ",121,"د",1,0],["وَلاقَتْ علَى حُكْمِ السَّعَادَةِ بُرْدَها","ومَا بَرِحَتْ أثْنَاءَ شِقْوَتِهَا رَهْصا",122,"ص",2,0],["وَلاقَيتُ لِلأَعلاقِ أجْود مانِحٍ","يَميناً وَللأغْلاق أسْعدَ فاتِح",123,"ح",1,0],["وَلا قيدَتِ الخَيلُ العِتاقُ شَوازِباً","وَلا هُزَّ رُمحٌ في أَنامِلِ هَزّازِ",124,"ز",1,0],["وَلا قَرقَفٌ صَهباءُ صِرفٌ مُحيلَةٌ","يَفُضُّ زُكامَ المِنخَرَينِ عَتيقُها",125,"ق",3,0],["ولاقِهم بالبِشرِ","وحيِّهم بالشُكرِ",126,"ر",1,0],["ولأقبضن عنان قولي ها هنا","حسى وفي تعدادهم لم أطمع",127,"ع",1,0],["ولا قصر الا زناد عن نيل قصدها","سوى ضجر عجز تكاسل جثمان",128,"ن",1,0],["وَلاقيتُ برّاً قَد طَمى برّ بحره","فَجابَت لَه آمالُنا البرّ والبحرا",129,"ر",2,0],["ولا قاطع للناس نهج سبيلهم","ولا مفسد في الارض في كل وجهة",130,"ه",1,0],["وَلا قِرى لِنَزيلٍ دونَ قَريَتِهِ","وَلا هُدىً لِسَبيلٍ دونَ كَوكَبِهِ",131,"ب",2,0],["ولاقَيتَ مِن دُونِ الأَمَانِي خَلِيفَةً","بدِيهَتُه وَحيٌ وَعَزمَتُهُ لَمحُ",132,"ح",1,0],["ولاقيتَني فرداً فلاقيتَ ماجداً","وأنتَ حَسيرٌ في الوَثَاقِ أَسيرُ",133,"ر",1,0],["وَلا قُلتُ لِلأَعداءِ إِنّي سَحَرتُهُم","وَهَذا ثَنئي ثُمَّ ما هاجَهُم سِحري",134,"ر",2,0],["وَلا قُلتُ مَطروداً بِعامِ مَجاعَةٍ","وَلَكِن طَريدٌ مِن سُيولِ غَمامِ",135,"م",1,0],["ولا قال لا أرضى تعاليم بُطرسٍ","وما جاءنا بالبينات رسول",136,"ل",1,0],["ولا قال إني خائفٌ عند طاعتي","وفي الناس منهم قاتلٌ وقتيل",136,"ل",1,0],["ولاقيت كل العارفين بسفحها","وكل كريم ساكن برباها",137,"ا",3,0],["ولاقى به قوماً من الرسل كلها","يقول له يا مرحباً حين سلما",138,"م",2,0],["ولا قطعة اقتطعتها أو ولاية","كما هو دأب الناس في كل مورد",139,"د",1,0],["ولاقيت هابيلاً قتيل شقيقه","يواريه لما أن رآه غراب",140,"ب",1,0],["وَلأقتُلَنَّ العُدمَ قتلةَ ثائِرٍ","بِالجودِ من نَفحاتِ كَفِّ حُسَينِ",141,"ن",1,0],["وَلأَقضينَّ الدَهرَ غيرُ مُقَصِّرٍ","ما كانَ أَسلَفَنيه مِن أَحقادِهِ",142,"د",2,0],["ولاقيت صعب المرتقى غير ناكص","وأصعب ما ألقى رئاسة ناقص",143,"ص",1,0],["ولاقاهم وهل يخشى لقاهم","فتىً ألقى على اللَه اتكالا",144,"ل",2,0],["ولا قام يبغي نصرة الحق قائم","من الناس لولا سيف عزمك والجد",145,"د",1,0],["ولاقَيْتُمُ البيضَ والسُّمْرَ عَنَّا","ونحنُ بِعَقْوَتِكُمْ آمِنُونا",146,"ن",2,0],["ولاقى وْجوهَ الراغبينَ كأنَّما","أمانِيُّهُم يُصْبِحَنَ مْنهُ عَلَى وعْدِ",147,"د",1,0],["ولاقاكَ فاسْتَخْذى لديكَ تذلُّلاً","ليحتازَ من أدنى رضاكَ تَرَحُّما",148,"م",2,0],["ولا قَدَمٌ لا تَسْأَمُ الدَّهْرَ تَرْتَقِي","ذُرى كُلِّ صَعْبِ المُرْتَقَاةِ مُنِيفِها",149,"ف",3,0],["وَلا قَنَطٌ واليُسرُ لِلعُسرِ غالِبٌ","وَفِي العرْشِ رَبٌّ بالخَلائِقِ رَحْمانُ",150,"ن",1,0],["ولاق ضيفك طلق الوجه مبتسماً","ولو تعبَّس وجه الدهر مكتلحا",151,"ح",2,0],["ولاقى بعد ما لاقى المعادا","عتاد الباقيات الصالحات",152,"ت",1,0],["ولا قلب مذسار الموادع وادع","ولا عيش مذ طال التفرق طائل",153,"ل",1,0],["ولا قَرَنتُ حبَّه صبابةً","لا يطمع العاذلُ في سلوانِها",154,"ن",3,0],["ولا قامت الدنيا بسيرةِ عادلٍ","يُهابُ ولم يُنصَرْ لربّك دينُ",155,"ن",1,0],["ولا قدَرت على نفسي ولحظي","على ما نَمَّ من طيبٍ وحُسنِ",156,"ن",1,0],["ولا قسموا لها الإنصاف يوما","بكيلٍ في السماح ولا بوزنِ",156,"ن",1,0],["ولا قصير الإزار إن جذبَ ال","جدبُ بأذيال خائِض القُحَمِ",157,"م",1,0],["ولا قلّص الملكُ عاداتهِ","معي وهو في ثوبه رافلُ",158,"ل",1,0],["ولا قَرَى صَبابةً فؤادَه","إلا السلوَّ حاضراً والجَلَدا",159,"د",2,0],["ولا قَضَى اللّهُ على سيِّد","قضاءَهُ إلا اجتبَى سيِّدا",160,"د",2,0],["ولاقاه من الأيام يوم","كما من قبل لم يخلد قدار",161,"ر",1,0],["وَلا قَرَأتُ كِتاباً مِنكِ يَبلُغُني","إِلّا تَنَفَّستُ مِن وَجدٍ بِكُم صُعَدا",162,"د",2,0],["ولا قطفوا باللثمِ وردةَ خَدَّها","ولا هصروا في ثِني أبرادِها الغصنا",163,"ن",2,0],["ولاقى على الأوطان أهوال عاشق","عرته أهاويل على الطي والنشر",164,"ر",1,0],["ولا قفرة إلا وأمسيت صِلَّها","ولا حَضَرٌ إلا وظلْتُ له وَفْدا",165,"د",2,0],["ولا قيَّدْتُ ذاتي في نِطاقٍ","يُميلُ بها شُهودي عن رُبَاكِ",166,"ك",1,0],["ولا قِستُ السّما حين انتصرتُ","ولا شئتُ البكا حين هُزمتُ",167,"ت",1,0],["ولا قنَصَتْ أختُ الغَزالِ جوارِحي","ولا هيّجَتْ وُرْقُ الحَمامِ بَلابِلي",168,"ل",2,0],["ولا قدس الدهر فلولا جوره","لم يتحكم عاجز في قادر",169,"ر",1,0],["ولا قسمت ألحاظه بين مخلص","جميل السجايا أو عدو يجامله",170,"ل",2,0],["ولا قام في المحراب والحرب عاملاً","من البأس والإحسان ما الله قابله",170,"ل",2,0],["ولا قدم الشهر المحرم قبل ما","عداه سوى تقديمكم للمحرم",171,"م",1,0],["ولاقيتَ من عزٍّ منيعٍ وحُظوة","ورِفعَةِ جاهٍ وابتِسامِ ثُغورِ",172,"ر",1,0],["ولاقاك عن شَوق رجالُ حكومةٍ","تُبادِلك الودَّ الذي يَتجدَّدُ",173,"د",1,0],["وَلا قُذيتُ بعوراءٍ لَهُ مَرَقَتْ","سرّاً ودافع عنها النّاسُ إعلانا",174,"ن",2,0],["ولا قومٌ لَهمْ في قل","لَةِ العلياءِ بُنيانُ",175,"ن",1,0],["وَلا قلبَ إلّا وهو منك مُكلَّمٌ","وَلا لُبَّ إلّا وهو فيك مُذَهَّلُ",176,"ل",1,0],["وَلا قيّضَ اللّهُ التفرّقَ عنكمُ","ولا عَنَّ نأْيٌ بيننا وتصدُّعُ",177,"ع",1,0],["وَلا قُرّبتَ من جَدْبٍ","ولا بوعدتَ من خِصْبِ",178,"ب",1,0],["ولا قومي أرى قومي","ولا أهلي أرى أهلي",179,"ل",2,0],["ولأقلام التجلي","سمعت أذني صريفا",180,"ف",2,0],["ولا قائم إلا بها في وجوده","ولا صانع إلا بها هو صانع",181,"ع",1,0],["وَلا قَضِيّاً بِالقضَاءِ المُتَّهَم","في أُمَّةٍ سُوِّسَها بَعدَ أُمَم",182,"م",1,0],["ولا قاذِفٌ نَفسي وَنَفسي بريئة","وَكَيفَ اعتذاري بعد ما قد قذفتها",183,"ت",3,0],["ولا قبلها كانت عليهم فجائع","ولا سامهم من قبلها ذل سائم",184,"م",1,0]]}