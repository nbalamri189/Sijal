iwan.net/poem41581.html","الطويل"],[90,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[31,"أعبدة ما ينسى مودتك القلب","https://www.aldiwan.net/poem42613.html","الطويل"],[74,"ألا ليت لمح البارق المتألق","https://www.aldiwan.net/poem13196.html","الطويل"],[105,"مهاة اللوى حسبي وحسب الهوى ذعرا","https://www.aldiwan.net/poem43381.html","الطويل"],[21,"جهنم تلك لا تبقي بغيا","https://www.aldiwan.net/poem36164.html","الوافر"],[40,"لمن طلل بالنعف نعف وقير","https://www.aldiwan.net/poem42313.html","الطويل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[48,"أيا من أخلف الوعد","https://www.aldiwan.net/poem62592.html","الهزج"],[48,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[46,"عمى العين يتلوه عمى الدين والهدى","https://www.aldiwan.net/poem23211.html","الطويل"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[46,"هذي القضايا فمن يطاولها","https://www.aldiwan.net/poem23461.html","المنسرح"],[46,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9894","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21003","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[31,"","https://poetry.dctabudhabi.ae/diwan/poem/6126","المتقارب"],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[18,"لوْ أنَّ خيلي أدركتكَ وجدتهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=22991",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[45,"لدارِكِ، يا لَيلى، سَماءٌ تَجودُها","https://www.poetsgate.com/ViewPoem.aspx?id=31695",""],[91,"حكاية قديمة","https://www.poetsgate.com/ViewPoem.aspx?id=53010",""],[38,"هممتَ الغداة َ همّة ً أنْ تراجعا","https://www.poetsgate.com/ViewPoem.aspx?id=21210",""],[31,"أَمِنْ آلِ نُعْمِ أَنْتَ غَادٍ فَمُبْكِرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18852&r=&rc=115",""],[20,"أتعرِف رسم الدار من أم معبد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69764&r=&rc=5",""],[6,"يا أيُّها المُزْمعُ ثُمَّ کنْثَنَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14189&r=&rc=4",""]],"verses":[["وَلا قَرَعتُ مِن قُنوطٍ سِنّي","ياأَيُّها المَغرورُ لا تَهِجَّني",0,"ي",1,0],["وَلا قاطِعٌ بِالظَنِّ ما كُنتُ واصِلاً","وَرُبَّ مَغيظٍ قاطِعٍ بِالتَوَهُّمِ",1,"م",1,0],["وَلا قائِلٌ ما يَعلَمُ اللَهُ ضِدَّهُ","وَلَو نالَ مِن جِلدي قَناً وَنُصولُ",2,"ل",1,0],["وَلا قِرنَ إِلّا أَدمَعَ الطَعنُ نَحرَهُ","وَما غَسَلَتهُ بِالدُموعِ مَدامِعُه",3,"ع",2,1],["وَلا قَّبَضَت أَنامِلهُ","عَلى مالٍ زَواجِرُه",4,"ر",2,0],["وَلا قُلتُ إِنّي عِندَ الفَخا","رِ إِلّا لِغَيرِ أَبي أَحمَدِ",5,"د",1,0],["وَلا قُضُبُ الرِجالِ الصيدِ فَضلاً","عَنِ الأَصواتِ في حَليِ النِساءِ",6,"ا",2,0],["ولاقى رَئيسُ القَوْمِ عَمْرو بنُ جابِرٍ","طِعاناً يُنَسِّيهِ الهَدِيِّ المُقَلدا",7,"د",2,0],["ولا قَعيدٌ أَغَضَبٌ قَرنُهُ","هاجَ لَهُ مِن مَرتَعٍ هائِجُ",8,"ج",1,0],["وَلاَ قَرَّ قَلْبٌ فِي قَرَارِ ضُلُوعِهِ","وَلَمْ تَعْرِفِ الأَجْفَانُ مَا لذَّةُ الغَمْضِ",9,"ض",1,0],["ولا قلْبَ إلا خافِقٌ في شِغافِهِ","بِها وكَساها منْ نَسيجَتِهِ بُرْدا",10,"د",2,0],["وَلا قُلنا لَهُم نَفسٌ بِنَفسٍ","أَقيدونا بِها إِن لَم تَدوها",11,"و",3,0],["وَلا قامَ في أَيّامِكَ البيضِ ماجِدٌ","يُنازِعُكَ البابَ الَّذي كُنتَ تَقرَعُ",12,"ع",1,0],["وَلا قيلَ هَذا فَيلَسوفٌ مُوَفَّقٌ","وَلا قيلَ هَذا عالِمٌ وَخَبيرُ",13,"ر",1,0],["وَلا قَبلَ عَبّادٍ جَوى البَحرَ مَجلِسٌ","وَلا حَمَلَ الطَودَ المُعَظَّمَ رَفرَفُ",14,"ف",1,0],["وَلأَقِفْ للنَّدَى بِحَيْثُ أَرَادُوا","وَلَهُمْ مِنْ إِجَابَتِي مَا رَامُوا",15,"م",3,0],["وَلاقى القَينُ وَالنَخَباتُ غَمّاً","تَرى لوكوفِ عَبرَتِهِ اِنصِبابا",16,"ب",2,0],["وَلاقَيتَ خَيراً مِن أَبيكَ فَوارِساً","وَأَكرَمَ أَيّاماً سُحَيماً وَجَحدَرا",17,"ر",2,0],["وَلاقَيتَ مِنّا مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاِستَأخِرَن أَو تَقَدَّما",18,"م",2,0],["وَلاقَيتَ مِنّي مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاستَأخِرَن أَو تَقَدَّما",18,"م",2,0],["وَلاَقَينَا قُضَاعَةَ يَومَ كَلب","بِطَلحَةَ والكُماةِ مُقَنَّعِينَا",19,"ن",2,0],["ولا قهوةٌ أستغفر الله تجتلى","ومن عجبٍ أنْ قد حلا منه ما مرا",20,"ر",2,0],["ولأقلام صاحب السرّ والأنظ","ار والاحتجاب في الخافقين",21,"ن",1,0],["ولا قيدت عن مصر قافية الحيا","ولا عطّلت أبياتها من رويه",22,"ي",2,0],["ولا قسورٌ إن لم يجد ما يكُفُّهُ","من الصَّيدِ أضحى والسباعُ له لحَمْ",23,"م",1,0],["ولا قَعَدْتُمْ على ضَيْمٍ ولا ضَمَدٍ","لكنْ عفوتُمْ وفي أيديكُمُ النِّقَمُ",24,"م",1,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّاً","كَفَتهُ كُلَّ حازِيَةٍ وَراقي",25,"ي",1,0],["وَلاقى اِمرَأً لا يَنقُضُ القَومُ عَهدَهُ","أَمَرَّ القُوى دونَ الوُشاةِ فَأَحصَدا",26,"د",2,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّا","كَفَتهُ كُلَّ راقِيَةٍ وَحازي",27,"ي",1,0],["وَلا قُصوراً وَلا رِياضاً","وَلا جُنوداً وَلا إِماء",28,"ا",2,0],["وَلا قَدُّها غُصن وَلا خَيرَزانَةٌ","وَلا خَصرُها غَور وَلا رِدفُها نَجدُ",29,"د",1,0],["ولَأَقلامُك أمضى","من شبا رمح دُرَيْدِ",30,"د",1,0],["وَلاقَينَ مِن أَولادِ عُقدَةَ عُصبَةً","عَلى الماءِ يَنثونَ الذُحولَ المَوانِعا",31,"ع",2,0],["ولاقيت منهم كل خسف وجفوةٍ","فماذا عسى من بعد ذا أن أُلاقيا",32,"ي",2,0],["ولا قرقرت أوبربرت يوما","كما هيجت ديكا مالِطِيا",33,"ي",2,0],["وَلاقي العَبقَرِيّينَ","لِقاءَ النِدِّ لِلنِدِّ",34,"د",1,0],["وَلاقى دونَ ثايِهِمِ طِعاناً","يُلاقي عِندَهُ الذِئبَ الغُرابُ",35,"ب",1,0],["وَلا قَبضٌ عَلى البيضِ المَواضي","وَلا حَظٌّ مِنَ السُمرِ اللِدانِ",36,"ن",1,0],["ولا قرَّ لي بعدَ التفرُّقِ مضجعٌ","ولا طابَ لي بعدَ الرحيلِ مقامُ",37,"م",1,0],["وَلا قَبولي ما كُنتَ جُدتَ بِهِ","عَلَيَّ بِالأَمسِ خُلسَةَ الذيبِ",38,"ب",1,0],["وَلا قَمَرٌ إِلّا حُشاشَةُ غائِرِ","كَعَينِ طِماسٍ رَنَّقَت لِرُقادِ",39,"د",1,0],["وَلاقَت عَلى الزابِ الصَغيرِ حُماتُها","حِمامَ المَنايا إِذ عِمادٌ عَميدُها",40,"د",3,0],["وَلا قَصرَ بي عَن ضامِنٍ مُتَكَفِّلٍ","بَوائِقَ ما يَطوي الزَمانُ وَما يُبدي",41,"ي",1,0],["وَلا قائِلٌ فيكَ إِلّا الجَمي","لَ وَإِن كانَ ما جِئتَ لا يَجمُلُ",42,"ل",1,0],["وَلاقَت مِنَ الحِرمازِ أَولادَ مِجشَإٍ","وَمِن مازِنٍ شَرِّ القَبائِلِ مَعشَرا",43,"ر",2,0],["وَلاقى شَديدَ الدَرءِ مُستَحصِدَ القِوى","تَفَرَّقُ بِالعِصيانِ عَنهُ عَواذِلُه",44,"ل",2,0],["وَلاقيهِ بِالتَرحيبِ وِالرَحرِ وَالقِرى","وَيَمّم لَهُ ما دُمتَ تَحتَ اِقتِدارِهِ",45,"ر",2,0],["وَلا قَلاني وَإِن كانَ المُسيءُ بِنا","إِلّا دَعَوتُ لَهُ الرَحمَنَ بِالرَشَدِ",46,"د",1,0],["وَلا قَلَّدَ الأَعناقَ مِن فَيضِ جودِهِ","قَلائِدَ بِرٍّ لا يَقومُ بِها الشُكرُ",47,"ر",1,0],["وَلا قيلَ يَوماً أَنَّهُ غَيرُ عالِمٍ","بِغَيرِ عُيوبِ الجارِ وَاللَومِ وَالجُبنِ",48,"ن",1,0],["ولاقِطٌ نظرةً عَجلى يكونُ بها","ليْ في الحياةِ وما ألقى بِها ، سَند",49,"د",1,0],["وَلا قُربُ نُعمٍ إِن دَنَت","وَلا نَأيُها يُسلي وَلا أَنتَ تَصبِرُ",50,"ر",1,0],["وَلا قَولُ واشٍ كاشِحٍ ذي عَداوَةٍ","وَلا بُعدُ دارٍ إِن نَأَيتِ وَلا قُربُ",51,"ب",1,0],["وَلا قِلتُ مِنهُ بَينَ ظِلٍّ لِعَطفَةٍ","تَنَدّى وَنورٍ لِلبَشاشَةِ مونِقِ",52,"ق",1,0],["وَلاقي بِمَأمولِ الرِضى مِنكِ مَوكِباً","تَوارَت لَهُ الجَوزاءُ وَاِستَحيَتِ الشِعرى",53,"ر",2,0],["وَلا قَرنٌ يُقَزَّزُ مِن طَعامٍ","وَلا نَصِبٌ وَلا مولى عَديمُ",54,"م",1,0],["وَلا قَولَها وَهناً وَقَد بَلَّ نَحرَها","سَوابِقُ دَمعٍ ما يَجِفُّ غَزَيرِ",55,"ر",1,0],["ولاقُوا المَوْتَ دُونَ حريمِ مِصْرٍ","وَصانُوا المَالَ مِنهُمْ وَالبَنِينا",56,"ن",2,0],["ولا قلّبت تلك السلاح أكفُّها","ولا وصلت تلك الأكفَّ الأنامل",57,"ل",1,0],["وَلا قَيسٌ أَخو لُبنى","وَلا عَمرٌ أَخو دَعدِ",58,"د",1,0],["وَلا قَطَعتُ عَلى حَرفٍ مُذَكَّرَةٍ","في مِرفَقَيها إِذا اِستَعرَضتَها فَتَلُ",59,"ل",1,0],["وَلا قَصَّرَت لي أُمُّ لَيلى بِشُربِها","حَنادِسَ أَوقاتٍ عَلَيَّ طِيالِ",60,"ل",1,0],["وَلاقَيتَ عِندي الخَيرَ تَحسَبُ عَيِّلاً","يُنافيكَ قَولٌ سَيِّئٌ وَشَتائِمُ",61,"م",1,0],["وَلا قُصورٌ لَها مُشَيَّدَةٌ","قَد مُوِّهَت عَسجَداً رَواشِنُها",62,"ن",3,0],["وَلاقَتبي عَلى العَودِ المُزَجّى","وَلا سَرجي عَلى الفَرَسِ الأَدَنِّ",63,"ن",1,0],["ولا قَلِقاتُ اللّيلِ باتَت كأنّها","من الأينِ والإدلاجِ بعضُ القنا اللُّدنِ",64,"ن",1,0],["ولاقَى دُوَيْنَ الوِرْدِ كلَّ مُغَيَّبٍ","عنِ الرّشْدِ يَقْتادُ الخَنا بزِمامهِ",65,"م",2,0],["وَلاَقاَهُ مِنّا فَارِسٌ غيرُ جَيدَرٍ","فَأَكرَهَ فِيهِ الرُمحَ حَتّى تَفَطَّرا",66,"ر",2,0],["ولا قبلَها قبل ولا بَعْدَ بَعْدَهَا","وقَبْليُّة الأبْعادِ فهْي لها حَتْم",67,"م",1,0],["وَلا قَولَها لَولا العُيونُ الَّتي تَرى","لَزُرتُكَ فَاِعذُرني فَدَتكَ جُدودُ",68,"د",1,0],["ولا قنا الأسباط حول يوشعا","أعفّ من قناهما وأخشعا",69,"ع",2,0],["وَلاقَيتُ العِدا وَحَفِظتُ قَوماً","أَضاعوني وَلَم يَرعَوا جَنابي",70,"ي",1,0],["ولاَقَيتُ لَذَّاتِ الفَتَى وأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",71,"د",1,0],["وَلا قراءَتكَ السوراتِ بَينَهُمُ","مُرَتَّلاتٍ بِإِظهارٍ وَإِدغامِ",72,"م",1,0],["وَلا قَطّ آذى مُسلِماً بِلِسانِهِ","وَلا بِيَدَيهِ بَل هُوَ اِحتَمَلَ الأَذى",73,"ذ",2,0],["وَلا قَولَها لِيَ إِذ أَيقَنَت","بِما قَد أُريدُ بِها أَستَقِر",74,"ر",1,0],["ولا قُضَاةً يَهَابُونَ الجُنَاة؛ فهم","يُغْصُون إن أزهقوا الأرواحَ أو نهبوا",75,"ب",3,0],["ولا قلب إلا خافق في شغافه","ولا طرف إلا من مهابتها ارتدا",76,"د",2,0],["وَ لأقتلنَّ حجاحجاً منْ بكركمْ","ولأَبْكِيَنَّ بِهَا جُفُونَ عُيُونِ",77,"ن",1,0],["ولا قوماً يَرُدُّون الدّواهي","وقد خَرِسَتْ بألسْنةٍ فِصاح",78,"ح",1,0],["ولا قائلٌ : اصبحتُ منكم ، وقد أرى","غوايَتكم او انني غير مهتدي",79,"د",2,0],["ولاقت على الزب الصغير حماتها","حمام المنايا إذ عماد عميدها",80,"د",3,0],["ولا قدّها غصن ولا خيزرانة","ولا خصرها غور ولا ردفها نجد",81,"د",1,0],["وَلاَقَيْنَ مِنْ أوْلاَدِ عُقْدَة َ عُصْبَة","ً عَلَى الْمَاءِ يَنْثُونَ الذُّحُولَ الْمَوَانِع",82,"ع",1,0],["ولا قربُ نعمٍ إن دنتْ لك نافعٌ،","وَلاَ نأْيُهَا يُسْلي وَلاَ أَنْتَ تَصْبِرُ",83,"ر",1,0],["وَلاقَيتُ لَذّاتِ الغِنى وَأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",84,"د",1,0],["ولا قَعيدٌ أعْضبٌ قرنُهُ","هَاجَ لَهُ مِنْ مَرْتَعٍ هَائِجُ",85,"ج",1,0]]}