/poem27791.html","الوافر"],[517,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[518,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[518,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[518,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[541,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[541,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[554,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[554,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[554,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[554,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[554,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[561,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[561,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[561,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[564,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[572,"رب أمور قد بريت لحاءها","https://www.aldiwan.net/poem52036.html","الطويل"],[590,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20473","الوافر"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10409","المتقارب"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21407","الطويل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2565","الوافر"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/19002","الوافر"]],"verses":[["ولا قر في نفسي سكون ولا اشتفى","بي الصدر من غيظي ولا خف واقد",0,"د",1,0],["وَلا قَرَعتُ مِن قُنوطٍ سِنّي","ياأَيُّها المَغرورُ لا تَهِجَّني",1,"ن",2,0],["وَلا قاطِعٌ بِالظَنِّ ما كُنتُ واصِلاً","وَرُبَّ مَغيظٍ قاطِعٍ بِالتَوَهُّمِ",2,"م",1,0],["وَلا قائِلٌ ما يَعلَمُ اللَهُ ضِدَّهُ","وَلَو نالَ مِن جِلدي قَناً وَنُصولُ",3,"ل",1,0],["وَلا قِرنَ إِلّا أَدمَعَ الطَعنُ نَحرَهُ","وَما غَسَلَتهُ بِالدُموعِ مَدامِعُه",4,"ع",2,1],["وَلا قَّبَضَت أَنامِلهُ","عَلى مالٍ زَواجِرُه",5,"ر",2,0],["وَلا قُلتُ إِنّي عِندَ الفَخا","رِ إِلّا لِغَيرِ أَبي أَحمَدِ",6,"د",1,0],["وَلا قُضُبُ الرِجالِ الصيدِ فَضلاً","عَنِ الأَصواتِ في حَليِ النِساءِ",7,"ا",2,0],["ولاقى رَئيسُ القَوْمِ عَمْرو بنُ جابِرٍ","طِعاناً يُنَسِّيهِ الهَدِيِّ المُقَلدا",8,"د",2,0],["ولا قَعيدٌ أَغَضَبٌ قَرنُهُ","هاجَ لَهُ مِن مَرتَعٍ هائِجُ",9,"ج",1,0],["وَلاَ قَرَّ قَلْبٌ فِي قَرَارِ ضُلُوعِهِ","وَلَمْ تَعْرِفِ الأَجْفَانُ مَا لذَّةُ الغَمْضِ",10,"ض",1,0],["ولا قلْبَ إلا خافِقٌ في شِغافِهِ","بِها وكَساها منْ نَسيجَتِهِ بُرْدا",11,"د",2,0],["وَلا قُلنا لَهُم نَفسٌ بِنَفسٍ","أَقيدونا بِها إِن لَم تَدوها",12,"و",3,0],["وَلا قامَ في أَيّامِكَ البيضِ ماجِدٌ","يُنازِعُكَ البابَ الَّذي كُنتَ تَقرَعُ",13,"ع",1,0],["وَلا قيلَ هَذا فَيلَسوفٌ مُوَفَّقٌ","وَلا قيلَ هَذا عالِمٌ وَخَبيرُ",14,"ر",1,0],["وَلا قَبلَ عَبّادٍ جَوى البَحرَ مَجلِسٌ","وَلا حَمَلَ الطَودَ المُعَظَّمَ رَفرَفُ",15,"ف",1,0],["وَلأَقِفْ للنَّدَى بِحَيْثُ أَرَادُوا","وَلَهُمْ مِنْ إِجَابَتِي مَا رَامُوا",16,"م",3,0],["وَلاقى القَينُ وَالنَخَباتُ غَمّاً","تَرى لوكوفِ عَبرَتِهِ اِنصِبابا",17,"ب",2,0],["وَلاقَيتَ خَيراً مِن أَبيكَ فَوارِساً","وَأَكرَمَ أَيّاماً سُحَيماً وَجَحدَرا",18,"ر",2,0],["وَلاقَيتَ مِنّا مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاِستَأخِرَن أَو تَقَدَّما",19,"م",2,0],["وَلاقَيتَ مِنّي مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاستَأخِرَن أَو تَقَدَّما",19,"م",2,0],["وَلاَقَينَا قُضَاعَةَ يَومَ كَلب","بِطَلحَةَ والكُماةِ مُقَنَّعِينَا",20,"ن",2,0],["ولا قهوةٌ أستغفر الله تجتلى","ومن عجبٍ أنْ قد حلا منه ما مرا",21,"ر",2,0],["ولأقلام صاحب السرّ والأنظ","ار والاحتجاب في الخافقين",22,"ن",1,0],["ولا قيدت عن مصر قافية الحيا","ولا عطّلت أبياتها من رويه",23,"ي",2,0],["ولا قسورٌ إن لم يجد ما يكُفُّهُ","من الصَّيدِ أضحى والسباعُ له لحَمْ",24,"م",1,0],["ولا قَعَدْتُمْ على ضَيْمٍ ولا ضَمَدٍ","لكنْ عفوتُمْ وفي أيديكُمُ النِّقَمُ",25,"م",1,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّاً","كَفَتهُ كُلَّ حازِيَةٍ وَراقي",26,"ق",2,0],["وَلاقى اِمرَأً لا يَنقُضُ القَومُ عَهدَهُ","أَمَرَّ القُوى دونَ الوُشاةِ فَأَحصَدا",27,"د",2,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّا","كَفَتهُ كُلَّ راقِيَةٍ وَحازي",28,"ز",2,0],["وَلا قُصوراً وَلا رِياضاً","وَلا جُنوداً وَلا إِماء",29,"ا",2,0],["وَلا قَدُّها غُصن وَلا خَيرَزانَةٌ","وَلا خَصرُها غَور وَلا رِدفُها نَجدُ",30,"د",1,0],["ولَأَقلامُك أمضى","من شبا رمح دُرَيْدِ",31,"د",1,0],["وَلاقَينَ مِن أَولادِ عُقدَةَ عُصبَةً","عَلى الماءِ يَنثونَ الذُحولَ المَوانِعا",32,"ع",2,0],["ولاقيت منهم كل خسف وجفوةٍ","فماذا عسى من بعد ذا أن أُلاقيا",33,"ي",2,0],["ولا قرقرت أوبربرت يوما","كما هيجت ديكا مالِطِيا",34,"ي",2,0],["وَلاقي العَبقَرِيّينَ","لِقاءَ النِدِّ لِلنِدِّ",35,"د",1,0],["وَلاقى دونَ ثايِهِمِ طِعاناً","يُلاقي عِندَهُ الذِئبَ الغُرابُ",36,"ب",1,0],["وَلا قَبضٌ عَلى البيضِ المَواضي","وَلا حَظٌّ مِنَ السُمرِ اللِدانِ",37,"ن",1,0],["ولا قرَّ لي بعدَ التفرُّقِ مضجعٌ","ولا طابَ لي بعدَ الرحيلِ مقامُ",38,"م",1,0],["وَلا قَبولي ما كُنتَ جُدتَ بِهِ","عَلَيَّ بِالأَمسِ خُلسَةَ الذيبِ",39,"ب",1,0],["وَلا قَمَرٌ إِلّا حُشاشَةُ غائِرِ","كَعَينِ طِماسٍ رَنَّقَت لِرُقادِ",40,"د",1,0],["وَلاقَت عَلى الزابِ الصَغيرِ حُماتُها","حِمامَ المَنايا إِذ عِمادٌ عَميدُها",41,"د",3,0],["وَلا قَصرَ بي عَن ضامِنٍ مُتَكَفِّلٍ","بَوائِقَ ما يَطوي الزَمانُ وَما يُبدي",42,"د",2,0],["وَلا قائِلٌ فيكَ إِلّا الجَمي","لَ وَإِن كانَ ما جِئتَ لا يَجمُلُ",43,"ل",1,0],["وَلاقَت مِنَ الحِرمازِ أَولادَ مِجشَإٍ","وَمِن مازِنٍ شَرِّ القَبائِلِ مَعشَرا",44,"ر",2,0],["وَلاقى شَديدَ الدَرءِ مُستَحصِدَ القِوى","تَفَرَّقُ بِالعِصيانِ عَنهُ عَواذِلُه",45,"ل",2,0],["وَلاقيهِ بِالتَرحيبِ وِالرَحرِ وَالقِرى","وَيَمّم لَهُ ما دُمتَ تَحتَ اِقتِدارِهِ",46,"ر",2,0],["وَلا قَلاني وَإِن كانَ المُسيءُ بِنا","إِلّا دَعَوتُ لَهُ الرَحمَنَ بِالرَشَدِ",47,"د",1,0],["وَلا قَلَّدَ الأَعناقَ مِن فَيضِ جودِهِ","قَلائِدَ بِرٍّ لا يَقومُ بِها الشُكرُ",48,"ر",1,0],["وَلا قيلَ يَوماً أَنَّهُ غَيرُ عالِمٍ","بِغَيرِ عُيوبِ الجارِ وَاللَومِ وَالجُبنِ",49,"ن",1,0],["وَلَأَقتُلُنَّ حَجاحِجاً مِن بَكرِكُم","وَلَأَبكِيَنَّ بِها جُفونَ عُيونِ",50,"ن",1,0],["ولاقِطٌ نظرةً عَجلى يكونُ بها","ليْ في الحياةِ وما ألقى بِها ، سَند",51,"د",1,0],["وَلا قُربُ نُعمٍ إِن دَنَت","وَلا نَأيُها يُسلي وَلا أَنتَ تَصبِرُ",52,"ر",1,0],["وَلا قَولُ واشٍ كاشِحٍ ذي عَداوَةٍ","وَلا بُعدُ دارٍ إِن نَأَيتِ وَلا قُربُ",53,"ب",1,0],["وَلا قِلتُ مِنهُ بَينَ ظِلٍّ لِعَطفَةٍ","تَنَدّى وَنورٍ لِلبَشاشَةِ مونِقِ",54,"ق",1,0],["وَلاقي بِمَأمولِ الرِضى مِنكِ مَوكِباً","تَوارَت لَهُ الجَوزاءُ وَاِستَحيَتِ الشِعرى",55,"ر",2,0],["وَلا قَرنٌ يُقَزَّزُ مِن طَعامٍ","وَلا نَصِبٌ وَلا مولى عَديمُ",56,"م",1,0],["وَلا قَولَها وَهناً وَقَد بَلَّ نَحرَها","سَوابِقُ دَمعٍ ما يَجِفُّ غَزَيرِ",57,"ر",1,0],["ولاقُوا المَوْتَ دُونَ حريمِ مِصْرٍ","وَصانُوا المَالَ مِنهُمْ وَالبَنِينا",58,"ن",2,0],["ولا قلّبت تلك السلاح أكفُّها","ولا وصلت تلك الأكفَّ الأنامل",59,"ل",1,0],["وَلا قَيسٌ أَخو لُبنى","وَلا عَمرٌ أَخو دَعدِ",60,"د",1,0],["وَلا قَطَعتُ عَلى حَرفٍ مُذَكَّرَةٍ","في مِرفَقَيها إِذا اِستَعرَضتَها فَتَلُ",61,"ل",1,0],["وَلا قَصَّرَت لي أُمُّ لَيلى بِشُربِها","حَنادِسَ أَوقاتٍ عَلَيَّ طِيالِ",62,"ل",1,0],["وَلاقَيتَ عِندي الخَيرَ تَحسَبُ عَيِّلاً","يُنافيكَ قَولٌ سَيِّئٌ وَشَتائِمُ",63,"م",1,0],["وَلا قُصورٌ لَها مُشَيَّدَةٌ","قَد مُوِّهَت عَسجَداً رَواشِنُها",64,"ن",3,0],["وَلاقَتبي عَلى العَودِ المُزَجّى","وَلا سَرجي عَلى الفَرَسِ الأَدَنِّ",65,"ن",1,0],["ولا قَلِقاتُ اللّيلِ باتَت كأنّها","من الأينِ والإدلاجِ بعضُ القنا اللُّدنِ",66,"ن",1,0],["ولاقَى دُوَيْنَ الوِرْدِ كلَّ مُغَيَّبٍ","عنِ الرّشْدِ يَقْتادُ الخَنا بزِمامهِ",67,"م",2,0],["وَلاَقاَهُ مِنّا فَارِسٌ غيرُ جَيدَرٍ","فَأَكرَهَ فِيهِ الرُمحَ حَتّى تَفَطَّرا",68,"ر",2,0],["ولا قبلَها قبل ولا بَعْدَ بَعْدَهَا","وقَبْليُّة الأبْعادِ فهْي لها حَتْم",69,"م",1,0],["ولاَ قَرْوَ إِلاَّ قَرْوَ رَيِّقِهِ ضُحىً","بِعَبْسٍ ونَجَّتْ طَيْرُهُ حِينَ أَسْفَرَا",70,"ر",2,0],["وَلا قَولَها لَولا العُيونُ الَّتي تَرى","لَزُرتُكَ فَاِعذُرني فَدَتكَ جُدودُ",71,"د",1,0],["ولا قنا الأسباط حول يوشعا","أعفّ من قناهما وأخشعا",72,"ع",2,0],["وَلاقَيتُ العِدا وَحَفِظتُ قَوماً","أَضاعوني وَلَم يَرعَوا جَنابي",73,"ب",2,0],["ولاَقَيتُ لَذَّاتِ الفَتَى وأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",74,"د",1,0],["وَلا قراءَتكَ السوراتِ بَينَهُمُ","مُرَتَّلاتٍ بِإِظهارٍ وَإِدغامِ",75,"م",1,0],["وَلا قَطّ آذى مُسلِماً بِلِسانِهِ","وَلا بِيَدَيهِ بَل هُوَ اِحتَمَلَ الأَذى",76,"ذ",2,0],["وَلا قَولَها لِيَ إِذ أَيقَنَت","بِما قَد أُريدُ بِها أَستَقِر",77,"ر",1,0],["ولا قُضَاةً يَهَابُونَ الجُنَاة؛ فهم","يُغْصُون إن أزهقوا الأرواحَ أو نهبوا",78,"ب",3,0],["ولا قلب إلا خافق في شغافه","ولا طرف إلا من مهابتها ارتدا",79,"د",2,0],["ولا قوماً يَرُدُّون الدّواهي","وقد خَرِسَتْ بألسْنةٍ فِصاح",80,"ح",1,0],["ولا قائلٌ : اصبحتُ منكم ، وقد أرى","غوايَتكم او انني غير مهتدي",81,"د",2,0],["ولاقت على الزب الصغير حماتها","حمام المنايا إذ عماد عميدها",82,"د",3,0],["ولا قدّها غصن ولا خيزرانة","ولا خصرها غور ولا ردفها نجد",83,"د",1,0],["وَلاَقَيْنَ مِنْ أوْلاَدِ عُقْدَة َ عُصْبَة","ً عَلَى الْمَاءِ يَنْثُونَ الذُّحُولَ الْمَوَانِع",84,"ع",1,0],["ولا قدرت تصطاد عندك لحظة","وقد طفقت للغافلين تصيد",85,"د",1,0],["ولا قربُ نعمٍ إن دنتْ لك نافعٌ،","وَلاَ نأْيُهَا يُسْلي وَلاَ أَنْتَ تَصْبِرُ",86,"ر",1,0],["وَلاقَيتُ لَذّاتِ الغِنى وَأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",87,"د",1,0],["ولا قَعيدٌ أعْضبٌ قرنُهُ","هَاجَ لَهُ مِنْ مَرْتَعٍ هَائِجُ",88,"ج",1,0],["ولا قطعت قريباً لي لذلته","ولا وصلت غريباً خيفة",89,"ه",1,0],["ولا قضاة ولا أحكام أسلمها","برداً على العدل آتون من النار",90,"ر",1,0],["ولاقَيْتَها شَهْباءَ تَخْطرُ بالقَنا","وسَعْيَةُ يُدْعَى وسطها والسَّمَوَّلُ",91,"ل",1,0],["ولا قاطعاً شخصاً له وهو واصلٌ","ولا واصلٌ شخصاً له وهو قاطعُ",92,"ع",1,0],["ولاقت مثلها الصعدات حتى","تكسرت النصالُ على النصالِ",93,"ل",1,0],["ولا قوس السحاب إذا تجلّى","ولا الأقمار في كبدِ السماءِ",94,"ا",2,0],["وَلا قادَني سَمعي وَلا بَصَري لَها","وَلا دَلَّني رَايي عَلَيها وَلا عَقلي",95,"ل",2,0],["ولا قيتَ ربَّ التاج يرفعُ حُجْبَهَ","ويطردُ ما ناجيته التيهَ والكِبرا",96,"ر",2,0],["ولاقت به الفُرسُ أمَّ اللُّهَي","م وأْدَ البناتِ وذبحَ البنينا",97,"ن",2,0],["وَلاقى الأُلوفَ غَيرَ مُكتَرِثٍ بِها","هُمامٌ أَجابَ المَوتَ أَوَّلَ ما دَعا",98,"ع",2,0],["وَلاقَت طَيِّئٌ ضَرباً دِراكاً","أَطارَ طُلىً وَأَذرِعَةً وَسوقا",99,"ق",2,0],["ولاقى هوانا مثله لم يلاقه","وهسفا وخسفا موجعا ومغارما",100,"م",2,0],["ولأقدمن على التناول كلما","أعطيتني ولو ان عقلي يذهب",101,"ب",1,0],["ولا قال جهلا للولاية منصب","يقصر عنها للنبوة منصب",102,"ب",1,0],["ولا قومه تحمى الفصوص وكفرها","لدى الملك من إلقائها في التنانر",103,"ر",1,0],["ولا قظت الشربة كل يوم","أعدى من مياههم الذبابا",104,"ب",2,0],["وَلا قائِلٍ لِلدَّهرِ رِفقاً وَقَد طَمَت","أَواذِيُّهُ شَرّاً وَجاشَت غَوارِبُهْ",105,"ب",2,0],["وَلاقَيتُ في أَبناءِ عَمّي وَمعشري","ذآليلَ لا يَرقى إِلَيها المُجالِحُ",106,"ح",1,0],["وَلاقَيتُ مِن جَرّائِكُم ما عَلِمتَهُ","وَهَل أَحَدٌ مِن سائِرِ الناسِ جاهِلُه",107,"ل",2,0],["وَلاقى الرَعايا خافِضاً مِن جَناحِهِ","وَفي بُردِهِ لَيثٌ بِخفّانَ مُشبِلُ",108,"ل",1,0],["وَلاقى الرَعايا خافِضاً مِن جَناحِهِ","وَفي بُردَتَيهِ هَيبَةٌ وَجَلالُ",109,"ل",1,0],["وَلا قابِضٍ فَضلَ الغِنى عَن فَقيرِها","وَلا باسِطٍ كَفّاً لَها حينَ أُعدِمُ",110,"م",1,0],["وَلا قَضيب النَقا تَذوي مَعاطفه","في قَفرة بِمياه الدَمع تَزدَهر",111,"ر",1,0],["ولأَقْنَعَنَّ من المُنَى بخيالهِ","زُورا يُمَنِّينى بخُلْفِ عُداته",112,"ت",2,0],["ولا قلت اذ كانوا نجوما طوالعا","وغابوا بان الارض تختص بالشهب",113,"ب",1,0],["ولا قلت ان الارض حين ثوى بها","تغيب بها الشمس المنيرة والبدر",114,"ر",1,0],["ولا قلت ان البحر يحمل سائرا","لى ظهر لوح او يحيط به قبر",114,"ر",1,0],["ولاقاها بِصَدرٍ راضَ صَبراً","وَلاقَتهُ بِصَدرٍ ضاقَ صَبرا",115,"ر",2,0],["ولأقعدن على الطريق فاشتكي","في زي مظلوم وأنت ظلمتني",116,"ن",2,0],["ولا قَنِعتُ بزور الْوَعْدِ من رَشَإٍ","دون التّعانُقِ والتَّجميش والقُبَلِ",117,"ل",1,0],["ولاقى الأذى من قومه فهو صابر","ومرّ إلى ذات النخيل يُفيض",118,"ض",1,0],["وَلاقَينَ جبّارَ بنَ حمزةَ بعدَما","أَطابَ بشَكٍّ أَيَّ أَمرَيهِ أَفعَلُ",119,"ل",1,0],["ولا قصرت أيام من كنت فرعه","ولا انقض يوماً في الزمان جداره",120,"ر",2,0],["ولاقِ الصُّبحَ مُنبلِجاً","وشمَّ الزَّهرَ مُنفتِحا",121,"ح",2,0],["ولا قدرةٌ بعد الشتاتِ على العدى","بغيرِ اتحادٍ فيهِ توحيدُ غاية",122,"ه",1,0],["وَلا قَيْس حُب أَو مَفاخِر دارِم","وَلا قَس لب قَطُّ أَو طَرفة العَبدِ",123,"د",1,0],["وَلاقَتْ علَى حُكْمِ السَّعَادَةِ بُرْدَها","ومَا بَرِحَتْ أثْنَاءَ شِقْوَتِهَا رَهْصا",124,"ص",2,0],["وَلاقَيتُ لِلأَعلاقِ أجْود مانِحٍ","يَميناً وَللأغْلاق أسْعدَ فاتِح",125,"ح",1,0],["وَلا قيدَتِ الخَيلُ العِتاقُ شَوازِباً","وَلا هُزَّ رُمحٌ في أَنامِلِ هَزّازِ",126,"ز",1,0],["وَلا قَرقَفٌ صَهباءُ صِرفٌ مُحيلَةٌ","يَفُضُّ زُكامَ المِنخَرَينِ عَتيقُها",127,"ق",3,0],["ولاقِهم بالبِشرِ","وحيِّهم بالشُكرِ",128,"ر",1,0],["ولأقبضن عنان قولي ها هنا","حسى وفي تعدادهم لم أطمع",129,"ع",1,0],["ولا قصر الا زناد عن نيل قصدها","سوى ضجر عجز تكاسل جثمان",130,"ن",1,0],["وَلاقيتُ برّاً قَد طَمى برّ بحره","فَجابَت لَه آمالُنا البرّ والبحرا",131,"ر",2,0],["ولا قاطع للناس نهج سبيلهم","ولا مفسد في الارض في كل وجهة",132,"ه",1,0],["وَلا قِرى لِنَزيلٍ دونَ قَريَتِهِ","وَلا هُدىً لِسَبيلٍ دونَ كَوكَبِهِ",133,"ب",2,0],["ولاقَيتَ مِن دُونِ الأَمَانِي خَلِيفَةً","بدِيهَتُه وَحيٌ وَعَزمَتُهُ لَمحُ",134,"ح",1,0],["ولاقيتَني فرداً فلاقيتَ ماجداً","وأنتَ حَسيرٌ في الوَثَاقِ أَسيرُ",135,"ر",1,0],["وَلا قُلتُ لِلأَعداءِ إِنّي سَحَرتُهُم","وَهَذا ثَنئي ثُمَّ ما هاجَهُم سِحري",136,"ر",2,0],["وَلا قُلتُ مَطروداً بِعامِ مَجاعَةٍ","وَلَكِن طَريدٌ مِن سُيولِ غَمامِ",137,"م",1,0],["ولا قال لا أرضى تعاليم بُطرسٍ","وما جاءنا بالبينات رسول",138,"ل",1,0],["ولا قال إني خائفٌ عند طاعتي","وفي الناس منهم قاتلٌ وقتيل",138,"ل",1,0],["ولاقيت كل العارفين بسفحها","وكل كريم ساكن برباها",139,"ا",3,0],["ولاقى به قوماً من الرسل كلها","يقول له يا مرحباً حين سلما",140,"م",2,0],["ولا قطعة اقتطعتها أو ولاية","كما هو دأب الناس في كل مورد",141,"د",1,0],["ولاقيت هابيلاً قتيل شقيقه","يواريه لما أن رآه غراب",142,"ب",1,0],["وَلأقتُلَنَّ العُدمَ قتلةَ ثائِرٍ","بِالجودِ من نَفحاتِ كَفِّ حُسَينِ",143,"ن",1,0],["وَلأَقضينَّ الدَهرَ غيرُ مُقَصِّرٍ","ما كانَ أَسلَفَنيه مِن أَحقادِهِ",144,"د",2,0],["ولاقيت صعب المرتقى غير ناكص","وأصعب ما ألقى رئاسة ناقص",145,"ص",1,0],["ولاقاهم وهل يخشى لقاهم","فتىً ألقى على اللَه اتكالا",146,"ل",2,0],["ولا قام يبغي نصرة الحق قائم","من الناس لولا سيف عزمك والجد",147,"د",1,0],["ولاقَيْتُمُ البيضَ والسُّمْرَ عَنَّا","ونحنُ بِعَقْوَتِكُمْ آمِنُونا",148,"ن",2,0],["ولاقى وْجوهَ الراغبينَ كأنَّما","أمانِيُّهُم يُصْبِحَنَ مْنهُ عَلَى وعْدِ",149,"د",1,0],["ولاقاكَ فاسْتَخْذى لديكَ تذلُّلاً","ليحتازَ من أدنى رضاكَ تَرَحُّما",150,"م",2,0],["ولا قَدَمٌ لا تَسْأَمُ الدَّهْرَ تَرْتَقِي","ذُرى كُلِّ صَعْبِ المُرْتَقَاةِ مُنِيفِها",151,"ف",3,0],["وَلا قَنَطٌ واليُسرُ لِلعُسرِ غالِبٌ","وَفِي العرْشِ رَبٌّ بالخَلائِقِ رَحْمانُ",152,"ن",1,0],["ولاق ضيفك طلق الوجه مبتسماً","ولو تعبَّس وجه الدهر مكتلحا",153,"ح",2,0],["ولاقى بعد ما لاقى المعادا","عتاد الباقيات الصالحات",154,"ت",1,0],["ولا قلب مذسار الموادع وادع","ولا عيش مذ طال التفرق طائل",155,"ل",1,0],["ولا قَرَنتُ حبَّه صبابةً","لا يطمع العاذلُ في سلوانِها",156,"ن",3,0],["ولا قامت الدنيا بسيرةِ عادلٍ","يُهابُ ولم يُنصَرْ لربّك دينُ",157,"ن",1,0],["ولا قدَرت على نفسي ولحظي","على ما نَمَّ من طيبٍ وحُسنِ",158,"ن",1,0],["ولا قسموا لها الإنصاف يوما","بكيلٍ في السماح ولا بوزنِ",158,"ن",1,0],["ولا قصير الإزار إن جذبَ ال","جدبُ بأذيال خائِض القُحَمِ",159,"م",1,0],["ولا قلّص الملكُ عاداتهِ","معي وهو في ثوبه رافلُ",160,"ل",1,0],["ولا قَرَى صَبابةً فؤادَه","إلا السلوَّ حاضراً والجَلَدا",161,"د",2,0],["ولا قَضَى اللّهُ على سيِّد","قضاءَهُ إلا اجتبَى سيِّدا",162,"د",2,0],["ولاقاه من الأيام يوم","كما من قبل لم يخلد قدار",163,"ر",1,0],["وَلا قَرَأتُ كِتاباً مِنكِ يَبلُغُني","إِلّا تَنَفَّستُ مِن وَجدٍ بِكُم صُعَدا",164,"د",2,0],["ولا قطفوا باللثمِ وردةَ خَدَّها","ولا هصروا في ثِني أبرادِها الغصنا",165,"ن",2,0],["ولاقى على الأوطان أهوال عاشق","عرته أهاويل على الطي والنشر",166,"ر",1,0],["ولا قفرة إلا وأمسيت صِلَّها","ولا حَضَرٌ إلا وظلْتُ له وَفْدا",167,"د",2,0],["ولا قيَّدْتُ ذاتي في نِطاقٍ","يُميلُ بها شُهودي عن رُبَاكِ",168,"ك",1,0],["ولا قِستُ السّما حين انتصرتُ","ولا شئتُ البكا حين هُزمتُ",169,"ت",1,0],["ولا قنَصَتْ أختُ الغَزالِ جوارِحي","ولا هيّجَتْ وُرْقُ الحَمامِ بَلابِلي",170,"ل",2,0],["ولا قدس الدهر فلولا جوره","لم يتحكم عاجز في قادر",171,"ر",1,0],["ولا قسمت ألحاظه بين مخلص","جميل السجايا أو عدو يجامله",172,"ل",2,0],["ولا قام في المحراب والحرب عاملاً","من البأس والإحسان ما الله قابله",172,"ل",2,0],["ولا قدم الشهر المحرم قبل ما","عداه سوى تقديمكم للمحرم",173,"م",1,0],["ولاقيتَ من عزٍّ منيعٍ وحُظوة","ورِفعَةِ جاهٍ وابتِسامِ ثُغورِ",174,"ر",1,0],["ولاقاك عن شَوق رجالُ حكومةٍ","تُبادِلك الودَّ الذي يَتجدَّدُ",175,"د",1,0],["وَلا قُذيتُ بعوراءٍ لَهُ مَرَقَتْ","سرّاً ودافع عنها النّاسُ إعلانا",176,"ن",2,0],["ولا قومٌ لَهمْ في قل","لَةِ العلياءِ بُنيانُ",177,"ن",1,0],["وَلا قلبَ إلّا وهو منك مُكلَّمٌ","وَلا لُبَّ إلّا وهو فيك مُذَهَّلُ",178,"ل",1,0],["وَلا قيّضَ اللّهُ التفرّقَ عنكمُ","ولا عَنَّ نأْيٌ بيننا وتصدُّعُ",179,"ع",1,0],["وَلا قُرّبتَ من جَدْبٍ","ولا بوعدتَ من خِصْبِ",180,"ب",1,0],["ولا قومي أرى قومي","ولا أهلي أرى أهلي",181,"ل",2,0],["ولأقلام التجلي","سمعت أذني صريفا",182,"ف",2,0],["ولا قائم إلا بها في وجوده","ولا صانع إلا بها هو صانع",183,"ع",1,0],["وَلا قَضِيّاً بِالقضَاءِ المُتَّهَم","في أُمَّةٍ سُوِّسَها بَعدَ أُمَم",184,"م",1,0],["ولا قاذِفٌ نَفسي وَنَفسي بريئة","وَكَيفَ اعتذاري بعد ما قد قذفتها",185,"ت",3,0],["ولا قبلها كانت عليهم فجائع","ولا سامهم من قبلها ذل سائم",186,"م",1,0],["وَلاقَيتُ الخُيورَ وَأَخطَأَتني","شُرورٌ جَمَّةٌ وَعَلَوتُ قِرني",187,"ن",2,0],["وَلاقى الشَقاءَ لَدى حَربِنا","دُحَيٌّ وَعَوفٌ وَإِخوانُها",188,"ن",3,0],["وَلا قُرزُلاً وَسطَ الرِجالِ جُنادِفاً","إِذا ما مَشى أَو قالَ قَولاً تَبَلتَعا",189,"ع",2,0],["وَلاقَينا بِأَبطَحِ ذي زَرودٍ","بَني شَيبانَ فَاِلتُهِموا اِلتِهاما",190,"م",2,0],["وَلاقَينا بِذي نَجَبٍ حُصَيناً","فَأَهلَكنا بِمُقلَتِنا أُساما",190,"م",2,0],["وَلاقي مِن نُفاثَةَ كُلَّ خِرقٍ","أَشَمَّ سَمَيدَعٍ مِثلِ الهِلالِ",191,"ل",1,0]]}