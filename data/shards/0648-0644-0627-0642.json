دي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[515,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[538,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[538,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[551,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[551,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[551,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[551,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[551,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[558,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[558,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[561,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[569,"رب أمور قد بريت لحاءها","https://www.aldiwan.net/poem52036.html","الطويل"],[587,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["وَلا قَرَعتُ مِن قُنوطٍ سِنّي","ياأَيُّها المَغرورُ لا تَهِجَّني",0,"ي",1,0],["وَلا قاطِعٌ بِالظَنِّ ما كُنتُ واصِلاً","وَرُبَّ مَغيظٍ قاطِعٍ بِالتَوَهُّمِ",1,"م",1,0],["وَلا قائِلٌ ما يَعلَمُ اللَهُ ضِدَّهُ","وَلَو نالَ مِن جِلدي قَناً وَنُصولُ",2,"ل",1,0],["وَلا قِرنَ إِلّا أَدمَعَ الطَعنُ نَحرَهُ","وَما غَسَلَتهُ بِالدُموعِ مَدامِعُه",3,"ع",2,1],["وَلا قَّبَضَت أَنامِلهُ","عَلى مالٍ زَواجِرُه",4,"ر",2,0],["وَلا قُلتُ إِنّي عِندَ الفَخا","رِ إِلّا لِغَيرِ أَبي أَحمَدِ",5,"د",1,0],["وَلا قُضُبُ الرِجالِ الصيدِ فَضلاً","عَنِ الأَصواتِ في حَليِ النِساءِ",6,"ا",2,0],["ولاقى رَئيسُ القَوْمِ عَمْرو بنُ جابِرٍ","طِعاناً يُنَسِّيهِ الهَدِيِّ المُقَلدا",7,"د",2,0],["ولا قَعيدٌ أَغَضَبٌ قَرنُهُ","هاجَ لَهُ مِن مَرتَعٍ هائِجُ",8,"ج",1,0],["وَلاَ قَرَّ قَلْبٌ فِي قَرَارِ ضُلُوعِهِ","وَلَمْ تَعْرِفِ الأَجْفَانُ مَا لذَّةُ الغَمْضِ",9,"ض",1,0],["ولا قلْبَ إلا خافِقٌ في شِغافِهِ","بِها وكَساها منْ نَسيجَتِهِ بُرْدا",10,"د",2,0],["وَلا قُلنا لَهُم نَفسٌ بِنَفسٍ","أَقيدونا بِها إِن لَم تَدوها",11,"و",3,0],["وَلا قامَ في أَيّامِكَ البيضِ ماجِدٌ","يُنازِعُكَ البابَ الَّذي كُنتَ تَقرَعُ",12,"ع",1,0],["وَلا قيلَ هَذا فَيلَسوفٌ مُوَفَّقٌ","وَلا قيلَ هَذا عالِمٌ وَخَبيرُ",13,"ر",1,0],["وَلا قَبلَ عَبّادٍ جَوى البَحرَ مَجلِسٌ","وَلا حَمَلَ الطَودَ المُعَظَّمَ رَفرَفُ",14,"ف",1,0],["وَلأَقِفْ للنَّدَى بِحَيْثُ أَرَادُوا","وَلَهُمْ مِنْ إِجَابَتِي مَا رَامُوا",15,"م",3,0],["وَلاقى القَينُ وَالنَخَباتُ غَمّاً","تَرى لوكوفِ عَبرَتِهِ اِنصِبابا",16,"ب",2,0],["وَلاقَيتَ خَيراً مِن أَبيكَ فَوارِساً","وَأَكرَمَ أَيّاماً سُحَيماً وَجَحدَرا",17,"ر",2,0],["وَلاقَيتَ مِنّا مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاِستَأخِرَن أَو تَقَدَّما",18,"م",2,0],["وَلاقَيتَ مِنّي مِثلَ غايَةِ داحِسٍ","وَمَوقِفِهِ فَاستَأخِرَن أَو تَقَدَّما",18,"م",2,0],["وَلاَقَينَا قُضَاعَةَ يَومَ كَلب","بِطَلحَةَ والكُماةِ مُقَنَّعِينَا",19,"ن",2,0],["ولا قهوةٌ أستغفر الله تجتلى","ومن عجبٍ أنْ قد حلا منه ما مرا",20,"ر",2,0],["ولأقلام صاحب السرّ والأنظ","ار والاحتجاب في الخافقين",21,"ن",1,0],["ولا قيدت عن مصر قافية الحيا","ولا عطّلت أبياتها من رويه",22,"ي",2,0],["ولا قسورٌ إن لم يجد ما يكُفُّهُ","من الصَّيدِ أضحى والسباعُ له لحَمْ",23,"م",1,0],["ولا قَعَدْتُمْ على ضَيْمٍ ولا ضَمَدٍ","لكنْ عفوتُمْ وفي أيديكُمُ النِّقَمُ",24,"م",1,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّاً","كَفَتهُ كُلَّ حازِيَةٍ وَراقي",25,"ي",1,0],["وَلاقى اِمرَأً لا يَنقُضُ القَومُ عَهدَهُ","أَمَرَّ القُوى دونَ الوُشاةِ فَأَحصَدا",26,"د",2,0],["وَلاقى اِبنُ الحُبابِ لَنا حُمَيّا","كَفَتهُ كُلَّ راقِيَةٍ وَحازي",27,"ي",1,0],["وَلا قُصوراً وَلا رِياضاً","وَلا جُنوداً وَلا إِماء",28,"ا",2,0],["وَلا قَدُّها غُصن وَلا خَيرَزانَةٌ","وَلا خَصرُها غَور وَلا رِدفُها نَجدُ",29,"د",1,0],["ولَأَقلامُك أمضى","من شبا رمح دُرَيْدِ",30,"د",1,0],["وَلاقَينَ مِن أَولادِ عُقدَةَ عُصبَةً","عَلى الماءِ يَنثونَ الذُحولَ المَوانِعا",31,"ع",2,0],["ولاقيت منهم كل خسف وجفوةٍ","فماذا عسى من بعد ذا أن أُلاقيا",32,"ي",2,0],["ولا قرقرت أوبربرت يوما","كما هيجت ديكا مالِطِيا",33,"ي",2,0],["وَلاقي العَبقَرِيّينَ","لِقاءَ النِدِّ لِلنِدِّ",34,"د",1,0],["وَلاقى دونَ ثايِهِمِ طِعاناً","يُلاقي عِندَهُ الذِئبَ الغُرابُ",35,"ب",1,0],["وَلا قَبضٌ عَلى البيضِ المَواضي","وَلا حَظٌّ مِنَ السُمرِ اللِدانِ",36,"ن",1,0],["ولا قرَّ لي بعدَ التفرُّقِ مضجعٌ","ولا طابَ لي بعدَ الرحيلِ مقامُ",37,"م",1,0],["وَلا قَبولي ما كُنتَ جُدتَ بِهِ","عَلَيَّ بِالأَمسِ خُلسَةَ الذيبِ",38,"ب",1,0],["وَلا قَمَرٌ إِلّا حُشاشَةُ غائِرِ","كَعَينِ طِماسٍ رَنَّقَت لِرُقادِ",39,"د",1,0],["وَلاقَت عَلى الزابِ الصَغيرِ حُماتُها","حِمامَ المَنايا إِذ عِمادٌ عَميدُها",40,"د",3,0],["وَلا قَصرَ بي عَن ضامِنٍ مُتَكَفِّلٍ","بَوائِقَ ما يَطوي الزَمانُ وَما يُبدي",41,"ي",1,0],["وَلا قائِلٌ فيكَ إِلّا الجَمي","لَ وَإِن كانَ ما جِئتَ لا يَجمُلُ",42,"ل",1,0],["وَلاقَت مِنَ الحِرمازِ أَولادَ مِجشَإٍ","وَمِن مازِنٍ شَرِّ القَبائِلِ مَعشَرا",43,"ر",2,0],["وَلاقى شَديدَ الدَرءِ مُستَحصِدَ القِوى","تَفَرَّقُ بِالعِصيانِ عَنهُ عَواذِلُه",44,"ل",2,0],["وَلاقيهِ بِالتَرحيبِ وِالرَحرِ وَالقِرى","وَيَمّم لَهُ ما دُمتَ تَحتَ اِقتِدارِهِ",45,"ر",2,0],["وَلا قَلاني وَإِن كانَ المُسيءُ بِنا","إِلّا دَعَوتُ لَهُ الرَحمَنَ بِالرَشَدِ",46,"د",1,0],["وَلا قَلَّدَ الأَعناقَ مِن فَيضِ جودِهِ","قَلائِدَ بِرٍّ لا يَقومُ بِها الشُكرُ",47,"ر",1,0],["وَلا قيلَ يَوماً أَنَّهُ غَيرُ عالِمٍ","بِغَيرِ عُيوبِ الجارِ وَاللَومِ وَالجُبنِ",48,"ن",1,0],["ولاقِطٌ نظرةً عَجلى يكونُ بها","ليْ في الحياةِ وما ألقى بِها ، سَند",49,"د",1,0],["وَلا قُربُ نُعمٍ إِن دَنَت","وَلا نَأيُها يُسلي وَلا أَنتَ تَصبِرُ",50,"ر",1,0],["وَلا قَولُ واشٍ كاشِحٍ ذي عَداوَةٍ","وَلا بُعدُ دارٍ إِن نَأَيتِ وَلا قُربُ",51,"ب",1,0],["وَلا قِلتُ مِنهُ بَينَ ظِلٍّ لِعَطفَةٍ","تَنَدّى وَنورٍ لِلبَشاشَةِ مونِقِ",52,"ق",1,0],["وَلاقي بِمَأمولِ الرِضى مِنكِ مَوكِباً","تَوارَت لَهُ الجَوزاءُ وَاِستَحيَتِ الشِعرى",53,"ر",2,0],["وَلا قَرنٌ يُقَزَّزُ مِن طَعامٍ","وَلا نَصِبٌ وَلا مولى عَديمُ",54,"م",1,0],["وَلا قَولَها وَهناً وَقَد بَلَّ نَحرَها","سَوابِقُ دَمعٍ ما يَجِفُّ غَزَيرِ",55,"ر",1,0],["ولاقُوا المَوْتَ دُونَ حريمِ مِصْرٍ","وَصانُوا المَالَ مِنهُمْ وَالبَنِينا",56,"ن",2,0],["ولا قلّبت تلك السلاح أكفُّها","ولا وصلت تلك الأكفَّ الأنامل",57,"ل",1,0],["وَلا قَيسٌ أَخو لُبنى","وَلا عَمرٌ أَخو دَعدِ",58,"د",1,0],["وَلا قَطَعتُ عَلى حَرفٍ مُذَكَّرَةٍ","في مِرفَقَيها إِذا اِستَعرَضتَها فَتَلُ",59,"ل",1,0],["وَلا قَصَّرَت لي أُمُّ لَيلى بِشُربِها","حَنادِسَ أَوقاتٍ عَلَيَّ طِيالِ",60,"ل",1,0],["وَلاقَيتَ عِندي الخَيرَ تَحسَبُ عَيِّلاً","يُنافيكَ قَولٌ سَيِّئٌ وَشَتائِمُ",61,"م",1,0],["وَلا قُصورٌ لَها مُشَيَّدَةٌ","قَد مُوِّهَت عَسجَداً رَواشِنُها",62,"ن",3,0],["وَلاقَتبي عَلى العَودِ المُزَجّى","وَلا سَرجي عَلى الفَرَسِ الأَدَنِّ",63,"ن",1,0],["ولا قَلِقاتُ اللّيلِ باتَت كأنّها","من الأينِ والإدلاجِ بعضُ القنا اللُّدنِ",64,"ن",1,0],["ولاقَى دُوَيْنَ الوِرْدِ كلَّ مُغَيَّبٍ","عنِ الرّشْدِ يَقْتادُ الخَنا بزِمامهِ",65,"م",2,0],["وَلاَقاَهُ مِنّا فَارِسٌ غيرُ جَيدَرٍ","فَأَكرَهَ فِيهِ الرُمحَ حَتّى تَفَطَّرا",66,"ر",2,0],["ولا قبلَها قبل ولا بَعْدَ بَعْدَهَا","وقَبْليُّة الأبْعادِ فهْي لها حَتْم",67,"م",1,0],["وَلا قَولَها لَولا العُيونُ الَّتي تَرى","لَزُرتُكَ فَاِعذُرني فَدَتكَ جُدودُ",68,"د",1,0],["ولا قنا الأسباط حول يوشعا","أعفّ من قناهما وأخشعا",69,"ع",2,0],["وَلاقَيتُ العِدا وَحَفِظتُ قَوماً","أَضاعوني وَلَم يَرعَوا جَنابي",70,"ي",1,0],["ولاَقَيتُ لَذَّاتِ الفَتَى وأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",71,"د",1,0],["وَلا قراءَتكَ السوراتِ بَينَهُمُ","مُرَتَّلاتٍ بِإِظهارٍ وَإِدغامِ",72,"م",1,0],["وَلا قَطّ آذى مُسلِماً بِلِسانِهِ","وَلا بِيَدَيهِ بَل هُوَ اِحتَمَلَ الأَذى",73,"ذ",2,0],["وَلا قَولَها لِيَ إِذ أَيقَنَت","بِما قَد أُريدُ بِها أَستَقِر",74,"ر",1,0],["ولا قُضَاةً يَهَابُونَ الجُنَاة؛ فهم","يُغْصُون إن أزهقوا الأرواحَ أو نهبوا",75,"ب",3,0],["ولا قلب إلا خافق في شغافه","ولا طرف إلا من مهابتها ارتدا",76,"د",2,0],["وَ لأقتلنَّ حجاحجاً منْ بكركمْ","ولأَبْكِيَنَّ بِهَا جُفُونَ عُيُونِ",77,"ن",1,0],["ولا قوماً يَرُدُّون الدّواهي","وقد خَرِسَتْ بألسْنةٍ فِصاح",78,"ح",1,0],["ولا قائلٌ : اصبحتُ منكم ، وقد أرى","غوايَتكم او انني غير مهتدي",79,"د",2,0],["ولاقت على الزب الصغير حماتها","حمام المنايا إذ عماد عميدها",80,"د",3,0],["ولا قدّها غصن ولا خيزرانة","ولا خصرها غور ولا ردفها نجد",81,"د",1,0],["وَلاَقَيْنَ مِنْ أوْلاَدِ عُقْدَة َ عُصْبَة","ً عَلَى الْمَاءِ يَنْثُونَ الذُّحُولَ الْمَوَانِع",82,"ع",1,0],["ولا قربُ نعمٍ إن دنتْ لك نافعٌ،","وَلاَ نأْيُهَا يُسْلي وَلاَ أَنْتَ تَصْبِرُ",83,"ر",1,0],["وَلاقَيتُ لَذّاتِ الغِنى وَأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ",84,"د",1,0],["ولا قَعيدٌ أعْضبٌ قرنُهُ","هَاجَ لَهُ مِنْ مَرْتَعٍ هَائِجُ",85,"ج",1,0],["ولا قطعت قريباً لي لذلته","ولا وصلت غريباً خيفة",86,"ه",1,0],["ولا قضاة ولا أحكام أسلمها","برداً على العدل آتون من النار",87,"ر",1,0],["ولاقَيْتَها شَهْباءَ تَخْطرُ بالقَنا","وسَعْيَةُ يُدْعَى وسطها والسَّمَوَّلُ",88,"ل",1,0],["ولا قاطعاً شخصاً له وهو واصلٌ","ولا واصلٌ شخصاً له وهو قاطعُ",89,"ع",1,0],["ولاقت مثلها الصعدات حتى","تكسرت النصالُ على النصالِ",90,"ل",1,0],["ولا قوس السحاب إذا تجلّى","ولا الأقمار في كبدِ السماءِ",91,"ا",2,0],["وَلا قادَني سَمعي وَلا بَصَري لَها","وَلا دَلَّني رَايي عَلَيها وَلا عَقلي",92,"ل",2,0],["ولا قيتَ ربَّ التاج يرفعُ حُجْبَهَ","ويطردُ ما ناجيته التيهَ والكِبرا",93,"ر",2,0],["ولاقت به الفُرسُ أمَّ اللُّهَي","م وأْدَ البناتِ وذبحَ البنينا",94,"ن",2,0],["وَلاقى الأُلوفَ غَيرَ مُكتَرِثٍ بِها","هُمامٌ أَجابَ المَوتَ أَوَّلَ ما دَعا",95,"ع",2,0],["وَلاقَت طَيِّئٌ ضَرباً دِراكاً","أَطارَ طُلىً وَأَذرِعَةً وَسوقا",96,"ق",2,0],["ولاقى هوانا مثله لم يلاقه","وهسفا وخسفا موجعا ومغارما",97,"م",2,0],["ولأقدمن على التناول كلما","أعطيتني ولو ان عقلي يذهب",98,"ب",1,0],["ولا قال جهلا للولاية منصب","يقصر عنها للنبوة منصب",99,"ب",1,0],["ولا قومه تحمى الفصوص وكفرها","لدى الملك من إلقائها في التنانر",100,"ر",1,0],["ولا قظت الشربة كل يوم","أعدى من مياههم الذبابا",101,"ب",2,0],["وَلا قائِلٍ لِلدَّهرِ رِفقاً وَقَد طَمَت","أَواذِيُّهُ شَرّاً وَجاشَت غَوارِبُهْ",102,"ب",2,0],["وَلاقَيتُ في أَبناءِ عَمّي وَمعشري","ذآليلَ لا يَرقى إِلَيها المُجالِحُ",103,"ح",1,0],["وَلاقَيتُ مِن جَرّائِكُم ما عَلِمتَهُ","وَهَل أَحَدٌ مِن سائِرِ الناسِ جاهِلُه",104,"ل",2,0],["وَلاقى الرَعايا خافِضاً مِن جَناحِهِ","وَفي بُردِهِ لَيثٌ بِخفّانَ مُشبِلُ",105,"ل",1,0],["وَلاقى الرَعايا خافِضاً مِن جَناحِهِ","وَفي بُردَتَيهِ هَيبَةٌ وَجَلالُ",106,"ل",1,0],["وَلا قابِضٍ فَضلَ الغِنى عَن فَقيرِها","وَلا باسِطٍ كَفّاً لَها حينَ أُعدِمُ",107,"م",1,0],["وَلا قَضيب النَقا تَذوي مَعاطفه","في قَفرة بِمياه الدَمع تَزدَهر",108,"ر",1,0],["ولأَقْنَعَنَّ من المُنَى بخيالهِ","زُورا يُمَنِّينى بخُلْفِ عُداته",109,"ت",2,0],["ولا قلت اذ كانوا نجوما طوالعا","وغابوا بان الارض تختص بالشهب",110,"ب",1,0],["ولا قلت ان الارض حين ثوى بها","تغيب بها الشمس المنيرة والبدر",111,"ر",1,0],["ولا قلت ان البحر يحمل سائرا","لى ظهر لوح او يحيط به قبر",111,"ر",1,0],["ولاقاها بِصَدرٍ راضَ صَبراً","وَلاقَتهُ بِصَدرٍ ضاقَ صَبرا",112,"ر",2,0],["ولأقعدن على الطريق فاشتكي","في زي مظلوم وأنت ظلمتني",113,"ن",2,0],["ولا قَنِعتُ بزور الْوَعْدِ من رَشَإٍ","دون التّعانُقِ والتَّجميش والقُبَلِ",114,"ل",1,0],["ولاقى الأذى من قومه فهو صابر","ومرّ إلى ذات النخيل يُفيض",115,"ض",1,0],["وَلاقَينَ جبّارَ بنَ حمزةَ بعدَما","أَطابَ بشَكٍّ أَيَّ أَمرَيهِ أَفعَلُ",116,"ل",1,0],["ولا قصرت أيام من كنت فرعه","ولا انقض يوماً في الزمان جداره",117,"ر",2,0],["ولاقِ الصُّبحَ مُنبلِجاً","وشمَّ الزَّهرَ مُنفتِحا",118,"ح",2,0],["ولا قدرةٌ بعد الشتاتِ على العدى","بغيرِ اتحادٍ فيهِ توحيدُ غاية",119,"ه",1,0],["وَلا قَيْس حُب أَو مَفاخِر دارِم","وَلا قَس لب قَطُّ أَو طَرفة العَبدِ",120,"د",1,0],["وَلاقَتْ علَى حُكْمِ السَّعَادَةِ بُرْدَها","ومَا بَرِحَتْ أثْنَاءَ شِقْوَتِهَا رَهْصا",121,"ص",2,0],["وَلاقَيتُ لِلأَعلاقِ أجْود مانِحٍ","يَميناً وَللأغْلاق أسْعدَ فاتِح",122,"ح",1,0],["وَلا قيدَتِ الخَيلُ العِتاقُ شَوازِباً","وَلا هُزَّ رُمحٌ في أَنامِلِ هَزّازِ",123,"ز",1,0],["وَلا قَرقَفٌ صَهباءُ صِرفٌ مُحيلَةٌ","يَفُضُّ زُكامَ المِنخَرَينِ عَتيقُها",124,"ق",3,0],["ولاقِهم بالبِشرِ","وحيِّهم بالشُكرِ",125,"ر",1,0],["ولأقبضن عنان قولي ها هنا","حسى وفي تعدادهم لم أطمع",126,"ع",1,0],["ولا قصر الا زناد عن نيل قصدها","سوى ضجر عجز تكاسل جثمان",127,"ن",1,0],["وَلاقيتُ برّاً قَد طَمى برّ بحره","فَجابَت لَه آمالُنا البرّ والبحرا",128,"ر",2,0],["ولا قاطع للناس نهج سبيلهم","ولا مفسد في الارض في كل وجهة",129,"ه",1,0],["وَلا قِرى لِنَزيلٍ دونَ قَريَتِهِ","وَلا هُدىً لِسَبيلٍ دونَ كَوكَبِهِ",130,"ب",2,0],["ولاقَيتَ مِن دُونِ الأَمَانِي خَلِيفَةً","بدِيهَتُه وَحيٌ وَعَزمَتُهُ لَمحُ",131,"ح",1,0],["ولاقيتَني فرداً فلاقيتَ ماجداً","وأنتَ حَسيرٌ في الوَثَاقِ أَسيرُ",132,"ر",1,0],["وَلا قُلتُ لِلأَعداءِ إِنّي سَحَرتُهُم","وَهَذا ثَنئي ثُمَّ ما هاجَهُم سِحري",133,"ي",1,0],["وَلا قُلتُ مَطروداً بِعامِ مَجاعَةٍ","وَلَكِن طَريدٌ مِن سُيولِ غَمامِ",134,"م",1,0],["ولا قال لا أرضى تعاليم بُطرسٍ","وما جاءنا بالبينات رسول",135,"ل",1,0],["ولا قال إني خائفٌ عند طاعتي","وفي الناس منهم قاتلٌ وقتيل",135,"ل",1,0],["ولاقيت كل العارفين بسفحها","وكل كريم ساكن برباها",136,"ا",3,0],["ولاقى به قوماً من الرسل كلها","يقول له يا مرحباً حين سلما",137,"م",2,0],["ولا قطعة اقتطعتها أو ولاية","كما هو دأب الناس في كل مورد",138,"د",1,0],["ولاقيت هابيلاً قتيل شقيقه","يواريه لما أن رآه غراب",139,"ب",1,0],["وَلأقتُلَنَّ العُدمَ قتلةَ ثائِرٍ","بِالجودِ من نَفحاتِ كَفِّ حُسَينِ",140,"ن",1,0],["وَلأَقضينَّ الدَهرَ غيرُ مُقَصِّرٍ","ما كانَ أَسلَفَنيه مِن أَحقادِهِ",141,"د",2,0],["ولاقيت صعب المرتقى غير ناكص","وأصعب ما ألقى رئاسة ناقص",142,"ص",1,0],["ولاقاهم وهل يخشى لقاهم","فتىً ألقى على اللَه اتكالا",143,"ل",2,0],["ولا قام يبغي نصرة الحق قائم","من الناس لولا سيف عزمك والجد",144,"د",1,0],["ولاقَيْتُمُ البيضَ والسُّمْرَ عَنَّا","ونحنُ بِعَقْوَتِكُمْ آمِنُونا",145,"ن",2,0],["ولاقى وْجوهَ الراغبينَ كأنَّما","أمانِيُّهُم يُصْبِحَنَ مْنهُ عَلَى وعْدِ",146,"د",1,0],["ولاقاكَ فاسْتَخْذى لديكَ تذلُّلاً","ليحتازَ من أدنى رضاكَ تَرَحُّما",147,"م",2,0],["ولا قَدَمٌ لا تَسْأَمُ الدَّهْرَ تَرْتَقِي","ذُرى كُلِّ صَعْبِ المُرْتَقَاةِ مُنِيفِها",148,"ف",3,0],["وَلا قَنَطٌ واليُسرُ لِلعُسرِ غالِبٌ","وَفِي العرْشِ رَبٌّ بالخَلائِقِ رَحْمانُ",149,"ن",1,0],["ولاق ضيفك طلق الوجه مبتسماً","ولو تعبَّس وجه الدهر مكتلحا",150,"ح",2,0],["ولاقى بعد ما لاقى المعادا","عتاد الباقيات الصالحات",151,"ت",1,0],["ولا قلب مذسار الموادع وادع","ولا عيش مذ طال التفرق طائل",152,"ل",1,0],["ولا قَرَنتُ حبَّه صبابةً","لا يطمع العاذلُ في سلوانِها",153,"ن",3,0],["ولا قامت الدنيا بسيرةِ عادلٍ","يُهابُ ولم يُنصَرْ لربّك دينُ",154,"ن",1,0],["ولا قدَرت على نفسي ولحظي","على ما نَمَّ من طيبٍ وحُسنِ",155,"ن",1,0],["ولا قسموا لها الإنصاف يوما","بكيلٍ في السماح ولا بوزنِ",155,"ن",1,0],["ولا قصير الإزار إن جذبَ ال","جدبُ بأذيال خائِض القُحَمِ",156,"م",1,0],["ولا قلّص الملكُ عاداتهِ","معي وهو في ثوبه رافلُ",157,"ل",1,0],["ولا قَرَى صَبابةً فؤادَه","إلا السلوَّ حاضراً والجَلَدا",158,"د",2,0],["ولا قَضَى اللّهُ على سيِّد","قضاءَهُ إلا اجتبَى سيِّدا",159,"د",2,0],["ولاقاه من الأيام يوم","كما من قبل لم يخلد قدار",160,"ر",1,0],["وَلا قَرَأتُ كِتاباً مِنكِ يَبلُغُني","إِلّا تَنَفَّستُ مِن وَجدٍ بِكُم صُعَدا",161,"د",2,0],["ولا قطفوا باللثمِ وردةَ خَدَّها","ولا هصروا في ثِني أبرادِها الغصنا",162,"ن",2,0],["ولاقى على الأوطان أهوال عاشق","عرته أهاويل على الطي والنشر",163,"ر",1,0],["ولا قفرة إلا وأمسيت صِلَّها","ولا حَضَرٌ إلا وظلْتُ له وَفْدا",164,"د",2,0],["ولا قيَّدْتُ ذاتي في نِطاقٍ","يُميلُ بها شُهودي عن رُبَاكِ",165,"ك",1,0],["ولا قِستُ السّما حين انتصرتُ","ولا شئتُ البكا حين هُزمتُ",166,"ت",1,0],["ولا قنَصَتْ أختُ الغَزالِ جوارِحي","ولا هيّجَتْ وُرْقُ الحَمامِ بَلابِلي",167,"ل",2,0],["ولا قدس الدهر فلولا جوره","لم يتحكم عاجز في قادر",168,"ر",1,0],["ولا قسمت ألحاظه بين مخلص","جميل السجايا أو عدو يجامله",169,"ل",2,0],["ولا قام في المحراب والحرب عاملاً","من البأس والإحسان ما الله قابله",169,"ل",2,0],["ولا قدم الشهر المحرم قبل ما","عداه سوى تقديمكم للمحرم",170,"م",1,0],["ولاقيتَ من عزٍّ منيعٍ وحُظوة","ورِفعَةِ جاهٍ وابتِسامِ ثُغورِ",171,"ر",1,0],["ولاقاك عن شَوق رجالُ حكومةٍ","تُبادِلك الودَّ الذي يَتجدَّدُ",172,"د",1,0],["وَلا قُذيتُ بعوراءٍ لَهُ مَرَقَتْ","سرّاً ودافع عنها النّاسُ إعلانا",173,"ن",2,0],["ولا قومٌ لَهمْ في قل","لَةِ العلياءِ بُنيانُ",174,"ن",1,0],["وَلا قلبَ إلّا وهو منك مُكلَّمٌ","وَلا لُبَّ إلّا وهو فيك مُذَهَّلُ",175,"ل",1,0],["وَلا قيّضَ اللّهُ التفرّقَ عنكمُ","ولا عَنَّ نأْيٌ بيننا وتصدُّعُ",176,"ع",1,0],["وَلا قُرّبتَ من جَدْبٍ","ولا بوعدتَ من خِصْبِ",177,"ب",1,0],["ولا قومي أرى قومي","ولا أهلي أرى أهلي",178,"ي",1,0],["ولأقلام التجلي","سمعت أذني صريفا",179,"ف",2,0],["ولا قائم إلا بها في وجوده","ولا صانع إلا بها هو صانع",180,"ع",1,0],["وَلا قَضِيّاً بِالقضَاءِ المُتَّهَم","في أُمَّةٍ سُوِّسَها بَعدَ أُمَم",181,"م",1,0],["ولا قاذِفٌ نَفسي وَنَفسي بريئة","وَكَيفَ اعتذاري بعد ما قد قذفتها",182,"ت",3,0],["ولا قبلها كانت عليهم فجائع","ولا سامهم من قبلها ذل سائم",183,"م",1,0]]}