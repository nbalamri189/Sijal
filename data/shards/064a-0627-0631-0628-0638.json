{"poems":[[74,"يا رب ظبي على ظبي ظفرت به","https://www.aldiwan.net/poem19364.html","البسيط"],[50,"يا رب ظبي بمكان خال","https://www.aldiwan.net/poem65082.html","الرجز"],[473,"يا رب ظمآن الوشاح","https://www.aldiwan.net/poem60285.html","مجزوء الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38650","الخفيف"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33008","البسيط"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121362","الكامل"]],"verses":[["يا رُبّ ظبيٍ على ظبيٍ ظفرت به","فقام إيري مقام الطاعن اللبق",0,"ق",1,1],["يا رُبَّ ظَبيٍ بِمَكانٍ خالِ","صَبَّحتُهُ وَاللَيلُ ذو أَهوالِ",1,"ل",1,1],["يا رُبَّ ظَمآنِ الوِشاحِ","يَفتَرُّ عن بَردِ الأَقاحي",2,"ح",2,1],["يا رَبِّ ظَنّي فيكَ أَحسَنتهُ","مَعَ اِقتِرافي لِلذّنوبِ العِظامْ",3,"م",1,1],["يا رُبَّ ظِلِّ عُقابٍ قَد وَقيتُ بِها","مُهري مِنَ الشَمسِ وَالأَبطالُ تَجتَلِدُ",4,"د",1,1],["يا ربَّ ظبيٍ قد طرق","تُ وساده في الليلِ سرا",5,"ر",2,1]]}