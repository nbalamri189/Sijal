om/ViewPoem.aspx?id=190348",""],[5039,"بعض الأغاني حزينه","https://www.poetsgate.com/ViewPoem.aspx?id=48130",""],[5092,"مرّةً لو نلتقي","https://www.poetsgate.com/ViewPoem.aspx?id=176222",""],[5401,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=78116",""],[5411,"لست أنت حبيبي..","https://www.poetsgate.com/ViewPoem.aspx?id=192204",""],[5431,"حرّق القلب","https://www.poetsgate.com/ViewPoem.aspx?id=209131",""],[5433,"جابك الله","https://www.poetsgate.com/ViewPoem.aspx?id=36260",""],[5455,"وحده بوحده","https://www.poetsgate.com/ViewPoem.aspx?id=34435",""],[5455,"صالات المطار","https://www.poetsgate.com/ViewPoem.aspx?id=34424",""],[5461,"ميلت نجمة حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=504",""],[5480,"من هموم ِ","https://www.poetsgate.com/ViewPoem.aspx?id=9868",""],[5491,"قهوة العطر","https://www.poetsgate.com/ViewPoem.aspx?id=215173",""],[5526,"ياليت","https://www.poetsgate.com/ViewPoem.aspx?id=202657",""],[5532,"هنوفي !","https://www.poetsgate.com/ViewPoem.aspx?id=34689",""],[5573,"شمس عمري","https://www.poetsgate.com/ViewPoem.aspx?id=200341",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5628,"مغترب يصف حاله","https://www.poetsgate.com/ViewPoem.aspx?id=178540",""],[5725,"قمر بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177977",""],[5756,"قصة حياة","https://www.poetsgate.com/ViewPoem.aspx?id=5435",""],[5756,"الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=5184",""],[5956,"أنا روحٌ حُرَّة","https://www.poetsgate.com/ViewPoem.aspx?id=183917",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[5957,"أمل الدُنيا","https://www.poetsgate.com/ViewPoem.aspx?id=22805",""],[5969,"مِنْ لَظى التعياءِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=199332",""],[5984,"ان عثمان الكدود بن رشد","https://www.poetsgate.com/ViewPoem.aspx?id=200378",""],[6008,"السلف والفخر","https://www.poetsgate.com/ViewPoem.aspx?id=59157",""],[6102,"خَطٌّ أَحمَر ..","https://www.poetsgate.com/ViewPoem.aspx?id=183988",""],[6115,"للصمت سبع فوائد","https://www.poetsgate.com/ViewPoem.aspx?id=180497",""],[6115,"سرع ما رحت ياشهر الصيامي","https://www.poetsgate.com/ViewPoem.aspx?id=180970",""],[6229,"مرة في الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65207&r=&rc=31",""],[6290,"وَطَنٌ فِي الصَّدْرِ مَوْؤُدٌ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85170&r=&rc=3",""],[6346,"أَقْبَلَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84886&r=&rc=11",""],[572,"دَجَاجَة ٌ في سِمَنْ السّمَنْدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9248&r=&rc=105",""]],"verses":[["مُرهَقَ الوَقفَةِ لا يَغ","مِزُ ساقاً مِن لُغوبِ",0,"ب",1,0],["مُرهَقاً يَدعو وَلا غَوثَ لَهُ","بِأَبٍ بَرٍّ وَجَدٍّ مُصطَفى",1,"ا",1,0],["مُرهُم يَخوضوا الزاخِراتِ وَيَنسِفوا","شُمَّ الجِبالِ بِقُوَّةِ الإيمانِ",2,"ن",1,0],["مَرِهَت عَيني فَعَيني","بَعدَ صَخرٍ عَطِفَه",3,"ف",2,1],["مرهوبُ شَيْبَانَ ومأمُولُها","والجبل الشَّامِخُ والسَّفْحُ",4,"ح",1,0],["مُرَّةً تَنْسابُ مِنْ قَلْبٍ حَطيمْ","مَلأَ الحُزْنُ أَقَاصِيهِ دُمُوعْ",5,"ع",1,0],["مُره يمسخ له ولو شطر بيت","قال أخشى انقلاب ذاك عليا",6,"ي",2,0],["مَرِهَت لِلنَوى فَلَمّا رَأَتني","كَحَلَّتها نَحافَةٌ وَشُحوبُ",7,"ب",1,0],["مُرهَفٌ ماثَنى التَبَسُّمَ إِلّا","أَشرَقَ البَيتُ أَو أَنارَ خَصاصُه",8,"ص",2,0],["مُرهَفاتٍ لَها إِذا أَظلَمَ النَق","عُ عَلَيها تَوَقُّدٌ وَإِشتِعالُ",9,"ل",1,0],["مُرهَفُ الأقلامِ يأتي في الوغَى","من جليل الفتحِ ما يُعيِي الحُساما",10,"م",2,0],["مَرَّةً عاشِقاً وَأُخرى خَلِيّاً","مُظهِراً غَيرَ ما الضَميرُ عَلَيهِ",11,"ي",2,0],["مُرَّةً يَهذِي الحَليمُ بِهَا","بِأبي ذلك منْ هاذِي",12,"ذ",2,0],["مرْهِقَاتٌ مِنَ المُنَى ذَاقَ فِيهَا","كُلَّ لَوْنٍ مِنَ الْعَنَاءِ الشَّدِيدِ",13,"د",1,0],["مرَّةً سامقاً على صهوة الْخَيْ","ل وأخرَى مطامِناً في صلاتهْ",14,"ت",2,0],["مَرّةً أَلتقِي به أملدَ الع","ودِ نضيرَ الصبا طليق العِنان",15,"ن",1,0],["مرّةً نستريح شوْقاً لذِكرا","ه وحيناً نَجِدُّ في نسيانه",16,"ن",2,0],["مرةً في مدَى يَدَيْهِ وأُخْرَى","ما له باقْتِناصِهِنَّ يَدانِ",17,"ن",1,0],["مُرهفةً ذاتَ شَباً وحَدِّ","لغيرِ ما ذَحْلٍ وغيرِ حِقْدِ",18,"د",1,0],["مرهوب الغرار حديده","وسيبك مسكوب النوال عقيده",19,"د",2,0],["مرة اشترى الجريدة سمّى","نصفها خائنا ، ونصفا دخيلا",20,"ل",2,0],["مرة أحزاننا لكنها","يا عذاب الصبر أحزان الرجال",21,"ل",1,0],["مُرَّةٌ قَبلَ مَزجِها فَإِذا ما","مُزِجَت لَذَّ طَعمُها مَن يَذوقُ",22,"ق",1,0],["مرةً في كل عامٍ واحدٍ","لا تزدْه ودعَنْ عنك العَذَلْ",23,"ل",1,0],["مرةً تسقيك صاباً وكذَا","مرةً تسقيكَ شهداً وعَسَلْ",23,"ل",1,0],["مُرْه عاذِرٍى قد جفانى والصدودُ نوًى","فيما تشَاء إذا طغى في الهجر حين قسَا",24,"س",2,0],["مُرهَفاتٌ إِن بَزَّها سُخطُكَ الأَغ","مادَ عيضَت مِنَ الطُلى أَغمادا",25,"د",2,0],["مرهت جفوني مذ صددت وإنما","كحل الجفون لدائها كحل الجلا",26,"ل",2,0],["مُرهُم بأَن يَقصُدوا سِوايَ بِها","فَغَيرُ عيدٍ عيدٌ بِلا نَفَقَه",27,"ق",2,0],["مُرَّةٍ يحلو بها العيش وفي","مثلها قد يُحمد الدَّهر المذمّم",28,"م",1,0],["مرهاءَ ما وهبت مَراودَها","وبحُقِّها فقرٌ إلى الكُحْلِ",29,"ل",1,0],["مَرِهْتُ بإدْماني سُري كل حادثٍ","ولا كحلَ إلا من غبار المَواكبِ",30,"ب",1,0],["مرهفٌ حدُّه تحزَّم في الملك","حزاماً كما تجلّل جلاَّ",31,"ل",2,0],["مرهف حده إذا هزه المج","د وفري السيوف بالإرهاف",32,"ف",1,0],["مرة من يموت فيها شجاعا","ومرارا يموت فيها الجبان",33,"ن",1,1],["مُرهَقٍ فائتِ الأمورِ بجِدٍّ","في أبِيِّ الخُطوبِ جِدّ مُطاعِ",34,"ع",1,0],["مرّةً جِداً وأخرى راحةً","فإذا ما غسق الليلُ انتَصَبْ",35,"ب",1,0],["مَرَّةً فَوقَ جِلدِهِ صَدَءُ الدِر","عِ وَيَوماً يَجري عَليهِ العَبيرُ",36,"ر",1,0],["مُرهَفُ مَجرَى الوِشاحِ جائِعُهُ","مُنعمُ ساقي العُراقِ جَيعانه",37,"ن",2,0],["مُرَهِّقُ النّارِ بابُهُ فَتَحٌ","ما دُونَه حاجِبٌ وَلا غُلَقُ",38,"ق",1,0],["مُرهَفُ مَجرَى الوِشاحِ مُفعَمَةٌ","مِنهُ الدَّماليجُ والخَلاخيلُ",39,"ل",1,0],["مُرُّهُ حلو ولكن","منه تنشق المرائرْ",40,"ر",1,0],["مرهف القرن أتلع الجيد نهد","واسع الصدر قارب الأقطارا",41,"ر",2,0],["مرّهفي الأبدان","يا فرحة الديدان",42,"ن",1,0],["مِرَّه فقدنا الغِيرْه","ونركض ورا الدينار",43,"ر",1,0],["مَرَّة مَا أَمَرَّ هَجرَ السَّكَنِ","بَعدَ التَّلاقِي وَانتِزَاحِ العَطَنِ",44,"ن",1,0],["مُرهفاتٌ إِذا طَفَت أَعمَلوها","في مَناطِ الأَعناقِ وَالأَجوافِ",45,"ف",1,0],["مرهوبة الجنبات قائمةَ الضحى","ما للأُسود بقاعها إصحارُ",46,"ر",1,0],["مَرَّه عَلى مَرَّه ثِنيتوه","الاوَّل تْسَجَّل في المجَلّه",47,"ل",2,0],["مرة من بعد أخرى","أَو يَميل المُستَقيم",48,"م",1,0],["مَرَةٌ مُخَدَّرَةً تَسِيرُ وَحَولَها","لَجِبٌ يَسُدُّ الخافِقَينِ عَرَمرَمُ",49,"م",1,0],["مرهف الجفن سيف مقلته والق","دّ أمضى فتكاً من السمهريِّ",50,"ي",1,0],["مرهف قضب العيون أكحلها","مضعف نبل الجفون أوطفها",51,"ف",3,0],["مَرّه يِدَقْ البِنّ وامرار لِقْناد","ويْحَط في دْلالٍ نِظافٍ جدادي",52,"د",2,0],["مرهفاً لم ينب إن ينبو الحسام","فلكم من كف باغ حسما",53,"م",2,0],["مَرَّةً تَعتَفيهِ ريحٌ جَنوبٌ","وَمِراراً تَهُبُّ ريحاً شَمولا",54,"ل",2,0],["مُرهفَ القدّ ليس يخطر إلّا","اهتز في طيّ برده خطارُه",55,"ر",2,0],["مرهف الحد حده لن يفلا","فإلى م عن القراب أخلى",56,"ل",2,0],["مرهفة أرواحهم وجسومهم","مضمخة أثوابهم بالمعابق",57,"ق",1,0],["مُرهَفٌ صارِمٌ وقلبٌ كَمِيٌّ","وجودٌ يجولُ كلَّ مجال",58,"ل",1,0],["مُرهَفَةٌ تُعْجِزُ وَصْفَ اللسَانْ","للسَّيْفِ مَعْنَى ولها معنيانْ",59,"ن",1,1],["مَرهوبَةٍ مِن أَنفَسِ المَرهوبِ","تَأخُذُ بِالعيونِ وَالقُلوبِ",60,"ب",1,0],["مُرهُم بحسن العشرة الشا","في الصدور من الجراح",61,"ح",1,0],["مُرْهَفاتُ الحَدّ أَمهاها المها","وقضاها للمحبّين القضاءُ",62,"ا",2,0],["مرهف عوذته باللَه من","أسهم ترشق عن قوس أضغان",63,"ن",1,0],["مَرةً أَخطَأتُها في عُمري","بِثَناءٍ قُلتُه في نَزقِ",64,"ق",1,0],["مُرهَفُ الحِسِّ لَيسَ يُعييهِ غَيب","يَسمَعُ الهَمسَ في حَنايا الصُدورِ",65,"ر",1,0],["مرهف القامة موفور الشعر","واضح الغرة مخضوب البنان",66,"ن",1,0],["مرهفهُ نار وفضفاضُه","ماءٌ وبين الحالتين اصطلاح",67,"ح",1,0],["مرهفا ينساب من نبع الغيوب","ويناديه بفن الساحر",68,"ر",1,0],["مُرٌّ هُوَ الثَّالُوثُ مَهمَا ادَّعَى","قَدَاسَةَ الأديانِ أَو بَرَّرَا",69,"ر",2,0],["مُرٌّ هُوَ الإقْدَامُ لكنما","خَوف التَّحَاشِي لَم يَكُن سُكَّرَا",69,"ر",2,0],["مُرَّةٌ هذهِ الثِّمَارُ.. ومُرٌّ","سُكَّرُ الصَّبرِ والنَّدَى والنَّجِيعُ",70,"ع",1,0],["مرة قد شد أذناً","ثم أخرى حك إبطه",71,"ط",2,0],["مرة الخيانة تكون ، مرة تكون فِتنةَ","بإيدينا هدِّنا وحرقنا أوطنّا",72,"ا",1,0],["مرّه سألته أنت من أيّاة طينه","صرخ بوجهي ... قال لي : شف أنا أنت",73,"ت",1,0],["مرّه ابوي وباقي الوقت ابني","إليا احترمته. ما احترمت المشاعر",74,"ر",1,0],["مره كلامي ينوخذ (كذبة ابريل)","ومره يقولوا الصدق جانا ويختال",75,"ل",1,0],["مرّه على طآق طآقيّه","باللعب .. ومرّه على آتآري",76,"ر",2,0],["مره تغيب ومره تكون حآضر","ومره حضورك نسخةٍ من غيآبك",77,"ك",1,1],["مرّه على شُرفه ومرّه على بآب","ومرآت ما ادري وين .. لكن لحآلي",78,"ل",2,0],["مرة سمعت اثنين","يحكون.. للغيّاب !",79,"ب",1,0],["مُرْهَقُ الرُّوْحِ سَلِيْبٌ، إنّما","دَافعي حُزْنٌ شَدِيدُ العُنْفُوان",80,"ن",1,0],["مرّه وفي نفسي مع العيد ياليت","يطري على السجان يعتق سجينه",81,"ن",2,0],["مرّةً لو نلتقي يا دوحتي ؟","وصلنا يحيا بصحراءِ العدمْ",82,"م",1,0],["مرّةٍ على غزير الجم موّووح","ومرّةٍ دمعه كما طش برديه",83,"ي",2,0],["مَرَّة أُخْرى ناوَشَ الشَّوْكُ رُسْغي","كَطُفَيْلٍ عَلَى التَّقَهْقُر عاشا",84,"ش",2,0],["مرةً حين قتلك الجاء غيا","واستزادوا بغيهم يابنيّ",85,"ي",1,0],["مرةٍ كنك الشمس وقت غروب","ومرةٍ كنك الحلم متشابك",86,"ك",1,0],["مره حلف بأنه يبّطل هباله","وقبل يكمّل .. فك اخوه الستاير",87,"ر",1,0],["مرةٍٍ ركضك يمين ونظرة عيونك يسار","ومرةٍٍ ركضك يسار ونظرة عيونك يمين",88,"ن",1,0],["مرة ترقص حروفي للهوى","ومرة اسمع من حروف نحيب",89,"ب",1,0],["مره اتشوفه تغليّ .. ومره اتشوفه رحوم","وكل دربن للمحبة صعب تلقى به هدايا",90,"ا",3,0],["مرَّةً كنتُ _والصقيع شديدٌ","أتمشى في ليلةٍ شتويَّه",91,"ي",2,0],["مره يبون تكون ' كول ' ' واتي كيت '","ومره تبيع الشمس بأول غيابه",92,"ب",2,0],["مره كريم بزود مره شحوحي","مره يدلعني بقولة \"هنوفي\"",93,"ف",2,0],["مره يقول أبشر خفوقي حلالك","قلبي وروحي والمحبه لك لباس",94,"س",1,0],["مرَّةً في الحياةِ ننفضُ فيها","بعضَ أعبائِنا ويصفو البالُ",95,"ل",1,0],["مرَّةً ننشُرُ الربيعَ جديداً","ويغنِّي في عرسِنا الموَّالُ",95,"ل",1,0],["مرّة حدّثني مُسْتفْسرا ً","صاحبٌ ثبّت في نفسي احترامهْ",96,"م",2,0],["مرّة حاولتُ أن أحرقها","غير أنّي خفتُ مِنْ أهْلِ الملامهْ",96,"م",2,0],["مرهفات سيوفها","تترك العنق ابترا",97,"ر",2,0],["مرة مع حظي ومرات ضده","واليا تكدر خاطر القلب تزداد",98,"د",1,0],["مره ارقد بالكفن وانت ترقد بالمهاد","ومرة ارقد بالمهد وانت ترقد بالكفون",99,"ن",1,0],["مرة أهوي حضيضا، مرة أرقَى الفضاءْ","تارة أنفث سمّاً، تارة أصفَى دواءْ",100,"ا",2,0],["مَرّةً آتي إليه كذباب","مرة مثل فَراشٍ أو كَدودِ",101,"د",1,0],["مرهفٌ شعرك في الدمِّ رمى","رعشةَ الشوق لذياك البعيدْ",102,"د",1,0],["مُرهَقٌ حتى يَراني","في دُروبِ الشوقِ أَجري",103,"ر",2,0],["مرة عند جوين أو أبى","حسن أيهما طعما أعدّ",104,"د",1,0],["مره بعيده منك ومره قريبه","ومرااااات في موج ٍ تصافق هبوبه",105,"ب",2,0],["مُرهَفُ الحَرفِ ؛ باتِرٌ بِقَرِيضِي","وَ مَهِيبٌ - أَنا - وَ فِي بَطنِ غِمدِي",106,"د",2,0],["مره تكلم لكن اسمع مرتين","واذا حكيت الزم قوانين الأدب",107,"ب",1,0],["مرةٍ واحده في كل عامي : تغمر الكون في خشيه وطيبه","تكسب اهل التقى حشمه طيبه : يوم تاجي لنا في كل عامي",108,"م",2,0],["مَرّةً في الزمان عشتُ مثالاً","لو وعى الخَلْقُ هَدْيَةً للصراط",109,"ط",1,0],["مَرَّةً بِاسْمِ الْمَرْكِسِيَّةِ نُخْصَى","وَ مِرَارًا بِاسْمِ الدِّمُقْرَاطِيَّهْ",110,"ي",2,0],["مُرْهَفِ الحِسِّ بَدِيعٍ مُلْهَمٍ","مِنْ يَنَابِيعِ القَوَافِي غَرَفَا",111,"ف",2,0],["مرهفة ٌ ذاتُ شباً وَحَدِّ","لِغيرِ ما دخلٍ وغيرِ حِقْدِ",112,"د",1,0]]}