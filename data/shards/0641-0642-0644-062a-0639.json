{"poems":[[55,"تلفت والرمل ما بيننا","https://www.aldiwan.net/poem29633.html","المتقارب"],[57,"قلت غداة السبت إذا قيل لي","https://www.aldiwan.net/poem26033.html","السريع"],[53,"ألا يا ابن القنوط عجبت جدا","https://www.aldiwan.net/poem65793.html","الوافر"],[93,"رأيت غلاما مليح الرواء","https://www.aldiwan.net/poem8783.html","عموديه"],[87,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[30,"وقفت بأعلى ذي قساء مطيتي","https://www.aldiwan.net/poem5022.html","الطويل"],[63,"كملن فأطلعن البدور كواملا","https://www.aldiwan.net/poem51486.html","الطويل"],[89,"وفاتنة الحديث لها نكات","https://www.aldiwan.net/poem8276.html","الوافر"],[107,"يا ناقض العهد لا شكوى ولا أسف","https://www.aldiwan.net/poem43988.html","البسيط"],[50,"تقول لي الركبان ما لك راجلا","https://www.aldiwan.net/poem65069.html","الطويل"],[50,"جالست يوما أبانا","https://www.aldiwan.net/poem66153.html","المجتث"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[113,"ألا فانصحا من رام حمدان شاعرا","https://www.aldiwan.net/poem16304.html","الطويل"],[123,"وقائلة تقول وقد رأتني","https://www.aldiwan.net/poem4365.html","الوافر"],[136,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[203,"قالوا جفتك ولا تنفك تذكرها","https://www.aldiwan.net/poem45233.html","البسيط"],[203,"أأخشاه جفنا ما تسل قواضبه","https://www.aldiwan.net/poem45563.html","الطويل"],[228,"بكت وهي صرعى من هموم تحيقها","https://www.aldiwan.net/poem41892.html","الطويل"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[275,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[308,"ولما تراءينا الهلال بدا لنا","https://www.aldiwan.net/poem58010.html","الطويل"],[358,"هواي سليم الود لا متشاعث","https://www.aldiwan.net/poem40551.html","الطويل"],[376,"رأيت الغصن معتسفا","https://www.aldiwan.net/poem57301.html","مجزوء الوافر"],[409,"أشمس اللقا قد راقني منك مطلع","https://www.aldiwan.net/poem33675.html","الطويل"],[500,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[543,"وخل أتى التدخين زهوا ونشوة","https://www.aldiwan.net/poem47568.html","عموديه"],[543,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[591,"بدا وجهه من فوق أسمر قده","https://www.aldiwan.net/poem17473.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38826","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38033","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59813","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64767","المجتث"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109032","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80027","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80024","البسيط"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67406","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127967","الوافر"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105412","الطويل"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104467","الرجز"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33863","الطويل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33887","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27495","الوافر"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82200","البسيط"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21434","الطويل"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21212","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137017",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75894","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65966","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58294","الوافر"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58400","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201682","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201122","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202902","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202609","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205068","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200152","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200143","الطويل"],[3265,"","https://poetry.dctabudhabi.ae/diwan/poem/89515","الرجز"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104301","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62968","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48352","البسيط"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102382","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101221","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216619","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103552","الطويل"],[3955,"","https://poetry.dctabudhabi.ae/diwan/poem/198343","المجتث"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93300","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54463","المجتث"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35059","الوافر"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198565","الطويل"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143324","الطويل"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143312","المجتث"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120401","المتقارب"],[4955,"رسمت على جدران قلبي خيالها","https://www.poetsgate.com/ViewPoem.aspx?id=196849",""],[5111,"وَقَلْتُ، وَقَالَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=212292",""],[5183,"فخري","https://www.poetsgate.com/ViewPoem.aspx?id=186477",""],[5213,"وقائلة هلا ترحلت طالبا","https://www.poetsgate.com/ViewPoem.aspx?id=170471",""],[5277,"أعيذُ عينك","https://www.poetsgate.com/ViewPoem.aspx?id=191032",""],[5376,"قد عيل صبري وما ذا النزف من شيمي","https://www.poetsgate.com/ViewPoem.aspx?id=199003",""],[5419,"عين الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=32241",""],[5616,"راحلة","https://www.poetsgate.com/ViewPoem.aspx?id=207473",""],[5790,"يقولون سافر من دمشق ولا تقم","https://www.poetsgate.com/ViewPoem.aspx?id=112062",""],[6355,"الوشاة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66566&r=&rc=26",""]],"verses":[["فَقُلتُ عَلى طَرَباتِ الهَوى","عَسى الطَرفُ يَبلُغُهُم أَوكَراهُ",0,"ا",2,0],["فَقُلتُ عِندي إِن تَشَأ رُقيةٌ","لا تَقصِدُ العَينُ لَها ثانِيَه",1,"ي",2,0],["فقلتُ عساهُ كان به نُعاسٌ","وعندي ما يُطيِّر من نعاسك",2,"ك",1,0],["فَقُلتُ عَدُوٌّ قَليلُ الحَياء","يُحاذِرُ شَرّاً عَلى دَولَتِه",3,"ه",1,0],["فقلت عوادي الهم بيني وبينها","تكاد تصدّ الكأس حين تدور",4,"ر",1,0],["فَقُلتُ عُبَيدُ اللَهِ خَيرُهُما أَباً","وَأَدناهُما عُرفاً لِكُلِّ جَوادِ",5,"د",1,0],["فقُلت عليٌّ منك أعلَى صَنَائعا","إذا ما رجَوناه وأرجَى مَخائِلا",6,"ل",2,0],["فَقُلْتُ عِدِي بِوَصْلٍ مِنْكِ صَبّاً","برَتْهُ يَدُ الصَّبَابَةِ وَالْغَرَامِ",7,"م",1,0],["فقلتَ عُودوا فما عندِي لكم صِلَةٌ","جَفَّ المَعِينُ فلا قَصْدٌ ولا سَرَفُ",8,"ف",1,0],["فَقُلتُ عَداني عَن رُكوبٍ وَمَلبَسٍ","ذَوّ رَحِمٍ آثَرتُهُم وَعِيالُ",9,"ل",1,0],["فَقُلتُ عيسى رَسولٌ","فَقالَ مِن شَيطانِ",10,"ن",1,0],["فقلتُ عليٌّ ليس للأمرِ غيرُه","إذا ما أدار الدهرُ صفحتَه جَهْما",11,"م",2,0],["فَقُلت عَلى مَن تَندبين فَولولت","وَقالَ لَقَد ماتَ الحِمار مِن الكَد",12,"د",1,0],["فقلتُ عليَّ شكرٌ وامتداحٌ","وليس عليَّ تقليبُ القلوبِ",13,"ب",1,0],["فَقُلتُ عَلَى السِّحر يَجني بهِ","مِنَ الإِثم مَا شَاءَ أن يَقطُفَا",14,"ف",2,0],["فقلتُ عينيَ مني وهْيَ إنْ رمدتْ","فلا يكونُ دواها كحلُ عميانِ",15,"ن",1,0],["فقلتُ عرفتُ الحبَّ واللهِ أنهُ","مطالبُ قلبٍ لا تُحَدُّ مطالبهْ",16,"ب",2,0],["فَقُلتُ عَزيزٌ يا بَني الشَرق أَن نَرى","الفَضيلَةَ يَمشي في المَكاسِدِ سوقُها",17,"ق",3,0],["فقلتُ عيناكِ كادتاه بما","تَعْجِز عن بعضِ حَلِّهِ الحِيلُ",18,"ل",1,0],["فقلتُ على مضاجعهم سلامٌ","وموتاها أُولو الرأي السّديد",19,"د",1,0],["فقلت عجيبٌ أن يرى البدر هكذا","تماماً ونحن الأن في أول الشهر",20,"ر",1,0],["فَقُلت عَلى ما أَنتَ لِلصَبّ رافس","فَقالَ تَمَنّى أَنَّهُ لِيَ رافثُ",21,"ث",1,0],["فَقُلتُ عَسى يعوقُهُما","اِختلافهُما وما اِختَلَفا",22,"ف",2,0],["فقلت عديني واخلفيني وماطلي","فنفسي بوعد من وصالك تقنع",23,"ع",1,0],["فقلت عن ملء ضلوعي مرضا","وحر أحشاء تلظى نبضا",24,"ض",2,0],["فقلتُ عفَاك اللهُ من نَشقِ نفحَةٍ","فقالَ عفَاني اللهُ لَكِن بِأُصبُعِ",25,"ع",1,0],["فقلتٌُ عَفوا فمَا لي مِن مُلاحظَةٍ","وإنَّني مُعجَبٌ بالمطعم البلدي",26,"د",2,0],["فَقُلْتُ عَجيبٌ كَيْفَ لَمْ يَذْهَب الدُّجَى","وَقَدْ طَلَعَتْ شَمْسُ النَّهارِ على رُمْحِ",27,"ح",1,0],["فَقُلت عَينايَ بِلَّورٌ وَأَسفلهُ","قَلبي المُتَيَّمُ وَالمُضنى بِمَن عَشِقا",28,"ق",2,0],["فَقُلتُ عَفصٌ في يدي","عَلى قَفاكَ اِنقَلَبا",29,"ب",2,0],["فقلت علَّ الليالي","تردُّ يوم لِقاه",30,"ه",1,0],["فقْلتُ عُوْذي بصبْرٍ","فقالَ ليس مَعاذَا",31,"ذ",2,0],["فقلت علامَ البكا والحزن","وكيف تبدل ذا الإبتسام",32,"م",1,0],["فقلت علامَ عزمت إذن","فقالت ومدت يداً للوئام",32,"م",1,0],["فقلتُ على مَن رنةُ النوح والبكا","فقالت على من لا ترى الدهرَ مثله",33,"ل",2,1],["فقلت عنِّي وهل لغيري","يا لائمي رنَّةُ العويل",34,"ل",1,0],["فَقُلْتُ عَلَيْكَ الحَوْضَ إنِّي تَرَكْتُهُ","وَفِي صَغْوِهِ فَضْلُ القَلُوصِ منَ السِّجْلِ",35,"ل",1,0],["فقلت عهود حبهم رزان","بقلبى قبل أن أصل الفطاما",36,"م",2,0],["فقلت عساه شاء يختبر الهوى","أينقصه أعراضه أم يزيده",37,"د",2,0],["فقلت عرفني الكتاب واسمه","فقال اقرأ هو طب حكمه",38,"ه",1,0],["فَقُلتُ عَلى التَقصيرِ في النَيكِ لُمتَني","أَلا ذَهَبَ الأَيرُ الَّذي كُنتَ تَعرِفُ",39,"ف",1,0],["فَقُلتُ عِندي لَكَ البِشارَةُ وَالشُك","رُ وَقَلّا في جَنبِ حاجَتِيَه",40,"ي",2,0],["فقلت علمت إنك لي مجيب","على قدر السؤال بشرح حالي",41,"ل",2,0],["فقلت عذلك قد أكثرت لائمتي","ولم يمت حاتم هزلا ولا هرم",42,"م",1,0],["فَقُلتُ علَيَّ اللَّه لا تَذعرانِها","وَقَد بَشَّرَت أَنَّ اللِّقاءَ قَريبُ",43,"ب",1,0],["فقلت عل الذي ترجينَ يُنجزُهُ","لكِ الألهُ فرجّي الخير وانتظري",44,"ر",2,0],["فقلت عميد لبنان تحلى","بشامل عطف مارتل العميد",45,"د",1,0],["فَقُلتُ عُيونُ الكوزِ سُودٌ لذكرة","عُيون حَبيبٍ باخلٍ بِمِدادِ",46,"د",1,0],["فقلت على دين ابن وهب وجابر","لقد وجدوا والكل منهم مسارع",47,"ع",1,0],["فقلتُ علمتُ ذلكَ وهوَ سَمْح","يُضَيِّعُ كُلَّ يوم ألفَ عَين",48,"ن",1,0],["فَقُلتُ عَيناهُ تُهوى كيفما صارتْ","ذي ضُرَّتينِ وذي مِن حُسنِها غارتْ",49,"ت",1,0],["فقلت عبيرٌ أنتِ أم مسك ناشقٍ","فقد عاد قلبي من أريجك نشوانا",50,"ن",2,0],["فقلت عداي رفاق الهناء","رفاقي رفاقُك إذ تعزل",51,"ل",1,0],["فقلت عن التأليف في الصيت لي غنى","لأني بأشعاري أؤلف عن نفسي",52,"ي",1,0],["فقلت على شعري أرى الكوخ زائداً","فمسكنُه في الروح والقلب والصدر",53,"ر",1,0],["فقلت عجزت عن شغل ولكن","قريت على ولادتك المئينا",54,"ن",2,0],["فقلت على رغم المروءة والعلى","أكون أبا السجّان والسجناء",55,"ا",2,0],["فقلت علام الحبس لا انا سارق","ولا آثم عمداً ولا دون ما عمد",56,"د",1,0],["فقلت عندي دُعوه","زرتني في رجب",57,"ب",1,0],["فقلت عداك الشر لم يبق منزع","لقوس الهوى لولا الحيا والتخلق",58,"ق",1,0],["فقلتُ عَسى أبو درعٍ دَعاني","ليقعدني على عرشِ السِّمَاكِ",59,"ك",1,0],["فقُلْتُ علَّ خَيالاً منك يَطْرُقُني","قالَتْ أتَطْلُعُ شمسٌ في دَياجِيها",60,"ي",3,0],["فقلتُ عداني أنَّ أهلَكِ ظَنَّةٌ","عليَّ وأنّي قد علمْتُ شهيرُ",61,"ر",1,0],["فقلت عفاء لكم إنه","لكالليث يفتر عند الغضب",62,"ب",1,0],["فقلت على النفس التي سوف تغتدي","طلولاً بإحناء الضلوع حوانيا",63,"ي",2,0],["فقلت عبيد اللَه أو نجله سرى","فذكرني دارين أوبت بالشحر",64,"ر",1,0],["فقلت عاتب وخاطب","بالأمن أهل العقول",65,"ل",1,0],["فقلت عِذارُ مَنْ أَهوى","أَمارتُه إِمارتُه",66,"ه",1,0],["فقلتُ عنّتْ أُمورٌ","عجيبةُ الأَشكالِ",67,"ل",1,0],["فقلت عسى حادي المطي يعينني","وفوق المطايا الوجدات يدينني",68,"ي",1,0],["فقلت عسى إله الحي يضحي","إِذا قدّمت تضحية عطوفا",69,"ف",2,0],["فقلت عسى من فولكن بقية","فقلن وأي الفول ترغبه منا؟",70,"ن",2,0],["فقلتُ عذابي هل له فيكِ آخرٌ","فقالتْ إذا ما صار مقترحاً عَذبا",71,"ب",2,0],["فقلتُ عهدٌ بعيدُ","قدَّرْت وهو جديدُ",72,"د",1,1],["فقلت على الحسن اوليك مدحا","ولكن على العجب اوليك سبا",73,"ب",2,0],["فقلت عساني إن تأمَّلتُ طيفها","أُخَفِّفُ حزني فالفراقُ مريرُ",74,"ر",1,0],["فُقُلْتُ : عِشِقْتُكِ سِرًّا وَجَهْرًا","فَشَوْقُكِ : يَعْصِفُ هَوْجًا وَرَعْدَا",75,"د",2,0],["فقلت على مقول البعض من","أولاك ان