{"poems":[[110,"ما انفكت الناس في أديانها قددا","https://www.shoaraa.com/p11352",""],[55,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[49,"أتعجب أن ملكنا الأرض قسرا","https://www.aldiwan.net/poem25350.html","الوافر"],[53,"وجدت أبا عبد الإله خليفة لصاحبه","https://www.aldiwan.net/poem8694.html","الطويل"],[53,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[40,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[87,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[47,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[47,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[51,"فقصر ما ترى بالصبر حقا","https://www.aldiwan.net/poem64277.html","الطويل"],[68,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[99,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[33,"تقول وليدتي لما رأتني","https://www.aldiwan.net/poem41270.html","الوافر"],[76,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[76,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9943","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[47,"هزيع دجى في الرأس بارده بدر","https://www.poetsgate.com/ViewPoem.aspx?id=31243",""],[131,"أعباس إنا وما بيننا","https://www.aldiwan.net/poem24271.html","المتقارب"],[147,"محلك من محل الشمس أعلا","https://www.aldiwan.net/poem11806.html","الوافر"],[164,"أيرجو أن يزور وأن يزارا","https://www.aldiwan.net/poem58952.html","الوافر"],[185,"أقمت على رمان يوما وليلة","https://www.aldiwan.net/poem58873.html","الطويل"],[279,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[280,"هل عند عمرة من بتات مسافر","https://www.aldiwan.net/poem2239.html","الكامل"],[354,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[368,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[368,"أتراه بنفسه يذكر المولي","https://www.aldiwan.net/poem60885.html","الطويل"],[406,"هيهات ذلك دين لا أفارقه","https://www.aldiwan.net/poem46952.html","البسيط"],[420,"كن بالمدامة للسرور متمما","https://www.aldiwan.net/poem54035.html","الكامل"],[441,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[443,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[443,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[456,"اضحكوا ثم اضحكوا يا هازلين","https://www.aldiwan.net/poem61608.html","الرمل"],[461,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[461,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[461,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[461,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[464,"وعلى الأيام من نعمائه","https://www.aldiwan.net/poem16075.html","الرمل"],[498,"ومضطغن على الألباب قاس","https://www.aldiwan.net/poem10272.html","الوافر"],[517,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[530,"لاحت لوجهي أنجم","https://www.aldiwan.net/poem45957.html","مجزوء الكامل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[589,"هذا الذي أحبه","https://www.aldiwan.net/poem17421.html","مجزوء الرجز"],[590,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216887","الخفيف"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21403","الطويل"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"]],"verses":[["فقَصروا العمرَ في هَدْيِ الأنامِ ولم","يَكُنْ لِيَحْيَى الهُدى إلا بِكَبشِ فِدا",0,"د",2,0],["فَقَصَّرتَ فيهِ كُلَّ سَمراءَ لَدنَةٍ","وَأَنحَلتَ فيهِ كُلَّ أَبيَضَ قاضِبِ",1,"ب",1,0],["فَقَصراً إِنَّ حالاً مَلَّكَتنا","لَحالٌ لا تُذَمُّ وَلا تُعابُ",2,"ب",1,0],["فقصَّرتُ في الأمرين والقلب مُضمِرٌ","مودَّتَهُ في مستقرِّ ثباتِهِ",3,"ت",2,0],["فقصدتُ ربحاً حاضراً","ورَفضْت أمراً كان خُسراً",4,"ر",2,0],["فَقَصَّرَ عَنّي اليَومَ كَأسٌ رَوِيَّةٌ","وَرَخصُ الشِواءِ وَالقِيانُ الصَوادِحُ",5,"ح",1,0],["فَقُصورُهُم كوخٌ وَبَيتُ بَداوَةٍ","وَقُبورُهُم صَرحٌ أَشَمُّ وَجَوسَقُ",6,"ق",1,0],["فَقَصرُكَ إِنّي حائِمٌ فَمُرَفرِفٌ","عَلى خُلُقي أَو ذاهِبٌ حَيثُ أَذهَبُ",7,"ب",1,0],["فَقَصرَكِ إِنَّ الشَيبَ مِن عَدلِ حُكمِهِ","وَإِن كانَ جَوراً أَن يُقالَ لَكِ القَصرُ",8,"ر",1,0],["فَقَصِّر ما تَرى بِالصَبرِ حَقّاً","فَكُلٌّ إِن صَبَرتَ لَهُ مُزيلُ",9,"ل",1,1],["فَقَصَدتَ البَيتَ الحَرامِ فَأَقصَد","تَ بِسَهمِ الرَدى قُلوبَ العُداةِ",10,"ه",1,0],["فقصدته عَجِلاً ولي بصرٌ","شبه الفراشة يعشق النورَا",11,"ر",2,0],["فَقَصَّ مَيسُرَةُ المَأمونُ قِصَّتَهُ","عَلَى خَديجَةَ سَرداً غَيرَ مُنعَجِمِ",12,"م",1,0],["فَقَصَّ عَلَيَّ ما يَلقى بِهِندٍ","فَذَكَّرَ بَعدَ ما كُنّا نَسينا",13,"ن",2,0],["فَقَصرُ أَناةِ الحِلمِ عَضَّةُ سَطوَةٍ","تُقيمُ صَغا تِلكَ القَنا وَتُسَوِّدُ",14,"د",1,0],["فَقُصارُ مُجتَمِعُ الأَصاحِبِ فِرقَةٌ","وَمَحارُ أَنوارِ الشَبابِ رَمادُ",15,"د",1,0],["فقصت زليخا فرعها من أصوله","وَكانَ يَزور الأرض ساعة ينشر",16,"ر",1,0],["فَقَصَّرَ عَن لَحاقي في المَعالي","وَقَد أَعيَت بِهِ أَيدي المَساعي",17,"ع",2,0],["فَقصَدْنهُ وَسَخِرْنَ مِنْ","زجرِ الأُمَيْمَاتِ الزَّوَاجِرْ",18,"ر",1,0],["فقصعتها إذ حكمت حكم ربها","فما بقيت عارية ومعير",19,"ر",1,0],["فقصرت، إن الشيب من عدل حكمه","وإن كان جوراً أن يقال لك القصر",20,"ر",1,0],["فَقَصرُكُ مِنّي رَقيقُ الذُبا","بِ عَضبُ كَريهَتِهِ مُبترُ",21,"ر",1,0],["فَقَصرُكَ مَأَثورَةٌ إِن بَقيت","أَصحو بِها لَكَ أَو أَسكَرُ",21,"ر",1,0],["فَقَصرٌ مِنهُ بِالفُسطاطِ يَخلو","وَشَرواهُ لَهُ بِدِمَشقَ يُخلا",22,"ل",2,0],["فقصيّ بعض أخباري عليها","فاخباري تلين لكِ الحجارا",23,"ر",2,0],["فَقَصرُكِ منّى كلَّ يَومٍ قَصِيدةٌ","تَخِبُّ بها خُوصُ المَطِىِّ النَّزائِعُ",24,"ع",1,0],["فَقَصيرُ البيضِ مُفَلّلُهُ","وطَويلُ السمْر مُقصّدُهُ",25,"د",2,0],["فَقَصَرتُ يَومَهُمُ بِرَنَّةِ شارِفٍ","وَسَماعِ مُدجِنَةٍ وَجَدوى جازِرِ",26,"ر",1,0],["فقصَرنَ مُزدَهَف وَذو رَمَقٍ","مُتحامِلاً بحُشاشَةِ النَفسِ",27,"س",1,0],["فقَصِّر مَلامي فهْي جِدُّ قَصيرةٍ","وأقْلِلْ عتابي فهْيَ جِدُّ قلائل",28,"ل",1,0],["فقصَدْتُ المَولَى العزيزَ لكَي يَج","بُرَ من قلبيَ الكئيبِ انكِساره",29,"ر",2,0],["فَقَصِّروا عن ملامي إنَّني رجلٌ","لا أرتضي غيرَهُ ديناً ومعتَقَدا",30,"د",2,0],["فقصدت أفْوَدَ من قَصَدْتُ من الورى","وأتيتُ أبْرَكَ من أتيت ميمَّما",31,"م",2,0],["فقصّروا فرموني بالقبيح ولم","أكن الأرضاه في جدّ ولا لعب",32,"ب",1,0],["فَقَصَرْتَ مُدَّتَها بوقفةِ ساعَةٍ","أَبْقَتْ لَكَ الفخرَ الجليلَ مُخلَّدا",33,"د",2,0],["فَقَصْرُ مُلُوكِ الأَرْضِ سُدَّةُ قصره","وإِنْ سَحَقُوا بُعْداً وإِنْ شَحَطُوا نأْيا",34,"ي",2,0],["فقصاركم جميعاً صيدكم","يستوى الماكولُ بين الآكلين",35,"ن",1,0],["فقصَّر مشيتَه مكرهاً","نتيجةَ أدهمَ بالأمسِ حالا",36,"ل",2,0],["فقَصرَك يا خادعي من وفائي","لؤمت أعن كرمي أُخدعُ",37,"ع",1,0],["فقصرُ ما أوليتَ أن أجزيَهُ","جزاءه في المطلَقاتِ الحُبُسِ",38,"س",1,0],["فقصَّر كلُّ منتفخٍ هجينٍ","ومرَّ أقبُّ يطوِي الشوطَ نهدُ",39,"د",1,0],["فَقَصيٌّ مثلُ دانٍ في النَّدى","وكَمنْ خالَ الغِنى منْ لم يخلْ",40,"ل",1,0],["فقص عليه قصة ما أجابت","وقال ولم تدعها كالهشيم",41,"م",1,0],["فقَصَرْتُ تَشبيبي على ظَبَياتِهم","وحصَرْتُ مَدْحي في عليِّ الشّانِ",42,"ن",1,0],["فقصصتهنَّ وإنّما","دهري بمقراضي أخادع",43,"ع",1,0],["فقصدوا جماعة الأنصار","وهم مع الكثرة أهل الدار",44,"ر",1,0],["فَقصْدُهُ مُحَمَّدٌ","وَآلهُ وَصحْبُهُ",45,"ب",2,0],["فقص الذي من عينه قد أشانها","وأصلح ما يؤذيه منها ويتعب",46,"ب",1,0],["فقصرنَ الشّتاء بعد عليه","وهو للذّود إذ يقسّمنَ جار",47,"ر",1,0],["فَقُصُّوا عَلَيهِ ذَنبَنا وَتجاوَزوا","ذُنوبَهُم عِندَ القَصيصَةِ والأَثر",48,"ر",1,1],["فَقَصرَكِ انّي قد شهدتُ فلم أجد","بكفيّ عنهم للمنية مَدفعا",49,"ع",2,0]]}