{"poems":[[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[47,"أتعجب أن ملكنا الأرض قسرا","https://www.aldiwan.net/poem25350.html","الوافر"],[51,"وجدت أبا عبد الإله خليفة لصاحبه","https://www.aldiwan.net/poem8694.html","الطويل"],[51,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[38,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[45,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[49,"فقصر ما ترى بالصبر حقا","https://www.aldiwan.net/poem64277.html","الطويل"],[66,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[31,"تقول وليدتي لما رأتني","https://www.aldiwan.net/poem41270.html","الوافر"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[74,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9943","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[45,"هزيع دجى في الرأس بارده بدر","https://www.poetsgate.com/ViewPoem.aspx?id=31243",""]],"verses":[["فَقَصَّرتَ فيهِ كُلَّ سَمراءَ لَدنَةٍ","وَأَنحَلتَ فيهِ كُلَّ أَبيَضَ قاضِبِ",0,"ب",1,0],["فَقَصراً إِنَّ حالاً مَلَّكَتنا","لَحالٌ لا تُذَمُّ وَلا تُعابُ",1,"ب",1,0],["فقصَّرتُ في الأمرين والقلب مُضمِرٌ","مودَّتَهُ في مستقرِّ ثباتِهِ",2,"ت",2,0],["فقصدتُ ربحاً حاضراً","ورَفضْت أمراً كان خُسراً",3,"ر",2,0],["فَقَصَّرَ عَنّي اليَومَ كَأسٌ رَوِيَّةٌ","وَرَخصُ الشِواءِ وَالقِيانُ الصَوادِحُ",4,"ح",1,0],["فَقُصورُهُم كوخٌ وَبَيتُ بَداوَةٍ","وَقُبورُهُم صَرحٌ أَشَمُّ وَجَوسَقُ",5,"ق",1,0],["فَقَصرُكَ إِنّي حائِمٌ فَمُرَفرِفٌ","عَلى خُلُقي أَو ذاهِبٌ حَيثُ أَذهَبُ",6,"ب",1,0],["فَقَصرَكِ إِنَّ الشَيبَ مِن عَدلِ حُكمِهِ","وَإِن كانَ جَوراً أَن يُقالَ لَكِ القَصرُ",7,"ر",1,0],["فَقَصِّر ما تَرى بِالصَبرِ حَقّاً","فَكُلٌّ إِن صَبَرتَ لَهُ مُزيلُ",8,"ل",1,1],["فَقَصَدتَ البَيتَ الحَرامِ فَأَقصَد","تَ بِسَهمِ الرَدى قُلوبَ العُداةِ",9,"ه",1,0],["فقصدته عَجِلاً ولي بصرٌ","شبه الفراشة يعشق النورَا",10,"ر",2,0],["فَقَصَّ مَيسُرَةُ المَأمونُ قِصَّتَهُ","عَلَى خَديجَةَ سَرداً غَيرَ مُنعَجِمِ",11,"م",1,0],["فَقَصَّ عَلَيَّ ما يَلقى بِهِندٍ","فَذَكَّرَ بَعدَ ما كُنّا نَسينا",12,"ن",2,0],["فَقَصرُ أَناةِ الحِلمِ عَضَّةُ سَطوَةٍ","تُقيمُ صَغا تِلكَ القَنا وَتُسَوِّدُ",13,"د",1,0],["فَقُصارُ مُجتَمِعُ الأَصاحِبِ فِرقَةٌ","وَمَحارُ أَنوارِ الشَبابِ رَمادُ",14,"د",1,0],["فقصت زليخا فرعها من أصوله","وَكانَ يَزور الأرض ساعة ينشر",15,"ر",1,0],["فَقَصَّرَ عَن لَحاقي في المَعالي","وَقَد أَعيَت بِهِ أَيدي المَساعي",16,"ي",1,0],["فَقصَدْنهُ وَسَخِرْنَ مِنْ","زجرِ الأُمَيْمَاتِ الزَّوَاجِرْ",17,"ر",1,0],["فقصرت، إن الشيب من عدل حكمه","وإن كان جوراً أن يقال لك القصر",18,"ر",1,0]]}