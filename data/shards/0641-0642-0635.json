{"poems":[[108,"ما انفكت الناس في أديانها قددا","https://www.shoaraa.com/p11352",""],[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[47,"أتعجب أن ملكنا الأرض قسرا","https://www.aldiwan.net/poem25350.html","الوافر"],[51,"وجدت أبا عبد الإله خليفة لصاحبه","https://www.aldiwan.net/poem8694.html","الطويل"],[51,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[38,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[45,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[49,"فقصر ما ترى بالصبر حقا","https://www.aldiwan.net/poem64277.html","الطويل"],[66,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[31,"تقول وليدتي لما رأتني","https://www.aldiwan.net/poem41270.html","الوافر"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[74,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9943","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[45,"هزيع دجى في الرأس بارده بدر","https://www.poetsgate.com/ViewPoem.aspx?id=31243",""],[128,"أعباس إنا وما بيننا","https://www.aldiwan.net/poem24271.html","المتقارب"],[144,"محلك من محل الشمس أعلا","https://www.aldiwan.net/poem11806.html","الوافر"],[161,"أيرجو أن يزور وأن يزارا","https://www.aldiwan.net/poem58952.html","الوافر"],[182,"أقمت على رمان يوما وليلة","https://www.aldiwan.net/poem58873.html","الطويل"],[276,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[277,"هل عند عمرة من بتات مسافر","https://www.aldiwan.net/poem2239.html","الكامل"],[351,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[365,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[365,"أتراه بنفسه يذكر المولي","https://www.aldiwan.net/poem60885.html","الطويل"],[403,"هيهات ذلك دين لا أفارقه","https://www.aldiwan.net/poem46952.html","البسيط"],[417,"كن بالمدامة للسرور متمما","https://www.aldiwan.net/poem54035.html","الكامل"],[438,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[440,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[440,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[454,"اضحكوا ثم اضحكوا يا هازلين","https://www.aldiwan.net/poem61608.html","الرمل"],[459,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[459,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[459,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[459,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[462,"وعلى الأيام من نعمائه","https://www.aldiwan.net/poem16075.html","الرمل"],[496,"ومضطغن على الألباب قاس","https://www.aldiwan.net/poem10272.html","الوافر"],[515,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[528,"لاحت لوجهي أنجم","https://www.aldiwan.net/poem45957.html","مجزوء الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"هذا الذي أحبه","https://www.aldiwan.net/poem17421.html","مجزوء الرجز"],[588,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["فقَصروا العمرَ في هَدْيِ الأنامِ ولم","يَكُنْ لِيَحْيَى الهُدى إلا بِكَبشِ فِدا",0,"د",2,0],["فَقَصَّرتَ فيهِ كُلَّ سَمراءَ لَدنَةٍ","وَأَنحَلتَ فيهِ كُلَّ أَبيَضَ قاضِبِ",1,"ب",1,0],["فَقَصراً إِنَّ حالاً مَلَّكَتنا","لَحالٌ لا تُذَمُّ وَلا تُعابُ",2,"ب",1,0],["فقصَّرتُ في الأمرين والقلب مُضمِرٌ","مودَّتَهُ في مستقرِّ ثباتِهِ",3,"ت",2,0],["فقصدتُ ربحاً حاضراً","ورَفضْت أمراً كان خُسراً",4,"ر",2,0],["فَقَصَّرَ عَنّي اليَومَ كَأسٌ رَوِيَّةٌ","وَرَخصُ الشِواءِ وَالقِيانُ الصَوادِحُ",5,"ح",1,0],["فَقُصورُهُم كوخٌ وَبَيتُ بَداوَةٍ","وَقُبورُهُم صَرحٌ أَشَمُّ وَجَوسَقُ",6,"ق",1,0],["فَقَصرُكَ إِنّي حائِمٌ فَمُرَفرِفٌ","عَلى خُلُقي أَو ذاهِبٌ حَيثُ أَذهَبُ",7,"ب",1,0],["فَقَصرَكِ إِنَّ الشَيبَ مِن عَدلِ حُكمِهِ","وَإِن كانَ جَوراً أَن يُقالَ لَكِ القَصرُ",8,"ر",1,0],["فَقَصِّر ما تَرى بِالصَبرِ حَقّاً","فَكُلٌّ إِن صَبَرتَ لَهُ مُزيلُ",9,"ل",1,1],["فَقَصَدتَ البَيتَ الحَرامِ فَأَقصَد","تَ بِسَهمِ الرَدى قُلوبَ العُداةِ",10,"ه",1,0],["فقصدته عَجِلاً ولي بصرٌ","شبه الفراشة يعشق النورَا",11,"ر",2,0],["فَقَصَّ مَيسُرَةُ المَأمونُ قِصَّتَهُ","عَلَى خَديجَةَ سَرداً غَيرَ مُنعَجِمِ",12,"م",1,0],["فَقَصَّ عَلَيَّ ما يَلقى بِهِندٍ","فَذَكَّرَ بَعدَ ما كُنّا نَسينا",13,"ن",2,0],["فَقَصرُ أَناةِ الحِلمِ عَضَّةُ سَطوَةٍ","تُقيمُ صَغا تِلكَ القَنا وَتُسَوِّدُ",14,"د",1,0],["فَقُصارُ مُجتَمِعُ الأَصاحِبِ فِرقَةٌ","وَمَحارُ أَنوارِ الشَبابِ رَمادُ",15,"د",1,0],["فقصت زليخا فرعها من أصوله","وَكانَ يَزور الأرض ساعة ينشر",16,"ر",1,0],["فَقَصَّرَ عَن لَحاقي في المَعالي","وَقَد أَعيَت بِهِ أَيدي المَساعي",17,"ع",2,0],["فَقصَدْنهُ وَسَخِرْنَ مِنْ","زجرِ الأُمَيْمَاتِ الزَّوَاجِرْ",18,"ر",1,0],["فقصرت، إن الشيب من عدل حكمه","وإن كان جوراً أن يقال لك القصر",19,"ر",1,0],["فَقَصرُكُ مِنّي رَقيقُ الذُبا","بِ عَضبُ كَريهَتِهِ مُبترُ",20,"ر",1,0],["فَقَصرُكَ مَأَثورَةٌ إِن بَقيت","أَصحو بِها لَكَ أَو أَسكَرُ",20,"ر",1,0],["فَقَصرٌ مِنهُ بِالفُسطاطِ يَخلو","وَشَرواهُ لَهُ بِدِمَشقَ يُخلا",21,"ل",2,0],["فقصيّ بعض أخباري عليها","فاخباري تلين لكِ الحجارا",22,"ر",2,0],["فَقَصرُكِ منّى كلَّ يَومٍ قَصِيدةٌ","تَخِبُّ بها خُوصُ المَطِىِّ النَّزائِعُ",23,"ع",1,0],["فَقَصيرُ البيضِ مُفَلّلُهُ","وطَويلُ السمْر مُقصّدُهُ",24,"د",2,0],["فَقَصَرتُ يَومَهُمُ بِرَنَّةِ شارِفٍ","وَسَماعِ مُدجِنَةٍ وَجَدوى جازِرِ",25,"ر",1,0],["فقصَرنَ مُزدَهَف وَذو رَمَقٍ","مُتحامِلاً بحُشاشَةِ النَفسِ",26,"س",1,0],["فقَصِّر مَلامي فهْي جِدُّ قَصيرةٍ","وأقْلِلْ عتابي فهْيَ جِدُّ قلائل",27,"ل",1,0],["فقصَدْتُ المَولَى العزيزَ لكَي يَج","بُرَ من قلبيَ الكئيبِ انكِساره",28,"ر",2,0],["فَقَصِّروا عن ملامي إنَّني رجلٌ","لا أرتضي غيرَهُ ديناً ومعتَقَدا",29,"د",2,0],["فقصدت أفْوَدَ من قَصَدْتُ من الورى","وأتيتُ أبْرَكَ من أتيت ميمَّما",30,"م",2,0],["فقصّروا فرموني بالقبيح ولم","أكن الأرضاه في جدّ ولا لعب",31,"ب",1,0],["فَقَصَرْتَ مُدَّتَها بوقفةِ ساعَةٍ","أَبْقَتْ لَكَ الفخرَ الجليلَ مُخلَّدا",32,"د",2,0],["فَقَصْرُ مُلُوكِ الأَرْضِ سُدَّةُ قصره","وإِنْ سَحَقُوا بُعْداً وإِنْ شَحَطُوا نأْيا",33,"ي",2,0],["فقصاركم جميعاً صيدكم","يستوى الماكولُ بين الآكلين",34,"ن",1,0],["فقصَّر مشيتَه مكرهاً","نتيجةَ أدهمَ بالأمسِ حالا",35,"ل",2,0],["فقَصرَك يا خادعي من وفائي","لؤمت أعن كرمي أُخدعُ",36,"ع",1,0],["فقصرُ ما أوليتَ أن أجزيَهُ","جزاءه في المطلَقاتِ الحُبُسِ",37,"س",1,0],["فقصَّر كلُّ منتفخٍ هجينٍ","ومرَّ أقبُّ يطوِي الشوطَ نهدُ",38,"د",1,0],["فَقَصيٌّ مثلُ دانٍ في النَّدى","وكَمنْ خالَ الغِنى منْ لم يخلْ",39,"ل",1,0],["فقص عليه قصة ما أجابت","وقال ولم تدعها كالهشيم",40,"م",1,0],["فقَصَرْتُ تَشبيبي على ظَبَياتِهم","وحصَرْتُ مَدْحي في عليِّ الشّانِ",41,"ن",1,0],["فقصصتهنَّ وإنّما","دهري بمقراضي أخادع",42,"ع",1,0],["فقصدوا جماعة الأنصار","وهم مع الكثرة أهل الدار",43,"ر",1,0],["فَقصْدُهُ مُحَمَّدٌ","وَآلهُ وَصحْبُهُ",44,"ب",2,0],["فقص الذي من عينه قد أشانها","وأصلح ما يؤذيه منها ويتعب",45,"ب",1,0]]}