{"poems":[[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[47,"أتعجب أن ملكنا الأرض قسرا","https://www.aldiwan.net/poem25350.html","الوافر"],[51,"وجدت أبا عبد الإله خليفة لصاحبه","https://www.aldiwan.net/poem8694.html","الطويل"],[51,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[38,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[45,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[49,"فقصر ما ترى بالصبر حقا","https://www.aldiwan.net/poem64277.html","الطويل"],[66,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[31,"تقول وليدتي لما رأتني","https://www.aldiwan.net/poem41270.html","الوافر"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[74,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9943","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[45,"هزيع دجى في الرأس بارده بدر","https://www.poetsgate.com/ViewPoem.aspx?id=31243",""],[125,"أعباس إنا وما بيننا","https://www.aldiwan.net/poem24271.html","المتقارب"],[141,"محلك من محل الشمس أعلا","https://www.aldiwan.net/poem11806.html","الوافر"],[158,"أيرجو أن يزور وأن يزارا","https://www.aldiwan.net/poem58952.html","الوافر"],[179,"أقمت على رمان يوما وليلة","https://www.aldiwan.net/poem58873.html","الطويل"],[273,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[274,"هل عند عمرة من بتات مسافر","https://www.aldiwan.net/poem2239.html","الكامل"],[348,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[362,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[362,"أتراه بنفسه يذكر المولي","https://www.aldiwan.net/poem60885.html","الطويل"],[399,"هيهات ذلك دين لا أفارقه","https://www.aldiwan.net/poem46952.html","البسيط"],[413,"كن بالمدامة للسرور متمما","https://www.aldiwan.net/poem54035.html","الكامل"],[434,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[436,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[436,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[451,"اضحكوا ثم اضحكوا يا هازلين","https://www.aldiwan.net/poem61608.html","الرمل"],[456,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[456,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[456,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[456,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[459,"وعلى الأيام من نعمائه","https://www.aldiwan.net/poem16075.html","الرمل"],[493,"ومضطغن على الألباب قاس","https://www.aldiwan.net/poem10272.html","الوافر"],[512,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[525,"لاحت لوجهي أنجم","https://www.aldiwan.net/poem45957.html","مجزوء الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"هذا الذي أحبه","https://www.aldiwan.net/poem17421.html","مجزوء الرجز"],[585,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["فَقَصَّرتَ فيهِ كُلَّ سَمراءَ لَدنَةٍ","وَأَنحَلتَ فيهِ كُلَّ أَبيَضَ قاضِبِ",0,"ب",1,0],["فَقَصراً إِنَّ حالاً مَلَّكَتنا","لَحالٌ لا تُذَمُّ وَلا تُعابُ",1,"ب",1,0],["فقصَّرتُ في الأمرين والقلب مُضمِرٌ","مودَّتَهُ في مستقرِّ ثباتِهِ",2,"ت",2,0],["فقصدتُ ربحاً حاضراً","ورَفضْت أمراً كان خُسراً",3,"ر",2,0],["فَقَصَّرَ عَنّي اليَومَ كَأسٌ رَوِيَّةٌ","وَرَخصُ الشِواءِ وَالقِيانُ الصَوادِحُ",4,"ح",1,0],["فَقُصورُهُم كوخٌ وَبَيتُ بَداوَةٍ","وَقُبورُهُم صَرحٌ أَشَمُّ وَجَوسَقُ",5,"ق",1,0],["فَقَصرُكَ إِنّي حائِمٌ فَمُرَفرِفٌ","عَلى خُلُقي أَو ذاهِبٌ حَيثُ أَذهَبُ",6,"ب",1,0],["فَقَصرَكِ إِنَّ الشَيبَ مِن عَدلِ حُكمِهِ","وَإِن كانَ جَوراً أَن يُقالَ لَكِ القَصرُ",7,"ر",1,0],["فَقَصِّر ما تَرى بِالصَبرِ حَقّاً","فَكُلٌّ إِن صَبَرتَ لَهُ مُزيلُ",8,"ل",1,1],["فَقَصَدتَ البَيتَ الحَرامِ فَأَقصَد","تَ بِسَهمِ الرَدى قُلوبَ العُداةِ",9,"ه",1,0],["فقصدته عَجِلاً ولي بصرٌ","شبه الفراشة يعشق النورَا",10,"ر",2,0],["فَقَصَّ مَيسُرَةُ المَأمونُ قِصَّتَهُ","عَلَى خَديجَةَ سَرداً غَيرَ مُنعَجِمِ",11,"م",1,0],["فَقَصَّ عَلَيَّ ما يَلقى بِهِندٍ","فَذَكَّرَ بَعدَ ما كُنّا نَسينا",12,"ن",2,0],["فَقَصرُ أَناةِ الحِلمِ عَضَّةُ سَطوَةٍ","تُقيمُ صَغا تِلكَ القَنا وَتُسَوِّدُ",13,"د",1,0],["فَقُصارُ مُجتَمِعُ الأَصاحِبِ فِرقَةٌ","وَمَحارُ أَنوارِ الشَبابِ رَمادُ",14,"د",1,0],["فقصت زليخا فرعها من أصوله","وَكانَ يَزور الأرض ساعة ينشر",15,"ر",1,0],["فَقَصَّرَ عَن لَحاقي في المَعالي","وَقَد أَعيَت بِهِ أَيدي المَساعي",16,"ي",1,0],["فَقصَدْنهُ وَسَخِرْنَ مِنْ","زجرِ الأُمَيْمَاتِ الزَّوَاجِرْ",17,"ر",1,0],["فقصرت، إن الشيب من عدل حكمه","وإن كان جوراً أن يقال لك القصر",18,"ر",1,0],["فَقَصرُكُ مِنّي رَقيقُ الذُبا","بِ عَضبُ كَريهَتِهِ مُبترُ",19,"ر",1,0],["فَقَصرُكَ مَأَثورَةٌ إِن بَقيت","أَصحو بِها لَكَ أَو أَسكَرُ",19,"ر",1,0],["فَقَصرٌ مِنهُ بِالفُسطاطِ يَخلو","وَشَرواهُ لَهُ بِدِمَشقَ يُخلا",20,"ل",2,0],["فقصيّ بعض أخباري عليها","فاخباري تلين لكِ الحجارا",21,"ر",2,0],["فَقَصرُكِ منّى كلَّ يَومٍ قَصِيدةٌ","تَخِبُّ بها خُوصُ المَطِىِّ النَّزائِعُ",22,"ع",1,0],["فَقَصيرُ البيضِ مُفَلّلُهُ","وطَويلُ السمْر مُقصّدُهُ",23,"د",2,0],["فَقَصَرتُ يَومَهُمُ بِرَنَّةِ شارِفٍ","وَسَماعِ مُدجِنَةٍ وَجَدوى جازِرِ",24,"ر",1,0],["فقصَرنَ مُزدَهَف وَذو رَمَقٍ","مُتحامِلاً بحُشاشَةِ النَفسِ",25,"س",1,0],["فقَصِّر مَلامي فهْي جِدُّ قَصيرةٍ","وأقْلِلْ عتابي فهْيَ جِدُّ قلائل",26,"ل",1,0],["فقصَدْتُ المَولَى العزيزَ لكَي يَج","بُرَ من قلبيَ الكئيبِ انكِساره",27,"ر",2,0],["فَقَصِّروا عن ملامي إنَّني رجلٌ","لا أرتضي غيرَهُ ديناً ومعتَقَدا",28,"د",2,0],["فقصدت أفْوَدَ من قَصَدْتُ من الورى","وأتيتُ أبْرَكَ من أتيت ميمَّما",29,"م",2,0],["فقصّروا فرموني بالقبيح ولم","أكن الأرضاه في جدّ ولا لعب",30,"ب",1,0],["فَقَصَرْتَ مُدَّتَها بوقفةِ ساعَةٍ","أَبْقَتْ لَكَ الفخرَ الجليلَ مُخلَّدا",31,"د",2,0],["فَقَصْرُ مُلُوكِ الأَرْضِ سُدَّةُ قصره","وإِنْ سَحَقُوا بُعْداً وإِنْ شَحَطُوا نأْيا",32,"ي",2,0],["فقصاركم جميعاً صيدكم","يستوى الماكولُ بين الآكلين",33,"ن",1,0],["فقصَّر مشيتَه مكرهاً","نتيجةَ أدهمَ بالأمسِ حالا",34,"ل",2,0],["فقَصرَك يا خادعي من وفائي","لؤمت أعن كرمي أُخدعُ",35,"ع",1,0],["فقصرُ ما أوليتَ أن أجزيَهُ","جزاءه في المطلَقاتِ الحُبُسِ",36,"س",1,0],["فقصَّر كلُّ منتفخٍ هجينٍ","ومرَّ أقبُّ يطوِي الشوطَ نهدُ",37,"د",1,0],["فَقَصيٌّ مثلُ دانٍ في النَّدى","وكَمنْ خالَ الغِنى منْ لم يخلْ",38,"ل",1,0],["فقص عليه قصة ما أجابت","وقال ولم تدعها كالهشيم",39,"م",1,0],["فقَصَرْتُ تَشبيبي على ظَبَياتِهم","وحصَرْتُ مَدْحي في عليِّ الشّانِ",40,"ن",1,0],["فقصصتهنَّ وإنّما","دهري بمقراضي أخادع",41,"ع",1,0],["فقصدوا جماعة الأنصار","وهم مع الكثرة أهل الدار",42,"ر",1,0],["فَقصْدُهُ مُحَمَّدٌ","وَآلهُ وَصحْبُهُ",43,"ب",2,0],["فقص الذي من عينه قد أشانها","وأصلح ما يؤذيه منها ويتعب",44,"ب",1,0]]}