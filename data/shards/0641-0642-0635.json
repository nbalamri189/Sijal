],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32814","الطويل"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114651","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77192","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44689","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125899","الرمل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78194","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135091","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198227","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83175","الوافر"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"],[4684,"الطائر المهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=201382",""],[4809,"وفوق الرمل من يبني سيشقى","https://www.poetsgate.com/ViewPoem.aspx?id=201475",""],[4818,"ثاني الجنتين","https://www.poetsgate.com/ViewPoem.aspx?id=203511",""],[4941,"كأسٌ لانقراض ساعي البريد","https://www.poetsgate.com/ViewPoem.aspx?id=178743",""],[4978,"رد على قصيدة زينب علي","https://www.poetsgate.com/ViewPoem.aspx?id=177303",""],[4984,"التباري1","https://www.poetsgate.com/ViewPoem.aspx?id=186524",""],[5083,"بُنودُ الشَّام","https://www.poetsgate.com/ViewPoem.aspx?id=53878",""],[5092,"ذبول على غصن الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=176736",""],[5111,"بَرْقُ الْقَصَائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=212499",""],[5121,"وَجْهُ الآهَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=214874",""],[5145,"البين فرق بين جفني والكرى","https://www.poetsgate.com/ViewPoem.aspx?id=108235",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5216,"مع سيرة الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=187130",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5376,"وقامت أُخيَّة تلقي السلام......من حماه","https://www.poetsgate.com/ViewPoem.aspx?id=188421",""],[5493,"أتيتُ أُناجِي","https://www.poetsgate.com/ViewPoem.aspx?id=196982",""],[5628,"لقاء في هيروشيما(1)","https://www.poetsgate.com/ViewPoem.aspx?id=178534",""],[5708,"وَرَدَ الورى سلسالَ جودك فارتَوْوا","https://www.poetsgate.com/ViewPoem.aspx?id=158079",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5906,"أنا المولود في كنف الخطايا","https://www.poetsgate.com/ViewPoem.aspx?id=188020",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5969,"تَدري بك الحسناءُ يا مَفتونُ","https://www.poetsgate.com/ViewPoem.aspx?id=198715",""],[6093,"قصيدة تمشي","https://www.poetsgate.com/ViewPoem.aspx?id=197547",""]],"verses":[["فقَصروا العمرَ في هَدْيِ الأنامِ ولم","يَكُنْ لِيَحْيَى الهُدى إلا بِكَبشِ فِدا",0,"د",2,0],["فَقَصَّرتَ فيهِ كُلَّ سَمراءَ لَدنَةٍ","وَأَنحَلتَ فيهِ كُلَّ أَبيَضَ قاضِبِ",1,"ب",1,0],["فَقَصراً إِنَّ حالاً مَلَّكَتنا","لَحالٌ لا تُذَمُّ وَلا تُعابُ",2,"ب",1,0],["فقصَّرتُ في الأمرين والقلب مُضمِرٌ","مودَّتَهُ في مستقرِّ ثباتِهِ",3,"ت",2,0],["فقصدتُ ربحاً حاضراً","ورَفضْت أمراً كان خُسراً",4,"ر",2,0],["فَقَصَّرَ عَنّي اليَومَ كَأسٌ رَوِيَّةٌ","وَرَخصُ الشِواءِ وَالقِيانُ الصَوادِحُ",5,"ح",1,0],["فَقُصورُهُم كوخٌ وَبَيتُ بَداوَةٍ","وَقُبورُهُم صَرحٌ أَشَمُّ وَجَوسَقُ",6,"ق",1,0],["فَقَصرُكَ إِنّي حائِمٌ فَمُرَفرِفٌ","عَلى خُلُقي أَو ذاهِبٌ حَيثُ أَذهَبُ",7,"ب",1,0],["فَقَصرَكِ إِنَّ الشَيبَ مِن عَدلِ حُكمِهِ","وَإِن كانَ جَوراً أَن يُقالَ لَكِ القَصرُ",8,"ر",1,0],["فَقَصِّر ما تَرى بِالصَبرِ حَقّاً","فَكُلٌّ إِن صَبَرتَ لَهُ مُزيلُ",9,"ل",1,1],["فَقَصَدتَ البَيتَ الحَرامِ فَأَقصَد","تَ بِسَهمِ الرَدى قُلوبَ العُداةِ",10,"ه",1,0],["فقصدته عَجِلاً ولي بصرٌ","شبه الفراشة يعشق النورَا",11,"ر",2,0],["فَقَصَّ مَيسُرَةُ المَأمونُ قِصَّتَهُ","عَلَى خَديجَةَ سَرداً غَيرَ مُنعَجِمِ",12,"م",1,0],["فَقَصَّ عَلَيَّ ما يَلقى بِهِندٍ","فَذَكَّرَ بَعدَ ما كُنّا نَسينا",13,"ن",2,0],["فَقَصرُ أَناةِ الحِلمِ عَضَّةُ سَطوَةٍ","تُقيمُ صَغا تِلكَ القَنا وَتُسَوِّدُ",14,"د",1,0],["فَقُصارُ مُجتَمِعُ الأَصاحِبِ فِرقَةٌ","وَمَحارُ أَنوارِ الشَبابِ رَمادُ",15,"د",1,0],["فقصت زليخا فرعها من أصوله","وَكانَ يَزور الأرض ساعة ينشر",16,"ر",1,0],["فَقَصَّرَ عَن لَحاقي في المَعالي","وَقَد أَعيَت بِهِ أَيدي المَساعي",17,"ع",2,0],["فَقصَدْنهُ وَسَخِرْنَ مِنْ","زجرِ الأُمَيْمَاتِ الزَّوَاجِرْ",18,"ر",1,0],["فقصعتها إذ حكمت حكم ربها","فما بقيت عارية ومعير",19,"ر",1,0],["فقصرت، إن الشيب من عدل حكمه","وإن كان جوراً أن يقال لك القصر",20,"ر",1,0],["فَقَصرُكُ مِنّي رَقيقُ الذُبا","بِ عَضبُ كَريهَتِهِ مُبترُ",21,"ر",1,0],["فَقَصرُكَ مَأَثورَةٌ إِن بَقيت","أَصحو بِها لَكَ أَو أَسكَرُ",21,"ر",1,0],["فَقَصرٌ مِنهُ بِالفُسطاطِ يَخلو","وَشَرواهُ لَهُ بِدِمَشقَ يُخلا",22,"ل",2,0],["فقصيّ بعض أخباري عليها","فاخباري تلين لكِ الحجارا",23,"ر",2,0],["فَقَصرُكِ منّى كلَّ يَومٍ قَصِيدةٌ","تَخِبُّ بها خُوصُ المَطِىِّ النَّزائِعُ",24,"ع",1,0],["فَقَصيرُ البيضِ مُفَلّلُهُ","وطَويلُ السمْر مُقصّدُهُ",25,"د",2,0],["فَقَصَرتُ يَومَهُمُ بِرَنَّةِ شارِفٍ","وَسَماعِ مُدجِنَةٍ وَجَدوى جازِرِ",26,"ر",1,0],["فقصَرنَ مُزدَهَف وَذو رَمَقٍ","مُتحامِلاً بحُشاشَةِ النَفسِ",27,"س",1,0],["فقَصِّر مَلامي فهْي جِدُّ قَصيرةٍ","وأقْلِلْ عتابي فهْيَ جِدُّ قلائل",28,"ل",1,0],["فقصَدْتُ المَولَى العزيزَ لكَي يَج","بُرَ من قلبيَ الكئيبِ انكِساره",29,"ر",2,0],["فَقَصِّروا عن ملامي إنَّني رجلٌ","لا أرتضي غيرَهُ ديناً ومعتَقَدا",30,"د",2,0],["فقصدت أفْوَدَ من قَصَدْتُ من الورى","وأتيتُ أبْرَكَ من أتيت ميمَّما",31,"م",2,0],["فقصّروا فرموني بالقبيح ولم","أكن الأرضاه في جدّ ولا لعب",32,"ب",1,0],["فَقَصَرْتَ مُدَّتَها بوقفةِ ساعَةٍ","أَبْقَتْ لَكَ الفخرَ الجليلَ مُخلَّدا",33,"د",2,0],["فَقَصْرُ مُلُوكِ الأَرْضِ سُدَّةُ قصره","وإِنْ سَحَقُوا بُعْداً وإِنْ شَحَطُوا نأْيا",34,"ي",2,0],["فقصاركم جميعاً صيدكم","يستوى الماكولُ بين الآكلين",35,"ن",1,0],["فقصَّر مشيتَه مكرهاً","نتيجةَ أدهمَ بالأمسِ حالا",36,"ل",2,0],["فقَصرَك يا خادعي من وفائي","لؤمت أعن كرمي أُخدعُ",37,"ع",1,0],["فقصرُ ما أوليتَ أن أجزيَهُ","جزاءه في المطلَقاتِ الحُبُسِ",38,"س",1,0],["فقصَّر كلُّ منتفخٍ هجينٍ","ومرَّ أقبُّ يطوِي الشوطَ نهدُ",39,"د",1,0],["فَقَصيٌّ مثلُ دانٍ في النَّدى","وكَمنْ خالَ الغِنى منْ لم يخلْ",40,"ل",1,0],["فقص عليه قصة ما أجابت","وقال ولم تدعها كالهشيم",41,"م",1,0],["فقَصَرْتُ تَشبيبي على ظَبَياتِهم","وحصَرْتُ مَدْحي في عليِّ الشّانِ",42,"ن",1,0],["فقصصتهنَّ وإنّما","دهري بمقراضي أخادع",43,"ع",1,0],["فقصدوا جماعة الأنصار","وهم مع الكثرة أهل الدار",44,"ر",1,0],["فَقصْدُهُ مُحَمَّدٌ","وَآلهُ وَصحْبُهُ",45,"ب",2,0],["فقص الذي من عينه قد أشانها","وأصلح ما يؤذيه منها ويتعب",46,"ب",1,0],["فقصورها كل البها مستجمع","فيهنّ بل كل الروا مستكمل",47,"ل",1,0],["فَقُصارُ حَنَّتِها السُّلُوّ لأنهم","قالوا لأولِ كلِّ شيء آخرُ",48,"ر",1,0],["فقصّةُ الحبِّ إن عَدلْتَ بها","عن سَنَنِ الحزم أَصْبَحَتْ قِصصا",49,"ص",2,0],["فَقَصَّ ذا عَلى رُعاةِ الناس","هُم المُلوك رَأسُ كُل راسِ",50,"س",1,0],["فَقَصد الدَواء وَالعِلاجا","لِنَفسِهِ وَطَلَبَ الزَواجا",51,"ج",2,0],["فقصارى كل امرىءٍ عن قريب","منزل موحشٌ بأرض فلاة",52,"ه",1,0],["فقصورهم قد هدمت وجنانهم","قد صرّمت وسلاحهم في الشاعل",53,"ل",1,0],["فقصر الرحمن في عمره","ولا نما عمر أخيه عمر",54,"ر",1,0],["فقصرنَ الشّتاء بعد عليه","وهو للذّود إذ يقسّمنَ جار",55,"ر",1,0],["فَقَصَّرَتْ النَّاِئباتُ اللِّسَان","كما أضْعَفتْ قُوَّتي في الجنان",56,"ن",1,0],["فَقصر ليلي ما أَردت وصالكم","وَإِن كانَ لَيل العاشِقين طَويلا",57,"ل",2,0],["فقصدك ربي خير قصد وفيه يا","خليلي جميل الفوز والسعد والولا",58,"ل",2,0],["فَقَصَد المَرعى فَخاضَ طينا","فَظَل فيهِ موثقاً رَهينا",59,"ن",2,0],["فَقَصَدت أَخذي وَشدت كلها","وَلطف رَبي وَحده يغلها",60,"ه",2,0],["فقصرت تفريطاً عن الأمر مطلقاً","وقارفت تغريراً لنهي الشريعة",61,"ه",1,0],["فقصرهن لما طلن حتى","استوين عليه لا أمسي سويا",62,"ي",2,0],["فقصارى الحلوب كف طلاها","وقصارى الركوب ان تستقلا",63,"ل",2,0],["فقصَدتُ اللَه بلا زاد","أيُضامُ الخالي بحيِّهم",64,"م",1,0],["فقصار مثلى علمه من أنهم","أهل الوفا فلعلهم وعسى همو",65,"م",2,0],["فقصراً عنه فيما رامه فغدا","يرمي بقوسين أو يسطو بسيفين",66,"ن",1,0],["فقصدت أفضلها المُفضَّل قادما","نحو المقدَّم زاهدا فيمن بقي",67,"ق",2,0],["فقَصّرت عنها بعد طول لجاجة","وحبّ لها في سر أمري وفي الجهر",68,"ر",1,0],["فَقَصَّر عَنهُم مَن يَروم لحاقهم","كَما تَظلع العَرجاءُ خَلف ظعونها",69,"ن",3,0],["فَقَصَّ في السفرِ آلاماً وَموجِدَةً","وَوَصفَ أَمكِنَةٍ مِمّا اِحتَوَت حالُ",70,"ل",1,0],["فقصرت عن نيلها المطلوبا","واستوجبت للعلة الطبيبا",71,"ب",2,0],["فقصدت الشاطئ الها","دي أناجيه بحالي",72,"ي",1,0],["فقصدتَ مجد وروت تَرْهَق ظلَّها","كيما تُقيلَ بِهَا وتَرْتُقَ فَتقا",73,"ق",2,0],["فقَصْدُ العبْدِ إنْعامٌ بإذنٍ","فكَمْ لعُلاكَ من نعَمٍ عميمَهْ",74,"م",2,0],["فَقَصوا لَهُ عَنّي تباريح لَوعَتي","عَسى يَذكر المُشتاقُ في طَيِّ رَقعةِ",75,"ه",1,0],["فَقُصورُ عَصرِكَ دونَ شُمِّ قُبورِهِم","وَلَقَد يَلَذُّ لِعَصرِكَ التَّقليدُ",76,"د",1,0],["فَقُصُّوا عَلَيهِ ذَنبَنا وَتجاوَزوا","ذُنوبَهُم عِندَ القَصيصَةِ والأَثر",77,"ر",1,1],["فقصور من ساكنيها خوالٍ","ناجت البوم فوقها الغربان",78,"ن",1,0],["فَقَصرُ اِبنِ حَمدونٍ إِلى الشارِعِ الَّذي","غَنينا بِهِ وَالعَيشُ مُقتَبِلٌ رَغدُ",79,"د",1,0],["فقصارهن مع الهموم طويلة","وطوالهن مع السرور قصار",80,"ر",1,1],["فَقصدت بابَك راجِياً بَل عالِماً","فَقري إِلى جَدواكَ مِفتاح الغِنى",81,"ن",2,0],["فَقَصَدتُ بَيتي مُسلِماً","لَمّا بِهِ حلم القَدرْ",82,"ر",1,0],["فقصاراه صدود عنهم","دام لا يفتك أو لا يحقد",83,"د",1,0],["فَقَصَدت ساحَة عَفوِهِ متسربِلا","بِجنايَتي مُتَوَحِّشاً بِحَيائي",84,"ي",1,0],["فقصدي المعالي وهي إربي وطالما","أسائلها فيم الوصول إلى الوفد",85,"د",1,0],["فَقصرَ فَجِّ المجلسِ الأَعلى الَّذي","أوهَتهُ أحداثُ الليالي فَوَهَى",86,"ا",1,0],["فقصدنا ناديكَ والقَلبُ يدعُو","لكَ بالعِزِّ واللُّهَى تَتَرَّنمْ",87,"م",1,0],["فَقصّرَ وَالبَراثِنُ مُشرَعاتٌ","كَأَنَّ القَبرَ حينَ حَواهُ غابُ",88,"ب",1,0],["فَقَصرَكِ انّي قد شهدتُ فلم أجد","بكفيّ عنهم للمنية مَدفعا",89,"ع",2,0],["فقصيدي بعد ألفٍ مفحماتٍ","قصد الصفر وأضحى فحم نتفةْ",90,"ف",2,0],["ف(قصرُ العظم) لم يسلم بناءً","وقبل فلم نرَ إلاه أفقا",91,"ق",2,0],["فقصيدَتي روحي وأنتِ دماؤُها","عطرٌ تشظّى كانفجارِ القنْبلَة",92,"ل",2,0],["فقصّ الحاكمونَ ضفيرتيها","وباعوا رملَها الذهبيّ جهرا",93,"ر",2,0],["فقصائدها فيه تجلت","عن أجمل لحن وصفات",94,"ت",1,0],["فقصوا ما لديهم من","عجيب القول يبهرنا",95,"ن",2,0],["فقَصْرٌ لا أُساسَ له مَتينٌ","تُقَوِّضُهُ العَواصِفُ والرُعودُ",96,"د",1,0],["فقصائدي حورٌ وطيشيَ عالمي","وتُرَاقِصُ الطيشَ المقيّدَ حورُ",97,"ر",1,0],["فَقَصَائِدِيْ بَرْقٌ سَنَا يعْنُو لَهَا","فَلَكُ النُّجُومِ ،وَضَاءَتِ الأضْوَاءُ",98,"و",3,1],["فَقِصَّةُ الْعُمْرِ حِينَ نَسْرِدُهَا","تَحْتَاجُ عُمْرَاً دُونَ انْقِبَاضَاتِ",99,"ت",1,0],["فقصور ناحية المصلّى إنها","أنموذج الجنات حطّ لينظرا",100,"ر",2,0],["فقص ما كان بالتفصيل أجمعه","قال الحسين اذكرني حين تأتيها",101,"ي",3,0],["فقُصورُ بُصرى تَستعِدُّ بلَهفَةٍ","ونخيلُ يثربَ للحبيبِ تَشَوَّقا",102,"ق",2,0],["فقصَّ على الشريفةِ ما لقاه","بذات الغار من أمر القضاءِ",103,"ا",2,0],["فقصف فرعد فزلزال أرض","فموت يصيب فدارٌ حطامْ",104,"م",1,0],["فَقصْقصْتَ هُدبي بالصّدود معذبًا","وغبتَ فجفّ الغيْم والهجْرُ يُحرِقُ",105,"ق",1,0],["فقصدتُ نصْبا للضحايا حاملاً","زهْرا وفي قلبي أسىً ونواحُ",106,"ح",1,0],["فقصدتُ مقصِدَهُمْ وجئتُك راجيًا","ووقفتُ خلف الوِرد وقفةَ حائم",107,"م",1,0],["فقصدْتكم ارجو المودةَ منكمُ","او جودٓكم مطر السما هطّالا",108,"ل",2,0],["فَقَصْدِي بِالهِدايَةِ جُلُّ هَمّي","إذا ما تُبتُ تَغفِرُ لِي ذُنُوبِي",109,"ب",2,0],["فقصيده ونشيده قبس","للمستضين شهابه فسح",110,"ح",1,0],["فَقَصيدُكَ اللماحُ يُدرِكُ أَنَّهُ","مُتفردٌ وَمُتَيَّمٌ وَحَنونُ",111,"ن",1,0],["فقصيدتِي تَمشي على قَدمٍ","والنَّاقدونَ بشَطْرِها سَكْرَى",112,"ر",2,0]]}