{"poems":[[55,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[74,"قد آثر القوم من بيروت همهم","https://www.aldiwan.net/poem18616.html","البسيط"],[53,"ليس كالسكر دواء لغناء كالدواء","https://www.aldiwan.net/poem7970.html","مجزوء الرمل"],[53,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[45,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[45,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[51,"ذهب الحرص بأصحاب الدلج","https://www.aldiwan.net/poem62023.html","الرمل"],[51,"خير أيام الفتى يوم نفع","https://www.aldiwan.net/poem62155.html","الرمل"],[68,"ليس كل الأوقات يجتمع الشم","https://www.aldiwan.net/poem40304.html","الخفيف"],[54,"ليت يومي بنهر فروخ عادا","https://www.aldiwan.net/poem27119.html","الخفيف"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140903",""],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141038",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55190","البسيط"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/6095","الخفيف"],[108,"يا أبا فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=179383",""],[108,"مشاعر الآباء!","https://www.poetsgate.com/ViewPoem.aspx?id=179320",""],[51,"ذَهبَ الحرصُ بأصحابِ الدَّلجْ","https://www.poetsgate.com/ViewPoem.aspx?id=16976",""],[132,"إن يوم الفراق كان شديدا","https://www.aldiwan.net/poem50634.html","الخفيف"],[136,"آي أطلال الأوداء","https://www.aldiwan.net/poem54896.html","المديد"],[202,"لي سكن شطت به غربة","https://www.aldiwan.net/poem51879.html","السريع"],[203,"عثرت في مدارها الأيام","https://www.aldiwan.net/poem45167.html","الخفيف"],[226,"جف ورد الجميل في اللحد","https://www.aldiwan.net/poem55295.html","الخفيف"],[242,"بشرى لفاس وقد طمت دياجيها","https://www.aldiwan.net/poem19728.html","البسيط"],[302,"قلت له والدمع في وجنتي","https://www.aldiwan.net/poem33207.html","السريع"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[556,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[563,"تستر السر بإفشائه","https://www.aldiwan.net/poem33527.html","السريع"],[563,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[563,"انظر إلى الكون وتسطيره","https://www.aldiwan.net/poem34458.html","السريع"],[563,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122567","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39228","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[944,"","https://poetry.dctabudhabi.ae/diwan/poem/51580","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62556","السريع"],[1040,"","https://poetry.dctabudhabi.ae/diwan/poem/146170","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95570","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108838","الخفيف"],[1796,"","https://poetry.dctabudhabi.ae/diwan/poem/198800","البسيط"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68349","الكامل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67585","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65115","الخفيف"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35844","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74057","الخفيف"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103875","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48454","المتقارب"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108283","الخفيف"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34712","الخفيف"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36068","الخفيف"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36029","المديد"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216755",""],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132146","المتقارب"],[3713,"","https://poetry.dctabudhabi.ae/diwan/poem/144988","الرمل"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99156","الخفيف"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4929,"لايضيع عمل المعروف","https://www.poetsgate.com/ViewPoem.aspx?id=208718",""],[5121,"الكَأْسُ","https://www.poetsgate.com/ViewPoem.aspx?id=215480",""],[5239,"وديمة مطرت ربعي على ظمإٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190933",""],[5307,"صوتِك الموسِيقْ","https://www.poetsgate.com/ViewPoem.aspx?id=10532",""],[5324,"آه لو تعلم..","https://www.poetsgate.com/ViewPoem.aspx?id=211157",""],[5431,"روما وعربي مغترب....","https://www.poetsgate.com/ViewPoem.aspx?id=208557",""],[5431,"قلب قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=213919",""],[5644,"كان دربا من عناد","https://www.poetsgate.com/ViewPoem.aspx?id=199956",""],[5748,"لي سكن شقت به غربة","https://www.poetsgate.com/ViewPoem.aspx?id=26248",""],[5776,"وَجَعُ المواعيد","https://www.poetsgate.com/ViewPoem.aspx?id=199442",""],[5809,"الثمن","https://www.poetsgate.com/ViewPoem.aspx?id=205289",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""],[6345,"ماء هاجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78659&r=&rc=30",""]],"verses":[["لَيسَ كَغَزوِ الذِئبِ بُهمَ الحِمى","إِن مَرَّ بِالسَخلَةِ لَم يَرجِعِ",0,"ع",1,0],["لي سكرتان وللندمان واحدة","شيء خصصت به من دونهم وحدي",1,"د",2,0],["ليس كالسُّكر دواءٌ","لغناءٍ كالدواءِ",2,"ا",2,1],["ليس كلُّ الإخوان يجمع ما يُرْ","ضيكَ من كل خلَّةٍ حسناءِ",3,"ا",2,0],["لَيسَ كَما ظَنَّ غَشيَةٌ عَرَضَت","فَجِئتَني في خِلالِها قاصِد",4,"د",1,0],["لَيسَ كُلُّ السَراةِ بِالروذَبارِي","يِ وَلا كُلُّ ما يَطيرُ بِبازِ",5,"ز",1,0],["لَيسَ كُلُّ الخَيرِ يَأتي عاجِلاً","إِنَّما الخَيرُ حُظوظٌ وَدَرَج",6,"ج",1,0],["لَيسَ كُلُّ الدَهرِ يَوماً واحِداً","رُبَّما ضاقَ الفَتى ثُمَّ اتَّسَع",7,"ع",1,0],["لَيسَ كُلَّ الأَوقاتِ يَجتَمِعُ الشَم","لُ ولا راجِعٌ لَنا ما يَفوتُ",8,"ت",1,1],["لَيسَ كُلُّ العُشاقِ صَبّاً وَلَكِن","ذا حُسامٌ يُقَطِّعُ الأَكبادا",9,"د",2,0],["لَيسَ كُلُّ السُرورِ يَبقي نَعيماً","رُبَّ غَيٍّ يَدُبُّ تَحتَ السُرورِ",10,"ر",1,0],["ليس كل السراة بالروذبا","ريّ ولا كل ما يطير بباز",11,"ز",1,0],["ليس كما ظنّ غشيةٌ لحقت","فجئتني في خلالها قاصد",12,"د",1,0],["لِي سِكَرَتِيرَانِ عُزَّتْ دَوْلَتِي بِهِمَا","لَمْ يَأَلَوَانِي إِسعَاداً وَإِجْمَالاَ",13,"ل",2,1],["لَيسَ كَالعَهدِ إِذ عَهِدتِ وَلَكِن","أَوقَدَ الناسُ بِالأَحاديثِ نارا",14,"ر",2,0],["ليس كلُّ الطعام خُبْزًا وأرزًا","فمن البِشْرِ للضيوف طعَام",15,"م",1,0],["ليس كلُّ التُّراثِ بَيْتًا وحقْلاً","خير ما وُرِّث البَنُون الدعاءُ",16,"ا",2,0],["ليسَ كُلُّ الخيرِ يأْتِي عَجَلاً","إنّما الخَيرُ حُظوظٌ ودَرَجْ",17,"ج",1,0],["ليس كل القريض شعراً ولا كلُّ","رضاب يُعَدُّ شهداً بَرُودَا",18,"د",2,0],["لَيسَ كالسعدَانِ كَانَ كَلاً","انبَتَتهُ كُلُّ بَيدَاءِ",19,"ا",2,0],["لي سَكَنٌ شَطَّتْ به غُرْبَةٌ","جادتْ لها عينايَ بالمُزْنِ",20,"ن",1,1],["ليسَ كلَّ الذي تبصرُ ناساً","إن بعضاً من الطيور الحمامُ",21,"م",1,0],["ليس كالموت فارق أبداً","بين هزل الحياة والجد",22,"د",1,0],["لَيْسَ كَمَا حَدَّثُوا عَنْ أَهْلِ مِصْرَ وَلاَ","عَنْ أَهْلِ أَنْدَلُسٍ عُجْباً وَتَنْوِيهَا",23,"ي",3,0],["لَيسَ كمثلي في الوَرى عاشقٌ","قالَ ولا مثليَ مَعشوقُ",24,"ق",1,0],["ليس كلُّ الغيوث إلاَّك إن وا","فى براحاً فما له من براح",25,"ح",1,0],["لَيس كَما قدّرتَه إنّما","خُلقتَ للتّربِ من التُّربِ",26,"ب",1,0],["ليس كلام القوم رمزاً ولا","إشارة منهم بإيمائه",27,"ا",3,0],["ليس كالنازل فيه علمه","من سحاب الغيث سيل ذو غنيّ",28,"ي",1,0],["ليس كمثل الله شيء كما","قال تعالى عند تفسيره",29,"ر",2,0],["ليس كل الوجود إلا أسامي","والمسمى بكل ذلك ذاتي",30,"ت",2,0],["ليس كٌُلُّ الوجُوه تُطلبُ للخَي","رِ بَلِ الخيرُ في الوُجوهِ الصَّباح",31,"ح",1,0],["ليسَ كُلُّ الَّذي يَفِرُّ بِناجٍ","ربَّ طَعْنٍ فيه حَياةٌ لشَخْصِ",32,"ص",1,0],["ليس كلُّ الهنودِ هنداً ولا ك","لُّ رقاشٍ من الغواني رقاشا",33,"ش",2,0],["ليسَ كمن أمسى له جُنَّةٌ","كأنه لِلذبح معلوف",34,"ف",1,0],["لي سكرة بالحب عند الصَّباحْ","لا غَروَ إن أفصح دمعي وباحْ",35,"ح",1,1],["ليس كل الذي انتضى من دواة","قلماً بالغ العلى بالأداة",36,"ه",1,1],["ليس كالنيل مورد سلسبيل","من رحيق حوى العلاء مُذَاباَ",37,"ب",2,0],["ليس كل الذي جرى","كان في طاقة القلم",38,"م",1,0],["ليسكب الروح فوق الشط أغنية","بيضاء تشرق في أعماق كل ظمي",39,"م",2,0],["لي سكرتان وسكرة","هي للمريد المقتدي",40,"د",2,0],["ليس كالسيفِ مؤنسٌ حين يغدو","حادثٌ مُعضِلٌ ويفدَحُ أمرُ",41,"ر",1,0],["ليس كلُّ امرىء حواهُ لمدح","أو لعلم لديه او إنجاد",42,"د",1,0],["لَيسَ كَمَن كانَ مَديناً إِن أَتى","دائِنَهُ صادَفَهُ مُفتَضِحا",43,"ح",2,0],["لَيسَ كلّ اِمرئ جَرى في مَجال","كانَ فيه المقدّم السبّاقا",44,"ق",2,0],["ليس كل الركوع فاعلم صلاةً","لا ولا كل ذي لحاظٍ بصيرا",45,"ر",2,0],["ليُسْكِنَهُ جنّةً أُزْلِفَتْ","وأنزَلَ في وصْفِها كُتْبَهُ",46,"ب",2,0],["ليسَ كل الجمال يدعى جمالاَ","أنظروا ذا المهفهف الميالا",47,"ل",2,1],["لَيسَ كَالكاتِبِ الَّذي بِأَبي الخَطّ","ابِ يُكنى قَد شابَهُ التَطفيلُ",48,"ل",1,0],["لَيسَ كُلُّ الأَقطارِ يَروى مِنَ الغَي","ثِ وَإِن عَمَّها بِصَوبِ القِطارِ",49,"ر",1,0],["لَيسَ كَشخاناً فَأَشتُمَهُ","إِنَّما الكَشخانُ صاحِبُهُ",50,"ه",1,0],["ليس كالليل في الظلا","م ولا الصبح في الكدر",51,"ر",1,0],["ليسكت في الصدر هذا الفؤاد","ويهدأ في الجفن هذا البصر",52,"ر",1,0],["ليس كلُّ الدهر يوما واحدا","ربما انحط الفتى، ثم ارتَفَعْ",53,"ع",1,0],["ليس كالياسمين نور الرياض","هو باق والنور أجمع ماضي",54,"ي",1,1],["لَيس كلّ العلم علماً","إِنَّما العلم المجرّب",55,"ب",1,0],["ليس كالمعرف دَينٌ يُنتَظرْ","ارْمِهِ في البحر تحصدْهْ بِبَرْ",56,"ر",1,1],["لَيْسَ كُلُّ الَّذَي يُمَزُّ لَذِيذٌ","إِنَّمَا ذَوْقُ النَّاسِ فِيهِ انْتِحَارُ",57,"ر",1,0],["ليس كقدر أبي العباس إن له","قدراً تقصر عن إدراكه خدمي",58,"م",2,0],["لي سِكَنْ في اليُوف وامشَيِّدِ مَباني","أوْ حَاطِها بأَسْوار في قَلبي عِليِّه",59,"ي",2,0],["ليس كفرا.. هو امر الله سوا","ك.. كما شئت فراتا للفرات",60,"ت",1,0],["ليسكتَ بي وحوشا ضارياتٍ","فلا تعوي بليلٍ إذْ تَعرّى !!",61,"ر",2,0],["ليس كالعقل منقذٌ في صراعٍ","صار للشرّ قوة ذات بأسِ",62,"س",1,0],["ليس كلُّ البعدِ كرهًا","كان دربًا من عنادِ",63,"د",1,1],["لي سكن شقت به غربة","جادت لها عيناي بالمزن",64,"ن",1,1],["ليسكر كل من شربوا جراحي","فكأسُ الآه يسكبها القصيدُ",65,"د",1,0],["ليس كالبائعِ خمراً وكذا","ليس من يشري جناناً كالدِّمَنْ",66,"ن",1,0],["ليس كالأَسْوَدِ البياضُ فأيدي","ذَاكَ بِيضٌ وذَا أَيادِيهِ سُودُ",67,"د",1,0],["ليس كفراً بأن تموت انتحاراً","إنما الكفرُ أنْ لموتكَ تطربْ",68,"ب",1,0],["ليس كذبا ما نراه","من أحاديث المشاعر",69,"ر",1,0]]}