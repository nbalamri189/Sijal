{"poems":[[55,"هل الطرف يعطي نظرة من حبيبه","https://www.aldiwan.net/poem30742.html","الطويل"],[53,"تأدب كي يقال فتى أديب","https://www.aldiwan.net/poem9391.html","الوافر"],[154,"تأدب إذا ذكر المصطفى","https://www.aldiwan.net/poem68451.html","المتقارب"],[190,"تأدى رجال في التمام وأهله","https://www.aldiwan.net/poem43819.html","الطويل"],[210,"سرور أزاح الهمّ والغمّ مذ بدا","https://www.aldiwan.net/poem916.html",""],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[396,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[415,"وافتك حالكة السواد يخالها","https://www.aldiwan.net/poem32239.html","الكامل"],[473,"وهيف عليها معلمات القراطق","https://www.aldiwan.net/poem59812.html","الطويل"],[564,"تأدب بباب الدير واخلع به النعلا","https://www.aldiwan.net/poem69348.html","الطويل"],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/113000","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70937","الهزج"],[1135,"","https://poetry.dctabudhabi.ae/diwan/poem/124200","الرجز"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102063","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117886","الوافر"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115304","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133098","الطويل"],[5691,"عاصمة السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206341",""]],"verses":[["تَأَدَّبَ مِنّي رائِعُ الخَطبِ بَعدَما","تَجَلّى سَفيهُ الجَدِّ لي عَن أَديبِهِ",0,"ب",2,0],["تأدَّبْ كي يقالَ فتى أديبٌ","لتَحْصَر عنه ألسنةُ المديحِ",1,"ح",1,1],["تأدب إذا ذكر المصطفى","بصمت اللسان وغضِّ البصر",2,"ر",1,1],["تأدى رجال في التمام وأهله","فطال المرا واستكشف الحقّ ساتره",3,"ر",2,1],["تأدّب لديه واحفظنّ مقاله","لتنجُو من جهل يؤدي إلى الردى",4,"د",2,0],["تأدب وكمل بالاوامر حسنها","وبكت بحسن الخلق حجة طعان",5,"ن",1,0],["تأدب فالأدب بالعبيد","أليق وأحمد",6,"د",1,0],["تَأديبُها لهُمُ بقَطعِ رُؤوسِهم","إن قَصّروا في السّعيِ عما تَرسُمُ",7,"م",1,0],["تَأَدُّبَهُ يُغنيهِ عَن كُلِّ رائِضٍ","وَفِطنَتُهُ تُغنيهِ عَن كُلِّ سائِقِ",8,"ق",1,0],["تَأدبْ بِبَاب الدَّيْر واخْلَعْ بِهِ النَّعْلاَ","وَسَلّمْ عَلَى الرُّهبَانِ واحْطُطْ بِهْمَ رَحْلا",9,"ل",2,1],["تأدبي وقفي بالباب خاضعة","واذري الدموع على اعتابه وقلي",10,"ل",2,0],["تأدبْ واجعلنْ للنط","قِ بين الناس ميزانا",11,"ن",2,0],["تأدبي ويحك في","حق أمير الأدب",12,"ب",1,0],["تأدب خاشعاً للطرف واجري","سلامي أنت منخضعاً وحي",13,"ي",1,0],["تأدب عند إلجام ومسح","وإعلاف وشرب لا دني",14,"ي",1,0],["تأديب سيرتها الحسناء يخبرنا","عن حسن تهذيبها للطبع والشيمِ",15,"م",1,0],["تأدب ثم عن طمع مريب","فضمن إساءة الأدب الممات",16,"ت",1,0],["تَأدّبتُ عن حُسنِ الرجاءِ فلن أرى","أعودُ له إِنّ الزمانَ مُؤدِّبُ",17,"ب",1,0],["تأدب لهم في كل حالٍ ومعهم","ركن عبدهم إن شرفوك بخدمة",18,"ه",1,0],["تأدَّبْ أمامَ المَجْدِ يا ابْنَ قُريْظَةٍ","ومَنْ دُمْتَ عبْداً للصَّهايِنِ مأْمورا !",19,"ر",2,0],["تأدَّبْ فإنَّ القُدْسَ نبْضُ قلوبِنا","وقدْ شُيِّدَتْ أرْواحُنا حوْلَها سورا !",19,"ر",2,0]]}