{"poems":[[86,"جل الأسى فتجملي","https://www.aldiwan.net/poem10486.html","مجزوء الكامل"],[86,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[86,"أتيت سوق عكاظ","https://www.aldiwan.net/poem68903.html","المجتث"],[54,"يا واقفا يبكي الطلول وينشد","https://www.aldiwan.net/poem27436.html","الكامل"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[72,"واوحشتي لمقام منك محمود","https://www.aldiwan.net/poem18564.html","البسيط"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[51,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[91,"يا أيها الشعر أسعفني فأرثيه","https://www.aldiwan.net/poem62808.html","عموديه"],[89,"أبكي ومثلي بالبكاء حقيق","https://www.aldiwan.net/poem44893.html","الكامل"],[85,"لما سمعت بنقطة","https://www.aldiwan.net/poem7576.html","مجزوء الكامل"],[85,"في مهرجان الحق أو يوم الدم","https://www.aldiwan.net/poem62949.html","الكامل"],[62,"حب اليهود لآل موسى ظاهر","https://www.aldiwan.net/poem52446.html","الكامل"],[45,"يكاد يبدي لسعدى غيب ما أجد","https://www.aldiwan.net/poem63477.html","البسيط"],[45,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[97,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[44,"إن عهدا لو تعلمان ذميما","https://www.aldiwan.net/poem30357.html","الخفيف"],[31,"هل تعرف الدار والأطلال والدمنا","https://www.aldiwan.net/poem41274.html","الخفيف"],[52,"يا رب بيت زرته فكأنما","https://www.aldiwan.net/poem26604.html","الكامل"],[52,"بخلا بهذا الدهر لست أراك","https://www.aldiwan.net/poem26770.html","الكامل"],[48,"خرجت للهو بالبستان عنك فما","https://www.aldiwan.net/poem10821.html","البسيط"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[7,"نبئت زرعة والسفاهة كاسمها","https://www.aldiwan.net/poem1995.html","الكامل"],[46,"عاشوا كما عاش آباء لهم سلفوا","https://www.aldiwan.net/poem22332.html","البسيط"],[46,"لا ملك للملك المقصور نعلمه","https://www.aldiwan.net/poem22545.html","البسيط"],[68,"قف بالديار وحي الأربع الدرسا","https://www.aldiwan.net/poem1503.html",""],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24769","المنسرح"],[106,"حفل زواج","https://www.poetsgate.com/ViewPoem.aspx?id=179388",""],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[90,"تحية الوزير","https://www.poetsgate.com/ViewPoem.aspx?id=179070",""],[90,"على حدود فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179015",""],[91,"يا قائد القوم","https://www.poetsgate.com/ViewPoem.aspx?id=53388",""],[51,"خساسة ُ البيهقي والبين","https://www.poetsgate.com/ViewPoem.aspx?id=30678",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[116,"متى خيام من احب تقرب","https://www.aldiwan.net/poem41253.html","عموديه"],[144,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[144,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[144,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[170,"أيدي الحوادث في الأيام والأمم","https://www.aldiwan.net/poem1667.html",""],[190,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[200,"مرض العيون الحور طبه","https://www.aldiwan.net/poem45570.html","مجزوء الكامل"],[230,"غيري رمين ذوات الأعين النجل","https://www.aldiwan.net/poem50856.html","البسيط"],[236,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[238,"حاولت صبرا على ما ناب من نوب","https://www.aldiwan.net/poem18065.html","البسيط"],[253,"ما نام بعد البين يستحلي الكرى","https://www.aldiwan.net/poem1416.html",""],[260,"من مجيري من فاتن الطرف فاتك","https://www.aldiwan.net/poem35948.html","الخفيف"],[262,"هل هوى تلك العراص","https://www.aldiwan.net/poem38247.html","مجزوء الرمل"],[271,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[283,"لله يوسف كم أغاث وغاثا","https://www.aldiwan.net/poem32843.html","الكامل"],[285,"ما أراني إلا سأترك بغداد","https://www.aldiwan.net/poem44320.html","الخفيف"],[298,"يا أيها المولى الذي","https://www.aldiwan.net/poem33166.html","مجزوء الكامل"],[299,"أحفى شواربه ولحيته معا","https://www.aldiwan.net/poem36831.html","الكامل"],[350,"لم يحرم ما كان حلا على","https://www.aldiwan.net/poem15507.html","مجزوء الخفيف"],[372,"أما اشتفى كاشح ولا حاسد","https://www.aldiwan.net/poem57477.html","المنسرح"],[381,"ناء بمصر وبالشآم حبيبه","https://www.aldiwan.net/poem49206.html","الكامل"],[410,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[410,"ماذا الوقوف على دار بذي سلم","https://www.aldiwan.net/poem31870.html","البسيط"],[411,"تبقى قوافي الشعر ما بقيت","https://www.aldiwan.net/poem67524.html","أحذ الكامل"],[417,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[430,"غدر الزمان واظهر التفنيدا","https://www.aldiwan.net/poem41035.html","الكامل"],[433,"إليك من ملك سام ومن ملك","https://www.aldiwan.net/poem12357.html","البسيط"],[440,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[454,"الشكر يجدر أن يمثل عيدا","https://www.aldiwan.net/poem61637.html","الكامل"],[454,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[459,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[462,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[465,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[478,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[480,"طلل يلوح من الضمير ضئيلا","https://www.aldiwan.net/poem37066.html","الكامل"],[501,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[515,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[516,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[541,"ياذا المنوه تدعوني لتسمعني","https://www.aldiwan.net/poem56644.html","البسيط"],[552,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[552,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[563,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"],[565,"إن قلبي من سكره لا يفيق","https://www.aldiwan.net/poem879.html",""],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"]],"verses":[["لَم يَحلُ لي مِن بَعدِهِم","عَيشٌ وَلَم أَتَعَلَّلِ",0,"ل",1,0],["لَم يَحمِهِم عَلَمٌ فيها وَلا عَدَدٌ","سِوى مَضاءٍ تَحامى وِردَهُ النُوَبُ",1,"ب",1,0],["لَم يَحبُها فَضلُ شَوقي","بَقِيَّةً مِن نَسيسِ",2,"س",1,0],["لَم يَحفَظوا حَقَّ النَبِيِّ مُحَمَّدٍ","إِذ جَرَّعوهُ حَرارَةً لا تَبرُدُ",3,"د",1,0],["لم يحجب الصبحُ شهبَ الأفق عن بصر","إلا وهديُك للأبصار يُبديها",4,"ي",3,0],["لم يحشم الخالفات قريتها ولم","يعض من نطافها السرب",5,"ب",1,0],["لم يحمهم سرد داود الذي ملكوا","من المنونِ ولا جنْد ابن داود",6,"د",1,0],["لم يحكّ وشيها ابن أبي سل","مى لرب المكارم ابن سنان",7,"ن",1,0],["لم يحتجبْ عنه الصوا","بُ وأين عنهُ تَرى احتجابهْ",8,"ب",2,0],["لم يُحرزِ القصباتِ مَن","لم يحتمل جَدعاً وعَقرا",9,"ر",2,0],["لم يَحْسبِ المجد الشرا","ء ولم يَبعْ كرماً بلوم",10,"م",1,0],["لَم يَحُِ نَعشُكَ جِسماً لا حِراكَ بِهِ","بَل أَنتَ آمالُنا مَوضوعَةٌ فيهِ",11,"ي",2,0],["لم يحسب النفر الألى قد ضيقوا","ماذا يجر وراءه التضييق",12,"ق",1,0],["لم يحكه تبّاعه","زهدا ولم يسلوا سلوّة",13,"و",2,0],["لَم يُحجِموا في ساعَةٍ قَد أَظفَرَت","مَلِكَ البِحارِ بِكُلِّ قَيصَرَ مُحجِمِ",14,"م",1,0],["لم يحفَظوا حَقَّ النبيِّ محمَّدٍ","في آلِه واللّهُ بالمرصادِ",15,"د",1,0],["لَم يُحصَ عِدَّةُ ما أَولاهُ مِن حَسَنٍ","وَسَيِّدُ النَيلِ ما لَم يُحصِهِ العَدَدُ",16,"د",1,0],["لَم يُحيلوا عَلى الخِداعِ وَسَلُّ ال","بَيضِ بَينَ الصَفَّينِ تَركُ الخِداعِ",17,"ع",1,0],["لم يحل طبعه ولا ذات يوم","لبست غير نفسها حواء",18,"ا",2,0],["لَم يُحَدِّث نَفساً بِمَكَّةَ حَتّى","جازَتِ الكَهفَ خَيلُهُ وَالرَقيما",19,"م",2,0],["لَم يُحبِبِ القَلبُ شَيئاً مِثلَ حُبُّكُمُ","وَلَم تَرَ العَينُ شَيئاً بَعدَكُم حَسَنا",20,"ن",2,0],["لَم يُحسِنِ الرُمّانُ جَمعَ أَحِبَّةٍ","في قِشرَةٍ إِلّا كَما نَحنُ",21,"ن",1,0],["لَم يَحلُ لِلعَينَينِ بَعدَكِ مَنظَرٌ","ذُمَّ المَنازِلُ كُلُّهُنَّ سِواكِ",22,"ك",1,0],["لَم يَحلُ في ناظِري مِن نورِهِ زَهَرٌ","إِلّا حَكاكَ بِحُسنٍ مِنهُ أَو طيبُ",23,"ب",1,0],["لَم يَحكُموا في مَواليهِم وَقَد مَلَكوا","حُكمَ المُحِلِّ وَلا حُكمُ اِبنِهِ العادي",24,"د",2,0],["لَم يُحرَموا حُسنَ الغِذاءِ وَأُمُّهُم","طَفَحَت عَلَيكَ بِناتِقٍ مِذكارِ",25,"ر",1,0],["لَم يَحمِ فارِسُ حَيٍّ مِن رَداً فَرَسٌ","وَلا أَجَدَّت فَأَجَدَّت عِرمِسٌ أَجُدُ",26,"د",1,0],["لَم يُحصِ أَعدادَ رَملِ الأَرضِ ساكِنُها","وَكُلُّ ذلِك عِندَ اللَهِ مَحصورُ",27,"ر",1,0],["لم يحلُ للعينِ شيء بعدَ بُعْدِهِم","والقلبُ مُذْ آنس التّذكارَ ما أَنِسا",28,"س",2,0],["لَم يَحُل بَينَهُم وَبَينَ المَلاهي","أَو شُؤونِ الحَياةِ جَوٌّ مَطيرُ",29,"ر",1,0],["لَمْ يَحْسَبُوا فِي مِصْرَ عَبْداً شَاكِياً","فَي فَتْرَةِ التفكِيرِ وَالإِضْمَارِ",30,"ر",1,0],["لَمْ يَحْبُ غَيْرَكَ رَبُّهُ","كلّ مَعْنىً مَا حَبَاك",31,"ك",1,0],["لَمْ يَحْتَبَسْ نَهْرٌ بِسَدٍّ قَبْلَهُ","ضَخْمٍ ضَخَامَتَهُ عَرِيض الْغَارِبِ",32,"ب",1,0],["لم يُحسنا قطُّ صُنْعَهُ وإذا","ما أنشداه فغير حُلوَيْن",33,"ن",1,0],["لم يَحْوِكم هذا المكانُ؛ وإنما","تحوِيكُمُ الأَسماعُ والأبصار",34,"ر",1,0],["لم يحوِ دينٌ ما حوى ال","إسلامُ من شرَفِ الخلال",35,"ل",1,0],["لم يحلوا بني رزاحٍ ببرقا","ء نطاعٍ لهم عليهم دعاء",36,"ا",2,0],["لم يحفظوا لأماني الشعب حرمَتَها","من أجل أن يبلُغوا من مطمعٍ أرَبا",37,"ب",2,0],["لمُ يحيِ هذا الماءُ مَيْتَ الثَرى","لو لم يكنْ ماءُ حياةٍ يُراق",38,"ق",1,0],["لم يحو نعشك جسما لا حراك به","بل أنت آمالنا موضوعة فيه",39,"ي",2,0],["لم يُحسنا قطُّ صُنْعَهُ وإذا","ما أنشداه حُلويْن",40,"ن",1,0],["لم يحبب إلى عيشي إلا","أمل غامض الحدود وسيع",41,"ع",1,0],["لم يحكم الصدق ويحفظ الوفا","والود الا الطيب المهذب",42,"ب",1,0],["لَم يَحفَظوا الحَقَّ مِن ماضٍ وَمُقتَبَلٍ","حَتّى كَأَنَّهُمُ غابوا وَإِن حَضَروا",43,"ر",3,0],["لَم يَحتَجِب عَن رَبِّ مَسأَلَةٍ وَلا","سُدِلَت عَلى غَيرِ التُقى أَستارُهُ",44,"ر",2,0],["لَم يُحِلكَ السُلطانُ عَن رَأيِكَ الأَو","وَلِ فيهِ بَل ضوعِفَ الإِكرامُ",45,"م",1,0],["لَم يَحمِهِ صارِمٌ قَد كانَ يَخضِبُهُ","يَومَ النِزالِ مِنَ الأَعناقِ وَالقِمَمِ",46,"م",1,0],["لَم يَحمِهِ عَدَدٌ مَجرٌ وَلا دَفَعَت","عَنهُ المَنِيَّةَ إِذ جاءَت بنُو جُشَمِ",46,"م",1,0],["لَم يَحن بعدُ اللقا فاِبكي دما","وَاِهجسي يا نفسُ أو لا تهجسي",47,"ي",1,0],["لم يحكهِ الغيدُ الحيا","نَ وهل تحاكي البدرَ شبهُهْ",48,"ب",3,0],["لم يَحْم مَنِّيَ خَدّاً لَدْغُ عَقْرَبهِ","ولا ثَنَتْنِي سهامُ اللّحظِ عن مُقِل",49,"ل",1,0],["لَم يُحِل عَهدَكَ ما","أوتيتَ مِن حالٍ وَثَروَه",50,"و",2,0],["لَمْ يَحْتَسِبْ بَعْدَكَ البَاقُونَ فِي تَعَبٍِ","مِثْلَكَ في حَسَبٍ يَا خَيْرَ مُحْتَسَبِ",51,"ب",1,0],["لَم يحسُنِ الأَترابُ فَوقَ سُطورِها","إِلّا لأَنَّ الجَيش يَعقُد عِثيرا",52,"ر",2,0],["لم يحل عنك خاطري فافهمي يا","نفس قولي إن كنت في غفلاتك",53,"ك",1,0],["لم يحد عنه ومن حا","د عن المشروع عاص",54,"ص",1,0],["لم يحفظوا ملكهم فليحفظوا لغةً","فصحى وديناً لصدعِ الملكِ رءّابا",55,"ب",2,0],["لَم يَحفِروا تِلكَ الخَنادِقَ حَولَهُم","إِلّا لِتَجعَلَها لَهُم أَجداثا",56,"ث",2,0],["لَم يَحكه النساجُ يَوماً لِبَيعٍ","لا وَلا يشتَري مِنَ البزازِ",57,"ز",1,0],["لَم يحوِ طِرسٌ مثلَها","كلّا ولا رَقمَ القَلم",58,"م",1,0],["لم يحكه بالقبح إلاّ كالحٌ","سمجُ الجبلَّةِ بالنذالةِ مفرط",59,"ط",1,0],["لَم يُحَرَّم ما كانَ حِلاً عَلى","غَيرِ ظُلومٍ بِذا أَتانا الكِتابُ",60,"ب",1,1],["لم يُحبَسِ الدمع في جُفونهما","إلا ليبقى الهوى بلا شاهِد",61,"د",1,0],["لَم يحص مِن قَتَلت لحاظك حاسب","فَصَريع حُبك لَم تَعد ذُنوبَهُ",62,"ب",2,0],["لم يَحمِهم حِصنُهم منها ولا رَهِبَتْ","بأساً تَناذَرَه الأقرانُ أزمانا",63,"ن",2,0],["لم يحْصُلوا حين وافاهُم حِمامُهُمُ","مِن كلِّ ما حَصَّلوا إلاّ عَلى النَّدَمِ",64,"م",1,0],["لَم يحظَ في الشِعرِ كَما حَظيتُ","جَمعٌ مِنَ الناسِ وَلا شَتيتُ",65,"ت",1,0],["لم يحسن العيش الذي شاهدته","من بعد ذات الطلعة الحسناء",66,"ا",2,0],["لم يحسبنهم قلدوه صوارماً","بل قلّدوه جواهراً وعقودا",67,"د",2,0],["لم يَحْكِ جُودَ يَدَيْهِ الغيثُ منهمِراً","ومثلَ ما حِكْتَ فيه الرَّوْضُ لَمْ يَحِكِ",68,"ك",1,0],["لم يحمِلُوا عَيْبَ ذي قالٍ يَعِيبُهُمُ","فِي الجودِ والبأْسِ إِلّا أَنَّهُ سَرَفُ",69,"ف",1,0],["لم يُحصِ أنفاساً عليه مُسلَّطٌ","يوماً ولا هو سامه تحديدا",70,"د",2,0],["لم يُحصر الفن فن ذهن وانان","حتى يمجد شعري فوق حسباني",71,"ن",2,1],["لم يحترِش ضَغَناً ولا حُنِيتْ","عُوجُ الضلوع له على غِمرِ",72,"ر",1,0],["لم يُحدِث القُرٌّ العنيفُ بوجههِ","نَدَماً ولو جاءَ الشتاءُ بأفْكلِ",73,"ل",1,0],["لم يحلَ صدر الدهر قبل مثلها","كلاًّ ولا جيد الزمان الحاضر",74,"ر",1,0],["لم يحمِ عنه ربعَهُ","عديدُهُ وعُدَدُه",75,"د",2,0],["لم يحل في بصري ولم يحلل به","إلاك أو يجنح عليك عدولا",76,"ل",2,0],["لم يحفظ الجبار مهم","ما دسَّ مكراً جانبه",77,"ب",2,0],["لم يُحسِنوا الخطّ إن راموا مُكاتبةً","فوق الصّدورِ بأطرافِ القَنا كَتبوا",78,"ب",3,0],["لم يحز رتبة الكفالة إلا","والليالي إليه فيها تشير",79,"ر",1,0],["لم يحصلوا من العلى ورسمها","إلا على الفخر برسم داثر",80,"ر",1,0],["لَم يُحسِنوا الظَنَّ إِذ ظَنّوا بذي حَسَبٍ","وَفيهمُ العذرُ مَقرونٌ إِلى الطَبَنِ",81,"ن",1,0],["لم يحلّوا دارَ الهَوانِ وكانوا","في المعالي فوق النّجوم نجوما",82,"م",2,0],["لم يحملوا يومَ الرّحيل سوى","قلبي العميد بهمْ على البُزلِ",83,"ل",1,0],["لم يحْمِهِ الشَرَفُ الأعلى بجُرمتِهِ","والآلُ والصَّحْبُ والأملاكُ والبِد