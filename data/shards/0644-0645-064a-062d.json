gate.com/ViewPoem.aspx?id=183912",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[3591,"فاحت ريلح أزهارٍ ولطائمِ","https://www.poetsgate.com/ViewPoem.aspx?id=149397",""],[5136,"أسد غودر في القاع الجدد","https://www.poetsgate.com/ViewPoem.aspx?id=121559",""],[5261,"رمضانيون","https://www.poetsgate.com/ViewPoem.aspx?id=212890",""],[5296,"وحدي أنا","https://www.poetsgate.com/ViewPoem.aspx?id=155353",""],[5351,"عذاب اليوم..","https://www.poetsgate.com/ViewPoem.aspx?id=203746",""],[5363,"رثاء أبي","https://www.poetsgate.com/ViewPoem.aspx?id=199951",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5431,"على لسان حواء...","https://www.poetsgate.com/ViewPoem.aspx?id=208756",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5582,"غاداكَ مِنْ دِيَمِ الحَيا ضَحْوِيُّها","https://www.poetsgate.com/ViewPoem.aspx?id=187333",""],[5616,"شقاوة","https://www.poetsgate.com/ViewPoem.aspx?id=203199",""],[5652,"كنتي وطن","https://www.poetsgate.com/ViewPoem.aspx?id=168821",""],[402,"ماذا تعيضك من صباك","https://www.poetsgate.com/ViewPoem.aspx?id=36030",""],[5939,"لستِ أنثى!","https://www.poetsgate.com/ViewPoem.aspx?id=185492",""],[5956,"أبواشٌ وشارونيّون","https://www.poetsgate.com/ViewPoem.aspx?id=192363",""],[5956,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=194897",""],[5956,"لله درُّك يا ابنَ الفيصل الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=204197",""],[5958,"وَصَاحب كالزلال يمحو","https://www.poetsgate.com/ViewPoem.aspx?id=189020",""],[5355,"من أجلها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87224&r=&rc=49",""],[6308,"كفي ولونُ الجدائل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87725&r=&rc=3",""],[6318,"لغتي الجميلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66157&r=&rc=7",""]],"verses":[["لَم يَحلُ لي مِن بَعدِهِم","عَيشٌ وَلَم أَتَعَلَّلِ",0,"ل",1,0],["لَم يَحمِهِم عَلَمٌ فيها وَلا عَدَدٌ","سِوى مَضاءٍ تَحامى وِردَهُ النُوَبُ",1,"ب",1,0],["لَم يَحبُها فَضلُ شَوقي","بَقِيَّةً مِن نَسيسِ",2,"س",1,0],["لَم يَحفَظوا حَقَّ النَبِيِّ مُحَمَّدٍ","إِذ جَرَّعوهُ حَرارَةً لا تَبرُدُ",3,"د",1,0],["لم يحجب الصبحُ شهبَ الأفق عن بصر","إلا وهديُك للأبصار يُبديها",4,"ي",3,0],["لم يحشم الخالفات قريتها ولم","يعض من نطافها السرب",5,"ب",1,0],["لم يحمهم سرد داود الذي ملكوا","من المنونِ ولا جنْد ابن داود",6,"د",1,0],["لم يحكّ وشيها ابن أبي سل","مى لرب المكارم ابن سنان",7,"ن",1,0],["لم يحتجبْ عنه الصوا","بُ وأين عنهُ تَرى احتجابهْ",8,"ب",2,0],["لم يُحرزِ القصباتِ مَن","لم يحتمل جَدعاً وعَقرا",9,"ر",2,0],["لم يَحْسبِ المجد الشرا","ء ولم يَبعْ كرماً بلوم",10,"م",1,0],["لَم يَحُِ نَعشُكَ جِسماً لا حِراكَ بِهِ","بَل أَنتَ آمالُنا مَوضوعَةٌ فيهِ",11,"ي",2,0],["لم يحسب النفر الألى قد ضيقوا","ماذا يجر وراءه التضييق",12,"ق",1,0],["لم يحكه تبّاعه","زهدا ولم يسلوا سلوّة",13,"و",2,0],["لَم يُحجِموا في ساعَةٍ قَد أَظفَرَت","مَلِكَ البِحارِ بِكُلِّ قَيصَرَ مُحجِمِ",14,"م",1,0],["لم يحفَظوا حَقَّ النبيِّ محمَّدٍ","في آلِه واللّهُ بالمرصادِ",15,"د",1,0],["لَم يُحصَ عِدَّةُ ما أَولاهُ مِن حَسَنٍ","وَسَيِّدُ النَيلِ ما لَم يُحصِهِ العَدَدُ",16,"د",1,0],["لَم يُحيلوا عَلى الخِداعِ وَسَلُّ ال","بَيضِ بَينَ الصَفَّينِ تَركُ الخِداعِ",17,"ع",1,0],["لم يحل طبعه ولا ذات يوم","لبست غير نفسها حواء",18,"ا",2,0],["لَم يُحَدِّث نَفساً بِمَكَّةَ حَتّى","جازَتِ الكَهفَ خَيلُهُ وَالرَقيما",19,"م",2,0],["لَم يُحبِبِ القَلبُ شَيئاً مِثلَ حُبُّكُمُ","وَلَم تَرَ العَينُ شَيئاً بَعدَكُم حَسَنا",20,"ن",2,0],["لَم يُحسِنِ الرُمّانُ جَمعَ أَحِبَّةٍ","في قِشرَةٍ إِلّا كَما نَحنُ",21,"ن",1,0],["لَم يَحلُ لِلعَينَينِ بَعدَكِ مَنظَرٌ","ذُمَّ المَنازِلُ كُلُّهُنَّ سِواكِ",22,"ك",1,0],["لَم يَحلُ في ناظِري مِن نورِهِ زَهَرٌ","إِلّا حَكاكَ بِحُسنٍ مِنهُ أَو طيبُ",23,"ب",1,0],["لَم يَحكُموا في مَواليهِم وَقَد مَلَكوا","حُكمَ المُحِلِّ وَلا حُكمُ اِبنِهِ العادي",24,"د",2,0],["لَم يُحرَموا حُسنَ الغِذاءِ وَأُمُّهُم","طَفَحَت عَلَيكَ بِناتِقٍ مِذكارِ",25,"ر",1,0],["لَم يَحمِ فارِسُ حَيٍّ مِن رَداً فَرَسٌ","وَلا أَجَدَّت فَأَجَدَّت عِرمِسٌ أَجُدُ",26,"د",1,0],["لَم يُحصِ أَعدادَ رَملِ الأَرضِ ساكِنُها","وَكُلُّ ذلِك عِندَ اللَهِ مَحصورُ",27,"ر",1,0],["لم يحلُ للعينِ شيء بعدَ بُعْدِهِم","والقلبُ مُذْ آنس التّذكارَ ما أَنِسا",28,"س",2,0],["لَم يَحُل بَينَهُم وَبَينَ المَلاهي","أَو شُؤونِ الحَياةِ جَوٌّ مَطيرُ",29,"ر",1,0],["لَمْ يَحْسَبُوا فِي مِصْرَ عَبْداً شَاكِياً","فَي فَتْرَةِ التفكِيرِ وَالإِضْمَارِ",30,"ر",1,0],["لَمْ يَحْبُ غَيْرَكَ رَبُّهُ","كلّ مَعْنىً مَا حَبَاك",31,"ك",1,0],["لَمْ يَحْتَبَسْ نَهْرٌ بِسَدٍّ قَبْلَهُ","ضَخْمٍ ضَخَامَتَهُ عَرِيض الْغَارِبِ",32,"ب",1,0],["لم يُحسنا قطُّ صُنْعَهُ وإذا","ما أنشداه فغير حُلوَيْن",33,"ن",1,0],["لم يَحْوِكم هذا المكانُ؛ وإنما","تحوِيكُمُ الأَسماعُ والأبصار",34,"ر",1,0],["لم يحوِ دينٌ ما حوى ال","إسلامُ من شرَفِ الخلال",35,"ل",1,0],["لم يحلوا بني رزاحٍ ببرقا","ء نطاعٍ لهم عليهم دعاء",36,"ا",2,0],["لم يحفظوا لأماني الشعب حرمَتَها","من أجل أن يبلُغوا من مطمعٍ أرَبا",37,"ب",2,0],["لمُ يحيِ هذا الماءُ مَيْتَ الثَرى","لو لم يكنْ ماءُ حياةٍ يُراق",38,"ق",1,0],["لم يحو نعشك جسما لا حراك به","بل أنت آمالنا موضوعة فيه",39,"ي",2,0],["لم يُحسنا قطُّ صُنْعَهُ وإذا","ما أنشداه حُلويْن",40,"ن",1,0],["لم يحبب إلى عيشي إلا","أمل غامض الحدود وسيع",41,"ع",1,0],["لم يحكم الصدق ويحفظ الوفا","والود الا الطيب المهذب",42,"ب",1,0],["لَم يَحفَظوا الحَقَّ مِن ماضٍ وَمُقتَبَلٍ","حَتّى كَأَنَّهُمُ غابوا وَإِن حَضَروا",43,"ر",3,0],["لَم يَحتَجِب عَن رَبِّ مَسأَلَةٍ وَلا","سُدِلَت عَلى غَيرِ التُقى أَستارُهُ",44,"ر",2,0],["لَم يُحِلكَ السُلطانُ عَن رَأيِكَ الأَو","وَلِ فيهِ بَل ضوعِفَ الإِكرامُ",45,"م",1,0],["لَم يَحمِهِ صارِمٌ قَد كانَ يَخضِبُهُ","يَومَ النِزالِ مِنَ الأَعناقِ وَالقِمَمِ",46,"م",1,0],["لَم يَحمِهِ عَدَدٌ مَجرٌ وَلا دَفَعَت","عَنهُ المَنِيَّةَ إِذ جاءَت بنُو جُشَمِ",46,"م",1,0],["لَم يَحن بعدُ اللقا فاِبكي دما","وَاِهجسي يا نفسُ أو لا تهجسي",47,"ي",1,0],["لم يحكهِ الغيدُ الحيا","نَ وهل تحاكي البدرَ شبهُهْ",48,"ب",3,0],["لم يَحْم مَنِّيَ خَدّاً لَدْغُ عَقْرَبهِ","ولا ثَنَتْنِي سهامُ اللّحظِ عن مُقِل",49,"ل",1,0],["لَم يُحِل عَهدَكَ ما","أوتيتَ مِن حالٍ وَثَروَه",50,"و",2,0],["لَمْ يَحْتَسِبْ بَعْدَكَ البَاقُونَ فِي تَعَبٍِ","مِثْلَكَ في حَسَبٍ يَا خَيْرَ مُحْتَسَبِ",51,"ب",1,0],["لَم يحسُنِ الأَترابُ فَوقَ سُطورِها","إِلّا لأَنَّ الجَيش يَعقُد عِثيرا",52,"ر",2,0],["لم يحل عنك خاطري فافهمي يا","نفس قولي إن كنت في غفلاتك",53,"ك",1,0],["لم يحد عنه ومن حا","د عن المشروع عاص",54,"ص",1,0],["لم يحفظوا ملكهم فليحفظوا لغةً","فصحى وديناً لصدعِ الملكِ رءّابا",55,"ب",2,0],["لَم يَحفِروا تِلكَ الخَنادِقَ حَولَهُم","إِلّا لِتَجعَلَها لَهُم أَجداثا",56,"ث",2,0],["لَم يَحكه النساجُ يَوماً لِبَيعٍ","لا وَلا يشتَري مِنَ البزازِ",57,"ز",1,0],["لَم يحوِ طِرسٌ مثلَها","كلّا ولا رَقمَ القَلم",58,"م",1,0],["لم يحكه بالقبح إلاّ كالحٌ","سمجُ الجبلَّةِ بالنذالةِ مفرط",59,"ط",1,0],["لَم يُحَرَّم ما كانَ حِلاً عَلى","غَيرِ ظُلومٍ بِذا أَتانا الكِتابُ",60,"ب",1,1],["لم يُحبَسِ الدمع في جُفونهما","إلا ليبقى الهوى بلا شاهِد",61,"د",1,0],["لَم يحص مِن قَتَلت لحاظك حاسب","فَصَريع حُبك لَم تَعد ذُنوبَهُ",62,"ب",2,0],["لم يَحمِهم حِصنُهم منها ولا رَهِبَتْ","بأساً تَناذَرَه الأقرانُ أزمانا",63,"ن",2,0],["لم يحْصُلوا حين وافاهُم حِمامُهُمُ","مِن كلِّ ما حَصَّلوا إلاّ عَلى النَّدَمِ",64,"م",1,0],["لَم يحظَ في الشِعرِ كَما حَظيتُ","جَمعٌ مِنَ الناسِ وَلا شَتيتُ",65,"ت",1,0],["لم يحسن العيش الذي شاهدته","من بعد ذات الطلعة الحسناء",66,"ا",2,0],["لم يحسبنهم قلدوه صوارماً","بل قلّدوه جواهراً وعقودا",67,"د",2,0],["لم يَحْكِ جُودَ يَدَيْهِ الغيثُ منهمِراً","ومثلَ ما حِكْتَ فيه الرَّوْضُ لَمْ يَحِكِ",68,"ك",1,0],["لم يحمِلُوا عَيْبَ ذي قالٍ يَعِيبُهُمُ","فِي الجودِ والبأْسِ إِلّا أَنَّهُ سَرَفُ",69,"ف",1,0],["لم يُحصِ أنفاساً عليه مُسلَّطٌ","يوماً ولا هو سامه تحديدا",70,"د",2,0],["لم يُحصر الفن فن ذهن وانان","حتى يمجد شعري فوق حسباني",71,"ن",2,1],["لم يحترِش ضَغَناً ولا حُنِيتْ","عُوجُ الضلوع له على غِمرِ",72,"ر",1,0],["لم يُحدِث القُرٌّ العنيفُ بوجههِ","نَدَماً ولو جاءَ الشتاءُ بأفْكلِ",73,"ل",1,0],["لم يحلَ صدر الدهر قبل مثلها","كلاًّ ولا جيد الزمان الحاضر",74,"ر",1,0],["لم يحمِ عنه ربعَهُ","عديدُهُ وعُدَدُه",75,"د",2,0],["لم يحل في بصري ولم يحلل به","إل