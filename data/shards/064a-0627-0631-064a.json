تظالم","https://www.poetsgate.com/ViewPoem.aspx?id=210815",""],[5535,"يا ريس الحب أدركني فقد وحلت","https://www.poetsgate.com/ViewPoem.aspx?id=201502",""],[5542,"نفحة من بستان الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=10057",""],[5590,"يا ريح تحملي من المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=105275",""],[5626,"يا ريمُ رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=189508",""],[5725,"يا ريم","https://www.poetsgate.com/ViewPoem.aspx?id=195217",""],[5736,"يا ريح تشرين","https://www.poetsgate.com/ViewPoem.aspx?id=203878",""],[5749,"الفكلمة","https://www.poetsgate.com/ViewPoem.aspx?id=132697",""],[5756,"مدح الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8434",""],[5784,"#يا ريح","https://www.poetsgate.com/ViewPoem.aspx?id=210510",""],[5830,"يَا صَاحِبَ الكَلِمَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=200769",""],[5858,"دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=188129",""],[5977,"رياح الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=213086",""],[5997,"الرحى جوعى","https://www.poetsgate.com/ViewPoem.aspx?id=214466",""],[6013,"يا نسيماً هب مسكاً عبقاً","https://www.poetsgate.com/ViewPoem.aspx?id=181605",""],[6057,"نبع المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=184739",""],[469,"يا خائنا ما كنت احس","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574831",""],[6190,"على سبيل الأمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87008&r=&rc=14",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""],[5567,"شغف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81761&r=&rc=29",""],[572,"ياريمُ كمْ أدنو وأنتَ ترِيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9467&r=&rc=324",""]],"verses":[["يا ريمَ ذا الأَجرَعِ يَرعى بِهِ","ثِمارَ قَلبي بَدَلَ الرَطبِ",0,"ب",1,1],["يا رِيمُ ما لِيَ إِلّا بالهَوى شُغُلُ","فَمُنْيةُ النَّفْسِ حَيْثُ الأَعْيُنُ النُّجُلُ",1,"ل",1,1],["يا ريحُ لَولا أَنَّ فيكِ بَقِيَّةً","مِن طيبِ عَبلَةَ مُتُّ قَبلَ لِقاكِ",2,"ك",1,0],["يا رِيقَهُ حيّرْتَني ومَطَلْتَني","ما أنْتَ إلا بارِدٌ يا رِيقَهُ",3,"ه",1,0],["يَا رَئِيسَ القَصْرِ مِنْ قِدَمٍ","وَأُسَاةِ العَصْرِ فِي العَقْبِ",4,"ب",1,0],["يَا رَئِيسِي وَأَوْلِيَائِي وَآلِي","قَدْ رَفَعْتُمُ شَأْنِي بِأَيِّ احْتِفَالِ",5,"ل",1,1],["يا ريح مهلاً فلا تُذري الرماد بها","إن الرماد الذي تذرين أموال",6,"ل",1,0],["يا رئيساً به لقد أُدّب الده","ر الذي قد جنى على الآداب",7,"ب",1,0],["يا رئيساً أضحتْ بهِ حلبُ الش","هباء مَلقى الأفواج فالأفواج",8,"ج",1,0],["يا رئيساً أحيى الثنا بنوالٍ","كفّ عنا إزْلَ الزمانِ وإرْزَه",9,"ز",2,0],["يا رئيساً نرجو به أدب الدّه","ر لأنَّا نراه من خُدَّامهْ",10,"م",2,0],["يا رئيساً دعا الزمان لهُ الوف","د وقال الرجاء حثُّوا المطيّا",11,"ي",2,0],["يا رِياحَ الوُجُود سيري بعنفٍ","وتغنِّي بصَوْتِكِ الأَوَّاهِ",12,"ه",1,0],["يا ريت تشوف في المنام","دمعي وتنظر ضنايا",13,"ي",2,0],["يا ريحُ أَنتَ اِبنُ السَبي","لِ ما عَرَفتَ ما السَكَن",14,"ن",1,0],["يا رياحا ليس يهدا عصفها","نضب الزيت ومصباحي انطفا",15,"ف",2,0],["يا ريمُ هاتِ الدَواةَ وَالقَلَما","أَكتُبُ شَوقي إِلى الَّذي ظَلَما",16,"م",2,1],["يا رِئمُ قولي لِمِثلِ الرِئمِ قَد هَجَرَت","يَقظى فَما بالُها في النَومِ تَغشاني",17,"ن",2,0],["يا ريح رفقاً فالَّذي","تلوينه غصن رطيب",18,"ب",1,0],["يا ريح مرِّي عَلى خيامِ","فشا بمن حلها غرامي",19,"ي",1,0],["يَا رَئِيسِي إِنِّي لأَذْكُرُ عَهْداً","قَدْ تَوَلَّى بِهِ زَمَانٌ سَحِيق",20,"ق",1,0],["يا رِياضاً زهَرَتْ في فارسٍ","شكرَتْكنَّ عُيونٌ وأُنوف",21,"ف",1,0],["يارَئيسَ الشِّعرِ قُل لي","مَا الذّي يَقْضِي الرَّئِيسُ",22,"س",1,1],["يا ريم رامة لَم أَقُل","لَولاك جادَ الوَدق رامه",23,"ه",1,1],["يا ريم رفقا اني","لميت وحي",24,"ي",1,0],["يا ريم غيرك ما نظرت فخلني","من كاذب خبر التلون قد روى",25,"و",2,0],["يا ريم منك ادمى","فؤادي السنان",26,"ن",1,0],["يا ريم رفقا بالذي","عاث به عذاله",27,"ل",2,0],["يا ريم حاجر ما هذا الجفاء اما","تولي محبك احسانا وتنصفه",28,"ف",2,0],["يا ريقةَ اللمياءِ تلعبُ بالنهى","لم أدرِ ايكما من الصَّهباءِ",29,"ا",2,0],["يا رئيسَ الدَّهرِ كن لي مُنصفاً","من خطوب الدهرِ إن الدهر خَصمي",30,"م",2,1],["يا رئيسَ الزمان دعوةَ عَبدٍ","مُستَجيرٍ من صَرفِ هذا الزمان",31,"ن",1,0],["يا ريح سرقين البغا","ل يداف في بول الحمير",32,"ر",1,0],["يا رئيساً من الأنام وقد قل","مقالى لغيره يا رئيسا",33,"س",2,0],["يا رئيساً أطال بسط المعاني","بالمعالي وطاب لفظاً وجيزا",34,"ز",2,0],["يَا رِيم قَصْرٍ بِه أهِيمُ","الصّبْحُ ما لَمْ تَلُحْ بَهِيمُ",35,"م",1,1],["يا رئيس الخطابة ازددت قدرا","وبك ازدادت المنابر بشرى",36,"ر",2,1],["يا رياحاً حملتْ","أردانُها ريّا الخزام",37,"م",1,0],["يا رياح المغيب هبي بقلبي","وبنفسي وراحتي وشبابي",38,"ب",2,0],["يا رِياحَ الشَآمِ أَنتِ رَسولٌ","يَتَعَنّى في حاجَةِ العُشّاقِ",39,"ق",1,0],["يا رئيساً تحكَّمَنْ","يا إماماً ترفَّقا",40,"ق",2,0],["يا رِياح الفَجر مِن نَحو الحِمى","هَجتِ لي لَما تَنسمتِ الطَرَب",41,"ب",1,1],["يا ريشتي، أنتِ في الإبداعِ رائدةٌ","كبَّرْتِ من لَمحَاتِ الفَنِّ ما صَغُرا",42,"ر",2,0],["يا رياح الانس من وادي الطرب","صافحي عني أباه ذا الأدب",43,"ب",1,0],["ياريحُ لا أرجٌ منهمُ وقد رحلوا","عن الجَنابِ ولاعِلمٌ ولاخَبَرُ",44,"ر",1,0],["يا ريمَ رامةَ كم مَنَعْتَ على النوى","عنّي ممرَّ خيالكَ الزّوارِ",45,"ر",1,0],["يا ريمَ رامةَ بي شوقٌ يُهيِّجُهُ","ذِكرى قديمِكَ والاِحسانُ محسوبُِ",46,"ب",1,0],["يا ريمَ رامةَ قد أمسيتَ تُسلِمُني","الى الممضَّينِنسياني واِغفالي",47,"ل",2,0],["يا ريحُ رُبَّ كُرْبَةٍ أزالها","بارِؤُنا بالفَرَجِ السَّريعِ",48,"ع",1,0],["يا رئيسَ الأقْطابِ حيًّا وميْتاً","يا ابنَ بنتِ النَّبيِّ يا مولائي",49,"ا",2,0],["يَا رئيساً نَخالُه مَرؤُوسَا","رَغمَ أكتافٍ تَحمِلُ البَرنُوسا",50,"س",2,1],["يا رياض الجنان من حان قربي","عطرينا بالطيب من نفحاتك",51,"ك",1,0],["يَا رِيْمُ كَمْ أَدْنُو وَأَنْتَ تَرِيْمُ","وَتَنَامُ عَنْ لَيْلِي وَلَسْتَ تُنِيْمُ",52,"م",1,1],["يا ريم أنت من العناد","دعيت بالريم العنود",53,"د",1,0],["يا رياضَ الحُسِن ما تَلَفي","فيكَ إلاَّ الوَردُ والآسُ",54,"س",1,0],["يا رِياض العُلى وَرُكنَ الشَهامَهْ","وَمُشيرَ الخديوِ رَبِّ الزَعامَهْ",55,"م",2,1],["يا رِياضاً أهْدَى لأَنْفي بَهارا","وصَباحاً أبْدَى لِعَيْني نَهارا",56,"ر",2,1],["يا ريمُ قومي الآن ويحكِ فانظري","ما للربى قد أظهرتْ إِعجابَها",57,"ه",2,1],["يا رياح بن عُقبةَ بن أبي رَمْ","ثةَ يا شرَّ منْ حوته الرجالُ",58,"ل",1,1],["يا رياض الحسن هل ثمر","أجنيه منك أو زهر",59,"ر",1,1],["يا ريم سلعٍ هل يعود لنا","عود الوصال برامة لدنا",60,"ن",2,0],["يا ريم رامة يا غزالاً لَم يَكُن","منّا عقولٌ يوم ودّع ناركا",61,"ك",2,0],["يا رئيس البلاد هذي بلاد","عرفت بالوفاء للخلصاء",62,"ا",2,0],["يا رياضياً رياضاً جنيت منها فنوني","صدق الله فيك كل ظنوني",63,"ن",2,1],["يا رئيسَ الحكماءِ استَجلِها","من بناتِ الفِكر بِكراً مُترَفَه",64,"ف",2,0],["يا رياضَ الوصال أثمرتِ غيدا","فاجتنينا سوالفاً وخُدودا",65,"د",2,1],["يا ريح نفخ الصور","يا كاف ها يا نون",66,"ن",1,0],["يا ريح زهر العبهرِ","يا نقش فرش العَبقري",67,"ي",1,0],["يا ريم يا تَسنيم عين محمد","يا درّة الأَسرار يا باهوت",68,"ت",1,1],["يا ريح قولي للذين تغيبوا","عني براس البر يا أسيادي",69,"ي",1,1],["يا رياح الحياة في مصرَ هُبّي","روِّحينا بطيب ريّا الحياة",70,"ه",1,0],["يا ريم مِنْ القنيص مرْفُوْق","ذيّرك شمس ولمع براق",71,"ق",1,0],["ياريف روحي يابعد كل محبوب","والله ما اسمع قول اللواحي",72,"ح",2,0],["يا ريمُ إِنَّكِ وَالَّذي يَجلو الضُحى","أَولَى الحِسانِ بِمَدحِهِ تُختارُ",73,"ر",1,1],["يا ريقة اللسن الفصاح وذوقها","لك في الفنون مهارة الحكاك",74,"ك",1,0],["يا رَئيسي دين النبي وَكُل","مِنكُما يفضل ابن سينا الرَئيسا",75,"س",2,0],["يا رَيط هَل لي عِندَكُم نائِل","أَم لا فَإِنّي مِن غَدٍ راحِلُ",76,"ل",1,1],["يا رَيط يا أُختَ بَني مالِكٍ","أَنتِ لِقَلبي شُغلٌ شاغِلُ",76,"ل",1,0],["يا رَيطَ هَل عِندَكُم دائِمٌ","إِنّي لمن واصلَني واصِلُ",76,"ل",1,0],["يا رَيطَ يا رَيطَ أَلَم تُخبَري","عَنّا وَقَد يَحمِدُنا السائِلُ",76,"ل",1,0],["يا رياضاً شبهتها بغوانٍ","فبحقي عليك أين غواني",77,"ن",2,0],["يا رئيسا قد شد للفضل ازراً","واليه الزمان القى الزماما",78,"م",2,0],["يا رئيس النبل يا سامي الذرى","انت عين المجد فينا الاثر",79,"ر",1,1],["يا رئيساً شددت للدين ازراً","وشفيت من الزمان غليلا",80,"ل",2,0],["يا ريح إذا أتيت دار الأحباب","قبل عني تراب تلك الأعتاب",81,"ب",1,1],["يا ريح إذا أتيت أرض الجمع","أغني طوسا فقل لأهل الربع",82,"ع",1,1],["يا ريح إذا أتيت أرض النجف","فالثم عني ترابها ثم قف",83,"ف",1,1],["يا ريحُ أقُصُّ قِصَّةَ الشَّوقِ إليكْ","إن جِئْتَ إلى طُوس فباالله عَليْكْ",84,"ك",1,1],["يا رئحا بلغ رجالاً من بني","قيس بن إبراهيم كالأعلام",85,"م",1,0],["يا رياحَ المريس هُبيِّ وصُبي","وأجهدي إنَّ قبّةَ الفرنِ عِنْدي",86,"د",2,0],["يا ريمَ رامةَ قد فُطرتُ على الهوى","طفلاً وَدَبَّ العِشقُ في أمشاجي",87,"ج",2,0],["يا رياح الخريف منك فراراً","ووداعاً أيا ليالي المصيف",88,"ف",1,0],["يا ريف إن كتاب بؤسك مشكل","يعيا بحل رموزه الشراح",89,"ح",1,0],["يا ريف مالك شرب أهلك آجن","رنق وشرب ولاة أمرك راح",89,"ح",1,0],["يا ريم من لي وسط قلبي مقر","وفي وسط مهجتي حاضر",90,"ر",1,1],["يا ريم في عشقتك روحي رهين","أمحنني بالهجر تمحين",91,"ن",1,0],["يا ريم مالي للجفا","ولا البعاد مصطبر",92,"ر",1,0],["يا ريم في أي واد","قد كان يرتع سربك",93,"ك",1,0],["يا رياض الخدود دمت وان لم","يجتني الطرف من رياضك وردا",94,"د",2,0],["يا ريم لا يَا المَحَل واديك","يِعلَه خِصب فِيْ كِلّ عَامِ",95,"م",1,0],["يا ري كل ظما واليوم قلبك من","حر الظما لو يمس الصخر ينضحة",96,"ه",1,0],["يا رئيساً ذلت لديه نفوس","رغبة وانحنت إليه رؤوس",97,"س",1,0],["يا رياض النرجس","في الربيع الناضر",98,"ر",1,1],["يا رياضاً عمها الغيث انسجاما","وسقا أرجاءها بالأنس جاما",99,"م",2,1],["يا رِياضي يا راحَتي يا دَوائي","يا شَقائي يا أَنفَعُ التِرياقِ",100,"ق",1,0],["يا رياض البسفور جادك مزنٌ","كل يومٍ لوبله تهتان",101,"ن",1,0],["يا رياض الربيع مالك جرداء","وما للقضا بزهرك أودى",102,"د",2,0],["يَا رِيحُ أقبَلَ مِن غَربٍ فَثَقَّلَ فِي","زِيَارَةٍ لَهُ إِنَّنَا سَئمنَاكَ",103,"ك",1,1],["يا رَئِمُ يا قاتِلَتي","إِن لَم تَجودي فَعِدي",104,"د",2,1],["يا ريمُ فَاِشفي كَبِداً","حَرّى وَقَلباً شَغِفا",105,"ف",2,0],["يا رِئمُ قَد أَتلَفَتِ روحي فَما","مِنها مَعي إِلّا القَليلُ الحَقير",106,"ر",1,1],["يا ريم وجدي فيك ليس يريم","بين الضلوع وإن رحلت مقيم",107,"م",1,1],["يا ريحَ ذا القلم الذي جرَّدتَهُ","لو كان سرَّ بقدر ما قد ساءَ",108,"ا",2,0],["يا ريم رامة واللوى","بك استجبر من النوى",109,"ن",3,1],["يا ريم حسبك مهجتي مرعى","لا شيح كاظمة ولا الجرعا",110,"ع",2,1],["يا ريحُ مَتى هَمَمتِ بالتطوافِ","أَدّي خبري خُصِصتِ بالأَلطافِ",111,"ف",1,1],["يا ريحُ صلي أَهلَ وِدادي 