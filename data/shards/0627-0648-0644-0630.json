{"poems":[[556,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55884","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112323","الكامل"]],"verses":[["أو لذّةً نِيلتْ وليس يحفُّها","أبدَ الزّمان تكلّفٌ وتجشُّمُ",0,"م",1,0],["أو لذاك العدل عود يرتجى","وإلى الأمن رجوع كالقدم",1,"م",1,0],["أو لذت ببريطانيا","في حضن أسطول متين",2,"ن",1,0]]}