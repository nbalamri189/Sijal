{"poems":[[55,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[53,"يا فؤادي غلبتني عصيانا","https://www.aldiwan.net/poem66699.html","الخفيف"],[93,"كن بلسما إن صار دهرك أرقما","https://www.aldiwan.net/poem62736.html","عموديه"],[51,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[48,"تمزن من مزن السحاب معاشر","https://www.aldiwan.net/poem23500.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85551","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[98,"عام جديد","https://www.poetsgate.com/ViewPoem.aspx?id=17900",""],[53,"يافؤادي غلبتني عصيانا","https://www.poetsgate.com/ViewPoem.aspx?id=30763",""],[132,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[147,"كن بعيدا إن شئت أو كن قريبا","https://www.aldiwan.net/poem11727.html","الخفيف"],[159,"كن بعيدا إن شئت أو كن قريبا","https://www.aldiwan.net/poem55765.html","الخفيف"],[264,"يا سالك بالهدى طريق البكري","https://www.aldiwan.net/poem35429.html","الدوبيت"],[290,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[310,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[385,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[409,"بنت فكر وافت كشمس النهار","https://www.aldiwan.net/poem33921.html","الخفيف"],[422,"كن بالمدامة للسرور متمما","https://www.aldiwan.net/poem54035.html","الكامل"],[435,"بعز حسن مهيب","https://www.aldiwan.net/poem40727.html","المجتث"],[484,"قم بالمهمة في حل ومرتحل","https://www.aldiwan.net/poem36964.html","البسيط"],[510,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[563,"كل شيء كما أتى النص هالك","https://www.aldiwan.net/poem33538.html","الخفيف"],[563,"صورة إن نظرتها كلفتني","https://www.aldiwan.net/poem33731.html","الخفيف"],[563,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[563,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[563,"إن كاس التوحيد من يحتسيه","https://www.aldiwan.net/poem33892.html","الخفيف"],[563,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[563,"كن باسم حبك تكن موجود لا باسمك","https://www.aldiwan.net/poem34283.html","المواليا"],[563,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[567,"أنت الخليل وفي الأطلال برد لظى","https://www.aldiwan.net/poem52975.html","البسيط"],[580,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[592,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107094","الرجز"],[803,"","https://poetry.dctabudhabi.ae/diwan/poem/146130","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48696","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100137","المتدارك"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115966","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101036","المجتث"],[1787,"","https://poetry.dctabudhabi.ae/diwan/poem/105104","الرمل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45664","الرمل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102586","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82947","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94316","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58333","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145140","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126931","الخفيف"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45771","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110131","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110062","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109990","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205541","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85186","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85219","الخفيف"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122252","الرمل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32484","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69924","الكامل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/141098","المنسرح"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52158","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52183","الرمل"],[4750,"زيارة","https://www.poetsgate.com/ViewPoem.aspx?id=180413",""],[4750,"القناص","https://www.poetsgate.com/ViewPoem.aspx?id=180400",""],[4755,"حَجْر الله\" الصحي","https://www.poetsgate.com/ViewPoem.aspx?id=211332",""],[4785,"سفر","https://www.poetsgate.com/ViewPoem.aspx?id=129735",""],[4830,"سجايا المرء","https://www.poetsgate.com/ViewPoem.aspx?id=199666",""],[4850,"إليك","https://www.poetsgate.com/ViewPoem.aspx?id=33323",""],[4916,"دندنه","https://www.poetsgate.com/ViewPoem.aspx?id=136925",""],[4987,"خيل السروج","https://www.poetsgate.com/ViewPoem.aspx?id=49559",""],[5002,"حوَّاء....","https://www.poetsgate.com/ViewPoem.aspx?id=210694",""],[5010,"كن بياضا","https://www.poetsgate.com/ViewPoem.aspx?id=189858",""],[5038,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=190147",""],[5064,"استبصار","https://www.poetsgate.com/ViewPoem.aspx?id=199090",""],[5064,"بينَ .. بينَ","https://www.poetsgate.com/ViewPoem.aspx?id=199135",""],[5106,"مِهْرَجَانُ الشَّمْس .","https://www.poetsgate.com/ViewPoem.aspx?id=153972",""],[5111,"هَا...هُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=212321",""],[5136,"صاح إياك والركون إلى الد","https://www.poetsgate.com/ViewPoem.aspx?id=121504",""],[5329,"فكرةٌ شدهى","https://www.poetsgate.com/ViewPoem.aspx?id=214707",""],[5388,"كن بخير","https://www.poetsgate.com/ViewPoem.aspx?id=206910",""],[5512,"ملائكة الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=204346",""],[5512,"وتشرق شمس صبحي","https://www.poetsgate.com/ViewPoem.aspx?id=204624",""],[5691,"تناقضات","https://www.poetsgate.com/ViewPoem.aspx?id=206156",""],[5723,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=25485",""],[5729,"أراني سجنت","https://www.poetsgate.com/ViewPoem.aspx?id=203975",""],[5756,"الثريا","https://www.poetsgate.com/ViewPoem.aspx?id=5417",""],[6068,"سحّتْ دموعي لجّها تهيّيجا -17-","https://www.poetsgate.com/ViewPoem.aspx?id=175813",""],[6256,"أحبك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65915&r=&rc=3",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""],[5567,"كن بي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81765&r=&rc=33",""],[5064,"تبصِرَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87525&r=&rc=20",""]],"verses":[["كَنِبالِ القاريَّ يَر","مي بِهِنَّ المَرامِيا",0,"ي",2,0],["كن بهذا الوصف ما اخضَر","رَ بشَامٌ وثُمامُ",1,"م",1,0],["كُنَّ بالأولياء مُفتتناتٍ","ثم زِيدوا نوراً فزِدْنَ افتِتانا",2,"ن",2,0],["كُن بَلسَماً إِن صارَ دَهرُكَ أَرقَما","وَحَلاوَةً إِن صارَ غَيرُكَ عَلقَما",3,"م",2,1],["كُن بِالسُؤالِ أَشَدَّ عَقدَ ضَنانَةٍ","مِمَّن يَضِنُّ عَلَيكَ بِالأَموالِ",4,"ل",1,0],["كَنَبتٍ ضَعيفٍ لَم يُوازِرهُ غَيرُهُ","فَأَيُّ نَسيمٍ هَبَّ فَهوَ يَهُزُّني",5,"ن",2,0],["كن بالحقيقة مجهاراً وإن جرحت","وأعلن السر كل السر إعلانا",6,"ن",2,0],["كنْ بشيرَ الحبّ والنور إلى","مُهَجٍ كلْمى وأكبادٍ دوامي",7,"م",2,0],["كن بشير الحبّ الحبّ والنّور إلى","مهج كلمي وأكباد دوامي",8,"م",2,0],["كُنَّ بالأولياء مُفتناتٍ","ثم زِيدوا نوراً فزِدْنَ افتِتانا",9,"ن",2,0],["كنْ بصيراً بأهل دهرِك وافتحْ","جَفنَ عين إن كنتَ عينَ البصيرِ",10,"ر",1,0],["كُن بَعيداً إِن شِئتَ أَو كُن قَريبا","فَأَياديكَ عِندَنا لَن تَغيبا",11,"ب",2,1],["كُنْ بعيداً إِنْ شئتَ أَو كنْ قريبا","أَنتَ أَسقمتَني فكُنْ لي طبيبا",12,"ب",2,1],["كن بالذكر كبلبل الأقفاص","لا ترهب من دانٍ ولا من قاص",13,"ص",1,0],["كنبيء الله نوح جدنا","ملك الموت له العمر طوى",14,"و",2,0],["كُن بِها اليومَ صابراً ومعزّى","وَمُهنّا بها ليوم الحسابِ",15,"ب",1,0],["كُن بِالتَواضع لِلوَرى مُتحبباً","إِن التَواضع جالب التَفخيم",16,"م",1,0],["كن بعلم اللسان صبَّا مُعنَّى","وبعلم الكتاب والآثار",17,"ر",1,0],["كُنْ بالمدامة للسُّرور مُتَمِّما","صفراءَ قبلَ المزج تحكي العَنْدَما",18,"م",2,1],["كن بالعقيق رحيما","فالفضل يُعزى إليهِ",19,"ه",1,0],["كن باتحادك نبراسا يضيء به","ما أظلمته دياجي الشك والخطل",20,"ل",1,0],["كنْ بعيداً من مَنِّهمْ لا يصيبُ","وقريباً يُشفى بهِ المحْرومُ",21,"م",1,0],["كن به عارفاً وكن مستقيماً","وتحقق فإن هذا المالك",22,"ك",1,0],["كن بلا أنت إن أردت ارتياحاً","وقبولاً منها لنيل التمني",23,"ن",2,0],["كن به عارفا ودُمْ فيه مغريً","وتقرب له تكن إنسانا",24,"ن",2,0],["كن بإيمانك المقلد واقنع","فيه بالله والنبيِّ التهامي",25,"م",2,0],["كن بصيراً ولا تلم أهل سكر","بشراب التُقى تصير الملوما",26,"م",2,0],["كن به معتصماً واسلم له","لا تعاند فيه واهجر بدعك",27,"ك",1,0],["كن باسم حبك تكن موجود لا باسمَكْ","واخرج عن الفكر إن الفكر من رسمَكْ",28,"ك",1,1],["كن بلا أنت تكشف الحجب عنه","ويريك الذي أرى الإنجابا",29,"ب",2,0],["كن بالغاً أوجَ سعدٍ ما بهِ ضررٌ","أو غالباً لم يزَل في أوَّل الظفرِ",30,"ر",1,0],["كُنْ بشَراً أَو مَلِكَا","أَو مَلَكاً مُقَرَّبا",31,"ب",2,0],["كن باذل الجد في علم الحديث تنل","كل العلوم وكن بالأصل مشتانا",32,"ن",2,0],["كن بعض جند العلم عن نصره","فالفتح قد رف على أعلامه",33,"م",2,0],["كن بخيلاً وتواضع تحتمل","أو سخّياّ يحتمل منك الصّلف",34,"ف",1,0],["كن بيننا كسواك ضيفاً راضياً","تصفو لنا وله الحياة وتعذب",35,"ب",1,0],["كن بالسلف الماضي وبما","لاقت آباؤك معتبرا",36,"ر",2,0],["كُن بالزّمان فيهمُ ذا ثقةٍ","فَرُبَّما فازض بِه مَن وثقا",37,"ق",2,0],["كن بالعلوم ولوعاً","ترق المقام الجليلا",38,"ل",2,0],["كن بدنياك صموتاً","آفة الإنسان نطق",39,"ق",1,0],["كُن بِما اوتيته مُقتَنِعاً","تَستَدم عَيش القَنوع المُكتَفي",40,"ف",2,1],["كن بالوعيد مصدّقا","وبالوعود محققا",41,"ق",2,0],["كن بِما أوتيتُهُ مغتبطا","تستدم عُمرَ القَنوعِ المُكتفي",42,"ف",2,1],["كن بالحلال راضيا وقانعا","ولا تكن لما سواه قانعا",43,"ع",2,0],["كَنَبْتُ وَلَحظي قد تَبدَّلَ نَرجساً","بورْد وَدَمعي قَدْ تَساقطَ مَنْثورا",44,"ر",2,1],["كن بالذي أعطاك ربك راضيا","ولا تك في جمع الثراء منافسا",45,"س",2,0],["كن بيوم المعاد لي عند ربي","شافعا حيث أبهضتني الذنوب",46,"ب",1,0],["كُن بِالإِله عَلى عُداتِكَ مَظهَرا","بَأساً تَنالُ بِهِ عَلَيهُم مَظهَرا",47,"ر",2,1],["كُن ببلواكَ شاكراً غيرَ شاكٍ","كي تَرَى اللَهَ في بِلاكَ مُعينا",48,"ن",2,1],["كن بالنَدامةِ يوماً ثابتاً قَدَماً","كيلا تقولَ غداً يا زَلَّةَ القَدَمِ",49,"م",1,0],["كُن بالنَدامةِ مُولَعاً","لا بالخَلاعةِ والوُلُوعِ",50,"ع",1,0],["كن بينهم «بوذا» فإن لم تطق","فكن كتيمور ونيرونا",51,"ن",2,1],["كن بالخوالج حياً فالحجى جدث","لربه ووقار الحلم أكفان",52,"ن",1,0],["كن بي رؤفاً راحماً وتولني","فضلاً بفضلك في جميع عوالمي",53,"ي",1,0],["كن بهم لائذاً على كل حال","كي بهم تحزر الخصال الجميلة",54,"ل",2,0],["كنبي اللَه يحيي ذي الوفا","وكذا الكفل جزيل المنن",55,"ن",1,0],["كُن بِصَبٍّ أَمسى بِحُبِّكَ بَرّاً","إِن يَحيى قَد كانَ بَرّاً تَقِيّا",56,"ي",2,0],["كُن بانتخاب الروح بطرس كَالصفا","يا مَن عَلَيهِ الرُوح حلَّ مرفرفا",57,"ف",2,1],["كن بالذي حدّثوا على ثقة","ما في حديث الفراق من إفك",58,"ك",1,0],["كنبتَةِ وردٍ شوّكت زمنَ الصبا","وفي زَهرها أضحت تزانُ الولائِدُ",59,"د",1,0],["كنَّ باسم السيف حُمراً من دمٍ","واستحلنَ اليومَ باسمِ السلم خُضرا",60,"ر",2,0],["كن برّاق السمر في معنقها","او هلال النصف فالبيض لا ثّنا",61,"ن",2,0],["كن بياضك من حمارك لاتقّسم","عارض في وجنتك موكب مراسم",62,"م",1,0],["- كُن بِخَيرٍ \"يا دَاعِيَ الحَجرِ\"","(حَجرُ اللهِ) أَقوَى.. قالت لهُ \"أُمُّ بَرعَة\"",63,"ع",2,0],["كنْ بينهم رجل الزمان","تظلُّ \"تركو\" محتقر",64,"ر",1,0],["كَنَبْتٍ يستقي من أيّ نبعٍ","وتزهو فيه أزهارٌ زِهارُ",65,"ر",1,0],["كنبع من الماء لاح النهار","وسلساله العذب جار وفير",66,"ر",1,0],["كن بيني وبينهن دمّ وقرابه","يافديت شعورهن يوم إكتبنّي",67,"ن",2,0],["كن بين الضلوع العوج صفقات موج","يوم فاض الغلا والشوق والقلب هاج",68,"ج",1,0],["كنَبٕع سَٰلْسلٕ رَسَمَ العطَاشى","وكاسُ وُرودها يُشْفي العَليلا",69,"ل",2,0],["كُنْ بَيَاضًا إنْ تَكُ الدُّنْيَا سَوَادَا","وَوِدَادًا للَّذِي يَرْجُو وِدَادَا",70,"د",2,1],["كنْ بالسّما مثْل الشهيد فقدْ"