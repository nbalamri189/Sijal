aspx?id=205622",""],[5431,"ما أطفأ النارَ بردٌ فيَ مرتعشُ","https://www.poetsgate.com/ViewPoem.aspx?id=200537",""],[5459,"لغز الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=190964",""],[5533,"المعلِّم","https://www.poetsgate.com/ViewPoem.aspx?id=177058",""],[5616,"آلاء","https://www.poetsgate.com/ViewPoem.aspx?id=205243",""],[5943,"بدايات ونهايات","https://www.poetsgate.com/ViewPoem.aspx?id=61814",""],[5956,"في عُشّنا الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=182125",""],[5956,"هدايا للأطفال العرب من صهيون","https://www.poetsgate.com/ViewPoem.aspx?id=192184",""],[5956,"كيان شرير التكوين","https://www.poetsgate.com/ViewPoem.aspx?id=192313",""],[5956,"يا ألفَ شكر للسمية بِنْتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=206261",""],[5957,"يا حبيَ الخالدَ","https://www.poetsgate.com/ViewPoem.aspx?id=12540",""],[6056,"شقائق النعمان","https://www.poetsgate.com/ViewPoem.aspx?id=130320",""],[6202,"ما غيّروك عن النضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86751&r=&rc=52",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""]],"verses":[["ما أَطاعوا النَبيَّ فيكَ وَقَد ما","لَت بِأَرماحِهِم إِلَيكَ الذُحولُ",0,"ل",1,0],["ما أَطيَبَ الأَمرَ وَلَو أَنَّهُ","عَلى رَزايا نَعَمٍ في مَراح",1,"ح",1,0],["ما أَطيَبَ العَيشَ فَأَمّا عَلى","أَلّا أَرى وَجهَكِ يَوماً فَلا",2,"ل",2,1],["ما أَطوَلَ الدُنيا وَأَعرَضَها","وَأَدَلَّني بِمَسالِكِ الطُرُقِ",3,"ق",1,0],["ما أطيب العيش في الدنيا لو أتَصلت","أسباب دنياي مع أسباب دنياك",4,"ك",1,0],["ما أُطلقتْ في ذاك إل","لا حين آن لها تُغَلُّ",5,"ل",1,0],["ما أَطاعوا فيكِ أَحكامَ النُهى","لا وَلا قَولَ الكتابِ المُنزَلِ",6,"ل",1,0],["ما أَطيَبَ وَقتَنا وَأَهنى","وَالعاذِلُ غائِبٌ وَغافِل",7,"ل",1,0],["ما أَطمَعَ العُذّالَ إِلّا أَنَّني","خَوفاً عَلَيكَ إِلَيهِمُ أَتَمَلَّقُ",8,"ق",1,0],["ما أَطيَبَ اللَيلَ فيهِ حينَ أَسهَرُهُ","كَأَنَّما زَفَراتي فيهِ أَسمارُ",9,"ر",1,0],["ما أَطاقوا دَفنَ الَّذي أَظهَروهُ","كَبُرَ الحِقدُ أَن يَكونَ دَفينا",10,"ن",2,0],["ما اطرد الشعر للجمال وما","أقبح ملكا تزول نعمته",11,"ت",2,0],["ما أَطيَبَ العَيشَ لَولا أَنَّ سالِكَهُ","يُمسي لِأَسهُمِ كَيدِ الناسِ كَالهَدَفِ",12,"ف",1,0],["ما أَطاقَ الدَّهرُ أَنْ يَسلِبَها","أرَجَ المِسكِ ولَونَ العَسجَدِ",13,"د",1,0],["مَا أَطْيَبَ الْعَيْشَ لَوْلا أَنَّهُ فَانِي","تَبْلَى النُّفُوسُ وَلا يَبْلَى الْجَدِيدَانِ",14,"ن",1,1],["ما أطيبَ المالَ وأحلى النِّعَما","لولا مقاساةُ العبيدِ والإما",15,"م",2,0],["ما أَطلَقَ الحَتفَ إِلّا اِنسابَ في أَجَلٍ","مُصَفَّدٍ في يَدِ الأَقدارِ مَغلولِ",16,"ل",1,0],["ما أَطعَمُ النَومَ حَتّى الصُبحِ أَكلَؤُهُ","كَما تَكالا حِذارَ العَورَةِ الحَرَسُ",17,"س",1,0],["ما أُطلِقُ العَينَ في شَيءٍ أُسَرُّ بِهِ","وَلَستُ أُبدي الرِضا إِلّا عَلى السَخطِ",18,"ط",1,0],["ما أَطيَبَ المَوتَ لِشُرّابِهِ","إِن صَحَّ لِلأَمواتِ وَشكُ اِلتِقاء",19,"ق",3,0],["ما أَطيَبَ العَيشَ عِندَ قَومٍ","لَو أَنَّهُ كانَ لا يَزولُ",20,"ل",1,1],["ما أَطْيَبَ ما بِتْنَا معاً في بُرْدٍ","إذْ لاصَقَ خَدَّهُ اعْتِنَاقاً خَدِّي",21,"ي",1,1],["مَا أَطْيَبَ العَيْشَ لَوْ أَنَّ الفَتَى حَجَرٌ","تَنْبُو الحَوادِثُ عَنْهُ وَهْوَ مَلْمُومُ",22,"م",1,0],["ما أُطِيقُ الَّذِي ادَّعيْت ولَوْ مُلْ","لِكْتُهُ لم أَكُنْ لغَيْركَ عبْدا",23,"د",2,0],["ما أَطْرَبَتْ فَوْقَ الغُصُونِ حَمامةٌ","إِلا رَأَيْتَ دُمُوعَ عَيْني تُسْكَبُ",24,"ب",1,1],["ما أطيَبَ العيشَ إلّا أَنَّهُ","عن عاجِلٍ كُلُّه متروكُ",25,"ك",1,0],["مَا أَطْوَلَ اللَّيْلَ عَلَى السَّاهِرِ","أَمَا لِهَذَا اللَّيْلِ مِنْ آخِرِ",26,"ر",1,1],["ما أطيب العيش لولا ان يشاركني","فيما ينغصه الهيابة الوكل",27,"ل",1,0],["ما أطيق الذي ادعيت ولو","ملكته لم أكن لغيرك عبدا",28,"د",2,0],["مَا أَطَعْتُ بِهَا بِالْغَيْبِ، قَدْ عَلِمَتْ","مَقَالَة َ الكَاشِحِ الواشي إذا مَحَلا",29,"ل",2,0],["ما أطوعَ الشِّعْرَ في مَدْحِ الحَبيبِ، متى","طَلَبْتُهُ جاءَ مُنْقادًا فأَرْتَجِلُ",30,"ل",1,0],["ما أطيبَ الأوطانَ إلا أنها","للمرء أحلىَ أثرَ اغترابهِ",31,"ب",2,0],["ما أطيب الظل الظليل والهوى","فيه وما اهنا هما وامرا",32,"ر",2,0],["ما أُطيق السلوَّ عنك ولو جَر","رَعتني في هواك سمَّ مماض",33,"ض",1,0],["ما أَطيَبَ القَتلَ بِسَيفِ لَحظِهِ","رُزِقتُهُ وَلا رزقتُ ثارا",34,"ر",2,0],["ما أَطاعَت خاطِباً قَب","لَكَ في عَقدِ نِكاحِ",35,"ح",1,0],["ما أطربتنا جواري الماء إن رقصت","وغنّت الورق في روضٍ على عود",36,"د",1,0],["ما اطلع الأفق زهراً في مطالعه","وأرسل الشهب منه إثر كل رجى",37,"ج",2,0],["ما أطرَبَ الحرّ للصوتِ الرخيمِ وما","أقسى قلوبَ الأُلى عاشُوا بلا فطن",38,"ن",1,0],["ما أطيَبَ الخمرَ في بَردِ الكوانينِ","على المصابيحِ تُجلى والكوانينِ",39,"ن",1,1],["ما أَطْيَبَ الْعَيْشَ لَوْ أَنِّي وَفَدْتُ بِهِ","عَلَى شَبابٍ وَدَهْرٍ غَيْرِ غَدّارِ",40,"ر",1,0],["ما أَطنبت فكرتي في نعت شيمَتِهِ","إِلّا وكانَت عَلى الإِطناب مُختَصِرَه",41,"ر",2,0],["ما أطرقت لِمَخاضِها إلّا وَقَد","صُعِقَت بنفخةِ صوره الأحياءُ",42,"ا",2,0],["ما أَطلَق الدَمع الصَبيب غَرامه","إِلّا لِوَضع الصبّ تَحتَ قُيودهِ",43,"د",2,0],["ما اِطعت الوُشاة فيكَ وَلكِن","خاطَبوني جَهلا فَقُلتُ سَلاما",44,"م",2,0],["ما أطلَعاني على سِرارِهما","أما عجيبٌ أهوى ولا أدري",45,"ر",2,0],["ما أطعنا اللُّوَّامَ والحبُّ يأبى","أنْ يطيعَ المتيَّمُ الَّلائمينا",46,"ن",2,0],["ما أطولَ الليلَ على الساهرِ","لولا التفاتُ القمرِ الزاهرِ",47,"ر",1,1],["مَا أَطْبَقَ الهَمُّ إِلّا رَيثَما انْفَرَجَا","ولا دَجا الخطبُ إِلّا وَشْكَ مَا انْبَلَجا",48,"ج",2,1],["ما اطمأنَّ الوفرُ في بُحبُوحَةٍ","فرأيتَ المجدَ منها مطمئنّا",49,"ن",2,0],["ما أطرقت عيناي من ملل بلى","سجدت لما تتلوهُ من آياتها",50,"ت",3,0],["ما أَطْوَلَ اللَّيْلَ فيهِمْ والدُّجى قَلِقٌ","ما أَقرَبَ اليومَ إذْ فجُّوا بشَمْسِهِمِ",51,"م",1,0],["ما أطيب الريح تهديها وقد عبقت","منها بعرف يفوق العنبر العبقا",52,"ق",2,0],["ما أَطرَب السَّمعَ تَرجيع الحداة ضُحى","لَدى الرَّكائب نَحوَ البَيت وَالحَرَم",53,"م",1,0],["ما اطَّلعَت رأسها كيما تُهَدِّدُني","حصا تطرَّحُ مِن يعيى عَلى شَزَنِ",54,"ن",1,0],["ما أطيبَ العيشَ وإنْ","كان لنا مرنَّقا",55,"ق",2,0],["ما أطعمَ الحبَّ يأساً ثمّ مَطْمَعَةً","لَو كانَ لي بالّذي يجني عليَّ يَدُ",56,"د",1,0],["ما أَطولَ الليلَ على عاشِقٍ","مهجتهُ بالهجْر مرتاعه",57,"ع",2,0],["ما أَطرقَ الطرفُ منِّي يومَ رُؤيتها","كِبْراً ولكن لذاك الحُسْنِ قَد سَجَدَا",58,"د",2,0],["ما أطيبَ العَيشَ لولا عِلَّةٌ حَكَمت","فينا بِموتِ الصِّبا مِن ميتَةِ الشَّعر",59,"ر",1,0],["ما أطرق الطرف ما أطفى تلهبه","سبباً يعلله لديك تسبب",60,"ب",1,0],["ما أَطرَبَت أَمداحُهم مُدّاحَهُم","وَاِشتاقَ مَهجورٌ إِلى مَحبوبِ",61,"ب",1,0],["ما أطلقوا الأجمالَ تحت جمالهم","إلا وقد علِقَتْ بهنّ عُقولُ",62,"ل",1,0],["ما أطلقَ الألفاظَ إلا غادرتْ","سحبانَ وهو مُقيَّدُ الألفاظ",63,"ظ",1,0],["ما أطمخع الوفاد في أمواله","وعلومهِ إلا طلاقة بشرهِ",64,"ر",2,0],["مَا أُطيلُ الْمَقاَلَ خَوْفاً لإِضْجاً","رِ إمَامٍ مُؤَيَّدٍ مَحْرُوسِ",65,"س",1,0],["ما أطلع الشمسَ الضيا","ءَ اللَّهُ والقمرَ المنيرا",66,"ر",2,0],["ما أطيب العيشَ لكن","بالشيب أضحى مكدَّر",67,"ر",1,0],["ما أطيب إذ صاع نثر طيبك مسكا","ما أصوب إذ عاد غيث جودك هطال",68,"ل",1,0],["ما أَطمعته تذلّلاً بِوصالها","إلّا وأبدلت المطامعَ ياسا",69,"س",2,0],["ما أَطيب الكِفايه","ما أَنفع العِنايه",70,"ه",1,1],["ما أطيبَ النّاس من ثنائهم","على عليّ به فقد صدَقوا",71,"ق",3,0],["ما أطمع الناظر الوسنان بالرجلِ","وأفتك الصارم المسموم بالكحلِ",72,"ل",1,1],["ما أطلعت مثلها الجوزاء نيرةً","ولا حوى مثلها الإكليل من قمر",73,"ر",1,0],["ما أَطيبَ المَوْتَ في عِشْق المِلاحِ كذا","لاسِيَّما بِسيوفِ الأَعْيُنِ النُّجُلِ",74,"ل",1,0],["ما أطبقت عن آل جفنة جفنها","إلا وهم بصروفها قد هوّموا",75,"م",3,0],["ما أطرب الأفلاك في دورانها","لتزاحم الأملاك في أبوابه",76,"ب",2,0],["ما أطيب ليلة مضت بالسفح","والعيش بها يقصرُ عنه شرحي",77,"ي",1,1],["ما أطيب ما كانت وما أسعدني","لو فزت بمثلها ولو في الحلم",78,"م",1,0],["ما أطلع البدرَ من أزراره وجلا","إلا وغابت به شمس الضحى وجلا",79,"ل",2,1],["ما اطيب العيش والايام باسمة","والمرء يرتع بين السعد والظفر",80,"ر",1,0],["ما أطيب الوصل لولا ما يكدّره","من النوى ذكره للقلب قد جرحا",81,"ح",2,0],["ما أطلق الطير الشجيَّ غناؤه","مثل ابتسام الزهر والنوار",82,"ر",1,0],["ما أطعت الله إلا واثق","من جحيم ما لغاشيه براح",83,"ح",1,0],["ما أطيب العيش لاوقتٌ يحدده","فلا تقطّع أحلامٌ بأوهام",84,"م",1,0],["ما أطيب منك ساعة ما ألطف","يا من ثمر الوصال منه يعطف",85,"ف",1,0],["ما أطيب في الغرام موتي وجدا","ويلاه وإلى متى أذوق الفقدا",86,"د",2,0],["ما أطيب الحب لو لا كثرةُ 