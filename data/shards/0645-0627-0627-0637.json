{"poems":[[53,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[53,"نبهتهم مثل عوالي الرماح","https://www.aldiwan.net/poem30651.html","السريع"],[54,"ما أطيب العيش فأما","https://www.aldiwan.net/poem27504.html","السريع"],[54,"دليتني بغرور وعدك","https://www.aldiwan.net/poem27520.html","الكامل"],[88,"قامت تميس بأعطاف وأوراك","https://www.aldiwan.net/poem44402.html","البسيط"],[51,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[91,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[70,"يا من لعبت به شمول","https://www.aldiwan.net/poem42746.html","مجزوء الدوبيت"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[70,"سكنت قلبي وفيه منك أسرار","https://www.aldiwan.net/poem42904.html","البسيط"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[61,"أنكرته إذ رأيته وجنته","https://www.aldiwan.net/poem51378.html","المنسرح"],[66,"هويته تحت أطمار مشعثة","https://www.aldiwan.net/poem40107.html","البسيط"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[87,"ما أطيب العيش لولا أنه فاني","https://www.aldiwan.net/poem8209.html","البسيط"],[69,"إن الأرقاء غلاظ لؤما","https://www.aldiwan.net/poem28712.html","الرجز"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[40,"تحمل اليوم أم لم تبرح الأنس","https://www.aldiwan.net/poem42284.html","البسيط"],[52,"إني غريب بدار لا كرام بها","https://www.aldiwan.net/poem26874.html","البسيط"],[46,"تقواك زاد فاعتقد أنه","https://www.aldiwan.net/poem22036.html","السريع"],[46,"ما أطيب العيش عند قوم","https://www.aldiwan.net/poem23138.html","مجزوء البسيط"],[68,"ما أطيب ما بتنا معا في برد","https://www.aldiwan.net/poem1494.html",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30452","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30438","الكامل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39408","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42629","السريع"],[84,"قل لمن زاد إذ تباعد بعدا","https://www.poetsgate.com/ViewPoem.aspx?id=26318",""],[31,"يا صاحبيّ، قفا نستخبرِ الطللا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19020&r=&rc=283",""],[117,"العطرُ أنت (1)","https://www.aldiwan.net/poem24028.html","البسيط"],[142,"قد رجع الحق إلى نصابه","https://www.aldiwan.net/poem58439.html","الرجز"],[160,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[204,"شف قلبي مضاضة الإعراض","https://www.aldiwan.net/poem53106.html","الخفيف"],[232,"ردوا لقلبي القلق الفرارا","https://www.aldiwan.net/poem14807.html","الرجز"],[235,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[259,"خلت ربوعك من غوث المناجيد","https://www.aldiwan.net/poem35744.html","البسيط"],[261,"عقبى مدى الهم أولي غاية الفرج","https://www.aldiwan.net/poem38354.html","البسيط"],[270,"قصرت ما طال من هم ومن حزن","https://www.aldiwan.net/poem35262.html","البسيط"],[270,"ما أطيب الخمر في برد الكوانين","https://www.aldiwan.net/poem35282.html","البسيط"],[280,"هي الديار فعج في رسمها العاري","https://www.aldiwan.net/poem60723.html","البسيط"],[297,"ألية بانعطاف القامة النضرة","https://www.aldiwan.net/poem33265.html","البسيط"],[305,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[353,"لو كان يوفي في الهوى بوعوده","https://www.aldiwan.net/poem40393.html","الكامل"],[361,"لا وخال كأنه نقطة الناسخ","https://www.aldiwan.net/poem68057.html","الخفيف"],[371,"وذي جنون أظنها عرفت","https://www.aldiwan.net/poem57432.html","المنسرح"],[416,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[432,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[439,"ما أطبق الهم إلا ريثما انفرجا","https://www.aldiwan.net/poem34794.html","البسيط"],[458,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[464,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[500,"غنى الهزار على روض العرار بكم","https://www.aldiwan.net/poem37798.html","البسيط"],[515,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[524,"صلوا على من عليه الله خالقه","https://www.aldiwan.net/poem13292.html","البسيط"],[540,"إني امرؤ من رعى عيني رعيت له","https://www.aldiwan.net/poem56645.html","الوافر"],[551,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[551,"هل شافع لي إلى نعم وسيلتها","https://www.aldiwan.net/poem47879.html","البسيط"],[575,"يا ملكاً لا يلتقي أمره","https://www.aldiwan.net/poem2717.html","السريع"],[575,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"]],"verses":[["ما أَطاعوا النَبيَّ فيكَ وَقَد ما","لَت بِأَرماحِهِم إِلَيكَ الذُحولُ",0,"ل",1,0],["ما أَطيَبَ الأَمرَ وَلَو أَنَّهُ","عَلى رَزايا نَعَمٍ في مَراح",1,"ح",1,0],["ما أَطيَبَ العَيشَ فَأَمّا عَلى","أَلّا أَرى وَجهَكِ يَوماً فَلا",2,"ل",2,1],["ما أَطوَلَ الدُنيا وَأَعرَضَها","وَأَدَلَّني بِمَسالِكِ الطُرُقِ",3,"ق",1,0],["ما أطيب العيش في الدنيا لو أتَصلت","أسباب دنياي مع أسباب دنياك",4,"ك",1,0],["ما أُطلقتْ في ذاك إل","لا حين آن لها تُغَلُّ",5,"ل",1,0],["ما أَطاعوا فيكِ أَحكامَ النُهى","لا وَلا قَولَ الكتابِ المُنزَلِ",6,"ل",1,0],["ما أَطيَبَ وَقتَنا وَأَهنى","وَالعاذِلُ غائِبٌ وَغافِل",7,"ل",1,0],["ما أَطمَعَ العُذّالَ إِلّا أَنَّني","خَوفاً عَلَيكَ إِلَيهِمُ أَتَمَلَّقُ",8,"ق",1,0],["ما أَطيَبَ اللَيلَ فيهِ حينَ أَسهَرُهُ","كَأَنَّما زَفَراتي فيهِ أَسمارُ",9,"ر",1,0],["ما أَطاقوا دَفنَ الَّذي أَظهَروهُ","كَبُرَ الحِقدُ أَن يَكونَ دَفينا",10,"ن",2,0],["ما اطرد الشعر للجمال وما","أقبح ملكا تزول نعمته",11,"ت",2,0],["ما أَطيَبَ العَيشَ لَولا أَنَّ سالِكَهُ","يُمسي لِأَسهُمِ كَيدِ الناسِ كَالهَدَفِ",12,"ف",1,0],["ما أَطاقَ الدَّهرُ أَنْ يَسلِبَها","أرَجَ المِسكِ ولَونَ العَسجَدِ",13,"د",1,0],["مَا أَطْيَبَ الْعَيْشَ لَوْلا أَنَّهُ فَانِي","تَبْلَى النُّفُوسُ وَلا يَبْلَى الْجَدِيدَانِ",14,"ن",1,1],["ما أطيبَ المالَ وأحلى النِّعَما","لولا مقاساةُ العبيدِ والإما",15,"م",2,0],["ما أَطلَقَ الحَتفَ إِلّا اِنسابَ في أَجَلٍ","مُصَفَّدٍ في يَدِ الأَقدارِ مَغلولِ",16,"ل",1,0],["ما أَطعَمُ النَومَ حَتّى الصُبحِ أَكلَؤُهُ","كَما تَكالا حِذارَ العَورَةِ الحَرَسُ",17,"س",1,0],["ما أُطلِقُ العَينَ في شَيءٍ أُسَرُّ بِهِ","وَلَستُ أُبدي الرِضا إِلّا عَلى السَخطِ",18,"ط",1,0],["ما أَطيَبَ المَوتَ لِشُرّابِهِ","إِن صَحَّ لِلأَمواتِ وَشكُ اِلتِقاء",19,"ق",3,0],["ما أَطيَبَ العَيشَ عِندَ قَومٍ","لَو أَنَّهُ كانَ لا يَزولُ",20,"ل",1,1],["ما أَطْيَبَ ما بِتْنَا معاً في بُرْدٍ","إذْ لاصَقَ خَدَّهُ اعْتِنَاقاً خَدِّي",21,"ي",1,1],["ما أُطِيقُ الَّذِي ادَّعيْت ولَوْ مُلْ","لِكْتُهُ لم أَكُنْ لغَيْركَ عبْدا",22,"د",2,0],["ما أَطْرَبَتْ فَوْقَ الغُصُونِ حَمامةٌ","إِلا رَأَيْتَ دُمُوعَ عَيْني تُسْكَبُ",23,"ب",1,1],["ما أطيَبَ العيشَ إلّا أَنَّهُ","عن عاجِلٍ كُلُّه متروكُ",24,"ك",1,0],["مَا أَطْوَلَ اللَّيْلَ عَلَى السَّاهِرِ","أَمَا لِهَذَا اللَّيْلِ مِنْ آخِرِ",25,"ر",1,1],["ما أطيق الذي ادعيت ولو","ملكته لم أكن لغيرك عبدا",26,"د",2,0],["مَا أَطَعْتُ بِهَا بِالْغَيْبِ، قَدْ عَلِمَتْ","مَقَالَة َ الكَاشِحِ الواشي إذا مَحَلا",27,"ل",2,0],["ما أطوعَ الشِّعْرَ في مَدْحِ الحَبيبِ، متى","طَلَبْتُهُ جاءَ مُنْقادًا فأَرْتَجِلُ",28,"ل",1,0],["ما أطيبَ الأوطانَ إلا أنها","للمرء أحلىَ أثرَ اغترابهِ",29,"ب",2,0],["ما أطيب الظل الظليل والهوى","فيه وما اهنا هما وامرا",30,"ر",2,0],["ما أُطيق السلوَّ عنك ولو جَر","رَعتني في هواك سمَّ مماض",31,"ض",1,0],["ما أَطيَبَ القَتلَ بِسَيفِ لَحظِهِ","رُزِقتُهُ وَلا رزقتُ ثارا",32,"ر",2,0],["ما أَطاعَت خاطِباً قَب","لَكَ في عَقدِ نِكاحِ",33,"ح",1,0],["ما أطربتنا جواري الماء إن رقصت","وغنّت الورق في روضٍ على عود",34,"د",1,0],["ما اطلع الأفق زهراً في مطالعه","وأرسل الشهب منه إثر كل رجى",35,"ج",2,0],["ما أطرَبَ الحرّ للصوتِ الرخيمِ وما","أقسى قلوبَ الأُلى عاشُوا بلا فطن",36,"ن",1,0],["ما أطيَبَ الخمرَ في بَردِ الكوانينِ","على المصابيحِ تُجلى والكوانينِ",37,"ن",1,1],["ما أَطْيَبَ الْعَيْشَ لَوْ أَنِّي وَفَدْتُ بِهِ","عَلَى شَبابٍ وَدَهْرٍ غَيْرِ غَدّارِ",38,"ر",1,0],["ما أَطنبت فكرتي في نعت شيمَتِهِ","إِلّا وكانَت عَلى الإِطناب مُختَصِرَه",39,"ر",2,0],["ما أطرقت لِمَخاضِها إلّا وَقَد","صُعِقَت بنفخةِ صوره الأحياءُ",40,"ا",2,0],["ما أَطلَق الدَمع الصَبيب غَرامه","إِلّا لِوَضع الصبّ تَحتَ قُيودهِ",41,"د",2,0],["ما اِطعت الوُشاة فيكَ وَلكِن","خاطَبوني جَهلا فَقُلتُ سَلاما",42,"م",2,0],["ما أطلَعاني على سِرارِهما","أما عجيبٌ أهوى ولا أدري",43,"ي",1,0],["ما أطعنا اللُّوَّامَ والحبُّ يأبى","أنْ يطيعَ المتيَّمُ الَّلائمينا",44,"ن",2,0],["ما أطولَ الليلَ على الساهرِ","لولا التفاتُ القمرِ الزاهرِ",45,"ر",1,1],["مَا أَطْبَقَ الهَمُّ إِلّا رَيثَما انْفَرَجَا","ولا دَجا الخطبُ إِلّا وَشْكَ مَا انْبَلَجا",46,"ج",2,1],["ما اطمأنَّ الوفرُ في بُحبُوحَةٍ","فرأيتَ المجدَ منها مطمئنّا",47,"ن",2,0],["ما أطرقت عيناي من ملل بلى","سجدت لما تتلوهُ من آياتها",48,"ت",3,0],["ما أَطْوَلَ اللَّيْلَ فيهِمْ والدُّجى قَلِقٌ","ما أَقرَبَ اليومَ إذْ فجُّوا بشَمْسِهِمِ",49,"م",1,0],["ما أطيب الريح تهديها وقد عبقت","منها بعرف يفوق العنبر العبقا",50,"ق",2,0],["ما أَطرَب السَّمعَ تَرجيع الحداة ضُحى","لَدى الرَّكائب نَحوَ البَيت وَالحَرَم",51,"م",1,0],["ما اطَّلعَت رأسها كيما تُهَدِّدُني","حصا تطرَّحُ مِن يعيى عَلى شَزَنِ",52,"ن",1,0],["ما أطيبَ العيشَ وإنْ","كان لنا مرنَّقا",53,"ق",2,0],["ما أطعمَ الحبَّ يأساً ثمّ مَطْمَعَةً","لَو كانَ لي بالّذي يجني عليَّ يَدُ",54,"د",1,0],["ما أَطولَ الليلَ على عاشِقٍ","مهجتهُ بالهجْر مرتاعه",55,"ع",2,0],["ما أَطرقَ الطرفُ منِّي يومَ رُؤيتها","كِبْراً ولكن لذاك الحُسْنِ قَد سَجَدَا",56,"د",2,0]]}