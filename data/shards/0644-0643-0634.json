{"poems":[[72,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[51,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54784","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54810","الخفيف"],[365,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[365,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لك شعرٌ وقامةٌ إن يكونا","رايةً فهيَ راية الأفراح",0,"ح",1,0],["لك شطر كسبي كلما","حبَّرتُ في الخرطوم شِعرا",1,"ر",2,0],["لَكَ شُكْرٌ عَلَى مُروءَتِكَ الحُسْنَى","وَذِكْرٌ يَطِيبُ بِالتَّردِيْدْ",2,"د",1,0],["لَكَ شُكْرٌ حُقُوقُهُ لاَ تُوَّفَى","وَفَخَارٌ يَبْقَى عَلَى الابَادِ",3,"د",1,0],["لك شُكْري وليس كلُّ لِسانٍ","ناشرٍ شُكْرَ مثْلِه مَحْمود",4,"د",1,0],["لكشْفِ نقابِ الغيبِ عن وجه ما انطوَى","عنِ الخَلْقِِ يغْدو الدهرُ وهْو نِقاب",5,"ب",1,0],["لكشف حرمة النبي المصطفى","وهتكم من ستره ما انكشفا",6,"ف",2,0]]}