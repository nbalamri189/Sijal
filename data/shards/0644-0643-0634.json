{"poems":[[74,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[53,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54784","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54810","الخفيف"],[369,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[369,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53745","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126808","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48868","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119920","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56613","الخفيف"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124296","الطويل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114037","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71045","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102136","المنسرح"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137097",""],[2751,"","https://poetry.dctabudhabi.ae/diwan/poem/138894",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205074","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204665","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65267","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205751","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206152","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125899","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72733","الطويل"],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""],[5302,"يا خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=200944",""],[5302,"خير الأحبة نجود","https://www.poetsgate.com/ViewPoem.aspx?id=201738",""],[592,"ألا يا أيها الإنسان سمعا","https://www.poetsgate.com/ViewPoem.aspx?id=128822",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5952,"لك يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=207803",""],[6160,"مَرايا لِعُروَة ابنِ الوَرد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87098&r=&rc=15",""],[6249,"أفّ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85663&r=&rc=6",""]],"verses":[["لك شعرٌ وقامةٌ إن يكونا","رايةً فهيَ راية الأفراح",0,"ح",1,0],["لك شطر كسبي كلما","حبَّرتُ في الخرطوم شِعرا",1,"ر",2,0],["لَكَ شُكْرٌ عَلَى مُروءَتِكَ الحُسْنَى","وَذِكْرٌ يَطِيبُ بِالتَّردِيْدْ",2,"د",1,0],["لَكَ شُكْرٌ حُقُوقُهُ لاَ تُوَّفَى","وَفَخَارٌ يَبْقَى عَلَى الابَادِ",3,"د",1,0],["لك شُكْري وليس كلُّ لِسانٍ","ناشرٍ شُكْرَ مثْلِه مَحْمود",4,"د",1,0],["لكشْفِ نقابِ الغيبِ عن وجه ما انطوَى","عنِ الخَلْقِِ يغْدو الدهرُ وهْو نِقاب",5,"ب",1,0],["لكشف حرمة النبي المصطفى","وهتكم من ستره ما انكشفا",6,"ف",2,0],["لك شافع مني إلي فما","يقضي عليك بهفوة فكري",7,"ر",2,0],["لكَ شقّ ربُّ العرشِ مِن أسمائهِ","اِسماً لذاك محمّد سمّاكا",8,"ك",2,0],["لك شرقية وغريبة لي","وكلانا في كل قلب مقيم",9,"م",1,0],["لكشفت سر الوجد مذ سترت","عني خمور شفاهها الخمرُ",10,"ر",1,0],["لك شكور في القلوب عهود","لست أخشى يوماً عليها انصراما",11,"م",2,0],["لكشف حجاب النفس عني فانني","بفضلك لا أرضي بعيش البهائم",12,"م",1,0],["لك شرح لو لم يكن ملك الشّ","راح ما سلّمت له أحكامه",13,"م",2,0],["لَكَشَفْتُ باطِنَ صورتي في دَعْوَتي","إِيّاك قول مُحَقِّقٍ في قصْدِهِ",14,"د",2,0],["لكشفِ كل هول","ورفعهِ بصَولِ",15,"ل",1,0],["لك شيمة كلطيمة العطار يسطع","نشرها في السهل والاوعار",16,"ر",1,0],["لكشفت سراً كنت أنت ضميره","حاشاك من كذبٍ به حاشاكا",17,"ك",2,0],["لك شعر كأنه الروح يحيى","كل مصغ له ولو كان رمّه",18,"م",2,0],["لك شعر سيغتدي خير ذخر","فيه يوصي الأجداد للأحفاد",19,"د",1,0],["لك شافعٌ في الوجه ظلّ مُعاقبي","اللهُ أكبرُ من عقاب الشّافع",20,"ع",1,0],["لك شعر يحكي سريرة نفس","رُكِّبت من صراحة ونقاء",21,"ا",2,1],["لكشفتَ باطنها فقد أنكرتُها","لما بدا منها القرار الغائر",22,"ر",1,0],["لكِ شعري لكِ حبي والهوى","وأَنا باسمك ليلى أَوقد",23,"د",1,0],["لكشح العلايا أهل بغداد أرخوا","بدا كنطاق طاق عثمان نورس",24,"س",1,0],["لك شدو الصداح، ما بنت عني،","وبقربي، فلسعة الذراح",25,"ح",1,0],["لك شاهد بالخير لا يحضى به","أحد سواك بطارف وتليد",26,"د",1,0],["لك شعبة ليست لمخلوق سوا","ك ومنزل في أضلعي مرموق",27,"ق",1,0],["لكشف ملمة وزوال هم","وغم قد أمض السائلينا",28,"ن",2,0],["لك شاد ربك من حظيرة قدسه","عرشاً وخلد تاجك المعقودا",29,"د",2,0],["لك شعبك المنثور قمحاً في رحىً","صُنعَت على عينٍ لهم لتصنِّفهْ",30,"ف",2,0],["لَكَ شأنُكَ المَنْسي فاتْرُكني","فَلي أَيضًا شُؤوني ...",31,"ن",2,0],["لكِ شُكرًا .. نبَّهتِنِي مِن سُباتِي","بعد ما عِشتُ في رُؤَى الغافِلينا",32,"ن",2,0]]}