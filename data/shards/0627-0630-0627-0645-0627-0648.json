{"poems":[[88,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[37,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[32,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[23,"نشدت بني النجار أفعال والدي","https://www.aldiwan.net/poem21244.html","الطويل"],[53,"إذا ما وصفت امرءا لامرىء","https://www.aldiwan.net/poem61835.html","المتقارب"],[53,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[53,"علاك قناع المشيب اليقق","https://www.aldiwan.net/poem65702.html","المتقارب"],[30,"ستبلغ عني غدوة الريح أنها","https://www.aldiwan.net/poem5558.html","الطويل"],[30,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[30,"لحا الله ماء حنبل قيم له","https://www.aldiwan.net/poem5644.html","الطويل"],[68,"عيون لها مرأى الأحبة إثمد","https://www.aldiwan.net/poem40291.html","الطويل"],[41,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[50,"إذا ما وطئ الأمر","https://www.aldiwan.net/poem62575.html","الوافر"],[50,"إذا ما وطىء الأمرد خمسا","https://www.aldiwan.net/poem66567.html","الهزج"],[52,"نهاني أمير المؤمنين عن الصبا","https://www.aldiwan.net/poem62227.html","الكامل"],[48,"متى أنا في هذا التراب مغيب","https://www.aldiwan.net/poem23495.html","الطويل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6818","الطويل"],[52,"نهاني أميرُ المؤمنين عن الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=31090",""],[92,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[30,"ستبلغ عني غدوة الريح أنها","https://www.poetsgate.com/ViewPoem.aspx?id=20997",""],[188,"إذا ما وردنا ماء مدين أشرقت","https://www.aldiwan.net/poem23816.html","عموديه"],[190,"رويدا أيا إسحاق واسمع فإنني","https://www.aldiwan.net/poem44118.html","الطويل"],[236,"نعم إن للبرق اليماني لوعة","https://www.aldiwan.net/poem44585.html","الطويل"],[240,"وأغيد ما عنه للصب صبر","https://www.aldiwan.net/poem32000.html","المتقارب"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[285,"خذا من صبا نجد أمانا لقلبه","https://www.aldiwan.net/poem60719.html","الطويل"],[382,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[406,"أغصان الحروف","https://www.aldiwan.net/poem6789.html","عموديه"],[422,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[473,"اخ لي بعيد مرامي الهمم","https://www.aldiwan.net/poem59685.html","المتقارب"],[473,"عقيق الشقيق ومينا الخضر","https://www.aldiwan.net/poem60059.html","المتقارب"],[505,"أحيباب قلبي والمحبة دينها","https://www.aldiwan.net/poem37631.html","الطويل"],[556,"ولي صاحب لا يصحب الضيم ربه","https://www.aldiwan.net/poem48089.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66851","المتقارب"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206098","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137590",""],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119957","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144082","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46640",""],[1497,"","https://poetry.dctabudhabi.ae/diwan/poem/202315","المتقارب"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124733","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89532","الطويل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18007","الوافر"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18080","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118821","المتقارب"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28828","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89433","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74028","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62838","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103867","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205551","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131199",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131091",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114364","المتقارب"],[5093,"حكاية حب","https://www.poetsgate.com/ViewPoem.aspx?id=144989",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5582,"لِمَنْ مَرْبَعٌ للبُقْعِ فِيهِ نَعِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186672",""],[5790,"أسرب المها لا حبذا أنت من سرب","https://www.poetsgate.com/ViewPoem.aspx?id=111944",""],[6031,"وراءَ كُما إنَّ المُصَابَ جَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46289",""]],"verses":[["إِذا ما وَرَدتَ لَها مَنهَلاً","وَرَدتَ نَميراً لَذيذَ الخَصَر",0,"ر",1,0],["إِذا ما وَرَدنا مَنهَلاً صَاح أَهلُهُ","عَلينا فما نَنفَكُّ نُرمَى وَنُضرَبُ",1,"ب",1,0],["إِذا ما وَرَدنا لَم نُصادِف بِجَوفِهِ","سِوى وارِداتٍ مِن قَطاً وَحَمامِ",2,"م",1,0],["إِذا ما وَطِئنا وَطأَةٍ في غروزِها","تَجافَينَ حَتّى تَستَقِلَّ الكَراكِرُ",3,"ر",1,0],["إِذا ما وَليدُ الحَيِّ لَم يُسقَ شَربَةً","وَقَد ضَنَّ عَنهُ بِالصَبوحِ مَراضِعُه",4,"ع",2,0],["إذا ما وصفتَ امرءاً لامرىء","فلا تَغْلُ في وصفه واقصدِ",5,"د",1,1],["إذا ما ونى عنها الزناة دعتهُمُ","شقاشق من ارحامها الخضر تَهدِر",6,"ر",1,0],["إذا ما وعى مدحَه المادحو","ن طاب نسيمُهم والعرق",7,"ق",1,0],["إِذا ما وُجوهُ القَومِ سالَت جِباهُها","مِنَ العَرَقِ المَغنوطِ تَحتَ الحَلاقِمِ",8,"م",1,0],["إِذا ما وُجوهُ الناسِ سالَت جِباهُها","مِنَ العَرَقِ المَعبوطِ تَحتَ العَمائِمِ",9,"م",1,0],["إِذا ما وُزِنّا بِالجِبالِ رَأَيتَنا","نَميلُ بِأَنضادِ الجِبالِ الأَضاخِمِ",9,"م",1,0],["إِذا ما وَرَدتَ الماءَ فَاِدلِف لِحَنبَلٍ","بِقَعبِ سَويقٍ أَو بِقَعبِ طَحينِ",10,"ن",1,0],["إِذا ما وَنى مَسراهُ ثِقلاً يَحُثُّهُ","جَوادٌ وَعَضبٌ أَجرَدٌ وَمُجَرَّدُ",11,"د",1,0],["إِذا ما وَنَت أَو وَنى الحادِيان","تَعَلَّلنَ بِالدُبُلِ السائِحَه",12,"ح",2,0],["إِذا ما وَطِئَ الأَمرَ","دُ لِلعِلمِ حَصى المَسجِد",13,"د",1,1],["إذا ما وطىءَ الأمردُ خم","ساً من حصى المسجد",14,"د",1,1],["إِذا ما وَلِيُّ العَهدِ قَضّى لُبانَتي","وَقَفتُ بِأُخرى عِندَهُ أَستَديمُها",15,"م",3,0],["إِذا ما وَرَدنا لِلمَنايا شَريعَةً","فَهانَ عَلَينا ما شَرِبنا مِنَ الأَجنِ",16,"ن",1,0],["إِذا ما وَهى غَيثٌ وَأَمرَعَ جانِبٌ","صَبَبتُ عَلَيهِ جَحفَلاً غانِظاً لَهُم",17,"م",1,0],["إذا ما وَلِيّ العَهد قَضَّى لُبانتي","وقفُ بأخرى عنده أستديمها",18,"م",3,0],["إذا ما وردتمْ نميرَ الحياة","وراقَ لكمْ وِرْدُه فاذكرونا",19,"ن",2,0],["إذا مَا وَجُوهُ القَوْمِ سالَتْ جِباهُها","مِنَ العَرَقِ المَغنوظِ تحتَ الحَلاقِمِ",20,"م",1,0],["إذا ما وردنا ماء مدين أشرقت","موارد وردي في انتهازي فرصتي",21,"ت",2,1],["إذا ما وشى واش إليك فمثله","مبلغ واش عنك واتسع الخطب",22,"ب",1,0],["إذا ما وردت الماء ماء مجنة","وطلت عليه المطى تخوض",23,"ض",1,0],["إِذا ما وَقَفتَ بِبابِ الأَميرِ","وَلاحَ لَكَ القَمَرُ المُستَسِرُّ",24,"ر",1,0],["إِذا ما وَفى قَدُّها بِالسُّمُوِّ","أَخْلَفَها عُنُقٌ يَوْقَصُ",25,"ص",1,0],["إِذا ما وَرَدْتَ اْعِزَّ يَوْماً بِنَصْرِهِمْ","أَمَلَّكَ مِنْ رَشْفِ النَّمِيرِ وَعَبِّهِ",26,"ب",2,0],["إذا ما وردناهُ صدرنا إلى الردى","ومصدره يبدي لنا موردَ الحتف",27,"ف",1,0],["إذا ما ولدت انتظرت الممات","ولما يمر علي الشهر",28,"ر",1,0],["إذا ما وُزِنَ القومُ","ففي وزنك رجحان",29,"ن",1,0],["إِذا ما وُجوهُهُمُ أَسفَرَت","عَرَفتَ عَرانينَهُمُ بِالشَمَم",30,"م",1,0],["إِذا ما وَرَدتَ إِلى مَورِدٍ","فَبادِر بِرَبِّكَ قَبلَ الصَدَر",31,"ر",1,0],["إذا ما وصلت الحيُّ فاهدأ وخذ بها","نقيلاً وخلِّ الخفَّ وانتعل الدربا",32,"ب",2,0],["إِذا ما وَجا أو داجَ قَرْن مُصمّمٍ","أعاد مشيبَ الوجهِ وهو شبابُ",33,"ب",1,0],["إذا ما وَردنا غداً حوضَه","فأدنى السعيدَ وذادَ الشقيّا",34,"ي",2,0],["إذا ما وردن الماء في غلس الضحى","بللن أوادي لبس خزر يشينها",35,"ن",3,0],["إذا ما وقفت لديه ظلاما","بفصل به فاح عرف الخزامى",36,"م",2,1],["إذا ما ورت نار الوغى وتسعرت","دلفت إليها والرماح شوارعُ",37,"ع",1,0],["إذا ما ونتْ خوصُ النجائبِ تحتَهمْ","حدَوْها بأوصافِ الرّضيّ فتُسرِعُ",38,"ع",1,0],["إذا ما ونَت خُوضُ النجائبِ تحتَهُم","حَدوَها بأوصافِ الرَّضيِّ فتُسرعُ",39,"ع",1,0],["إذاما .... وا في الوغى","حسبتهم الجن من عبقر",40,"ر",1,0],["إذا ما وقت عدتها تولى","وكان الزوج في بلدٍ سحاقِ",41,"ق",1,0],["إِذا ما وَنَت غَنّى الرَديفُ بِذِكرهِ","فَزَفَّت زَفيفَ الرَألِ فَاجاهُ خاتِلُه",42,"ل",2,0],["إِذا ما واجِبُ الأَضيافِ أَمسى","وَكانَ قِراهُمُ غَثّاً فَصيدا",43,"د",2,0],["إِذا ما وَرَدنا الماءَ كانَت حُماتُهُ","بَنو أَسَدٍ يَوماً عَلى رَغمِ مَن رَغَم",44,"م",1,0],["إذا ما وقفنا بأبوابكم","فذاك لدينا أجلٌّ القرب",45,"ب",1,0],["إِذا ما وَنَتْ حَثَّها بِالنَّهيمِ","وَطَوراً يُعَلِّلُها بِالحُداءِ",46,"ا",2,0],["إذا ما وجهك الممسوخ يبدو","فوجه القرد ذو حسن وجيه",47,"ي",2,0],["إِذا ما وشوا أَو عرّضوا بي عنده","ثَنى جيده نَحوي وَثنّى بِعارِضِ",48,"ض",1,0],["إذا ما واصلتْ غَدَرَتْ وخانتْ","وأعوزَ في خلائِقِها الوَفاءُ",49,"ا",2,0],["إذا ما وجدنا الشيء علة نفسه","فذاك وجود ليس يفنى على الأبد",50,"د",1,0],["إذا ما وعدت اليوم أخلفت في غدٍ","وهيهات لا تبقين يومًا على حالِ",51,"ل",1,0],["إذا ما وردن النيل ينقعن غلة","تذكرن شوقيا فعدن صواديا",52,"ي",2,0],["إذا ما وزعنا باسمك الدهر أقبلت","ميامنه تترى وولت نوائبه",53,"ب",2,0],["إذا ما وجدتكَ كنتَ المنى","ومالي على فقدِ غيرٍ ندم",54,"م",1,0],["إذا ما وقفتُ على بابكم","خفضتُ جبيني وأشعلتُ عشرا",55,"ر",2,0],["إذا ما وصفنا بعض عمران دورها","عيينا بعمران العقول الذي جدا",56,"د",2,0],["إِذا ما وَنَتْ فِي السَّيْرِ لاحَتْ لِعَيْنِها","بُرُوقُ رَجاءٍ وَدْقُهُنَّ سَكُوبُ",57,"ب",1,0],["إذا ما وجدت البحر سهلا وروده","فما لك وجه في التيمم بالترب",58,"ب",1,0],["إذا ماوَضَعتُمْ نَعْشَ مَيْتٍ رَفَعْتُمُ","جَنَازَةَ ثَانٍ إِنَّ ذَا لَيَطُولُ",59,"ل",1,0]]}