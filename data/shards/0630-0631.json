16992","البسيط"],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[90,"أحيِّيك طه","https://www.poetsgate.com/ViewPoem.aspx?id=179200",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"ذكرى دمشق الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179048",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[91,"فنون الوصف","https://www.poetsgate.com/ViewPoem.aspx?id=53081",""],[28,"إذا باهلي تحته حنظلية","https://www.poetsgate.com/ViewPoem.aspx?id=2506",""],[14,"أقِلِّي عَلَيَّ اللِّوْمَ يا ابْنَة َ مُنْذِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17403&r=&rc=14",""]],"verses":[["ذَرَّت إِلَيَّ ذُرورَ الشَمسِ طالِعَةً","شُروقُها أَبَداً باقٍ بِلا أُصُلِ",0,"ل",1,0],["ذَرَعَ الدُجى وَطَوى خَميصَتَهُ","وَلَها عَلى قِمَمِ الرُبى كُفَفُ",1,"ف",1,0],["ذَرا اللَومَ يا بني سالِمٍ إِنَّ صَبوَتي","رَمَتْ كُلَّ لاحٍ مِن إِبائي بِمُسكِتِ",2,"ت",1,1],["ذَرِ اللَّومَ يا بْنَ الهاشِميَّة إِنَّني","بِغَيضٌ إِليَّ العاذِلُ المُتَخَرِّصُ",3,"ص",1,1],["ذَرِيني أُراعِ النَّجْمَ في مُدْلَهِمَّةٍ","تَخوضُ دَياجيها المَطِيُّ الأَوارِكُ",4,"ك",1,0],["ذَريني وَالحُسامَ أُفِدْكِ مَالاً","فَراحَةُ مَنْ يَعولُكِ في التَّعَنِّي",5,"ي",1,0],["ذَرِ اللّوْمَ إني لَسْتُ أُرْعيكَ مَسمَعي","فتلكَ هَوى نَفسي وأنتَ خَليلُها",6,"ل",3,0],["ذَرَفَتْ عُيونُ المَكْرُماتِ وأعْصَمَتْ","أسَفاً بأكْبادٍ علَيْهِ حِرارِ",7,"ر",1,0],["ذَريني أَنَم لَم أَنَل مِنكِ زَورَةً","لَعَلَّ خَيالاً في المَنامِ يَزورُ",8,"ر",1,0],["ذَري عَنكِ يا ذَلفاءُ طولَ عِتابي","وَلا تَترُكي داعيكِ غَيرَ مُجابِ",9,"ب",1,1],["ذَروها وأرْضَ اللهِ لا تَعْرِضوا لَها","بمَعْرِضِ سُوءٍ فهْيَ ناقَةُ صالِحِ",10,"ح",1,0],["ذَروا آلَ سلمى ظِنَّتي وَتَعَنُّتي","وَما زَلَّ مِنّي إِنَّ مافاتَ فائِتُ",11,"ت",1,1],["ذَريني لَكِ الوَيلاتُ آتي الغَوانِيا","مَتى كُنتُ ذَرّاعاً أَسوقُ السَوانِيا",12,"ي",2,1],["ذَرَّ الكَتاتيبَ مُنشيها بِلا عَدَدٍ","ذَرَّ الرَمادِ بِعَينِ الحاذِقِ الأَرِبِ",13,"ب",1,0],["ذَراها إِذا رامَت مَعاجاً إِلى الحِمى","فَقَد هاجَ مِنها البَرقُ داءً مُكَتَّما",14,"م",2,1],["ذِراعٌ لِما يَأتي بِهِ الدَهرُ واسِعٌ","وَباعٌ إِلى مايُحرِزُ الفَخرَ مُمتَدُّ",15,"د",1,0],["ذِراعَي عَيطَلٍ أَدماءَ بِكرٍ","هِجانِ اللَونِ لَم تَقرَأ جَنينا",16,"ن",2,0],["ذَري عَنكِ أَقوالَ الضَلالِ كَفى بِنا","لِكَبشِ الوَغى في اليَومِ وَالأَمسِ ناطِحا",17,"ح",2,1],["ذَرُوا كُلَّ قَوْلٍ فَاقِدِ النَّفْعِ جَانِباً","وَمُدُّوا مَجَالَ الْفِعْلِ ذَلِكَ أحْزَمُ",18,"م",1,0],["ذَرَفَت دُموعي ثمَّ قُل","تُ بِمَن يُبَادِلُني بِمَن",19,"ن",1,0],["ذُرى أُقحُوانِ الرَملِ هَزّت فُروعَهُ","صَبا طَلَّةٌ بَينَ الحُقوفِ اليَتائِمِ",20,"م",1,0],["ذَرَعَن بِنا أَجوازَ كُلِّ تَنوفَةٍ","مُلَمِّعَةٍ وَالأَرضُ يُطوى عَريضُها",21,"ض",3,0],["ذُرى أُقحُوانٍ واجَهَ اللَيلُ وَاِرتَقى","إِلَيهِ النَدى مِن رامَةَ المُتَرَوَّحُ",22,"ح",1,0],["ذروني فإني بالعلاء خبيرُ","أَسيرُ فإِنّ النَّيِّراتِ تسيرُ",23,"ر",1,1],["ذريني فلو أَنّي أُخَلّد بالغنى","لكنتُ ضنيناً بالذي ملكت يدي",24,"ي",1,0],["ذريني أزُرْ في هَضْب لُبنان أربعاً","تعالت بحيث العزّ مُرخَى الضفائر",25,"ر",1,0],["ذَرَنَّ الفَخرَ يا اِبنَ أَبي خُلَيدٍ","وَأَدِّ خَراجَ رَأسِكَ كُلَّ عامِ",26,"م",1,0],["ذَرني وَما مَلَكَت يَمي","ني إِن رَفَعتُ بِهِ شُؤونا",27,"ن",2,0],["ذَريني وَحالي إِنَّ مالَكِ وافِرٌ","وَكُلُّ اِمرِئٍ جارٍ عَلى ما تَعَوَّدا",28,"د",2,0],["ذَريني يَكُن مالي لِعِرضِيَ جُنَّةً","يَقي المالُ عِرضي قَبلَ أَن يَتَبَدَّدا",28,"د",2,0],["ذَريني وَعِلمي بِالأُمورِ وَشيمَتي","فَما طائِري فيها عَلَيكِ بِأَخيَلا",29,"ل",2,0],["ذَروا فَلَجاتِ الشَأمِ قَد حالَ دونَها","ضِرابٌ كَأَفواهِ المَخاضِ الأَوارِكِ",30,"ك",1,0],["ذرينيَ قُسطنطينُ آكلُ شهوتي","وتُبشمُنِي إني بذلك راضي",31,"ي",1,1],["ذَراني تَجُد كَفّي بِمالي فَإِنَّني","سَأُصبِحُ لا أَسطيعُ جوداً وَلا بُخلا",32,"ل",2,0],["ذَريني فَلا مالي يَرُدُّ مَنِيَّتي","وَما إِن أَرى حَيّاً عَلى نَفسِهِ قُفلا",32,"ل",2,0],["ذَريني فَإِنَّ الخَمرَ مِن لَذَّةِ الفَتى","وَلَو كُنتُ مَوغولاً عَلَيَّ وَواغِلا",33,"ل",2,0],["ذَرهُم وَإِن أَجلَبوا وَإِن صَخَبوا","وَلا تَلُمهُم فَما هُمُ بَشَرُ",34,"ر",1,0],["ذَرِ المَدح وَالتَشبيبَ بَِلخَمر وَالمَهى","فَإِنّي رَأَيتُ الوَصفَ أَليَقُ بِالشِعرِ",35,"ر",1,0],["ذَرني وَأَشجاني وَجِسمي وَالضَنى","وَيَدي وَأَقلامي وَطَرفي وَالسَهَر",36,"ر",1,0],["ذَريني وَنَفسي أُمَّ حَسّانَ إِنَّني","بِها قَبلَ أَن لا أَملِكَ البَيعَ مُشتَري",37,"ر",2,0],["ذَريني أُطَوِّف في البِلادِ لَعَلَّني","أُخَلّيكِ أَو أُغنيكِ عَن سوءِ مَحضِري",37,"ر",2,0],["ذَرَفَتْهُ أَجفانُ الصَّباحِ مدامعاً","أَلاَّقَةً في دَوْحةٍ وزُهورِ",38,"ر",1,0],["ذَرِ الساعاتِ تَبسُطُهُ","سَتَقبضُهُ يَدُ الفَجرِ",39,"ر",1,0],["ذرفت على تلك المشاهد مقلتي","عبراً وعهدي انها لا تذرف",40,"ف",1,0],["ذريني ألاقي الموت يا نفس واذهبي","فما أنا من جدي أعز ومن أبي",41,"ب",2,1],["ذريني بموتي وهو آخر ملجئ","أخفف من عبء المعيشة منكبي",41,"ب",2,0],["ذريني أنجو من حياة عذابُها","شديد ومن لم يحىَ لم يتعذبِ",41,"ب",1,0],["ذريني ذريني أستنيم إلى الردى","فإن الردى يا نفس سؤلي ومطلبي",41,"ب",2,0],["ذَروني وَشَأني وَالوَغى لا مُبالِياً","إِلى المَوتِ أَمشي أَم إِلى المَوتِ أَركَبُ",42,"ب",1,0],["ذَرِ النَفسَ تَأخُذ وُسعَها قَبلَ بَينِها","فَمُفتَرِقٌ جارانِ دارُهُما العُمرُ",43,"ر",1,0],["ذِراعاها عَدُوّا دُملُجَيها","يَظُنُّ ضَجيعُها الزَندَ الضَجيعا",44,"ع",2,0],["ذَريني أَنَل ما لا يُنالُ مِنَ العُلى","فَصَعبُ العُلى في الصَعبِ وَالسَهلُ في السَهلِ",45,"ل",1,0],["ذَراني وَالفَلاةُ بِلا دَليلٍ","وَوَجهي وَالهَجيرَ بِلا لِثامِ",46,"م",1,0],["ذريني على أخلاقِي الشُّوْسِ إنني","عليمٌ بإمرارِ العزائمِ والنَّقْضِ",47,"ض",1,1],["ذرِيني وما أختارُهُ من تَصَوُّنِي","ومَصِّي ثِمَادَ الرِزْقِ غيرَ مُكَدَّرِ",48,"ر",1,1],["ذَريني وَإِيّاهُم فَحَسبي صَريمَتي","إِذا الحَربُ لَم يُقدَح لِمُخمِدِها زَندُ",49,"د",1,0],["ذَرينِيَ مِن ضَربِ القِداحِ عَلى السُرى","فَعَزمِيَ لا يَثنيهِ نَحسٌ وَلا سَعدُ",49,"د",1,0],["ذَرِبُ اللِسانِ كَأَنَّهُ مِن خَثعَمٍ","ثَبتُ الجَنانِ كَأَنَّهُ مِن حِميَرِ",50,"ر",1,0],["ذَراكَ وَمَن يَحلُل ذَراكَ يَجِد بِهِ","مُجيراً عَلى الأَيّامِ أَن يَتَهَضَّما",51,"م",2,0],["ذِراعٌ بِها لُؤمٌ وَأُخرى كَريمَةٌ","وَما يَصنَعُ الأَقوامُ فَاللَهُ أَصنَعُ",52,"ع",1,0],["ذَرَعنَ بِنا ما بَينَ يَبرينَ عَرضَهُ","إِلى الشَأمِ تَلقانا رِعانٌ وَصَفصَفُ",53,"ف",1,0],["ذروة الموت أن تموت المروءات","ويمشي إلى الوراء الوراء",54,"ا",2,0],["ذَريهِ لا تَقرَبيهِ إِنَّ لَهُ","حَبلاً بِحَبلِ الوَصِيِّ مُتَصِلا",55,"ل",2,0],["ذَريني أُعَلِّل نَفسِيَ اليَومَ إِنَّها","رَهينَةُ رَمسٍ في ثَرى وَجَنادِلِ",56,"ل",1,0],["ذَريني أُعَلِّل بِالشَرابِ فَقَد أَرى","بَقِيَّةَ عَيشي هَذِهِ غَيرَ طائِلِ",56,"ل",1,0],["ذَرَّ النَسيمُ عَلَيهِ مِن أَكنافِهِ","نَشرَ العَبيرِ فَشاقَهُ العَرفُ الشَذي",57,"ي",1,0],["ذُرَواتُ مَجدٍ لا تُنالُ وَهِمَّةٌ","طالَت فَكادَت لِلكَواكِبِ تَحتَذي",57,"ي",1,0],["ذَرعَنكَ نَجمَ الدينِ أَشباحَ العِدى","وَعَلى صَميمِ قُلوبِهِم فَاِستَحوِذِ",57,"ذ",1,0],["ذُرتَ الزَمانَ عَلى الطُغاةِ وَقَد طَغى","وَجَلَوتَ طَرفَ المَكرُماتِ وَقَد قَذي",57,"ي",1,0],["ذَر أَيُّها الصَبُّ تَذكارَ الدِيارِ إِذا","مُتَّعتَ فيها بِعَيشٍ غَيرِ مُتَّسِقِ",58,"ق",1,0],["ذَريني أكُنْ للعزم والليل والسرى","وللحرب والبيداءِ والنَّجمِ سابِعا",59,"ع",2,0],["ذُرى المِنبَرِ الصَعبِ مِن فُرشِهِ","وَنارُ الوَغا نارُهُ لِلصِلاءِ",60,"ا",2,0],["ذَريني مِنكِ سافِحَةَ المَآقي","وَمِن سَرَعانِ عَبرَتِكِ المُراقِ",61,"ق",1,1],["ذَريني وَأَهوالَ الزَمانِ أُفانِها","فَأَهوالُهُ العُظمى تَليها رَغائِبُه",62,"ب",2,0],["ذرَّ كافورَ ثلجِهِ الجوُّ في الأر","ضِ فأضحى مزاجُها كافورا",63,"ر",2,1],["ذَرَفَت عَينُها فَفاضَت دُموعي","وَكِلانا يَلقَي بِلُبٍّ أَصيلِ",64,"ل",1,0],["ذَريهم إذ عَصَوْكِ ولم يثوبوا","إلى الوَحْيِ المنزَّلِ أو ذرينا",65,"ن",2,0],["ذَراني أُقِم لِلشِعرِ في مِصرَ مَأتَما","إِلى أَن يَفيضَ النيلُ في أَرضِها دَما",66,"م",2,1],["ذَرُوفُ النَهارِ حِينَ تَحمي مِن البُكا","كَثِيرٌ إِذا جَنَّ الظَلامُ اطِّرَادُها",67,"د",3,0],["ذَرَّ في وَجهِها المَلاحَةَ ذَرّاً","خالِقٌ هَزَّ غُصنَها تَحتَ بَدرِ",68,"ر",1,0],["ذَرْهُ يُجَمِّعُ ألْفَ ألف كتِيبَةٍ","فهو النَّكُولُ وجَمْعُه المفلُول",69,"ل",1,0],["ذَرْني ومَيدانَ الجيادِ فإنّمَا","تُبْلى السوابقُ عندَ مَدِّ المِقبَص",70,"ص",1,0],["ذَرْنَا من اللّيْثِ الذي زعموا فهل","جرَّبتَهُ في معركٍ أو مَقْنَص",70,"ص",1,0],["ذَرُوا الوِرْدَ في ماء الفُراتِ لخيلِهِ","فلا ال