t/poem60849.html","الطويل"],[365,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[366,"رأيت رجالا ناكسين رؤوسهم","https://www.aldiwan.net/poem44379.html","الطويل"],[370,"ذريني وخلقي يا أميم فإنني","https://www.aldiwan.net/poem4323.html","الطويل"],[372,"أما بهواه تيمني هواه","https://www.aldiwan.net/poem56988.html","الخفيف"],[372,"صددت ولي في الناس أهل وجيران","https://www.aldiwan.net/poem57015.html","البسيط"],[372,"جزعت فجزع دمع عينك بالدم","https://www.aldiwan.net/poem57157.html","الطويل"],[372,"مزيدي أسى ما عندكم أنه يسلي","https://www.aldiwan.net/poem57215.html","الطويل"],[372,"عسى بعض هاتيك العوائد عائد","https://www.aldiwan.net/poem57499.html","الطويل"],[378,"كأن دموع النفس في نحرها سلك","https://www.aldiwan.net/poem59304.html","الطويل"],[378,"يسوع أقبل من عرش السماء فقد","https://www.aldiwan.net/poem59452.html","البسيط"],[378,"ذريني فجدي حيثما كنت مرشدي","https://www.aldiwan.net/poem66877.html","الطويل"],[378,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[378,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[406,"ذرني أسر في البلاد مبتغيا","https://www.aldiwan.net/poem49458.html","المنسرح"],[407,"أسيلة خد دونه الأسل السمر","https://www.aldiwan.net/poem50165.html","الطويل"],[407,"خليلي قد طال الكرى بكما هبا","https://www.aldiwan.net/poem50203.html","الطويل"],[417,"زماني على رغم الحسود مسالمي","https://www.aldiwan.net/poem53996.html","الطويل"],[417,"دعاه إلى الهوى داعي التصابي","https://www.aldiwan.net/poem54151.html","الوافر"],[417,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[440,"ثنائي عليك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[453,"تنبهت في الروابي نسمة الفلق","https://www.aldiwan.net/poem13863.html","البسيط"],[459,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[459,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[459,"ذكرت وما وفاي بحيث أنسى","https://www.aldiwan.net/poem56157.html","الوافر"],[459,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[462,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[462,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[465,"مابعد لقياك للعافين من أملِ","https://www.aldiwan.net/poem3136.html","عموديه"],[465,"أعاذلتي في حبس نفس ملية","https://www.aldiwan.net/poem3307.html","عموديه"],[478,"برق تألق من تهامه","https://www.aldiwan.net/poem15205.html","مجزوء الكامل"],[478,"عفى الزمان مرابعاوملاعبا","https://www.aldiwan.net/poem15213.html","الكامل"],[480,"قم بالمهمة في حل ومرتحل","https://www.aldiwan.net/poem36964.html","البسيط"],[483,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[501,"وحي السماء منزل ببيوتنا","https://www.aldiwan.net/poem37804.html","الكامل"],[501,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[515,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[516,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[521,"لسعد قدومكم هبّ النسيم","https://www.aldiwan.net/poem815.html",""],[544,"أيا تملك يا تمل","https://www.aldiwan.net/poem1760.html","الهزج"],[559,"ذو العلم يعرف أن أصل المأخذ","https://www.aldiwan.net/poem33551.html","الكامل"],[559,"نور تلفف بالظلام مكمل","https://www.aldiwan.net/poem34237.html","الكامل"],[563,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[570,"ذريني أَم مسكين ذريني","https://www.aldiwan.net/poem52024.html","الوافر"]],"verses":[["ذرتها السواقي حِجة بعد حجة","وأضوت عليها البارقات الرواعد",0,"د",1,0],["ذَرَّت إِلَيَّ ذُرورَ الشَمسِ طالِعَةً","شُروقُها أَبَداً باقٍ بِلا أُصُلِ",1,"ل",1,0],["ذَرَعَ الدُجى وَطَوى خَميصَتَهُ","وَلَها عَلى قِمَمِ الرُبى كُفَفُ",2,"ف",1,0],["ذَرا اللَومَ يا بني سالِمٍ إِنَّ صَبوَتي","رَمَتْ كُلَّ لاحٍ مِن إِبائي بِمُسكِتِ",3,"ت",1,1],["ذَرِ اللَّومَ يا بْنَ الهاشِميَّة إِنَّني","بِغَيضٌ إِليَّ العاذِلُ المُتَخَرِّصُ",4,"ص",1,1],["ذَرِيني أُراعِ النَّجْمَ في مُدْلَهِمَّةٍ","تَخوضُ دَياجيها المَطِيُّ الأَوارِكُ",5,"ك",1,0],["ذَريني وَالحُسامَ أُفِدْكِ مَالاً","فَراحَةُ مَنْ يَعولُكِ في التَّعَنِّي",6,"ن",2,0],["ذَرِ اللّوْمَ إني لَسْتُ أُرْعيكَ مَسمَعي","فتلكَ هَوى نَفسي وأنتَ خَليلُها",7,"ل",3,0],["ذَرَفَتْ عُيونُ المَكْرُماتِ وأعْصَمَتْ","أسَفاً بأكْبادٍ علَيْهِ حِرارِ",8,"ر",1,0],["ذَريني أَنَم لَم أَنَل مِنكِ زَورَةً","لَعَلَّ خَيالاً في المَنامِ يَزورُ",9,"ر",1,0],["ذَري عَنكِ يا ذَلفاءُ طولَ عِتابي","وَلا تَترُكي داعيكِ غَيرَ مُجابِ",10,"ب",1,1],["ذَروها وأرْضَ اللهِ لا تَعْرِضوا لَها","بمَعْرِضِ سُوءٍ فهْيَ ناقَةُ صالِحِ",11,"ح",1,0],["ذَروا آلَ سلمى ظِنَّتي وَتَعَنُّتي","وَما زَلَّ مِنّي إِنَّ مافاتَ فائِتُ",12,"ت",1,1],["ذَريني لَكِ الوَيلاتُ آتي الغَوانِيا","مَتى كُنتُ ذَرّاعاً أَسوقُ السَوانِيا",13,"ي",2,1],["ذَرَّ الكَتاتيبَ مُنشيها بِلا عَدَدٍ","ذَرَّ الرَمادِ بِعَينِ الحاذِقِ الأَرِبِ",14,"ب",1,0],["ذَراها إِذا رامَت مَعاجاً إِلى الحِمى","فَقَد هاجَ مِنها البَرقُ داءً مُكَتَّما",15,"م",2,1],["ذِراعٌ لِما يَأتي بِهِ الدَهرُ واسِعٌ","وَباعٌ إِلى مايُحرِزُ الفَخرَ مُمتَدُّ",16,"د",1,0],["ذِراعَي عَيطَلٍ أَدماءَ بِكرٍ","هِجانِ اللَونِ لَم تَقرَأ جَنينا",17,"ن",2,0],["ذَري عَنكِ أَقوالَ الضَلالِ كَفى بِنا","لِكَبشِ الوَغى في اليَومِ وَالأَمسِ ناطِحا",18,"ح",2,1],["ذَرُوا كُلَّ قَوْلٍ فَاقِدِ النَّفْعِ جَانِباً","وَمُدُّوا مَجَالَ الْفِعْلِ ذَلِكَ أحْزَمُ",19,"م",1,0],["ذَرَفَت دُموعي ثمَّ قُل","تُ بِمَن يُبَادِلُني بِمَن",20,"ن",1,0],["ذُرى أُقحُوانِ الرَملِ هَزّت فُروعَهُ","صَبا طَلَّةٌ بَينَ الحُقوفِ اليَتائِمِ",21,"م",1,0],["ذَرَعَن بِنا أَجوازَ كُلِّ تَنوفَةٍ","مُلَمِّعَةٍ وَالأَرضُ يُطوى عَريضُها",22,"ض",3,0],["ذُرى أُقحُوانٍ واجَهَ اللَيلُ وَاِرتَقى","إِلَيهِ النَدى مِن رامَةَ المُتَرَوَّحُ",23,"ح",1,0],["ذروني فإني بالعلاء خبيرُ","أَسيرُ فإِنّ النَّيِّراتِ تسيرُ",24,"ر",1,1],["ذريني فلو أَنّي أُخَلّد بالغنى","لكنتُ ضنيناً بالذي ملكت يدي",25,"ي",1,0],["ذريني أزُرْ في هَضْب لُبنان أربعاً","تعالت بحيث العزّ مُرخَى الضفائر",26,"ر",1,0],["ذَرَنَّ الفَخرَ يا اِبنَ أَبي خُلَيدٍ","وَأَدِّ خَراجَ رَأسِكَ كُلَّ عامِ",27,"م",1,0],["ذَرني وَما مَلَكَت يَمي","ني إِن رَفَعتُ بِهِ شُؤونا",28,"ن",2,0],["ذَريني وَحالي إِنَّ مالَكِ وافِرٌ","وَكُلُّ اِمرِئٍ جارٍ عَلى ما تَعَوَّدا",29,"د",2,0],["ذَريني يَكُن مالي لِعِرضِيَ جُنَّةً","يَقي المالُ عِرضي قَبلَ أَن يَتَبَدَّدا",29,"د",2,0],["ذَريني وَعِلمي بِالأُمورِ وَشيمَتي","فَما طائِري فيها عَلَيكِ بِأَخيَلا",30,"ل",2,0],["ذَروا فَلَجاتِ الشَأمِ قَد حالَ دونَها","ضِرابٌ كَأَفواهِ المَخاضِ الأَوارِكِ",31,"ك",1,0],["ذرينيَ قُسطنطينُ آكلُ شهوتي","وتُبشمُنِي إني بذلك راضي",32,"ض",2,1],["ذَراني تَجُد كَفّي بِمالي فَإِنَّني","سَأُصبِحُ لا أَسطيعُ جوداً وَلا بُخلا",33,"ل",2,0],["ذَريني فَلا مالي يَرُدُّ مَنِيَّتي","وَما إِن أَرى حَيّاً عَلى نَفسِهِ قُفلا",33,"ل",2,0],["ذَريني فَإِنَّ الخَمرَ مِن لَذَّةِ الفَتى","وَلَو كُنتُ مَوغولاً عَلَيَّ وَواغِلا",34,"ل",2,0],["ذَرهُم وَإِن أَجلَبوا وَإِن صَخَبوا","وَلا تَلُمهُم فَما هُمُ بَشَرُ",35,"ر",1,0],["ذَرِ المَدح وَالتَشبيبَ بَِلخَمر وَالمَهى","فَإِنّي رَأَيتُ الوَصفَ أَليَقُ بِالشِعرِ",36,"ر",1,0],["ذَرني وَأَشجاني وَجِسمي وَالضَنى","وَيَدي وَأَقلامي وَطَرفي وَالسَهَر",37,"ر",1,0],["ذَريني وَنَفسي أُمَّ حَسّانَ إِنَّني","بِها قَبلَ أَن لا أَملِكَ البَيعَ مُشتَري",38,"ر",2,0],["ذَريني أُطَوِّف في البِلادِ لَعَلَّني","أُخَلّيكِ أَو أُغنيكِ عَن سوءِ مَحضِري",38,"ر",2,0],["ذَرَفَتْهُ أَجفانُ الصَّباحِ مدامعاً","أَلاَّقَةً في دَوْحةٍ وزُهورِ",39,"ر",1,0],["ذَرِ الساعاتِ تَبسُطُهُ","سَتَقبضُهُ يَدُ الفَجرِ",40,"ر",1,0],["ذرفت على تلك المشاهد مقلتي","عبراً وعهدي انها لا تذرف",41,"ف",1,0],["ذريني ألاقي الموت يا نفس واذهبي","فما أنا من جدي أعز ومن أبي",42,"ب",2,1],["ذريني بموتي وهو آخر ملجئ","أخفف من عبء المعيشة منكبي",42,"ب",2,0],["ذريني أنجو من حياة عذابُها","شديد ومن لم يحىَ لم يتعذبِ",42,"ب",1,0],["ذريني ذريني أستنيم إلى الردى","فإن الردى يا نفس سؤلي ومطلبي",42,"ب",2,0],["ذَروني وَشَأني وَالوَغى لا مُبالِياً","إِلى المَوتِ أَمشي أَم إِلى المَوتِ أَركَبُ",43,"ب",1,0],["ذَرِ النَفسَ تَأخُذ وُسعَها قَبلَ بَينِها","ف