{"poems":[[255,"أرى الإسكندرية ذات حسن","https://www.aldiwan.net/poem14945.html","الوافر"],[371,"ولقد رأيت وما سمعت بمثله","https://www.aldiwan.net/poem17392.html","الكامل"],[409,"قلب المتيم كل يذوده","https://www.aldiwan.net/poem33973.html","مجزوء الكامل"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[5363,"يا باعث الأشجان","https://www.poetsgate.com/ViewPoem.aspx?id=144151",""],[5725,"موت عراقي الشذى","https://www.poetsgate.com/ViewPoem.aspx?id=207163",""],[5887,"كفكف الدمع أنت على الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=37214",""]],"verses":[["بَرُصُّ فصوصَهُ بانيه رصاً","يُفَصِّلهُ على نَظمِ العُقُودِ",0,"د",1,0],["بَرَصٌ يُرينا مِنهُ جِلداً أَبيَضاً","وَأَذى يُرينا مِنهُ جِلداً أَسحَما",1,"م",2,0],["برصانة ورزانة","والذهن ملتهب وقوده",2,"د",2,0],["بِرَصينِ القَولِ جُودي","إنه فخرُ الأنامِ",3,"م",1,0],["برصومُ مع يعقوبَ ذاكَ البردعيِّ","ودِسقُرُس تَبِعُوهُ بالبُطلانِ",4,"ن",1,0],["بِرَصِّهِمِ الخُوَذُ اللامِعاتُ","تَلاقَت تَموجُ بِها العَذَباتُ",5,"ت",1,0],["برصاص قتَّالٍ بقلب عدوِّهمْ","وتحالفِ النيران والأقلامِ",6,"م",1,0],["برصاص الغدر مذموم الصدى","عجّل النصر بصدر البطلِ",7,"ل",1,0],["برصاصهم قتلوا الشيوخ وهشموا","بعصيهم منا الجماجم واليدا",8,"د",2,0]]}