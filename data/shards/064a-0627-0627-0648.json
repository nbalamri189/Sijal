{"poems":[[71,"يا أولي العلم خبروني فإني","https://www.aldiwan.net/poem3860.html","الخفيف"],[93,"يا أوحد الطب هذي","https://www.aldiwan.net/poem11158.html","المجتث"],[93,"أمرتني وبهذا الأمر تسعدني","https://www.aldiwan.net/poem11261.html","البسيط"],[93,"ألعرق الذوقي أشهى الطلا","https://www.aldiwan.net/poem11352.html","السريع"],[51,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[61,"حمى الأمير أمان الخائف الوجل","https://www.aldiwan.net/poem51471.html","البسيط"],[46,"ما لي رأيتك لا تلم بمسجد","https://www.aldiwan.net/poem22966.html","الكامل"],[46,"لو كان يدري أويس ماجنت يده","https://www.aldiwan.net/poem23343.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54957","الكامل"],[135,"حلا لدي الصب ما حياه من كتب","https://www.aldiwan.net/poem49058.html","البسيط"],[135,"دع في الغرام مقالة السفهاء","https://www.aldiwan.net/poem49114.html","الكامل"],[143,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[185,"لا أظلم البين حالي كالذي كانا","https://www.aldiwan.net/poem14679.html","البسيط"],[211,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[223,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[304,"يا ربنا يا ربنا","https://www.aldiwan.net/poem16747.html","مجزوء الكامل"],[305,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[305,"لا والذي بثناكم منطقي فتقا","https://www.aldiwan.net/poem56463.html","البسيط"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[328,"قولو لمن نظم الرواية","https://www.aldiwan.net/poem55011.html","مجزوء الكامل"],[328,"قالوا الربيع فقلت لا","https://www.aldiwan.net/poem55037.html","مجزوء الكامل"],[353,"رتب العز والتقى","https://www.aldiwan.net/poem40027.html","مجزوء الخفيف"],[353,"يا أوحد الأدباء إني ناصح","https://www.aldiwan.net/poem40176.html","الكامل"],[364,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[371,"رسم علي لناظري","https://www.aldiwan.net/poem57439.html","مجزوء الكامل"],[391,"أدركوني أدركوني","https://www.aldiwan.net/poem54460.html","عموديه"],[400,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[400,"في ليل دافوس","https://www.aldiwan.net/poem6729.html","عموديه"],[409,"يا أوحد العصر علا وعنصرا","https://www.aldiwan.net/poem31701.html","عموديه"],[432,"عهدي بحيك وهو حي عامر","https://www.aldiwan.net/poem12398.html","الكامل"],[432,"يا حافظا علقت بذي","https://www.aldiwan.net/poem12413.html","مجزوء الكامل"],[432,"يا أولا في كل عد","https://www.aldiwan.net/poem12511.html","مجزوء الكامل"],[441,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[453,"أمودعي من قبل أن يلقاني","https://www.aldiwan.net/poem61317.html","الكامل"],[464,"يا أوحد العلماء لو شاهديني","https://www.aldiwan.net/poem3175.html","عموديه"],[538,"يا أودائي إليكم صورتي","https://www.aldiwan.net/poem47531.html","عموديه"],[551,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[558,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"]],"verses":[["يا أُولي العِلمِ خَبِّروني فَإِنّي","ضاقَ ذَرعي وَضَلَّ ثاقِبُ فَهمي",0,"ي",1,1],["يَا أَوْحَدَ الطُّبِّ هَذِي","بُشْرَى وَقُرَّةُ عَيْنِ",1,"ن",1,1],["يَا أَوْحَدَ الدَّهْرِ فِي طُبِّ النِّسَاءِ وَإِنْ","نُفْرِدْهُ لَمْ يُنْتَقَضْ فَضْلٌ وَلَمْ يَهُنِ",2,"ن",1,0],["يَا أَوَّلَ الفُتْيَانِ فِي أُسْرَةٍ","قَدْ أَنْجَبتْ لِلْجَّاهِ أَعْلامَا",3,"م",2,0],["يا أولياءَ عهودِ الشرِّ هَوْنَكُمُ","منْ غالبَ اللَّهَ في سلطانه غُلِبَا",4,"ب",2,0],["يا أوسعَ الناسِ صَدراً يومَ مَلحَمةٍ","وأضربَ الناسِ فيها هامةَ البَطلِ",5,"ل",1,0],["يا أَوَّلاً في الكُفرِ لَم يَكُ ثانِياً","طالَ اِستِتارُكَ بِالإِمامِ الرابِعِ",6,"ع",1,0],["يا أَوسُ هَيهاتَ كَم قابَلتَ هاجِرَةً","أَذكَت عَلَيكَ وَقودَ الحَرِّ فَاِحتَدَما",7,"م",2,0],["يَا أَوْحَدَ الأُمَرَاءِ يَا عُمَر","يَمْضِي السَّحَابُ وَيَنْجَلِي الْقَمَرُ",8,"ر",1,1],["يا أوحد العصر دم في رفعة وسناً","وارق العُلا وابتهج وأسلم وسُد وطِبِ",9,"ب",1,0],["يا أوحد العلماء بل يا أمجد ال","نبلاءِ بل يا أسعد السعداءِ",10,"ا",2,0],["يا أَوضَحَ البيضِ عِندَ المُجتَلى أُثُرا","أَجَل وَأَشهَرُها يَومَ الوَغى أَثَرا",11,"ر",2,0],["يا أوحدَ الناسِ في خَلْقٍ وفي خُلُق","هَلاّ أضفتَ لذاك الحسنِ إحسانا",12,"ن",2,0],["يا أوحد الخلق في تنسيق صورته","ويا مثال السنا من نور تبياني",13,"ي",1,0],["يا أولِغا مَرَّ الصَفا عابِراً","كلَّ صفاءٍ في الوَرى يعبُرُ",14,"ر",1,0],["يا أَوَّلاً يا آخِراً","يا ظاهِراً يا باطِنا",15,"ن",2,0],["يا أوحداً حازَ الفضائلَ ثانياً","فَضلَ العنانِ وعطفه عن مأثمِ",16,"م",1,0],["يا أوحداً غَفَر اللّه الكريم بهِ","ذنباً لَو اِدركَ نورَ الشمس لاِنمَحقا",17,"ق",2,0],["يا أوحَدَ العلماءِ غير مدافعٍ","في صدرِ شانيك المكارم تدفعُ",18,"ع",1,0],["يا أوّل الباغين كم","لك في الضلالةِ من مآثر",19,"ر",1,0],["يا أول الألحان ما","لي عن تعشقك اصطبار",20,"ر",1,0],["يا أولي الفَضل أَرّخوا","رُتبتي العزّ وَالتُقى",21,"ق",2,0],["يا أَوحدَ الأُدباءِ إِنّي ناصِحٌ","لا عاذِلٌ بَل عاذِرٌ فيمَن عَذر",22,"ر",1,1],["يا أوحداً للعصرِ أصبح صِيتُه","يومَ الفَخارِ لكُلِّ جَرْسٍ مخفِتا",23,"ت",2,0],["يا أوَّل الحَسَراتِ جِئ","تَ مُعقِّباً في الآخِرِ",24,"ر",1,0],["يا أولي المعروف جودا","سايروني واحفوظني",25,"ن",2,0],["يا أولاةَ الأَمْرِ اسمعونا، فإنَّ","ما جَهلناكمو، ولم تَجْهَلُونا",26,"ن",2,0],["يا أوردغان تحيانا معطرةً","أما الدعاء فما استخفى ولا فترى",27,"ر",2,0],["يا أوحد العصر علا وعنصرا","وبحر فضل بالعلوم زخرا",28,"ر",2,1],["يا أَولَّ السَّاداتِ غَيْرَ مُنَازَعٍ","وإِنِ اعْتَلَى بكَ ذا الزمانُ الآخِرُ",29,"ر",1,0],["يا أَولاً أَنا للضَّنَى","والفقرِ والأَشجانِ رابعْ",30,"ع",1,0],["يا أوّلاً في كل عدٍّ","وجماعةً في شخصِ فردِ",31,"د",1,1],["يا أول يا آخر يا ظاهر","يا باطن يا ذا الجلال مهيمنا",32,"ن",2,0],["يا أوحد العصر الذي إيمانه","بالحق اسعد دائما إيماني",33,"ي",1,0],["يا أوحدَ العلماء لو شاهديني","بالأمس بين يدي ذوي الأحوال",34,"ل",1,1],["يَا أوِدَّائي إليكُمُ صُورَتِي","بدَلاَ عنِّى إلى يَومِ التَّلاق",35,"ق",1,1],["يا أوثقَ النّاسِ عقداً","وأعذبَ النّاسِ وِرْدا",36,"د",2,0],["يا أولي الألباب هل من أحد","منصفي قد ضاعت النفس هنا",37,"ن",2,0]]}