م","https://www.poetsgate.com/ViewPoem.aspx?id=176828",""],[5899,"عطر النار","https://www.poetsgate.com/ViewPoem.aspx?id=31488",""],[5942,"بغداد. يا لغة الدنيا وجنتها","https://www.poetsgate.com/ViewPoem.aspx?id=215593",""],[5952,"في يوم مولده","https://www.poetsgate.com/ViewPoem.aspx?id=207804",""],[5953,"يا أيها الأول الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=93785",""],[5956,"وجوه مبتسمة","https://www.poetsgate.com/ViewPoem.aspx?id=184823",""],[5997,"دمعة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=214255",""],[6019,"موج قصيدة ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53046",""],[6089,"يا سدرةَ النّجوى","https://www.poetsgate.com/ViewPoem.aspx?id=214099",""],[6125,"يا أوَّل الغيثِ","https://www.poetsgate.com/ViewPoem.aspx?id=210902",""],[6142,"يا أول الناس للإسلام مرتبة","https://www.poetsgate.com/ViewPoem.aspx?id=155742",""],[6213,"نهر الأحلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76256&r=&rc=13",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["يا أُولي العِلمِ خَبِّروني فَإِنّي","ضاقَ ذَرعي وَضَلَّ ثاقِبُ فَهمي",0,"م",2,1],["يَا أَوْحَدَ الطُّبِّ هَذِي","بُشْرَى وَقُرَّةُ عَيْنِ",1,"ن",1,1],["يَا أَوْحَدَ الدَّهْرِ فِي طُبِّ النِّسَاءِ وَإِنْ","نُفْرِدْهُ لَمْ يُنْتَقَضْ فَضْلٌ وَلَمْ يَهُنِ",2,"ن",1,0],["يَا أَوَّلَ الفُتْيَانِ فِي أُسْرَةٍ","قَدْ أَنْجَبتْ لِلْجَّاهِ أَعْلامَا",3,"م",2,0],["يا أولياءَ عهودِ الشرِّ هَوْنَكُمُ","منْ غالبَ اللَّهَ في سلطانه غُلِبَا",4,"ب",2,0],["يا أوسعَ الناسِ صَدراً يومَ مَلحَمةٍ","وأضربَ الناسِ فيها هامةَ البَطلِ",5,"ل",1,0],["يا أَوَّلاً في الكُفرِ لَم يَكُ ثانِياً","طالَ اِستِتارُكَ بِالإِمامِ الرابِعِ",6,"ع",1,0],["يا أَوسُ هَيهاتَ كَم قابَلتَ هاجِرَةً","أَذكَت عَلَيكَ وَقودَ الحَرِّ فَاِحتَدَما",7,"م",2,0],["يَا أَوْحَدَ الأُمَرَاءِ يَا عُمَر","يَمْضِي السَّحَابُ وَيَنْجَلِي الْقَمَرُ",8,"ر",1,1],["يا أول الكل بعد الله مبتدَعا ً","وأول الكل عند الله في الخطر",9,"ر",1,0],["يا أوحد العصر دم في رفعة وسناً","وارق العُلا وابتهج وأسلم وسُد وطِبِ",10,"ب",1,0],["يا أوحد العلماء بل يا أمجد ال","نبلاءِ بل يا أسعد السعداءِ",11,"ا",2,0],["يا أَوضَحَ البيضِ عِندَ المُجتَلى أُثُرا","أَجَل وَأَشهَرُها يَومَ الوَغى أَثَرا",12,"ر",2,0],["يا أوحدَ الناسِ في خَلْقٍ وفي خُلُق","هَلاّ أضفتَ لذاك الحسنِ إحسانا",13,"ن",2,0],["يا أوحد الخلق في تنسيق صورته","ويا مثال السنا من نور تبياني",14,"ن",2,0],["يا أولِغا مَرَّ الصَفا عابِراً","كلَّ صفاءٍ في الوَرى يعبُرُ",15,"ر",1,0],["يا أَوَّلاً يا آخِراً","يا ظاهِراً يا باطِنا",16,"ن",2,0],["يا أوحداً حازَ الفضائلَ ثانياً","فَضلَ العنانِ وعطفه عن مأثمِ",17,"م",1,0],["يا أوحداً غَفَر اللّه الكريم بهِ","ذنباً لَو اِدركَ نورَ الشمس لاِنمَحقا",18,"ق",2,0],["يا أوحَدَ العلماءِ غير مدافعٍ","في صدرِ شانيك المكارم تدفعُ",19,"ع",1,0],["يا أوّل الباغين كم","لك في الضلالةِ من مآثر",20,"ر",1,0],["يا أول الألحان ما","لي عن تعشقك اصطبار",21,"ر",1,0],["يا أولي الفَضل أَرّخوا","رُتبتي العزّ وَالتُقى",22,"ق",2,0],["يا أَوحدَ الأُدباءِ إِنّي ناصِحٌ","لا عاذِلٌ بَل عاذِرٌ فيمَن عَذر",23,"ر",1,1],["يا أوحداً للعصرِ أصبح صِيتُه","يومَ الفَخارِ لكُلِّ جَرْسٍ مخفِتا",24,"ت",2,0],["يا أوَّل الحَسَراتِ جِئ","تَ مُعقِّباً في الآخِرِ",25,"ر",1,0],["يا أولي المعروف جودا","سايروني واحفوظني",26,"ن",2,0],["يا أولاةَ الأَمْرِ اسمعونا، فإنَّ","ما جَهلناكمو، ولم تَجْهَلُونا",27,"ن",2,0],["يا أوردغان تحيانا معطرةً","أما الدعاء فما استخفى ولا فترى",28,"ر",2,0],["يا أوحد العصر علا وعنصرا","وبحر فضل بالعلوم زخرا",29,"ر",2,1],["يا أَولَّ السَّاداتِ غَيْرَ مُنَازَعٍ","وإِنِ اعْتَلَى بكَ ذا الزمانُ الآخِرُ",30,"ر",1,0],["يا أَولاً أَنا للضَّنَى","والفقرِ والأَشجانِ رابعْ",31,"ع",1,0],["يا أوّلاً في كل عدٍّ","وجماعةً في شخصِ فردِ",32,"د",1,1],["يا أول يا آخر يا ظاهر","يا باطن يا ذا الجلال مهيمنا",33,"ن",2,0],["يا أوحد العصر الذي إيمانه","بالحق اسعد دائما إيماني",34,"ن",2,0],["يا أوحدَ العلماء لو شاهديني","بالأمس بين يدي ذوي الأحوال",35,"ل",1,1],["يَا أوِدَّائي إليكُمُ صُورَتِي","بدَلاَ عنِّى إلى يَومِ التَّلاق",36,"ق",1,1],["يا أوثقَ النّاسِ عقداً","وأعذبَ النّاسِ وِرْدا",37,"د",2,0],["يا أولي الألباب هل من أحد","منصفي قد ضاعت النفس هنا",38,"ن",2,0],["يا أوحد العصر يابحاثة عثرت","على كنوز يداه بعد من نقبا",39,"ب",2,0],["يا أوحد الزعماء في القطر الذي","حقا بعثت لساكنيه رسولا",40,"ل",2,0],["يا أَوحَدَ العَصرِ الَّذي عَقَدَت عَلى","تَقديمِهِ في الفَضلِ خَيرُ خَناصِرِ",41,"ر",1,0],["يا أَوحد الدَهر في حَزم وَفي حَسبِ","وَمُفرد العَصر في عَزم وفي نَسَبِ",42,"ب",1,1],["يا أَوحد الدَهر في ملكٍ وفي حسبِ","وَمفرد العَصر بَين العَجم وَالعَرَبِ",43,"ب",1,1],["يا أَوحَد الدَهر مجد وَفي شَرَف","وَمُفرَد العَصر في سَعد وَفي تَرَف",44,"ف",1,1],["يا أَوحد الدَهر في تَدبير مملكةٍ","نشرت فيها لِواء العَدل وَالأَدَبِ",45,"ب",1,1],["يا أَوحَد الدَهر إِني قَد قَصدت حمىً","مَن أَمَّه نال فَوقَ القَصد وَالأَملِ",46,"ل",1,1],["يا أَوحَد الدَهر في مجد وَفي شَرَفِ","وَمُفرَد العَصر في سَعد وَفي تَرَفِ",47,"ف",1,1],["يا أَوحد الدَهر في أَصل وَفي حَسَبِ","وَمُفرد العَصر في فَضل وَفي أَدَبِ",48,"ب",1,1],["يا أورزيل تعطَّفي وتطلَّبي","ما شئت إن لم تكتفي بفؤاديا",49,"ي",2,0],["يا أورزيل أسلواناً وتعزيةً","إن عشت أو مت إن القلب مثواكِ",50,"ك",1,1],["يا أورزيل إليك أشكو لوعة","ملء الفؤاد وكربة لا تدفعُ",51,"ع",1,1],["يا أورزيل ولست أشكو محنة","إلا إلى هذا الجمال وأضرع",51,"ع",1,0],["يا أورزيل أما لتيهك غاية","وإلى متى تترفعين وأخضع",51,"ع",1,0],["يا أوحد العصر ويا نور المقل","ويا طبيباً طبه فاق الأول",52,"ل",1,1],["يَا أوسعَ الرسلْ جاهاً يا كريم أقِلْ","مِنَ الخَطَايَا التِي قَدْ ألْزَمَتْ عُنُقِي",53,"ق",2,0],["يا أول يا آخر يا ظاهر","يا باطن يا ذا الإغاثة يا كريم",54,"م",1,0],["يا أوسع الرسل جاها إنني دنف","قد أوبقتني أوزار وزلات",55,"ت",1,0],["يا أَوسعَ الناسِ صَفحاً في سجيّتهِ","عَن مَن جَنى من جناياتٍ أو اِقترَفا",56,"ف",2,0],["يا أوحد الدهر الذي قد غدا","في حسن الطاف المزايا فريدْ",57,"د",1,0],["يا أولاً قد قدمتك ارادة","سبقت وفضل الله والانعام",58,"م",1,0],["يا أُولي الأَلبابِ يا أولي النُهى","هِمتُ ما بينَ المَهاةِ وَالمَها",59,"ه",2,1],["يا أولا في المكرمات فما له","فيها وعنها في البرية ثاني",60,"ن",2,0],["يا أولاً فيه أهل الفضل قد بدأوا","وآخراً فيه أهل العلم قد ختموا",61,"م",3,0],["يا أورقا يا غصناً يا نقا","يا ظبية بالليل يا صبح",62,"ح",1,0],["يا أول الخلق يا من نوره اقتبست","منه الورى وبر الباري الذي برأه",63,"ا",2,0],["يا أَول الناس إِسلاماً وَأَعرقهم","أَصلاً وَأَطيبهم فرعا إِذا نشرا",64,"ر",2,0],["يا أولا ولي وما","ابقى لأيام أخر",65,"ر",1,0],["يا اوجَ محمدٍ ليس تُحصى زُهرهُ","يا بحرَ فضلٍ لَيسَ يُحصَر دُرُّهُ",66,"ر",2,0],["يا أوجَهَ العلماء عند اللَه بل","والعالمين بباطن أو ظاهر",67,"ر",1,0],["يا أُولِي الفضل والنَدى","مَن غَدَوا مَورِدَ الكَرَم",68,"م",1,1],["يَا أوسَعَ النَّاسِ فَضلاً بَعدض وَالِدِهِ","إِن تُعطِ خَيراً فإِنَّ الله أعطَاكَا",69,"ك",2,0],["يا أولٌ يا آخرٌ يا باطنْ","يا ظاهرٌ أغثْ لكل كائنْ",70,"ن",1,0],["يا أولُ من قبل قولِ أولُ","وآخرٌ وذاك لا يبدَّلُ",71,"ل",1,1],["يا أولٌ قدِّمْ تأخُّري على","تقديمِ من سواي من أهل العُلى",72,"ل",2,0],["يا أولٌ يا آخرٌ يا ظاهرُ","يا باطنٌ كن لي فإني حائرُ",73,"ر",1,0],["يا أوحدا ما إن له ثان إذا","عد الكرام وهل يثنى الأوحد",74,"د",1,0],["يا أَوَّلَ الصَيدِ أَبطالاً وَثانِيَهُم","بَأساً وَمَن لَم يُخَوَّل قُوَّةَ البَطلِ",75,"ل",1,0],["يا أوصياء رسول الَله شانؤكم","نعم هو الابتر المستهجن الخرب",76,"ب",1,0],["يا أَوحدَ العصرِ الذي بزَّ الورى","فضلاً بغيرِ مشاكهٍ ومشاكلِ",77,"ل",1,0],["يا أولى الأشعار ما لي من خليط","باغترابي في مصابي ذا البسيط",78,"ط",1,0],["يا أولي الأشعار زادت لهفتي","أدركوني العجتني زفرتي",78,"ي",1,0],["يا أولى الأشعار ما منكم نصيف","علِّلوني سوِّفوا قلباً شَغيف",78,"ف",1,0],["يا أولى الألباب عذراً عن يقين","إن دهري جاءَ في سؤلي ضنين",78,"ن",1,0],["يا أولى الألباب هل لي من فرار","من يد المعتزِّ في خلع العِذار",78,"ر",1,0],["يا أوحد العلم يا من","قريضه كالسلاف",79,"ف",1,0],["يا أوحد الخلق طرا","لم الجفا والتجافي",79,"ف",2,0],["يا أوحد الناس علماً","ويا وحيد المقال",80,"ل",1,0],["يا أوحد العصر ويا","أبجل من في البلد",81,"د",1,0],["يا أوحدُ بالجمالِ يا جانِمسَن","أز عهدِ من أي دُوست مَكَر نادم سَن",82,"ن",1,1],["يا أول الاعداد في أهل الندى","ولأنت في جمِّ الكريهة فيلق",83,"ق",1,0],["يا أول امرأة وآخر من رأت","عيني فعيني لم ترى إلاَّكِ",84,"ك",1,0],["يا أولَ حبٍ في عمري","أتُراني يوماً أنساكِ",85,"ك",1,0],["يا أول اللّي أسكن الطيب بحشاي","صدرك سقاني الطيب ويّا حليبه",86,"ب",2,0],["يا أول قلب يبكيني وتبكيني مواثيقه","أنا اطباعي ما هي زينه بس هذي اطباعي",87,"ع",2,0],["يا أوّلي في الحبّ ودعتُ الهوى","مذ عقّ مجدافُ الوصالِ مراسي",88,"ي",1,1],["يآ اولي الهرج المُطعّم بالسعير","خآفوا الله بالاكل من لحمتي",89,"ت",2,0],["يا أول الفقد آهاتي مجنحة","ثج الحنيين وفاض الدمع وانسكبا",90,"ب",2,0],["يا أول َ الغادين في قلبي الذي","تعبت ْ إناث ُ الأرض ِ في أن ترسمَهْ",91,"م",2,0],["يا أولى الراحل المفدى تحيا","ت على قمة المقام المعزى",92,"ز",2,0],["يا أول التاريخ كيفَ رقيمُهُ","عن كفّكَ السمراء أضحى يُنزَعُ",93,"ع",1,0],["يا أويقات الهنا عودي لنا","وارفعي الحزن عن القلب الحزين",94,"ن",1,0],["يا أوَّلَ الحَرمَيْنِ ثانِيَ قِبْلةٍ","شَطَّ المزَارُ متَى يكُونُ لقاءُ ؟",95,"ا",2,0],["يا أوّل الناسْ في عالي المراتيبي","ومن دونك الناسْ حاكم فوق حكّامي",96,"م",2,0],["يا أَوس ما طلعت شمسٌ ولا غربتْ","إِلاَّ ذَكرتُكَ والمَحزُونُ يُدَّكرُ",97,"ر",1,1],["يا أولَّ الناسِ إن مرّت قوافلُهُمْ","وأخرُ القومِ يَرمي فيَّ نظرتَهُ",98,"ت",2,0],["يا أوَّلاً ما كانَ غيرَكَ أولٌ","ولكَ النهايةُ في الدُّنى والمطلعُ",99,"ع",1,0],["يا أولَّ اليأسِ هل لي فيكَ ملتجأٌ","وكلُّ أذنابِك الأشلاءُ والمزقُ",100,"ق",1,0],["يا أول احلام روحٍ كان دافعها","انك سندها وحاضرها وماضيها",101,"ي",3,0],["يا أولي ياآخري وسعادتي","ويحقُّ لي أنت المنى وتمتعي",102,"ع",2,0],["يا أولَ الماضين َ في آذارهِ","أنّى لقاؤُكَ ؟ قلْ لنا يا هاشمُ",103,"م",1,0],["يا أول الذبول بالجفون","وأول الكؤوس إنْ هذا",104,"ذ",2,0],["يا أوحد الدهر في طب النساء وإن","نفرده لم ينتقص فضل ولم يهن",105,"ن",1,0],["يا أول طريقٍ بي بدا ولا انتهابي","يا آخر حكايه مرها قلب ماخاب",106,"ب",1,0],["يا أول أنثى أعشقها","آه كم حبك يشجيني",107,"ن",2,0],["يا أولَ الكأسِ تاريخاً ونشرَبُهُ","فكُن كماءٍ قُراحٍ ليس بالأسِنِ",108,"ن",1,0],["يا أول الغيث في الدنيا وآخره","بحر من العلم منه الناس تغترف",109,"ف",1,0],["يا أول فرد قديم","ويا علي ويا كبير",110,"ر",1,0],["يا أوجُهاً بَسَمَتْ جزاكِ إلهُنا","خيراً نقلتِ الروح نحو حبيبها",111,"ب",3,0],["يا أولَ العشقِ في دنيا سرادقها","نفثٌ لهُ في بناْتِ العينِ تكفينا",112,"ن",2,0],["يَا أَوَّلَ النَّبضِ الذي يَحيَا بِهِ","جَسَدِي فَيَزهُو في السِّنِينِ شَبَابَا",113,"ب",2,0],["يا أوَّلي في العالمينَ وآخرِي","طُرقي بدونِكَ مالهنّ عُيُونُ",114,"ن",1,0],["يا أوَّل الغيثِ، مَنْ أرْوي بها ذاتي","يا قِبْلَةَ العشْقِ يا كلَّ الحكاياتِ",115,"ت",1,1],["يا أول الناس للإسلام مرتبة","إلا خديجة ذات الفضل والحسب",116,"ب",1,1],["ياأولادي ياأحبابي","إني أسعى، حبي جائع",117,"ع",1,0],["يَا أوَّلَ السَّطْرِ فِي الدُّنيَا وآخِرَهُ","الواقِعيَّةُ أنتِ والخيَاليَّةْ",118,"ي",2,0]]}