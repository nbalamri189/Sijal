{"poems":[[164,"عطف الحبيب وشمت بارقة الرضا","https://www.aldiwan.net/poem58958.html","الكامل"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[469,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[563,"إنما بيت عزتي وهو قلبي","https://www.aldiwan.net/poem34927.html","الخفيف"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138820",""],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95564","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77742","الكامل"],[4908,"سَمَرٌ شِتائيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=207420",""],[5271,"على ضفافكِ أَستطيبُ عَذابي","https://www.poetsgate.com/ViewPoem.aspx?id=60537",""],[5358,"نطقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=201485",""],[5704,"يا روح الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195152",""],[5747,"ياعطاشا عطشنا","https://www.poetsgate.com/ViewPoem.aspx?id=61669",""],[5893,"لو أكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=141384",""],[5899,"عطر النار","https://www.poetsgate.com/ViewPoem.aspx?id=31488",""],[5943,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=11025",""],[5957,"أهواكِ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=12552",""],[5957,"أوراق حزني","https://www.poetsgate.com/ViewPoem.aspx?id=53846",""],[5957,"للطفل الغارق في حلمه","https://www.poetsgate.com/ViewPoem.aspx?id=181646",""],[6209,"فطوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82548&r=&rc=17",""],[5957,"أوراق حزني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85642&r=&rc=168",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[6343,"فاكهة الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86039&r=&rc=10",""]],"verses":[["يا عطفة الخل الحبيب تعاهدي","قلبي العميد فقد وها وتقوضا",0,"ض",2,0],["يا عطشى إن لم أرِدْ","إلا الخليَّ المَشرَعِ",1,"ع",1,0],["يا عطفه كيف الملاذ بعطفه","هلا تعلم منك أن يتعطفا",2,"ف",2,0],["يا عطاش النفوس هذا زلال","بارد فاشربوا له مثل شربي",3,"ب",2,0],["يا عطر الرحمن مرقد أحمد","وضريحه أبداً بطيب عطرهِ",4,"ر",2,0],["يا عطوفاً على العفاة أيا سع","فان يا ماسحاً دموع اليتامَى",5,"م",2,0],["يا عطر عطار القلوب وَيا","هبوب صبا الغيوب بعلم من لا يعلم",6,"م",1,0],["يا عطرَ أنفاسي بذكرك يرتوي","قلبي ويأسرني الغرامُ ويَعْتِقُ",7,"ق",1,0],["يا عطر أيامي وبحر سفينتي","يا ريح أشرعتي ولون قبابي",8,"ب",2,0],["يا عطْرَ أنسامِ الرّبيعِ","وزهرُهُ ألقى إزارَه",9,"ر",2,0],["يا عطرًا ضاع فأغرقني","في بحر هيام من تيه",10,"ي",2,0],["ياعطاشا عطشنا من ظروفٍ شديده","جف وبل المخيله فالزمان العجيب",11,"ب",1,0],["يا عطر قلبي يا ورود ورياحين","مدي كفوفك قلبي المزهرية",12,"ي",2,0],["يا عطر النار بأوردتي","يا باقة عشق تثريني",13,"ن",2,1],["يا عطرَ قلبي ويانبضَ الحياةِ ويا","دفءَ الأحبَّةِ في أسمى معانيه",14,"ي",2,0],["ياعطرَ سحرٍ قد أتى","يروي غليلي إذ غلا",15,"ا",1,0],["يا عطرك الفواح عد لي ثانية","يا رعشة تعيد روحي البالية",16,"ي",2,0],["يا عطر دماهُ ما بردت","بتراب ٍ يُحسنُ من جسمه",17,"م",2,0],["يا عطر أمسيتي وسكَّرَ قهوتي","يا ظِل أحلامي وبحر سهادي",18,"د",2,0],["يا عطرك الفواح في أردانية","يا رعشة تشتاقها أوتارية",19,"ي",2,0],["يَا عَطَاءَ الإِسْلاَم يَا نَفْحَةَ الإِي","مَان يَادُرَّةَ العَطَاءِ الفَرِيدِ",20,"د",1,0],["يا عطرَ فاكهةِ الكلامِ تمرّدي","فالعطر في أفواهنا يتمرّدُ",21,"د",1,1]]}