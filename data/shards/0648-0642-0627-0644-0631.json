{"poems":[[65,"علاقة بفؤادي أعقبت كمدا","https://www.aldiwan.net/poem45805.html","البسيط"],[48,"قران المشتري زحلا يرجى","https://www.aldiwan.net/poem23581.html","الوافر"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29351","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19689","الرجز"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[251,"نأتك بليلى دارها لا تزورها","https://www.aldiwan.net/poem56333.html","الطويل"],[353,"سلام على الصدر الذي عنده قلبي","https://www.aldiwan.net/poem19861.html","الطويل"],[353,"عاتبته بدر تم","https://www.aldiwan.net/poem19881.html","المجتث"],[369,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[466,"وقال رواة الحي لا بل غواته","https://www.aldiwan.net/poem16056.html","الطويل"],[521,"بزينب المم قبل ان يرحل الركب","https://www.aldiwan.net/poem48740.html","الطويل"],[558,"وقال رجال لو تعرضت للغنى","https://www.aldiwan.net/poem68312.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66816","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61061","الطويل"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67707","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76802","الطويل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131335","الرجز"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89532","الطويل"],[2254,"","https://poetry.dctabudhabi.ae/diwan/poem/83251","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28548","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60974","الطويل"],[2468,"","https://poetry.dctabudhabi.ae/diwan/poem/117816","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94296","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112671","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112644","الرجز"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102388","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[5219,"إليك يا سيدي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193700",""],[5605,"شاعر العرب","https://www.poetsgate.com/ViewPoem.aspx?id=159615",""]],"verses":[["وَقالَ رُحْ يا أَخا فِهْرٍ فَقُلتُ لَهُ","يا سَعدُ أَودَعَ جِسمي طَرفُها مَرَضا",0,"ض",2,0],["وَقالَ رِجالُهُ وَحيٌ أَتاهُ","وَقالَ الظالِمونَ بَلِ اِفتَراها",1,"ا",3,0],["وقال رجال من صديقي إنما","ينال المنى والمفرحات يزيد",2,"د",1,0],["وقال ربى كم أعي","ش عانيا معذبا",3,"ب",2,0],["وقالَ رَسُولُ اللهِ لَمّا بَدَوا لنا","إذا مَا اشْتَهَى أَنّا نُطِيعُ ونسْمعُ",4,"ع",1,0],["وقال رجال لا يَضيرُكَ نأيُها","بلى كلَّ ما شفَّ النفوسَ يضيرها",5,"ر",3,0],["وَقالَ رَأَتْ عَيني ثَلاثَةَ أَرجُلٍ","وَواحِدَةً مِنهُنَّ مَشْؤُمَةَ الكَعبِ",6,"ب",1,0],["وَقَالَ رِفْقاً بِخَصْرٍ","في السُّقمِ أَنتَ نَسِيبُهُ",7,"ب",2,0],["وقال رَسولُ اللّهِ يُوسُفُ ولّنِي","خزائنَها تُحفَظْ لديَّ حُدودها",8,"د",3,0],["وقال رَقيبانا دَعُوا لَومَ ناظرٍ","وناظرةٍ لم تَنْوِ سُوءاً فتُحرَج",9,"ج",1,0],["وقال رب الفضل وهو المشتهر","بكل فضلٍ الأمير المعتبر",10,"ر",1,0],["وقال رواةُ الحي لا بل غواتُهُ","وتلك أحاديث الظُّنونِ الكواذبِ",11,"ب",1,1],["وَقال رِجال حسبه من طلابِها","فَقُلتُ كَذَبتُم لَيسَ لي دونِها حَسب",12,"ب",1,0],["وَقالَ رِجالٌ لَو تَعَرَّضتَ لِلغِنى","سَبيلاً فَإِنَّ المَرءَ مِثلَكَ ذو وَفرِ",13,"ر",1,1],["وقال رسول الله أنّى","يُؤدّي الوحْيَ إلاّ الأقربونا",14,"ن",2,0],["وَقالَ رَعاكَ اللَّه ما لي حيلة","سِوى أَنَّني أَدعو لترجع مُسرِعا",15,"ع",2,0],["وقال رجالٌ إنّ عمراً يُريدُها","فقلت لهم عمروٌ ليَ اليومَ تابعُ",16,"ع",1,0],["وقال رسولُ اللَهِ مَهما اختَلَفتُم","ولم تَعرِفوا قصد السَّبيل المُلَحَّب",17,"ب",1,0],["وقال رسول الله اني مدينة","من العلم وهو الباب فالباب فاقصد",18,"د",1,0],["وقال ربُّ الأَرْض والسّماواتْ","يا أيّها الناسُ كُلُوا مِن طَيِّبات",19,"ت",1,0],["وَقالَ رَسولُ اللَهِ سَمعاً وَطاعَةً","لِذي أَمرِكُم لَو شَطَّ في الحُكمِ عامِلُه",20,"ل",2,0],["وقال رَأسهم هذا يجوزُ وذا","محال اجراؤه في أيما زَمَن",21,"ن",1,0],["وَقالَ رَبيعٌ ماتَ فيهِ مُسَلَّم","فَقُلتُ لَهُ بَل ماتَ فيهِ رَبيعُ",22,"ع",1,0],["وقال رِفَاقي تشربُ الخمْرَ وحدَها","فقلت ولي مِنْ ريق قاتلتي خَمْر",23,"ر",1,0],["وقال رجال سَدَّدَ اليومَ مالكٌ","وقال رجالٌ مالكٌ لم يُسدِّدِ",24,"د",1,1],["وقال رضوان الحنان أرخوا","أبرار عليين قد دعت على",25,"ل",2,0],["وقال ردوا عِترَة الرسولِ","أومّوا بِهم مدينةَ الرسول",26,"ل",1,0],["وقال ربّ خُصَهُم باللَعنِ","وأبلغِ الهادي السَلام مِني",27,"ي",1,0],["وقال رفيقاكَ اللذانَ تجشَّما سُرى الليلِ","من يَجشَمْ سُرى الليلِ يَجشَمِ",28,"م",1,0],["وقال رد واصلته","منه وقد واحلته",29,"ه",1,0],["وقال رب الورى قد نلت منزلة","ما نالها مرسل ... والله قاضيها",30,"ي",3,0],["وقال رابعهم ما ليس نفهمه","ففسر النقد بعد الجهد بالعطب",31,"ب",1,0]]}