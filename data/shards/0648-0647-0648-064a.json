ttps://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5573,"الله الواحد","https://www.poetsgate.com/ViewPoem.aspx?id=200182",""],[482,"بسوى قربِكَ لا يُشْفَى الغليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=111425",""],[5612,"الوَلِيّْ","https://www.poetsgate.com/ViewPoem.aspx?id=179729",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5720,"عاصِفةُ الحَزْم","https://www.poetsgate.com/ViewPoem.aspx?id=199941",""],[5796,"نِمْتُمُ عن ليلِ حِلْفِ السَّهرِ","https://www.poetsgate.com/ViewPoem.aspx?id=189037",""],[5944,"2020","https://www.poetsgate.com/ViewPoem.aspx?id=213794",""],[5989,"يا سائلي ما الحب ..","https://www.poetsgate.com/ViewPoem.aspx?id=181546",""],[6031,"يا خَلِيلَيَّ احْبِسَا الرَّكْبَ إذَا مَا","https://www.poetsgate.com/ViewPoem.aspx?id=46300",""],[6127,"خوفُ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=198260",""],[6142,"بكر الردى فاجتاح في نكبائه","https://www.poetsgate.com/ViewPoem.aspx?id=155755",""],[6142,"مل بنا يا هديت ننتجع الحق","https://www.poetsgate.com/ViewPoem.aspx?id=155693",""],[6167,"عمارة الضباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85571&r=&rc=54",""],[1583,"عيناكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73061&r=&rc=18",""],[6237,"هوية الإنسان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77868&r=&rc=10",""],[6237,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77859&r=&rc=1",""],[463,"اتمنَّى والمنى جهدُ المقلُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60222&r=&rc=278",""]],"verses":[["وَهَوى بِتيجانِ الجَبابِرَةِ الأُلى","عَن كُلِّ مَطرورِ الغِرارِ صَقيلِ",0,"ل",1,0],["وَهْوَ يَسعى طالِباً لِل","عِلمِ وَالهَمُّ يُذِيبُهْ",1,"ب",2,0],["وهَوى كزَيْدِ بْنِ الحُسَينِ إِلى الثّرى","غِبَّ الثّراءِ مُحالِفَ الإعْدامِ",2,"م",1,0],["وهوى يضحك للطيف كما","يضحك الروض لعين الزائر",3,"ر",1,0],["وَهوَ يَحمى مَعي عَلى كُلِّ قِرنٍ","مِثلَما لِلنَسيبِ يَحمي النَسيبُ",4,"ب",1,0],["وَهَوى عَن سَماوَةِ العَرشِ مَلكٌ","لَم نُمَتَّع بِعَهدِهِ الذَهَبِيِّ",5,"ي",1,0],["وَهَوَيتَ مِن كَبِدِ السَما","ءِ وَهَكَذا مَهوى البُدورِ",6,"ر",1,0],["وَهْوَ يَأْبَى الجُمُودَ يَوْماً فَمَا لِلشَّرْ","قِ لا يَسْأَمُ الجُمُودَ قُرُونَا",7,"ن",2,0],["وَهَوَى بِكَ الوَادِي مَهَاوِيَهُ","وَرَنَوْتَ مُنْطَاداً مِنَ القِمَمِ",8,"م",1,0],["وهوى بانهزامه حَصن اقري","ط وأمسى قذىً على عين فيجه",9,"ج",2,0],["وهو يهنّي حزبه قائلاً","يا من عصى الله ومن قد كفر",10,"ر",1,0],["وهويته بالحسنِ منتقباً","فلي الهنا بمواضعِ النقب",11,"ب",1,0],["وهوىً يطالب علمه ونواله","فكأنما يعطي على الطلب الرشا",12,"ش",2,0],["وهوينا حلو القوام فنادى","لا عجيب حلاوة العسَّال",13,"ل",1,0],["وهويتها كالروض يزهو حسنها","ما شاءَ فهيَ كثيرة التَّلوين",14,"ن",1,0],["وهْو يَشفي الصدور من جنَف الحق","د ويُغْضي من مقلة زرقاءِ",15,"ا",2,0],["وَهْوَ يومُ المظَفَّرينَ بني العب","باس سَقيْاً لِظِلِّه الممدودِ",16,"د",1,0],["وهْو يحشو في حَشاها","أير فحلٍ كالحمار",17,"ر",1,0],["وهوى ليس ينقضي ما تثنَّتْ","كُثُبٌ في الغصون فوق الخصور",18,"ر",1,0],["وهو يرجِّي بيُمن وجهِك ذي ال","يمنِ قديماً أن يقطع الشَّركا",19,"ك",2,0],["وهوىً منه هواه كونُه","وطنيّاً لم يفارقْ وطنه",20,"ن",2,0],["وهو يخْتلُّ عن قَفيزِ دقيقٍ","وسُلافٍ مِنَ المُدامِة لَدْنِ",21,"ن",1,0],["وهو يحيى لولا النجاسةُ والجهْ","لُ وإن لم يَجِئْ به زكريُّ",22,"ي",1,0],["وَهَوى مِن مَكانِهِ وَهوَ يَشكو الأ","رضَ وَالشُهبَ وَالدُجى وَالسَماءَ",23,"ا",2,0],["وَهَوىً حَفِظتُ حَديثَهُ وَكَتَمتُهُ","فَوَجَدتُ دَمعي قَد رَواهُ مُسَلسَلا",24,"ل",2,0],["وهوَى لأنَّ اللَّيلَ أَسْمَعَهُ","أَناشيدَ الوُجُومْ",25,"م",1,0],["وهَوَى منَ الأَغْصانِ","ما بَيْنَ الزُّهورِ البَاسِرَهْ",26,"ه",1,0],["وَهَوىً هَوى بِدُموعِهِ فَتَبادَرَت","نَسَقاً يَطَأنَ تَجَلُّداً مَغلوبا",27,"ب",2,0],["وَهوَ يَغدو يَطلُبُ الأَع","مالَ في زِيِّ التِجّارِ",28,"ر",1,0],["وَهوَ يُنبيكَ عَن عَجائِبِ قَومٍ","لايُشابُ البَيانُ فيهِم بِلَبسِ",29,"س",1,0],["وَهَوىً كُلَّما جَرى عَنهُ دَمعٌ","يَئِسَ العاذِلونَ مِن إِقلاعي",30,"ع",2,0],["وَهَوىً مِنَ الأَهواءِ باتَ مُؤرِقي","فَكَأَنَّهُ سَقَمٌ مِنَ الأَسقامِ",31,"م",1,0],["وَهَوىً تُجَدِّدُهُ اللَيالي كُلَّما","قَدُمَت وَتَرجِعُهُ السِنونَ فَيَرجَعُ",32,"ع",1,0],["وهوىً يُرَدِّدُ في مَحاجرِ مُغرَمٍ","دمعاً يكونُ على التَّلدُّدِ شاهِدا",33,"د",2,0],["وَهَوى إِلَيكَ العِذقُ ثُمَّ رَدَدتَهُ","في نَخلَةٍ تُزهى بِهِ وَتُزانُ",34,"ن",1,0],["وهو يرمي قوائمَ الأعصم الضَّر","ب وَيَلْوي قَوادمَ المَضْرحيِّ",35,"ي",1,0],["وَهَوى كَما يَهوي أَتِيٌّ مُزبِدٌ","رَجَمَت بِهِ بَعضَ التِلاعِ تِلالُ",36,"ل",1,0],["وهوى اللّواء مُعفَّراً وتحطَّمت","حولَ اللّواءِ أسِنّةٌ ونصالُ",37,"ل",1,0],["وَهْوَ يُطْرِيهِ في غُرورٍ وَيَسْقِي","هِ نُفُوسَ الكُماةِ ظَنّاً وَزَعْما",38,"م",2,0],["وهو يُخفِي لك ما لا ينقضي","من هوىً صافٍ وشوقٍ وحنينْ",39,"ن",1,0],["وهَوى أبو جهلٍ ونَوفَلُ وارْعَوى","بعدَ اللَّجاج الفاحشُ المتوقِّح",40,"ح",1,0],["وَهْوَ يدعو إلى الإِلهِ وَإن شق","قَ عليه كفرٌ به وَازدِراءُ",41,"ا",2,0],["وَهْوَ يقولُ افْسَحوا لِمُحْتَسِبٍ","قد جاءكم مِنْ دِمَشْقَ في عُلْبَهْ",42,"ب",2,0],["وَهَوِيَتَها فَرَأَيتَ خُلَّةَ غادِرٍ","ورَضيتَ أَنَّكَ في وِصالِكَ تُشرَكُ",43,"ك",1,0],["وهَوى الغادةِ عَمري عادةً","يَجْلُبُ الشّيبَ إلى الشّابِ الأُحَي",44,"ي",1,0],["وهو يهتز للمعاصي كما يه","تزُّ في زرقة الصباح السرير",45,"ر",1,0],["وَهوى إليه طاعناً في ظهره","بسنان رمح لان كالثعبان",46,"ن",1,0],["وهوىً للوطن الحر الذي","خرَّ في حومته بعض ذماءْ",47,"ا",2,0],["وهو يستطيعُ أن يُجدَّكِ حسنا","إحفظي لا أصابك النسيانُ",48,"ن",1,0],["وهوى وفي شفتيْهِ بسمةُ ظافرٍ","أوْدى وتمَّ على يديهِ الثارُ",49,"ر",1,0],["وهو يحني للبحر شاحب وجهِ","بينما يندبُ الحياة اعتسافا",50,"ف",2,0],["وهوى الجناحُ فلا الرياحُ خوافقٌ","فيه ولا الأرواحُ طوعَ عِنانِ",51,"ن",1,0],["وهو يُسمَّى أعضَباً فكُلما","ضُمَّ إليهِ العَصبُ سُمي أَقْصما",52,"م",2,0],["وهو يغلي غليان المرجل","قال لم ينكب بهم مثلي ولم",53,"م",1,0],["وَهوَ يندي عِرقاً من شمَّهُ","قالَ هذا ماءُ وَردٍ لا عَرَق",54,"ق",1,0],["وَهْوَ يَعْدُو لاَ الرَّأْسُ مَالَ مِنَ الأَيْنِ","وَلا قَلْبُهُ شَكَا خَفَقَانَهْ",55,"ن",2,0],["وهوى جثة على الذروة الشماء","في حضن وهجها المستطير",56,"ر",1,0],["وهوْ يدري مَنْ سَيردِي سهمُهُ","ومتى يرمي وفي أيِّ اتجاهْ؟",57,"ا",2,0],["وهوى الطائر الكسير ودوّى","موكب الرعب ملأه وتلاحى",58,"ح",2,0],["وهوى يعزف احتراقي ويشدو","فاعيد الصدى ، وأحسو الرمادا",59,"د",2,0],["وهو يلهو لهو الشجيّ ويمضي","في جنون الهوى يعرّي القيانا",60,"ن",2,0],["وهو يسقيها ويظمى حولها","ويغذّيها ولم يملك طعاما",61,"م",2,0],["وهوى وفي شفتيه بسمة ظافر","أودى ، وتمّ يكلّل مفرقيه الغار",62,"ر",1,0],["وَهْوَ يقولُ: افْسَحوا المُحْتَسِبِ","قد جاءكم مِنْ دِمَشْقَ في عُلْبَهْ",63,"ب",2,0],["وهو يَجزيْك بالجميلِ من الفِعْلِ","جميلاً من الثناء المنيف",64,"ف",1,0],["وهو يَحيي لولا النجاسة ُ والجهْ","لُ وإن لم يَجِىء به زكريُّ",65,"ي",1,0],["وهوى جثة على الذروة الشماء","في حضن وكره المهجور",66,"ر",1,0],["وهوى الدراهم إن تأصّ","ل علّة كهوى الموائد",67,"د",1,0],["وهوى بشيطاني القنوط","وأفق إلهامي تجهّم",68,"م",1,0],["وهوَ يرجوكِ مُصِرّاً ولقَد","أشهدَ اللَهِ على إصرارهِ",69,"ه",1,0],["وهو يعفو عن كثير","وهو يمحو كل وزر",70,"ر",1,0],["وهوى ليلى ببغداد هوى","من جواه الموقد النار اشتويت",71,"ت",1,0],["وَهوىً يعربِد في دمي","وَتنشّ في كَأسي دِماه",72,"ا",2,0],["وَهوُ يَدري أَنَّ الرُؤى أَيقَظَتهُ","مِن شُجونٍ إِلى شُجونٍ أُخرى",73,"ر",2,0],["وَهَوى يسترشفُ شهدَ لماك","فَذابَ بِثَغرِكَ عَسجدُهُ",74,"د",2,0],["وهو يعلو بالروح عن خطل الجس","م ويضفي عليه ثوب الضياء",75,"ا",2,0],["وهو يسمو عن الزمان وما قد","يقتضيه الزمان من أخطاء",75,"ا",2,0],["وهو يسري في وسيع","من رجاء مترام",76,"م",1,0],["وَهَوىً يُماطِلُ بِالقَضاءِ غَريمُهُ","وَصَبابَةٌ ما يَستَفيقُ غَرامُها",77,"م",3,0],["وَهوَ يَجلي وَكُلَّما غُضَّ عِندَ الن","ناسِ مِن قَدرِهِ فَمِنّي يُغَضُّ",78,"ض",1,0],["وهو يحب الصرار يفتقها","ويشتهي أن يجمش القطعا",79,"ع",2,0],["وهو يجلو مرآة قلبٍ معنّىً","بصفا الحب قابل الإنتعاش",80,"ش",1,0],["وَهوَ يَرجو جودَ الإِلَهِ وَما خَي","يَبَ حُسنَ الرَجاءِ فيهِ الكَريمُ",81,"م",1,0],["وَهوَ يَسمو مؤرّخاً","بَيرمُ الخامسُ الهُدى",82,"د",2,0],["وَهويت أسفل سافلين فَلَم تَكد","تهوي لمهواك الرجوم صوائبا",83,"ب",2,0],["وهو يشتار من ندى الفجر شهدا","ومن الليل أكؤسا من صاب",84,"ب",1,0],["وهو يوم أفديه بالروح إن عز","على العاشقين فيه الفداء",85,"ا",2,0],["وَهَوىً يُؤلّف بَينَ جِسمي وَالضَنى","وَجفاً يُفرّق بَينَ جَفني وَالكَرى",86,"ر",2,0],["وَهوَ يَشدو في تِلاوته","منهل العُشّاق مَورودُ",87,"د",1,0],["وَهَوى الآرام غالبه","وَهوَ لا يُصغي لِمَن عَتبا",88,"ب",2,0],["وهوىً للجودِ تَملَّكَهُ","فإلامَ يُطيلُ مُفَنّدِه",89,"د",2,0],["وَهْوَ يَفلِي شُعُثاً أَعرَافُهَا","شُخُصَ الأَبصارِ لِلوَحشِ نُظُرْ",90,"ر",1,0],["وَهَوَى القَلبِ الَّذِي أَعْجَبَهُ","صورَةٌ أَحسَنُ مَن لاثَ الخُمُرْ",91,"ر",1,0],["وهوَ يَدري أنَّ الذرائِعَ في الجو","دِ دروعٌ تبقي عَلى الأَعراضِ",92,"ض",1,0],["وهو يا طالب الغر","س أشجار بجنات",93,"ت",1,0],["وهو يشط الثوب في غفلة","قلت له قد زادت الشطة",94,"ه",1,0],["وهَوىً عُنِيتُ بِرعْيِ ذمَّتِهِ","فأضَاعَهُ المتلَوِّنُ الطَّرِفُ",95,"ف",1,0],["وهوى مربع لظمياءَ أقوى","تسحب المزن في مغانيه ذيلا",96,"ل",2,0],["وهو يَكُدُّ العيونَ منظَرُهُ","وهْيَ بذاكَ الجمالِ مُضْطَهَدَه",97,"د",2,0],["وهو يشدوهُمُ من الطّربِ الخا","رجِ عن حدّه الى الاضطرابِ",98,"ب",1,0],["وهو يفني السؤال إذ بمنخ السا","ئل سيبا كيما يجود ابتداء",99,"ا",2,0],["وهَوًى تقاصَرَ بالمُنى فأَطالَ بِي","هَمَّاً إِلَى قَلْبِي سَرى فَسَرى بي",100,"ب",2,0],["وهو يرقى علما بعد علم","لبلوغ القصد من هذا السفر",101,"ر",1,0],["وهوىً أهونُ ما يُسمَى الضنا","بمسيىءٍ بالإساءاتِ مُدِلّْ",102,"ل",1,0],["وهَوىً أطعت أميرَهُ في لذّةٍ","متبوعةٍ لم تَنجُ من تَبِعاتِها",103,"ت",3,0],["وهو يحيي العفاة إن شيمَ رفداً","ويميتُ العداةَ إن شام نصلا",104,"ل",2,0],["وهو يبكي بكاء مجنون ليلى","ساعة الإذن أو غداةَ الطعام",105,"م",1,0],["وَهوَ يَعلو.. يا جَولَة َالحَقِّ نَذرٌ","لِمآقي أطفالِنا أنْ تُجالي !",106,"ل",2,0],["وَهوَ يَومٌ إِن ناحَتِ الطَيرُ فيهِ","أَو بَكى الجَوُّ قَهقَهَ الخَرداذي",107,"ذ",2,0],["وهوًى يُثيرُ لكَ الغرامَ ونارُه","بين الربوعِ العذلُ والآثارُ",108,"ر",1,0],["وهو ينادي بلسان حاله","هذا جزا من كفر الصنائعا",109,"ع",2,0],["وهوى إلى مَطْوى الشّجاعِ فحازه","واِستلَّ مِن أَخياسه الضّرغاما",110,"م",2,0],["وهوَ يُهدِي إليك ما أنتَ تهوا","ه وما نحن في هواك نرومُ",111,"م",1,0],["وهوى بالطرف يحوي حورا","وغرام بالذي تحت القُبَيّ",112,"ي",1,0],["وهو يشتاق ونشتاق