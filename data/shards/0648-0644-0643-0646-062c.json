{"poems":[[110,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[79,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[90,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[90,"أما آن أن تنسى من القوم أضغان","https://www.aldiwan.net/poem44992.html","الطويل"],[53,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[31,"دنا البين من أروى فزالت حمولها","https://www.aldiwan.net/poem6159.html","الطويل"],[34,"أفق قد أفاق العاشقون وفارقوا","https://www.aldiwan.net/poem27784.html","الطويل"],[64,"أرى شغفي بطلاب العلى","https://www.aldiwan.net/poem52290.html","المتقارب"],[47,"وصلنا إلى التوديع غير مودع","https://www.aldiwan.net/poem65138.html","الطويل"],[47,"بمثل لقائها شفي الغليل","https://www.aldiwan.net/poem65600.html","الوافر"],[30,"ستبلغ مدحة غراء عني","https://www.aldiwan.net/poem5230.html","الوافر"],[2,"أمن آل ليلى عرفت الطلولا","https://www.aldiwan.net/poem25046.html","المتقارب"],[107,"أكان يزيد بأسك إذ تصاب","https://www.aldiwan.net/poem44210.html","الوافر"],[48,"أتت خنساء مكة كالثريا","https://www.aldiwan.net/poem23582.html","الوافر"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54723","الطويل"],[2,"أمِنْ آلِ لَيلى عَرَفْتَ الطُّلُولا","https://www.poetsgate.com/ViewPoem.aspx?id=5263",""],[136,"ستهجى والهجاء له تليق","https://www.aldiwan.net/poem54788.html","الوافر"],[164,"رمتني بسهم خلتني منه ناجيا","https://www.aldiwan.net/poem58843.html","الطويل"],[164,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[211,"فأبلغ لديك بني مالك","https://www.aldiwan.net/poem27958.html","المتقارب"],[226,"أتستقبل الدهر مستبشرا","https://www.aldiwan.net/poem55293.html","المتقارب"],[227,"دعاك الهوى فاجب من دعاك","https://www.aldiwan.net/poem55466.html","المتقارب"],[285,"أفيض دموع أم سيول تموج","https://www.aldiwan.net/poem60699.html","الطويل"],[285,"متى أنا طاعن قلب الفجاج","https://www.aldiwan.net/poem60722.html","الوافر"],[369,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[408,"دعوت إلى السلوان غير سميع","https://www.aldiwan.net/poem46744.html","الطويل"],[463,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[463,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[469,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[469,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[470,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[484,"سماط أمد إلى الظرفا","https://www.aldiwan.net/poem37187.html","المتقارب"],[574,"ونار دعوت المعتفين بضوئها","https://www.aldiwan.net/poem52006.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38418","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70743","الطويل"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67739","المتقارب"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115901","الهزج"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71046","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71079","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137937",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53204","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109765","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28549","المتقارب"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120657","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102557","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76076","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109820","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204505","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118929","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66477","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135446","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77042","الطويل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44911","الطويل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93747","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94812","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94648","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58177","الطويل"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139873",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120528","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4927,"دموع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29947",""],[5081,"سَلَامُ اللهِ يَا حُلْمَاً","https://www.poetsgate.com/ViewPoem.aspx?id=185620",""],[5185,"نبوءة الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=72852",""],[5186,"تسآءلني فتاة الحي ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=156495",""],[5338,"أخادع نفسي بالأماني الكواذب","https://www.poetsgate.com/ViewPoem.aspx?id=187713",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5413,"أفي الله شك فاطر السموات والأرض!!","https://www.poetsgate.com/ViewPoem.aspx?id=201589",""],[5638,"عيون.....","https://www.poetsgate.com/ViewPoem.aspx?id=198255",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""]],"verses":[["ولكن جلوسا يقذف الدمع جامدا","على الكبد المقذوف بالطست ذائبه",0,"ب",2,0],["ولكِنْ جَنَبْتَ الجُرْدَ قُبّاً بُطونُها","فأقْبَلْنَ أسْراباً كمِثْلِ القَطا تَرْدي",1,"د",2,0],["وَلَكِنْ جَفَتْ فَانْدَكَّ مَعْقِلَ صَبْرِهِ","وَأَعْياهُ دَفْعُ اليَأْسِ عَنْهُ فَسَلَّمَا",2,"م",2,0],["ولكن جرت نُكب الرياح بأرضهم","فجرَّت عليها كلكل الحِجج الشهب",3,"ب",1,0],["ولكن جهل الجاهلين طَحا بهم","إلى كل قول لم يؤيّده برهان",4,"ن",1,0],["ولكنْ جَمَّ فيك مُشاركُوهُ","وإن أصبحْتَ بينهُمُ تَريكا",5,"ك",2,0],["وَلَكِن جَليلُ الرَأيِ في كُلِّ مَوطِنٍ","وَأَكرَمُ أَخلاقِ الرِجالِ جَليلُها",6,"ل",3,0],["وَلَكِن جَعَلتُ اللَحظَ بَيني وَبَينُها","رَسولاً فَأَدّى ما تَجُنَّ الضَمائِرُ",7,"ر",1,0],["ولكن جرتْ عادةُ الجَدِّ أنْ","يكايدني بالجُفاةِ الطَّغامِ",8,"م",1,0],["وَلَكِن جَرى مِنهُ قَليلٌ مُصَرَّدٌ","وَلَم يَكُ تَصريدُ الدُموعِ بِمُقنِعِ",9,"ع",1,0],["وَلَكِن جاهُ ذي خَطَرٍ شَريفٍ","أَراهُ وَهوَ مِن جودٍ بَديلُ",10,"ل",1,0],["وَلَكِن جالَدوا مَلَكاً كِراماً","هُمُ فَضّوا القَبائِلَ يَومَ بَدرِ",11,"ر",1,0],["وَلَكِنَّ جَلداً جَميعَ السِلا","حِ لَيلَةَ ذَلِكَ عِضّاً بَسيلا",12,"ل",2,0],["ولكن جَلَّ منزلةً وقدراً","فبرَّ رجالُهُ ووفَى الصّحاب",13,"ب",1,0],["وَلَكِن جاءَتِ الجَمَراتِ تَرمي","وَأَبصارُ الغُواةِ إِلى يَدَيها",14,"ي",3,0],["وَلكِن جَزاكَ اللَهُ حَيَّاً وَهالِكاً","عَلى كُلِّ حالٍ خيرَ ما كانَ جازيا",15,"ي",2,0],["وَلَكِنَّ جِرْذَانَ الثُّغُورِ رَمَيْنَنِي","فأَكْرَمْتُ نَفْسِى أَن تُرِيقَ دِماءَهَا",16,"ا",3,0],["وَلكِنَّ جُهْدِي دُونَ أَدْنَى رَغَائِبِي","فَكُنْ لِخَيَالِي أَيُّهَا الشِّعْرُ مُسْعِدَا",17,"د",2,0],["ولكنَّ جلداً، جميعَ السلا","حِ، ليلة َ ذلكَ، صدقاً بسيلا",18,"ل",2,0],["ولَكِن جَرَّكَ الجُدَرِىٌّ عني","بِحَيثُ تَبِيضُ بِالقُنَنِ الأُنُوقُ",19,"ق",1,0],["ولكن جرى حكم القضاء بما جرى","ففتّت أكباداً وأجرى مآقيا",20,"ي",2,0],["ولكن جِهارا يأخذ الحق عنوةً","وما احتال في أخذ الحقوق جليدُ",21,"د",1,0],["وَلَكِنَّ جَمعاً كَجِذلِ الحِكا","كِ فيهِ المُقَنَّعُ وَالحُسَّرُ",22,"ر",1,0],["ولكن جلائل أعماله","تسامى به لرفيع الذرى",23,"ر",2,0],["ولكن جسمي أسير السقام","وسل عن فؤادي وقلبي هواك",24,"ك",1,0],["وَلكِنْ جُنُونٌ مِنْ زَمانٍ مُسَفَّهٍ","وَدَهْرٌ جَهُولٌ أَوْلَقُ الرَّأْيِ أَهْوَجُ",25,"ج",1,0],["وَلكِنْ جَلَّ عَنْ فَنَدٍ وَلَوْمٍ","غَرامِي بِالْمَحامِدِ وَالْتِهاجِي",26,"ج",2,0],["ولكنْ جَلا فخْرُ الرّئاسةِ ناظِري","بغُرّةِ وجْهٍ كُلُّ أُفْقٍ بهِ أَضا",27,"ض",2,0],["ولكنْ جفونٌ يومَ نَعمانً فُتَّرٌ","صوارمُها لا تُتَّقى بدروعِ",28,"ع",1,0],["ولكن جاد محلولَ العزالي","إذا بدأ الحيا أدلت عصامَهْ",29,"م",2,0],["ولكن جفوةٌ لم تُنسِ عهداً","ولم تجُز الدلالَ إلى الملالِ",30,"ل",1,0],["ولكن جلا لك حقٌ مبينٌ","وهيهات أن يبطل الحقَّ جحد",31,"د",1,0],["ولكن جلبت الشكر والشكر ونافق","بناديه في سوق من الجود قائم",32,"م",1,0],["ولكنْ جثَتْ وجفونُ الحسين","تَرفُّ على ذلك المَجثَمِ",33,"م",1,0],["ولكن جنحت إلى خلوة","فأحضرت زبدة ما عرفا",34,"ف",2,0],["ولكن جعلناها كخير نسائنا","فَجاءَت بهم بيضاً غطارفة زهرا",35,"ر",2,0],["وَلَكِن جَفاني وَالغَرامُ مُدامَةٌ","تُحدّثني وَهما بِأنّيَ لا أجفى",36,"ف",2,0],["ولكن جراك اللَّه طول سلامةٍ","على رغم مَنْ عاداك في الحق واعتدى",37,"د",2,0],["وَلَكِنَّ جَمْعَ العَذَارَى الحِسَانِ","عَنَاءٌ شَدِيدٌ إذَا الْمَرْءُ شَابَا",38,"ب",2,0],["ولكن جَلَّ علمُ الغي","بِ عن مقدِرةِ العبدِ",39,"د",1,0],["ولكنْ جرَى شَرْطُ السِّجلِّ بأَنَّه","له منه مفتاحٌ ومنه خِتامُ",40,"م",1,0],["ولكنْ جَزَيْتُ الضِّدَّ بالصاع أَصْوُعاً","وأَحْلَلْتُ تدميري به ونَكالي",41,"ل",2,0],["ولكن جود كقك فوق هذا","ونيلي مثل هذا من عطاكا",42,"ك",2,0],["ولكن جيوش الروس كانت تأهبت","وصارت على استئنافها الحرب قادره",43,"ر",2,0],["ولكن جاده لله لطف","مديد الظلّ يؤذن بالدوام",44,"م",1,0],["ولكن جني ذنباً يؤدي إلى الترك","علمتُ يقينا حينما عني انثنى",45,"ن",2,0],["وَلَكِن جَرى سابِقاً في الرِّهانِ","وَضَلّوا عَلى الأَثَرِ المَهيَعِ",46,"ع",1,0],["ولكن جَمَعتَ المالَ حطماً لوارثِ","شددت على الفاني وأحسِن به يدا",47,"د",2,0],["ولكن جفاء الخل عندي يسوءني","وإني على ما ساءني لم يزل صبري",48,"ر",2,0],["وَلكن جَهِلنا فاستراحَت نُفُوسُنا","وما تلكَ إِلا راحةٌ تَعقبُ الحُزنا",49,"ن",2,0],["ولكن جارت الاقدار فيهم","ففي ابصارهم منها ازورار",50,"ر",1,0],["ولكن جسمي ليس يقنع إن يفز","بلذة نفسي فهو للنفس جاحد",51,"د",1,0],["ولكن جرى دمعي ونمَّ بما جرى","فتحقيق جار عند جار وسائلِ",52,"ل",1,0],["ولكن جاوزوا في الحسن حدّاً","فمنهم ضوءها الشمس اكتسابا",53,"ب",2,0],["ولكن جلسنا وسارت قلوب","لتشييعكم وتوديعكم",54,"م",1,0],["ولكن جيش العدى فرحاً","تكثف من حوله وابتهج",55,"ج",1,0],["وَلكِن جَنى ذَنباً يَؤولُ إِلى التَركِ","يَرومُ اِختِياري بِالغَرامِ تَفَتُّنا",56,"ن",2,0],["وَلَكِن جَبانٌ خائرُ العَزمِ فاترٌ","وَلَن يَبلغَ المَجدَ المؤثَّلَ فاترُ",57,"ر",1,0],["وَلَكنّ جَمعاً ضل في الناس سَعيهم","فَزَلوا وَعُقبى الظالمين كُروب",58,"ب",1,0],["ولكن جرَّني قلبٌ مشوقٌ","كقَود الحُرّ شطرَ بني الإماره",59,"ر",2,0],["ولكن جنى ذنباً يُؤَدّي إلى التركِ","فكنّا بحرصٍ لا نُغمّض عيننا",60,"ن",2,0],["ولكن جفّت الأقْلامُ","والأقْدارُ كيف تَرضى",61,"ر",3,0],["ولكن جزاءُ المتقى جنةٌ له","له عيشة بين الأرائك راضيةْ",62,"ي",2,0],["ولكن جعلت الوهم بيني وبينها","رسولاً فادي ما تُكن الضمائر",63,"ر",1,0],["ولكن جاحد النعمى مليم","وفي تاديبه احراز اجر",64,"ر",1,0],["وَلَكِن جَرى المَقدورُ فَهوَ عَلى عَمىً","عَنِ العَينِ إِذ حالَت هُناكَ مَوانِعُ",65,"ع",1,0],["وَلَكِنَّ جُمْهُوْرَ الْغَرَاْمِ مُخَدَّرٌ","بِبَحْرِ دُمُوْعِ الْعَيْنِº وَالْهَجْرِ يَسْبَحُ",66,"ح",1,0],["وَلَكِنْ جَاءَ مَسْعَاكُمْ","فَلَمْ تَنْجَحْ مَسَاعِيهَا",67,"ي",3,0],["ولكنّ جدولك الصب تأبى","خطاه التحرك بين الشعاب",68,"ب",1,0],["ولكن جد ما لم يستجده","عفاف هدى ولم يك في حساب",69,"ب",1,0],["وَلكنّ جَوْرَ النّاسِ أَدْمَىٰ مَحَاجِري","بِغَدْرِ فَتَىً يُنْمىٰ إِلَىٰ آلِ غَالِبِ",70,"ب",1,0],["ولكن جرت منهم أموراً فعوقبوا","على ما جرى منهم بلا واسع العذر",71,"ر",1,0],["ولكنَّ جهلَ الملحدين بربهمْ","يُقَوِّلُهُمْ ما خالف العقل والنقلا",72,"ل",2,0],["وَلَكِنَّ جَفْنَيْهَا كَمِثْلِ سَحَابَةٍ","فَتَنْهَلُ مِنْ دِفْءٍ وَنُورٌ تَبَسَّمَا",73,"م",2,0],["ولكنْ جلّهم حجّوا لأمرٍ","خيالٌ كلُّ سعيهمو وهذرُ",74,"ر",1,0]]}