5,"مآثر","https://www.poetsgate.com/ViewPoem.aspx?id=100739",""],[5216,"مجنون","https://www.poetsgate.com/ViewPoem.aspx?id=187649",""],[5216,"أحلامُ قَيْس","https://www.poetsgate.com/ViewPoem.aspx?id=187655",""],[5273,"جريمة","https://www.poetsgate.com/ViewPoem.aspx?id=176205",""],[5392,"..للخيوط ذهولُ","https://www.poetsgate.com/ViewPoem.aspx?id=11293",""],[3912,"كفى حَزَنًا بالهائم الصبِّ أن يرى","https://www.poetsgate.com/ViewPoem.aspx?id=136749",""],[5493,"طريق الشوك","https://www.poetsgate.com/ViewPoem.aspx?id=205584",""],[5533,"رثاءُ صَديق","https://www.poetsgate.com/ViewPoem.aspx?id=176667",""],[5776,"هامشٌ من مسوّدات الغيب على مقعدٍ خشبيّ","https://www.poetsgate.com/ViewPoem.aspx?id=199406",""],[5950,"ياسيد الأحباب","https://www.poetsgate.com/ViewPoem.aspx?id=126263",""],[5956,"حتى المَكيف قد أقام حِدادا","https://www.poetsgate.com/ViewPoem.aspx?id=192400",""],[5956,"رحل الرئيسُ الطاهرُ المِضيافُ","https://www.poetsgate.com/ViewPoem.aspx?id=193981",""],[5957,"كأن الحب ديدنهُ الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=208526",""],[6070,"نَصَبْتَ شباكَ قَلْبِكَ في هواها","https://www.poetsgate.com/ViewPoem.aspx?id=188981",""],[6124,"نور العشق","https://www.poetsgate.com/ViewPoem.aspx?id=174662",""],[231,"العود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79153&r=&rc=27",""],[2638,"من بين الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87872&r=&rc=29",""]],"verses":[["كأنّ الحَبابَ المُسْتَطيرَ إذا طَفا","لآلِئُ إلا أنّها لم تُثَقَّبِ",0,"ب",1,0],["كأنّ الحُسامَ المَشرَفيَّ شَريكُهُ","إذا سَنَحَتْ أُكْرومَةٌ في المَناقِبِ",1,"ب",1,0],["كَأَنَّ الحَصى مِن خَلفِها وَأَمامِه","إِذا نَجَلَتهُ رِجلُها خَذفُ أَعسَرا",2,"ر",2,0],["كَأَنَّ الحَمامَ الوُرقَ في الدارِ جَثَّمَت","عَلى خَرِقٍ بَينَ الأَثافي جَوازِلُه",3,"ل",2,0],["كَأَنَّ الحدُاةَ اِستَوفَضوِا أَخدَرِيّة","مُوَشَّحَةَ الأَقرابِ سُمَر السَنابِكِ",4,"ك",1,0],["كان الحديدُ لباسهم وشعارهم","واليوم لم تلبسه إلاّ الأرجُلُ",5,"ل",1,0],["كَأَنَّ الحِجا وَالصَونُ وَالعَقلُ وَالتُقى","لَدَيَّ لِرَبّاتِ الخُدورِ ضَرائِرُ",6,"ر",1,0],["كأن الحبَّ دائرةٌ بقلبي","فحيثُ الانتهاء الابتداء",7,"ا",2,0],["كانَ الحمامُ بها يغرِّد فرحةً","فاليوم تغريد الحمام نواح",8,"ح",1,0],["كان الحجاب يسومها","خسفاً ويرهقها عذابا",9,"ب",2,0],["كَأَنَّ الحُزنَ مَشغوفٌ بِقَلبي","فَساعَةَ هَجرِها يَجِدُ الوِصالا",10,"ل",2,0],["كأنّ الحطيمَ على بابهِ","وزَمزَمَ والبيتَ في دارهِ",11,"ر",2,0],["كأنَّ الحَبابَ المُستديرَ قِلادَةٌ","عليه وتَوريدُ المُدامَةِ يَلْمَقُ",12,"ق",1,0],["كَأَنَّ الحُماةَ المُشفِقينَ عَلَيكَ قَد","غَدَوا بِكَ أَو راحوا رَواحاً فَأَسرَعوا",13,"ع",3,0],["كأن الحب تيار","سرى ما بين جسمينا",14,"ن",2,0],["كأنّ ألحانَهُ الفصيحةَ منْ","صريرِ بابِ الجنانِ مُكْتَسَبَه",15,"ب",2,0],["كأنّ الحبابَ لها جُمّةٌ","معممةٌ رأسَها بالمشيبِ",16,"ب",1,0],["كَأَنَّ الحَشا مِن تَحتِهِ عَلِقَت بِهِ","يَدٌ ذاتُ أَظفارٍ فَتَدمى كُلومُها",17,"م",3,0],["كأنّ الحياة كلامٌ يقال","وأحدوثةٌ من فُضولِ السَّمَرْ",18,"ر",1,0],["كأنَّ الحقَّ مَقْتَلُ كلِّ نفسٍ","فمن يَضرِبْهُ لا يُوقَ المنايا",19,"ا",3,0],["كَأَنَّ الحَشا مِن ذِكرِ سَلمى إِذا اِعتَرى","جَناحٌ حَدَتهُ الجِربِياءُ لَموعُ",20,"ع",1,0],["كأنَّ الحبُّ فيهِ صُبَّ","من قرنٍ إلى قدم",21,"م",1,0],["كَأَنَّ الحَمامَ الوُرقَ في الدارِ وُقَّعاً","مَآتِمُ ثَكلى مِن بَواكٍ وَعُوَّدِ",22,"د",1,0],["كأن الحزن مشغوفٌ بقلبي","فساعة هجرها تجد الوصالا",23,"ل",2,0],["كانَ الحُسامَ فَما مَضى حَتّى مَضى","وَشَجا مُضِيٌّ مِنهُ بَعدَ مَضاءِ",24,"ا",2,0],["كَأَنَّ الحَصى مِن خَلفِها وَأَمامِها","إِذا نَجَلَتهُ رِجلُها خَذفُ أَعسَرا",25,"ر",2,0],["كَأَنَّ الْحَبَابَ عَلَى وَجْهِها","وُعُودٌ حَصَلْنَ وَلَمْ تَحْصُلِ",26,"ل",1,0],["كأنّ الحَصَى مِنْ خَلفِهَا وَأمامِهَا","إذا نجَلَته رِحلُها حَذْفُ أعسَرَا",27,"ر",2,0],["كأنَّ الحربَ كانت ذاتَ عقلٍ","صحيح لَم يحلَّ بِهِ السِّقامُ",28,"م",1,0],["كَأَنَّ الحُداةَ وَالمُشايِعَ وَسطَهُ","وَعوذاً مَطافيلاً بِأَمعَزَ مُشرِقِ",29,"ق",1,0],["كأن الحزن مكتوب علينا","فلا نرتاح يوماً من ملمهْ",30,"ه",1,0],["كَأَنَّ الحَميمَ عَلى جِسمِها","إِذا اِغتَرَفَتهُ بِأَطماسِها",31,"ه",2,1],["كأنَّ الحمامَ الوُرقَ حاد غصونه","ليُدركَهم والبانُ كيف يزولُ",32,"ل",1,0],["كأنّ الحُبَى يومَ تَعقادِها","عليه على يذبُلٍ أو حِراءِ",33,"ا",2,0],["كأنَّ الحياءَ انهلَّ في وجَناته","فكانَ لها ماءً وكانت له غُدْرا",34,"ر",2,0],["كأنَّ الحواجبَ قوسٌ فما","تحركَ إلا جلتْ عن قتيلْ",35,"ل",1,0],["كأن الحلي يبرقُ في يديهِ","لتكمدَ من تلألئهِ النحورُ",36,"ر",1,0],["كأن الحسن ذاب بكل لونٍ","نراه وفي المياه وفي الطريق",37,"ق",1,0],["كان الحديد سياجاً أستظلّ به","ظهراً وكان نديمي عند أسحاري",38,"ي",1,0],["كأنّ الحميّا باحمرار خدودها","تدير على العشّاق صهباء خمرة",39,"ه",1,0],["كأن الحيا منه اغار على ندي","يد الأمجد المولى الأغر كريمي",40,"م",2,0],["كأنَّ الحمى ورد وصحبيَ دونه","يجيلون فيه الطرفَ طلّح لوب",41,"ب",1,0],["كأن الحسانَ الغيدَ يخطرنَ بيننا","ملائكةُ الرحمن في ليلةِ القدر",42,"ر",1,0],["كأن الحسن يعشقه قديماً","فنقطه بدينار وحبه",43,"ه",1,0],["كأن الحشا طيرٌ وكاسرُ جفنه","تصيدهُ من هدبه بمخالب",44,"ب",1,0],["كانَ الحُسامُ يَمانِيَّ الهَوى مَعَنا","فَما أَضَرَّ بِنا أَن أَصفَقَت مُضَرُ",45,"ر",1,0],["كانَ الحِمامُ أَمامَ الصَفوِ أَرفَقَ بي","مِنَ الحَياةِ الَّتي أَفضَت إِلى الكَدَرِ",46,"ر",1,0],["كان الحزينُ ينادي كل زاويةٍ","في الدار يرسلُ فيها طيفَ ولهانِ",47,"ن",1,0],["كأنَّ الحِبْرَ في قلمي دموعٌ","على وجناتِ أوراقي تَسيحُ",48,"ح",1,0],["كان الحديث بأرضكم","مستغرباً واللّه جدا",49,"د",2,0],["كأنَّ الحق يؤخذ بالتدنىِّ","كأنَّ المجدَ يورثهٌ المسُّف",50,"ف",1,0],["كأنَّ الحقَّ لم يظهرْ لديهم","ولم يفزَعْ لنُوقِ الدِّينِ حَادِ",51,"د",1,0],["كانَ الحُصَينُ يُرَجِّي أَن يَفوزَ بِها","حَتّى أَخَذتَ عَلَيهِ بِالأَخاديدِ",52,"د",1,0],["كانَ الحُسين إماماً والشريعة حضاً","في النُسكِ والزهدِ يحكي عبادةَ الثقلين",53,"ن",1,0],["كأن الحجاز وقد أوطآ","محيا ثراه خفاف النجب",54,"ب",1,0],["كأنَّ الحديدَ على متنهِ","لُجينٌ بشمس الضُّحى مُذهبُ",55,"ب",1,0],["كَأَنَّ الحَبابَ المُستَديرَ بِطَوقِها","كَواكِبُ دُرٍّ في سَماءِ عَقيقِ",56,"ق",1,0],["كأن الحمى والملك والشعب بينهم","متاع مشاع أو تراث مقسم",57,"م",1,0],["كانَ الحِمار جاء مِن الغيط","وَالحمل مِن فَوقِ راسهُ",58,"ه",1,0],["كأنَّ الحَشا من لاعِجِ البينِ مُخبِرٌ","بأن قد جَفاهُ ذُو المَعالي وجارُها",59,"ر",3,0],["كأن الحمام خلال الكمام","يرجفن من كل أوب صدا",60,"د",2,1],["كأن الحسن أسمل كل سر","إليك فصرت موضوع السؤال",61,"ل",1,0],["كأن ألحاظه أشفاه في يده","وقلبي الجلد فهو الدهر ينخسه",62,"ه",1,0],["كان الحبيبُ علىَّ فيه مُقبِلاً","وسعادةُ المشغوفِ فى إقبالِهِ",63,"ل",2,0],["كأن ألحاظها في كيد عاشقها","أسياف مخلص في أرحال مجترم",64,"م",1,0],["كأن الحسينيين عند اخترامه","وجوه خلت من أعين وحواجب",65,"ب",1,0],["كَأَنَّ الحِسانَ الغِيدَ جُزنَ بِأَرضِها","فَأَلقَت عَلَيها كُلُّ غانِيَةٍ عِقدا",66,"د",2,0],["كَأَنَّ الحَيّ فارَقَه فَشابَت","لِفُرقَتِهُ مِنَ النورِ القُنانُ",67,"ن",1,0],["كَأَنَّ الحَمامَ الوُرقَ حادٍ يَشُوقُهُ","تَرَنُّمُهُ وَالدارُ حِبُّ يُواصِلُه",68,"ل",2,0],["كأن الحجار الصلبيّة قدرت","فجاءت لها وفقاً حوافره الحفر",69,"ر",1,0],["كَأَن الحوت حينَ بَدا غَريقٌ","بِآذيٍّ مِن الأَمواج طام",70,"م",1,0],["كان الحداد البيض تخضب بالدما","لعينيه ثغر بارد الظلم اشنب",71,"ب",1,0],["كان الحسين وقد مضى","فليهنها نيل المرادي",72,"د",2,0],["كأن الحيا قد كان سَفْراً مهنئاً","فمذ شارف الشهباء حطَّت رواحله",73,"ل",2,0],["كأنَّ الحُرًّ كانَ له شنيئاً","وليسَ سوايَ حرٌ في الأنام",74,"م",1,0],["كان الحسان لبسن الحدادَ","وأسفرنَ عن كل وجهٍ أضاءَ",75,"ا",2,0],["كأن الحسن خط عليه سطراً","فطرز فيه صفحته وحبر",76,"ر",1,0],["كأن الحسن أجرى فيه خيل ال","شباب فثار في خديه عثير",76,"ر",1,0],["كانَ الحَياء لِذاتِ الخِدر مَنقبَةً","وَالصَون مِن شَأنِها أَيام تَحتجب",77,"ب",1,0],["كان الحريص على الولاء وكفه","بالجود كانت تخجل الاقمارا",78,"ر",2,0],["كَأَنَّ الحشا لِلذكرِ أَوتارُ قَينَةٍ","تَهزُّ بِعُنّابٍ عَلى الضَّربِ دائِمِ",79,"م",1,0],["كَأَنَّ الحَشا وَالقَلبَ عِندَ تَذَكُّري","لَهُم وَرقاتٌ في قَضيبٍ مُزَعزَعِ",80,"ع",1,0],["كان الحب ارضعه لبانا","وعللك وقد نسى الفطاما",81,"م",2,0],["كان الحاظ من أهواه تمزجها","وكلما غبت عن جي تناجيني",82,"ن",2,0],["كأن الحياة هي الحرب بين","نفوس وبين جسوم تثار",83,"ر",1,0],["كأن الحياة سموٌّ به","وضيعُ الطبيعة يغدو رفيعا",84,"ع",2,0],["كأنّ الحباب على كأسها","عناقيدُها وهي بين الكروم",85,"م",1,0],["كأنّ الحشا منّي عدُوُّ لحاظه","يُقارعُ منها بالسّهام وينضلُ",86,"ل",1,0],["كَأَنَّ الحَبلَ لَم يوصَل تِماماً","إِذا أنقَطَع الخَليلُ مِنَ الخَليلِ",87,"ل",1,0],["كَأَنَّ الحَصا حينَ يَترُكنَهُ","رَضيخُ نَدى القَسبِ بَينَ الصّلاءِ",88,"ا",2,0],["كأن الحيا والمزن والروض عاطراً","ودموع وأجفانٌ وخدٌ مورد",89,"د",1,0],["كأنّ الحِمى لمّا استهلّتْ مدامِعي","كميٌّ على أعْطافِهِ يقطُرُ الدَّمُ",90,"م",1,0],["كان الحبيبَ وقد تأَرَّخ حبُّهُ","راجي رِثِ المُلك المعدَّ تكرُّما",91,"م",2,0],["كَأَنّ الحَباب المزدهي فَوقَ كَأسها","أَزاهرُ رَوضٍ أَبرزَتها خَمائله",92,"ل",2,0],["كأنّ الحسان يملن القدود","غصون بأثمارها ينّع",93,"ع",1,0],["كَأَنَّ الحَبابَ عَلى رَأسِها","جَواهِرُ قَدْ كُلِّلَتْ فِي عَصائِبْ",94,"ب",1,0],["كأنَّ الحَباب بها لؤلوءٌ","على ذهبٍ ذائبٍ مسجَمِ",95,"م",1,0],["كأنَّ الحبيب بها طائفاً","علينا ونحن ولم نظلمِ",95,"م",1,0],["كأنّ الحُدوجَ الرائحات عشيةً","مواقرُ نخلٍ من شمائلَ مبسرِ",96,"ر",1,0],["كأن الحميا في الزجاجة شعلة","متى اخمدت بالماء زادت تاججا",97,"ج",2,0],["كانَ الحُسَين لَنا إذا","وَقَفَ الغمام عن النُّزول",98,"ل",1,0],["كأن الحسين المجتبى في لقائه","إذا أمه راج وقد حفه بشر",99,"ر",1,0],["كأنَّ الحَبابَ قُلِّدَت","هُ دُرٌّ يُفصِّلُ عِقيانَها",100,"ن",3,0],["كأن الحلم حتى الحلم حرامٍ ما تملكني","تركني بس اتمنى واعايش ظلمة ارواحه",101,"ح",2,0],["كان الحزن يمشي بوسط المدينه","بالناس ... لمبات الشوارع ... والأسمنت",102,"ت",1,1],["كان الحزن ....؟ قلت الله الله بعينه","كنت اعرفه من يوم ماعرف وش كنت",102,"ت",1,0],["كانَ الحقيقةَ قبلَ النَفخِ ، قامَ بها","سرُّ الوجودِ ، فلا عهداً لناسيهِ",103,"ي",2,0],["كان الحب اللي بينا يضربه الامثال","واليوم صرنا حكاوي على كل لسان",104,"ن",1,1],["كَأَنَِّ الْحُبَّ نِيْرَاْنٌ تَلَظَّىْ","بِأَضْلاْعِ الْمُحِبِّº لَهَاْ ضِرَاْمُ",105,"م",1,0],["كان الحنين إلى الماضي يؤرقنا","واليوم نبكي على الماضي ويبكينا",106,"ن",2,0],["كأن الحرف وعطور الدخون اشراق","أهازيج البحور وحفلة اوشاحي",107,"ح",2,0],["كأنَّ الحبَّ بحرٌ نحنُ فيهِ","فما ندري بأيِّ الأرضِ نرسو",108,"س",2,0],["كأنَّ الحبَّ عِربيدٌ","إلى الأصنامِ يَبتهلُ",109,"ل",1,0]