s://www.poetsgate.com/ViewPoem.aspx?id=34696",""],[5464,"كُتِبَ الوفاءُ عليَّ دون إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=125405",""],[5493,"فيمَ السؤالُ","https://www.poetsgate.com/ViewPoem.aspx?id=211622",""],[5573,"ترجمتك في صمتي بوح","https://www.poetsgate.com/ViewPoem.aspx?id=200071",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5628,"أطياف على الضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=178549",""],[5688,"رفقا بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=200758",""],[5720,"كَأَنَّكَ الشَّمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=201280",""],[5764,"ست وثلاثينك","https://www.poetsgate.com/ViewPoem.aspx?id=177319",""],[5842,"يا ربّ عفوك / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=136527",""],[5887,"قال السجين","https://www.poetsgate.com/ViewPoem.aspx?id=35277",""],[5923,"إلى فرح","https://www.poetsgate.com/ViewPoem.aspx?id=146860",""],[5943,"ليت الكلام يحقق الآمالا","https://www.poetsgate.com/ViewPoem.aspx?id=35157",""],[5956,"أمَّلْتِني كثيرا","https://www.poetsgate.com/ViewPoem.aspx?id=182550",""],[5956,"وحيدة حتى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183438",""],[5956,"بالي على شقيقك يا سمية مقلقي","https://www.poetsgate.com/ViewPoem.aspx?id=204343",""],[5956,"يا ألفَ شكر للسمية بِنْتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=206261",""],[5956,"صراع بين التفاؤل والتشاؤم","https://www.poetsgate.com/ViewPoem.aspx?id=207548",""],[5956,"ربَّما هجَرتْ هاجَر بُنوَّتي","https://www.poetsgate.com/ViewPoem.aspx?id=207824",""],[5977,"لا تيأسوا","https://www.poetsgate.com/ViewPoem.aspx?id=213285",""],[6068,"إن الغرام غرابة -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175910",""],[6068,"مسكتْ بحدّ الخنجر -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175933",""],[6099,"زهد","https://www.poetsgate.com/ViewPoem.aspx?id=35164",""],[6115,"نافق وجامل وكل الناس يطرونك","https://www.poetsgate.com/ViewPoem.aspx?id=180522",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[406,"إلى ياسر عرفات ( بعها )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=840&r=&rc=31",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""],[5190,"السقوط المنتظر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85052&r=&rc=127",""],[6367,"أين الطريق إليك ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80597&r=&rc=0",""]],"verses":[["لكنْ بكيتُ بها دونَ الورى فِتَنًا","تُذكي بِهَدْمِ بيوتِ اللهِ ما خَمَدا",0,"د",2,0],["لَكِن بِها بَردانِ بَردُ شِتائِها","إِمّا شَتَوتَ وَبَردُ شِعر البارِعِ",1,"ع",1,0],["لَكِنَّ بَعضَ القَومِ هَيّابَةٌ","في القَومِ لا تَغبِطُهُ البادِيَه",2,"ي",2,0],["لكنّ باريز ما زالت مطامعها","ترنو إلى الشام تصعيداً وتصويبا",3,"ب",2,0],["لكن بنيَّ وإن كانوا ذوي عذرٍ","ليسوا من الصبرِ في شيءٍ وإن هانا",4,"ن",2,0],["لكن بأشياءَ يهتزُّ الكريمُ لها","جُوداً فيُسني العطايا أيّ إسناءِ",5,"ا",2,0],["لكن بدأتُ القولَ مستوهباً","فيه لحسنِ الرأي مُستَجلِبا",6,"ب",2,0],["لكن بِدَسْتَنْبُويَةٍ ضخمةٍ","لقلبها في غمزها راحَهْ",7,"ح",2,0],["لكنْ برجليها ولم تَنَكَّدِ","فبتُّ منها مطمئنَّ المقْعَدِ",8,"د",1,0],["لكن بأن خالوه بدراً باهراً","وإذا أخال شبيهُ شيءٍ خِيلا",9,"ل",2,0],["لكن بأنْ حسبوه رَيّا روضةٍ","هبّتْ لها ريحُ الشمال بَليلا",9,"ل",2,0],["لَكِن بَعَثتُ الفِكرَ في آثارِهِم","في البَحرِ في الأَجواءِ في عَرضِ الفَلا",10,"ل",2,0],["لَكِن بَكَيتُ مِنَ الباغي يُعَذِّبُهُم","وَهُم شُيوخٌ وَأَطفالٌ وَنِسوانُ",11,"ن",1,0],["لكن بينهما اختلافا بَيِّناً","كتباين الأفعال والأسماء",12,"ا",2,0],["لَكِن بِأَوَّلِ زارِعٍ نَقَضَ الثَرى","بِذَكائِهِ وَأَثارِهِ بِبَنانِهِ",13,"ن",2,0],["لكنْ بِمَا بَانَ فِي عَيْنَيْهِ مِنْ تَعَبٍ","أَرَادَ إِخْفَاءَهُ عَنْ قَوْمِهِ فَبَدَا",14,"د",2,0],["لَكِن بَنو طَوقٍ وَطَوقٌ قَبلَهُم","شادوا المَعالي بِالثَناءِ الأَغلَبِ",15,"ب",1,0],["لكن بخلْنَ ولّما","بخلْنَ هبّت رياحُ",16,"ح",1,0],["لكنْ بعَلقَمَةَ الفَحلِ الذي زعموا","في الشعر أو بامرىء القيس المُراريّ",17,"ي",1,0],["لكن بفارسِ شيبانَ الذي سجدتْ","إليه فُرسانُ عَتّابٍ ودُعمي",17,"ي",1,0],["لَكِن بِديوانِ يَحيى","بِفيهِ لَطخُ مِدادِ",18,"د",1,0],["لَكِن بُكائي لِبُكا شادِنٍ","تَقيهِ نَفسي كُلَّ مَحذورِ",19,"ر",1,0],["لَكِن بِوَجهِ الحَبيبِ أَشرَبُها","بَينَ نَدامى وَبَينَ أُلّافِ",20,"ف",1,0],["لَكِن بِها جُلَّنارٌ قَد تَفَرَّعَهُ","آسٌ وَكَلَّلَهُ وَردٌ وَسوسانُ",21,"ن",1,0],["لكن بكائي على أبناءِ دهقنةٍ","غُرٍّ بها ليل من أبناء آلوسِ",22,"س",1,0],["لَكِن بِفِرتاجَ فَالخَلصاءِ أَنتَ بِها","فَحَنبَلٍ فَلِوى سَرّاءَ مَسرورُ",23,"ر",1,0],["لَكِنْ بِكَدٍّ فِيهِ تُحْ","يي اللَّيْلَ مِنْ قَتْلِ المَنَامِ",24,"م",1,0],["لكِنَّ بَيْنَ أَبِي الْفَتا","ةِ وَبَيْنَهُ ثَأْراً لِثَائِرْ",25,"ر",1,0],["لَكِنْ بِوَحْيِكَ فَاهَ كُلُّ مُفَوَّهٍ","وَبِرَأْيِكَ اسْتَهْدَى أُولُو الآرَاءِ",26,"ا",2,0],["لكِنْ بيوتُكُ لا تسا","وي شَطْرَ ببَيتٍ من قصيدي",27,"د",2,0],["لكن باح بالسر الجميل، وقد","يطيب للسر -سرِّ الدهر- إعلان",28,"ن",1,0],["لكنْ بمختلطينَ في نيِّاتهم","شُبُهاً ، فلا وَضَحٌ ولا إبهام",29,"م",1,0],["لكنْ بأوسعَ من آفاقها أمداً","رَحْباً ، وأرهفَ منها جانباً وشَبا",30,"ب",2,0],["لكنَّ بي جنَفَاً عنِ وعي فلسفةٍ","تقضي بأنَّ البرايا صُنِّفتْ رُتَبا",30,"ب",2,0],["لكن بأن تحقر منه ماجدا","ذا هممٍ قد ناغت الفَراقدا",31,"د",2,0],["لكن بحمدِ اللَّهِ أن","ى لا تحركنى له قُدَرْ",32,"ر",1,0],["لكن بقا ما تنساشي","إنّ الظواهرْ مرعيهْ",33,"ه",1,0],["لكن بأجفانه سقم بلا ألم","وسقم جسمي تشكو النفس من ألمه",34,"م",2,0],["لكن بما شاهدته","من فعله في شانه",35,"ن",2,0],["لَكن بينهما فرقاً بهِ اِفترقا","مَعَ اِتّفاقِهما فيما يعاب بهِ",36,"ب",2,0],["لَكن بركتَ بأثقالِ الذنوبِ وهل","بِمِثلها لجناحِ المرءِ تثقيلُ",37,"ل",1,0],["لكن بمدحك ما شدوت مشببا","الا وملت بثروة وغساء",38,"ا",2,0],["لكن بدت بمدامع يَقَقٍ","وبكيتُ قبلُ بأدمُعٍ حُمْر",39,"ر",1,0],["لكن بنو التاميزَ والسانَ ادَّعوا","حقّاً ونحنُ طرائدُ القنَّاص",40,"ص",1,0],["لكنَّ بعضَ الذي بي من محبَّتِها","العينُ في جَنَّةٍ والقلبُ في سَقَر",41,"ر",1,0],["لكن بسعدك ذلت لي شواردها","فرضت منها بتحبير وتزيين",42,"ن",1,0],["لَكِن بِذا حُكمِ القَضا","لَيسَ اِمرُؤٌ بِمَخلَدِ",43,"د",1,0],["لَكِن بِها كَلبٌ عَقورُ","قَد بَدَت مِنهُ المَخاوِفِ",44,"ف",1,0],["لكِنْ بَعِيدُ الوِدّ حَ","قُّ يَدٍ بِطيب الرَّائِحَه",45,"ح",2,0],["لكنْ بدا كعبةً ما دونَ طَلْعتِه","للعينِ إلاّ غبارَ الخيلِ أَستار",46,"ر",1,0],["لكن بفضلكِ راحتِ ال","أرواحُ عنك راضيه",47,"ي",2,0],["لكنَّ بغيَ الوغد مُديةُ حتفِه","يستجذبُ المرمى لسهم الرامي",48,"م",2,0],["لكن بشرطِ الفكرِ في العواقبِ","والنظرِ المنتجِ للمطالبِ",49,"ب",1,0],["لَكن بِعارِضِها دَمعي وَيُدهِشُها","مِن وَجنَتَيهِ شُعاع يَخطف البَصَرا",50,"ر",2,0],["لكن بحمد اللّه نكتتها التي","ذكرت تزيد تمكناً وحلولا",51,"ل",2,0],["لكن بمصر قبر وفي شيزر","قبر وداري بمنتأى العجم",52,"م",1,0],["لكن بقلبِيَ همٌّ زاد سورَتَهُ","وهْمٌ إذا قلتُ يخبُو زَندُهُ قَدَحَا",53,"ح",2,0],["لكن بمدحك قد فاقت","مني بخيالك يا اسما",54,"م",2,0],["لكن بَنُو الْحَجَرِ اسْتَدْعَتْ مكارِمُهُمْ","عَزْمِي وقد كانَ يُسْتَدْعَى بِها الحَجَرُ",55,"ر",1,0],["لكنْ براحاتِ المُنى","تلمُسُ لا راحِ اليد",56,"د",1,0],["لكنّ بيتا من بيوت العلا","بعدُ مشيدُ المجدِ لم يُهدَمِ",57,"م",1,0],["لكن بي الله إلا أن يتممه","حظا وفيرا فحف الكاس بالحب",58,"ب",1,0],["لكن بحَقِّكَ مَن هَذا الَّذي بِه صَا","رَ القَلبُ منكَ حَليفَ الشَّجوِ والشَّجنِ",59,"ن",1,0],["لكن بما أبدَعتَهُ فكرةُ البَشَرِ","إني بلندن وباريس وليتَهُما",60,"م",2,0],["لَكِن بمَديَنَ مِن مَفضى سوَيَمَرَةٍ","مَن لا يُذَمُّ وَلا يُشنا لَه خُلقُ",61,"ق",1,0],["لكن بدعواك الوجود حجبت عن","من يُدَّعى والعارفون مشارب",62,"ب",1,0],["لكن بإصلاحكم أركانه ثبتت","ما أحتاج يوماً إلى توطيد أطناب",63,"ب",1,0],["لَكِن بُكائي عَلى المُبكي بِمِصرَعِهِ","أَهلَ المَشارِقِ بَل مِن غَيرِهِم أُمَما",64,"م",2,0],["لكن بعرصة كربلا","فشت المصائب والعبر",65,"ر",1,0],["لكن بحر قريحتي","مذ شئت ذلك قد جمد",66,"د",1,0],["لكن بكيتُ لمعروض الجنان على ال","حتوفِ جهلاً وما من ريبةٍ عُرضا",67,"ض",2,0],["لَكِن بَدا صُبحُ اليقينِ فَأُطفِئَت","وَبِسيفِهِ قَد كانَ قَطع لِسانِها",68,"ن",3,0],["لَكن بِذَوقهِ السَليم قَد سَلَك","وَولي الأَحكام وَالمال مَلك",69,"ك",1,0],["لكنْ به صار ركنُ الْ","فسادِ دَكّاً مُدَعْثَر",7