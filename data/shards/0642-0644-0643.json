{"poems":[[53,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[82,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[47,"كَمْ بالكَثيبِ من اعترَاضِ كَثِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31528",""],[96,"مصرع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=12923",""],[154,"سبحان من في كل شيء شاهد","https://www.aldiwan.net/poem68495.html","الكامل"],[164,"من سلب الدهر رد أشبابه","https://www.aldiwan.net/poem58893.html","الرجز"],[438,"يا برق سق حيا السحاب الأبرقا","https://www.aldiwan.net/poem12682.html","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115998","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49548","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27513","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27239","البسيط"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67283","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198648","الكامل"],[2873,"","https://poetry.dctabudhabi.ae/diwan/poem/198893","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118857","الدوبيت"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91520","البسيط"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139388",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86374","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133163","الرمل"],[4852,"دعك","https://www.poetsgate.com/ViewPoem.aspx?id=214612",""],[5057,"يا واقفا","https://www.poetsgate.com/ViewPoem.aspx?id=197229",""],[5191,"يا من ظلمتَ","https://www.poetsgate.com/ViewPoem.aspx?id=211975",""],[5409,"عش في زمانك ما استطعت نبيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155496",""],[5674,"الحديث يطول","https://www.poetsgate.com/ViewPoem.aspx?id=195391",""],[5703,"قل كل شيءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=208793",""],[5848,"شاعر ولكنه من الغاوون","https://www.poetsgate.com/ViewPoem.aspx?id=48814",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5956,"وحيدة حتى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183438",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""],[5956,"أبتاه","https://www.poetsgate.com/ViewPoem.aspx?id=192724",""],[5956,"حارَ حناني","https://www.poetsgate.com/ViewPoem.aspx?id=195020",""]],"verses":[["قل كما قال يوسفُ الخيرِ يا يو","سُفُ للمُرتجيك لا تثريبا",0,"ب",2,0],["قل كما كنت تقو","ل وارسل مثلك",1,"ك",1,0],["قُلْ كَيفَ تَعطِفُ بِالوِصالِ لِعاشِقٍ","من لا تجودُ له بِعَطْفَةِ جيدِ",2,"د",1,0],["قُلْ كما شئت في مديح شفيقٍ","والكرام الثقاتِ من أعوانه",3,"ن",2,0],["قل كما صدقت مخايل بارق","يهمي، وفضل ناصع التهذيب",4,"ب",1,0],["قل كما قال للغمامة هارون","وفي الجوّ زمزمات الرّعود",5,"د",1,0],["قل كيف لا يلقى النجاح خليفةٌ","أمِنَ الوليُ به وخاف المارد",6,"د",1,0],["قل كفاه وقتنا ولو يشا","يشا به جميع من يشابه",7,"ب",2,0],["قُلْ كيفَ يلتذُ الرُقادُ متيّمٌ","الوجدُ قلّبَ منه قلباً مُحْرَقا",8,"ق",2,0],["قل كامل ورجز ثم الخفيف","قارب تدارك في الختام بالرديف",9,"ف",1,0],["قل كلانا يا حماماتِ اللّوى","يشتكى وجداً قديما وغراما",10,"م",2,0],["قلْ كيفَ يُشْفِقُ من مكابدةِ الأَسَى","من ليس يَفْرَق من مُكَابدة العدا",11,"د",2,0],["قلْ كيف شئتَ فإنَّ الأمر يقلبه","ولا تخفْ من غويٍّ في تطلُّبه",12,"ب",2,0],["قل كيف يسكن قلب لا يحيط به","وقد تيقن هذا في تقلبه",13,"ه",1,1],["قل كيفَ يظهرُ والطغاةُ لحربهِ","متأهّبون متى عياناً بانا",14,"ن",2,0],["قل كيف تُنْعَشُ بعد طول عِثارها","أم كيف تُفْتَحُ بعد سدّ رِتاجها",15,"ج",3,0],["قل كيف لا يفتح الله البلاد وقد","تفتحت لك أبواب السماوات",16,"ت",1,0],["قل كيف لنا ولو بروز الطيفِ","فالهجر عذابه أليم الحيفِ",17,"ف",1,0],["قُل كانَ لي جيرةٌ أَهلٌ إِذا قَربوا","وَسادةٌ حَيثما كانوا بِما فعلوا",18,"ل",3,0],["قل كما قال يوسفٌ لبني","يعقوبَ لما رأوه لا تثريب",19,"ب",1,0],["قل كيف تختلس المداد مقدراً","كفٌ قد انبجست ببحر مزبد",20,"د",1,0],["قل كرام الحي يا أهل الوفا","إن في الغناء قد عاينت في",21,"ي",1,0],["قل: ..\" كنتُ بذراَ .. يرتجيها كوثرا\"","بل دعْكَ عن ما رمتَ تحكيهِ .. دعَكْ.",22,"ك",1,0],["قل كلّ ما أُلهِمتهُ فلرُبما","تتبدّلُ الأفكارُ والأحوالُ",23,"ل",1,0],["قُلْ كَيفَ يُثخِنُني الجِراحَ، وخدُّهُ","!غَضُّ الهَوى، سُبحانَ مَنْ سواكا",24,"ك",2,0],["قل كيف عاش ولا تقل كم عاش من","جعل الحياة إلى علاه سبيلا",25,"ل",2,0],["قل كيف أبدأ والحديث يطولُ","هل لي إلى وصلٍ وأنتَ قتيلُ",26,"ل",1,1],["قُلْ كلَّ شيءٍ سوى شَكٍّ بعاطفتي","إنَّ الشُّكوكَ تُشيبُ الشَّعْرَ في راسي",27,"س",2,0],["قل كان واحد .. بس ! به مليون","طعنة وجرح وضيقة ومأساه",28,"ا",2,0],["قل كلما ضاقت بك الأمداءُ","واستنكرت ظلماءك الظلماءُ",29,"ا",2,1],["قُلْ كيف حال الأرضِ والبغضاءُ تف","تك دائماً بعِظامها ورئاتها؟",30,"ت",3,0],["قل كيف تبقى الأرض أرضاً بينما","فيها براكينُ الغباء الناقمِ؟",31,"م",1,0],["قُلْ كيف يمكن أن تُمارس رحمةً","إنْ نحن لم نُخطئْ وإنْ لن تَرْحَما؟",32,"م",2,0],["قُلْ كيف أعفو عن لئيمٍ كلما","سامحتُهُ يزداد في إثخاني؟",33,"ن",2,0]]}