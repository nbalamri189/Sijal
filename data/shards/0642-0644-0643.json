{"poems":[[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[45,"كَمْ بالكَثيبِ من اعترَاضِ كَثِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31528",""],[148,"سبحان من في كل شيء شاهد","https://www.aldiwan.net/poem68495.html","الكامل"],[158,"من سلب الدهر رد أشبابه","https://www.aldiwan.net/poem58893.html","الرجز"],[429,"يا برق سق حيا السحاب الأبرقا","https://www.aldiwan.net/poem12682.html","الكامل"]],"verses":[["قل كما قال يوسفُ الخيرِ يا يو","سُفُ للمُرتجيك لا تثريبا",0,"ب",2,0],["قل كما كنت تقو","ل وارسل مثلك",1,"ك",1,0],["قُلْ كَيفَ تَعطِفُ بِالوِصالِ لِعاشِقٍ","من لا تجودُ له بِعَطْفَةِ جيدِ",2,"د",1,0],["قُلْ كما شئت في مديح شفيقٍ","والكرام الثقاتِ من أعوانه",3,"ن",2,0],["قل كما صدقت مخايل بارق","يهمي، وفضل ناصع التهذيب",4,"ب",1,0],["قل كيف لا يلقى النجاح خليفةٌ","أمِنَ الوليُ به وخاف المارد",5,"د",1,0],["قل كفاه وقتنا ولو يشا","يشا به جميع من يشابه",6,"ب",2,0],["قُلْ كيفَ يلتذُ الرُقادُ متيّمٌ","الوجدُ قلّبَ منه قلباً مُحْرَقا",7,"ق",2,0]]}