,""],[5080,"يكبّل لحظة ويزيح أخرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88132&r=&rc=2",""],[5555,"راقصة الجاز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87419&r=&rc=14",""],[6310,"جمر الشتات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72001&r=&rc=5",""],[6315,"رُؤى على شفير الحداد !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87579&r=&rc=4",""],[6336,"أشواق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73400&r=&rc=6",""],[5190,"السقوط المنتظر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85052&r=&rc=127",""]],"verses":[["تجيء على أعقابها الريح، ترتدي","رمداَ محيطٍ، جفَّ من طول ماطغى",0,"غ",2,0],["تَجِئكَ بِمَلئِها طَوراً وَطَوراً","تَجِئكَ بِحَمأَةٍ وَقَليلِ ماءِ",1,"ا",2,0],["تجيشُ منهُ فويقَ الثَّدي جائفة ٌ","بمزبدٍ منْ نجيعِ الجوفِ فوَّارِ",2,"ر",1,0],["تُجِيبُ سَائِلَهُ عَنْهُ فَغَائِلُهُ","وَمَا يَعُدُّ عَلَيْهِ السَّامِع الكَلِمَا",3,"م",2,0],["تَجيشُ إِلى النَفسِ في كُلِّ مَنزِلٍ","لِمَيٍّ وَيَرتاعُ الفُؤادُ المُشَوَّقُ",4,"ق",1,0],["تَجيشُ مِنَ اللُؤمِ أَحسابُكُم","كَجَيشِ المُشاشَةِ في المِرجَلِ",5,"ل",1,0],["تُجيبون كلتا الدَعْوتين كأنكمْ","غيوثٌ وأحياناً ليوثٌ عنابس",6,"س",1,0],["تجيل طرفَك فيما خطَّ حاملُهُ","فلا ترى رهلاً فيه ولا قحلا",7,"ل",2,0],["تُجِيد الشدوَ مُوقعةً","وضاربةً ومُرتجلَهْ",8,"ل",2,0],["تَجيشُ بِأَوصالِ الجُزورِ قُدورُهُ","إِذا المَحلُ لَم يَرجِع بِعودَينَ حاطِبُه",9,"ب",2,0],["تَجيءُ إِلَيهِ الطَيرُ عَطشى فَتَرتَوي","وَإِن وَرَدَتهُ الإِبلُ لَم يَزجُرِ الإِبلا",10,"ل",2,0],["تَجيءُ اِبنَ بَعّاجٍ نُسورٌ كَأَنَّها","مَجالِسُ تَبغي بَيعَةً عِندَ تاجِرِ",11,"ر",1,0],["تجير على حوادثها وتحمى","ولا يحمين منك المحتمينا",12,"ن",2,0],["تُجيبُ الدارُ سائِلَها فَتُنبي","عَنِ الحَيِّ المُفارِقِ مِن تُجيبِ",13,"ب",1,0],["تُجيلَ دِلاءَ القَومِ فيهِ غُثائَهُ","إِجالَةَ حَمِّ المُستَذيبَةِ جامِلُه",14,"ل",2,0],["تَجيشُ بأوصالِ وَحْشيَّةٍ","رَعَتْ زَهَراتِ الرُّبا أشهُرا",15,"ر",2,0],["تَجيشُ بما افاءَ الطِّرْ","فُ والمجنونةُ النُّجُبُ",16,"ب",1,0],["تَجيدُ الضِرابَ وَحزَّ الرِقابِ","أَمامَ العِقابِ غَداةَ النَزالِ",17,"ل",1,0],["تَجِئكَ بِمِلئِها يَوماً وَيَوماً","تَجِئكَ بِحَمأَةٍ وَقَليلِ ماءِ",18,"ا",2,0],["تجيءُ خلافاً للأمور أُمُورُنا","وَيَعدلُ دهرٌ في الورى ويجورُ",19,"ر",1,0],["تجيء كأمّ الشبل غضبى تَوَقّدَتْ","وقد تَوّجَ اليافوخَ منها عسيبها",20,"ب",3,0],["تَجيشُ في كلّ مُسْتَنٍّ ومُنْسربٍ","والبأسُ يُصْرخُ في آثارها سِيري",21,"ر",2,0],["تُجيْبُ بعثتِ الوفدَ أمّا سبيلُه","فَسمحٌ وأمّا مُنتواهُ فَصالحُ",22,"ح",1,1],["تَجيءُ مَواعيدُ الكِرامِ سَوِيَّةً","وَتُنضى مَواعيدُ اللِئامِ فَتُخدَجُ",23,"ج",1,0],["تَجيءُ الرَزايا بِالمَنايا كَأَنَّما","نُفوسُ البَرايا لِلحِمامِ رَهائِنُ",24,"ن",1,0],["تُجِيرُ عَلَينا وائِلاً بِدِمائِنا","كَأَنَّكَ عَمّا نَابَ أشياعَنا عَمِ",25,"م",1,0],["تَجيشُ لها نفْسُ المُهَنّدِ هَيْبَة","فكلُّ حُسامٍ رامَها الصّبْرَ قالِس",26,"س",1,0],["تُجيعُ الطفلَ في قيدِ المنايا","وترضى الذعرَ محلولَ الوثاقِ",27,"ق",1,0],["تُجيِلُ سِلاَحَ الْمَوْتِ فِيْهِمْ كَأَنَّهُمْ","لِشَوْكَتِكَ الحُدَّى ضَئِينٌ نَوَافِرُ",28,"ر",1,0],["تجيءُ المطامعُ منقادةً","إليه إذا شاءَ أو لم يَشا",29,"ا",1,0],["تجيءُ إلى الصدرِ تحتَ الحرير","كجيئتها الصدرَ تحتَ الوَبر",30,"ر",1,0],["تجيء إليه الطير عطشى فترتوي","وإن وردنه الإبل لم يزجر الإبلا",31,"ل",2,0],["تُجيلُ والنومُ ظِلٌّ في مَحاجرها","طَرفاً تُهدهدُهُ الأحلامُ وسنانا",32,"ن",2,0],["تجيب على بعد نداء صريخهم","وتحمل من أعبائهم ما تحملوا",33,"ل",3,0],["تَجِيءُ بِآلاتٍ لَها مُستَعِدَّةً","لِحَصدِ غِلالٍ لا لِضَربِ قِلالِ",34,"ل",1,0],["تُجِيرُ لِذي الحُمقِ أَنّى أَرا","دَ حَمقاتِهِ وَتُعِزُّ اللَئيما",35,"م",2,0],["تَجيءُ عَليها الحليُ والحللُ اِنجلت","مُعطّرةً مصقولةً صفّتِ الشعرا",36,"ر",2,0],["تُجيبُ صهيلَ الخيلِ فيها حمائمٌ","أُطارحُها الشوقَ المبرِّح والوجدا",37,"د",2,0],["تُجيرونَ مِن صَرفِ اللَيالي فَجارُكُم","عَزيزٌ إِذا ما الجارُ أُسلِمَ لِلذُلِّ",38,"ل",1,0],["تَجيشُ إِذا ذَكَرَتهُ النُفوسُ","وَتَنبو إِذا نَظَرَتهُ الحَدَق",39,"ق",1,0],["تَجيشُ بِها صُدورُ القَومِ حَتّى","تَكادُ تَطيرُ بَينَهُم الشِرارُ",40,"ر",1,0],["تجيش بها للانقلاب مراجل","وتوقدها نيران نفس تلهب",41,"ب",1,0],["تُجيرُ وإن شَطتْ بها غُربةُ النَّوى","ستُنعِم يوماً أو يُفادى أسيرُها",42,"ر",3,0],["تجيبُ الصَفاةُ وَلَيسَ يُجيب","وَدَمعي على وَجنَتي سائِلُ",43,"ل",1,0],["تجيدُ لِحسنها وصفاً حلاه","وَيحصرُ دون أدناها المجيدُ",44,"د",1,0],["تجىء فلا أحسّ بها","وتمضى دون أن أعلم",45,"م",1,0],["تجيء فتمضي كمثل الهباء","وتحيا فتطوي كمثل العدم",46,"م",1,0],["تَجيءُ بِفُرسانِ الصَباحِ عَوابِساً","مُسَوَّمَةٍ تَردي بِكُلِّ مُقَنَّعِ",47,"ع",1,0],["تَجيء سَواءً والسّهامُ إذا رُمُوا","عليها فلا تَعدو المُروحَ وُقُوعها",48,"ع",3,0],["تَجيءُ على سَومِ الأراذلِ رذْلةً","وإنْ هِيَ قِيلتْ في الجَوادِ تجود",49,"د",1,0],["تُجيب بإحدى مُقلتَيها تَحيّتي","وأخرى تُراعي أعيُنَ الرُّقباء",50,"ا",2,0],["تَجَيَّشَ في جَيشٍ من الحُسنِ وارتَدَى","رِداء جَمالٍ طَرزُهُ الحدق النُّجلُ",51,"ل",1,0],["تجيءُ غليه مُنقاداً ذليلاً","ولا تدري يمنَك مِن شِمالِكْ",52,"ك",1,0],["تُجيبُ إذا سُئِلْتَ بكلِّ فنٍّ","وتعجزهم جواباً عن سؤالك",53,"ك",1,0],["تجيي عطاياه ميتَ المكرمات كما","تنسي سجاياهُ ما قد خطّ في الكتبِ",54,"ب",1,0],["تُجِيبيَّةٌ جابَ عنها الرَّدَى","كَجَوْبِ المُهَنَّدِ مَتْنَ الرِّداءِ",55,"ا",2,0],["تَجِيشُ بِوَدْقٍ من جَنى النَّبْعِ صائِبٍ","أَساوِدُهُ نَحْوَ العِدى وأَرَاقِمُهْ",56,"م",2,0],["تَجيشُ الليالي ثم يخمُدُ صَرفُها","فتنقُص فيما بيننا وتُطيلُ",57,"ل",1,0],["تجيش صدور الأرحبيات غضبةً","فما يدَّرِعْنَ الليل إلا رواغيا",58,"ي",2,0],["تجيز وتمنح الإخوان جوداً","وغيرك لا يجيز المادحينا",59,"ن",2,0],["تجيءُ ثقيلاً أو خفيفاً ترنّحت","قدود المعاني منهُ قبل المسامع",60,"ع",1,0],["تجيدُ الضربَ لكن في مقامٍ","دخانُ كبائهِ وهجُ العجاج",61,"ج",1,0],["تَجيشُ أرتالُهُم فوقَ الدّروع ِبِها","فَتَترُكُ السُّوحَ مَلأى بالمَطاعين ِ",62,"ن",1,0],["تُجيرُ قَلبَكَ مِن جَورش الهُمومِ إِذا","لَجينُها لاحَ في ياقوتِ ما جورِ",63,"ر",1,0],["تجيء به واحداً لا تريد","معيناً ولا تستشير الخليلا",64,"ل",2,0],["تَجيشُ فَتُعدي جَوهَرَ الحَلي خِدرَها","وَتُغضي فَتُعدي نَكهَةَ العَنبَرِ الخِدرا",65,"ر",2,0],["تجيءُ تسرَحُ أسرابُ البلابلِ في","صدريْ, وتسْكَرُ في أحلامِها النزِقة ْ",66,"ق",2,0],["تَجيءُ إِلى هذا بغيرِ رسالةٍ","وتَعْقُدُ عن ذَا بَعْدَ أَلْفِ رسُولِ",67,"ل",1,0],["تجيءُ الملوكُ إِلى بابِه","لِيَغْمُرَهُمْ جُودُه الشامِلُ",68,"ل",1,0],["تجيءُ الملوكُ له خُشَّعاً","وتَنْقاد في أَمْرِه رُبَّضاً",69,"ض",2,0],["تُجيلُ جِياعَ الوَشحِ وهي نَواحِلٌ","أغارَت عَلَيها مُشبَعاتُ الخَلائِل",70,"ل",1,0],["تجيئك تحت لواء السلام","وتأخذها باليد البانيه",71,"ي",2,0],["تُجير من الأحداث في آلِ خِندِفٍ","وكيف وأنت المُستجارُ تُجيرُ",72,"ر",1,1],["تجيل فكرك في روض العقول فلا","نزال تختار ما تجني وتقتطف",73,"ف",1,0],["تَجيئ وَتَمضي تارَةً بَعدَ تارَة","وَتَغنى جَميعاً وَالمحرّك باقي",74,"ق",2,0],["تجير على الأيام من بسمت","له وترفعه للمنصب المتعالي",75,"ل",2,0],["تجيب دعا الداعين في حندس الدجى","فنرجوك عفواً إن عفوك أوسع",76,"ع",1,0],["تَجيئون خَلفَ القومِ سواداً وُجوهكم","إذا ما قريشٌ للأضاميم أصفقوا",77,"ق",3,0],["تجيزها وتجيز المادحين بها","فقل لنا أزهير أنت أم هرم",78,"م",1,1],["تجير مياه العطايا من أنامله","إلى غليل مُنَى الراجي فَتَنْقَعُهُ",79,"ع",2,0],["تجيء وما ينفك عنها مجيئها","ولكنها تأتيك بالمدّ والجزر",80,"ر",1,0],["تَجيء لَكَ الوَرى مِن كُل فَج","بِهم ريح الرَجا تَجري رخاءا",81,"ا",3,0],["تَجيء الناس وَالحاجات شَتى","فَمرتحل بشكرك أَو مُقيم",82,"م",1,0],["تَجيء ليَ الركبان تَحدو بِسيبه","وَتَرجع مني في مَدايحه تَحدو",83,"د",2,0],["تَجيء كَنَظم الدُر مِنكَ الرَسائل","يَحلى بِها غَيري وَجيدي عاطل",84,"ل",1,0],["تَجيءُ بِرَيّا مِن عُثَيمَةَ طَلَّةٌ","يُفيقُ لِمَسراها الدَوا فَيُثيبُ",85,"ب",1,0],["تجيءُ مع الورد في فصلهِ","وأوجهُها للمُنى مسفِرَه",86,"ر",2,0],["تُجيلَ طَرفَ يَراعٍ بِالأَنامِلِ في","مَيدانِ طُرسٍ مُطيعاً لَم يَكُن حَرنا",87,"ن",2,0],["تجيش فتنسيه الهواجس نفسه","وتمنعه بالليل ان يغمض الجفنا",88,"ن",2,0],["تُجيلُ الحَبابَ بِأَنفاسِها","وَتَجلو سَبيخَ جُفالِ النُسالِ",89,"ل",1,0],["تجيئ بسبعة زادت وفيها","لنقص شباط بالجبر احتياط",90,"ط",1,0],["تجيء بأشعاري قريحة شاعر","ويفسدها من فكرتي نقدُ عالم",91,"م",1,0],["تجيء تموء لي بشجيٍّ صوت","فأحسبه بكاء لا مواء",92,"ا",2,0],["تجيء فيخشى الناس منك فيتقوا","أذاك وكم ساموك طباً وتدجيلا",93,"ل",2,0],["تجىء بلحية من بعد أخرى","كأنك بعض صناع ال