{"poems":[[55,"لهان الغمد ما بقي الحسام","https://www.aldiwan.net/poem29818.html","الوافر"],[65,"تأملت ربع الماليكة بالحمى","https://www.aldiwan.net/poem45716.html","الطويل"],[88,"ردوا علي بياني بعد محمود","https://www.aldiwan.net/poem10495.html","البسيط"],[90,"قضى والليل معتكر بهيم","https://www.aldiwan.net/poem45034.html","الوافر"],[74,"يفدي كرام الحمى منكم كرائمه","https://www.aldiwan.net/poem19686.html","البسيط"],[74,"لا تسألوا في الحب عن شاني","https://www.aldiwan.net/poem20152.html","السريع"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[93,"يا رب قائلة والقول أجمله","https://www.aldiwan.net/poem8757.html","عموديه"],[34,"لهفا على البيت المعدي لهفا","https://www.aldiwan.net/poem27728.html","الرجز"],[47,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[71,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[83,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[83,"ضللت بالبدر على نوره","https://www.aldiwan.net/poem61517.html","السريع"],[50,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[48,"يا سابحا يصهل في غرة","https://www.aldiwan.net/poem22419.html","السريع"],[48,"ينجمون وما يدرون لو سئلوا","https://www.aldiwan.net/poem22977.html","البسيط"],[48,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[48,"لقد آن أن يثني الجموح لجام","https://www.aldiwan.net/poem23643.html","الطويل"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42618","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[53,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[132,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[147,"حاشاك أن تسلب الأيام ما تهب","https://www.aldiwan.net/poem11738.html","البسيط"],[147,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[147,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[173,"أقيما على حر المدى أو ترحلا","https://www.aldiwan.net/poem1649.html",""],[189,"يا سادة قد كملوا","https://www.aldiwan.net/poem14737.html","مجزوء الرجز"],[203,"ما الحب إلا أنس كل امرئ","https://www.aldiwan.net/poem45518.html","السريع"],[214,"لا وليال بالحمى من نجد","https://www.aldiwan.net/poem13348.html","الرجز"],[226,"قائم فوق شاطىء النهر","https://www.aldiwan.net/poem55276.html","المنسرح"],[228,"غلواء ما أحلى المعطارا","https://www.aldiwan.net/poem39711.html","الرجز"],[240,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[266,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[276,"هب النسيم فما ست منه أشجار","https://www.aldiwan.net/poem52074.html","البسيط"],[285,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[303,"من فاته أن يرى الأشجان ماثلة","https://www.aldiwan.net/poem36307.html","عموديه"],[318,"ولو داواك كل طبيب إنس","https://www.aldiwan.net/poem59239.html","الوافر"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[342,"أمن دمنتين عرج الركب فيهما","https://www.aldiwan.net/poem45419.html","الطويل"],[412,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[463,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[463,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[510,"الإنسان","https://www.aldiwan.net/poem61093.html","البسيط"],[556,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[556,"من مثلها كنت تخشى أيها الحذر","https://www.aldiwan.net/poem47824.html","البسيط"],[563,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[564,"يا حاضرا في فؤادي","https://www.aldiwan.net/poem69368.html","المجتث"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53744","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122785","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87180","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123381","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70844","المجتث"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145101","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80005","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108835","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108540","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100997","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114802","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114747","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114711","الطويل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76795","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53188","البسيط"],[2206,"","https://poetry.dctabudhabi.ae/diwan/poem/146666","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27673","المجتث"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21450","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121192","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93688","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94295","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104679","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201057","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204989","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74238","الطويل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110750","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87365","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71308","البسيط"],[3437,"","https://poetry.dctabudhabi.ae/diwan/poem/102028","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74061","السريع"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103874","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86284","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109994","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91910","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91094","الوافر"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202349","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114242","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135954","الرجز"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130558","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45056","الطويل"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135100","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136389",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120312","البسيط"],[4859,"جميل الحب","https://www.poetsgate.com/ViewPoem.aspx?id=199794",""],[4955,"كتاب الله نهجره سنينا","https://www.poetsgate.com/ViewPoem.aspx?id=191233",""],[5038,"هذي بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=189564",""],[5147,"دعاه الهوى ما العصر عصر بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=166712",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5288,"أنا ماني بلعبه","https://www.poetsgate.com/ViewPoem.aspx?id=1191",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[1021,"تبدى يملأ الناظر","https://www.poetsgate.com/ViewPoem.aspx?id=47834",""],[5370,"سنين","https://www.poetsgate.com/ViewPoem.aspx?id=81638",""],[5397,"أغاظ الدهر قدرك أن يسودا","https://www.poetsgate.com/ViewPoem.aspx?id=157926",""],[5419,"باحس إني باضيع مني","https://www.poetsgate.com/ViewPoem.aspx?id=32491",""],[5582,"دَعِينِي وَيْكِ عاذِلَتِي دَعِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=187306",""],[5956,"التفرد","https://www.poetsgate.com/ViewPoem.aspx?id=185591",""],[5309,"فكر قليلا قبل عشق المها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573644",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[463,"حماها بأطراف الرماحِ حماتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59996&r=&rc=52",""],[6317,"هذا الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86083&r=&rc=1",""]],"verses":[["وَلوداً مِثلَ ما خالَستَ مِنهُ","وَأَنتَ بِمِثلِهِ أَبَداً عَقامُ",0,"م",1,0],["وَلَو دامَ هَذا الوَجدُ لَم تَبقَ عَبرَةٌ","وَلَو أَنَّني مِن لُجَّةِ البَحرِ أَغرِفُ",1,"ف",1,0],["وَلَو دَرَت أَنَّ هَذا الخَطبَ أَفحَمَني","لَأَطلَقَت مِن لِساني كُلَّ مَعقودِ",2,"د",1,0],["ولودرت النجوم له مصاباً","بكته على ترفعّها النجوم",3,"م",1,0],["ولو درى القبر من وافاه لاحْتفرت","من السرور بلا كفّ معالمه",4,"م",2,0],["ولو دعاه حيّ عدوان ما","رماهُم الدهر بعدوان",5,"ن",1,0],["ولَوَدَّا إذا هما بك حَلّا","لو يقيمان ثم لا يرحلان",6,"ن",1,0],["وَلَو دَرى أَنَّ هَذي الشُهبُ تُزعِجُها","أَمسى يَروعُ في أَفلاكِها الشُهُبا",7,"ب",2,0],["وَلَو دَعا اللَهَ وَمَدَّ الكَفّا","لَرَجَفَت مِنهُ الجِبالُ رَجفا",8,"ف",2,0],["وَلَو داسَكُم بِالخَيلِ دَوسَةَ مُغضَبٍ","لَطِرتُم غُباراً فَوقَ خُرسِ الكَتائِبِ",9,"ب",1,0],["وَلَو دَرَت أَنَّها فِيما تُحاوِلُهُ","مَخذولَةٌ لَم تَسُم في مَرتَعٍ وَخِمِ",10,"م",1,0],["ولو درتُ وادي ديرِ سمعانَ ساعةً","لكنتُ أبلُّ الشوقَ مِنْ عمرِ الرضى",11,"ض",2,0],["وَلَو دَبَّ ريقُكَ في حَيَّةٍ","لَعادَ بِهِ سَمُّها سَلسَلا",12,"ل",2,0],["وَلَو دَعا مَيتاً بِأَلفاظِهِ","إِذَن لَلَبّاهُ مِنَ القَبرِ",13,"ر",1,0],["ولو دنوتَ فمكّن","تَ ضارباً لم يؤثر",14,"ر",1,0],["وَلَو دَرى الموؤودُ ما عِندَنا","مِن نَبَإٍ ما عُتِبَ الوائِدُ",15,"د",1,0],["وَلَو دَرَت بِمَخازيهِم بُيوتُهُم","هَوَت عَلَيهِم وَلم تُنظِرهُمُ السُقُفُ",16,"ف",1,0],["وَلَو دَفَنوهُ في الغَبراءِ جاءَت","بِما يَسعى لَهُ مُتَأَلِّبوهُ",17,"ب",3,0],["ولو دامَتِ الدُّولاتُ كانوا كغَيرِهمُ","رَعايا ولكِنْ ما لَهُنّ دَوَامُ",18,"م",1,0],["وَلَو دامَ مِنها وَصلُها ما قَلَيتُها","ولَكِن كَفى بِالهَجرِ لِلحُبِّ شافِيا",19,"ي",2,0],["وَلَوْ دَرَى أَنَّ مَا يَلْقَاهُ مِنْ عَنَتٍ","مِنْ خَيْبَةِ الرَّأْيِ لَمْ يَعْتُبْ عَلَى الْقَدَرِ",20,"ر",1,0],["وَلَوَدَّتْ لَكَ الْبَقَاءَ إِلى غَا","يَتِهِ لَوْ وَقَى مِنَ الْمَوْتِ وَاقِ",21,"ق",1,0],["ولوّد إذا هما بك حَلاَّ","لو يقيمان ثم لا يرحلان",22,"ن",1,0],["ولو دَرَوْا ما بَدَتْ منهم مُخالَفةٌ","ولا أحاطَ بهم سُوءٌ ولا نُكُرُ",23,"ر",1,0],["وَلَو دَرَوا أَنَّها وَالعُشبَ طالِعَةٌ","ما سَرَّ مُجدِبَهُم أَن يَطلَعَ العُشُبُ",24,"ب",1,0],["وَلَو دَعَوتَ المُلوكَ قاطِبَةً","لَأَصبَحَت دونَ رُسلِها تَفِدُ",25,"د",1,0],["وَلَو دافَعوا عَن رَبِّهِم بَعدَ رَبِّهِم","بِأَنفُسِهِم ما أَبطَأوا إِذ تَسَرَّعا",26,"ع",2,0],["ولَو دِرهَمٌ يَوماً دَعاهُم لَأَقبَلَت","رِجالٌ وَخَيلٌ تَملأُ الجَوَّ قَسطَلا",27,"ل",2,0],["ولو دَرَى مقدارَ ما","أهدى من هَذي التُّحَف",28,"ف",1,0],["ولو درى كلُّ الورى فضلهُ","لهامَ فيِهِ الجنُّ والأنسُ",29,"س",1,0],["ولو دعتني باسم سعد عبدها","لقلت هذا من كمال سعدي",30,"د",2,0],["ولو دهته الحياة آونة","لقصرت منه فسحة العمر",31,"ر",1,0],["وَلَو دَوى أَنَّ هُناك عَقرَب","لآثَرَ الغَصَّ عَلى أَن يَشرَب",32,"ب",1,0],["وَلَو دَفَعَ الرَدى المَحتومِ بَأسٌ","وَإِقدامٌ وَرَأيٌ وَاِعتِزامُ",33,"م",1,0],["ولو دافعت من دونه البيض والقنا","حكمنا بها قطعاً وبالسمر شرعا",34,"ع",2,0],["وَلَو دَعا بجماد الارض معجزة","لباه ترب واشجار واحجار",35,"ر",1,0],["وَلَو دُفِعَ الْحِمامُ بِعِزِّ قَوْمٍ","لَكُنْتَ أَعَزَّ ذِي عِنٍّ نَصِيراً",36,"ر",2,0],["وَلَو دَعَوتُ لَلَبَّتني ضراغمة","تَدأى إِلى جاحِمٍ بِالحَربِ مُشتَعِلِ",37,"ل",1,0],["وَلو درى ناظرٌ ماذا تضمَّنه","قلبي لأَصبح منه القلبُ ينصدع",38,"ع",1,0],["وَلَو دَاوَاكَ كُلُّ طَبِيبِ إنسٍ","بِغَيرِ كَلامِ لَيلَى مَا شَفَاكا",39,"ك",2,1],["وَلَو دَعا البَحرَ لِلطوفانِ مُعجِزَةً","لا غَرِقَت أُمَّةُ الكُفّارِ دَعوَتُهُ",40,"ت",2,0],["وَلودَينِ لِلبَيضِ الهِجانِ وَحالِكٌ","مِنَ اللَونِ غِربيبٌ بِهيمٌ عَلاهُما",41,"م",2,0],["وَلَو دَرى مسرى الصَبا نَحوَها","سَد مِنَ البُخلِ مَهَبِ الرِياح",42,"ح",1,0],["ولو درى النائمُ أيَّ قَدَمٍ","يُحرزها الساهر لاشتاق السَّهَدْ",43,"د",1,0],["ولوداًن ولِي من حظِّها بطنُ حائلٍ","معنَّسةٍ شابت وشابَ لِداتُها",44,"ت",3,0],["ولو دعيت نزال لقلت أهلا","فقبحا ويك للموت الزؤام",45,"م",1,0],["ولوْ دلَلْتَ عليهِ الناسَ ما جحَدوا","لكنّكَ ارْتحْتَ للدنيا وما تعِدُ",46,"د",1,0],["ولو درى أهلُ الهوى بالّذي","جَنَى الهوى من قبل لم يعشِقوا",47,"ق",3,0],["وَلَو دَرى مِن على حُزنٍ يقرّعنِي","بمن فُجعتُ ومن خُولستُه عَذَروا",48,"ر",3,0],["ولو دفعت كل الذي هو ملكها","على طلقة ما كان قلبي يخالع",49,"ع",1,0],["وَلوْ دَرَى الدَّهْرُ عَنِّي","جَاءت إِلىَّ شعُوبُ",50,"ب",1,0],["ولو دَفَعَ العِزُّ الحِمامَ عن امرىءٍ","لما نال عمراً للحِمامِ شَبَا ظُفَرِ",51,"ر",1,0],["وَلَو دَعَوتَ بِكُحلانٍ أَجابَكَ مِن","خَوفِ الرَّدَى أَهلُ كُحلانٍ وَ كُحلانُ",52,"ن",1,0],["وَلَو دامَ مَن أَهوى عَلى الغَدر لاشتفى","بإتلاف رُوحي في الصَبابة شاني",53,"ن",2,0],["ولو درى أنني في النوم فُزتُ به","مِنْ بُخلِه ثم حاولتُ الرُّقاد لَما",54,"م",2,0],["ولو دهْتنا بِغيلا","نها الأسودُ الضَّوابث",55,"ث",1,0],["ولو دعاها معهدًا لانتعشت","وانصرفت لها العيون وعَشَت",56,"ت",1,0],["وَلَو دَروا أَن المُراد الأَدَبُ","بِوضعِهِ وَصُنعِهِ ما لَعبوا",57,"ب",3,0],["ولودَّت أترابُها الغيدُ أن قد","جعلته على الترائبِ عطرا",58,"ر",2,0],["ولو دعا غيرك المولى المجيد لها","صارت لخنصر نابليون خاتاما",59,"م",2,0],["ولو دعى ضوءُ فيكَ البرقَ أوقفه","حيران ذا كلف بالنور مبهوتا",60,"ت",2,0],["ولو دَرَوا من قلبها ما درى","قلبيَ ما لاموا ولا أنكروا",61,"ر",3,0],["ولو دامتِ الدنيا لدامت لأحمدٍ","نبي الهدى لكنها قط لم تدم",62,"م",1,0],["ولو دُعِيتُ إلى أَمثالِهَا لسعَت","إليك سعي مشوقٍ هائمٍ قَدَمي",63,"م",2,0],["ولو دفعت بنفسٍ أنت مهلكها","أوردتها نهلاً في الأجر بل عَللا",64,"ل",2,0],["ولو دَرتِ الأَنعامُ وَهيَ رَوَاتِعٌ","مِنَ المَوتِ ما ندي لَمَا رأَتِ السِّمَن",65,"ن",1,0],["ولو دعا التينَ والزيتونَ لابتدرا","إليه في الحين واقرأ تستبن خبَرَه",66,"ر",2,0],["ولو دعاكم إلى سلم يحصنكم","محمد لحللتم حُرمة الذِّمَم",67,"م",1,0],["ولو دام لي، ما دمت، وصل أحبتي","لبشرت نفسي بالأمان من الهجر",68,"ر",1,0],["ولو دّرتْ أن هذا","يضرّها ما استكنت",69,"ت",1,0],["وَلَو دَرى أَنَّ ما جاهَرتَني ظَهَراً","ما عُدتُ ما لألأَت أَذنابَها الفُورُ",70,"ر",1,0],["ولو دعا الصبح لشق الدجى","ركضا من الفجر على ابلق",71,"ق",1,0],["وَلو دَنا غَيره مِنها يحاولها","لَصارَ بَينَ الوَرى في خزيهِ مَثَلا",72,"ل",2,0],["ولو دامت الدنيا لكان محمد","بها باقيا حيا وما القبر آواه",73,"و",3,0],["ولو دعي باسمه والأرض مجدبة","لجادها المزن واخضرت نواحيها",74,"ي",3,0],["ولو دام السرور دوام حزنٍ","لدُمنا منتشين بلا شَمول",75,"ل",1,0],["ولو دخلا في كون شعري لأبصرا","مديحي وذمّي منهما غاية الجهل",76,"ل",1,0],["وَلَو دامَت اللذات عشنا بِغبطة","مِن الدَهر لَكن ما لهن دَوام",77,"م",1,0],["ولو درى المسك أن الترب ضمهم","لو دنشقة عرف من شذا التربِ",78,"ب",1,0],["وَلَو درى العيسُ ما بي قبل ان ظعنت","توقَّفت رحمةً لي دونَ مُرتَحلِ",79,"ل",1,0],["وَلَوْ دَرَى مَنْهُلُ الوَادِي الذَّي وَرَدُوا","مَنْ وَارِدُوا مَائِهِ لاَهْتَزَّهُ الطَرَبُ",80,"ب",1,0],["ولو درى البيت أن قد جاءه لسعى","بشراً للقياه يمشي لا على القدم",81,"م",1,0],["وَلَو دَرى كَيفَ مَصير الهَوى","ما كانَ للأهواء منقادا",82,"د",2,0],["ولو دعوت بها أسد الفلا لغدا","اضرارها عن جميع الناس مقصورا",83,"ر",2,0],["وَلَو دامَت الدُنيا لَدامَت لِفارِس","لَهُ ما عَهِدنا في الوَرى مِن مسابق",84,"ق",1,0],["وُلودةُ ابنٍ عن تعقُّلِ ذاتِهِ","ونفخةُ روحٍ عن محبَّتهِ الوُسعَى",85,"ع",2,0],["وَلَو دَرى المَرء ما في الغَيب من عَجَب","ما باتَ يَسبح في بحرٍ من الفِكَر",86,"ر",1,0],["وَلو دامَت غوايات لدامَت","أَوائلنا فَلم يَهرم صباها",87,"ا",3,0],["ولود مغفر كل ليث باسل","لو كان من حسد البراقع برقعا",88,"ع",2,0],["وَلَو دَرَيتَ بِمَن آتَاكَ يَا رَجُلُ","لَكُنتَ تُوطِئُهُ أنَاسِيَ البَصَرِ",89,"ر",1,0],["ولو درى الناظرُ ما قد نظرا","يفهمُ ما قد قلتُه مشتهرا",90,"ر",2,0],["ولود آدم أن يكون نعيمه","عوض النعيم فلا يرى ابليسا",91,"س",2,0],["وَلَو دَفَعَ المَعروفُ حَتفَ امرىء لَما","تَقَلَّدَ مِن ثَوبِ البِلى ما تَقَلَّدا",92,"د",2,0],["ولو دهتني أسود الغيل بالغيل","فلن ينال الفتى أقصى مطالبه",93,"ه",1,0],["ولو دعت خمرة من خدها عصرت","كأنما أخذها للعقل اخفاء",94,"ا",2,0],["ولو درت الأطيار منه نشدةً","تغنت بها من فوق أغصانها الخضر",95,"ر",1,0],["ولو درت مصر ما بالشام من اسف","لشاطرته نصيب الفخر والرغد",96,"د",1,0],["ولو دفنوه وارتحلوا","ستُرجعُ روحَه الذكرى!",97,"ر",2,0],["ولو دخلَ الأعادي جحرَ ضبٍّ","دخلنا خلفهم متسارعينا",98,"ن",2,0],["وَلوْ دَفَعْتُمْ إلى قَلْبي نِصالَكُمُ","لَثارَ مِنْهُ قَرائينٌ وقُدّاسُ",99,"س",1,0],["ولو درست أرواحكم منطق الهوى","لما عرفت فيه سوى الصورة الغرا",100,"ر",2,0],["ولو دعتني للديار أنّة","مني كانت أم من الحي سوا",101,"ا",1,0],["ولو دمعي يسيل أنهار .. عساها للعمى عيني","ولا أترجى وصالك لو وصالك ينعش الخاطر",102,"ر",1,0],["وَ لَوْ دَرَى الوَرْدُ مَا تطْوِي جَوَانحُنَا","مِنْ حُبِّهِ لَتَخَلَّى عَنْ تَعَالِيهِ",103,"ي",2,0],["وَ لَوْ دَرَى سِرَّنَا أَعْطَى وَ كَلَّلَنَا","بِالغَارِ أَوْ قُبْلَةٍ بِالنَّارِ تُغْرِيهِ",103,"ي",2,0],["ولود الكف للرفد","وكم تلفى يد عاقر",104,"ر",1,0],["ولو دندنت أساوري في يديّه","أضم انا الهاتف واهلّ التراحيب",105,"ب",1,0],["ولو دعوا الإله بصدق قول","به مسخوهم جمعاً قرودا",106,"د",2,0],["ولو دارت بنا الأفلاك","هتفضل غنوتك لحنى",107,"ا",1,0],["وَلَوْ دَمْعِي يَشُوبُ البَحْرَ فَيْضاً","لَما رَكِبَتْهُ أَلْواحُ السَّفِينِ",108,"ن",1,0],["ولو دَرَسُوا التفَرُّدَ في قصيدي","لقالوا إنه صَرَعَ الكِذابا",109,"ب",2,0],["وَلَو دَرى المَيتُ نَشيدَ الهَوى","لاهتَزَّ كَالأَحياء مِن عُجبِه",110,"ه",1,0],["وَلَو دَرى العاشِقُ المَوتُورُ كَيفَ سَلا","أَحبابُهُ لَم يَبِت يَوماً بِقُربِهِم",111,"م",1,0],["ولودا ولي من حظها بطنُ حائلٍ","معنسة ٍ شابت وشابَ لداتها",112,"ت",3,0],["ولو دنا ثغرها البسّام .. من قدح","لراح يرقص في شطآنه الحَبَب",113,"ب",1,0]]}