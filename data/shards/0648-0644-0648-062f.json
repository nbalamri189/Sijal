{"poems":[[53,"لهان الغمد ما بقي الحسام","https://www.aldiwan.net/poem29818.html","الوافر"],[63,"تأملت ربع الماليكة بالحمى","https://www.aldiwan.net/poem45716.html","الطويل"],[86,"ردوا علي بياني بعد محمود","https://www.aldiwan.net/poem10495.html","البسيط"],[88,"قضى والليل معتكر بهيم","https://www.aldiwan.net/poem45034.html","الوافر"],[72,"يفدي كرام الحمى منكم كرائمه","https://www.aldiwan.net/poem19686.html","البسيط"],[72,"لا تسألوا في الحب عن شاني","https://www.aldiwan.net/poem20152.html","السريع"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"يا رب قائلة والقول أجمله","https://www.aldiwan.net/poem8757.html","عموديه"],[32,"لهفا على البيت المعدي لهفا","https://www.aldiwan.net/poem27728.html","الرجز"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[81,"ضللت بالبدر على نوره","https://www.aldiwan.net/poem61517.html","السريع"],[48,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[46,"يا سابحا يصهل في غرة","https://www.aldiwan.net/poem22419.html","السريع"],[46,"ينجمون وما يدرون لو سئلوا","https://www.aldiwan.net/poem22977.html","البسيط"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[46,"لقد آن أن يثني الجموح لجام","https://www.aldiwan.net/poem23643.html","الطويل"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42618","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[129,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[144,"حاشاك أن تسلب الأيام ما تهب","https://www.aldiwan.net/poem11738.html","البسيط"],[144,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[144,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[170,"أقيما على حر المدى أو ترحلا","https://www.aldiwan.net/poem1649.html",""],[186,"يا سادة قد كملوا","https://www.aldiwan.net/poem14737.html","مجزوء الرجز"],[200,"ما الحب إلا أنس كل امرئ","https://www.aldiwan.net/poem45518.html","السريع"],[211,"لا وليال بالحمى من نجد","https://www.aldiwan.net/poem13348.html","الرجز"],[222,"قائم فوق شاطىء النهر","https://www.aldiwan.net/poem55276.html","المنسرح"],[224,"غلواء ما أحلى المعطارا","https://www.aldiwan.net/poem39711.html","الرجز"],[236,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[262,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[272,"هب النسيم فما ست منه أشجار","https://www.aldiwan.net/poem52074.html","البسيط"],[281,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[283,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[299,"من فاته أن يرى الأشجان ماثلة","https://www.aldiwan.net/poem36307.html","عموديه"],[314,"ولو داواك كل طبيب إنس","https://www.aldiwan.net/poem59239.html","الوافر"],[321,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[338,"أمن دمنتين عرج الركب فيهما","https://www.aldiwan.net/poem45419.html","الطويل"],[407,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[459,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[459,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[480,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[506,"الإنسان","https://www.aldiwan.net/poem61093.html","البسيط"],[552,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[552,"من مثلها كنت تخشى أيها الحذر","https://www.aldiwan.net/poem47824.html","البسيط"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[560,"يا حاضرا في فؤادي","https://www.aldiwan.net/poem69368.html","المجتث"]],"verses":[["وَلوداً مِثلَ ما خالَستَ مِنهُ","وَأَنتَ بِمِثلِهِ أَبَداً عَقامُ",0,"م",1,0],["وَلَو دامَ هَذا الوَجدُ لَم تَبقَ عَبرَةٌ","وَلَو أَنَّني مِن لُجَّةِ البَحرِ أَغرِفُ",1,"ف",1,0],["وَلَو دَرَت أَنَّ هَذا الخَطبَ أَفحَمَني","لَأَطلَقَت مِن لِساني كُلَّ مَعقودِ",2,"د",1,0],["ولودرت النجوم له مصاباً","بكته على ترفعّها النجوم",3,"م",1,0],["ولو درى القبر من وافاه لاحْتفرت","من السرور بلا كفّ معالمه",4,"م",2,0],["ولو دعاه حيّ عدوان ما","رماهُم الدهر بعدوان",5,"ن",1,0],["ولَوَدَّا إذا هما بك حَلّا","لو يقيمان ثم لا يرحلان",6,"ن",1,0],["وَلَو دَرى أَنَّ هَذي الشُهبُ تُزعِجُها","أَمسى يَروعُ في أَفلاكِها الشُهُبا",7,"ب",2,0],["وَلَو دَعا اللَهَ وَمَدَّ الكَفّا","لَرَجَفَت مِنهُ الجِبالُ رَجفا",8,"ف",2,0],["وَلَو داسَكُم بِالخَيلِ دَوسَةَ مُغضَبٍ","لَطِرتُم غُباراً فَوقَ خُرسِ الكَتائِبِ",9,"ب",1,0],["وَلَو دَرَت أَنَّها فِيما تُحاوِلُهُ","مَخذولَةٌ لَم تَسُم في مَرتَعٍ وَخِمِ",10,"م",1,0],["ولو درتُ وادي ديرِ سمعانَ ساعةً","لكنتُ أبلُّ الشوقَ مِنْ عمرِ الرضى",11,"ض",2,0],["وَلَو دَبَّ ريقُكَ في حَيَّةٍ","لَعادَ بِهِ سَمُّها سَلسَلا",12,"ل",2,0],["وَلَو دَعا مَيتاً بِأَلفاظِهِ","إِذَن لَلَبّاهُ مِنَ القَبرِ",13,"ر",1,0],["ولو دنوتَ فمكّن","تَ ضارباً لم يؤثر",14,"ر",1,0],["وَلَو دَرى الموؤودُ ما عِندَنا","مِن نَبَإٍ ما عُتِبَ الوائِدُ",15,"د",1,0],["وَلَو دَرَت بِمَخازيهِم بُيوتُهُم","هَوَت عَلَيهِم وَلم تُنظِرهُمُ السُقُفُ",16,"ف",1,0],["وَلَو دَفَنوهُ في الغَبراءِ جاءَت","بِما يَسعى لَهُ مُتَأَلِّبوهُ",17,"ب",3,0],["ولو دامَتِ الدُّولاتُ كانوا كغَيرِهمُ","رَعايا ولكِنْ ما لَهُنّ دَوَامُ",18,"م",1,0],["وَلَو دامَ مِنها وَصلُها ما قَلَيتُها","ولَكِن كَفى بِالهَجرِ لِلحُبِّ شافِيا",19,"ي",2,0],["وَلَوْ دَرَى أَنَّ مَا يَلْقَاهُ مِنْ عَنَتٍ","مِنْ خَيْبَةِ الرَّأْيِ لَمْ يَعْتُبْ عَلَى الْقَدَرِ",20,"ر",1,0],["وَلَوَدَّتْ لَكَ الْبَقَاءَ إِلى غَا","يَتِهِ لَوْ وَقَى مِنَ الْمَوْتِ وَاقِ",21,"ق",1,0],["ولوّد إذا هما بك حَلاَّ","لو يقيمان ثم لا يرحلان",22,"ن",1,0],["ولو دَرَوْا ما بَدَتْ منهم مُخالَفةٌ","ولا أحاطَ بهم سُوءٌ ولا نُكُرُ",23,"ر",1,0],["وَلَو دَرَوا أَنَّها وَالعُشبَ طالِعَةٌ","ما سَرَّ مُجدِبَهُم أَن يَطلَعَ العُشُبُ",24,"ب",1,0],["وَلَو دَعَوتَ المُلوكَ قاطِبَةً","لَأَصبَحَت دونَ رُسلِها تَفِدُ",25,"د",1,0],["وَلَو دافَعوا عَن رَبِّهِم بَعدَ رَبِّهِم","بِأَنفُسِهِم ما أَبطَأوا إِذ تَسَرَّعا",26,"ع",2,0],["ولَو دِرهَمٌ يَوماً دَعاهُم لَأَقبَلَت","رِجالٌ وَخَيلٌ تَملأُ الجَوَّ قَسطَلا",27,"ل",2,0],["ولو دَرَى مقدارَ ما","أهدى من هَذي التُّحَف",28,"ف",1,0],["ولو درى كلُّ الورى فضلهُ","لهامَ فيِهِ الجنُّ والأنسُ",29,"س",1,0],["ولو دعتني باسم سعد عبدها","لقلت هذا من كمال سعدي",30,"د",2,0],["ولو دهته الحياة آونة","لقصرت منه فسحة العمر",31,"ر",1,0],["وَلَو دَوى أَنَّ هُناك عَقرَب","لآثَرَ الغَصَّ عَلى أَن يَشرَب",32,"ب",1,0],["وَلَو دَفَعَ الرَدى المَحتومِ بَأسٌ","وَإِقدامٌ وَرَأيٌ وَاِعتِزامُ",33,"م",1,0],["ولو دافعت من دونه البيض والقنا","حكمنا بها قطعاً وبالسمر شرعا",34,"ع",2,0],["وَلَو دَعا بجماد الارض معجزة","لباه ترب واشجار واحجار",35,"ر",1,0],["وَلَو دُفِعَ الْحِمامُ بِعِزِّ قَوْمٍ","لَكُنْتَ أَعَزَّ ذِي عِنٍّ نَصِيراً",36,"ر",2,0],["وَلَو دَعَوتُ لَلَبَّتني ضراغمة","تَدأى إِلى جاحِمٍ بِالحَربِ مُشتَعِلِ",37,"ل",1,0],["وَلو درى ناظرٌ ماذا تضمَّنه","قلبي لأَصبح منه القلبُ ينصدع",38,"ع",1,0],["وَلَو دَاوَاكَ كُلُّ طَبِيبِ إنسٍ","بِغَيرِ كَلامِ لَيلَى مَا شَفَاكا",39,"ك",2,1],["وَلَو دَعا البَحرَ لِلطوفانِ مُعجِزَةً","لا غَرِقَت أُمَّةُ الكُفّارِ دَعوَتُهُ",40,"ت",2,0],["وَلودَينِ لِلبَيضِ الهِجانِ وَحالِكٌ","مِنَ اللَونِ غِربيبٌ بِهيمٌ عَلاهُما",41,"م",2,0],["وَلَو دَرى مسرى الصَبا نَحوَها","سَد مِنَ البُخلِ مَهَبِ الرِياح",42,"ح",1,0],["ولو درى النائمُ أيَّ قَدَمٍ","يُحرزها الساهر لاشتاق السَّهَدْ",43,"د",1,0],["ولوداًن ولِي من حظِّها بطنُ حائلٍ","معنَّسةٍ شابت وشابَ لِداتُها",44,"ت",3,0],["ولو دعيت نزال لقلت أهلا","فقبحا ويك للموت الزؤام",45,"م",1,0],["ولوْ دلَلْتَ عليهِ الناسَ ما جحَدوا","لكنّكَ ارْتحْتَ للدنيا وما تعِدُ",46,"د",1,0],["ولو درى أهلُ الهوى بالّذي","جَنَى الهوى من قبل لم يعشِقوا",47,"ق",3,0],["وَلَو دَرى مِن على حُزنٍ يقرّعنِي","بمن فُجعتُ ومن خُولستُه عَذَروا",48,"ر",3,0],["ولو دفعت كل الذي هو ملكها","على طلقة ما كان قلبي يخالع",49,"ع",1,0],["وَلوْ دَرَى الدَّهْرُ عَنِّي","جَاءت إِلىَّ شعُوبُ",50,"ب",1,0]]}