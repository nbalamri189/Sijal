abudhabi.ae/diwan/poem/103004","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103053","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29330","الرمل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76488","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136574",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83134","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33693","الخفيف"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35120","الخفيف"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35126","الرمل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67447","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204166","الخفيف"],[357,"الليل والذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=6324",""],[4755,"لا تَلُومُوا (شُبَاطَ).. فهو طَبِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=210278",""],[5010,"لا تزد قلبي جراحا","https://www.poetsgate.com/ViewPoem.aspx?id=190276",""],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5135,"أفكار المساء","https://www.poetsgate.com/ViewPoem.aspx?id=201888",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5277,"معارضةُ يائيةِ ابن الفارض(1)","https://www.poetsgate.com/ViewPoem.aspx?id=198943",""],[5277,"ويْ حبيبي..","https://www.poetsgate.com/ViewPoem.aspx?id=203366",""],[5388,"أقبل الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206922",""],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""],[5561,"شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=192903",""],[5561,"نجمة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=193221",""],[5561,"انعدام مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=195178",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5703,"في غياب القمر","https://www.poetsgate.com/ViewPoem.aspx?id=215498",""],[5878,"أيها الليل","https://www.poetsgate.com/ViewPoem.aspx?id=199219",""],[6102,"هذه ليلتي","https://www.poetsgate.com/ViewPoem.aspx?id=182769",""],[6361,"ليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66810&r=&rc=40",""]],"verses":[["أيها الليل … أنادي إنّما","هل أنادي ؟ لا … أظنّ الصوت وهمي",0,"م",2,0],["أَيُّها اللَيلُ أَنتَ أَبهى مِنَ ال","فَجرِ وَإِن كُنتَ أَسوَدَ الطَيلَسانِ",1,"ن",1,0],["أَيُّها اللائِمُ فيهِ","لا تُقَصِّر في مَلامي",2,"م",2,0],["أَيُّها اللائِمُ فيهِ","طابَ لي فيهِ المَلامُ",3,"م",1,0],["ايها الليل هل وراءك صبح","مؤذن بعد ريثه بانفلاق",4,"ق",1,0],["ايها الليل ان صبحك","حسبيلو انفجر",5,"ر",1,0],["ايها اللون الذي","غرني ما انصلك",6,"ك",1,0],["ايها الليل الذي","جنني ما اطولك",6,"ك",1,0],["أَيُّها اللُوّامُ ما أَظلَمَكُم","أَينَ لي العَقلُ الَّذي يُسعِدُ أَين",7,"ن",1,0],["أيُّها اللاّئمي على صَوْنِ وَجهْي","إنَّ بذْلَ الوُجوهِ شَيْنٌ وعارُ",8,"ر",1,0],["أيها اللائذُ بالصَّمتِ كَفَى","وأدِر وجهَكَ لي وانظر طويلا",9,"ل",2,0],["أَيُّها اللَيلُ الطَويلُ","سِر وَخَفِّف يا ثَقيلُ",10,"ل",1,1],["أَيُّها اللائِمي وَلَم آتِ بَأساً","يَشهَدُ اللَهُ وَالثَلاثُ الشُهودُ",11,"د",1,0],["أَيُّها اللّائِمونَ ماذا عَلَيْكم","أَنْ تَعيشُوا وأنْ أَمُوتَ بِدائي",12,"ي",1,0],["أَيُّها اللائمي على الصمت إيهاً","أَو ما قد دريت أني عليل",13,"ل",1,0],["أَيُّها الليل دلَّنا في سرانا","قبل أَن تعجل النجوم أفولا",14,"ل",2,0],["أيّها اللاعِبُ الذي فَرَسُ الشِّطْ","رَنْجِ هَمَّتْ في كفّه بالصّهيل",15,"ل",1,0],["أَيُّها الليلُ يا أبا البؤسِ والهَوْ","لِ يا هيكلَ الحَياةِ الرهيبِ",16,"ب",1,1],["أَيُّها الليلُ أَنْتَ نَغْمٌ شَجيٌّ","في شفاهِ الدُّهورِ بَيْنَ النَّحيبِ",16,"ب",1,0],["أيها الليل استطلْ مهما تشا","وتحكم يا كرى في المُقَلِ",17,"ل",1,0],["أَيُّها اللائِمُ الَّذي لامَ فيهِ","دَع مُحِبّاً بِجَهدِهِ أَو أَعِنهُ",18,"ن",2,0],["أيها الليل إنني من مكاني","لسلامي إلى نجومك أهدي",19,"ي",1,0],["أيها اللوام ويحكم","إن لي عن لومكم شغلا",20,"ل",2,0],["أيها اللابس الجمال أتستح","سنُ أن تجعل السقامَ لباسي",21,"س",2,0],["أَيُّها اللَيلُ ما ظَلَمتَ قُلوباً","لَو عَرَفت القُلوبَ ماذا تُكابِد",22,"د",1,0],["أيُّها الليلُ أعِد لي","ذلكَ الصَّوتَ الرخيما",23,"م",2,0],["أيُّها الليلُ لماذا","أنتَ بالنَّجمِ شحيح",24,"ح",1,0],["أَيُّها اللائم اذنى لا تعي","زخرف القول فدع عنك الملاما",25,"م",2,0],["أَيُّها اللائِمُ لا مِلْتَ إلى","قَولِ مَن عَنّفَ في الحُبِّ وَلامَا",26,"م",2,0],["أَيُّها اللائمُ المُخَطّي ومَحْوِي","عن بياضِ الفلا من العيسِ سَطرا",27,"ر",2,0],["أيها الليلُ لن يعيشَ الغريبا","نِ ولن يَلمُسَا مساءً جديدا",28,"د",2,0],["أيها اللائم لُمْ غي","ريَ فيما قد أتَينا",29,"ن",2,1],["أيها اللائمونَ في الحبّ كُفّوا","لومَ صبٍّ أضحى قريحَ مآقِ",30,"ق",1,0],["أيّها اللائمي على بدر تمّ","مستنير له من الحسن هاله",31,"ل",2,0],["أيُّها اللاحي عداني صبرهُ","لا تسل ما فعلت بي مقلتاها",32,"ا",3,0],["أيها اللائمي على الجزع البرح","على ساكن اللوى فالجزع",33,"ع",1,0],["أَيُّها اللائِمُ لي في حُبِّ مَن","لَيسَ يَرثي لِيَ مِن ذُلّي لَدَيهِ",34,"ي",2,1],["أَيُّها اللائِمُ الَّذي قَد رَماني","فَمُهُ اليَومَ بَينَ قالٍ وَقيلِ",35,"ل",1,1],["أيها الللاحي قصر النصح إنا","نحن قوم نرى العذول عدوا",36,"و",2,0],["أَيّها اللّائمُ الّذي لا يملُّ الل","لومَ صبحاً حتّى يلومَ عَشِيّا",37,"ي",2,1],["أيها اللائم الذي لام جهلاً","في هوى ذلك الغلام النفيسِ",38,"س",1,1],["أَيُّهَا اللاّئِم رِفْقاً","بِالذَّي قَدْ ذَابَ عِشْقا",39,"ق",2,1],["أيُّها اللابسُ السَوادَ ولا بدْ","عَ إذا كُنتَ تقتفي الخُلفاءَ",40,"ا",2,0],["أيها اللائم قم","إن ذا وقت النشور",41,"ر",1,0],["أيها اللاحي رويداً","لم يدع لي الحب مترك",42,"ك",1,1],["أيها اللاّحظي بطرف كليلِ","هل إلى الوصل بيننا من سبيلِ",43,"ل",1,1],["أيها اللائمي كم استصباحٍ","أعقبته العواقبُ استعشاشا",44,"ش",2,0],["أيُها اللائم المعنِّف أقصِر","أنا من لومك الملفَّق هازي",45,"ز",2,0],["أيها اللائم لي في لوعة","لا سبيل لي إلى كتمانها",46,"ن",3,0],["أيها الليل صرت عون شجوني","ولقد كنت مطمحاً ومراما",47,"م",2,0],["أيها اللائمي على حبها أق","صر فما أنت فيه من نصّاحي",48,"ح",2,0],["أيها اللاحي خف اللهَ ودعْ","فجناني في جنانٍ ورياضْ",49,"ض",1,0],["أيها الليل أنت أضللت فكري","وأمرت الخيال باستخدامي",50,"م",2,0],["أيها الليل طل علي فإني","أجتلي في دجاك ما أجتليه",51,"ي",2,0],["أَيُّها اللّيْلُ طُلْ بِغَيْرِ جَناحِ","لَيْسَ لِلْعَيْنِ راحَةٌ في الصَّباحِ",52,"ح",1,1],["أيّها اللامعاتُ فيهم غروراً","لابن دينارك استرقّي الخصيبا",53,"ب",2,0],["أَيُّها اللائِمي عَلى فَرطِ شَوقي","خابَ مَن غابَ عَن ذَويهِ وَذَلّا",54,"ل",2,0],["أيها اللائمون كفوا الملاما","إن لوم المحب كان حراما",55,"م",2,0],["أَيُّها اللائِمي عَلى نكد الدَه","رِ لِكُلِّ من البَلاءِ نَصيبُ",56,"ب",1,1],["أيها اللّوذعيّ إن جوابي","من حوى مقصّراً سيفيكا",57,"ك",2,1],["أَيُّها اللَيلُ أَتَدري","كَم صَريعٍ لِلغَواني",58,"ن",2,1],["أَيُّها اللائِمونَ كُفُّوا فَما أغ","فَلَ مَن نامَ عَن طولِ اللَّيالي",59,"ل",2,0],["أيُّها اللائمُ صَبَاً","كانَ في الحب عَميدا",60,"د",2,1],["أيها الليل أنت مرآةُ حظي","قمتَ تدني إليَّ يومً وفاتي",61,"ت",2,0],["أيها اللائمون قلبى على الحب","ب رويدا فما عسى تبتغونا",62,"ن",2,0],["أيها الليل لا تؤمّل خلوداً","عن قريب يمحو ظلامكَ ماح",63,"ح",1,0],["أَيُّها اللائِمي عَلى الحُبِّ مَهلا","هَل تُلام الحمام في التَّغريدِ",64,"د",1,0],["أيها اللائم أذني لا تيع","إنما مثلك من يدعو الرجاما",65,"م",2,0],["أيها الليل الذكيّ ترّنم","ودع الناس في جنون المعامع",66,"ع",1,1],["أيها اللّاهون عن جوهركم","بشظايا صدف نظّمتموها",67,"ه",2,1],["أيها الليل يمحق النورَ نورٌ","ليس لليل ضد نور سلاح",68,"ح",1,0],["أَيُّها الَّلاْئُمِ الْعُيُونَ إذا","أَبْصَرتْ مِنْ وَجْهِهِ جَمَالاً وَحُسْنا",69,"ن",2,0],["أيها اللحظ المريق دمي","أنت في حِلٍّ وفي سعةِ",70,"ه",1,1],["أَيُها اللائم قَلبي بِالهَوى","خلني وَاترك عَن القَلب الملاما",71,"م",2,0],["أيها اللاعبون يكفي سراعا","للوغى فوقكم ترف البنود",72,"د",1,0],["أيها اللائمُ في الحب","بِ لَحَاكَ اللّهُ حَسْبي",73,"ي",1,1],["أيُّها الَّلائِمُ دَعْنِي واسْتَرِحْ","مِن خليعٍ هو للنُّصْحِ عَصَى",74,"ص",2,1],["اَيُّها اللاهي عَن اللَهَ انتَبِه","حَيثُ عِندَ المَوتِ لا تَخشى الوَجَل",75,"ل",1,0],["أَيُّها اللَيلات ما غيري وَلا","غَيرُكم يذكرُ عهداً بالمغان",76,"ن",1,0],["أَيها اللائمون هَيهاتَ جدوى","لَيسَ يغني الملام بعد الفتون",77,"ن",1,0],["أَيُّها اللاحي الَّذي في الحُبَّ هاجا","شَوقُ قَلبي كُلَّما هاجَيتَ هاجا",78,"ج",2,1],["أيها اللائمُ الذي حَسبَ اللَّومَ","صلاحاً ما فيه لي من صلاحِ",79,"ح",1,0],["أيها الليل كم تطول كأني","راكب منك أدهماً مشكولا",80,"ل",2,0],["أيها اللائم المفنّد قلبي","ويك عني ما للملام ومالي",81,"ل",2,0],["أَيُّها اللَيلُ أَتَينا نَشتَكي","فَاِستَمَع شَكوى الحَزانى المُتعَبين",82,"ن",1,0],["أَيُّها اللماع يَمشي مسرعا","حامِلا صندوقه بين يديه",83,"ي",2,1],["أيهّا الليلُ هل لصُبحٍ مُحياً","يُخجل الشمسَ نورُه من طلوع",84,"ع",1,0],["أيهّا الليل هل عَثرت بطَيفٍ","من حَبيبي أم هل رأيت هجوعي",84,"ع",2,0],["أَيُّها اللائِمُ دَعهُ","فَلَهُ في الحُبِّ دِينُه",85,"ن",2,0],["أيُّها اللائِمون فيهِ أفِيقوا","أنا عبدٌ لهُ ووقفٌ عليهِ",86,"ي",2,0],["أَيُّها اللَيلُ هَل دَرى البَدرُ أَنّي","بِتُّ مِن أُختِهِ مَكانَ الضَجيعِ",87,"ع",1,0],["أَيُّها اللُوّامُ ما أَهدَأَكُم","عَن قُلوبٍ أَسهَرَتنا قَلَقا",88,"ق",2,0],["أيها اللايمي ترفق بقلب","ليس يسلي همومه لحي لاح",89,"ح",1,0],["أيها اللائم المضيق صدري","لا تلمني فكثرة اللوم تغري",90,"ي",1,1],["أيها الليل ترفق ...بالذي يخفى سهاده","أن في عيني جمرا ...لا تزد فيه اتقاده",91,"د",2,0],["أَيُّها اللَّائِمُونَ ذِكرَى شُبَاطٍ","لا يَعَافُ الدَّوَاءَ إِلَّا مُرِيبُ",92,"ب",1,0],["أيّها اللّيلُ ترفَّقْ","لا تزدْ قلبي جِرَاحَا",93,"ح",2,1],["أيها اللائمي لحبي عليا","قم ذميما إلى الجحيم خزيا",94,"ي",2,1],["أَيُّهَا الليْلُ تَرَحَّلْ","هَلْ يَنَامُ الليْلَ جَالِسْ",95,"س",1,0],["أيها اللائمون مهلا وعدلا","نحن لا الدين أس هذا الملام",96,"م",1,0],["أيها اللائمُ فيهم إنني","لم أزلْ أُفرغُ فيهمْ مقْلَتَيْ",97,"ي",1,0],["أيها \"اللا أنتَ\" إنّي \"لا أنا\"","إنْ جعلتُ الحبَّ للقلبِ انْتحارا",98,"ر",2,0],["أيُّها الليلُ عَتيقٌ","أنتَ لِلشاكي بُكاه",99,"ا",2,0],["أيها اللاعبون بالنار كفوا","قبل أن تذهب الجهود صليا",100,"ي",2,0],["أيُّها الّليلُ ما بطولِك همٌّ","لكِنِ القلبَ يعتريه السآم",101,"م",1,0],["أيها الليل تمهل ساعة","واسترح أنك أوفى الأصدقاء",102,"ا",2,0],["أيُّها الليلُ نحنُ أصدِقاءٌ","منذُ عصرِ التَّكوينِ والتَّكويرِ",103,"ر",1,0],["أيها الليل والمواجع شتّى","أفلا كنت عاشقاً مستهاما",104,"م",2,0],["أيها الليل ارمز أم ترى","أنت ستر للغيوب الخالدات؟",105,"ت",1,0],["أيها الليل فكم من عبر","تحت أستارك تبدو للحصاة",105,"ه",1,0],["أيها الليل فما سوى","نقطة سودا بأسمى الصفحات",105,"ت",1,0],["أيّها الليلُ أنتَ مثلي مُعَنّى","فَكلانا قد فارَقَ الأحبابا",106,"ب",2,0],["أَيُّهَا الَّليلُ هَل لِقَلبِي دَوَاءُ","أَم غَدَا الضَّيمُ دَرْبَنَا وَالعَنَاءُ",107,"ا",2,1],["أَيُّهَا الَّليلُ هَل لَنَا مِن مَحِيصٍ","صَارَ قَلبِي بِخَافِقَيهِ الخَوَاءُ",107,"ا",2,0],["أَيُّها الليلُ؛ لِلحَدِيثِ شُجُونٌ","عَبَراتٌ خَنِيقَةٌ وَحَيارى",108,"ر",2,0],["أيها الليل كف","عن هذا التواضع الكاذب",109,"ب",1,1]]}