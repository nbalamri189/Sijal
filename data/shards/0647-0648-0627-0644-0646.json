"https://www.poetsgate.com/ViewPoem.aspx?id=157927",""],[5397,"بآل محمدٍ عرف الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=157900",""],[5431,"في حب الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=202478",""],[4623,"خليلي زدني من مديح محمد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146771",""],[5790,"على حلب الغراء مني تحيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=111882",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[2220,"ذنبي عظيمٌ وذنبي لا يزايلني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11908&r=&rc=777",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""]],"verses":[["هُوَ النابِهُ النَيرانِ في كُلِّ ظُلمَةٍ","وَمُجري دِماءَ الكومِ كُلَّ مَساءِ",0,"ا",2,0],["هوَ النّصرُ بادٍ للعُيونِ صَباحُهُ","فمَا عُذْرُ صَدْرٍ ليْسَ يَبْدو انْشِراحُهُ",1,"ح",2,1],["هُوَ النَفسُ إِلّا أَنَّ آلَ مُحَمَّدٍ","لَهُم دونَ نَفسي في الفُؤادِ كَمينُ",2,"ن",1,0],["هو النصر معقود برايتنا الحمرا","على أنه في الحرب آيتنا الكبرى",3,"ر",2,1],["هو النَغَم الرقيق من المثاني","هو الأدب الرفيع هو العلوم",4,"م",1,0],["هُوَ النَخبَةُ الخَوّارُ ما دونَ قَلبِهِ","حِجابٌ وَلا حَولَ الفُؤادِ ضُلوعُ",5,"ع",1,0],["هُوَ النَخبَةُ الخَوّارُ ما دونَ قَلبِهِ","حِجابٌ وَما فَوقَ الحِجابِ ضُلوعُ",6,"ع",1,0],["هو النُّكرُ من وجهين غَصبٌ وبدعةٌ","وفي النكر من وجهين موضعُ مَعْتبِ",7,"ب",1,0],["هو النار من أي النواحي غشيتَها","تلقَّاك منها جانب يتسعَّر",8,"ر",1,0],["هو النخلةُ الطُّولى أبت أن تنالها","يدانِ ولكن ينْعُها مُتساقطُ",9,"ط",1,0],["هو النار فاصطلها واستضئ","بها في الدجى وتوقَّ الحرق",10,"ق",1,0],["هو النيلُ يجري في سواءِ سبيلهِ","فلا تنتحي عن قصدِهِ للمُعادلِ",11,"ل",1,0],["هو النصر مقروناً به العزُّ لم تزل","بألسنة الأيام آياته تُتلى",12,"ل",2,0],["هُوَ النَفيسُ الَّذي مَواهِبُهُ","أَنفَسُ أَموالِهِ وَأَسناها",13,"ا",3,0],["هو النصحُ إلّا أنّه غيرُ نافعٍ","إِذا لم يكُنْ لي بالسُّلُوِّ يدانِ",14,"ن",1,0],["هُوَ النَبَأُ العَظيمُ وَكَم بِأَرضِ","أُسيلَ دَمٌ عَلى خَدٍّ أَسيلِ",15,"ل",1,0],["هوَ النَّقَدُ المسلوبُ من غارَةِ الوَغَى","ولكنَّهُ في غارَةِ الشعرِ ضَيْغَمُ",16,"م",1,0],["هُوَ النَبِيُّ الَّذي آياتُهُ ظَهَرَت","مِن قَبلِ مَظهَرِهِ لِلناسِ في القِدَمِ",17,"م",1,0],["هُوَ النَّبِيُّ الذي أَفْضَى لِكُلِّ فَتَىً","بِأَنَّ فِيهِ نَبِيَّاً إِنْ هُوَ اْجْتَهَدَا",18,"د",2,0],["هُوَ النّجْدُ يقري الرمحَ والسيفَ كَفُّهُ","بِعُضوَين يُلْفَى فيهما العمرُ والذكرُ",19,"ر",1,0],["هُوَ النَفَلُ الحُلوُ الَّذي إِن شَكَرتَهُ","فَقَد ذابَ في أَقصى لَهاتِكَ حَلُّهُ",20,"ل",2,0],["هُوَ النَّبِيُّ الَّذي لَولاهُ ما قُبِلَت","رَجاةُ آدمَ لَمّا زَلَّ في القِدَمِ",21,"م",1,0],["هُوَ النَّصْرُ يا تَيْمَاءُ يَتبعُهُ النَّصْرُ","فإن كُنتِ في رَيْبٍ فقد وَضَحَ الأمرُ",22,"ر",1,1],["هو النّورُ نورُ اللّهِ يملأُ أرضَه","فتلقَى الهُدى فيه عصورٌ وأجيال",23,"ل",1,0],["هُوَ النَّهرُ يَفْصِلُ ما بيْننا","مُدلّاً بتَمساحهِ الغادرِ",24,"ر",1,0],["هُوَ النَّارُ في الأَحْشَاءِ لَكِنْ لِوَقْعِهَا","عَلَى كَبِدِي مِمَّا أَلَذُّ بِهِ بَرْدُ",25,"د",1,0],["هُوَ النَّبِيُّ الَّذي لَوْلا هِدَايَتُهُ","لَكانَ أَعْلَمُ مَنْ فِي الأَرْضِ كَالْهَمَجِ",26,"ج",1,0],["هو الندبُ في الحربِ ليثُ الوغى","وقد صارَ في السِّلم غيثَ الطعامْ",27,"م",1,0],["هو النبىُّ الرضىُّ المبعوثُ مِن مُضر","ناهيك من جدُّه عدنانُ أو مضرُ",28,"ر",1,0],["هو النجلُ من بيتٍ رفيعٍ عمادُه","تسلل من أصلٍ كريمِ المناسبِ",29,"ب",1,0],["هُوَ النَّدبُ أفَّاهُ الضَّنِينُ بِعِرضِه","ولَم يَكُ بالدُّرِّ الثَّمِينِ ضَنِينَا",30,"ن",2,0],["هو الناصر الملك الذي لا سحابه","جهام ولا ماضي سباه كهام",31,"م",1,0],["هو الناصر الدين الحنيف بسيفه","ومحيى نداً قد كان في ظلم اللحد",32,"د",1,0],["هو الناصر ابن الاشرف الملك أحمد","سلالة إسمعيل ليث الكتائب",33,"ب",1,0],["هو الناصر الإسلام وهو صلاحه","إذا ما بنا الإسلام مال عموده",34,"د",2,0],["هُوَ الناصِرُ بنُ المُستَضيء وَقِدحُهُ ال","مُعَلّى وَما في عُودِهِ الصُلبِ قادِحُ",35,"ح",1,0],["هُوَ النَصلُ لَكِن لا يحُسُّ غِرارَهُ","بَنانٌ وَبِالأَيدي تُحَسُّ المَناصِلُ",36,"ل",1,0],["هو الناسُ طُرّا في اعتزامٍ وقُدرةٍ","وفي الجود والفضلِ العَميم وَحيد",37,"د",1,0],["هو النيّرُ الأعلى إِذا الكون أظلما","بهِ الدينُ والدنيا بهِ الأرضُ والسما",38,"م",2,0],["هو الندب قد صيرت فرضا مديحه","ليحسن نظم المدح بالفرض والندب",39,"ب",1,0],["هُوَ الناصِرُ الدينَ الحَنيفَ بِسَيفِهِ","وَآرائِهِ وَاللَهُ بِالغَيبِ ناصِرُه",40,"ر",2,0],["هُوَ النجم المضيء لكل سار","هُوَ القمر المنزه عَن سرار",41,"ر",1,0],["هُوَ النُّور حَقاً والهُدى شدّ ما اقْتدَى","بِها حَائِدٌ ضَلَّ السبيلَ وحَائِرُ",42,"ر",1,0],["هُوَ النَمِرُ اليَقظانُ لا الفَهدُ نائِماً","كَثُعبانِ موسى وَهوَ أَحسنُ مُنسابِ",43,"ب",1,0],["هُوَ النَبي خِتامُ الرُسُلِ خَيرَهُم","إِسماً وَفِعلاً وَخَيرَ الناسِ أُمَّتُهُ",44,"ت",2,0],["هُوَ النَصل الَّذي الأعَدا أُغازي","بِهِ وبِنورِهِ الدُنيا أُغالي",45,"ل",2,0],["هو النّدى والزّمانُ الرّوضُ باكَرَهُ","حتّى غدا حُسْنُه بالطِيّبِ مُخْتلِطا",46,"ط",2,0],["هو النور للأكوان من غير مرية","فلا عجب أن لا يكون له ظل",47,"ل",1,0],["هُوَ النَّادي وأَنتَ به أُنادي","فيامروي الحيا موري الزنادِ",48,"د",1,1],["هُوَ النَّصْرُ والتَّمْكِينُ أَدْرَكَ طالِبُهُ","ولاحَتْ وَشيكاً بالسُّعودِ كواكِبُهْ",49,"ب",2,1],["هو النُّجْحُ لا يُدْعى إِلَى الصُّبح شاهِدٌ","هو النور لا يُبغى عَلَى الشَّمْسِ بُرْهَانُ",50,"ن",1,0],["هو النجاةُ وأخوه الملحُ لا","يسلمُ من أخطاره المستلم",51,"م",1,0],["هو النجمُ لا العرضُ منهُ يباح","كلاَّ ولا مالهُ يختزن",52,"ن",1,0],["هو النجمُ كذّب فيه العدى","وصدق في سعدهِ كلُّ ظنِّ",53,"ن",1,0],["هو النسبُ الزاكي أناف بفضله","وصيٌّ سبق العلا ورسول",54,"ل",1,0],["هو النَّبيُّ الَّذي أحْيى القُلُوبِ به","مولاهُ فضْلاً بدِينٍ غيرَ مَنْكورِ",55,"ر",1,0],["هو النجم المنود نال اوجه","حماه اللَه عن اثر الوبال",56,"ل",1,0],["هو النّورُ الّذي لولاه لاقَتْ","بُدورُ المجدِ في التِمِّ السِّرارا",57,"ر",2,0],["هو النور إلا أنه هو ظلمة","وضدان أمر مستحيل لذائق",58,"ق",1,0],["هو النور عنها قد أبان وعنه قد","أبانت وكلٌّ ذو وفاً بعهود",59,"د",1,0],["هو الندب عبد اللّه مَن لم نجِد له","سِوى المجد حِلفاً والعلى خير صاحبِ",60,"ب",1,0],["هو النقيبُ الزعيم المرتدي بعلا","لم يتّخذ غير فعل الخيرِ مُكتسبا",61,"ب",2,0],["هُوَ النّاسُ كُلٌّ فاغنَ مِنهُ بِظِلِّهِ","وَخلِّ فُلاناً عَنكَ وابنَ فُلانِ",62,"ن",1,0],["هو النجم إلا أنه البدر كاملا","على أنه شمس الضحى في التعادل",63,"ل",1,0],["هو النجم من أفق المعارف قد هوى","فعاد دجى ضوء البدور الكوامل",63,"ل",1,0],["هو النير الموفي الذي كل نير","له هالة والبحر والبحر ساحله",64,"ل",2,0],["هو النقي الذي يرضيك باطنه","من الصلاح كما يرضيك ظاهره",65,"ر",2,0],["هو الناصر الدين الحنيفي قدومه","ورافع رايات على السنة الغرا",66,"ر",2,1],["هُوَ النَّجمُ لَو ضَلَّت فُهومٌ بِمشكلٍ","لَكانَت كَمَن بِالنَّجمِ لَيلاً قَدِ اِهتَدى",67,"ا",1,0],["هو النورُ الذي افتخَرَتُ","بطلعته بنُو ذُهْل",68,"ل",1,0],["هو النسبُ الزاكي أناف بفضله","وصيٌّ حوى سبق العلا ورسول",69,"ل",1,0],["هو النجد المنجد المستما","ح واليقظ السيد الأيّدُ",70,"د",1,0],["هو النقطة الأولى التي امتد خطها","فمدت بها أشكال وضع مهندس",71,"س",1,0],["هو النجم الساري هو الصبح للهدى","هو الغيث للعافي هو الغوث للنسي",71,"س",2,0],["هو النقطة الأولى التي قد تاصلت","هو الجوهر الفرد الذي لن يقسما",72,"م",2,0],["هو النقطة الأولى التي امتد خطها","إلى أن نشت عنها خطوط الطوالع",73,"ع",1,0],["هو النقطة الأولى التي امتد حظها","إلى أن نشبت عنه بدور وأنجم",74,"م",1,0],["هو النذير فحاذر أن يغرك ما","يلهيك عنه فللآجال ميقات",75,"ت",1,0],["هو النور نور الله والنور مشرق","علينا ونور اللّه ليس يزول",76,"ل",1,0],["هو النقطة الغرّاء والعلّة التي","بتكييفها الآراءُ لا تتقلَّب",77,"ب",1,0],["هو النجل شبل الليث ذاك الذي علا","على كل مقدامٍ بلطف الشمايلِ",78,"ل",1,0],["هو النور المبين به اهتدينا","هو الداعي إلى اقوى سبيل",79,"ل",1,0],["هو النور يهدي الحايرين ضياؤه","وفي الحشر ظل المرسلين لواؤه",80,"ا",3,1],["هو الناصر الأمر الالهي حازماً","منيعاً علياً في مقام المعية",81,"ه",1,0],["هو النُّضار المُصفَّى سرُّ جوهرِه","والنَّاسُ من بعدُ أشباهٌ وأشباهُ",82,"ا",2,0],["هُوَ النَّارُ وَالنَّاسُ الهَوَاءُ إِذَا بَدَا","وَلاَ شَكَّ أَنَّ النَّارَ تَعْلُو عَلَى الثَّوَى",83,"و",2,0],["هُوَ النَّاصِرُ الْمَنْصُورُ أَكْرَمُ مُصْرِخٍ","إِذَا مَا أَتَاهُ يَبْتَغِي النَّصْرَ صَارِخُ",84,"خ",1,