{"poems":[[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[45,"ومنزل ليس لنا بمنزل","https://www.aldiwan.net/poem10111.html","الرجز"],[63,"وشاحب اللبسة والأعضاء","https://www.aldiwan.net/poem51835.html","الرجز"],[48,"عن لا عج باتوا برملة عالج","https://www.aldiwan.net/poem22266.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147506","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[102,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[45,"ومنزل ليس لنا بمنزل","https://www.poetsgate.com/ViewPoem.aspx?id=417",""],[92,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[133,"حدث الشاعر عن نور القمر","https://www.aldiwan.net/poem60382.html","الرمل"],[190,"ما لعيني مذ هويت اغتماض","https://www.aldiwan.net/poem43663.html","الخفيف"],[199,"ليت شعري هل تخبرني الديار","https://www.aldiwan.net/poem54408.html","الخفيف"],[234,"عن لي أن أقبلك","https://www.aldiwan.net/poem50890.html","مجزوء الخفيف"],[385,"أسلموني لسهادي","https://www.aldiwan.net/poem48796.html","مجزوء الرمل"],[435,"أقبلت تنثني بأعدل قامه","https://www.aldiwan.net/poem40713.html","الخفيف"],[435,"جد وحدث عن العيون الكحال","https://www.aldiwan.net/poem41401.html","الخفيف"],[463,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[487,"حدثني صبح دياجي الخندس","https://www.aldiwan.net/poem24431.html","عموديه"],[556,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[563,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[591,"فدتك نفوس قد حلا بك حالها","https://www.aldiwan.net/poem17657.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53953","الرمل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199561","المسحوب"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142198","الرمل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216887","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49000","الرمل"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216588",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93668","الرجز"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105590","السريع"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100291","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127368","الرمل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89043","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36771","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103005","الخفيف"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36346","الدوبيت"],[4611,"","https://poetry.dctabudhabi.ae/diwan/poem/124100","الخفيف"],[4728,"الطفل ودموع الأمتين","https://www.poetsgate.com/ViewPoem.aspx?id=176955",""],[4755,"عَمَّ يَتَحَدَّثُون ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=184735",""],[4916,"مشتاقه","https://www.poetsgate.com/ViewPoem.aspx?id=136241",""],[4119,"أشرق البهو يا جبين الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=16212",""],[5092,"هموم","https://www.poetsgate.com/ViewPoem.aspx?id=182903",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5431,"في الدير أوجاع الفرات جحافلٌ ...","https://www.poetsgate.com/ViewPoem.aspx?id=201024",""],[5444,"رُّمانُ.. وأيلولُ أسود","https://www.poetsgate.com/ViewPoem.aspx?id=205085",""],[5747,"ماجيت أقدم عن غلاك إعتذاري","https://www.poetsgate.com/ViewPoem.aspx?id=61606",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""]],"verses":[["عَنَّ لَنا سِربٌ بِبَطنِ الوادي","يَقدُمُهُ أَقرَنُ عَبلُ الهادي",0,"ي",1,0],["عن لسانٍ أرقَّ حدّاً من السي","فِ دليلٍ على طباع زُلالِ",1,"ل",1,0],["عن لي يا هزار اغنية النو","م على قبري كي يطيب رقودي",2,"د",2,0],["عَنَّ لَنا فيهِ مُراعي مُغزِلِ","مُحَيَّنُ النَفسِ بَعيدُ المَوإِلِ",3,"ل",1,0],["عَنَّ لنا في حُلَّتَي عَناءِ","من صنعةِ الإدلاجِ والإسراءِ",4,"ا",2,0],["عَن لا عِجٍ باتوا بِرَملَةِ عالِجِ","في رَبوَتَي عَودٍ كَظَهرِ الفالِجِ",5,"ج",1,1],["عنّ لهم في سربهم مورد","لو كان يروي مثله لارتووا",6,"و",3,0],["عَنَّ لِلْغاشِمِ أَنْ يُطْعِمَهَا","لِجِيَاعِ الوَحْشِ فِي المَلْعَبِ جَهْرَا",7,"ر",2,0],["عن لقا ألزاسه أو يقتل","فلتك الألزاس يا سين لهم",8,"م",1,0],["عَنَّ لي لو تَحمِلُ الأجيالَ يا","أنتَ أَضحَت أشمَخُ القِمَّاتِ سَفحَك",9,"ك",1,0],["عَنَّ لَنا فيهِ مُراعي مُغزِلِ","مُحَيَّنُ النَفسِ بَعيدُ المَوئلِ",10,"ل",1,0],["عن لطيفٍ في ساعَتيه مَهيبٍ","وأديبٍ في موقفَيه ظريف",11,"ف",1,0],["عن ليالٍ عَبَرَت ما عابَها","في التَلاقي والرِضى إِلّا القِصَر",12,"ر",1,0],["عن ليالي الوَيلِ عن قَطعِ الرَجا","عن دنوِّ البَينِ عن بُعدِ المَفّر",12,"ر",1,0],["عنّ لي حبّه وقد عبث الشي","ب برأسي وفي قناتي انخفاض",13,"ض",1,0],["عَن لِسانٍ كَجُثَّةِ الوَرِلِ الأَص","فَرِ مَجَّ النَدى عَلَيهِ العَرارُ",14,"ر",1,0],["عنّ لِي أن أُقَبِّلَكْ","فارضَ مِنّي بذاكَ لَكْ",15,"ك",1,1],["عَن لي يَرق كَليل","دونَهُ بيض غَواد",16,"د",1,0],["عنّ لي ذكر بارق بالثنايا","وعذيبٍ لما رأيت ابتسامه",17,"م",2,0],["عن لحاظ لحظن قلبي انكساراً","فاتكات يرشن سمر النبال",18,"ل",1,0],["عنَّ لها والشروعُ حيثُ ترى","أشعثُ باقي قميصه رسمُ",19,"م",1,0],["عن ليالي الأنس عن سر غدا","بيننا يسعى بكهف المجلس",20,"س",1,0],["عَنَّ لنا منكِ على وادي مِنى","نَوْءُ غرامٍ ليته ما كان عَنْ",21,"ن",1,0],["عن لسان الملأ الأع","لى وهاتيك الذوات",22,"ت",1,0],["عَنَّ لي دُمْيَةً وَلاحَ هِلالا","وَانْثَنَى صُعْدَةً وَفرَّ عَزَالا",23,"ا",1,0],["عَنَّ لِي يوماً وقلبي سالمٌ","فعَنانِي بالغرامش حين عَنْ",24,"ن",1,0],["عن لا يغرّك لو يطيب لسانها","يخبث إلى صار الفواد عليل",25,"ل",1,0],["عن لي لحن الرضى في نشوة","واترك الأيام تصغي للصدى",26,"د",2,0],["عن لسانٍ كجثّةِ الورلِ الأحْ","مر مَجَّ النّدى عليه العَرارُ",27,"ر",1,0],["عنَّ لي الحُلمِ ظبيٌ","شاردٌ قلبيَ كلّمْ",28,"م",1,1],["عَنْ لا تْهَقِّي بيفوتني شَيّ","يدوّر لْمَدْخُوله أسباب",29,"ب",1,0],["عَنَّ لَها بَرق الحِمى فَشاقَها","فَألفتت عوج الطلا أَعناقَها",30,"ق",3,1],["عنّ لقلبي فيه فاشتاقه","ماض من العيش عهدناه",31,"ا",2,0],["عنَّ لي أطرح الحبالة ختلاً","وحذاري من أن يعنّ حذارُه",32,"ر",2,0],["عن لي يا طير من لحنك ما","يبعث الآمال في النفس اليؤوس",33,"س",1,0],["عن له في مدلهم عرضا","ولهلاك نفسه تعرضا",34,"ض",2,0],["عن لا وليت وعن لولا وما وعسى","ما كان من ذاك في شيءٍ بمنتقد",35,"د",1,0],["عَن لَوعَةٍ عَن زَفرَةٍ","عَن مُقلَةٍ قَرحى وَعَن",36,"ن",1,0],["عنَّ لي في القِباب من عرفات","رشأ لحظه عِقال العقول",37,"ل",1,0],["عَن لَهويَ هَل يَكفُّني التَوبيخُ","وَالعَيشُ لَهُ يوميَ ذا تاريخُ",38,"خ",1,1],["عن ليال لنا مضت طيّبات","وعن أيامنا اللذاذ التصابى",39,"ب",2,0],["عن لحد من تختٍ وعن كفن من طيلسان","ساد من هو كان مخلوق من ماءٍ مهين",40,"ن",1,0],["عَن لَجنَةِ التَّحقِيقِ إنْ بَاشَرَت","أعمَالَهَا بالطَّمسِ لِلحَادِثِ ؟",41,"ث",1,0],["عن لذيذ النوم .. والله صامت","احرمتني ..[ متعة الذوّاقه ] !!",42,"ق",2,0],["عن ليال حجبن عنا سناها","إنما غيبة الهلال ليالي",43,"ل",2,0],["عن لمسةٍ عُذريّةٍ ما لُومستْ","عن قُبلةٍ فوق الشفاه رضابُ",44,"ب",1,0],["عن لم يكن في معادي آخذاً بيدي","إلى السويِّ فلحماني على وضم",45,"م",1,0],["عن لحن نايٍ عابرٍ لسمائه","يبكي بحرقة عاشقٍ أحبابه",46,"ب",2,0],["عن ليلةٍ كتبَت نهايةَ قصةٍ","فيها السوادُ يُبدِّدُ الألوانا",47,"ن",2,0],["عن [ لوعتي ] يابنت لو كان تدرين","..[ ما لاعني ] همك على غير طاري",48,"ر",2,0],["عنْ لا مساسَ يمسّ ما لا ينمحي","يروي لتائبةِ الخطايا ما الزللْ",49,"ل",1,0]]}