{"poems":[[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[268,"أيا طالب الدنيا وتارك الاخرى","https://www.aldiwan.net/poem69127.html","عموديه"],[439,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"]],"verses":[["وصكت وجوه لم تكن قبلُ لطمت","وأُرخى منها في مناكبها الشعر",0,"ر",1,0],["وَصكت حنانٌ أمُّه الوجه للأسى","وَعضت بأَطراف البنان من الثكل",1,"ل",1,0],["وصك بمثل الصخر سمعي نعيه","فشبهت بالخنساء إذ فقدت صخرا",2,"ر",2,0],["وصَكُّ الموجِ فِيهَا كُلَّ وَجْهٍ","وُجُوهاً ساوَرَتْهُمْ بالجَفاءِ",3,"ا",2,0]]}