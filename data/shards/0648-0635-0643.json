{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[273,"أيا طالب الدنيا وتارك الاخرى","https://www.aldiwan.net/poem69127.html","عموديه"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96458","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89561","الطويل"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34711","المنسرح"],[5431,"ليته كان شفّر !!","https://www.poetsgate.com/ViewPoem.aspx?id=203703",""],[5493,"معراج الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=203377",""]],"verses":[["وصكت وجوه لم تكن قبلُ لطمت","وأُرخى منها في مناكبها الشعر",0,"ر",1,0],["وَصكت حنانٌ أمُّه الوجه للأسى","وَعضت بأَطراف البنان من الثكل",1,"ل",1,0],["وصك ثغور القاسطين بقيلق","له مدد من ربه وظهير",2,"ر",1,0],["وصك بمثل الصخر سمعي نعيه","فشبهت بالخنساء إذ فقدت صخرا",3,"ر",2,0],["وصَكُّ الموجِ فِيهَا كُلَّ وَجْهٍ","وُجُوهاً ساوَرَتْهُمْ بالجَفاءِ",4,"ا",2,0],["وَصَكَّت عَلَينَا قَومَنَا مشن وَرَائِنَا","فَكَم مِن قَتِيلٍ بَينَنَا وَمُقَاتِلِ",5,"ل",1,0],["وَصُكَّ له صَكٌّ إِلى النارِ بعدَ ما","يُحَمَّلُ من أَوزارِهِم وَيُعَذَّبُ",6,"ب",1,0],["وَصَكَّها صَكَّةً فَما لَبِثَت","أَن وَرَدَت عَسكَرَ المَكاسيرِ",7,"ر",1,0],["وصكوكا من العمالة نقدا","ليس إلاه أخضرٌ ما تحمّر !!",8,"ر",1,0],["وصكوكُ دجالِ المحبةِ حِلُّهُم","وحرامُنا أنْ نقرأ الآياتِ",9,"ت",1,0]]}