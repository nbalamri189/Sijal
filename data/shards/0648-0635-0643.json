{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[272,"أيا طالب الدنيا وتارك الاخرى","https://www.aldiwan.net/poem69127.html","عموديه"],[443,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"]],"verses":[["وصكت وجوه لم تكن قبلُ لطمت","وأُرخى منها في مناكبها الشعر",0,"ر",1,0],["وَصكت حنانٌ أمُّه الوجه للأسى","وَعضت بأَطراف البنان من الثكل",1,"ل",1,0],["وصك ثغور القاسطين بقيلق","له مدد من ربه وظهير",2,"ر",1,0],["وصك بمثل الصخر سمعي نعيه","فشبهت بالخنساء إذ فقدت صخرا",3,"ر",2,0],["وصَكُّ الموجِ فِيهَا كُلَّ وَجْهٍ","وُجُوهاً ساوَرَتْهُمْ بالجَفاءِ",4,"ا",2,0]]}