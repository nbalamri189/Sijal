{"poems":[[88,"لاح منها حاجب للناظرين","https://www.aldiwan.net/poem68836.html","الرمل"],[53,"لهف نفسي على رصاص مذاب","https://www.aldiwan.net/poem8508.html","الخفيف"],[58,"ليتني لم أكن لعطفك نلت","https://www.aldiwan.net/poem58631.html","الخفيف"],[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[347,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[396,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[458,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77523","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111887","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66314","الرمل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32582","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216704","الرمل"],[5431,"بنٌ أفّاك!...","https://www.poetsgate.com/ViewPoem.aspx?id=208853",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["قالَ ذا رَبّي فَلَمّا أَفَلَت","قالَ إِنّي لا أُحِبُّ الآفِلين",0,"ن",1,0],["قال ذاك الصبَّابُ قل لي أبا الحا","رث قل لي يا حاطمَ الأصلابِ",1,"ب",1,0],["قالَ ذُو الجَهْلِ قَدْ حَلُمْتَ ولا أَعْ","لَمُ أَنِّي حَلُمْتُ حتى جَهِلتُ",2,"ت",1,0],["قال ذُو أمرِهِم أَغِثْنا ولا تَعْ","نَفْ علينا إنّ القلوبَ لَتَعْمَى",3,"م",2,0],["قال ذا صعب ولكن","وردتي تهدي اليكَ",4,"ك",1,0],["قال ذا القول سادات عدول","نصح لله حقا والرسول",5,"ل",1,0],["قال ذو القرنين يا قوم اثبتوا","لا تهولنّكم كثرتهم",6,"م",1,0],["قال ذاك الطاغوتُ من أنتض ما مع","نى مصابيحكم أهذا جَنانُ",7,"ن",1,0],["قالَ ذو العَجز صالح وَهوَ مَجدي","أَصلح اللَه حالَهُ وَهَداه",8,"ا",2,0],["قالَ ذي رائِحَة مَمدوحة","وَكَذاكَ الوَرد مؤذٍ للجُعَل",9,"ل",1,0],["قال ذي خمرةٌ رمتَ وَرداً","هاكَ خدّي فماؤُهُ ماءُ وردِ",10,"د",1,0],["قال ذو العرش طريقي","قال دعني في طريقي",11,"ق",2,0],["قال ذو العرش نبي","قال قدمت رفيقي",11,"ق",2,0],["قال ذو العرش حسابي","وعذابي وحريقي",11,"ق",2,0],["قالَ ذَرني فَلَن أُطيقَ دَنُوّاً","مِن نَبيذٍ يَشُمُّهُ المَزكوم",12,"م",1,0],["قال ذو القرنين إني باسط","لك فيئاً فاسكني أو فاهجري",13,"ر",2,0],["قال ذُقْ من عجائبي واختبرني","لا عليكَ!...وقد بدا الإرباكُ",14,"ك",1,0],["قِ الَّذي في فُؤادِه اللَه أَدخل","فَلِهَذا من ارتَضى الأدم بالخل",15,"ل",1,0]]}