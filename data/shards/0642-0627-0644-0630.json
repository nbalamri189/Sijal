{"poems":[[86,"لاح منها حاجب للناظرين","https://www.aldiwan.net/poem68836.html","الرمل"],[51,"لهف نفسي على رصاص مذاب","https://www.aldiwan.net/poem8508.html","الخفيف"],[56,"ليتني لم أكن لعطفك نلت","https://www.aldiwan.net/poem58631.html","الخفيف"],[105,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[342,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[391,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[443,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[453,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"]],"verses":[["قالَ ذا رَبّي فَلَمّا أَفَلَت","قالَ إِنّي لا أُحِبُّ الآفِلين",0,"ن",1,0],["قال ذاك الصبَّابُ قل لي أبا الحا","رث قل لي يا حاطمَ الأصلابِ",1,"ب",1,0],["قالَ ذُو الجَهْلِ قَدْ حَلُمْتَ ولا أَعْ","لَمُ أَنِّي حَلُمْتُ حتى جَهِلتُ",2,"ت",1,0],["قال ذُو أمرِهِم أَغِثْنا ولا تَعْ","نَفْ علينا إنّ القلوبَ لَتَعْمَى",3,"م",2,0],["قال ذا صعب ولكن","وردتي تهدي اليكَ",4,"ك",1,0],["قال ذا القول سادات عدول","نصح لله حقا والرسول",5,"ل",1,0],["قال ذو القرنين يا قوم اثبتوا","لا تهولنّكم كثرتهم",6,"م",1,0],["قال ذاك الطاغوتُ من أنتض ما مع","نى مصابيحكم أهذا جَنانُ",7,"ن",1,0]]}