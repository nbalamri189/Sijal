{"poems":[[80,"يا خبر من يلحظه ناظري","https://www.aldiwan.net/poem14166.html","السريع"],[91,"في الفن معنى حسنه لا يعرف","https://www.aldiwan.net/poem44754.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55194","البسيط"],[376,"قلبي مع الحيوان لا","https://www.aldiwan.net/poem57256.html","مجزوء الكامل"],[435,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54020","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76172","الرجز"],[2734,"","https://poetry.dctabudhabi.ae/diwan/poem/101411","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201887","السريع"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83143","البسيط"],[6093,"كالنجم يمدحه ثناء الكوكب","https://www.poetsgate.com/ViewPoem.aspx?id=214136",""]],"verses":[["اللَفظُ وَالقِرطاسُ إِن شُبِّها","قيلَ هُما مِسكٌ وَكافورُ",0,"ر",1,0],["اللفظ والمعنى جناحا طائر","غرد يطوف بروضه ويرفرف",1,"ف",1,0],["اللَّفْظُ حُلْوٌ وَالفِكْرُ حُلْوٌ","وَاسْمُ الأدِيبِ المَجيدِ حُلْوُ",2,"و",1,0],["اللِّفتُ والكُرَّاث والقُن","نَبيطُ والجَزَرُ الصَّليقُ",3,"ق",1,0],["اللفاتٌ تزري بقد الغواني","حين تجلى بثوبها الحبريّ",4,"ي",1,0],["اللَّفْظُ لِلْمَعْنَى غَدَا طِبْقاً لَهُ","كَالطَّبْقِ فِي الإِيجَازِ وَ الإِطْنَابِ",5,"ب",1,0],["اللفظ صوت أحرف من الفم","جنسٌ يعمّ مطلق التكلم",6,"م",1,0],["اللَّفظُ هُم أنشَوا لَهُ مَعنًى بِذَا","كَ الإصطِلاَحِ وَذَاكَ أمرٌ دَانِ",7,"ن",1,0],["اللَفظ إِن أريدَ مِنهُ الظاهِرُ","حَقيقة مجازُه مغاير",8,"ر",1,1],["اللفظ بذله مع المعنى وذا التح","ريف من يرضي عدا البلداء",9,"ا",2,0],["اللفظ لا يكفيك عند البيانْ","لفهم من لم يستمعْ بالجَنْان",10,"ن",1,1],["اللَفظُ يَثقُل بِالتَرديدِ مَوقعه","وَتِلكَ تَحلو مَعانيها بِتَرديد",11,"د",1,0],["اللفظة الحسناء بنت لسانه","وجوابه لمهذب بمهذب",12,"ب",1,0]]}