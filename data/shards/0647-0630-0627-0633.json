],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5542,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=10200",""],[5595,"نِعْمَ القريضُ الشعرُ حينَ رواها","https://www.poetsgate.com/ViewPoem.aspx?id=144567",""],[5790,"مولاي حاشاك أن تصغى إلى عذل","https://www.poetsgate.com/ViewPoem.aspx?id=112118",""],[5815,"رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=190221",""],[5829,"رمضان مهلا","https://www.poetsgate.com/ViewPoem.aspx?id=204864",""],[5887,"أحيمد","https://www.poetsgate.com/ViewPoem.aspx?id=35261",""],[5956,"بين الحقيقة والمنى","https://www.poetsgate.com/ViewPoem.aspx?id=182539",""],[5956,"نشتاق يا جَدِّي إليكِ وأسرتِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=200897",""],[6045,"وجمة غضب ونغمة طرب","https://www.poetsgate.com/ViewPoem.aspx?id=162864",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6093,"الكُلُّ يخطيءُ تارةً ويُصيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=205649",""],[6162,"مَا لمْ تَقلهُ المرَايْا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69309&r=&rc=2",""],[6355,"إنجازات تربيتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66637&r=&rc=97",""]],"verses":[["هَذَا سُلَيْمَانُ النَّبِيُّ ابْتَزَّهُ","الْكُرسِيَّ بَعْضُ الْجِنِّ فيِمَا يُنْقَلُ",0,"ل",1,0],["هَذا سُلَيمانُ بنُ وَهبٍ بَعدَ ما","طالَت مَساعيهِ النُجومَ سُموكا",1,"ك",2,0],["هَذا سِنانٌ زاغِبِيٌّ في الوَغى","وَكَأَنَّما هَذا ذُبابُ مُهَنَّدِ",2,"د",1,0],["هَذا سَحابٌ أَنتَ سُقتَ غَمامَهُ","وَعَلَيكَ بَعدَ اللَهِ فَيضُ غَمامِهِ",3,"م",2,0],["هذا سَبيلُ المُؤمنينَ لكم بهِ","أجرُ المُجاهدِ والمجاهِدُ يُؤْجَرُ",4,"ر",1,0],["هذا سُهَيْلٌ جاءَ يحملُ سُؤْلَهم","وَيَعيبُ ما صَنَعَ الرُّماةُ وَيندم",5,"م",1,0],["هذا سليمانُ النبيُّ لما سها","عن بعض حق للإِله وقصرّا",6,"ر",2,0],["هَذا سَليلُ بَنِي نِقولا قَد غَدا","كَالبَدرِ في طَيِّ المَقابرِ يُرمَسُ",7,"س",1,1],["هذا سماء أياديه تفيض لنا","منها النوال وسحب الجود تتهمر",8,"ر",1,0],["هذا سؤالي إليكم","لقد عدلت فجرتم",9,"م",1,0],["هذا سعيدٌ أميرُ الخلقِ كُلِّهُمُ","زَكَتْ لَهُ في أصُولِ الفَخْرِ أعْرَاقُ",10,"ق",1,0],["هذا سعيدُ الذي بانَتْ مَعَالِمُه","سليلُ ثانيَ مِطْعانَ ومِنْفَاقُ",11,"ق",1,0],["هذا سعيد الذي تهمي أناملُهُ","غيثاً من الذَهَب القاني أو الدُّررِ",12,"ر",1,0],["هذا سعيد بن سلطان شواهره","كالشمس لا يُخْفِيها قُفْلٌ ومِفْتاحُ",13,"ح",1,0],["هذا سكون مريح","لمن أطال النضال",14,"ل",1,0],["هذا سؤال ولكن","ماذا جواب السؤال",14,"ل",1,0],["هَذا سَميك أَحمد قلق الحشا","أَتراك تغفل عن سميك أَحمَد",15,"د",1,0],["هذا سجين أضالع","فنيت على جمر الشكاة",16,"ه",1,0],["هذا سلامي لا يفي إن لم يصل","جبريلُ نظمَ سلامه بسلامي",17,"م",2,0],["هذا سلامٌ والصدورُ رحابُ","وهوى المنازلِ في الفؤاد حِرابُ",18,"ب",1,1],["هذا سؤالي أتى من عالم فطن","قد حل مني محل الروح من بدني",19,"ن",2,1],["هذا سبيل رائق","ماءُ الصفا منه جرى",20,"ر",2,1],["هذا سعيد فلا يشقى وذاك فلم","يسعد شقي علينا حكمه فرضا",21,"ض",2,0],["هذا سليمان الفتى ومحمد","ومحمد وحبا الربيع ربيعا",22,"ع",2,0],["هذا سَبوقٌ للأجا","وِدِ وهو سَبَّاق الجِيادِ",23,"د",1,0],["هذا سميك يا خير الأنام أتى","للحاكم العدل بالآتي أباطيلا",24,"ل",2,0],["هذا سجين ولا يدري له سببا","قضى السنين كما شاؤوه إهمالا",25,"ل",2,0],["هذا سؤال على عقول","أتى بعلم ونفي جهل",26,"ل",1,0],["هذا سليمانُ لطفٍ طابَ موْرِدُهُ","بروحِ فصلِ خطابِ اللُّطفِ والحِكَمِ",27,"م",1,0],["هذا سلَيمانُ الوَرَى لكنَّهُ","في طاعةِ الرَّحمن إبراهيمُ",28,"م",1,0],["هذا سليمان الزمان بحكمة","تستصحبُ الرأي الأسدّ الأصوبا",29,"ب",2,0],["هذا سبيل حاله فاسد","وزيره يرشح من قعره",30,"ر",2,0],["هذا سليلُ محمّدٍ","لِبني الولا كهفٌ وعِصمَه",31,"م",2,0],["هذا سليمانٌ أتى","للنعشِ يسعى في عديدِ",32,"د",1,0],["هذا سلامٌ إليه اليومَ ابعثهُ","مضمَّخاً بشذآءِ العنبر العَطِرِ",33,"ر",1,0],["هذا سلام محب هزّه طرَب","يهدي إلى البحر من در الثنا طبقا",34,"ق",2,0],["هذا سلام مقصِّر","بالأكرمين لهُ التزامْ",35,"م",1,0],["هذا سبيلُ بني الزّمان وقد","يبلى الورى وصروفه جُدُد",36,"د",1,0],["هذا سؤال شج أبدى ظلامته","وأنت يا غاية الامال مسؤول",37,"ل",1,0],["هَذا سَبِيلٌ فِي سَبِيلِ مُهَيمَنٍ","أجرَاهُ مَنْ أولَى الجَمَالَ جَمِيلهُ",38,"ل",2,1],["هذا سليمانُ على مُلكهِ","والجِنُّ والإِنسُ له حُشَّدُ",39,"د",1,0],["هذَا سِرَاجُ الكَونِ هذَا المُصطَفى","هذَا الشَّفِيعُ لِكُلِّ مَن قَد أُرجِفَا",40,"ف",2,0],["هذا سبيل نجاةٍ واعتقاد هدى","لذي الكمال بحكم العقل والفطن",41,"ن",1,0],["هذا سليمان الرّضى بنُ محمّدٍ","مَنْ أشرقَتْ بجبينه الأنوارُ",42,"ر",1,0],["هذا سبيلٌ حسنه يزداد","وثوابُه يومَ القيامة زادُ",43,"د",1,0],["هذا سماع مطلق وسماعنا ال","قرآن في الدنيا فنوع ثان",44,"ن",1,0],["هَذا سِجِلُّ قَضِيَّةٍ مَشهودَةٍ","بَيني وَبَينَ عُيونِ ذاكَ الشادِنِ",45,"ن",1,1],["هذا سناؤك لونُه وكذا","نور الصباح يموِّج الفجرا",46,"ر",2,0],["هَذا سُليمان أُوتي حكم والده","وَلم يَزل هوَ لِلمَظلوم منتصفا",47,"ف",2,0],["هذا سليل المجد والحبر الذي","شهدت بسابق فضله الأعداء",48,"ا",2,0],["هذا سعيد بالرشا","د وذا شقيٌّ بالغرور",49,"ر",1,0],["هذا سنا فرحي إذ أرخوه زها","والشمس زفت لنجمي وهو مسعود",50,"د",1,0],["هذا سعيد الدهر مفرد عصره","من مصره افتخرت على الأمصار",51,"ر",1,0],["هذا سرير من اغتدت","في الحب فاضحة الضمائر",52,"ر",1,1],["هذا سريرك يا حبيبة مهجتي","يا ليتني كنت السرير مكانه",53,"ه",1,1],["هذا سعيدٌ بدوره يمرح","وذا شقيٌّ بدوره يكدح",54,"ح",1,1],["هذا سليمان وذي رحلته","فيها على همته إثباتُ",55,"ت",1,1],["هذا سروري ببشراهم فكيف بهم","فالله يجلو بهم همّي وأحزاني",56,"ن",2,0],["هذا سؤالٌ جاء مُستدعيا","منكم جوابا فيه للنفس خير",57,"ر",1,0],["هذا سليل المرتضى حيدر","ساقي الورى من سلسل الكوثر",58,"ر",1,0],["هذا سموّ خديوينا الذي فَتَحت","بابَ القَبول لراجي العلم يُمناهُ",59,"ا",2,0],["هَذا سلامُ اخي ودادٍ كُلُّهُ","ودٌّ وَكُلُّ ودادِهِ فدوامُ",60,"م",1,0],["هذا سبيل اللَه تجري به","سحبٌ على نائلة هاطله",61,"ل",2,0],["هذا سروُري بأبي عامر","مُغرِّقِي في لُجَّةِ الغامرِ",62,"ر",1,1],["هذا سُروري بأَبي المُعَمَّرِ","الحسنِ الخَلقِ البديعِ المنظرِ",63,"ر",1,1],["هذا سَبيلُ لِكُلِّ الناسِ تَسلُكُهُ","وَسَهم حَتف لَهُ اضحى الوَرى هَدَفا",64,"ف",2,0],["هذا سبيلُ اللَه همَّ بهِ الهما","مُ عليُّ محيي الدينِ رِيّاً للصَدِي",65,"د",2,1],["هذا سراج القيروان خطيبها","وبقية الأفذاذ والإعلام",66,"م",1,0],["هذا سرابكَ جنةٌ تُغري","يا فاتني بالقرب والذكر",67,"ر",1,1],["هذا سبيل الهُدَى","لا ما افتراه الهُدَاةْ",68,"ا",2,0],["هذا سُلَيمانُ لَكِنْ سِرُّ خاتَمِهِ","موسى فَما ضَرَّهُ فُقْدانُ داودِ",69,"د",1,0],["هذا سراقة قد ساخت به فرس","في الأرض وهو بنيل الجعل مشغول",70,"ل",1,0],["هذا سراج رجال العلم قدوتهم","فالكل مقتبس من زنده الوارى",71,"ر",2,0],["هذا سؤال سبر غور العقل","به كما رأيته في النقلِ",72,"ل",1,1],["هذا سليمان الذي أشفى على","زحل العراق فصار بدرا نيرا",73,"ر",2,0],["هذا سليمان الزمان ومن غدا","في كنز كل علا أمين أمينه",74,"ن",2,0],["هذا سليمان الذي لقحت به","أم الكمال مباركا مبرورا",75,"ر",2,0],["هذا سليمان الذي لمقامه","ريح الجبابرة الشداد تروخ",76,"خ",1,0],["هذا سليمان الذي فتحت به","زرق الأسنة مقفل الأبواب",77,"ب",1,0],["هذا سليمان لم تقنع عزائمه","الا بطاعة انسيّ وجنيّ",78,"ي",1,0],["هذا سليمان الزمان وكفّه","ما بين مغرب شمسه والمطلع",79,"ع",1,0],["هَذا سلامٌ وَالنَسيم رَسولهُ","لا تَحسبوهُ مزخرفاً وَمنمَّقا",80,"ق",2,0],["هَذا سلام وَبنت الفكر تحملهُ","نقَّطتُها بِدُموعٍ تبهجُ الكَبدا",81,"د",2,0],["هذا سعود والحسين تباركا","فهما قِران للسعود موفق",82,"ق",1,0],["هذا سعود في العلاء كأنه","عبد العزيز وجده الميمون",83,"ن",1,0],["هذا سعود ولي العهج مثلك في","أخلاقه الغرِّ يذكي عزمهُ الهمما",84,"م",2,0],["هذا سماء المجد منه قد هوى","للترب كوكب بهجة الأعيان",85,"ن",1,0],["هذا سمي محمد ونبينا","بسميه يوم القيامة يشفع",86,"ع",1,1],["هَذا سِراجُ العارِفينَ بِرَبِّهِم","كَم قَد هَدى وَأَفادَ قَوماً هيما",87,"م",2,0],["هَذا سَمَيُّكَ وابنُ دَعوَتِكض الَّتي","تَدري فَعاجِل مُعضِلي بِعِلاجِ",88,"ج",1,0],["هذا سليمان وخاتمه","لما دعت لجنوده النمل",89,"ل",1,0],["هذا سُليمانُ قَد مَلَّكتَ راحَتَهُ","مَشارِقَ الأَرضِ مِن سَهلٍ وَمِن جَبَلِ",90,"ل",1,0],["هذا سَلِك ناسٍ وفي الناس حَدٍّ","عروضها تِذهَب وتِبقى أموالها",91,"ل",3,0],["هذا سليله الرضا السامي فخا","را وعلا هام الثريا والسهى",92,"ا",1,0],["هذا سنا الرحمن حين أبانه","لكليمه موسى النبي العابد",93,"د",1,0],["هذا سنا نصرنا الموعود قد عَلمتْ","مكامنُ الشرّ أنّ الأمرَ قد حُسما",94,"م",2,0],["هذا سُهَيلٌ يُنادِي: يا بَنِيَّ قِفُوا","كي تُبصِرُوا كَم مُرادًا زادَ إِمعانا",95,"ن",2,0],["هذا سبيلكِ فاسلكي وادعي له","بالعقل والتبيين والإثبات",96,"ت",1,0],["هَذَا سَلَامِي إِلَيكِ القَلبُ يُرسِلُهُ","لَا زِلْتِ وَعْداً وللِأَحرَارِ مُعتَنَقَا",97,"ق",2,0],["هذا سراجُ الشعر آنَ أوانه","ما عاد زيت يرتجيه فتيلُ",98,"ل",1,0],["هذا سوادُ الشَعرِ ذكَّرني","شِعراَ صبوحاً , وحي أقلامي",99,"م",2,0],["هذا سلاحي بين أيديكم على","أني أسير أكارم وأفاضل",100,"ل",1,0],["هذا سؤالي وانت منّه تهربت","أو أنت جاهل حب قلبك وخلك",101,"ك",1,0],["هَذَا سَقَاهُ السُّمَّ غَدْرُ جُعَيْدَةٍ","وَحُسَينُ فِي كَرْبٍ ثَوَى وَبَلاءِ(١)",102,"ا",2,0],["هذا سَوادُ العُمْرِ أصبَحَ سَرْمَداً","مَنْ يُخْرِج الإصْبَاح مِنْ هذا الغَسَقْ",103,"ق",1,0],["هذا سبيل العز حيث سلكته","فوجدت نصرا للعلاء ممهدا",104,"د",2,0],["هذا سليل المصطفى وشبيهه","خلقا وخلقا قد علاه المفخر",105,"ر",1,0],["هذا سبيل العاملين فسر به","إن كنت تطلب منهجاً وضاحا",106,"ح",2,0],["هذا سلاحي وبعد الحرب أطلقه","والبعض حتَّى لهذا الشجب يفتقر",107,"ر",1,0],["هذا سؤالٌ لا يجيد جوابَه","من يعبد الأَهواءَ والشيطانا",108,"ن",2,0],["هذا سؤال القدس وهي جريحةٌ","تشكو، فكيف نُجيب يا سَلْمانُ؟",109,"ن",1,0],["هذا \\\" سلامٌ \\\" خَط َّ في ديوانهِ","حُلَلا ً وفنّاً صائغاً أحلاها",110,"ا",3,0],["هذا سلامي على الدنيا أودعها","لأنين ميت إن دام هجرك لي",111,"ل",2,0],["هذا سفيني قد سما بشراعهِ‎","ويسير ملتحفاً ندى شاطيكِ",112,"ك",1,0],["هذا سلامُ في الوداعِ مجلجلٌ","ومحبةٌ تسري معَ النّسَماتِ",113,"ت",1,0],["هذا سبيل العارفين بربهم","هذا سبيل الخالدين من العظام",114,"م",1,0],["‏ ‏هذا سناك بمقلتي يتزاحمُ","‏ ‏ وترادُفُ الأطياف ليس يقاوَمُ",115,"م",1,0],["هذا سخاءُ أبيك زخَّ يغيثنا","وسخاءُ أمِّكِ، والجميعُ كزختكْ",116,"ك",1,0],["هذا سلامٌ مع الإشفاق باعثه","حبٌ أتيهُ به لا لومَ لا عتبا",117,"ب",2,0],["هذا سلامُ فؤادي يا بنَ آمنةٍ","يا رحمةَ اللهِ للإنسان والضعفا",118,"ف",2,0],["هذا سؤالٌ لا أُخالُ أجِيبُهُ","حَضَر َالسؤالُ وغابَ عنهُ مُجِيبُ",119,"ب",1,0],["هذا سؤالي جريح فوق طاولتي","وللغرابة في أحشائه وحمُ",120,"م",1,0],["هذا سلاحي طًموحٌ جامحٌ وتُقىً","وأمنياتٌ تسامتْ في مُخَيِّلَتي",121,"ت",2,0]]}