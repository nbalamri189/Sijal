{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[47,"أأخي نهنه دمعك المسفوكا","https://www.aldiwan.net/poem65223.html","الكامل"],[46,"يا دهر قدك وقلما يغني قدي","https://www.aldiwan.net/poem30317.html","الكامل"],[46,"لولا أبو يعقوب في إبرامه","https://www.aldiwan.net/poem30350.html","الكامل"],[107,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[107,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[164,"لا تأخذنك وحشة مما جرى","https://www.aldiwan.net/poem58918.html","الكامل"],[186,"هذا سليل بني نقولا قد غدا","https://www.aldiwan.net/poem61153.html","البسيط"],[214,"بك المناصب في العلياء تفتخر","https://www.aldiwan.net/poem13551.html","البسيط"],[215,"عدنا إلى الحب عدنا","https://www.aldiwan.net/poem46249.html","المجتث"],[216,"زار الحبيب وللواشين أبراق","https://www.aldiwan.net/poem37855.html","الطويل"],[216,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[216,"أهدي سلاما بعد النخل والشجر","https://www.aldiwan.net/poem37881.html","البسيط"],[216,"لقد تقاربن أشباح وأشباح","https://www.aldiwan.net/poem37900.html","البسيط"],[225,"الشمس خلف الجبال","https://www.aldiwan.net/poem55254.html","المجتث"],[275,"أنبي دونك عبرتي وتنهدي","https://www.aldiwan.net/poem52087.html","الكامل"],[332,"قالوا الربيع فقلت لا","https://www.aldiwan.net/poem55037.html","مجزوء الكامل"],[381,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[381,"هذا سلام والصدور رحاب","https://www.aldiwan.net/poem66940.html","الكامل"],[407,"هذا سؤالي أتى من عالم فطن","https://www.aldiwan.net/poem33391.html","البسيط"],[433,"هذا سبيل رائق","https://www.aldiwan.net/poem40729.html","مجزوء الكامل"],[445,"رضى بما قدر الله الحكيم رضى","https://www.aldiwan.net/poem14455.html","البسيط"],[445,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[464,"وصل الجواد من الجواد","https://www.aldiwan.net/poem16175.html","مجزوء الكامل"],[482,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[482,"من لي بوصفه يوما في محاكمة","https://www.aldiwan.net/poem37040.html","البسيط"],[561,"إن قلت إن الوجود نفس","https://www.aldiwan.net/poem34238.html","مخلع البسيط"],[565,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[565,"للشوق عندك مقعد ومقيم","https://www.aldiwan.net/poem52948.html","الكامل"]],"verses":[["هَذَا سُلَيْمَانُ النَّبِيُّ ابْتَزَّهُ","الْكُرسِيَّ بَعْضُ الْجِنِّ فيِمَا يُنْقَلُ",0,"ل",1,0],["هَذا سُلَيمانُ بنُ وَهبٍ بَعدَ ما","طالَت مَساعيهِ النُجومَ سُموكا",1,"ك",2,0],["هَذا سِنانٌ زاغِبِيٌّ في الوَغى","وَكَأَنَّما هَذا ذُبابُ مُهَنَّدِ",2,"د",1,0],["هَذا سَحابٌ أَنتَ سُقتَ غَمامَهُ","وَعَلَيكَ بَعدَ اللَهِ فَيضُ غَمامِهِ",3,"م",2,0],["هذا سَبيلُ المُؤمنينَ لكم بهِ","أجرُ المُجاهدِ والمجاهِدُ يُؤْجَرُ",4,"ر",1,0],["هذا سُهَيْلٌ جاءَ يحملُ سُؤْلَهم","وَيَعيبُ ما صَنَعَ الرُّماةُ وَيندم",5,"م",1,0],["هذا سليمانُ النبيُّ لما سها","عن بعض حق للإِله وقصرّا",6,"ر",2,0],["هَذا سَليلُ بَنِي نِقولا قَد غَدا","كَالبَدرِ في طَيِّ المَقابرِ يُرمَسُ",7,"س",1,1],["هذا سماء أياديه تفيض لنا","منها النوال وسحب الجود تتهمر",8,"ر",1,0],["هذا سؤالي إليكم","لقد عدلت فجرتم",9,"م",1,0],["هذا سعيدٌ أميرُ الخلقِ كُلِّهُمُ","زَكَتْ لَهُ في أصُولِ الفَخْرِ أعْرَاقُ",10,"ق",1,0],["هذا سعيدُ الذي بانَتْ مَعَالِمُه","سليلُ ثانيَ مِطْعانَ ومِنْفَاقُ",11,"ق",1,0],["هذا سعيد الذي تهمي أناملُهُ","غيثاً من الذَهَب القاني أو الدُّررِ",12,"ر",1,0],["هذا سعيد بن سلطان شواهره","كالشمس لا يُخْفِيها قُفْلٌ ومِفْتاحُ",13,"ح",1,0],["هذا سكون مريح","لمن أطال النضال",14,"ل",1,0],["هذا سؤال ولكن","ماذا جواب السؤال",14,"ل",1,0],["هَذا سَميك أَحمد قلق الحشا","أَتراك تغفل عن سميك أَحمَد",15,"د",1,0],["هذا سجين أضالع","فنيت على جمر الشكاة",16,"ه",1,0],["هذا سلامي لا يفي إن لم يصل","جبريلُ نظمَ سلامه بسلامي",17,"م",2,0],["هذا سلامٌ والصدورُ رحابُ","وهوى المنازلِ في الفؤاد حِرابُ",18,"ب",1,1],["هذا سؤالي أتى من عالم فطن","قد حل مني محل الروح من بدني",19,"ن",2,1],["هذا سبيل رائق","ماءُ الصفا منه جرى",20,"ر",2,1],["هذا سعيد فلا يشقى وذاك فلم","يسعد شقي علينا حكمه فرضا",21,"ض",2,0],["هذا سليمان الفتى ومحمد","ومحمد وحبا الربيع ربيعا",22,"ع",2,0],["هذا سَبوقٌ للأجا","وِدِ وهو سَبَّاق الجِيادِ",23,"د",1,0],["هذا سميك يا خير الأنام أتى","للحاكم العدل بالآتي أباطيلا",24,"ل",2,0],["هذا سجين ولا يدري له سببا","قضى السنين كما شاؤوه إهمالا",25,"ل",2,0],["هذا سؤال على عقول","أتى بعلم ونفي جهل",26,"ل",1,0],["هذا سليمانُ لطفٍ طابَ موْرِدُهُ","بروحِ فصلِ خطابِ اللُّطفِ والحِكَمِ",27,"م",1,0],["هذا سلَيمانُ الوَرَى لكنَّهُ","في طاعةِ الرَّحمن إبراهيمُ",28,"م",1,0]]}