{"poems":[[82,"واعمر بقصر الملك ناديك الذي","https://www.aldiwan.net/poem31233.html","الكامل"],[309,"إن كان هذا الذي أكابده","https://www.aldiwan.net/poem16752.html","المنسرح"],[376,"لمن القلب المعنى وبمن","https://www.aldiwan.net/poem57040.html","الرمل"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48654","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145888","البسيط"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138061","الرجز"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47373","الكامل"],[3005,"","https://poetry.dctabudhabi.ae/diwan/poem/34710","الرجز"],[5136,"أسد غودر في القاع الجدد","https://www.poetsgate.com/ViewPoem.aspx?id=121559",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""],[5694,"هذا الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=132092",""]],"verses":[["والمذنبون هُدوا الصراطَ وَكفّرَتْ","حسناتُهُمْ لذنوبهم تكفيرا",0,"ر",2,0],["وَالمَذهَبُ المُستَقيمِ أَذهَبَهُ","نَصُّ الكِتابِ وَصَرحُ الخَبَرُ",1,"ر",1,0],["والمذمَّاتُ إذا ما رَشَقَت","بسِهامٍ فالعَطِيَّاتُ جُنَن",2,"ن",1,0],["والمذاكي وجهَ الصباح","وعينُ الشمس تخشى عنانها والقتاما",3,"م",2,0],["والمذهب الذي قضى بالفتحِ","أولى لهم من آمر بالصفحِ",4,"ح",1,0],["و(المَذْهَبُ) الأنَ قد أمسى لنا وطناً","أما العراقُ فأمرٌ ليس يعنينا",5,"ن",2,0],["وَالْمَذْهَبُ الْمَشْهُوْرُ بَيْنَ الْعُلَما","نِسْبَتُهُ بِالاََبِ شَرْطٌ فَاعْلَما",6,"م",2,0],["والمُذْهَباتُ مِنَ الَخْوافِقِ بَعْضُها","لَيْثٌ أَزَلُّ وَلَقْوَةٌ فَتْخَاء",7,"ا",2,0],["وَالمَذهَبِ المُذهِبِ لِلنّقاقِ","وَالفِصحِ يا مُهَذِّبَ الأَخلاقِ",8,"ق",1,0],["والمذاكي فوقها زعنفة","ليس منهم حيز هاجت من ورد",9,"د",1,0],["والمذنبون بلا ذنب ومجرمةٍ","والغرب يحكمنا في الدين والشِّيَمِ",10,"م",1,0],["والمذهب الماضي صعيبن رجوعه","الا ان يرجع ميت من مقره",11,"ر",2,0]]}