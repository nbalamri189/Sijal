{"poems":[[47,"ذات ارتجاز بحنين الرعد","https://www.aldiwan.net/poem63456.html","الرجز"],[46,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[287,"نوح الحمام الورق في أوراقها","https://www.aldiwan.net/poem32291.html","الرجز"],[438,"تعود الطرد بها والطراد","https://www.aldiwan.net/poem12591.html","السريع"],[520,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64906","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79821","البسيط"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117984","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89591","الكامل"],[6023,"قل لمن بالقريض بزَّ الفحولا","https://www.poetsgate.com/ViewPoem.aspx?id=123905",""]],"verses":[["مَسفوحَةُ الدَمعِ لِغَيرِ وَجدِ","لَها نَسيمٌ كَنَسيمِ الوَردِ",0,"د",1,0],["مُسِفِّهِ ثَرِّهِ مُسَحسِحِهِ","وابِلِهِ مُستَهِلِّهِ بَرِدِه",1,"د",2,0],["مُسْفِرٌ يَلْتَقِي الكَتِيبَةَ بَسَّا","ماً إذا أسْهَمَ الوُجُوهَ اللِّقاءُ",2,"ا",2,0],["مُسْفِرُ الوَجْهِ للقَريبِ وللجا","نِبِ إنْ جانِبٌ أخَبّ السّفيرا",3,"ر",2,0],["مُسفرةٌ أَنهارُها ضاحِكَةٌ","تَنطَلِقُ الوُجوهُ لانطِلاقِها",4,"ق",3,0],["مسفِّعُ الأقلامِ فيما حبَتْ","ظبى السُيوفِ المُرهَفاتِ الحِدادْ",5,"د",1,0],["مسفرة الغرة لم ألقها","إلا انثنى لي أمل سافر",6,"ر",1,0],["مُسِفَّةٌ زَاحَمَتْ أَبْراجُها شُهبُاً","مِنَ السَّما وبزُهْرٍ مِنْ حواشيكا",7,"ك",2,0],["مسفوحةً لم تُجب عند استغاثتِها","إلاَّ بأدمع ثكلى شفَّها الألمُ",8,"م",1,0],["مسفرةٌ ضاحكةٌ مستبشره","مخضلةٌ نافحةٌ مستعطره",9,"ه",1,0],["مُسَفَّعُ الوَجهِ في أَرساغِهِ خَدَمٌ","وَفَوقَ ذاكَ إِلى الكَعبَينِ تَحجيلُ",10,"ل",1,0],["مسفر الوجه والمهذب أخلا","قاً ونفساً مظفر حيث يمّم",11,"م",1,0],["مُسفِرٌ عَن أثمارِ أفنانِ هَديٍ","هَصَرَتها الأنامِلُ الرَّخصَاءُ",12,"ا",2,0],["مَسفوكَةٌ مَسفوحَةٌ","مِنها الدِماءُ القانِيَه",13,"ي",2,0],["مسفرات عن حسن معنى بديع","من سناه تبغي البدور الأفولا",14,"ل",2,0]]}