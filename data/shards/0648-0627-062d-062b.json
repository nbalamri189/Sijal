{"poems":[[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1237","الكامل"],[119,"لا عذبن العين غير مفكر","https://www.aldiwan.net/poem40486.html","عموديه"],[214,"قم واصرف الهم بصرف الطلا","https://www.aldiwan.net/poem13418.html","السريع"],[463,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[463,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96652","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126150","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128698","الخفيف"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139348",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93871","الكامل"],[2943,"","https://poetry.dctabudhabi.ae/diwan/poem/111342","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97081","الكامل"],[5156,"ما ترى طيب وقتنا يا سعيد","https://www.poetsgate.com/ViewPoem.aspx?id=99128",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5194,"بحر الأسرار","https://www.poetsgate.com/ViewPoem.aspx?id=30631",""],[6070,"زكاة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=188817",""],[463,"أغشُّ بآمالي كأنيَ أنصحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60003&r=&rc=59",""]],"verses":[["وَاِحثُث أَنامِلَكَ السَوابِغَ بَينَها","حَتّى تَجولَ هُناكَ كُلَّ مَجالِ",0,"ل",1,0],["واحثها تبكي الطلول مخاطرا","فيها بكت بالدمع او فاضت دما",1,"م",2,0],["واحث بالشرب على شربها","وفرغ الكيس على كاسها",2,"ه",2,0],["واحثُ التراب على شحوبك حاسراً","وانزِلْ فعزِّ محمّداً بمحمّدِ",3,"د",1,0],["وأحثو بكفّي أو أشقُّ حفيرةً","يُهال على قلبي ثراها ويُضرَحُ",4,"ح",1,0],["وَأَحثَلَ الوَسيقَ كُلَّ مُحثَلِ","مِنَ المَطايا وَالرِجالِ الوُغَّلِ",5,"ل",1,0],["واحثثي للسير في الغدو وروحي","بين يمنى مسيرة ورشاد",6,"د",1,0],["وَأَحثي عليهِ التربَ بالكفِّ مُسرعاً","وَقَد كنتُ نملَ الأرضِ عنه أذودُ",7,"د",1,0],["واحثت مطيَّك نحو حمص قاصداً","ذاك الضريح الممتلي أنوارا",8,"ر",2,0],["واحثث العيس لا عدمتك واغنم","لذّة العيش في ربا الدهناء",9,"ا",2,0],["وأحثَّه يحدو به","حادي الحمام مع الأصيلِ",10,"ل",1,0],["واحثث مطايانا على نشر الخطا","فالنشر يطوي شقة الأسفار",11,"ر",1,0],["واحث التراب على الخدود","وقل أيا حامي الحمى",12,"م",2,0],["وأحث على الرأس التراب وناده","أو ما علمت بأن شبلك قد قضى",13,"ض",2,0],["وأحثث الكأس يا سعيد فقد حث","ك نايٌّ لها وحرك عود",14,"د",1,0],["وأحث أفلاكي لأرسو آمنا","بفنائه وأهيم في وديانه",15,"ن",2,0],["وأحث مشواره على ركب الأقدار","وأشد وأنزل في ربيعه وصيفه",16,"ف",2,0],["وأحثَّ نفسي بالمحبَّةِ دائماً","فزكاةُ هذي الروحِ أَنْ تتضرَّعا",17,"ع",2,0],["وأحثو بكفيّ أو أشقُّ حفيرة ً","يهال على قلبي ثراها ويصرخُ",18,"خ",1,0]]}