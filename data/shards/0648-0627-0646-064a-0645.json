oem34031.html","الوافر"],[553,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[553,"أشيبا ولما تمض خمسون حجة","https://www.aldiwan.net/poem47216.html","الطويل"],[553,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[553,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[553,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[553,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[553,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[553,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[553,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[553,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[553,"ألا حبذا زمن الحاجر","https://www.aldiwan.net/poem47796.html","المتقارب"],[553,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[553,"سقاني ولم أستسقه فضل خيره","https://www.aldiwan.net/poem47864.html","الطويل"],[553,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[553,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[553,"تطالبني نفسي بما غيره الرضا","https://www.aldiwan.net/poem48086.html","الطويل"],[560,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[560,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[566,"ولما رأيت الدل في شرعة الهوى","https://www.aldiwan.net/poem877.html",""],[577,"تركت حبيب القلب لا عن ملالة","https://www.aldiwan.net/poem2897.html","الطويل"],[577,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"],[589,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/124805","الطويل"],[790,"","https://poetry.dctabudhabi.ae/diwan/poem/26694","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/27079","الطويل"],[1099,"","https://poetry.dctabudhabi.ae/diwan/poem/114903","الطويل"],[1162,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"],[1093,"وَإِنّي من أَرعادكم وَبروقكم","https://www.poetsgate.com/ViewPoem.aspx?id=8290",""]],"verses":[["وَإِنَّي مِنَ القَومِ الَّذينَ بِبَأسِهِم","يُذَلِّلُ مِن أَيّامِهِم حَدَثانُها",0,"ن",3,0],["وَإِنِّيَ مِمّا آلَفُ الجِدَّ باخِلٌ","بِثَغري فَما يَدري اِمرُؤٌ أَينَ مَبسَمي",1,"م",2,0],["وَإِنّي مِن مَناجيبٍ","لَهُم أَنَفٌ إِذا ذُلّوا",2,"ل",3,0],["وَإِنّي مُعيرٌ ساعِدي مَن أَرادَهُ","بِأَبيضَ طاغي الشَفرَتَينِ صَقيلِ",3,"ل",1,0],["وَإِن يَمضِ نَصلٌ مِن عُقَيلٍ نَجِد لَهُ","مَناصِلَ في أَيدي الصِياقِلِ قُطَّعا",4,"ع",2,0],["وَإِنّي مَليءٌ إِن بَقيتُ لِعُرضِكُم","بِشَوهِ المَجالي تَحتَهُنَّ النَواقِرُ",5,"ر",1,0],["وَإِنِّيَ مُذ عادَ التَوَدُّدُ بَينَنا","تَجَلّى الدُجى عَن ناظِري وَوَرى زَندي",6,"د",2,0],["وأنّيَ مُذْ يمّمْتُ حضْرَةَ يوسُفٍ","تَقِلُّ مَقاديرُ الخلائِقِ عنْ قدْري",7,"ر",2,0],["وَإِن يَمُت تَمُتِ الآمالُ في بَلَدٍ","لَولا المُؤَيَّدُ لَم يَنشَط إِلى طَلَبِ",8,"ب",1,0],["وَأَنّي مِن ظِلالِكَ في زَمانٍ","نَدي الآصالِ رَقراقِ الضَواحي",9,"ح",2,0],["وَإِنّي مُدِلٌّ أَدَّعي أَنَّ صُحبَةً","وَأَسبابَ عَهدٍ لَم أُقَطَّع وِصالَها",10,"ل",3,0],["وَأَنّي مَتى أُشرِف عَلى الجانِبِ الَّذي","بِهِ أَنتِ مِن بَينِ الجَوانِبِ ناظِرُ",11,"ر",1,0],["وَإِنّي مِنَ القَومِ الَّذينَ تَعُدُّهُم","تَميمٌ حُماةَ المَأزِقِ المُتَلاحِمِ",12,"م",1,0],["وَإِنّي مافُجِعتُ بِهِ لَأَلقى","بِهِ مَلقى العِثارِ مِنَ الشِعارِ",13,"ر",1,0],["وَأَنّي ما حَيِيتُ عَلى هَواها","وَأَنّي بِالمَغيبِ لَها نَصورُ",14,"ر",1,0],["وَإِنّي مِنكَ لَفي خَجلَةٍ","لِأَنّي أُقَصِّرُ عَمّا وَجَب",15,"ب",1,0],["وَإِنّيَ مَن كانَ الرِجالُ بِسَبيهِ","وَمَن سَيفهِ في جَنَةٍ أَو جَهَنمِ",16,"م",1,0],["واني منه فوق احقر بقعة","فكيف ولم افهمه عنه اترجم",17,"م",1,0],["واني من بعد الدموع لسافح","دمي في هواها وهو آخر ما عندي",18,"ي",1,0],["واني محيّ للعروبة انها","قد استيقظت من نومها بعد احقب",19,"ب",1,0],["وإِنِّيَ مردي الخَصمِ يَحْرُقُ نابَهُ","إِذا طمسَ الأصباحُ ريشَ القشاعمِ",20,"م",1,0],["وَإِنّي مَلِيٌّ بِأَلّا يُسَرَّ","بِما نالَ مِنّي وَلا يَبتَهِج",21,"ج",1,0],["وَإِنّي مَتى أَعدُد مَعاليكَ أَعتَدِد","بِها شَرَفاً إِذ كُلُّ فَخرِكَ لي فَخرُ",22,"ر",1,0],["وَإِنّي مَليءٌ إِن ثَنَيتُ رَكائِبي","بِدَيمومَةٍ تَسفي بِها الريحُ ماتَسفي",23,"ف",2,0],["وَأَنّي مَتى أَهبِط مِنَ الأَرضِ تَلعَةً","أَجِد أَثَراً قَبلي جَديداً وَعافِيا",24,"ي",2,0],["وَإِنّي مَع صُدودِكَ وَالتَجَنّي","وَفيٌّ لَيسَ لي عَنكَ اِنتِقالُ",25,"ل",1,0],["وَإِنِّي مِنَ الْقَوْمِ الَّذِينَ إِذَا انْتَوَوْا","مَهُولاً مِنَ الأَخْطَارِ بَاؤُوا عَلَى بَأْوِ",26,"و",1,0],["وإني مقيمٌ لا أغيِّرُ مَوْثِقاً","وإنْ أنتِ غَيَّرْتِ المواثق مِنْ بعدِ",27,"د",1,0],["وَأَنِّيَ مَمنوعٌ مِنَ النَومِ مُدنَفٌ","وَعَينايَ مِن وَجدِ الأَسى تَكِفانِ",28,"ن",1,0],["وَإِنِّيَ مِن إِعراضِها مُتَأَلِّمٌ","قَليلُ العَزا وَالصَدُّ لا شَكَّ قاتِلي",29,"ل",2,0],["وَإِنّي مِنَ البَلوى أَسيرُ صَبابَةٍ","وَزادَت بِيَ البَلوى يَكُرُّ مُرورُها",30,"ر",3,0],["وإن يمس لبنان استبد به الأسى","فقدأصبحت بغداد والهة جدا",31,"د",2,0],["وَإِنِّيَ مِن فِكرَتي وَالقَضا","ءِ ما بَينَ بَحرَينِ لا يَسجُوانِ",32,"ن",1,0],["وَإِنِّي مُعِيذٌ عَزْمَكُمْ مِنْ تَرَدُّدٍ","إِذَا هُو لَمْ تَحْفِزْهُ طَنْطَنَةُ الشِّعْرِ",33,"ر",1,0],["وَأَنْ يَمْكُثَا فِي أُلْفَةٍ وَمَحَبَّةٍ","يَظَلُّ غَيُوراً مِنْهُمَا كُلُّ فَرْقَدِ",34,"د",1,0],["وإنّي مِنَ القَوْمِ الذينَ سَمِعْتُمُ","أَجَابُوا وَلَبُّوا دعوةَ اللهِ في الأمرِ",35,"ر",1,0],["وأنِّىَ من سبع خلون محافظ","على العهد، إن خان العهود متيم",36,"م",1,0],["وإني مذ يممت حضرة يوسف","تقل مقادير الخلائق عن قدر",37,"ر",1,0],["وانيَّ مذ فارقتكم ْ كان لي غنى","وشغل عن المال المجمع بالطرح",38,"ح",1,0],["وأنْ يَمدُّوا به في كلِّ مُطَّرحٍ","وإنْ سُقوا مِن جَناه الويلَ والحرَبا",39,"ب",2,0],["وَإنّي مَليءٌ بِأنْ لا يُسَرّ","بِمَا نَالَ مِنّي وَلا يَبْتَهِجْ",40,"ج",1,0],["وأني ممنوع من النوم مدنف","وعيناي من وجد الأسى يكفان",41,"ن",1,0],["وَإِن يَمم الضَيف أَحياءَنا","بَذَلنا لَهُ الروح قَبل القَرى",42,"ر",2,0],["واني من اولي الشرف المصفى","طوال الفرع في آل التهامي",43,"م",2,0],["واني من البيت الذي حول بابه","تداعت اسود الغاب ترجف بالذعر",44,"ر",1,0],["واني من الشم العرانين ما علوا","بمال ولا انحطوا عن الفخر بالفقر",44,"ر",1,0],["واني من القوم الذين ضحت بهم","وجوه المعالي بعد عتم الرزية",45,"ه",1,0],["واني مولوه الفؤاد بحبكم","فعذبتموني والعذاب بكم عذب",46,"ب",1,0],["وإني محفوظ الجناب وهمتي","علية شأن أسست حال تكويني",47,"ن",2,0],["وإن يمت قلبنا في طي حالتنا","بنظرة مع حسن الحال يحيينا",48,"ن",2,0],["وأني من برد عليك ودي","إذا أركبته الشوس الصعابا",49,"ب",2,0],["وإني مثلما قالوا","أخو نشوات عربيد",50,"د",1,0],["وإني مقيمٌ ما حييتُ على الوفَا","وإنكمَا في جَفْوتي ما بقيتُمَا",51,"م",2,0],["وَإني مُذ دَعَا الدَّاعِى بِنَاىٍ","مَرِيضٌ مُصعِدُ الزَّفَرَاتِ بَاكِ",52,"ك",1,0],["وإني مع الإحسانِ عنكم مقصرٌ","ولو كان في عوني زيادٌ وحسانُ",53,"ن",1,0],["وإني موقن ببلوغ قصدي","ولي من حسن ذكراكم دليل",54,"ل",1,0],["وإنّىَ من لاعجاتِ الهوى","على مثل صدرِ القناة انثنائى",55,"ا",2,0],["وَإِنّي مَتى حاوَلتُ سَيبَكَ ظالِمٌ","وَفي بَعضِ ما نَوَّلتَني مِنهُ ما أَغنا",56,"ن",2,0],["وإني متى ارتع عيوني جمالها","رتعن بلحظ فيه غير محرم",57,"م",1,0],["وأن يملك الإقصى وأن يبلغ المنى","وأن لا يجارى في كمال ولا فضل",58,"ل",1,0],["وَإِنّي مَتى أُشرِف عَلى مُصمَئِلَّةٍ","تُثَأثِئُ أَقدامَ الرِجالِ الدَلاهِثِ",59,"ث",1,0],["وإن يمنع المرء الزراري جاره","فأعجب بها من حاجب ثم أعجب",60,"ب",1,0],["وَإِنّي مَعَ الغَبنِ الَّذي يَرمضُ الحَشا","لأَحمي وَأَرمي دُونَهُ مَن يُناضِلُه",61,"ل",2,0],["وَإِنّي مِنَ القَومِ الَّذينَ إِذا اِنتَدَت","رَبيعَةُ يَوماً كانَ مِنهُم هُمامُها",62,"م",3,0],["وأني مقهور وأنك قاهر","وأنيَ مأمور وأنت أمير",63,"ر",1,0],["وإني متى وافيت والقوم حضّر","فيبدي عبوسا وهو مع ذاك يحرد",64,"د",1,0],["وَإنّي مِن القَومِ الَّذينَ دِماؤُهُم","شِفاءٌ لِطُلابِ التِّراتِ مِنَ الوَغمِ",65,"م",1,0],["واني متى جلدت ذبت صبابة","بوطئي على شيء احر من الجمر",66,"ر",1,0],["وإني مسموع الامارات كلها","وما في يدي عدل ولو كان أعوجا",67,"ج",2,0],["وإنّي متى ما أَطْوَهِ عنكَ مُوقِنٌ","بأنَّي في طَيٍّ له عنكَ آثم",68,"م",1,0],["وَإِنِّيَ مِن جودِ الوَزيرِ لَواثِقٌ","بِأَن سَيَريشُ اليَومَ ما اِنحَطَّ مِن حالي",69,"ل",2,0],["وَإِن يُمسِ مَدحي مُستَقَلِّاً لِمَجدِهِ","فَيا رُبَّ جيدٍ مُستَقَلٍّ لَهُ الدُرُّ",70,"ر",1,0],["وَإِنّي مِنَ الإِحسانِ في القَولِ مُكثِرٌ","وَلَكِنَّ حَظّي مِن فَوائِدِهِ نَزرُ",70,"ر",1,0],["واني من خلى بأيسر ده","اسروا سرى ما دعاني واسرع",71,"ع",1,0],["وإني من عانى المهالك بالمها","وبالبيض في الهيجاء بيض القواضب",72,"ب",1,0],["وإن يموتوا فقُولي ليتَهم خلدُوا","وابكي على زَهراتٍ من شبابهم",73,"م",1,0],["وإني من العُربِ الذين سُيوفُهم","وأقلامُهم كانت نجومَ البريَّة",74,"ه",1,0],["وَإِنِّي مُذْ تَحَدَّتْنِي اللَّيالِي","لَمُنْحازٌ إِلى الْكَرَمِ انْحِيازا",75,"ز",2,0],["وإِن يمَّمت سَفحَ العَقيق بمقلتي","فَيا حبَّذا سفحُ العَقيق الميمّمُ",76,"م",1,0],["وإنّي من القَوم الألى شيَّدوا العُلى","إِذا نقموا ضرّوا وإِن نعموا بَرّوا",77,"ر",3,0],["وَإني مذْ نأيت أَخو اكتئابٍ","قريحُ الجفْنِ في دمعي شريقُ",78,"ق",1,0],["وإني مقيم في مواطن غربة","على كثرة الآلاف في جانب وحدي",79,"د",2,0],["وإني مسيء ومذنب ومخلط","وأنت شفيع المذنبين إلى المولى",80,"ل",2,0],["وان يمت قلبي فروحي الأسير","متكل يا رب دوماً عليك",81,"ك",1,0],["وَإِنّي مِن لَذّاتِ دَهري لَقانِعٌ","بِحُلوِ حَديثٍ إِو بِمُرِّ عَتيقِ",82,"ق",1,0],["وَإِنّي مُذ وَجَدتُ بِكَ الأَماني","عَدِمتُ بِها مِنَ الخَلقِ التَمَنّي",83,"ن",2,0],["وَإِنّي مُذ رَفَضتُ بِكَ اللَواحي","عَلَيكَ بِسُنَّةِ الأَبدالِ سِنّي",83,"ن",2,0],["وَاِنّي من قَوم اِذا عَشِقوا رَأَوا","هَلاكَهُم في العِشق أَعظَم مَأرب",84,"ب",1,0],["وإنّ يَميناً لا تَضُنُّ بمالِها","لَمَرجُوَّةٌ ألاّ تَضُنَّ بخَطّها",85,"ط",3,0],["وَإِنّيَ مِن فَوقِ التُرابِ وَتَحتَهُ","لِأَحمِلُ عَهداً مِثلَ حُبِّكِ باقِيا",86,"ي",2,0],["وأن يُمِدَّ ذاكراً ما أجرما","كمّاً وكيفاً ثم نوعاً معهما",87,"م",2,0],["وإني مُشيدٌ بالصوابِ إذا بدا","وإني لِمن لايُحسنُ الفعلَ عاتبُ",88,"ب",1,0],["وإنّي مِن القوم الكرام فعالُهم","وانهّم يومَ الكريهة كالأُسدِ",89,"د",1,0],["وأنّي من قومٍ كرامٍ أعزّةٍ","ذخائرهم في صونٍ أعراضِهم نهبُ",90,"ب",1,0],["وإني مما قد جنيت لتائب","فهل غافر قبح الذي كان من كسبي",91,"ب",2,0],["وَإِنّي مِن دَهرٍ أَصابَكَ صِرفِهِ","وَأَخطأَني مِن أَن يُصيبَ عَلى حِذرِ",92,"ر",1,0],["وإنِّي متى ضَوَّعْتُ طيب ثنائه","فتَقْتُ به مِسكاً وأَشممْتُ عنبرا",93,"ر",2,0],["وإنِّي مشتاقٌ إلى كلِّ ماجد","يَصوبُ بقطر أو يَهُبُّ بريح",94,"ح",1,0],["وإنِّي متى عرَّضتُ يوماً بمدحهم","وأوْرَدْتُ ما أوْرَدْتُهُ من خواطري",95,"ر",2,0],["وإنّي مثلما عَلِمَتْ سُعادٌ","وقورُ الجأش مِقْلاقُ الركاب",96,"ب",1,0],["وإنّي متى أخليتُ من ثروة الغنى","وأغلق من دون المطامع بابه",97,"ب",2,0],["وإنِّي مذ ركنتُ إلى عُلاه","كأنِّي قد ركنت إلى ثبير",98,"ر",1,0],["وإنِّي متى ما شئتُ أن أنل الغنى","وأبلغ آمالي مدحت محمَّدا",99,"د",2,0],["وإنِّي مع الإِطناب فيك مقصِّرٌ","وإن كانَ شعري فيك ممَّا يناسبُ",100,"ب",1,0],["وإنِّي منى أدعُ لمجدك بالبقا","دعوتُ لنفسي أن أعزَّ وأكرما",101,"م",2,0],["وإن يُمِتْ موقفُ التوديعِ مُصْطَبَرِي","فَأَحْرِ لي بدُنُوٍّ منك يُحْيِيِني",102,"ن",2,0],["وأَنِّيَ من ظُلمِي بِعَدْلِكَ عَائِدٌ","وكم مطلبٍ أَسلمتَهُ فِي يَديْ عَدْلِ",103,"ل",1,0],["وأنى مديحي فيك واللَه مادح","فعالك في القرآن رتب فضلها",104,"ل",3,0],["وإني من رقيقك يا رسول","أتيت إليك في العصب الرقيق",105,"ق",1,0],["وإني مذ نأت دنياي عنهم","من الدنيا على هجرٍ ورفضِ",106,"ض",1,0],["وإنِّي من مولى الملوك ورأيِهِ","وسلطانِهِ بين المجرّةِ والنَّسرِ",107,"ر",1,0],["وإني مذ عذت هممي سيوفاً","لأَعلَمُ أنّني أبداً ضَريبُ",108,"ب",1,0],["وإِني مع الإِعْراض عني لَمُقْبلٌ","إلى الوِدِّ مَلآنُ الفصاحة بالشُّكْرِ",109,"ر",1,1],["وَأَنَّى مِن دِيارِكَ أُمُّ حَفصٍ","سَقى بَلَداً تَحُلُّ بِهِ الغَمامُ",110,"م",1,0],["وإني معدوم فما ذقت لذة ال","وجود على وفق التضاد اختراعه",111,"ع",2,0],["وأنّي من على الفلكِ","رأيتُ الشِّرك طوفانا",112,"ن",2,0],["وأنّي متُّ والآنا","م والشيطانُ أنْسانا",112,"ن",2,0],["وإنّي ميّتٌ لكنّ موتيْ","أُريدَ لهُ التفرّقَ في دوائرْ",113,"ر",1,0],["وأني متى ما طاب لي خفض عيشةٍ","تذكرت أياماً مضت لي لديكم",114,"م",1,0],["وإنّي من القومِ الّذين بنانُهم","وألسُنُهُم للسّائِلينَ تُفيدُ",115,"د",1,0],["وإني من تأريخ أيامك التي","بها سابق التأريخ يمحى ويمحق",116,"ق",1,0],["وإِنِّي مُقِرٌّ بالذُّنوبِ فإِنَّني","تَحَمَّلْتُ مِنْها مِلءَ كُلِّ وِعاءِ",117,"ا",2,0],["وإني مِن القَوم الغَطَارِفَةِ الألَى","مَكارِمُهم مِن دونِ إحصَائِها العَدُّ",118,"د",1,0],["وإنِّي مِثلُه لكِ فاعلَمِيه","على ما كانَ ما بقيَت حياتي",119,"ت",2,0],["وإنِّيَ منكمْ وُصْلَةً وولادَةً","وفي حبّكمْ لا زلت عنه مسامي",120,"م",2,0],["وَإِنّي مُذ أَضحى عذاري قرارَهُ","أَعاد بلا سُقمٍ وَأَجفى بلا جرمِ",121,"م",1,0],["وإنْ يُمَلّوا وما مُلَّ الجميلُ بهمْ","فإنّني مُعتَقٌ من رِبْقَةِ المَلَلِ",122,"ل",1,0],["وإنّي مقيمٌ وإن أجدبتْ","بلادي عَلى الرّجل الفاضلِ",123,"ل",1,0],["وأَنِّيَ ما حُزتُ الفخارَ مغرِّباً","كما حزتُهُ دون الأنامِ مشرّقا",124,"ق",2,0],["وأنِّيَ ما أنصبتُ في طرقِ العُلا","قلوباً وأجساماً وخيلاً وأينُقا",124,"ق",2,0],["وأنِّيَ موفورٌ وأنتَ مُحَمَّلٌ","بثِقْلِ الثَّرى ما لا أراك تُطيقُهُ",125,"ق",2,0],["وإنّيَ ممّنْ لا يواليك رغبةً","وأين من الرغبات من ليس يُنْطَفُ",126,"ف",1,0],["وإنِّيَ منكَ مهما يُصِبْكَ","يُصِبْنِي وفي مَرْوَتِي يقرعُ",127,"ع",1,0],["وَإنّي منَ القومِ الّذين إذا اِنتَموا","أَسالوا مِنَ السّاداتِ بحراً غُطامِطا",128,"ط",2,0],["وَإنّيَ مِمَّنْ لا تُحَطُّ رِكابهُ","على البلد النابِي المُجَلَّهِ بالحسْرِ",129,"ر",1,0],["وَإِنّيَ مِن فَرْطِ شَوقي إليك","ووجدي كسيرٌ بلا جابرِ",130,"ر",1,0],["وإنِّيَ مغمودٌ وإِنْ كنتُ باتِراً","ولا بُدّ يوماً أن أُجرَّدَ من غِمدِي",131,"د",2,0],["وَإنِّيَ ممّنْ إِن نَبا عنه منزلٌ","وأنكرَ مثواه نآه فأبعدا",132,"د",2,0],["وَإنِّي مَتى ضنَّ الصّديقُ بقربهِ","أكنْ منه أسخى بالبِعاد وأجْوَدا",133,"د",2,0],["وَإنّيَ مَبْلوٌّ بِما لم تُبل بِهِ","فَلا تُبلِني فيهِ بلومِ المعاتِبِ",134,"ب",1,0],["وَإنِّيَ مِمَّنْ إِنْ نَبا عَنهُ مَنزلٌ","نَبا وَنَجتْ عَنهُ عِجالاً ركائبُهْ",135,"ب",2,0],["وإن يمت فالجزاء نارٌ","لأنه للضلال جاني",136,"ن",2,0],["وإني ما أنا عيسى","ولا المهديْ إلى السبل",137,"ل",1,0],["وإني ما أنا شيخ","ولا بالشابِّ والكهل",137,"ل",1,0],["وإني مطلق والكل","ل في قيد وفي غل",137,"ل",1,0],["وإني محك للزيوف مجري","بعصري ولا يبقى مع الحك زيبق",138,"ق",1,0],["وَإِنِّي منه في عَقابيل طَرْبِهِ","ويُبْقِي ويُمْضِي المِسْكَ رائحةُ المسكِ",139,"ك",1,0],["وإِنِّي مَنْ كَسْبُ المَعَالي مُرادُه","وغَيرُ جَزِيلاَتِ العَطَايَا طِلاَبُه",140,"ب",2,0],["وإني ما أقام عسيب يوماً","أقيم ودادكم مهما أقاما",141,"م",2,0],["وإِنِّي منَ القَوْمِ الَّذِينَ عَرَفْتَهُمْ","إِذا ماتَ منهم سَيِّدٌ قام صاحِبُهْ",142,"ب",2,1],["وَأَنّي مُلاقٍ بَعدَما غالَ والِدي","وَأَنّي مُلاقٍ غولَ عَمرِو بنِ كاهِلِ",143,"ل",1,0],["وَإِنّي مِنَ القَومِ الَّذينَ هُمُ هُمُ","إِذا ماتَ مِنهُم سَيِّدٌ قامَ صاحِبُه",144,"ب",2,0],["واني مع الساعي عليكم بسيفه","إذا عظمكم يوماً رأيت به كسرا",145,"ر",2,0],["وانّي متى ما أدعُ باسمكَ لا تُجِب","وكنتَ جديراً ان تجيبَ وتُسمِعا",146,"ع",2,0],["وَإِنّي من أَرعادكم وَبروقكم","وإيعادكم بالقتل صم مسامعي",147,"ع",2,1]]}