tsgate.com/ViewPoem.aspx?id=189906",""],[585,"هي الجزيرة فيها الصيحة العمم","https://www.poetsgate.com/ViewPoem.aspx?id=161893",""],[5189,"بإذنِ الواحد الصمد","https://www.poetsgate.com/ViewPoem.aspx?id=211097",""],[5189,"الحب نهرا","https://www.poetsgate.com/ViewPoem.aspx?id=213319",""],[3975,"وَإِنّي من أَرعادكم وَبروقكم","https://www.poetsgate.com/ViewPoem.aspx?id=8290",""],[5219,"شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=195038",""],[5277,"طفلةُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=190765",""],[5277,"مِن تهجّدات البدوي الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=208837",""],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[307,"خَرِيفُ العُمْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=215587",""],[5376,"لو جادَ غيثُكِ ما مكثْتُ عليلا","https://www.poetsgate.com/ViewPoem.aspx?id=205151",""],[5413,"كفى الحب عزا","https://www.poetsgate.com/ViewPoem.aspx?id=200546",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"لعمرك إنّ الحب راحٌ ومبهجُ","https://www.poetsgate.com/ViewPoem.aspx?id=189966",""],[5431,"غناء ...","https://www.poetsgate.com/ViewPoem.aspx?id=207456",""],[5431,"(عمّ...) ولاعذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=214248",""],[5486,"امرأة من حجر","https://www.poetsgate.com/ViewPoem.aspx?id=211189",""],[5574,"عزائمنا","https://www.poetsgate.com/ViewPoem.aspx?id=206017",""],[5628,"هواجس مرعبة","https://www.poetsgate.com/ViewPoem.aspx?id=178464",""],[5629,"العيد","https://www.poetsgate.com/ViewPoem.aspx?id=184616",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[5725,"محمد ادعج العينين وصفا","https://www.poetsgate.com/ViewPoem.aspx?id=184579",""],[5725,"عطشْتك عشرا من المجدبات","https://www.poetsgate.com/ViewPoem.aspx?id=202745",""],[402,"إلى الغادة الزهراء من آل فاضل","https://www.poetsgate.com/ViewPoem.aspx?id=35397",""],[5956,"عساك تنيرين قلبي بضوء هواك ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181946",""],[5956,"أكذوبة","https://www.poetsgate.com/ViewPoem.aspx?id=183230",""],[5956,"دعوتُ للإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=194884",""],[5996,"وما ذاك إلا عارض من طماعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181339",""],[6031,"إلى الملكِ الوهَّابِ ما في يمينِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46259",""],[6068,"تسائلني الزميلة في الصباح -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175853",""],[6142,"لا عذر للعين إن لم تنفجر علقا","https://www.poetsgate.com/ViewPoem.aspx?id=155754",""],[422,"أتذكر أطلالاً تعفَّت وأرسما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22244&r=&rc=0",""],[6320,"لَظَى غَيْظِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83622&r=&rc=3",""]],"verses":[["وَإِنَّي مِنَ القَومِ الَّذينَ بِبَأسِهِم","يُذَلِّلُ مِن أَيّامِهِم حَدَثانُها",0,"ن",3,0],["وَإِنِّيَ مِمّا آلَفُ الجِدَّ باخِلٌ","بِثَغري فَما يَدري اِمرُؤٌ أَينَ مَبسَمي",1,"م",2,0],["وَإِنّي مِن مَناجيبٍ","لَهُم أَنَفٌ إِذا ذُلّوا",2,"ل",3,0],["وَإِنّي مُعيرٌ ساعِدي مَن أَرادَهُ","بِأَبيضَ طاغي الشَفرَتَينِ صَقيلِ",3,"ل",1,0],["وَإِن يَمضِ نَصلٌ مِن عُقَيلٍ نَجِد لَهُ","مَناصِلَ في أَيدي الصِياقِلِ قُطَّعا",4,"ع",2,0],["وَإِنّي مَليءٌ إِن بَقيتُ لِعُرضِكُم","بِشَوهِ المَجالي تَحتَهُنَّ النَواقِرُ",5,"ر",1,0],["وَإِنِّيَ مُذ عادَ التَوَدُّدُ بَينَنا","تَجَلّى الدُجى عَن ناظِري وَوَرى زَندي",6,"د",2,0],["وأنّيَ مُذْ يمّمْتُ حضْرَةَ يوسُفٍ","تَقِلُّ مَقاديرُ الخلائِقِ عنْ قدْري",7,"ر",2,0],["وَإِن يَمُت تَمُتِ الآمالُ في بَلَدٍ","لَولا المُؤَيَّدُ لَم يَنشَط إِلى طَلَبِ",8,"ب",1,0],["وَأَنّي مِن ظِلالِكَ في زَمانٍ","نَدي الآصالِ رَقراقِ الضَواحي",9,"ح",2,0],["وَإِنّي مُدِلٌّ أَدَّعي أَنَّ صُحبَةً","وَأَسبابَ عَهدٍ لَم أُقَطَّع وِصالَها",10,"ل",3,0],["وَأَنّي مَتى أُشرِف عَلى الجانِبِ الَّذي","بِهِ أَنتِ مِن بَينِ الجَوانِبِ ناظِرُ",11,"ر",1,0],["وَإِنّي مِنَ القَومِ الَّذينَ تَعُدُّهُم","تَميمٌ حُماةَ المَأزِقِ المُتَلاحِمِ",12,"م",1,0],["وَإِنّي مافُجِعتُ بِهِ لَأَلقى","بِهِ مَلقى العِثارِ مِنَ الشِعارِ",13,"ر",1,0],["وَأَنّي ما حَيِيتُ عَلى هَواها","وَأَنّي بِالمَغيبِ لَها نَصورُ",14,"ر",1,0],["وَإِنّي مِنكَ لَفي خَجلَةٍ","لِأَنّي أُقَصِّرُ عَمّا وَجَب",15,"ب",1,0],["وَإِنّيَ مَن كانَ الرِجالُ بِسَبيهِ","وَمَن سَيفهِ في جَنَةٍ أَو جَهَنمِ",16,"م",1,0],["واني منه فوق احقر بقعة","فكيف ولم افهمه عنه اترجم",17,"م",1,0],["واني من بعد الدموع لسافح","دمي في هواها وهو آخر ما عندي",18,"ي",1,0],["واني محيّ للعروبة انها","قد استيقظت من نومها بعد احقب",19,"ب",1,0],["وإِنِّيَ مردي الخَصمِ يَحْرُقُ نابَهُ","إِذا طمسَ الأصباحُ ريشَ القشاعمِ",20,"م",1,0],["وَإِنّي مَلِيٌّ بِأَلّا يُسَرَّ","بِما نالَ مِنّي وَلا يَبتَهِج",21,"ج",1,0],["وَإِنّي مَتى أَعدُد مَعاليكَ أَعتَدِد","بِها شَرَفاً إِذ كُلُّ فَخرِكَ لي فَخرُ",22,"ر",1,0],["وَإِنّي مَليءٌ إِن ثَنَيتُ رَكائِبي","بِدَيمومَةٍ تَسفي بِها الريحُ ماتَسفي",23,"ف",2,0],["وَأَنّي مَتى أَهبِط مِنَ الأَرضِ تَلعَةً","أَجِد أَثَراً قَبلي جَديداً وَعافِيا",24,"ي",2,0],["وَإِنّي مَع صُدودِكَ وَالتَجَنّي","وَفيٌّ لَيسَ لي عَنكَ اِنتِقالُ",25,"ل",1,0],["وَإِنِّي مِنَ الْقَوْمِ الَّذِينَ إِذَا انْتَوَوْا","مَهُولاً مِنَ الأَخْطَارِ بَاؤُوا عَلَى بَأْوِ",26,"و",1,0],["وإني مقيمٌ لا أغيِّرُ مَوْثِقاً","وإنْ أنتِ غَيَّرْتِ المواثق مِنْ بعدِ",27,"د",1,0],["وَأَنِّيَ مَمنوعٌ مِنَ النَومِ مُدنَفٌ","وَعَينايَ مِن وَجدِ الأَسى تَكِفانِ",28,"ن",1,0],["وَإِنِّيَ مِن إِعراضِها مُتَأَلِّمٌ","قَليلُ العَزا وَالصَدُّ لا شَكَّ قاتِلي",29,"ل",2,0],["وَإِنّي مِنَ البَلوى أَسيرُ صَبابَةٍ","وَزادَت بِيَ البَلوى يَكُرُّ مُرورُها",30,"ر",3,0],["وإن يمس لبنان استبد به الأسى","فقدأصبحت بغداد والهة جدا",31,"د",2,0],["وَإِنِّيَ مِن فِكرَتي وَالقَضا","ءِ ما بَينَ بَحرَينِ لا يَسجُوانِ",32,"ن",1,0],["وَإِنِّي مُعِيذٌ عَزْمَكُمْ مِنْ تَرَدُّدٍ","إِذَا هُو لَمْ تَحْفِزْهُ طَنْطَنَةُ الشِّعْرِ",33,"ر",1,0],["وَأَنْ يَمْكُثَا فِي أُلْفَةٍ وَمَحَبَّةٍ","يَظَلُّ غَيُوراً مِنْهُمَا كُلُّ فَرْقَدِ",34,"د",1,0],["وإنّي مِنَ القَوْمِ الذينَ سَمِعْتُمُ","أَجَابُوا وَلَبُّوا دعوةَ اللهِ في الأمرِ",35,"ر",1,0],["وأنِّىَ من سبع خلون محافظ","على العهد، إن خان العهود متيم",36,"م",1,0],["وإني مذ يممت حضرة يوسف","تقل مقادير الخلائق عن قدر",37,"ر",1,0],["وانيَّ مذ فارقتكم ْ كان لي غنى","وشغل عن المال المجمع بالطرح",38,"ح",1,0],["وأنْ يَمدُّوا به في كلِّ مُطَّرحٍ","وإنْ سُقوا مِن جَناه الويلَ والحرَبا",39,"ب",2,0],["وَإنّي مَليءٌ بِأنْ لا يُسَرّ","بِمَا نَالَ مِنّي وَلا يَبْتَهِجْ",40,"ج",1,0],["وأني ممنوع من النوم مدنف","وعيناي من وجد الأسى يكفان",41,"ن",1,0],["وَإِن يَمم الضَيف أَحياءَنا","بَذَلنا لَهُ الروح قَبل القَرى",42,"ر",2,0],["واني من اولي الشرف المصفى","طوال الفرع في آل التهامي",43,"م",2,0],["واني من البيت الذي حول بابه","تداعت اسود الغاب ترجف بالذعر",44,"ر",1,0],["واني من الشم العرانين ما علوا","بمال ولا انحطوا عن الفخر بالفقر",44,"ر",1,0],["واني من القوم الذين ضحت بهم","وجوه المعالي بعد عتم الرزية",45,"ه",1,0],["واني مولوه الفؤاد بحبكم","فعذبتموني والعذاب بكم عذب",46,"ب",1,0],["وإني محفوظ الجناب وهمتي","علية شأن أسست حال تكويني",47,"ن",2,0],["وإن يمت قلبنا في طي حالتنا","بنظرة مع حسن الحال يحيينا",48,"ن",2,0],["وأني من برد عليك ودي","إذا أركبته الشوس الصعابا",49,"ب",2,0],["وإني مثلما قالوا","أخو نشوات عربيد",50,"د",1,0],["وإني مقيمٌ ما حييتُ على الوفَا","وإنكمَا في جَفْوتي ما بقيتُمَا",51,"م",2,0],["وَإني مُذ دَعَا الدَّاعِى بِنَاىٍ","مَرِيضٌ مُصعِدُ الزَّفَرَاتِ بَاكِ",52,"ك",1,0],["وإني مع الإحسانِ عنكم مقصرٌ","ولو كان في عوني زيادٌ وحسانُ",53,"ن",1,0],["وإني موقن ببلوغ قصدي","ولي من حسن ذكراكم دليل",54,"ل",1,0],["وإنّىَ من لاعجاتِ الهوى","على مثل صدرِ القناة انثنائى",55,"ا",2,0],["وَإِنّي مَتى حاوَلتُ سَيبَكَ ظالِمٌ","وَفي بَعضِ ما نَوَّلتَني مِنهُ ما أَغنا",56,"ن",2,0],["وإني متى ارتع عيوني جمالها","رتعن بلحظ فيه غير محرم",57,"م",1,0],["وأن يملك الإقصى وأن يبلغ المنى","وأن لا يجارى في كمال ولا فضل",58,"ل",1,0],["وَإِنّي مَتى أُشرِف عَلى مُصمَئِلَّةٍ","تُثَأثِئُ أَقدامَ الرِجالِ الدَلاهِثِ",59,"ث",1,0],["وإن يمنع المرء الزراري جاره","فأعجب بها من حاجب ثم أعجب",60,"ب",1,0],["وَإِنّي مَعَ الغَبنِ الَّذي يَرمضُ الحَشا","لأَحمي وَأَرمي دُونَهُ مَن يُناضِلُه",61,"ل",2,0],["وَإِنّي مِنَ القَومِ الَّذينَ إِذا اِنتَدَت","رَبيعَةُ يَوماً كانَ مِنهُم هُمامُها",62,"م",3,0],["وأني مقهور وأنك قاهر","وأنيَ مأمور وأنت أمير",63,"ر",1,0],["وإني متى وافيت والقوم حضّر","فيبدي عبوسا وهو مع ذاك يحرد",64,"د",1,0],["وَإنّي مِن القَومِ الَّذينَ دِماؤُهُم","شِفاءٌ لِطُلابِ التِّراتِ مِنَ الوَغمِ",65,"م",1,0],["واني متى جلدت ذبت صبابة","بوطئي على شيء احر من الجمر",66,"ر",1,0],["وإني مسموع الامارات كلها","وما في يدي عدل ولو كان أعوجا",67,"ج",2,0],["وإنّي متى ما أَطْوَهِ عنكَ مُوقِنٌ","بأنَّي في طَيٍّ له عنكَ آثم",68,"م",1,0],["وَإِنِّيَ مِن جودِ الوَزيرِ لَواثِقٌ","بِأَن سَيَريشُ اليَومَ ما اِنحَطَّ مِن حالي",69,"ل",2,0],["وَإِن يُمسِ مَدحي مُستَقَلِّاً لِمَجدِهِ","فَيا رُبَّ جيدٍ مُستَقَلٍّ لَهُ الدُرُّ",70,"ر",1,0],["وَإِنّي مِنَ الإِحسانِ في القَولِ مُكثِرٌ","وَلَكِنَّ حَظّي مِن فَوائِدِهِ نَزرُ",70,"ر",1,0],["واني من خلى بأيسر ده","اسروا سرى ما دعاني واسرع",71,"ع",1,0],["وإني من عانى المهالك بالمها","وبالبيض في الهيجاء بيض القواضب",72,"ب",1,0],["وإن يموتوا فقُولي ليتَهم خلدُوا","وابكي على زَهراتٍ من شبابهم",73,"م",1,0],["وإني من العُربِ الذين سُيوفُهم","وأقلامُهم كانت نجومَ البريَّة",74,"ه",1,0],["وَإِنِّي مُذْ تَحَدَّتْنِي اللَّيالِي","لَمُنْحازٌ إِلى الْكَرَمِ انْحِيازا",75,"ز",2,0],["وإِن يمَّمت سَفحَ العَقيق بمقلتي","فَيا حبَّذا سفحُ العَقيق الميمّمُ",76,"م",1,0],["وإنّي من القَوم الألى شيَّدوا العُلى","إِذا نقموا ضرّوا وإِن نعموا بَرّوا",77,"ر",3,0],["وَإني مذْ نأيت أَخو اكتئابٍ","قريحُ الجفْنِ في دمعي شريقُ",78,"ق",1,0],["وإني مقيم في مواطن غربة","على كثرة الآلاف في جانب وحدي",79,"د",2,0],["وإني مسيء ومذنب ومخلط","وأنت شفيع المذنبين إلى المولى",80,"ل",2,0],["وان يمت قلبي فروحي الأسير","متكل يا رب دوماً عليك",81,"ك",1,0],["وَإِنّي مِن لَذّاتِ دَهري لَقانِعٌ","بِحُلوِ حَديثٍ إِو بِمُرِّ عَتيقِ",82,"ق",1,0],["وَإِنّي مُذ وَجَدتُ بِكَ الأَماني","عَدِمتُ بِها مِنَ الخَلقِ التَمَنّي",83,"ن",2,0],["وَإِنّي مُذ رَفَضتُ بِكَ اللَواحي","عَلَيكَ بِسُنَّةِ الأَبدالِ سِنّي",83,"ن",2,0],["وَاِنّي من قَوم اِذا عَشِقوا رَأَوا","هَلاكَهُم في العِشق أَعظَم مَأرب",84,"ب",1,0],["وإنّ يَميناً لا تَضُنُّ بمالِها","لَمَرجُوَّةٌ ألاّ تَضُنَّ بخَطّها",85,"ط",3,0],["وَإِنّيَ مِن فَوقِ التُرابِ وَتَحتَهُ","لِأَحمِلُ عَهداً مِثلَ حُبِّكِ باقِيا",86,"ي",2,0],["وأن يُمِدَّ ذاكراً ما أجرما","كمّاً وكيفاً ثم نوعاً معهما",87,"م",2,0],["وإني مُشيدٌ بالصوابِ إذا بدا","وإني لِمن لايُحسنُ الفعلَ عاتبُ",88,"ب",1,0],["وإنّي مِن القوم الكرام فعالُهم","وانهّم يومَ الكريهة كالأُسدِ",89,"د",1,0],["وأنّي من قومٍ كرامٍ أعزّةٍ","ذخائرهم في صونٍ أعراضِهم نهبُ",90,"ب",1,0],["وإني مما قد جنيت لتائب","فهل غافر قبح الذي كان من كسبي",91,"ب",2,0],["وَإِنّي مِن دَهرٍ أَصابَكَ صِرفِهِ","وَأَخطأَني مِن أَن يُصيبَ عَلى حِذرِ",92,"ر",1,0],["وإنِّي متى ضَوَّعْتُ طيب ثنائه","فتَقْتُ به مِسكاً وأَشممْتُ عنبرا",93,"ر",2,0],["وإنِّي مشتاقٌ إلى كلِّ ماجد","يَصوبُ بقطر أو يَهُبُّ بريح",94,"ح",1,0],["وإنِّي متى عرَّضتُ يوماً بمدحهم","وأوْرَدْتُ ما أوْرَدْتُهُ من خواطري",95,"ر",2,0],["وإنّي مثلما عَلِمَتْ سُعادٌ","وقورُ الجأش مِقْلاقُ الركاب",96,"ب",1,0],["وإنّي متى أخليتُ من ثروة الغنى","وأغلق من دون المطامع بابه",97,"ب",2,0],["وإنِّي مذ ركنتُ إلى عُلاه","كأنِّي قد ركنت إلى ثبير",98,"ر",1,0],["وإنِّي متى ما شئتُ أن أنل الغنى","وأبلغ آمالي مدحت محمَّدا",99,"د",2,0],["وإنِّي مع الإِطناب فيك مقصِّرٌ","وإن كانَ شعري فيك ممَّا يناسبُ",100,"ب",1,0],["وإنِّي منى أدعُ لمجدك بالبقا","دعوتُ لنفسي أن أعزَّ وأكرما",101,"م",2,0],["وإن يُمِتْ موقفُ التوديعِ مُصْطَبَرِي","فَأَحْرِ لي بدُنُوٍّ منك يُحْيِيِني",102,"ن",2,0],["وأَنِّيَ من ظُلمِي بِعَدْلِكَ عَائِدٌ","وكم مطلبٍ أَسلمتَهُ فِي يَديْ عَدْلِ",103,"ل",1,0],["وأنى مديحي فيك واللَه مادح","فعالك في القرآن رتب فضلها",104,"ل",3,0],["وإني من رقيقك يا رسول","أتيت إليك في العصب الرقيق",105,"ق",1,0],["وإني مذ نأت دنياي عنهم","من الدنيا على هجرٍ ورفضِ",106,"ض",1,0],["وإنِّي من مولى الملوك ورأيِهِ","وسلطانِهِ بين المجرّةِ والنَّسرِ",107,"ر",1,0],["وإني مذ عذت هممي سيوفاً","لأَعلَمُ أنّني أبداً ضَريبُ",108,"ب",1,0],["وإِني مع الإِعْراض عني لَمُقْبلٌ","إلى الوِدِّ مَلآنُ الفصاحة بالشُّكْرِ",109,"ر",1,1],["وَأَنَّى مِن دِيارِكَ أُمُّ حَفصٍ","سَقى بَلَداً تَحُلُّ بِهِ الغَمامُ",110,"م",1,0],["وإني معدوم فما ذقت لذة ال","وجود على وفق التضاد اختراعه",111,"ع",2,0],["وأنّي من على الفلكِ","رأيتُ الشِّرك طوفانا",112,"ن",2,0],["وأنّي متُّ والآنا","م والشيطانُ أنْسانا",112,"ن",2,0],["وإنّي ميّتٌ لكنّ موتيْ","أُريدَ لهُ التفرّقَ في دوائرْ",113,"ر",1,0],["وأني متى ما طاب لي خفض عيشةٍ","تذكرت أياماً مضت لي لديكم",114,"م",1,0],["وإنّي من القومِ الّذين بنانُهم","وألسُنُهُم للسّائِلينَ تُفيدُ",115,"د",1,0],["وإني من تأريخ أيامك التي","بها سابق التأريخ يمحى ويمحق",116,"ق",1,0],["وإِنِّي مُقِرٌّ بالذُّنوبِ فإِنَّني","تَحَمَّلْتُ مِنْها مِلءَ كُلِّ وِعاءِ",117,"ا",2,0],["وإني مِن القَوم الغَطَارِفَةِ الألَى","مَكارِمُهم مِن دونِ إحصَائِها العَدُّ",118,"د",1,0],["وإنِّي مِثلُه لكِ فاعلَمِيه","على ما كانَ ما بقيَت حياتي",119,"ت",2,0],["وإنِّيَ منكمْ وُصْلَةً وولادَةً","وفي حبّكمْ لا زلت عنه مسامي",120,"م",2,0],["وَإِنّي مُذ أَضحى عذاري قرارَهُ","أَعاد بلا سُقمٍ وَأَجفى بلا جرمِ",121,"م",1,0],["وإنْ يُمَلّوا وما مُلَّ الجميلُ بهمْ","فإنّني مُعتَقٌ من رِبْقَةِ المَلَلِ",122,"ل",1,0],["وإنّي مقيمٌ وإن أجدبتْ","بلادي عَلى الرّجل الفاضلِ",123,"ل",1,0],["وأَنِّيَ ما حُزتُ الفخارَ مغرِّباً","كما حزتُهُ دون الأنامِ مشرّقا",124,"ق",2,0],["وأنِّيَ ما أنصبتُ في طرقِ العُلا","قلوباً وأجساماً وخيلاً وأينُقا",124,"ق",2,0],["وأنِّيَ موفورٌ وأنتَ مُحَمَّلٌ","بثِقْلِ الثَّرى ما لا أراك تُطيقُهُ",125,"ق",2,0],["وإنّيَ ممّنْ لا يواليك رغبةً","وأين من الرغبات من ليس يُنْطَفُ",126,"ف",1,0],["وإنِّيَ منكَ مهما يُصِبْكَ","يُصِبْنِي وفي مَرْوَتِي يقرعُ",127,"ع",1,0],["وَإنّي منَ القومِ الّذين إذا اِنتَموا","أَسالوا مِنَ السّاداتِ بحراً غُطامِطا",128,"ط",2,0],["وَإنّيَ مِمَّنْ لا تُحَطُّ رِكابهُ","على البلد النابِي المُجَلَّهِ بالحسْرِ",129,"ر",1,0],["وَإِنّيَ مِن فَرْطِ شَوقي إليك","ووجدي كسيرٌ بلا جابرِ",130,"ر",1,0],["وإنِّيَ مغمودٌ وإِنْ كنتُ باتِراً","ولا بُدّ يوماً أن أُجرَّدَ من غِمدِي",131,"د",2,0],["وَإنِّيَ ممّنْ إِن نَبا عنه منزلٌ","وأنكرَ مثواه نآه فأبعدا",132,"د",2,0],["وَإنِّي مَتى ضنَّ الصّديقُ بقربهِ","أكنْ منه أسخى بالبِعاد وأجْوَدا",133,"د",2,0],["وَإنّيَ مَبْلوٌّ بِما لم تُبل بِهِ","فَلا تُبلِني فيهِ بلومِ المعاتِبِ",134,"ب",1,0],["وَإنِّيَ مِمَّنْ إِنْ نَبا عَنهُ مَنزلٌ","نَبا وَنَجتْ عَنهُ عِجالاً ركائبُهْ",135,"ب",2,0],["وإن يمت فالجزاء نارٌ","لأنه للضلال جاني",136,"ن",2,0],["وإني ما أنا عيسى","ولا المهديْ إلى السبل",137,"ل",1,0],["وإني ما أنا شيخ","ولا بالشابِّ والكهل",137,"ل",1,0],["وإني مطلق والكل","ل في قيد وفي غل",137,"ل",1,0],["وإني محك للزيوف مجري","بعصري ولا يبقى مع الحك زيبق",138,"ق",1,0],["وَإِنِّي منه في عَقابيل طَرْبِهِ","ويُبْقِي ويُمْضِي المِسْكَ رائحةُ المسكِ",139,"ك",1,0],["وإِنِّي مَنْ كَسْبُ المَعَالي مُرادُه","وغَيرُ جَزِيلاَتِ العَطَايَا طِلاَبُه",140,"ب",2,0],["وإني ما أقام عسيب يوماً","أقيم ودادكم مهما أقاما",141,"م",2,0],["وَأَنّي مِنَ القَومِ الَّذينَ هُمُ هُمُ","إِذا غابَ مِنهُم كَوكَبٌ لاح كَوكَبُ",142,"ب",1,0],["وَأَنّي مِنَ الشَعبِ الَّذينَ أَذا سَعوا","يَجلونَ قَدراً عَنِ حَؤولِ الحَوائِلِ",143,"ل",1,0],["وإنّيَ ممّن قد علقت بحبّهم","وليداً وفيهم قد أحيلت مآربي",144,"ب",2,0],["وإنّيَ مهما عشتُ أرجو لك البقا","وأرفعُ للرحمنِ مُبتهلاً كفّي",145,"ف",2,0],["وإني مع الأشياء لا بمعية","وليس معي شيء إذا كان لي فعلا",146,"ل",2,0],["وَإِن يَمَّم المَظلوم كَعبةَ عَدله","كَفاه الأَعادي وَهوَ في السَرج راكب",147,"ب",1,0],["وَإِني مِن القَوم الذين قَد انتموا","إِلَيكَ فَدوني لَيسَ يُغلق باب",148,"ب",1,0],["وإنْ يَمْسَسِ العاصِيْنَ قَرْحُكَ آنفاً","فأيدي الوَغَى عمّا قليلٍ تَوَالِئُ",149,"ا",1,0],["وإني من الأقدار في شر مستوى","فما لحياتي فيه بعْدٌ ولا قبل",150,"ل",1,0],["وأني مقيم بين كتبك للرضى","وللذكر ما أتلوه منها وما أُملي",151,"ل",2,0],["وإنيَ من مثوى الهدى وهو قبلتي","قريب وهل يغني من الصامت القرب",152,"ب",1,0],["وإني موفِّي كلَّ خلٍّ نصيبَهُ","وإن يَسْلُ عَنّي من هوى وحنين",153,"ن",1,0],["وَإِنّيَ مُثنٍ حامِدٌ ثمَّ شاكِرٌ","مَزايا كَريمٍ مَدحُهُ ليَ مَذهَبُ",154,"ب",1,0],["وَإِنّيَ مِمّا قَد جَنيتُ لَتائبٌ","كَما تابَ مِن فِعلِ الجِناية ماعزُ",155,"ز",1,0],["وَإِنّيَ مِنهُمْ قد يَئِسْتُ تَعمُّداً","ليَدْروا بأنّي قد رَجعْتُ إلى اِلْياسِ",156,"س",1,0],["وَإِنّيَ مِمَّن يُخمِدُ الحَربَ تارَةً","وَأُحمَلُ أَحياناً عَلَيها فَأَركَبِ",157,"ب",1,0],["وأنىَ مما قاله لمبرَّأٌ","فدعه كئيبا يعلِكُ الغيظَ والوَغْما",158,"م",2,0],["وإنيَ مسكينٌ وإنْ تك سائلا","عن الحالِ فاسأل من يُجيب فيصْدُق",159,"ق",1,0],["وإنيَ مُشْتاقٌ إلى ظل سَيِّدٍ","كريمٍ أرجِّيه لدفع المكائد",160,"د",1,0],["وإنيَ مَن يُردي الكماةَ ثباته","وقد هدَّ ركن الصبر في وثباته",161,"ت",2,0],["وإنيَ مَن يخشى الملوكُ نِزاله","ولم يخش صرف الدهر من عزماته",161,"ت",2,0],["وإنيَ مَن ترجو العفاة نواله","وتخشى أسود الحرب حَد شباته",161,"ت",2,0],["وإني من شلاشلها خَليُّ","ولم أكُ من صلاصلها بوَجْسِ",162,"س",1,0],["وإنى من لا يجمعُ الزادُ بيننا","على ثَمَدِ السيدان يوماً لخائف",163,"ف",1,0],["وَإِنّي مَتى أَعلُقُ بِسالِفِ وُدِّهِ","تَبَدَّلتُ مِن أَمري سَناماً بِمَنسَمِ",164,"م",1,0],["وإِنِّي منَ القَوْمِ الَّذِينَ عَرَفْتَهُمْ","إِذا ماتَ منهم سَيِّدٌ قام صاحِبُهْ",165,"ب",2,1],["وَإِني ما لَم ترمني العيس وَالنوى","بِقَدر حَياة في لقائك طامع",166,"ع",1,0],["وإني من قوم يبين بطفلهم","من الحدس عنوان الرياسة في المهد",167,"د",1,1],["وَإِنِّيَ مِن قَومٍ سَيُذكَرُ فيهِم","بَلائي إِذا ما غَصَّ بِالماءِ شارِبُه",168,"ب",2,0],["وإني مُذ شطّت بيَ الدار عنهُمُ","أخو قَلَقٍ ما يَنْقضي وأنينِ",169,"ن",1,0],["وأني مذ نأيت رايت ضري","تبدى جهرة وازداد هوني",170,"ن",2,0],["وإنّي مع تعمّدهم خمولي","ألوح كأنّني حرف النداء",171,"ا",2,0],["وإني من لذات دهري قانع","بحلو حديث أو بمر عتيق",172,"ق",1,0],["وَأَنّي مُذْ قَصَرْتُ يَدَيَّ طالَتْ","الَيْكَ يَدُ العَدُوِّ المُسْتَفيقِ",173,"ق",1,0],["وإنّي مع الساعات كيف تقلَّبت","لأسهُمها إن فوَّقت مُتَهَدَّفُ",174,"ف",1,0],["وإني من أناس ما أحلنا","على عزم فأعقبنا نزولا",175,"ل",2,0],["وإِنِّيَ من قومٍ كِرامٍ أَماجدٍ","لَهم بيتُ مَجدٍ باذِخٍ دونَهُ النَسرُ",176,"ر",1,0],["وإنيَ من معشرٍ حاضرينَ","يعيشون في موطن مُمرِعِ",177,"ع",1,0],["وإني من الحيّ اليماني لسيد","وما الناسُ إلا سيدٌ ومسودُ",178,"د",1,0],["وأن يمدّ به لي","عينٌ وميم وراء",179,"ا",2,0],["وإنّي من قومٍ قديماً ومُحدَثاً","تُباعُ عليهم بالألوف القصائد",180,"د",1,0],["وَإِنّي مِن قَيسٍ وَقَيسٌ هُمُ الذُرى","إِذا رَكِبَت فُرسانُها في السَنَوَّرِ",181,"ر",1,0],["وإن يمَّمتَه يمَّمتَ بحراً","فُرَاتاً ما لنا عنه صدورُ",182,"ر",1,0],["وَأَنّي مُلاقٍ بَعدَما غالَ والِدي","وَأَنّي مُلاقٍ غولَ عَمرِو بنِ كاهِلِ",183,"ل",1,0],["وإنّيَ مهما قد أطلتُ بوصفِهِ","فلستُ بجارٍ غايةَ الحدَّ والحصر",184,"ر",1,0],["وإني معرض عمن قلاني","وعمن عند مولانا هجاني",185,"ن",2,1],["وإن يمزج مصحفه بقلب","قضى في حينه بأشد باس",186,"س",1,0],["وَإِنِّى مُقيمٌ فِى سَوَاكِنَ مائِسٌ","وَرُوحِى لَدَى الأَحبابِ تَسرى وَتَدلجُ",187,"ج",1,0],["وإنِّي من هذا أولئك ناظرٌ","بياضُ العطايا في سوادِ المطالبِ",188,"ب",1,0],["وإنيَ منهم واحد غير أنه","وشى بيننا واشٍ من البين غاشم",189,"م",1,0],["وإني مقيم حيث لا تُذْعَرُ المنى","ولا تستطيع النائبات تنوب",190,"ب",1,0],["وإني ممن أسلم الأمر فيكمُ","إليه وممن بالإمامة قلَّدا",191,"د",2,0],["وإني من أعطى الوجودَ كماله","كما أنه أعطى الكثير من القل",192,"ل",1,0],["وإني من حقيقتِه بسرِّي","كمثلِ الشمسِ إذ تُعطي سناها",193,"ا",3,0],["وإني من أهل البيت ما أنا بائنٌ","ولا أنا حدَّاد ولا أنا زافر",194,"ر",1,0],["وإني من الأضدادِ في كلِّ حالة","كما هو مثل الغرِّ في اللوّنِ والجونِ",195,"ن",1,0],["وإني من القوم الذين إذا سروا","لغزو تراع الأرض من شدة الركض",196,"ض",1,1],["وإني مع الساعي إليكم بسيفه","إذا أحدث الأيام في عظمكم كسرا",197,"ر",2,0],["واني مُذِ اليوم الذي لم أُطِق بهِ","عن ابنة أُمّي مدفعاً لعلى وعدِ",198,"د",1,0],["وَإِنِّي مِنكَ الشِّبل في كُلِّ غايَةٍ","وَحَسبي فَخراً أَن تَكونَ قَريبي",199,"ب",2,0],["وَإِنّي مَعمورُ الزَمانِ بِشَخصِها","يمثل لي في الأَمسِ وَاليَومِ وَالغدوِ",200,"و",1,0],["وَإِنّي مَليٌّ يا جُمانَةُ بِالهَوى","وَصِدقِ الهَوى إِن كانَ ذَلِكَ يُقنِعُ",201,"ع",1,0],["وإني من القوم الذين لباسهم","إلى اليوم مذ عهد النبيء التعفف",202,"ف",1,0],["وإني ما ألهّت حتى محمداً","وان شعَّ نوراً خالداً وعلوما",203,"م",2,0],["وإنيّ مع مرّ هذا الجفاء","لحلو التلاقي به منتظِر",204,"ر",1,0],["وإني من جدواك مازلت آمناً","بمنزلة علياً لها الدهر خادم",205,"م",1,0],["واني من البيت الذي شاع مجده","ودان له الامجاد في العرب والعجم",206,"م",1,0],["وَأَنّي مُقيمٌ عَلى حُبِّها","وَنَفسِيَ عَن بَدَني راحِلَه",207,"ل",2,0],["وأن يميني على الأيمانِ","فذاك رأس المال والأملنِ",208,"ن",1,0],["وإني مَشُوقٌ كُلّما شابَ رأسهُ","بحُبِّ التي يشتاقُهَا كُلّما شَبّا",209,"ا",1,0],["وأنّي منحتُ الناسَ محضَ مودّتي","فَما منحوني غيرَ أهلٍ ومَرحَبِ",210,"ب",1,0],["وأني مت قبل ورود خطبٍ","أتى فأثار في الأكباد جمرا",211,"ر",2,0],["وإني من الورق السواجع بالضحى","ولكنني من بينها لم أطوق",212,"ق",1,1],["وإنّي من القومِ الذين ترى لهمْ","سِجالاً وأبواباً تُفيضُ المقاريا",213,"ي",2,0],["وَانِّيَ مُذ شاهَدت فِيَّ جَمالها","بِلَوعَة اِشواقِ المَحَبَّةِ والِع",214,"ع",1,0],["وإني معيذ سيدي أن سيغتدي","ملولاً لنظم جاد في سبكه الفكر",215,"ر",1,0],["وَإِنّي مِنَ القَومِ الَّذينَ هُمُ هُمُ","إِذا ماتَ مِنهُم سَيِّدٌ قامَ صاحِبُه",216,"ب",2,0],["وإن يممت يمّ نوالهم أو","نزلت بهم تجد فتحاً قريبا",217,"ب",2,0],["وإني من سيوفك لست أبنو","أنافح من قلاك ولا أبالي",218,"ل",2,0],["وأني مذ فارقت لا ذقت بعده","محياه لم أصحب حميماً سوى البكا",219,"ك",2,0],["وَإِني مَتى ما يَلقَني صارِماً لَهُ","فَما بَينَنا عِندَ الشَدائِدِ مِن صَرمِ",220,"م",1,0],["وإني مما يحدث الهجر جازع","وما أنا مما يحدث الدهر جازع",221,"ع",1,0],["وأني مليكُ الأرضِ وابن مليكها","وسيدُ قومٍ من تقدمَّ والتالي",222,"ل",2,0],["وإني مالُ مَن لا مالَ معه","ونَصرة مُستَضامٍ بي استجارا",223,"ر",2,0],["وإنى مخلص سرا وجهرا","ونفسي تكره الأمر الحراما",224,"م",2,0],["وَإِنِّي مِنَ البيَتِ الَّذِي تَعلَمِينَهُ","أَقَامَ عَمُودَ الدِّينِ لَمَّا تَأَوَّدَا",225,"د",2,0],["وأنّي مما أخمد الحرب تارةً","وأُحمل أحياناً عليها فأركب",226,"ب",1,0],["وإني من قوم كرام يزيدهم","شماساً وصبراً شدة الحدثان",227,"ن",1,1],["وأني متى أُنكب من الدهر نكبةً","أكفكفُ غربيَها بصبرٍ فتىً جزل",228,"ل",1,0],["وَإِنِّيَ مِثلَكَ أَفتَخِرُ","بِأَنِّيَ بَأسيَ أَدَّكِرُ",229,"ر",1,0],["واني مع الساعي عليكم بسيفه","إذا عظمكم يوماً رأيت به كسرا",230,"ر",2,0],["وإني مقيل للكريم عثاره","إذا جاء في ذنب بغير تعمد",231,"د",1,0],["وإن يملكْ سحاتيتاً","فللقطةِ والقط",232,"ط",1,0],["وأني من الشيخ الجليل وظله","مطنب بيت تحت ظل الغمائم",233,"م",1,0],["وَأَنّي مَتى أُنفِق مِن المالِ طارِفا","فَإِنّي أَرجو أَن يَثوبَ المُثَوَّبُ",234,"ب",1,0],["وَأَنّي مِن شَرابِ الشَي","خِ كِسرى أُكثِرُ القَلزا",235,"ز",2,0],["وإني مؤمنٌ بكتاب حُسنٍ","ينمِقّهُ العذار بلا مِداد",236,"د",1,0],["وإني من هواك شربت كأسا","فلا أصحو إلى يوم الحسابِ",237,"ب",1,0],["وإني من شوقي إليك وحرقتي","غدوتُ ضئيلاً ربما لست أُبصَر",238,"ر",1,0],["وإني من أناس ذا كريه","وحاشا أن يكون لنا نسيا",239,"ي",2,0],["وإنّي من العلياءِ في الكنفِ الذي","به حظُّ فضلي كلَّما انحطَّ يستعلي",240,"ل",2,0],["وإني من قوم إذا ما تنمر ال","ليالي تلقوا صرفها بالتنمر",241,"ر",1,1],["وَإِن يَمسسهُ ضُرٌّ مِنهُ يَشكو","فذلك ضرُّ بُعدكَ بَعدَ قُربِك",242,"ك",1,0],["وَأَنّي محبٌّ لِلحَبيبِ محمّدٍ","حَبيبُكَ يا مَولايَ وهو المُعَظَّمُ",243,"م",1,0],["وَإِنِّي مَتى أَنظُر إِلى مَن أُحِبُّهُ","أَشارَت من الأَعداء نَحوي الأَصابِعُ",244,"ع",1,0],["وَإِنَّ يَميني عَلى كُلِّ ما","حَوَيتَ مُسَلَّطَةٌ قادِرَه",245,"ر",2,0],["وإني من قوم كرام أعزة","مناقبهم جلّت عن العد والحصر",246,"ر",1,0],["وَإِنّي مَتى أُحمَل عَلى ذاكَ أَطَّلِع","إِلَيكَ عُيوناً لا أُحِبُّ اِطِّلاعَها",247,"ع",3,0],["وانّي متى ما أدعُ باسمكَ لا تُجِب","وكنتَ جديراً ان تجيبَ وتُسمِعا",248,"ع",2,0],["وإنِّي من اللهِ في نعمةٍ","وإياهُ أسألُ من فضلهِ",249,"ل",2,0],["وأني من زبائنها","أخو شيش ودوبارة",250,"ر",2,0],["وإني مليّ أن أكدّر ما صفا","لكم بعد هذا البلاد من الشّرب",251,"ب",1,0],["واني معهم اهدى دعاء","وتهنئة بعيد الفطر غرا",252,"ر",2,0],["واني منه عن رشف القناني","لفى شغل وعن عزف القيان",253,"ن",1,0],["واني متى افرغ لها الجهد تمتلئ","لدى عياب حقبة وحقائب",254,"ب",1,0],["واني مع جهد البلاء مثابر","على خدمة يرضونها ومواظب",254,"ب",1,0],["وَإِنّي مَتى أَسأَل بِهِم كُلَّ راكِبٍ","لِيُظهِرَ لي خَيراً تَأَبَّطَ لي شَرّا",255,"ر",2,0],["واني مدى الأيام تاللهِ ناصرٌ","لهم ومحامٍ عنهم ومجاهد",256,"د",1,0],["وإني من الإكبارِ أُهدي قلائداً","لعلَّ بِحرفِي تستلذُ المسامعُ",257,"ع",1,0],["وإني مذ غدت هممي سيوفا","لأعلمُ أنني أبدا ضريبُ",258,"ب",1,0],["وإن يمت قيصر فانظر لصورته","وإن يكونوا همو في البحر حيتانا",259,"ن",2,0],["وإنّي مِنَ الإبريزِ أسبكُ لفظها","وتأتي مَعانيهَا مِن القَلبِ هَكَذَا",260,"ذ",2,0],["وإن يمناه ركن اللائذين به","من الخطوب ومثل الركن تستلم",261,"م",1,0],["وإنّي موقِنٌ باللهِ صِدقًا","سَينقذنا مِن الكربِ العظيم",262,"م",1,0],["وأنّي منكِ ما أصبحتُ إلاّ","أسيراً لا يبالي الأسرَ دهرَا",263,"ر",2,0],["وَإِنّي من أَرعادكم وَبروقكم","وإيعادكم بالقتل صم مسامعي",264,"ع",2,1],["١٧-وأنّي مشاعٌ وحقّي مُضاعٌ","وأضحت رباعي لنذلٍ حلال",265,"ل",1,0],["وإنّي ما عرفتُ من القوافي","يقيناً..صارَ بعدَ الظنِّ شعرا",266,"ر",2,0],["وإنّي مُذْ ستَرتَ عليَّ عيْبي","بِبابكَ عن وقوفٍ لا أميلُ",267,"ل",1,0],["وإني موقن ببلوغ ركبي","مآربه وما جنح الأصيل",268,"ل",1,0],["وَأَنْ يَمْضِي الشَّبَابُ بِنُورِ هَدْيٍ","وَأَنْ يَجْعَل مِنَ التَّقْوَى نِصَابَا",269,"ب",2,0],["وأُنيم ُعيني علَّ طيفَك بغتةً","يأتي إليَّ فما عشقْتُ رحيلا",270,"ل",2,0],["وأنيَ مذْ أمسيتُ حامل سره","أسوق القوافي سَوْق حادٍ جِمالَهُ",271,"ل",2,0],["وإني موقن حمداً لربي","بأن الحق مذهبهم أنارا",272,"ر",2,0],["وإني من الحب العظيم وضعته","هززتُ إليه العشق زهرا يُبهّجُ",273,"ج",1,0],["وإنّي ماعشقت سواه جرحا","وما قُطّعتُ إلاّ كان مني!!",274,"ن",2,0],["وإنيَّ مسؤولٌ عن الفقر في الورى","سؤالي أمام الله ( عمَّ..) ولا عذرُ...",275,"ر",1,0],["وأني مسحور بماء شبابها","ولا بد لي من أن أحوز انجذابها",276,"ب",3,0],["٢- وإنّي متى أطبقْتُ جفني تكشّفتْ","لحونٌ تُغنّيها عَليَّ الحمائمُ",277,"م",1,0],["وانّي ما زلتُ في عالم ٍ","تثورُ الشرورُ به كالحِمَمْ",278,"م",1,0],["وأني مثل عابر بليا آيات أوطان","تاه وتعثر في بقايا ظنونه",279,"ن",2,0],["وأني من أمسى الخلود مطأطأ","بعتبته للرأس منتطر الاذن",280,"ن",1,0],["واني من عذيرة اذ غزاها","هوى العذري فيه الصبّ مضنى",281,"ن",2,0],["وإني مبايعُ عشرينها","بقلبٍ سجى بالجوى موحشا",282,"ش",2,0],["وأن يمكثا في ألفة ومحبة","يظل غيورا منها كل فرقد",283,"د",1,0],["‏ ‏وإني مطيعٌ بأمر يديك","‏ ‏ فهاتِ بأمرٍ لألثمَ فاك؟",284,"ك",1,0],["وإني محضْتُك أصفَى الغرام","تغذيْتَ منه بشعرٍ يُحَبُّ",285,"ب",1,0],["وإني مَعينٌ دائم لنمائهم","عنِ البرّ والتقوى أعيش مُحاميا",286,"ي",2,0],["وإني متى أعص التجلد والأسى","فللشوق مني والغرام مطيع",287,"ع",1,0],["وإنّيَ ما استحْدثتُ بعد فراقِهِ","خليلاً ولا استبدلتُهُ بِبَدِيلِ",288,"ل",1,0],["وإنّي مجتبيها ذات يوم","ألاقيها لأدفعها سراحي",289,"ح",2,0],["وإن يمت بين ملتف الظبا سغبا","فبعد ما أطعم الهندي حزب شقا",290,"ق",2,0],["وإني متى أدع لمجدك بالبقا","دعوت لنفسي أن أعزَّ وأكرما",291,"م",2,0],["وَإِنِّي مُنْذُ أَنْ عَنِّي تَنَاءَتْ","لَظَى غَيْظِي أُجَرَّعُهُ قَعِيدا",292,"د",2,0]]}