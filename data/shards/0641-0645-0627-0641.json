ر بهذا العذل","https://www.aldiwan.net/poem60798.html","المتقارب"],[365,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[365,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[367,"أيا بدر قد أسهرت عيني فارقد","https://www.aldiwan.net/poem17183.html","الطويل"],[372,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[381,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[381,"أرى السحر ما توحيه أجفانه المرضى","https://www.aldiwan.net/poem48828.html","الطويل"],[404,"أبعد اليوم تدخر الدموعا","https://www.aldiwan.net/poem33680.html","الوافر"],[407,"خليلي هل من رقدة أستعيرها","https://www.aldiwan.net/poem50173.html","الطويل"],[410,"إلى الله أشكو روعتي ورزيتي","https://www.aldiwan.net/poem31862.html","الطويل"],[430,"سرى النسيم بعرف من ربي الطلل","https://www.aldiwan.net/poem41399.html","البسيط"],[438,"دعوا مقلتي تغفي إذا لم يكن وصل","https://www.aldiwan.net/poem2512.html","الطويل"],[440,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[440,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[442,"عزاء بني سمح فما قد لقي سمح","https://www.aldiwan.net/poem14443.html","الطويل"],[442,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[459,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[459,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[478,"عليل الوجد عندك لا يعاد","https://www.aldiwan.net/poem15313.html","الوافر"],[483,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[501,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[537,"أشاقتك أطلال بوجرة درس","https://www.aldiwan.net/poem23852.html","الطويل"],[539,"رام الفخار يا لها من مسخره","https://www.aldiwan.net/poem48183.html","عموديه"],[539,"كما قلتم روض المعالي به خصب","https://www.aldiwan.net/poem48292.html","عموديه"],[552,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[559,"إليك من البعد قلبي دنا","https://www.aldiwan.net/poem33810.html","المتقارب"],[559,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[560,"إذا لم يكن معنى حديثك لي يدرى","https://www.aldiwan.net/poem69370.html","الطويل"],[588,"أثابك مولاك المهابة والرضى","https://www.aldiwan.net/poem11505.html","عموديه"]],"verses":[["فَما في نَعيمٍ بَعدَ فَقدِكِ لَذَّةٌ","وَلا في سُرورِ لَستِ فيهِ سُرورُ",0,"ر",1,0],["فَما فَضَّنا مِن صانِعٍ بَعدَ عَهدِكُم","فَيَطمَعَ فينا زاهِرٌ وَالأَصارِمُ",1,"م",1,0],["فَما في الناطِقينِ فَمٌ يُوَفّي","عَزاءَ الدينِ في هَذا المُصابِ",2,"ب",1,0],["فَما في حَياةٍ بَعدَ مَوتِك رَغبَةٌ","وَلا في وِصالٍ بَعدَ هَجرِكَ مَطمَعُ",3,"ع",1,0],["فَمَا فَاتَكَ الصَّبْرُ الجَمِيلُ عَلَى الأَذَى","لأَنِّكَ بِالغِبِّ الحَمِيدِ تَدِينُ",4,"ن",1,0],["فَمَا فِي الغِيدِ مَنْ يَشْجُو بِصَوْتٍ","أرَقَّ وَلا بِإِيقاعٍ أَحَنِّ",5,"ن",1,0],["فما فاسد الأخلاق بالعلم مُفْلِحاً","وإن كان بجراً زاخراً من بحاره",6,"ر",2,0],["فَما فارَقتَ كِندَةَ عَن تَراضٍ","وَما وَبَّرتَ في شُعَبى اِرتِغابا",7,"ب",2,0],["فَما في سَليطٍ فارِسٌ ذو حَفيظَةٍ","وَمَعقِلُها يَومَ الهِياجِ جُعورُها",8,"ر",3,0],["فَما في كِتابِ اللَهِ تَهديمُ دارِنا","بِتَهديمِ ماخورٍ خَبيثٍ مَداخِلُه",9,"ل",2,0],["فما فُدرٌ عواقل أحرزتها","عَمايةَ أو تضمنهنَّ شِيبُ",10,"ب",1,1],["فَما فَضائِلُنا إِلّا فَضائِلُهُ","وَلا مَفاخِرُنا إِلّا مَفاخِرُهُ",11,"ر",2,0],["فما فات رزق من تنبه للسرى","ومن يتمنى رزقه وهو نائم",12,"م",1,0],["فما فيك من ظل لغُلِّ ظهيرةٍ","وما فيك من جدوى لجانٍ وحاطبِ",13,"ب",1,0],["فما فضلُهُ والمدحُ دعوى ومُدَّعٍ","ولكنْ هما مِسكٌ ذكيٌّ ومَائِثُهْ",14,"ث",2,0],["فما في حياتك لي مَفْرَحٌ","ولا في مماتك لي مَتْرَحُ",15,"ح",1,0],["فما فيهما لي سَلْوَةٌ بَلْ حَزَازَةٌ","يَهِيجانِها دُونِي وأَشْقَى بها وحْدي",16,"د",2,0],["فما فاتني فكأن لم يفت","وما ضاع لي فكأن لم يضع",17,"ع",1,0],["فما في عودتي يوماً","إلى فضلكَ من إثمِ",18,"م",1,0],["فَما فَضلَةٌ مِن أَذرِعاتٍ هَوَت بِها","مُذَكَّرَةٌ عَنسٌ كَهادِيَةِ الضَحلِ",19,"ل",1,0],["فَما في شُربِها إِثم وَنُكرٌ","وَشِربُ الخَمرِ نُكرٌ أَيَّ نُكرِ",20,"ر",1,0],["فَما فاضَ ماءُ النيلِ إِلّا بِمَدمَعي","لَقَد مَرَجَ البَحرَينِ يَلتَقِيانِ",21,"ن",1,0],["فَما فاتَني حَظّي مِنَ اللَهوِ وَالصِبا","وَما فاتَني حَظّي مِنَ المَجدِ وَالعُلى",22,"ل",2,0],["فما في سُرُج الص","بر على أهوالها زيت",23,"ت",1,0],["فَما في القِوى أَنَّ السَماواتِ تُرتَقى","بِجَيشٍ وَأَنَّ النَجمَ يُغشى فَيُغضِبُ",24,"ب",1,0],["فَما في سَجاياكُم مُنازَعَةُ العُلى","وَلا في طِباعِ التُربَةِ المِسكُ وَالنَدُّ",25,"د",1,0],["فما في العلو من قدس خفيف","وما في الأرض من قدس ركين",26,"ن",1,0],["فما في الحقِّ أن يشقَى عليلاً","لديكَ وقد سعِدتَ به صحيحا",27,"ح",2,0],["فَما فَلَّ رَيبُ الدَهرِ مِن ذَلِكَ الشَبا","وَلا زَعزَعَ المَكروهُ مِن ذَلِكَ الرُكنِ",28,"ن",1,0],["فَما فُؤادي بِجازِعٍ أَسَفاً","ما أَخلَفَ ذا مَطامِعٍ ظِنَنُه",29,"ن",2,0],["فَما فارَقَتنا رَغبَةً عَن جِماعِنا","وَلَكِنَّما غالَت مُفَدّاةَ غولُها",30,"ل",3,0],["فَما فاضَلَت بَيتاً بِبَيتِكَ عامِرٌ","إِلى المَجدِ إِلّا كانَ بَيتُكَ أَفضَلا",31,"ل",2,1],["فما فيه عن المعروفِ مَنعٌ","ولا فيه عن الحَمْدِ ازوِرارُ",32,"ر",1,0],["فَما فُزتُ بِالوَعدِ الَّذي رُمتُ قَبضَهُ","وَقَد فاتَني النَومُ الَّذي كانَ في قَبضي",33,"ي",1,0],["فَما فيهِ شَيءٌ ناقِصٌ غَيرَ خَصرِهِ","وَلا فيهِ شَيءٌ بارِدٌ غَيرَ ريقِهِ",34,"ق",2,0],["فَما فَهمُ الأَشياء بالدرْسِ وَحْدَهُ","ولكنه بدءُ التفهّم والدّرْسِ",35,"س",1,0],["فما فُتِنتُ بردفٍ غَيرِ مُرْتَدَفٍ","ولا جُنِنْتُ بِخَصرٍ غَيرِ مُخْتَصَرِ",36,"ر",1,0],["فَما فازَ بِالمِسكِ إلّا فتىً","تَيَمّمَ دارِينَ أو دارَها",37,"ر",3,0],["فَما فَتَحتُ فَمي إِلّا كَعَمتُ فَمي","وَلا مَدَدتُ يَدي إِلّا رَدَدتُ يَدي",38,"د",2,0],["فَما في الأَرضِ مِن شَرَفٍ يَفاعٍ","سُبِقتَ بِهِ وَلا خُلُقٍ يَفاعِ",39,"ع",1,0],["فَما فاتَني ما عِندَهُ مِن حِبائِهِ","وَلا فاتَهُ مِن فاخِرِ الشِعرِ ما عِندي",40,"د",2,0],["فَما فَزِعَت مِمّا يُريدُ وَيَبتَغي","وَلا جَزَعَت مِمّا تُلَقّى وَتوعَدُ",41,"د",1,0],["فما فاتَهم خيرٌ ولا نَالَ سَعْيَهم","من النّاسِ غادٍ في البلادِ ورائحُ",42,"ح",1,0],["فَما فَرَغَت حَتّى أَتى الماءُ دونَها","وَسَدَّت نَواحيهِ وَرُفِّعَ دابِرُه",43,"ر",2,0],["فما فارَقَ البِشْرَ لمّا اكْفَهَرّ","ولا نَسِيَ العَفْوَ لمّا انْتَقَمْ",44,"م",1,0],["فما في حَريمٍ بعدَهَا منْ تَحَرُّجٍ","ولا هَتْكُ سِترٍ بعدَها بمحَرَّم",45,"م",1,0],["فَما في جودِهِ مَنٌّ","وَلا في بَذلِهِ حَبسُ",46,"س",1,0],["فَما فَرعُ الفَتاةِ إِذا تَوارَت","بِمُفتَقِرٍ إِلى سَرحٍ وَضَفرِ",47,"ر",1,0],["فَما فيكُمُ مِن خَيرٍ يُدَّعى بِهِ","يُفَرِّجُ عَنّي بِالمَضيقِ المَسالِكا",48,"ك",2,0],["فَما فَتِئَت خَيلٌ تَثوبُ وَتَدَّعي","وَيَلحَقُ مِنها لاحِقٌ وَتَقَطَّعُ",49,"ع",1,0],["فَما فَتِئَت حَتّى كَأَنَّ غُبارَها","سُرادِقُ يَومٍ ذي رِياحٍ تَرَفَّعُ",49,"ع",1,0],["فما في سجاياكم منازعة العلا","ولا في طباع التربة المسك والند",50,"د",1,0],["فَما فَخَرَت تَيمٌ بِيَومِ عَظيمَةٍ","وَلا قَبَضوا إِلّا بِخالِفَةٍ صِفرِ",51,"ر",1,0],["فَمَا فِي القِلادَةِ غَيْرُ الفَرِي","دِ وَلا فِي الأَشِعَّةِ مَا يُتْهَمُ",52,"م",1,0],["فَمَا فِي الأُولَى خَالَطْتَ إِلاَّ مَنِ اجْتَلَى","بِمَسْرَاكَ مَسْرَى الْكَوْكَبِ المُتَكَامِلِ",53,"ل",1,0],["فَمَا فِي غُرْبَتِي إِلاَّ سِهَامٌ","وَمَا فِي مُهْجَتِي غَيرُ الجِرَاحْ",54,"ح",1,0],["فَمَا فِي المُلُوكِ سِوَى أَعْبُدٍ","وَمَا فِي المَلِيكَاتِ إِلاَّ إِمَاءْ",55,"ا",2,0],["فَمَا فِي نَابِغِيهِ حِجىً وَعِلْماً","وَصِدْقَ مُروءَةٍ كَخَلِيلِ ثَابِتْ",56,"ت",1,0],["فما في الغاب من ناب","فزمجِر أيها الجابي",57,"ي",1,0],["فما في المشرقين لهُ نظيرٌ","ولا في المغربين ولا بكوفَه",58,"ف",2,0],["فما في الناس من بَشم عَلِيلٍ","ولا طاوٍ أضَرَّ به الهُزَال",59,"ل",1,0],["فَمَا فُؤَادِي بِجَازِعٍ أَسَفاً","مَا أَخْلَفَتْ ذَا مَطَامِعٍ ظِنَنُهْ",60,"ن",2,0],["فما فتحت جفوني وهي دامية","من الرّمال أعان الله أجفاني",61,"ن",2,0],["فما فاتني فكأنْ لم يفتْ","وما ضاع لي فكأنما لم يضِعْ",62,"ع",1,0],["فَما فَتِئوا حَتّى رَأَوها مُغيرَةً","كَرِجلِ الدِبى في كُلِّ رَبعٍ وَفَدفَدِ",63,"د",1,0],["فما فهموا مدائحهم","ولا قضَّوْا بها وطَرى",64,"ر",2,0],["فما في الهوى مَرعىً يطيبُ لذائق","ولا مَوردٌ عذبٌ يَلذّ به حاسِ",65,"س",1,0],["فما في الذل للمحبوب عارٌ","سبيل الحب ذلٌّ للمراد",66,"د",1,0],["فما فيكم من قرّ في الصدر قلبّه","ولا من رأى حصنا يقيه وان سما",67,"م",2,0],["فما فارقت قوما فاستقامت","لهم حال ولا غمضت جفون",68,"ن",1,0],["فما فاتَهُ في الشبابِ الوقارُ","ولم يُنسِهِ الشّيبُ عهدَ الدَّدَنْ",69,"ن",1,0],["فَما فيهِ تَضييعٌ عَلَيكَ وَلا تَرى","لَهُ في مَراضي مَن تُصافي مُشاكِلا",70,"ل",2,0],["فَما فُرقَةُ القالِينَ عِندي رَزِيَّةٌ","أُقيمُ لَها في نَدوَةِ الحَيِّ مَأتَما",71,"م",2,0],["فما فرحةٌ فيها لخلق وإن حظى","بأكثر في التعديد من ترحاتها",72,"ت",3,0],["فَما في بَنى حَوّاءَ فَرعٌ يَفوقُهُ","بِفاضِلَةٍ دونَ النَبِيِّ المُكَرَّمِ",73,"م",1,0],["فَما فَتِئَت خَيلي تَقُصُّ طَريقَهُم","وَتَقتُلُهُم بَعدَ اِشتِباكِ الحَنادِسِ",74,"س",1,0],["فَما في لَوعَةِ الآباءِ شكٌّ","ولا في ذاهبِ الأَبناءِ حيلَه",75,"ل",2,0],["فما فَلّلتْ حربُها لي شَباً","ولا ازددتُ بالسِّلم عنها رِضا",76,"ا",1,0],["فَما فازَ إِلّا مَن يَبيتُ صَباحُهُ","شَرابُ ثناياهُ وَمِنها غَبوقُهُ",77,"ق",2,0],["فَما فاتَ سَهمُ الحَظِّ مَن كُنتَ ناظِراً","إِلَيهِ قَريباً مِنهُ بِالكَوكَبِ السَعدِ",78,"د",1,0],["فَما فاتَني شيءٌ يَطولُ تَأَسُّفي","عَليهِ سِوى لُقياكَ يا اِبنَ مُحَمَّدِ",79,"د",1,0],["فَمَا فيِ سَلاَ شَيْءٌ يُسَلِّي ذَوِي الأَسَى","سِوَى بَحْرِهَا الزَّخَّارِ ذِي الُّلجَجِ السُّمْرِ",80,"ر",1,0],["فَما فَتِئَت تَرمي بِرَحلي أَمامَهُ","وَأَحلاسِهِ مِن مُؤخِرٍ وَمُقَدَّمِ",81,"م",1,0],["فما فيهِ عَيْبٌ غيرَ أَنَّ جُفونهُ","مِراضٌ وأَنَّ الخَصْرَ منه ضَعيفُ",82,"ف",1,0],["فَما فَزِعوا إِذ خالَطَ القَومُ أَهلَهُم","وَلَكِن رَأَوا صِرفاً مِنَ المَوتِ أَصهَبا",83,"ب",2,0],["فما فتقت اسيافكم من جلودهم","يرتقه اللدن الوشيج بشله",84,"ل",2,0],["فما فقدنا اباه عن رؤيته","والشبل كالليث في خلق وفي خلق",85,"ق",1,0],["فما فيكِ إلا الذي","يعافُ غدا أو يُمَلّ",86,"ل",1,0],["فما فيكِ حسنٌ للحبيبةِ طالعٌ","ومرآةُ قلبي لم تزل تُطلعُ الحُسنا",87,"ن",2,0],["فَما في حُسنِهِ لَيتٌ وَعلٌّ","يَرى مُتَقَوِّلٌ بِهِما اِحتِجاجا",88,"ج",2,0],["فما فاز امرؤ الا بسيفض","صقيل أو لسان أو خروف",89,"ف",1,0],["فَما في الخلقِ أَسرعُ منك نَصراً","لملهوفٍ وأَسمعُ منكَ أذنا",90,"ن",2,0],["فما فزت مع هذا العذاب بطائلٍ","سوى حسن ظني في تمني وصاله",91,"ه",1,0],["فما في فضل عنك يخطر فيه لي","سواك فوقتي فيك غير موقت",92,"ت",1,0],["فَما فَتِئَت جُنودُ السِلمِ حَتّى","رَأَينا القَومَ كَالغَنمِ السَوامِ",93,"م",1,0],["فما فرحى بالعيش وهو قصيدة","مهلهلة الأوزان ليست لشاعر",94,"ر",1,0],["فما في الحياة سوى الموبقات","فلذ بالممات وهم ونم",95,"م",1,0],["فَما فَضل من بِالسُكر قَد زالَ عَقله","عَلى غَيره مِن جنسه الحيواني",96,"ي",1,0],["فَما فَضل الأُلى سكروا فَزالَت","عُقولُهُم عَلى عَمى الحَميرِ",97,"ر",1,0],["فما فاتَهُ غَرَضٌ في الأناةِ","ولا نالَه زلَلٌ في العَجَل",98,"ل",1,0],["فما في أمرِ إدراري مَعابٌ","ولا دُرَري إذا جُعِلَتْ حُلاكا",99,"ك",2,0],["فما في ضَميري اليومَ من طارقِ الأسَى","مَكانٌ لتَذْكارِ السُّرورِ الّذي انقَضى",100,"ض",2,0],["فَما فَلَّلوا إِلّا بِسَيفٍ مُفَلَّلٍ","وَلا أَقصَدوا إِلّا بِرُمحٍ مُقَصَّدٍ",101,"د",1,0],["فَما فِعلُها إِلا الغناءُ كما تَرى","فأعداؤُها فيها سَواءٌ ومالُها",102,"ل",3,0],["فَما فارق الرَأي الأَصيل مُهَذب","وَلا رَوَّع الضرغام مِن قَعقع الشنّا",103,"ن",2,0],["فَما في حَياتي لَو يَجود بِها سِوى","عَذاب أَراهُ في مَحبَتِهِ فَرضا",104,"ض",2,0],["فما فقد العفاة كريم قوم","وقد وجدوا نداك لهم سميعا",105,"ع",2,0],["فَما فقرها نَحو السُتورِ وَإِنَّما","يَردُّكَ عَنها نورها لا سُتورُها",106,"ر",3,0],["فما في حياتي بعدَهُ ليَ راحَةٌ","فيا طولَ حُزني إن تطاولَ بي عُمري",107,"ر",2,0],["فما فؤادي سلا عن حفظ حبهم","وعهدهم ليس لي عنهم بمبتدل",108,"ل",1,0],["فما فتحت يوم الكريهة مقلة","لدى الروع إلا والسيفو لها كحل",109,"ل",1,0],["فما فَكَّتْ حُدَاءً عن رِكابِي","ولا كفَّتْ يميناً من زِمامي",110,"م",2,0],["فما فِي العويل لَهُ من كفِيءٍ","وَلا فِي الدُّموع لَهُ من شِفاءِ",111,"ا",2,0],["فما فسحة الأعمار إِلا أمانيا","إِذا انقضت الأَعمار لم يمنع الفسح",112,"ح",1,0],["فما فقدت مذ كنت أملاك حمير","ولا لسواك الحمد عند المواسم",113,"م",1,0],["فما في الحميّة أن يمنَع ال","مليءُ وذو حقّه مُعسرُ",114,"ر",1,0],["فما فوقه مَرمىً لظنٍّ موسَّعٍ","ولا عنه للحقّ المضَيَّعِ مَذْهَبُ",115,"ب",1,0],["فما فيهِ مِنَ الاِقواءِ شيءٌ","يُعابُ به ولا فيه سِنادُ",116,"د",1,0],["فما في الحشا مجلى لغير سهامها","ورفض السوى فرض علي لغيرتي",117,"ي",1,0],["فما فوقَ التُّرابِ يَعودُ فيه","وباقي الأَمْرِ لمْ يُبْذَلْ لفَانِ",118,"ن",1,0],["فَما فيكُمُ لِلَّهِ كُتبُ مَحَجَّةٍ","فَيَعرِفَها حَبرٌ وَلا مُتَبَرنِسُ",119,"س",1,0],["فَما في بَني الدُنيا عَلى الأَرضِ خالِدٌ","وَكُلُّهُمُ لا بُدَّ مَيتٌ سَيُرمَسوا",119,"س",3,0],["فما فَخارُ فاجِرٍ مِن فاجرٍ","وأختُه فاجرةٌ من فاجِرَه",120,"ر",2,0],["فما فاتَني إربٌ بِطلعةِ عيدِه","إذا فاتَني من عيدِ طلعتِه إربُ",121,"ب",1,0],["فَما فيهُم إلّا هُمَامٌ مُرَفَّعٌ","بحيث الثّريا أو غلامٌ مشيَّعُ",122,"ع",1,0],["فما في الغنى واحد مثلُكم","وفي الفقر لا عصبة مثلنا",123,"ن",2,0],["فما في الوجود سوى واحد","وأفعاله لا سوى ذاك ثم",124,"م",1,0],["فما في الهْوى شكوىَ ولو مُزِّق الحَشَا","وَعارٌ على العُشاق في حُبِّكَ الشَّكوى",125,"و",2,0],["فما فاعل المعروف إلاَّ ممدحاً","ولا فاعل الإحسان إلاَّ مبجلا",126,"ل",2,0]]}