لْ فَتَحْتَ مِنَ الشَّوْقِ بَابَا","https://www.poetsgate.com/ViewPoem.aspx?id=63469",""],[5605,"مصائب حب","https://www.poetsgate.com/ViewPoem.aspx?id=159789",""],[5612,"عِلاجُ الهَمّْ","https://www.poetsgate.com/ViewPoem.aspx?id=187587",""],[243,"تسديد الحساب","https://www.poetsgate.com/ViewPoem.aspx?id=50560",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[5691,"بيادق","https://www.poetsgate.com/ViewPoem.aspx?id=206042",""],[5829,"تسامح","https://www.poetsgate.com/ViewPoem.aspx?id=214986",""],[5853,"لفاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=175682",""],[5873,"أنبل الأقوام","https://www.poetsgate.com/ViewPoem.aspx?id=215303",""],[5873,"سيف العزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=215412",""],[5873,"غيث الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=215780",""],[5906,"إرادة الحُفاة","https://www.poetsgate.com/ViewPoem.aspx?id=193759",""],[5948,"قُل للأميرِ الذي يرجو نوافَله","https://www.poetsgate.com/ViewPoem.aspx?id=100580",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[5956,"لبتر أسباب الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=184187",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"تشبيه بلا تشويه","https://www.poetsgate.com/ViewPoem.aspx?id=192411",""],[5956,"امنعوا صنع السلاح","https://www.poetsgate.com/ViewPoem.aspx?id=194893",""],[5956,"ما منعوا الجروح تصيب غزةْ","https://www.poetsgate.com/ViewPoem.aspx?id=202514",""],[6052,"معالي الخير","https://www.poetsgate.com/ViewPoem.aspx?id=34817",""],[6093,"رَقِيْعٌ فَوْقَهَا أخرى رَقيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=176147",""],[6101,"مبتور عدوك / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120280",""],[6102,"ساق !!","https://www.poetsgate.com/ViewPoem.aspx?id=184410",""],[6147,"جنوني ... بلا مدى.","https://www.poetsgate.com/ViewPoem.aspx?id=151491",""],[5309,"قفا نحمد الأيام ان كان يحمد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573526",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["فَما في نَعيمٍ بَعدَ فَقدِكِ لَذَّةٌ","وَلا في سُرورِ لَستِ فيهِ سُرورُ",0,"ر",1,0],["فَما فَضَّنا مِن صانِعٍ بَعدَ عَهدِكُم","فَيَطمَعَ فينا زاهِرٌ وَالأَصارِمُ",1,"م",1,0],["فَما في الناطِقينِ فَمٌ يُوَفّي","عَزاءَ الدينِ في هَذا المُصابِ",2,"ب",1,0],["فَما في حَياةٍ بَعدَ مَوتِك رَغبَةٌ","وَلا في وِصالٍ بَعدَ هَجرِكَ مَطمَعُ",3,"ع",1,0],["فَمَا فَاتَكَ الصَّبْرُ الجَمِيلُ عَلَى الأَذَى","لأَنِّكَ بِالغِبِّ الحَمِيدِ تَدِينُ",4,"ن",1,0],["فَمَا فِي الغِيدِ مَنْ يَشْجُو بِصَوْتٍ","أرَقَّ وَلا بِإِيقاعٍ أَحَنِّ",5,"ن",1,0],["فما فاسد الأخلاق بالعلم مُفْلِحاً","وإن كان بجراً زاخراً من بحاره",6,"ر",2,0],["فَما فارَقتَ كِندَةَ عَن تَراضٍ","وَما وَبَّرتَ في شُعَبى اِرتِغابا",7,"ب",2,0],["فَما في سَليطٍ فارِسٌ ذو حَفيظَةٍ","وَمَعقِلُها يَومَ الهِياجِ جُعورُها",8,"ر",3,0],["فَما في كِتابِ اللَهِ تَهديمُ دارِنا","بِتَهديمِ ماخورٍ خَبيثٍ مَداخِلُه",9,"ل",2,0],["فما فُدرٌ عواقل أحرزتها","عَمايةَ أو تضمنهنَّ شِيبُ",10,"ب",1,1],["فَما فَضائِلُنا إِلّا فَضائِلُهُ","وَلا مَفاخِرُنا إِلّا مَفاخِرُهُ",11,"ر",2,0],["فما فات رزق من تنبه للسرى","ومن يتمنى رزقه وهو نائم",12,"م",1,0],["فما فيك من ظل لغُلِّ ظهيرةٍ","وما فيك من جدوى لجانٍ وحاطبِ",13,"ب",1,0],["فما فضلُهُ والمدحُ دعوى ومُدَّعٍ","ولكنْ هما مِسكٌ ذكيٌّ ومَائِثُهْ",14,"ث",2,0],["فما في حياتك لي مَفْرَحٌ","ولا في مماتك لي مَتْرَحُ",15,"ح",1,0],["فما فيهما لي سَلْوَةٌ بَلْ حَزَازَةٌ","يَهِيجانِها دُونِي وأَشْقَى بها وحْدي",16,"د",2,0],["فما فاتني فكأن لم يفت","وما ضاع لي فكأن لم يضع",17,"ع",1,0],["فما في عودتي يوماً","إلى فضلكَ من إثمِ",18,"م",1,0],["فَما فَضلَةٌ مِن أَذرِعاتٍ هَوَت بِها","مُذَكَّرَةٌ عَنسٌ كَهادِيَةِ الضَحلِ",19,"ل",1,0],["فَما في شُربِها إِثم وَنُكرٌ","وَشِربُ الخَمرِ نُكرٌ أَيَّ نُكرِ",20,"ر",1,0],["فَما فاضَ ماءُ النيلِ إِلّا بِمَدمَعي","لَقَد مَرَجَ البَحرَينِ يَلتَقِيانِ",21,"ن",1,0],["فَما فاتَني حَظّي مِنَ اللَهوِ وَالصِبا","وَما فاتَني حَظّي مِنَ المَجدِ وَالعُلى",22,"ل",2,0],["فما في سُرُج الص","بر على أهوالها زيت",23,"ت",1,0],["فَما في القِوى أَنَّ السَماواتِ تُرتَقى","بِجَيشٍ وَأَنَّ النَجمَ يُغشى فَيُغضِبُ",24,"ب",1,0],["فَما في سَجاياكُم مُنازَعَةُ العُلى","وَلا في طِباعِ التُربَةِ المِسكُ وَالنَدُّ",25,"د",1,0],["فما في العلو من قدس خفيف","وما في الأرض من قدس ركين",26,"ن",1,0],["فما في الحقِّ أن يشقَى عليلاً","لديكَ وقد سعِدتَ به صحيحا",27,"ح",2,0],["فَما فَلَّ رَيبُ الدَهرِ مِن ذَلِكَ الشَبا","وَلا زَعزَعَ المَكروهُ مِن ذَلِكَ الرُكنِ",28,"ن",1,0],["فَما فُؤادي بِجازِعٍ أَسَفاً","ما أَخلَفَ ذا مَطامِعٍ ظِنَنُه",29,"ن",2,0],["فَما فارَقَتنا رَغبَةً عَن جِماعِنا","وَلَكِنَّما غالَت مُفَدّاةَ غولُها",30,"ل",3,0],["فَما فاضَلَت بَيتاً بِبَيتِكَ عامِرٌ","إِلى المَجدِ إِلّا كانَ بَيتُكَ أَفضَلا",31,"ل",2,1],["فما فيه عن المعروفِ مَنعٌ","ولا فيه عن الحَمْدِ ازوِرارُ",32,"ر",1,0],["فَما فُزتُ بِالوَعدِ الَّذي رُمتُ قَبضَهُ","وَقَد فاتَني النَومُ الَّذي كانَ في قَبضي",33,"ي",1,0],["فَما فيهِ شَيءٌ ناقِصٌ غَيرَ خَصرِهِ","وَلا فيهِ شَيءٌ بارِدٌ غَيرَ ريقِهِ",34,"ق",2,0],["فَما فَهمُ الأَشياء بالدرْسِ وَحْدَهُ","ولكنه بدءُ التفهّم والدّرْسِ",35,"س",1,0],["فما فُتِنتُ بردفٍ غَيرِ مُرْتَدَفٍ","ولا جُنِنْتُ بِخَصرٍ غَيرِ مُخْتَصَرِ",36,"ر",1,0],["فَما فازَ بِالمِسكِ إلّا فتىً","تَيَمّمَ دارِينَ أو دارَها",37,"ر",3,0],["فَما فَتَحتُ فَمي إِلّا كَعَمتُ فَمي","وَلا مَدَدتُ يَدي إِلّا رَدَدتُ يَدي",38,"د",2,0],["فَما في الأَرضِ مِن شَرَفٍ يَفاعٍ","سُبِقتَ بِهِ وَلا خُلُقٍ يَفاعِ",39,"ع",1,0],["فَما فاتَني ما عِندَهُ مِن حِبائِهِ","وَلا فاتَهُ مِن فاخِرِ الشِعرِ ما عِندي",40,"د",2,0],["فَما فَزِعَت مِمّا يُريدُ وَيَبتَغي","وَلا جَزَعَت مِمّا تُلَقّى وَتوعَدُ",41,"د",1,0],["فما فاتَهم خيرٌ ولا نَالَ سَعْيَهم","من النّاسِ غادٍ في البلادِ ورائحُ",42,"ح",1,0],["فَما فَرَغَت حَتّى أَتى الماءُ دونَها","وَسَدَّت نَواحيهِ وَرُفِّعَ دابِرُه",43,"ر",2,0],["فما فارَقَ البِشْرَ لمّا اكْفَهَرّ","ولا نَسِيَ العَفْوَ لمّا انْتَقَمْ",44,"م",1,0],["فما في حَريمٍ بعدَهَا منْ تَحَرُّجٍ","ولا هَتْكُ سِترٍ بعدَها بمحَرَّم",45,"م",1,0],["فَما في جودِهِ مَنٌّ","وَلا في بَذلِهِ حَبسُ",46,"س",1,0],["فَما فَرعُ الفَتاةِ إِذا تَوارَت","بِمُفتَقِرٍ إِلى سَرحٍ وَضَفرِ",47,"ر",1,0],["فَما فيكُمُ مِن خَيرٍ يُدَّعى بِهِ","يُفَرِّجُ عَنّي بِالمَضيقِ المَسالِكا",48,"ك",2,0],["فَما فَتِئَت خَيلٌ تَثوبُ وَتَدَّعي","وَيَلحَقُ مِنها لاحِقٌ وَتَقَطَّعُ",49,"ع",1,0],["فَما فَتِئَت حَتّى كَأَنَّ غُبارَها","سُرادِقُ يَومٍ ذي رِياحٍ تَرَفَّعُ",49,"ع",1,0],["فما في سجاياكم منازعة العلا","ولا في طباع التربة المسك والند",50,"د",1,0],["فَما فَخَرَت تَيمٌ بِيَومِ عَظيمَةٍ","وَلا قَبَضوا إِلّا بِخالِفَةٍ صِفرِ",51,"ر",1,0],["فَمَا فِي القِلادَةِ غَيْرُ الفَرِي","دِ وَلا فِي الأَشِعَّةِ مَا يُتْهَمُ",52,"م",1,0],["فَمَا فِي الأُولَى خَالَطْتَ إِلاَّ مَنِ اجْتَلَى","بِمَسْرَاكَ مَسْرَى الْكَوْكَبِ المُتَكَامِلِ",53,"ل",1,0],["فَمَا فِي غُرْبَتِي إِلاَّ سِهَامٌ","وَمَا فِي مُهْجَتِي غَيرُ الجِرَاحْ",54,"ح",1,0],["فَمَا فِي المُلُوكِ سِوَى أَعْبُدٍ","وَمَا فِي المَلِيكَاتِ إِلاَّ إِمَاءْ",55,"ا",2,0],["فَمَا فِي نَابِغِيهِ حِجىً وَعِلْماً","وَصِدْقَ مُروءَةٍ كَخَلِيلِ ثَابِتْ",56,"ت",1,0],["فما في الغاب من ناب","فزمجِر أيها الجابي",57,"ي",1,0],["فما في المشرقين لهُ نظيرٌ","ولا في المغربين ولا بكوفَه",58,"ف",2,0],["فما في الناس من بَشم عَلِيلٍ","ولا طاوٍ أضَرَّ به الهُزَال",59,"ل",1,0],["فَمَا فُؤَادِي بِجَازِعٍ أَسَفاً","مَا أَخْلَفَتْ ذَا مَطَامِعٍ ظِنَنُهْ",60,"ن",2,0],["فما فتحت جفوني وهي دامية","من الرّمال أعان الله أجفاني",61,"ن",2,0],["فما فاتني فكأنْ لم يفتْ","وما ضاع لي فكأنما لم يضِعْ",62,"ع",1,0],["فَما فَتِئوا حَتّى رَأَوها مُغيرَةً","كَرِجلِ الدِبى في كُلِّ رَبعٍ وَفَدفَدِ",63,"د",1,0],["فما فهموا مدائحهم","ولا قضَّوْا بها وطَرى",64,"ر",2,0],["فما في الهوى مَرعىً يطيبُ لذائق","ولا مَوردٌ عذبٌ يَلذّ به حاسِ",65,"س",1,0],["فما في الذل للمحبوب عارٌ","سبيل الحب ذلٌّ للمراد",66,"د",1,0],["فما فيكم من قرّ في الصدر قلبّه","ولا من رأى حصنا يقيه وان سما",67,"م",2,0],["فما فارقت قوما فاستقامت","لهم حال ولا غمضت جفون",68,"ن",1,0],["فما فاتَهُ في الشبابِ الوقارُ","ولم يُنسِهِ الشّيبُ عهدَ الدَّدَنْ",69,"ن",1,0],["فَما فيهِ تَضييعٌ عَلَيكَ وَلا تَرى","لَهُ في مَراضي مَن تُصافي مُشاكِلا",70,"ل",2,0],["فَما فُرقَةُ القالِينَ عِندي رَزِيَّةٌ","أُقيمُ لَها في نَدوَةِ الحَيِّ مَأتَما",71,"م",2,0],["فما فرحةٌ فيها لخلق وإن حظى","بأكثر في التعديد من ترحاتها",72,"ت",3,0],["فَما في بَنى حَوّاءَ فَرعٌ يَفوقُهُ","بِفاضِلَةٍ دونَ النَبِيِّ المُكَرَّمِ",73,"م",1,0],["فَما فَتِئَت خَيلي تَقُصُّ طَريقَهُم","وَتَقتُلُهُم بَعدَ اِشتِباكِ الحَنادِسِ",74,"س",1,0],["فَما في لَوعَةِ الآباءِ شكٌّ","ولا في ذاهبِ الأَبناءِ حيلَه",75,"ل",2,0],["فما فَلّلتْ حربُها لي شَباً","ولا ازددتُ بالسِّلم عنها رِضا",76,"ا",1,0],["فَما فازَ إِلّا مَن يَبيتُ صَباحُهُ","شَرابُ ثناياهُ وَمِنها غَبوقُهُ",77,"ق",2,0],["فَما فاتَ سَهمُ الحَظِّ مَن كُنتَ ناظِراً","إِلَيهِ قَريباً مِنهُ بِالكَوكَبِ السَعدِ",78,"د",1,0],["فَما فاتَني شيءٌ يَطولُ تَأَسُّفي","عَليهِ سِوى لُقياكَ يا اِبنَ مُحَمَّدِ",79,"د",1,0],["فَمَا فيِ سَلاَ شَيْءٌ يُسَلِّي ذَوِي الأَسَى","سِوَى بَحْرِهَا الزَّخَّارِ ذِي الُّلجَجِ السُّمْرِ",80,"ر",1,0],["فَما فَتِئَت تَرمي بِرَحلي أَمامَهُ","وَأَحلاسِهِ مِن مُؤخِرٍ وَمُقَدَّمِ",81,"م",1,0],["فما فيهِ عَيْبٌ غيرَ أَنَّ جُفونهُ","مِراضٌ وأَنَّ الخَصْرَ منه ضَعيفُ",82,"ف",1,0],["فَما فَزِعوا إِذ خالَطَ القَومُ أَهلَهُم","وَلَكِن رَأَوا صِرفاً مِنَ المَوتِ أَصهَبا",83,"ب",2,0],["فما فتقت اسيافكم من جلودهم","يرتقه اللدن الوشيج بشله",84,"ل",2,0],["فما فقدنا اباه عن رؤيته","والشبل كالليث في خلق وفي خلق",85,"ق",1,0],["فما فيكِ إلا الذي","يعافُ غدا أو يُمَلّ",86,"ل",1,0],["فما فيكِ حسنٌ للحبيبةِ طالعٌ","ومرآةُ قلبي لم تزل تُطلعُ الحُسنا",87,"ن",2,0],["فَما في حُسنِهِ لَيتٌ وَعلٌّ","يَرى مُتَقَوِّلٌ بِهِما اِحتِجاجا",88,"ج",2,0],["فما فاز امرؤ الا بسيفض","صقيل أو لسان أو خروف",89,"ف",1,0],["فَما في الخلقِ أَسرعُ منك نَصراً","لملهوفٍ وأَسمعُ منكَ أذنا",90,"ن",2,0],["فما فزت مع هذا العذاب بطائلٍ","سوى حسن ظني في تمني وصاله",91,"ه",1,0],["فما في فضل عنك يخطر فيه لي","سواك فوقتي فيك غير موقت",92,"ت",1,0],["فَما فَتِئَت جُنودُ السِلمِ حَتّى","رَأَينا القَومَ كَالغَنمِ السَوامِ",93,"م",1,0],["فما فرحى بالعيش وهو قصيدة","مهلهلة الأوزان ليست لشاعر",94,"ر",1,0]