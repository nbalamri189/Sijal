{"poems":[[63,"واها لجائلة الوشاح سرت","https://www.aldiwan.net/poem45883.html","أحذ الكامل"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[72,"أوما لجفنك أو لفعلك ماضي","https://www.aldiwan.net/poem19125.html","الكامل"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[51,"حق الأديب لازم لذي الكرم","https://www.aldiwan.net/poem66033.html","الرجز"],[70,"أمذكري عهد الصبا","https://www.aldiwan.net/poem42826.html","مجزوء الكامل"],[85,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[45,"إما ألم فبعد فرط تجنب","https://www.aldiwan.net/poem11055.html","الكامل"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[66,"كرر اللوم عليه إن تشا","https://www.aldiwan.net/poem40645.html","الرمل"],[66,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[90,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[52,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[50,"وسهرتم في المكرمات وكسبها","https://www.aldiwan.net/poem62230.html","الكامل"],[46,"الساع آنية الحوادث ما حوت","https://www.aldiwan.net/poem22033.html","الكامل"],[46,"أصبحت غير مميز من عالم","https://www.aldiwan.net/poem22562.html","الكامل"],[46,"تصدق على الأعمى بأخذ يمينه","https://www.aldiwan.net/poem23333.html","الطويل"],[46,"أعوز الشث والسلم","https://www.aldiwan.net/poem23436.html","مجزوء الخفيف"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[108,"الاولين","https://www.poetsgate.com/ViewPoem.aspx?id=8407",""],[99,"لحمُها .. وأظَافري","https://www.poetsgate.com/ViewPoem.aspx?id=16934",""],[121,"لقد لاح من هند هدى راح لائحاً","https://www.aldiwan.net/poem23819.html","الطويل"],[133,"هو الفتح أعيا وصفه النظم والنثرا","https://www.aldiwan.net/poem4233.html","الطويل"],[134,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[143,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[143,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[160,"أهلا به من بحر علم صدره","https://www.aldiwan.net/poem59122.html","الرجز"],[197,"يا أخا الروح من يبل أوامي","https://www.aldiwan.net/poem39821.html","الخفيف"],[197,"أوقديها وذريها في حشايا","https://www.aldiwan.net/poem39942.html","الرمل"],[221,"حفظ المودة للخليل","https://www.aldiwan.net/poem55294.html","مجزوء الكامل"],[235,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[261,"عللوا قلبي بتذكار اللقاء","https://www.aldiwan.net/poem38376.html","الرمل"],[281,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[290,"يا جارتا رحماك في دنف","https://www.aldiwan.net/poem11659.html","أحذ الكامل"],[322,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[325,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[348,"وسهل حظه رزقا عسيرا","https://www.aldiwan.net/poem19825.html","الوافر"],[366,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[371,"قاتل فقد وجب الجها","https://www.aldiwan.net/poem57192.html","مجزوء الكامل"],[380,"ناء بمصر وبالشآم حبيبه","https://www.aldiwan.net/poem49206.html","الكامل"],[380,"مدمع بات يسفح","https://www.aldiwan.net/poem49237.html","مجزوء الخفيف"],[402,"يا بن خير الورى ومن","https://www.aldiwan.net/poem46910.html","مجزوء الخفيف"],[409,"ليس طرفي جارا لقلبي ولكن","https://www.aldiwan.net/poem32616.html","الخفيف"],[416,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[429,"لعمرك يا أخا الأشواق أنا","https://www.aldiwan.net/poem40258.html","الوافر"],[432,"وسهم فوارة انبعثت","https://www.aldiwan.net/poem12390.html","المنسرح"],[432,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[437,"صب قتيل المقلتين","https://www.aldiwan.net/poem2556.html","مجزوء الكامل"],[439,"عمري لقد أعذر الدمع الذي وكفا","https://www.aldiwan.net/poem34796.html","البسيط"],[439,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[441,"فوضت أمري إلى ذي القدرة الصمد","https://www.aldiwan.net/poem14302.html","البسيط"],[441,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[443,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[458,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[461,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[461,"وفقير عصف المحل به","https://www.aldiwan.net/poem15697.html","الرمل"],[464,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[464,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[477,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[479,"حمامات أيك عذبة النغمات","https://www.aldiwan.net/poem37913.html","الطويل"],[482,"وغزالة لغزالة خضعت ولكن","https://www.aldiwan.net/poem24327.html","عموديه"],[551,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[551,"لا تسلني عما أراه فإني","https://www.aldiwan.net/poem48071.html","الخفيف"],[558,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[575,"هاجرني من هجره هجنه","https://www.aldiwan.net/poem2841.html","السريع"]],"verses":[["وَسِهامُها نَحْوي مُفَوَّقَةٌ","أُرْمَى بِها وَفُؤادِيَ الغَرَضُ",0,"ض",1,0],["وَسَها النيلُ عَن سُراهُ ذُهولاً","حينَ أَلفى الجُموعَ تَبكي اِنتِحابا",1,"ب",2,0],["وسهام لحظك لا تردُّ عن الحشا","ووحقّ حسنكَ إنَّها أغراضي",2,"ي",1,0],["وسهر روى من بكاءي الذي","تدفق عن جعفر الصادق",3,"ق",1,0],["وسُهمة في الفكر ليست كالسُّهَمْ","مُؤتَمنٌ في علمه لامتّهمْ",4,"م",1,0],["وَسَهِرتُ في لَيلِ الصَبا","سَهَراً أَلَذُّ مِنَ الهُجوعِ",5,"ع",1,0],["وسهم جفنيك ما أرسلته عرضا","أبى القضاء له إلا رميّات",6,"ت",1,0],["وَسُهادُ عَينٍ مايَزالُ يَروقُها","أَجيادُ سِربٍ أَو نَواظِرُ رَبرَبِ",7,"ب",1,0],["وسهمُ فوَّارَةٍ ما ارتدَّ رائدُه","حتى أصابَ من العُّيوقِ ما طَلبا",8,"ب",2,0],["وسَهْلٍ حينَ يسألُ غيرِ صَعْبٍ","وقد ذلَّتْ له العُربُ الصِّعابُ",9,"ب",1,0],["وَسَهيلٌ مِثلُ قَلبٍ خافِقٍ","مُكِّنَ الرُعبُ بِهِ فَاِرتَعَشا",10,"ش",2,0],["وَسَهَّدتَ في رَعي العِبادِ نَواظِراً","بِها الناسُ في ظِلِّ الأَمانِ رُقودُ",11,"د",1,0],["وسهول كاد يعرو هَضْبَها","نزقٌ من صبوة لولا الجلال",12,"ل",1,0],["وَسِهامٌ تُردي الوَرى مِن بَعيدٍ","واقِعاتٌ مَواقِعَ الأَبصارِ",13,"ر",1,0],["وسَهْمُهُ يَسْبِقُهُ للّذي","عَوَّدَهُ من عادَةِ الرَّشْق",14,"ق",1,0],["وَسَهِرتُمُ في المُكرَماتِ وَكَسبِها","سَهَراً بِغَيرِ هَوىً وَغَيرِ سِقامِ",15,"م",1,1],["وَسِهامُ دَهرِكَ لا تَزالُ مُصيبَةً","صُرِفَت بِإِذنِ اللَهِ عَن أَخطائِها",16,"ا",3,0],["وَسُهَيلٌ اللَمّاحُ صُغِّرَ لَفظُهُ","فَاِنظُر أَهَيَّرَهُ بِذاكَ مُهَيِّرُ",17,"ر",1,0],["وَسَهلٌ عَلى نَفسي الَّتي رُمتُ حُزنَها","مَبيتُ سُهَيلٍ لِلرَكائِبِ مُؤتَمّا",18,"م",2,0],["وَسُهَيلاً مَعَ المَعا","شِرِ في كَفِّهِ زَلَم",19,"م",1,0],["وسُهَيْلٌ كوَجْنَةِ الحِبّ في اللّوْ","نِ وقَلْبِ المُحِبّ في الخَفَقَانِ",20,"ن",1,0],["وَسهيلٌ وَلَيسَ مثل سهيلٍ","متعب من تنفس الصعداء",21,"ا",2,0],["وَسَهْلُ القِتَالِ كَطِرْسٍ بِه","يُسَطِّرُ بَأْسُكَ مَا سَطَّرَا",22,"ر",2,0],["وسهيل.؟ يدرون العرب متى يبين","لاقامت الحايل.. تقردع.. بالعشار",23,"ر",1,0],["وسهل على النساء الفرار","فلماذا ؟ تبكين ملكا مضاعا",24,"ع",2,0],["وسهم الفؤاد اللوذعي مطلسما","مهذب أخلاق ويبسط ساطحا",25,"ح",2,0],["وسهلتِ المرقى إليه صوارِمٌ","كثيرٌ بها القتلى قليلٌ بها الأسرى",26,"ر",2,0],["وَسَهمٌ وَمَخزومٌ تَمالوا وَأَلَّبوا","عَلَينا العِدا مِن كُلِّ طِملٍ وَخامِلِ",27,"ل",1,0],["وَسَهمَ لِحاظٍ يُؤلِمُ القَلبَ جُرحُهُ","أَهانَ جِراحاً تُؤلِمُ العَظمَ وَالجِلدا",28,"د",2,0],["وَسِهامُهُ لا تَستَطيعُ فِراقَها","وَحِبالُهُ أَبَداً لِطَيرٍ مَصرَعُ",29,"ع",1,0],["وسهل العلم على طلابه","فلم يكد الغائصين دره",30,"ر",2,0],["وسهرنا معا ونمنا وقمنا","وجلسنا العام بعد العام",31,"م",1,0],["وسهامُ الموتِ طاشَت في الفَضا","وجناحي لم يعُد يحمِلُني",32,"ي",1,0],["وسهيل يرمقنا بلحظ","كالحسود أو الدخيل",33,"ل",1,0],["وَسِهامُ المَلامِ ما","قَرَعَت بَعدُ لي أُذُن",34,"ن",1,0],["وسها الراجي قياساً بالسهى","قمر الظلماء أو شمس الضحاء",35,"ا",2,0],["وسهّل عندي أن أرى الحزن مالكي","مصابيَ بالفياض سهل بن مالك",36,"ك",1,0],["وسهام لحظك أوهنت جلدي","فلحاظها أمضى من النصل",37,"ل",1,0],["وَسُهوبٍ وَكُلُّ أَبطَحَ لاخٍ","ثُمَّ آلٍ قَد جُبتُ مِن بَعدِ آلِ",38,"ل",1,0],["وسهل سبيل الكاذبين تعمدا","على ربهم من كل جاء بفرية",39,"ه",1,0],["وَسَهَّلَ حَظُّهُ رِزْقاً عَسِيراً","أراحَ بهِ فُؤَادِي مِن عَنَائِه",40,"ه",1,1],["وَسَهلُ كَلامٍ عِندَهُ يَسهُلُ المُنى","وَفَصلُ خِطابٍ عِندَهُ يَسهُلُ الخَطبُ",41,"ب",1,0],["وسِهامُها نَفَّاذَةٌ","في السَّابِرِيَّاتِ الفَواضِل",42,"ل",1,0],["وَسِهام طَرفك لا يَبلُّ رَميّها","وَغَليل وَجدي لا يَبلّ لَهيبُهُ",43,"ب",2,0],["وَسُهادٌ لا يَنقَضي","وَدُجى لَيسَ يَبرَح",44,"ح",1,0],["وسهاماً بها رَمَاني","زَماني فَأَقْصَدا",45,"د",2,0],["وسهامُ العيون أخفى من الوَه","مِ ولكنْ بهِنَّ تَدْمى القُلوبُ",46,"ب",1,0],["وسهرناها كما شاءَ الهوى","نتعاطى الكأسَ من خمر اللّمى",47,"م",2,0],["وسهم الحادثات أصاب قلبي","فاثر بالحشاشة حين رنا",48,"ن",2,0],["وسهْمِ فَوَّارَة انْبَعَثَتْ","غادَرَتِ الجَوَّ يَحْتَذِي أَرْضَهْ",49,"ه",1,1],["وسهرْتُ أرقُبُ من سُهيلٍ خافقاً","متفرِّداً فكأنه قلبُ الشّجي",50,"ج",2,0],["وسهام جفن أطلقو","ها عن قسيّ الحاجبين",51,"ن",1,0],["وسَهْمُ نصرٍ تُراعُ الحادِثاتُ بِهِ","أَضْحَى بسهمِ المنايا والرَّدَى قُذِفا",52,"ف",2,0],["وسهلٌ إِلَى حَزْنٍ وحزنٌ إِلَى فلاً","وسُهْبٌ إِلَى بَحرٍ وبَحرٌ إِلَى سُهْبِ",53,"ب",1,0],["وسهل اللَه إقبالي ومنصرفي","وقوم اللَه مني كل ذي أود",54,"د",1,0],["وسهل في الطريق وكل صعبٍ","فهونه بأمن في الطريق",55,"ق",1,0],["وسهأم هاتيك أم عجلات","دون خيل عرض البلاد تقيس",56,"س",1,0],["وسهرتُ حتى ما تُميِّزُ مقلتي","فُرقانَ مغربِ كوكبٍ من مطلِعِ",57,"ع",1,0],["وسهمٌ إذا ما صاحب العزم نافذٌ","ورضوى إذا ما ساورتهُ الزلازلُ",58,"ل",1,0],["وسِهامٍ فوَّقَتْ آراؤهُ","فتمنَّى رَشْقها رامي ثُعَلْ",59,"ل",1,0],["وسُهِلتْ طرق المجد لا ثيل بهم","فإن بغاها حسودٌ فهي أوعار",60,"ر",1,0],["وسهرتَ في طلب المنامِ ليالياً","فيها نجومُ الليل ممّن يهجع",61,"ع",1,0],["وسهَّلَتْ لي أرَباً","مِن قبلِها تعذَّرا",62,"ر",2,0],["وسهمُ حمامٍ رُكبت في قِسِّيها","ليُرَمى بها مَنْ يَبْتَغي الرَشَفَاتِ",63,"ت",1,0],["وسهام لحظ مع عقارب صدغها","من ذا يطيق وصالها ونجاتي",64,"ت",2,0],["وَسِهامُ أَقواس المنو","نِ الصائباتُ المصُمياتُ",65,"ت",1,0],["وَسِهاماً أَصَبْنَ جِسمي فلمّا","لم تضِرْني أَصبن منّا القلوبا",66,"ب",2,0],["وسهل لنا توبة نحتمي","بها في غد من لهيب الضرم",67,"م",1,0],["وسهَّل الوصل على أَنَّه","قد كان أَعيا الإِنسَ والجِنَّه",68,"ن",2,0]]}