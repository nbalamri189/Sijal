om/ViewPoem.aspx?id=214772",""],[5759,"عد إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=213623",""],[402,"مصابك حيا عرا جعفرا","https://www.poetsgate.com/ViewPoem.aspx?id=35746",""],[5842,"ومازال التراب \\محمد حسام الدين دويد","https://www.poetsgate.com/ViewPoem.aspx?id=150625",""],[5862,"البُ ع د يرضي .. جَنابِكْ ... !!!","https://www.poetsgate.com/ViewPoem.aspx?id=31906",""],[5937,"إلى مُعَلمة","https://www.poetsgate.com/ViewPoem.aspx?id=211808",""],[6070,"ياقافلَ الأبوابِ بالسَّكتِ","https://www.poetsgate.com/ViewPoem.aspx?id=188868",""],[6102,"وَمَضَينا!","https://www.poetsgate.com/ViewPoem.aspx?id=182771",""],[231,"خريف الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79120&r=&rc=6",""],[5355,"لحى الفراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87123&r=&rc=18",""],[6242,"أرق المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87553&r=&rc=1",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""]],"verses":[["وَسِهامُها نَحْوي مُفَوَّقَةٌ","أُرْمَى بِها وَفُؤادِيَ الغَرَضُ",0,"ض",1,0],["وَسَها النيلُ عَن سُراهُ ذُهولاً","حينَ أَلفى الجُموعَ تَبكي اِنتِحابا",1,"ب",2,0],["وسهام لحظك لا تردُّ عن الحشا","ووحقّ حسنكَ إنَّها أغراضي",2,"ض",2,0],["وسهر روى من بكاءي الذي","تدفق عن جعفر الصادق",3,"ق",1,0],["وسُهمة في الفكر ليست كالسُّهَمْ","مُؤتَمنٌ في علمه لامتّهمْ",4,"م",1,0],["وَسَهِرتُ في لَيلِ الصَبا","سَهَراً أَلَذُّ مِنَ الهُجوعِ",5,"ع",1,0],["وسهم جفنيك ما أرسلته عرضا","أبى القضاء له إلا رميّات",6,"ت",1,0],["وَسُهادُ عَينٍ مايَزالُ يَروقُها","أَجيادُ سِربٍ أَو نَواظِرُ رَبرَبِ",7,"ب",1,0],["وسهمُ فوَّارَةٍ ما ارتدَّ رائدُه","حتى أصابَ من العُّيوقِ ما طَلبا",8,"ب",2,0],["وسَهْلٍ حينَ يسألُ غيرِ صَعْبٍ","وقد ذلَّتْ له العُربُ الصِّعابُ",9,"ب",1,0],["وَسَهيلٌ مِثلُ قَلبٍ خافِقٍ","مُكِّنَ الرُعبُ بِهِ فَاِرتَعَشا",10,"ش",2,0],["وَسَهَّدتَ في رَعي العِبادِ نَواظِراً","بِها الناسُ في ظِلِّ الأَمانِ رُقودُ",11,"د",1,0],["وسهول كاد يعرو هَضْبَها","نزقٌ من صبوة لولا الجلال",12,"ل",1,0],["وَسِهامٌ تُردي الوَرى مِن بَعيدٍ","واقِعاتٌ مَواقِعَ الأَبصارِ",13,"ر",1,0],["وسَهْمُهُ يَسْبِقُهُ للّذي","عَوَّدَهُ من عادَةِ الرَّشْق",14,"ق",1,0],["وَسَهِرتُمُ في المُكرَماتِ وَكَسبِها","سَهَراً بِغَيرِ هَوىً وَغَيرِ سِقامِ",15,"م",1,1],["وَسِهامُ دَهرِكَ لا تَزالُ مُصيبَةً","صُرِفَت بِإِذنِ اللَهِ عَن أَخطائِها",16,"ا",3,0],["وَسُهَيلٌ اللَمّاحُ صُغِّرَ لَفظُهُ","فَاِنظُر أَهَيَّرَهُ بِذاكَ مُهَيِّرُ",17,"ر",1,0],["وَسَهلٌ عَلى نَفسي الَّتي رُمتُ حُزنَها","مَبيتُ سُهَيلٍ لِلرَكائِبِ مُؤتَمّا",18,"م",2,0],["وَسُهَيلاً مَعَ المَعا","شِرِ في كَفِّهِ زَلَم",19,"م",1,0],["وسُهَيْلٌ كوَجْنَةِ الحِبّ في اللّوْ","نِ وقَلْبِ المُحِبّ في الخَفَقَانِ",20,"ن",1,0],["وَسهيلٌ وَلَيسَ مثل سهيلٍ","متعب من تنفس الصعداء",21,"ا",2,0],["وَسَهْلُ القِتَالِ كَطِرْسٍ بِه","يُسَطِّرُ بَأْسُكَ مَا سَطَّرَا",22,"ر",2,0],["وسهيل.؟ يدرون العرب متى يبين","لاقامت الحايل.. تقردع.. بالعشار",23,"ر",1,0],["وسهل على النساء الفرار","فلماذا ؟ تبكين ملكا مضاعا",24,"ع",2,0],["وسهم الفؤاد اللوذعي مطلسما","مهذب أخلاق ويبسط ساطحا",25,"ح",2,0],["وسهلتِ المرقى إليه صوارِمٌ","كثيرٌ بها القتلى قليلٌ بها الأسرى",26,"ر",2,0],["وَسَهمٌ وَمَخزومٌ تَمالوا وَأَلَّبوا","عَلَينا العِدا مِن كُلِّ طِملٍ وَخامِلِ",27,"ل",1,0],["وَسَهمَ لِحاظٍ يُؤلِمُ القَلبَ جُرحُهُ","أَهانَ جِراحاً تُؤلِمُ العَظمَ وَالجِلدا",28,"د",2,0],["وَسِهامُهُ لا تَستَطيعُ فِراقَها","وَحِبالُهُ أَبَداً لِطَيرٍ مَصرَعُ",29,"ع",1,0],["وسهل العلم على طلابه","فلم يكد الغائصين دره",30,"ر",2,0],["وسهرنا معا ونمنا وقمنا","وجلسنا العام بعد العام",31,"م",1,0],["وسهامُ الموتِ طاشَت في الفَضا","وجناحي لم يعُد يحمِلُني",32,"ي",1,0],["وسهيل يرمقنا بلحظ","كالحسود أو الدخيل",33,"ل",1,0],["وَسِهامُ المَلامِ ما","قَرَعَت بَعدُ لي أُذُن",34,"ن",1,0],["وسها الراجي قياساً بالسهى","قمر الظلماء أو شمس الضحاء",35,"ا",2,0],["وسهّل عندي أن أرى الحزن مالكي","مصابيَ بالفياض سهل بن مالك",36,"ك",1,0],["وسهام لحظك أوهنت جلدي","فلحاظها أمضى من النصل",37,"ل",1,0],["وَسُهوبٍ وَكُلُّ أَبطَحَ لاخٍ","ثُمَّ آلٍ قَد جُبتُ مِن بَعدِ آلِ",38,"ل",1,0],["وسهل سبيل الكاذبين تعمدا","على ربهم من كل جاء بفرية",39,"ه",1,0],["وَسَهَّلَ حَظُّهُ رِزْقاً عَسِيراً","أراحَ بهِ فُؤَادِي مِن عَنَائِه",40,"ه",1,1],["وَسَهلُ كَلامٍ عِندَهُ يَسهُلُ المُنى","وَفَصلُ خِطابٍ عِندَهُ يَسهُلُ الخَطبُ",41,"ب",1,0],["وسِهامُها نَفَّاذَةٌ","في السَّابِرِيَّاتِ الفَواضِل",42,"ل",1,0],["وَسِهام طَرفك لا يَبلُّ رَميّها","وَغَليل وَجدي لا يَبلّ لَهيبُهُ",43,"ب",2,0],["وَسُهادٌ لا يَنقَضي","وَدُجى لَيسَ يَبرَح",44,"ح",1,0],["وسهاماً بها رَمَاني","زَماني فَأَقْصَدا",45,"د",2,0],["وسهامُ العيون أخفى من الوَه","مِ ولكنْ بهِنَّ تَدْمى القُلوبُ",46,"ب",1,0],["وسهرناها كما شاءَ الهوى","نتعاطى الكأسَ من خمر اللّمى",47,"م",2,0],["وسهم الحادثات أصاب قلبي","فاثر بالحشاشة حين رنا",48,"ن",2,0],["وسهْمِ فَوَّارَة انْبَعَثَتْ","غادَرَتِ الجَوَّ يَحْتَذِي أَرْضَهْ",49,"ه",1,1],["وسهرْتُ أرقُبُ من سُهيلٍ خافقاً","متفرِّداً فكأنه قلبُ الشّجي",50,"ج",2,0],["وسهام جفن أطلقو","ها عن قسيّ الحاجبين",51,"ن",1,0],["وسَهْمُ نصرٍ تُراعُ الحادِثاتُ بِهِ","أَضْحَى بسهمِ المنايا والرَّدَى قُذِفا",52,"ف",2,0],["وسهلٌ إِلَى حَزْنٍ وحزنٌ إِلَى فلاً","وسُهْبٌ إِلَى بَحرٍ وبَحرٌ إِلَى سُهْبِ",53,"ب",1,0],["وسهل اللَه إقبالي ومنصرفي","وقوم اللَه مني كل ذي أود",54,"د",1,0],["وسهل في الطريق وكل صعبٍ","فهونه بأمن في الطريق",55,"ق",1,0],["وسهأم هاتيك أم عجلات","دون خيل عرض البلاد تقيس",56,"س",1,0],["وسهرتُ حتى ما تُميِّزُ مقلتي","فُرقانَ مغربِ كوكبٍ من مطلِعِ",57,"ع",1,0],["وسهمٌ إذا ما صاحب العزم نافذٌ","ورضوى إذا ما ساورتهُ الزلازلُ",58,"ل",1,0],["وسِهامٍ فوَّقَتْ آراؤهُ","فتمنَّى رَشْقها رامي ثُعَلْ",59,"ل",1,0],["وسُهِلتْ طرق المجد لا ثيل بهم","فإن بغاها حسودٌ فهي أوعار",60,"ر",1,0],["وسهرتَ في طلب المنامِ ليالياً","فيها نجومُ الليل ممّن يهجع",61,"ع",1,0],["وسهَّلَتْ لي أرَباً","مِن قبلِها تعذَّرا",62,"ر",2,0],["وسهمُ حمامٍ رُكبت في قِسِّيها","ليُرَمى بها مَنْ يَبْتَغي الرَشَفَاتِ",63,"ت",1,0],["وسهام لحظ مع عقارب صدغها","من ذا يطيق وصالها ونجاتي",64,"ت",2,0],["وَسِهامُ أَقواس المنو","نِ الصائباتُ المصُمياتُ",65,"ت",1,0],["وَسِهاماً أَصَبْنَ جِسمي فلمّا","لم تضِرْني أَصبن منّا القلوبا",66,"ب",2,0],["وسهل لنا توبة نحتمي","بها في غد من لهيب الضرم",67,"م",1,0],["وسهَّل الوصل على أَنَّه","قد كان أَعيا الإِنسَ والجِنَّه",68,"ن",2,0],["وَسَهمٌ تَلقاهُ فُؤادي وَإِنَّهُ","لِآلَمٍ ما لاقى نِبالاً وَأَسهُما",69,"م",2,0],["وَسِهامٍ تُصمي فُؤاد عَنيد","غرّه جَهلُه لِفَرط عَماه",70,"ا",2,0],["وَسِهامهم تَفري الضُلوعْ","وَتشكُّ أَحداق المقلْ",71,"ل",1,0],["وَسِهام العسر أَصمت مهجةً","طالَما قَد صانَها اليسر الأَعم",72,"م",1,0],["وَسَهِرتُ أَرتَقِبُ النُجومَ كَأَنَّني","في الأُفقِ أَطلُبُ لِلحَبيبِ عُهودا",73,"د",2,0],["وسهمٍ من الميناء فُضِّضَ ريشُهُ","بقُدرةِ خَلاّقٍ وذُهِّبَ فُوقُه",74,"ه",1,1],["وسِهامِ لحظٍ عَنْ قِسِيِّ حَواجبٍ","تَرْمي بِرِيْشِ الهِدْبِ مِنْ طَرفٍ خَفي",75,"ف",2,0],["وسهلت سبل الحج إن سلوكها","لأسرع من سير الغمام وأيسر",76,"ر",1,0],["وسُهادٍ اذا اللَّواحظُ أغفت","واستباقٍ مِن الدموعِ الغِزارِ",77,"ر",1,0],["وسهامي اذا رميت الاعادي","نزعت بالخمول منها النصولا",78,"ل",2,0],["وَسَهلٌ عَلى الصّيّادِ مَنعُ حَياتِهِ","وَصَعبٌ عَلى الصيّادِ مَنعٌ مِنَ الصّيدِ",79,"د",1,0],["وسهامٌ تُصيبنا من جفونٍ","قاتلاتٍ تُرْمَى بلا أَرْعاظِ",80,"ظ",1,0],["وَسَهْمُ جَفَاهُمْ كَيْفَ يَبْرَا قَرِيحُهُ","زَمَانُ سُلُوِّي لاَ يُسَامُ مَسِيحُهُ",81,"ه",1,0],["وسهل طريقي وأوف ديني وجد بما","أرجيه في الدارين من كل نافع",82,"ع",1,0],["وَسِهامُ لَحظِكَ لَيسَ يُدرِكُها الفَنا","هَطَلَت فَقُلتُ العارض الهتانُ",83,"ن",1,0],["وَسَهَرتَ الآن يا راعي المَلا","تَحرُس القُطر مُصاناً فَهجد",84,"د",1,0],["وَسهدت حَتّى لا أَرى الطَّيف زائِري","وَفي الطَّيف بَينَ النائِمينَ سَفير",85,"ر",1,0],["وَسهام أَلحاظ بأَلفاظ رمت","أَكبادهم فاِستشغلوا منها العنا",86,"ن",2,0],["وسهَّل أسباب السعادة والصفا","لمن عرف المعروف واجتنب الشرا",87,"ر",2,0],["وسهلت سبل العلم بعد امتناعها","فأنت الى نيل المعارف راشد",88,"د",1,0],["وسهول تمايل النّبت فيها","مالئات القلوب والأبصار",89,"ر",1,0],["وسهام هي اللحاظ ولكن","فاتها الهدب والنوةى والمضاء",90,"ا",2,0],["وَسَهمٍ إِذا ما خالَطَ القَلبَ لَم يَكُن","لَهُ مِن سَواقي الأَبهَرَينِ نُصولُ",91,"ل",1,0],["وسهامَ الهوى التي صوَّبتُها","لفؤادي وزفرةَ النيران",92,"ن",1,0],["وسهم من كاتبته سادسٌ","له م