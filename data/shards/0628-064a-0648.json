ttps://www.poetsgate.com/ViewPoem.aspx?id=187258",""],[5431,"ويملكني جميل الروح سهلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187535",""],[5431,"الحسين...","https://www.poetsgate.com/ViewPoem.aspx?id=215715",""],[5458,"الحج غدفة","https://www.poetsgate.com/ViewPoem.aspx?id=72397",""],[5463,"أبلبس حزني لي بشت ٍ وأباخذ دمعي شخصيّه","https://www.poetsgate.com/ViewPoem.aspx?id=33695",""],[5469,"سل الدار عن سكانها أين حلت","https://www.poetsgate.com/ViewPoem.aspx?id=169365",""],[5582,"أَمُوسِعَةً بِمُهْجَتِيَ الصُّدُوعا","https://www.poetsgate.com/ViewPoem.aspx?id=187177",""],[5652,"عقولٍ تعشق الرأفه بليده دون فكرية","https://www.poetsgate.com/ViewPoem.aspx?id=178408",""],[466,"لقد علمت زوراء دجلة أنني","https://www.poetsgate.com/ViewPoem.aspx?id=38054",""],[5829,"اليرموك في ذكرى بدء التحرير","https://www.poetsgate.com/ViewPoem.aspx?id=204254",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[5957,"أحتاج أن تكون لي الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=183295",""],[6008,"رثاء بالشيوخ (مهل القعقاع -مساعد البنيه )","https://www.poetsgate.com/ViewPoem.aspx?id=60996",""],[6031,"لا أَلَمَّتْ بِجِسْمِكَ الآلاَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46359",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[4442,"قبلت خديه وهو نائم","https://www.poetsgate.com/ViewPoem.aspx?id=171022",""],[6115,"اذا جتني الذمّه من اللاش","https://www.poetsgate.com/ViewPoem.aspx?id=180455",""],[6225,"غزة ليستْ أوّلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80805&r=&rc=160",""]],"verses":[["بِيَومِ طِرادٍ يَصطَلي القَومُ تَحتَهُ","بِنارِ الحَنايا وَالقَنا وَالمَواضِيا",0,"ي",2,0],["بِيَومِ طِرادٍ قَنَّعَ الشَمسَ نَقعُهُ","بِفاضِلِ أَذيالِ الرُبى وَالدَكادِكِ",1,"ك",1,0],["بُيوتُهُم مَرهوبَةٌ تَخالُها","أَولاجَ غيلٍ رَشَّحَت سِباعَها",2,"ع",3,0],["بُيوتُهُمُ سودُ الذُرى وَلِنارِهِم","مَواقِدُ بيضٌ ما بِهِنَّ رَمادُ",3,"د",1,0],["بِيَومٍ كَثيرٍ بِالغُبارِ عُطاسُهُ","إِذا ثَوَّبَ الداعي قَليلُ المُشَمِّتِ",4,"ت",1,0],["بِيَوْمٍ خَاضَ جانِحَتَيْهِ عَمْروٌ","لَقَى حَرْبٍ تُلَقَّحُ عَن حِيالِ",5,"ل",1,0],["بِيَوْمٍ قَاتِمِ الطَّرَفَيْنِ فيهِ","يَشُوبُ طَلاقَةَ الوَجْهِ العُبوسُ",6,"س",1,0],["بيَوْمٍ كادَ منْ قَرَمٍ إلَيْهِمْ","تلمَّظُ في حَواشِيهِ الصِّعادُ",7,"د",1,0],["بيَوْمٍ مَريضِ الشّمسِ جَوْنٍ إهابُهُ","تظنُّ الضُّحى لَيْلاً منَ النّقْعِ أقْتَما",8,"م",2,0],["بيومٍ ترَدّى بالأسنّةِ فاسْتَوَتْ","هَواجِرُهُ من وَقْعِها والأصائِلُ",9,"ل",1,0],["بيوْمٍ تَرى الرّاياتِ فيهِ كأنَّها","إذا ساوَرَتْها خَطْرةُ الرّيح عِقبانُ",10,"ن",1,0],["بُيُوتُ نَارٍ بِنُورِ الله قَدْ طُفِيَتْ","شَتَّانَ وَاللهِ مَا بَيْنَ الْيَزِيدَيْنِ",11,"ن",1,0],["بيوسُفَ لاحَ الحَقُّ أبْلَجَ واضِحاً","وأصْبَحَ دينُ اللهِ فازَتْ قِداحُهُ",12,"ح",2,0],["بِيَومِ كَريهَةٍ ضَرباً وَطَعن","أَقَرَّ بِهِ مَواليكِ العُيونا",13,"ن",2,0],["بُيُوتٌ بِأَسْبَابِ السَّمَاءِ تَعَلَّقَتْ","لَهَا فِي المَهَاوِي مُسْتَقَرٌّ وَمَجْثَمُ",14,"م",1,0],["بِيَومٍ كَأَيّامٍ كَأَنَّ عُيونَها","إِلى شَمسِهِ حوصُ الأَناسِيِّ عورُها",15,"ر",3,0],["بيوت نظم هي الجناتُ معجبة","كأنَّ في كل بيتِ وجهَ حوراء",16,"ا",2,0],["بيومِ بدرٍ أعزَّ الدينَ ناصرُهُ","وبابنِ بدرٍ أعز الظَّرْفَ والأدبا",17,"ب",2,1],["بيوتُ ضياء لا تبوخُ وحكمةٍ","نُجوميِّةٍ منهاجُها غيرُ طاسمِ",18,"م",1,0],["بُيوتٌ مُنَزَّهَةٌ كَالعَتي","قِ وَإِن لَم تُسَتَّر وَلَم تُحجَبِ",19,"ب",1,0],["بيومٍ أجَدَّ الدهرُ فيه لِباسَهُ","وأبرزَ من مكنونِ زينتِه الذُّخْرا",20,"ر",2,0],["بُيوتُ مُلوكِ الناسِ يُبنَينَ في الرُبى","وَهاشِمُ مَبنى بَيتِها في الكَواكِبِ",21,"ب",1,0],["بُيوتاتُ مَجدٍ أَخرَبوها بِلُؤمِهِم","فَعادَت قَواءً كَالرُسومِ المَوائِلِ",22,"ل",1,0],["بُيُوتُهُمْ مِنْ قُرَيْشٍ يُسْتَضَاءُ بِهَا","فِي‌ النَّائِبَاتِ وَعِنْدَ الحُكْمِ إنْ حَكَمُوا",23,"م",3,0],["بيومٍ يَجُدُّ به الدارعونَ","فلا يعرفونَ سبيلَ المِزاحِ",24,"ح",1,0],["بُيوتُ كُماةٍ دونَها تُحطَمُ القَنا","وَغاباتُ أُسدٍ دونَها تُفرَسُ الأُسدُ",25,"د",1,0],["بِيَومِ الشَعثَمَينِ أَقَرَّ عَيناً","وَكَيفَ لِقاءُ مَن تَحتَ القُبورِ",26,"ر",1,0],["بِيَومٍ كَقولِ الدَهرِ في عَرضِ مِثلِهِ","وَوَجدِيَ مِن هَذا وَهَذاكَ أَطوَلُ",27,"ل",1,0],["بِيَومٍ تُريكَ المَوتَ في صورَةِ النَوى","أَواخِرُهُ مِن حَسرَةٍ وَأَوائِلُه",28,"ل",2,0],["بِيَومٍ أَراني البَرقَ أَحمَرَ قانِياً","بِهِ وَاِستَطارَ النَقعُ أَربَدَ أَقتَما",29,"م",2,0],["بِيُؤيُؤٍ يُعجِبُ مَن رَآهُ","ما في اليَآئي يُؤيُؤٌ شَرواهُ",30,"ا",2,0],["بُيوتٌ فَمَهدومٌ يُرى وَمُقَوَّضٌ","بِكَسرٍ وَبَيتٌ مِن قَريضٍ لَهُ كَسرُ",31,"ر",1,1],["بيوْمٍ كأنّ الشمسَ فيه خَريدَةٌ","عليها من النّقْعِ الأحَمّ لِثامُ",32,"م",1,0],["بيومٍ راحَ في سِرْبالِ ليلٍ","فَما عُرفَ الأصيلُ منَ البُكورِ",33,"ر",1,0],["بِيَومِ كَريهَةٍ ضَرباً وَطَعناً","أَقَرَّ بِهِ مَواليكِ العُيونا",34,"ن",2,0],["بيوم قدومه وجبت علينا النْ","نُذور وسيق للبيت الهديّ",35,"ي",1,0],["بِيَ وَقْرٌ يُشْبِهُ الشَّيْءَ الَّذِي","فِي أَولِي الجَّاهِ يُسَمَّى بِالْوَقَارِ",36,"ر",1,0],["بي وَجَلٌ مِما سَتَأْتُونَهْ","وَرُبَّمَا أَخْطَأَ مَنْ يُوجِلُ",37,"ل",1,0],["بِيُوحَنَّا وَإِنْ هُوَ غَيْرُ شَهْمٍ","بِأَفْضَلِ كلِّ آنِسَةٍ جَديرِ",38,"ر",1,0],["بُيوتُ الْعِلْمِ مَهْمَا تَلْتَمِسْنِي","لِنُصْرَتِهَا تَجِدْ مِنِّي مُجِيبَا",39,"ب",2,1],["بِيُوسُفَ وَالْمَشْهُورِ مِنْ وَثَبَاتِهِ","إِلَى كُلِّ إِصْلاَحٍ تَمَهَّدَتِ السُّبْلُ",40,"ل",1,0],["بيوم الشعثمين لقر عينا","وكيف لقاء من تحت القبور",41,"ر",1,0],["بيومٍ كريهةٍ ضرباً وطعناً","أمر به مواليك العُيونا",42,"ن",2,0],["بيومِ السبت صبحاً من ربيعٍ","توفِّى طاهرُ الجيبِ التقىّ",43,"ا",1,0],["بِيَومٍ أَحَمِّ الجَوِّ حامٍ وَطيسُهُ","كَأَنَّ حَصاهُ مِن تَلَظّيهِ ذائِبُ",44,"ب",1,0],["بِيَومٍ تَكَنَّت كِلابٌ بِهِ","عَلى كُلِّ ذي نَخوَةٍ مِن مُضَر",45,"ر",1,0],["بيوم قضى نحبا أخي فارتقى إلى","جنان له فيها نبيّ الرضا أوى",46,"و",2,0],["بِيَوْمٍ سَعْدٍ مُصَفَّى","مِنَ الزَّمانِ المَشُوبِ",47,"ب",1,0],["بيوم القرمطيّ وقد تلقى","حجيج البيت في جبلي زرود",48,"د",1,0],["بيوم تخال الأرض ترمي من السما","سهام عذاب من لظى تستعيرها",49,"ر",3,0],["بيوم تغشى الشمس قبل قتامه","ويشرق من خرصانه بالثواقب",50,"ب",1,0],["بُيُوتُ النّاسِ عامِرَةٌ ولكِن","بُيُوتُ المالِ خاوِيةٌ طُلُولُ",51,"ل",1,0],["بيوت الحقّ تنعى من بناها","ودور الل